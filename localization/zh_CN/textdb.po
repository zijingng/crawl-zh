msgid "screams\n\nbooms\n\nroars\n\nbellows\n\nhowls\n\nyells\n\nshouts\n\nshrieks\n\nw:5\nthunders\n\nw:3\nclamours\n\nw:3\nexclaims\n\nw:1\nvociferates\n"
msgstr "尖叫\n\n轰鸣\n\n咆哮\n\n怒吼\n\n嚎叫\n\n大叫\n\n喊叫\n\n嘶叫\n\nw:5\n雷鸣般怒吼\n\nw:3\n喧嚷\n\nw:3\n高呼\n\nw:1\n大声叫嚷\n"

