msgctxt "textdb:database/monspeak.txt:holy_being_pacification"
msgid "VISUAL:@The_monster@ is calmed by your holy aura.\n"
msgstr "VISUAL:@The_monster@在你的神圣光环下平静下来。\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:holy_being_pacification_humanoid"
msgid "w:5\n@holy_being_pacification@\n\nVISUAL:@The_monster@ relaxes @possessive@ fighting stance.\n\nVISUAL:@The_monster@ salutes you.\n"
msgstr "w:5\n@holy_being_pacification@\n\nVISUAL:@The_monster@放松了@possessive@战斗架势。\n\nVISUAL:@The_monster@向你致敬。\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:holy_being_pacification_speech"
msgid "@The_monster@ shouts at you, \"Continue thy quest, mortal!\"\n\n@The_monster@ says to you, \"Forge ahead, servant of Elyvilon!\"\n\n@The_monster@ says to you, \"Carry on, mortal.\"\n"
msgstr "@The_monster@朝你喊道：“继续汝的征途，凡人！”\n\n@The_monster@对你说：“奋勇向前，艾利维隆的仆从！”\n\n@The_monster@对你说：“继续前进，凡人。”\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:good god '&'"
msgid "w:20\n@_demon_taunt_@\n\nw:1\n@The_monster@ screams @at_foe@, \"@Foe_god@ won't protect you, @foe_name@!\"\n\nw:1\n@The_monster@ screams @at_foe@, \"@Foe_god@ is but a nuisance to me, mortal!\"\n\nw:1\n@The_monster@ screams @at_foe@, \"@Foe_god@ will weep as I flay your corpse!\"\n"
msgstr "w:20\n@_demon_taunt_@\n\nw:1\n@The_monster@朝@at_foe@尖叫：“@Foe_god@保护不了你，@foe_name@！”\n\nw:1\n@The_monster@朝@at_foe@尖叫：“凡人，@Foe_god@对我来说不过是个麻烦！”\n\nw:1\n@The_monster@朝@at_foe@尖叫：“等我剥下你尸体的皮时，@Foe_god@也会哭泣！”\n"

