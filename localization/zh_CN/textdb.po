msgctxt "textdb:database/monspeak.txt:yak"
msgid "@The_monster@ snorts and paws the @surface@.\n"
msgstr "@The_monster@喷着鼻息，用蹄子刨着@surface@。\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_good_god_"
msgid "Zin\n\nthe Shining One\n\nElyvilon\n"
msgstr "辛\n\n光明神\n\n艾利维隆\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_holy_being_"
msgid "w:2\n@The_monster@ intones a prayer.\nVISUAL:A sense of peace washes over you.\n\nw:1\n@The_monster@ says @to_foe@, \"Thou must remain pure in the battle against evil.\"\n\nw:1\n@The_monster@ says @to_foe@, \"May @foe_god@ always shine on thee, @foe_name@!\"\n\nw:1\n@The_monster@ says @to_foe@, \"@foe_god@ be with thee, mortal!\" @player_only@\n\nw:1\n@The_monster@ says @to_foe@, \"Praised be @_good_god_@ in the heavens above!\"\n"
msgstr "w:2\n@The_monster@吟诵祷文。\nVISUAL:一阵安宁之感涌遍你的全身。\n\nw:1\n@The_monster@对@to_foe@说：“汝与邪恶交战之时，须常守纯洁之心。”\n\nw:1\n@The_monster@对@to_foe@说：“愿@foe_god@永远照耀汝，@foe_name@！”\n\nw:1\n@The_monster@对@to_foe@说：“愿@foe_god@与汝同在，凡人！”@player_only@\n\nw:1\n@The_monster@对@to_foe@说：“赞美天上的@_good_god_@！”\n"

