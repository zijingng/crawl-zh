msgctxt "textdb:database/wpnnoise.txt:_scream_"
msgid "@The_weapon@ goes, \"RWARRR!\"\n\n\n@The_weapon@ @_screams_@, \"I WAS FORGED TO MURDER THE WORLD!\"\n\n@The_weapon@ @_screams_@, \"I WILL SING THE SONG THAT ENDS THE WORLD!\"\n\n@The_weapon@ @_screams_@, \"I AM THE PEN! I AM THE SWORD! I AM THE HIGHEST LORD!\"\n\n@The_weapon@ @_screams_@, \"I AM YOUR PUNISHER!\"\n\n@The_weapon@ @_screams_@, \"IT'S JUDGEMENT DAY AND THE SENTENCE IS DEATH!\"\n\n@The_weapon@ @_screams_@, \"I AM THE CREATOR!\"\n\n@The_weapon@ @_screams_@, \"THE SWORD GAVE, AND THE SWORD HATH TAKEN AWAY!\"\n\n@The_weapon@ @_screams_@, \"BAPTISED IN BLOOD I AM!\"\n\n@The_weapon@ @_screams_@, \"FEEL THE CATHARSIS!\"\n\n@The_weapon@ @_screams_@, \"ALL WORSHIP ME, THE MAJESTY OF STEEL!\"\n\n@The_weapon@ @_screams_@, \"PRAY TO ME, NOT TO GODS OF FLESH AND BONE!\"\n\n@The_weapon@ @_screams_@, \"FOUNTAINS OF BLOOD IN HONOUR OF THE FAIR BLADE!\"\n\n@The_weapon@ @_screams_@, \"I AM THE FIFTH HORSEMAN! THE TIME IS NOW!\"\n\n@The_weapon@ @_screams_@, \"I AM BECOME DEATH, [DESTROYER|DEFILER|DISMEMBERER] OF [WORLDS|GODS|CHAMPIONS|HEROES|LEGIONS|NATIONS|MILLIONS]!\"\n\n@The_weapon@ @_screams_@, \"I AM THE RESURRECTION AND THE LIFE!\"\n\n@The_weapon@ @_screams_@, \"THIS IS THE END OF THE WORLD AS YOU KNOW IT!!!\"\n\n@The_weapon@ @_screams_@, \"WHEN I'M GOD, EVERYONE DIES!!!\"\n\n@The_weapon@ @_screams_@, \"DIFFUSE IT! DESTROY IT! ABUSE IT! ENJOY IT!\"\n\n@The_weapon@ @_screams_@, \"I AM IRON GIVEN PURPOSE!\"\n\n@The_weapon@ @_screams_@, \"I AM PAIN SEEKING EXPRESSION!\"\n\n@The_weapon@ @_screams_@, \"LET'S STRANGLE THE @_MISCREANTS_@, STRANGLE THEM!\"\n\n@The_weapon@ @_screams_@, \"KILL! KILL!! KILL!!!\"\n\n@The_weapon@ @_screams_@, \"I SMELL BLOOD!\"\n\n@The_weapon@ @_screams_@, \"CARNAGE NOT CANTRIPS!\"\n\n@The_weapon@ @_screams_@, \"KILL, HATE, MUTILATE!\"\n\n@The_weapon@ @_screams_@, \"MURDER! DEATH!! KILL!!!\"\n\n@The_weapon@ @_screams_@, \"DECIMATE, TERMINATE, ERADICATE!\"\n\n@The_weapon@ @_screams_@, \"I BATHE IN BLOOD AND BONE AND BRAINS!\"\n\n@The_weapon@ @_screams_@, \"I AM THE BRINGER OF WAR!\"\n\n@The_weapon@ @_screams_@, \"LET'S END THEIR MISERABLE LIVES!\"\n\n@The_weapon@ @_screams_@, \"BRING THEM DOWN!\"\n\n@The_weapon@ @_screams_@, \"DIE WHILE I'M SINGING!\"\n\n@The_weapon@ @_screams_@, \"KNEE-DEEP IN BLOOD AND GOING STRONG!\"\n\n@The_weapon@ @_screams_@, \"ENCORE! ENCORE! ENCORE!\"\n\n@The_weapon@ @_screams_@, \"HOW CAN YOU THINK ABOUT SINGING AT A TIME LIKE THIS?!\"\n\n@The_weapon@ @_screams_@, \"THE SCREAMS! DON'T LET THEM STOP WITH THE SCREAMS!\"\n\n@The_weapon@ @_screams_@, \"NONE SHALL [LIVE|ESCAPE|SURVIVE|BE SPARED]!\"\n\n@The_weapon@ @_screams_@, \"SPARE NO ONE!\"\n\n@The_weapon@ @_screams_@, \"COME TO ME! COME TO ME AND DIE!\"\n\n@The_weapon@ @_screams_@, \"CUT! CUT! CUT AND SLASH!\"\n\n@The_weapon@ @_screams_@, \"STABBITY STAB STAB STAB!\"\n\n@The_weapon@ @_screams_@, \"ABANDON ALL HOPE!\"\n\n@The_weapon@ @_screams_@, \"SLASH 'EM! SLASH 'EM ALL!\"\n\n@The_weapon@ @_screams_@, \"LET'S HACK!\"\n\n@The_weapon@ @_screams_@, \"DON'T YOU DARE DIE ON ME NOW, @CAPS@ @player_name@!\"\n\n@The_weapon@ @_screams_@, \"THIS IS THE COLOUR OF PAIN!\"\n\nw:1\n@The_weapon@ @_screams_@, \"YES! YES! YES! THIS is the LIFE, baby, this is the LIFE!\"\n\nw:1\n@The_weapon@ @_screams_@, \"PAINT IT RED! PAINT IT RED! PAINT IT ALL RED RED RED RED!!!!\"\n\nw:20\n@The_weapon@ @_screams_@, \"SWING ME [HARDER|FASTER], YOU [FUMBLE-FINGERED|INCOMPETENT|USELESS|SLUGGISH|NOODLE-ARMED|RUNNY-EYED|KNUCKLE-DRAGGING] [NINCOMPOOP|LARDBUCKET|WEAKLING|STICK-INSECT|FLATFOOT|BONEHEAD|MOONCALF|SLOTH]!\"\n\n@The_weapon@ @_screams_@, \"SUFFER OR PERISH! EITHER!\"\n\n@The_weapon@ @_screams_@, \"I CUT THROUGH MAGIC!\"\n\n@The_weapon@ @_screams_@, \"[@CAPS@ @_kind_of_scales_@|DISHARMONIC] SLAUGHTER!\"\n\n@The_weapon@ @_screams_@, \"FASTER, @CAPS@ @player_genus@, KILL KILL KILL!\"\n\n@The_weapon@ @_screams_@, \"BLOOD! BLOOD! BLOOD MUST SPURT AND BLOOD MUST FLOW!\"\n\n@The_weapon@ @_screams_@, \"BLOOD! BLOOD! BLOOD MUST GUSH FROM EVERY FOE!\"\n\n@The_weapon@ @_screams_@, \"BRAINS! BRAINS! CLEAVE THE SKULL AND OUT THEY SEEP!\"\n\n@The_weapon@ @_screams_@, \"BRAINS! BRAINS! KILLING'S FUN AND LIFE IS CHEAP!\"\n\n\n@The_weapon@ @_screams_@, \"I AM THE SWORD OF ZOT!!!\"\n\n@The_weapon@ @_screams_@, \"I AM THE RUNES AND THE LIGHT!\"\n\n@The_weapon@ @_screams_@, \"I love you all! And my gift to you is ARMAGEDDON!\"\n\n@The_weapon@ @_screams_@, \"MY LOVE IS ETERNAL!\"\n\nw:1\n@The_weapon@ @_screams_@, \"I BRING THE STORM!\"\n\nw:1\n@The_weapon@ @_screams_@, \"LET'S FONDLE THE @_PETS_@, FONDLE THEM!\"\n\nw:40\n@The_weapon@ @_screams_@, \"I AM [AN ANGEL|AN ARTIST|AN AVATAR|A HARBINGER|AN INSTRUMENT|A POET|A PROPHET|A SERVANT|A SLAVE|THE LORD|THE MASTER] OF [BLOOD|DANCE|DEATH|DESOLATION|DESPAIR|DESTRUCTION|DOOM|GORE|MADNESS|MUSIC|PAIN|RUIN|SLAUGHTER|SONG|STEEL|WAR]!\"\n\n@The_weapon@ @_screams_@, \"I AM A BEAUTIFUL ANIMAL!\"\n\n@The_weapon@ @_screams_@, \"EVERYTHING FAILS! EVERYTHING!!!\"\n\nw:1\n@The_weapon@ @_screams_@, \"NI! NI!! NI!!! NI!!! NI!!!\"\n\n@The_weapon@ @_screams_@, \"I AM A SEXY SHOELESS GOD OF WAR!\"\n\n@The_weapon@ @_screams_@, \"BUGRIT, MILLENNIUM HAND AND SHRIMP!\"\n\n@The_weapon@ @_screams_@, \"I AM THE IRON OF DEATH! FROM NO BLOOD WILL I SHRINK!\"\n\n\n"
msgstr "@The_weapon@叫道：“吼啊——！”\n\n\n@The_weapon@@_screams_@：“我生来就是为了屠戮世界！”\n\n@The_weapon@@_screams_@：“我要唱响终结世界之歌！”\n\n@The_weapon@@_screams_@：“我是笔！我是剑！我是至高的领主！”\n\n@The_weapon@@_screams_@：“我是你的惩罚者！”\n\n@The_weapon@@_screams_@：“审判日到了，判决是死刑！”\n\n@The_weapon@@_screams_@：“我是创造者！”\n\n@The_weapon@@_screams_@：“剑赐予，剑也收回！”\n\n@The_weapon@@_screams_@：“我已受鲜血洗礼！”\n\n@The_weapon@@_screams_@：“感受这宣泄！”\n\n@The_weapon@@_screams_@：“都来崇拜我，钢铁的至尊！”\n\n@The_weapon@@_screams_@：“向我祈祷，别向那些血肉之神祈祷！”\n\n@The_weapon@@_screams_@：“以血喷泉，礼赞这美丽的剑刃！”\n\n@The_weapon@@_screams_@：“我是第五位骑士！就是现在！”\n\n@The_weapon@@_screams_@：“我已化为死亡，作为[毁灭者|玷污者|肢解者]降临于[世界|诸神|勇士|英雄|军团|诸国|千万人]！”\n\n@The_weapon@@_screams_@：“复活在我，生命也在我！”\n\n@The_weapon@@_screams_@：“这就是你所知的世界末日！！！”\n\n@The_weapon@@_screams_@：“当我成为神，所有人都得死！！！”\n\n@The_weapon@@_screams_@：“扩散它！摧毁它！蹂躏它！享受它！”\n\n@The_weapon@@_screams_@：“我是被赋予使命的钢铁！”\n\n@The_weapon@@_screams_@：“我是寻求表达的痛苦！”\n\n@The_weapon@@_screams_@：“勒死那些@_MISCREANTS_@，勒死他们！”\n\n@The_weapon@@_screams_@：“杀！杀！！杀！！！”\n\n@The_weapon@@_screams_@：“我闻到了鲜血！”\n\n@The_weapon@@_screams_@：“要屠杀，不要戏法！”\n\n@The_weapon@@_screams_@：“杀戮，憎恨，残害！”\n\n@The_weapon@@_screams_@：“谋杀！死亡！！杀戮！！！”\n\n@The_weapon@@_screams_@：“屠灭，终结，根除！”\n\n@The_weapon@@_screams_@：“我在鲜血、白骨和脑浆中沐浴！”\n\n@The_weapon@@_screams_@：“我是战争的使者！”\n\n@The_weapon@@_screams_@：“结束他们悲惨的生命！”\n\n@The_weapon@@_screams_@：“打倒他们！”\n\n@The_weapon@@_screams_@：“在我歌唱时死去！”\n\n@The_weapon@@_screams_@：“鲜血齐膝，我仍势不可挡！”\n\n@The_weapon@@_screams_@：“再来一曲！再来一曲！再来一曲！”\n\n@The_weapon@@_screams_@：“这种时候你怎么还想着唱歌？！”\n\n@The_weapon@@_screams_@：“尖叫！别让他们停止尖叫！”\n\n@The_weapon@@_screams_@：“谁也别想[活着|逃脱|幸存|得到饶恕]！”\n\n@The_weapon@@_screams_@：“一个也别放过！”\n\n@The_weapon@@_screams_@：“到我这里来！到我这里来送死！”\n\n@The_weapon@@_screams_@：“砍！砍！又砍又劈！”\n\n@The_weapon@@_screams_@：“捅啊捅，捅捅捅！”\n\n@The_weapon@@_screams_@：“放弃一切希望！”\n\n@The_weapon@@_screams_@：“砍了他们！把他们全砍了！”\n\n@The_weapon@@_screams_@：“来吧，劈砍！”\n\n@The_weapon@@_screams_@：“现在可不许死给我看，@CAPS@ @player_name@！”\n\n@The_weapon@@_screams_@：“这就是痛苦的颜色！”\n\nw:1\n@The_weapon@@_screams_@：“对！对！对！这才叫生活，宝贝，这才叫生活！”\n\nw:1\n@The_weapon@@_screams_@：“涂成红色！涂成红色！全部涂红，红红红红！！！！”\n\nw:20\n@The_weapon@@_screams_@：“[更用力|更快]地挥动我，你这[手指笨拙的|无能的|没用的|迟钝的|胳膊软绵绵的|泪眼汪汪的|拖着指节走路的][蠢货|肥桶|弱者|竹节虫|平足佬|笨蛋|傻瓜|懒虫]！”\n\n@The_weapon@@_screams_@：“受苦或灭亡！选一个！”\n\n@The_weapon@@_screams_@：“我能斩开魔法！”\n\n@The_weapon@@_screams_@：“[@CAPS@ @_kind_of_scales_@音阶|不协和]的屠杀！”\n\n@The_weapon@@_screams_@：“快点，@CAPS@ @player_genus@，杀杀杀！”\n\n@The_weapon@@_screams_@：“鲜血！鲜血！鲜血要喷涌，鲜血要奔流！”\n\n@The_weapon@@_screams_@：“鲜血！鲜血！每个敌人都得鲜血喷涌！”\n\n@The_weapon@@_screams_@：“脑浆！脑浆！劈开头骨就流淌！”\n\n@The_weapon@@_screams_@：“脑浆！脑浆！杀戮好玩，性命不值钱！”\n\n\n@The_weapon@@_screams_@：“我是佐特之剑！！！”\n\n@The_weapon@@_screams_@：“我是符文与光明！”\n\n@The_weapon@@_screams_@：“我爱你们所有人！我的礼物是末日决战！”\n\n@The_weapon@@_screams_@：“我的爱永恒不灭！”\n\nw:1\n@The_weapon@@_screams_@：“我带来风暴！”\n\nw:1\n@The_weapon@@_screams_@：“抚摸那些@_PETS_@，抚摸它们！”\n\nw:40\n@The_weapon@@_screams_@：“我是[天使|艺术家|化身|先驱|工具|诗人|先知|仆从|奴隶|领主|主宰]，属于[鲜血|舞蹈|死亡|荒芜|绝望|毁灭|厄运|血污|疯狂|音乐|痛苦|破败|屠杀|歌唱|钢铁|战争]！”\n\n@The_weapon@@_screams_@：“我是一只美丽的动物！”\n\n@The_weapon@@_screams_@：“一切都会失败！一切！！！”\n\nw:1\n@The_weapon@@_screams_@：“涅！涅！！涅！！！涅！！！涅！！！”\n\n@The_weapon@@_screams_@：“我是性感赤脚的战神！”\n\n@The_weapon@@_screams_@：“混账，千年手和虾！”\n\n@The_weapon@@_screams_@：“我是死亡之铁！无论何种鲜血，我都不退缩！”\n\n\n"


#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:sparkling_message"
msgid "You feel fleetingly lighter.\n\nYou feel a fleeting jolt of bravery.\n\nYou feel nauseous for a moment.\n\nYour emotions uncomfortably twist.\n"
msgstr "你感到身体短暂地轻盈起来。\n\n你感到一阵转瞬即逝的勇气。\n\n你一时感到恶心。\n\n你的情绪发生令人不适的扭转。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:default fountain_eyes"
msgid "The fountain's eyes stare blankly through you.\n\nThe fountain's eyes stare idly in all directions.\n\nThe fountain's eyes stare into nothing.\n"
msgstr "喷泉上的眼睛茫然地望穿你的身体。\n\n喷泉上的眼睛漫不经心地望向四面八方。\n\n喷泉上的眼睛凝视着虚无。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ashenzari peaceful fountain_blue"
msgid "You attempt to scry through the fountain, but the Dungeon's magics reject you.\n"
msgstr "你试图通过喷泉占卜，但地下城的魔力拒绝了你。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ashenzari fountain_blue"
msgid "You catch brief visions of the Dungeon's past in the fountain's reflection.\n"
msgstr "你在喷泉的倒影中瞥见地下城往昔的片段。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:beogh fountain_blue"
msgid "You look at your reflection in the fountain and see a proud orc.\n"
msgstr "你看着喷泉中的倒影，看见一个骄傲的兽人。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:beogh fountain_sparkling"
msgid "You look at your [shimmering|glittering] reflection in the fountain and see a proud orc.\n"
msgstr "你看着喷泉中[微光闪烁|熠熠生辉]的倒影，看见一个骄傲的兽人。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:cheibriados fountain_sparkling"
msgid "You briefly disapprove of the fountain's mystically arrhythmic flow.\n"
msgstr "喷泉那神秘而毫无规律的水流让你略感不满。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:cheibriados peaceful dry_fountain"
msgid "You briefly muse on the calm stillness of an empty fountain.\n"
msgstr "你略微思索了一番空喷泉的宁静与安定。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:dithmenos fountain_blood"
msgid "You scoff at the overwrought melodramatics of this fountain.\n"
msgstr "你对这座喷泉过分夸张的煽情嗤之以鼻。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:fedhas peaceful fountain_blue"
msgid "You briefly survey the algae on the fountain's rim. They seem healthy.\n"
msgstr "你略微查看喷泉边缘的藻类，它们似乎很健康。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:fedhas peaceful fountain_sparkling"
msgid "You briefly survey the algae on the fountain's rim. They shimmer back.\n"
msgstr "你略微查看喷泉边缘的藻类，它们闪着微光回应你。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:fedhas peaceful fountain_blood"
msgid "You briefly survey the mould on the fountain's rim. It seems... concerning.\n"
msgstr "你略微查看喷泉边缘的霉菌，它们似乎……令人担忧。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:fedhas peaceful fountain_eyes"
msgid "You briefly survey the mould on the fountain's rim. It possibly surveys back.\n"
msgstr "你略微查看喷泉边缘的霉菌，它们或许也在查看你。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:gozag peaceful fountain_blue"
msgid "You look for coins within the fountain, but they're all too worthless to bother.\n"
msgstr "你在喷泉里寻找硬币，但它们太不值钱，不值得费心。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:gozag peaceful fountain_sparkling"
msgid "@Gozag peaceful fountain_blue@\n"
msgstr "@Gozag peaceful fountain_blue@\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:hepliaklqana fountain_blue"
msgid "The fountain's ripples stir distant, transient memories.\n"
msgstr "喷泉的涟漪唤起遥远而转瞬即逝的记忆。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:hepliaklqana dry_fountain"
msgid "You swear to never forget your legacy as this fountain's builders were forgotten.\n"
msgstr "你发誓绝不遗忘自己的传承，不让它像这喷泉的建造者一样被人遗忘。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:hepliaklqana peaceful fountain_blood"
msgid "You observe a moment of silence for whomever's blood flows through this fountain.\n"
msgstr "你为血液流经这座喷泉的生灵默哀片刻。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ignis fountain_blue"
msgid "The fountain's water lightly sizzles in your presence.\n\nw:1\nThe dying flame fearfully flickers in the reflection of the fountain.\n"
msgstr "喷泉的水因你的到来而轻轻嘶响。\n\nw:1\n垂死的火焰在喷泉倒影中恐惧地闪烁。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ignis fountain_sparkling"
msgid "The fountain's sparkling water lightly sizzles and shimmers in your presence.\n\nw:1\nThe dying flame fearfully flickers in the reflection of the sparkling fountain.\n"
msgstr "喷泉的闪光泉水因你的到来而轻轻嘶响，泛起微光。\n\nw:1\n垂死的火焰在闪光喷泉的倒影中恐惧地闪烁。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ignis fountain_blood"
msgid "The fountain's blood briefly boils in your presence.\n"
msgstr "喷泉中的鲜血因你的到来而短暂沸腾。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:jiyva peaceful fountain_blue"
msgid "You stop to admire the sparkling slime slowly growing over the fountain's rim.\n"
msgstr "你停下来欣赏缓缓爬满喷泉边缘、闪着微光的黏液。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:jiyva fountain_eyes"
msgid "Your genes instinctively attempt to commune with the fountain's eyes and fail.\n\nA few eyes on the fountain briefly shift into confused golden shades.\n"
msgstr "你的基因本能地试图与喷泉上的眼睛交流，却失败了。\n\n喷泉上的几只眼睛短暂地泛起困惑的金色。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:kikubaaqudgha peaceful dry_fountain"
msgid "You muse upon the day when the entire world will share this fountain's fate.\n"
msgstr "你思索着终有一天，整个世界都会落得这喷泉一样的下场。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:lugonu peaceful fountain_eyes"
msgid "You muse on Lugonu's promise to warp all of reality as thoroughly as this fountain.\n"
msgstr "你思索着卢戈努的承诺：将整个现实都扭曲成这喷泉一般的模样。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:nemelex xobeh peaceful fountain_blue"
msgid "You toss an ancient coin into the fountain for a little extra luck.\n"
msgstr "你向喷泉投下一枚古钱币，求取一点额外的好运。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:nemelex xobeh peaceful fountain_sparkling"
msgid "You toss an ancient coin into the fountain for some extra glamorous luck.\n"
msgstr "你向喷泉投下一枚古钱币，求取一点更绚丽的好运。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:qazlal peaceful fountain_blue"
msgid "w:5\nYou scoff at such attempts to contain the uncontrollable elements.\n\n@Qazlal fountain_blue@\n"
msgstr "w:5\n你嘲笑这种禁锢失控元素的企图。\n\n@Qazlal fountain_blue@\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:qazlal fountain_blue"
msgid "The fountain bubbles and surges in the storm.\n"
msgstr "喷泉在风暴中翻腾涌动。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:qazlal fountain_sparkling"
msgid "The fountain bubbles and surges violently in the storm.\n"
msgstr "喷泉在风暴中猛烈翻腾涌动。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:qazlal fountain_blood"
msgid "The fountain's blood bubbles and surges in the storm.\n"
msgstr "喷泉的鲜血在风暴中翻腾涌动。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ru peaceful fountain_blue"
msgid "The water in the fountain reflects the world, which is itself a mere reflection.\n"
msgstr "喷泉的水映照着世界，而世界本身也不过是一道倒影。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:ru peaceful fountain_eyes"
msgid "w:2\nThe eyes in the fountain cannot see the truth any more than any other material.\n\n@default fountain_eyes@\n"
msgstr "w:2\n喷泉上的眼睛和其他物质一样，都无法看见真相。\n\n@default fountain_eyes@\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:sif muna peaceful fountain_sparkling"
msgid "You struggle to determine the manifold diluted potions present in the fountain.\n"
msgstr "你努力辨认喷泉里混杂的各种稀释药水。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:sif muna peaceful fountain_blood"
msgid "You struggle to identify the manner of creatures' blood used in this fountain.\n"
msgstr "你努力辨认这喷泉使用了哪些生物的血。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:sif muna peaceful fountain_eyes"
msgid "You idly identify at least [five|six] types of eyes growing in the fountain.\n"
msgstr "你漫不经心地认出喷泉上至少长着[五|六]种眼睛。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:uskayaw peaceful fountain_blue"
msgid "You do an impromptu, brief dance in the water, like the crinaeae of old.\n"
msgstr "你像古时的泉水宁芙一样，在水中即兴跳了一小段舞。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:uskayaw fountain_blood"
msgid "The fountain of blood pulses a joyous rhythm of life and death.\n"
msgstr "血喷泉搏动着，奏出生与死的欢快节奏。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:vehumet fountain_blood"
msgid "You sense the potent destructive power at rest in within this fountain.\n"
msgstr "你感到这座喷泉中潜藏着强大的毁灭之力。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:wu jian peaceful fountain_blue"
msgid "You briefly muse on the need to flow like the water through this fountain.\n\nw:5\nThe fountain is calm. The water trickles softly. Here one can find peace.\n"
msgstr "你略微思索了一番，应当像这喷泉中的水一样流动。\n\nw:5\n喷泉平静，流水轻淌。此地可得安宁。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:xom fountain_blue"
msgid "Harmless butterflyfish stare at you from within the fountain.\n\nw:1\nFor a brief moment, you thought you saw Xom summoned an eel in this fountain.\n\nw:1\nFor a terrifying moment, you swear Xom summoned a kraken in this fountain.\n"
msgstr "无害的蝴蝶鱼从喷泉里盯着你。\n\nw:1\n有那么一瞬间，你仿佛看见佐姆在喷泉里召唤了一条鳗鱼。\n\nw:1\n有那么可怕的一瞬间，你确信佐姆在喷泉里召唤了一只海妖。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:xom fountain_sparkling"
msgid "Shimmering and harmless butterflyfish glower at you from within the fountain.\n\nw:1\nFor a brief moment, you swear Xom called forth a formless jellyfish here.\n"
msgstr "闪着微光的无害蝴蝶鱼从喷泉里瞪着你。\n\nw:1\n有那么一瞬间，你确信佐姆在这里召来了一只无形水母。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:xom fountain_blood"
msgid "Harmless vampiric butterflyfish glare at you from within the fountain.\n\nw:1\nFor a terrifying moment, you swear Xom placed a vampire kraken in this fountain.\n"
msgstr "无害的吸血蝴蝶鱼从喷泉里怒视着你。\n\nw:1\n有那么可怕的一瞬间，你确信佐姆在喷泉里放了一只吸血鬼海妖。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:yredelemnul fountain_blue"
msgid "A miniscule dead [mosquito|moth] on the fountain's rim briefly twitches under your umbra.\n"
msgstr "喷泉边缘一只微小的[蚊子|蛾]尸体在你的幽影下短暂抽动。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:yredelemnul fountain_sparkling"
msgid "@Yredelemnul fountain_blue@\n"
msgstr "@Yredelemnul fountain_blue@\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:yredelemnul fountain_blood"
msgid "You dismiss the blood in this fountain as useless to your harvest.\n"
msgstr "你认定这喷泉里的鲜血对你的收割毫无用处。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:zin fountain_sparkling"
msgid "You avert your eyes from the scattered magic in the fountain's sparkles.\n"
msgstr "你移开目光，不看喷泉微光中散乱的魔力。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:zin fountain_eyes"
msgid "You avert your eyes from the unclean eyes pooled in the fountain.\n"
msgstr "你移开目光，不看喷泉里聚集的不洁眼睛。\n"

#. Reviewed database-12 fountain messages.
msgctxt "textdb:database/decorlines.txt:the shining one fountain_blood"
msgid "You quietly vow to avenge the poor creatures bled out for this fountain.\n"
msgstr "你默默发誓，要替那些为这喷泉流尽鲜血的可怜生灵复仇。\n"


#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:fruit cache"
msgid "You reach down and sample @_fruit_and_reaction_@\n"
msgstr "你俯身尝了@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:meat cache"
msgid "You reach down and sample @_meat_and_reaction_@\n"
msgstr "你俯身尝了@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:baked goods cache"
msgid "You reach down and sample @_baked_good_and_reaction_@\n"
msgstr "你俯身尝了@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:_fruit_and_reaction_"
msgid "an apple. Crisp.\n\nan apricot. Delicious.\n\na banana. Delicious.\n\na choko. Bland.\n\nsome grapes. Delicious.\n\nsome lychee. Delicately sweet.\n\nan orange. Delicious.\n\nsome rambutans. Delicious.\n\nsome strawberries. Delicious.\n\na snozzcumber. Putrid!\n\n\na tomato. Savoury.\n\na cherimoya. Tangy!\n\na mango. Yummy.\n\na tamarind. Juicy!\n"
msgstr "一个苹果。清脆。\n\n一个杏子。美味。\n\n一根香蕉。美味。\n\n一个佛手瓜。寡淡。\n\n一些葡萄。美味。\n\n一些荔枝。清甜。\n\n一个橙子。美味。\n\n一些红毛丹。美味。\n\n一些草莓。美味。\n\n一根斯诺兹瓜。臭不可闻！\n\n\n一个番茄。鲜美。\n\n一个毛叶番荔枝。酸爽！\n\n一个芒果。好吃。\n\n一个罗望子。多汁！\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:_meat_and_reaction_"
msgid "a smoked eel. Savoury!\n\na yak sausage. Delicious.\n\na cured ham hock. Salty.\n\nsome adder jerky. Delicious.\n\na slice of magically-preserved pepperoni pizza. Delicious.\n\nw:6\nsome smoked snail. Delicious.\n\nw:6\nsome death yak haggis. Delicious.\n\nw:6\nsome alligator jerky. Delicious.\n\nw:6\nsome cured dream mutton. Ephemeral.\n\nw:6\na slice of magically-preserved Pandemonium pizza. Delectable.\n\nw:2\na candy-coated scorpion. Crunchy.\n\nw:2\na pickled kraken tentacle. Astonishing!\n\nw:2\na cured hell ham hock. Spicy!\n\nw:2\nsome shrike confit. Tangy!\n\nw:2\na century hydra egg. An acquired taste.\n\n"
msgstr "一条熏鳗鱼。鲜美！\n\n一根牦牛肉肠。美味。\n\n一块腌猪肘。咸香。\n\n一些蝰蛇肉干。美味。\n\n一片用魔法保鲜的意式辣香肠披萨。美味。\n\nw:6\n一些熏蜗牛。美味。\n\nw:6\n一些死亡牦牛杂碎馅肚。美味。\n\nw:6\n一些短吻鳄肉干。美味。\n\nw:6\n一些腌梦羊肉。稍纵即逝。\n\nw:6\n一片用魔法保鲜的魔窟披萨。可口。\n\nw:2\n一只裹糖的蝎子。酥脆。\n\nw:2\n一根腌海妖触手。令人惊叹！\n\nw:2\n一块腌地狱猪肘。辛辣！\n\nw:2\n一些油封伯劳肉。酸香！\n\nw:2\n一个海德拉皮蛋。得慢慢习惯这味道。\n\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:_baked_good_and_reaction_"
msgid "w:24\nsome spriggan [bread loaf|tarts|rock buns|scones|biscuits|hardtack]. Delicious.\n\nw:14\nan orcish [pirog|pastel de nata|bizcocho]. Tasty.\n\nw:14\nsome elven [shortbread|rye rolls]. Refined.\n\nsome merfolk [baklava|tsoureki]. Decadent.\n\na stuffed naga paratha. Phenomenal.\n\na draconian baguette. Hearty and warming.\n\nw:6\nsome [dwarven|kobold|kobold] pretzels. Scrumptious.\n\nw:6\nsome choko cake. Less bland than expected!\n\nw:2\nsome [trollish|giant|giant] [wittenberger|grovbrød]. Savoury.\n\nw:2\nsome tengu anpan. Delightful.\n\nw:2\nsome ghoulish sourdough. A strange taste.\n\nw:2\nsome vault guards' spare rations. Filling.\n\nw:2\na strangely fresh circus pie. Mirthful.\n\nw:2\nsome starflower jam biscuits. A disquieting taste.\n"
msgstr "w:24\n一些斯普利根[整条面包|馅挞|岩皮小蛋糕|司康|饼干|硬饼干]。美味。\n\nw:14\n一个兽人[馅饼|葡式蛋挞|海绵蛋糕]。可口。\n\nw:14\n一些精灵[酥饼|黑麦小面包]。精致。\n\n一些人鱼[果仁蜜酥|甜面包]。奢靡。\n\n一个娜迦夹馅薄饼。妙不可言。\n\n一根龙人法棍。扎实暖胃。\n\nw:6\n一些[矮人|狗头人|狗头人]椒盐卷饼。香甜可口。\n\nw:6\n一些佛手瓜蛋糕。没想象中那么寡淡！\n\nw:2\n一些[巨魔|巨人|巨人][维滕贝格面包|粗粮面包]。鲜美。\n\nw:2\n一些天狗红豆面包。令人愉快。\n\nw:2\n一些食尸鬼酸种面包。味道奇特。\n\nw:2\n一些宝库守卫的备用口粮。管饱。\n\nw:2\n一个新鲜得古怪的马戏团馅饼。令人发笑。\n\nw:2\n一些星之花果酱饼干。味道令人不安。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:carnivore fruit cache"
msgid "You peruse the fruit pile and shrug.\n"
msgstr "你打量了一番水果堆，耸了耸肩。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:carnivore baked goods cache"
msgid "You peruse the pile and make a meat sandwich with @_baked_good_and_reaction_@\n"
msgstr "你打量了一番食物堆，做了个肉馅三明治，用的是@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:short fruit cache"
msgid "You root around and sample @_fruit_and_reaction_@\n"
msgstr "你翻找了一番，尝了@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:short meat cache"
msgid "You root around and sample @_meat_and_reaction_@\n"
msgstr "你翻找了一番，尝了@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:short baked goods cache"
msgid "You root around and sample @_baked_good_and_reaction_@\n"
msgstr "你翻找了一番，尝了@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:stone fruit cache"
msgid "You pestle and swallow @_fruit_and_reaction_@\n"
msgstr "你捣碎并吞下@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:stone meat cache"
msgid "You pestle and swallow @_meat_and_reaction_@\n"
msgstr "你捣碎并吞下@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:stone baked goods cache"
msgid "You mill down and swallow @_baked_good_and_reaction_@\n"
msgstr "你磨碎并吞下@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:inediate fruit cache"
msgid "You briefly stare at the fruit pile and sigh.\n"
msgstr "你盯着水果堆看了片刻，叹了口气。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:inediate meat cache"
msgid "You briefly stare at the meat pile and sigh.\n"
msgstr "你盯着肉堆看了片刻，叹了口气。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:inediate baked goods cache"
msgid "You briefly stare at the breadstuffs pile and sigh.\n"
msgstr "你盯着面点堆看了片刻，叹了口气。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:draconian fruit cache"
msgid "You reach down and sample @_fruit_and_reaction_@\n\nw:1\nYou reach down and sample a dragonfruit. You feel vaguely uncomfortable.\n"
msgstr "你俯身尝了@_fruit_and_reaction_@\n\nw:1\n你俯身尝了一个火龙果。你隐约感到有些不自在。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:felid fruit cache"
msgid "You dice up an apple and nibble upon it. Bland.\n\nYou dice up a banana and nibble upon it. Bland.\n\nYou pick out some berries and nibble upon them. Bland.\n"
msgstr "你把一个苹果切成小块，慢慢啃食。寡淡。\n\n你把一根香蕉切成小块，慢慢啃食。寡淡。\n\n你挑出一些浆果，慢慢啃食。寡淡。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:felid meat cache"
msgid "You nibble upon @_meat_and_reaction_@\n"
msgstr "你小口啃食@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:felid baked goods cache"
msgid "You nibble upon @_baked_good_and_reaction_@\n"
msgstr "你小口啃食@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:oni fruit cache"
msgid "You reach down and grab @_fruit_and_reaction_@ You go for seconds.\n"
msgstr "你俯身抓起@_fruit_and_reaction_@你又添了一份。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:oni baked goods cache"
msgid "You reach down and grab @_baked_good_and_reaction_@ You go for seconds.\n"
msgstr "你俯身抓起@_baked_good_and_reaction_@你又添了一份。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:spriggan meat cache"
msgid "You root around, looking for pizza, but fail to find any.\n\nw:4\nYou find a slice of magically-preserved pizza, and pick the meat off. Delicious!\n"
msgstr "你翻找着披萨，却什么也没找到。\n\nw:4\n你找到一片用魔法保鲜的披萨，把上面的肉挑掉。美味！\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:spriggan baked goods cache"
msgid "You root around and eagerly enjoy @_baked_good_and_reaction_@\n"
msgstr "你翻找了一番，迫不及待地享用@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:tengu baked goods cache"
msgid "You reach down and peck at @_baked_good_and_reaction_@\n"
msgstr "你俯身啄食@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:amphisbaena fruit cache"
msgid "You distend one of your jaws to swallow @_fruit_and_reaction_@\n"
msgstr "你张大其中一张嘴，吞下@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:amphisbaena meat cache"
msgid "You distend one of your jaws to swallow @_meat_and_reaction_@\n"
msgstr "你张大其中一张嘴，吞下@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:amphisbaena baked goods cache"
msgid "You distend one of your jaws to swallow @_baked_good_and_reaction_@\n"
msgstr "你张大其中一张嘴，吞下@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:bat fruit cache"
msgid "You slurp up @_fruit_and_reaction_@\n"
msgstr "你吸食@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:bat baked goods cache"
msgid "You swoop down and nibble at @_baked_good_and_reaction_@\n"
msgstr "你俯冲下来，小口啃食@_baked_good_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:blade fruit cache"
msgid "You try to grab some fruit with your blades, but fail!\n\nw:4\nYou use your hands like chopsticks to delicately eat @_fruit_and_reaction_@\n"
msgstr "你想用刀刃抓起一些水果，却失败了！\n\nw:4\n你把双手当作筷子，小心地吃下@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:blade meat cache"
msgid "You try to grab some meat with your blades, but fail!\n\nYou skewer and sample @_meat_and_reaction_@\n"
msgstr "你想用刀刃抓起一些肉，却失败了！\n\n你串起并品尝了@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:dragon fruit cache"
msgid "You devour @_fruit_and_reaction_@\n\nw:1\nYou devour a dragonfruit. You feel vaguely uncomfortable.\n"
msgstr "你狼吞虎咽地吃下@_fruit_and_reaction_@\n\nw:1\n你狼吞虎咽地吃下一个火龙果。你隐约感到有些不自在。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:maw fruit cache"
msgid "You devour half the fruit pile! It's not enough.\n"
msgstr "你吞掉了半堆水果！还不够。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:maw meat cache"
msgid "You devour half the meat pile! It's not enough.\n"
msgstr "你吞掉了半堆肉！还不够。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:maw baked goods cache"
msgid "You devour half the baked goods pile! It's not enough.\n"
msgstr "你吞掉了半堆烘焙食品！还不够。\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:storm fruit cache"
msgid "You reach down and electrolyse @_fruit_and_reaction_@\n"
msgstr "你俯身电解了@_fruit_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:storm meat cache"
msgid "You reach down and electrolyse @_meat_and_reaction_@\n"
msgstr "你俯身电解了@_meat_and_reaction_@\n"

#. Reviewed database-13 food decoration.
msgctxt "textdb:database/decorlines.txt:vampire fruit cache"
msgid "You root around, looking for a blood orange, but fail to find any.\n\nw:4\nYou reach down and find a blood orange. Delicious.\n"
msgstr "你翻找着血橙，却什么也没找到。\n\nw:4\n你俯身找到一个血橙。美味。\n"

