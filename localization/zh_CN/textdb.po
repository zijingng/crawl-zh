#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_friendly_beogh_speech_common_"
msgid "w:5\n@The_monster@ @_loudly_or_repeatedly_@ @_shouts_@ encouragement@_orc_modifier_@\n\n@The_monster@ shouts, \"Orcs kill for Beogh, Orcs die for Beogh!\"\n\n@The_monster@ says, \"Your appearance changed my life!\"\n\n@The_monster@ @_says_or_shouts_@, \"Dying for Beogh gives my life meaning.\"\n\n@The_monster@ @_shouts_@, \"Blood in Beogh's name!\"\n\n@The_monster@ shouts, \"All our enemies must die!\"\n\n@The_monster@ @_shouts_@, \"Let's [kill|smash|burn|maim] whoever stands in our way!\"\n\n@The_monster@ @_orc_says_@, \"With Beogh's help we'll overthrow all the false gods!\"\n\n@The_monster@ @_shouts_@, \"Smite the @_orc_heathen_@s!\"\n\n@The_monster@ @_shouts_@, \"Take back everything that was taken from us!\"\n\n@The_monster@ @_says_or_shouts_@, \"I'm proud to serve; I'm ready to die.\"\n\n@The_monster@ says, \"May Beogh smile on you, @player_name@.\"\n\n@The_monster@ shouts, \"Fear not, @player_name@! Beogh smiles on those who fall in battle!\"\n\n@The_monster@ lets loose a series of foul curses in Beogh's name.\n\n@The_monster@ @_says_or_shouts_@, \"I fight for @player_name@, for Beogh shepherds all!\"\n\n@The_monster@ @_says_or_shouts_@, \"Orcs will kill them all!\"\n\n@The_monster@ @_shouts_@, \"Orcs rule!\"\n\n@The_monster@ says, \"I just want to die in your service, @player_name@!\"\n\n@The_monster@ says, \"Beogh doesn't mind all this killing, you know.\"\n"
msgstr "w:5\n@The_monster@@_loudly_or_repeatedly_@@_shouts_@着鼓励的话语@_orc_modifier_@\n\n@The_monster@喊道：“兽人为比欧弗杀敌，兽人为比欧弗赴死！”\n\n@The_monster@说：“你的出现改变了我的一生！”\n\n@The_monster@@_says_or_shouts_@：“为比欧弗而死，让我的生命有了意义。”\n\n@The_monster@@_shouts_@：“以比欧弗之名，让鲜血流淌！”\n\n@The_monster@喊道：“我们的敌人都得死！”\n\n@The_monster@@_shouts_@：“把挡路的家伙全都[杀死|砸烂|烧死|打残]！”\n\n@The_monster@@_orc_says_@：“有比欧弗相助，我们定能推翻一切伪神！”\n\n@The_monster@@_shouts_@：“神罚那些@_orc_heathen_@！”\n\n@The_monster@@_shouts_@：“夺回我们被抢走的一切！”\n\n@The_monster@@_says_or_shouts_@：“为你效命是我的荣耀，我已准备赴死。”\n\n@The_monster@说：“愿比欧弗眷顾你，@player_name@。”\n\n@The_monster@喊道：“不要害怕，@player_name@！比欧弗眷顾战死之人！”\n\n@The_monster@以比欧弗之名接连吐出恶毒的咒骂。\n\n@The_monster@@_says_or_shouts_@：“我为@player_name@而战，比欧弗引领众生！”\n\n@The_monster@@_says_or_shouts_@：“兽人会把他们杀个精光！”\n\n@The_monster@@_shouts_@：“兽人称霸！”\n\n@The_monster@说：“我只想为你效命而死，@player_name@！”\n\n@The_monster@说：“要知道，比欧弗并不介意这些杀戮。”\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_friendly_beogh_speech_rare_"
msgid "@The_monster@ @_says_or_shouts_@, \"Beogh is great, and so is @player_name@!\"\n\n@The_monster@ @_says_or_shouts_@, \"I am so glad I met you.\"\n\n@The_monster@ @_orc_says_@, \"A dead @_orc_heathen_@ will not bedevil my soul.\"\n\n@The_monster@ says, \"I never had a vision before.\"\n\n@The_monster@ @_says_or_shouts_@, \"Our fallen brethren won't be forgotten.\"\n\nVISUAL:@The_monster@ looks @at_foe/around@ nervously.\n\n@The_monster@ looks @at_foe@ and says, \"I'd rather not die in your service, @player_name@.\"\n\n@The_monster@ chants, \"I shall fear no evil, for @player_name@ is my saviour.\"\n\n@The_monster@ says, \"I'm proud to be an orc.\"\n\n@The_monster@ says, \"I'm an Orc, you're an Orc, it's OK.\"\n\n@The_monster@ seems like @subjective@ is about to say something to you, then stops.\n\n@The_monster@ @_mutters_@, \"When this is all over, I'm going to start a fungus farm.\"\n"
msgstr "@The_monster@@_says_or_shouts_@：“比欧弗伟大，@player_name@也同样伟大！”\n\n@The_monster@@_says_or_shouts_@：“遇见你真是太好了。”\n\n@The_monster@@_orc_says_@：“死掉的@_orc_heathen_@就不会再侵扰我的灵魂。”\n\n@The_monster@说：“我从未见过神启。”\n\n@The_monster@@_says_or_shouts_@：“我们不会忘记倒下的同胞。”\n\nVISUAL:@The_monster@紧张地看着@at_foe/around@。\n\n@The_monster@望着@at_foe@说：“我还是不想为你效命而死，@player_name@。”\n\n@The_monster@吟唱道：“我必不惧邪恶，因@player_name@是我的救主。”\n\n@The_monster@说：“身为兽人，我很自豪。”\n\n@The_monster@说：“我是兽人，你也是兽人，这没什么不好。”\n\n@The_monster@似乎想对你说些什么，但@subjective@又打住了。\n\n@The_monster@@_mutters_@：“等这一切结束，我要开个真菌农场。”\n"

