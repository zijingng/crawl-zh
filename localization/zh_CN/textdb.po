msgstr "w:120\n像@_beastly_adjective_@的@_beast_@一样\n\n歇斯底里地\n\n愤怒地\n\nw:60\n@_loudly_@\n"

#. Reviewed database-06; keep canonical random order.
msgctxt "textdb:database/wpnnoise.txt:_loudly_"
msgid "loudly\n\ndeafeningly\n\near-piercingly\n\near-splittingly\n"
msgstr "大声地\n\n震耳欲聋地\n\n尖厉刺耳地\n\n响彻耳际地\n"

#. Reviewed database-06; keep canonical random order.
msgctxt "textdb:database/wpnnoise.txt:_beastly_adjective_"
msgid "hungry\n\nenraged\n\nraging\n\nfurious\n\nirate\n"
msgstr "饥饿\n\n暴怒\n\n狂怒\n\n愤怒\n\n恼怒\n"

#. Reviewed database-06; keep canonical random order.
msgctxt "textdb:database/wpnnoise.txt:_beast_"
msgid "dragon\n\nfrog\n\nlion\n\nbull\n\nbeast\n\nw:1\nbeast of prey\n\npredator\n\ncarnivore\n"
msgstr "龙\n\n青蛙\n\n狮子\n\n公牛\n\n野兽\n\nw:1\n猛兽\n\n捕食者\n\n食肉动物\n"

#. Reviewed database-06; keep canonical random order.
msgctxt "textdb:database/wpnnoise.txt:_strikes_up_what_"
msgid "w:5\na slow and mournful tune\n\na merry tune\n\na merry melody\n\na funeral march\n"
msgstr "w:5\n一支缓慢而哀伤的曲子\n\n一支欢快的曲子\n\n一段欢快的旋律\n\n一支葬礼进行曲\n"

#. Reviewed database-06; keep canonical random order.
