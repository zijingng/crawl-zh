msgid "@The_monster@ breathes a plume of calcifying dust @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷出一股钙化粉尘。\n"

msgctxt "textdb:database/monspell.txt:poisonous cloud natural cast"
msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

