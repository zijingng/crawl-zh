msgid "@Urug@\n\nw:4\n@related beogh orc@\n"
msgstr "@Urug@\n\nw:4\n@related beogh orc@\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_reaction_sight"
msgid "@The_monster@ stares at you in amazement and kneels.\n\n@The_monster@ relaxes @possessive@ fighting stance and smiles at you.\n\n@The_monster@ falls on @possessive@ knees before you.\n"
msgstr "@The_monster@惊讶地望着你，跪了下来。\n\n@The_monster@放松了@possessive@战斗架势，向你微笑。\n\n@The_monster@在你面前屈下@possessive@双膝。\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_speech_sight"
msgid "@Subjective@ shouts, \"@player_name@ is one of us!\"\n\n@Subjective@ shouts, \"Surely Beogh must have sent you!\"\n\n@Subjective@ asks, \"Are you our saviour?\"\n\n@Subjective@ says, \"I'm so glad you are here now.\"\n"
msgstr "@Subjective@喊道：“@player_name@是我们的一员！”\n\n@Subjective@喊道：“你一定是比欧弗派来的！”\n\n@Subjective@问道：“你是我们的救世主吗？”\n\n@Subjective@说：“你来了，我真高兴。”\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_reaction_battle"
msgid "@The_monster@ surrenders.\n\n@The_monster@ falls to @possessive@ knees.\n\n@The_monster@ raises @possessive@ hands in surrender.\n"
msgstr "@The_monster@投降了。\n\n@The_monster@屈下@possessive@双膝，跪了下来。\n\n@The_monster@举起@possessive@双手投降。\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_speech_battle"
msgid "@Subjective@ shouts, \"I'll follow you! Let me live!\"\n\n@Subjective@ says, \"You must be the Messiah, I see it now!\"\n\n@Subjective@ yells, \"I follow Beogh's word, I swear it!\"\n"
msgstr "@Subjective@喊道：“我愿意追随你！饶我一命！”\n\n@Subjective@说：“你一定就是救世主，我现在明白了！”\n\n@Subjective@大喊：“我遵从比欧弗的教诲，我发誓！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_speech_vengeance"
msgid "@Subjective@ shouts, \"You have your revenge! Let me go!\"\n\n@Subjective@ shouts, \"Spare me, and you'll never see me again!\"\n\n@Subjective@ says, \"I deserve death, but Beogh is merciful!\"\n"
msgstr "@Subjective@喊道：“你的仇已经报了！放我走！”\n\n@Subjective@喊道：“饶了我，你就再也见不到我了！”\n\n@Subjective@说：“我罪该万死，但比欧弗是仁慈的！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_resurrection"
msgid "@The_monster@ shouts, \"You saved me!\"\n\n@The_monster@ says, \"You really are the Messiah.\"\n\n@The_monster@ thanks you for bringing @objective@ back to life.\n\n@The_monster@ says, \"I knew I could rely on you.\"\n\n@The_monster@ says, \"Now I can live to fight another day.\"\n"
msgstr "@The_monster@喊道：“你救了我！”\n\n@The_monster@说：“你果然就是救世主。”\n\n@The_monster@感谢你让@objective@重获生命。\n\n@The_monster@说：“我就知道你靠得住。”\n\n@The_monster@说：“现在我又能活着继续战斗了。”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_reaction_battle_follower"
msgid "@beogh_converted_orc_reaction_battle@\n"
msgstr "@beogh_converted_orc_reaction_battle@\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_speech_battle_follower"
msgid "@beogh_converted_orc_speech_battle@\n"
msgstr "@beogh_converted_orc_speech_battle@\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:beogh_converted_orc_speech_vengeance_follower"
msgid "@beogh_converted_orc_speech_vengeance@\n"
msgstr "@beogh_converted_orc_speech_vengeance@\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:orc_priest_apostate"
msgid "The priest shouts, \"Disloyal scoundrel, leave my sight!\"\n\nThe priest snarls, \"I'll spare you only if you run away! Begone!\"\n\nThe priest curses, \"Your faithless show of piety disgusts me!\"\n\nThe priest sneers, \"Beogh may forgive you, but I don't!\"\n\nThe priest shouts, \"You had your chance, apostate scum!\"\n"
msgstr "祭司喊道：“背信弃义的无赖，滚出我的视线！”\n\n祭司龇牙低吼：“赶紧逃，我才饶你一命！滚！”\n\n祭司咒骂道：“你这毫无信仰的虔诚作态让我恶心！”\n\n祭司冷笑道：“比欧弗或许会原谅你，我可不会！”\n\n祭司喊道：“你已经有过机会了，叛教的败类！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:orc_priest_preaching"
msgid "@The_monster@ shouts, \"Beogh offers mercy even to people such as you. Join us and be reborn!\"\n\n@The_monster@ shouts, \"The Pantheon deserves no one's loyalty. Let us show you the true path!\"\n\n@The_monster@ shouts, \"Surrender to Beogh and we'll let you live!\"\n\n@The_monster@ threatens, \"Beogh's wrath is as vast as Beogh's mercy. Make your choice!\"\n"
msgstr "@The_monster@喊道：“即便是你这样的人，比欧弗也愿施以仁慈。加入我们，获得新生！”\n\n@The_monster@喊道：“那些神都不值得效忠。让我们指引你走上正道！”\n\n@The_monster@喊道：“向比欧弗投降，我们就饶你一命！”\n\n@The_monster@威胁道：“比欧弗的神怒与仁慈同样无边无际。做出选择吧！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:orc_apostle_yield"
msgid "@The_monster@ shouts, \"I yield! You are indeed the chosen one!\"\n\n@The_monster@ shouts, \"I yield! Victory is yours!\"\n\n@The_monster@ falls to @possessive@ knees and submits.\n"
msgstr "@The_monster@喊道：“我认输！你果然是天选之人！”\n\n@The_monster@喊道：“我认输！胜利属于你！”\n\n@The_monster@屈下@possessive@双膝，俯首归顺。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:orc_apostle_dismissed"
msgid "@The_monster@ says, \"I will never forget you!\"\n\n@The_monster@ leaves to spread the word of Beogh to the surface.\n\n@The_monster@ salutes you before departing.\n"
msgstr "@The_monster@说：“我永远不会忘记你！”\n\n@The_monster@离去，前往地表传播比欧弗的教诲。\n\n@The_monster@离开前向你致敬。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:orc_apostle_unbanished"
msgid "VISUAL:@The_monster@ pulls a severed tentacle out of their boot and sighs heavily.\n\n@The_monster@ grins, \"Not even the Unformed can stop the chosen ones of Beogh!\"\n\n@The_monster@ shouts triumpantly, \"Who's laughing NOW?\"\n\n@The_monster@ shudders. \"I think my head was attached to my elbow for a minute there...\"\n\n@The_monster@ says, \"I don't think I'll ever look at the stars the same way again.\"\n\n@The_monster@ yells, \"Just try that again; I dare you!\"\n\nw:1\n@The_monster@ gibbers softly, \"It was just one butterfly....\"\n\nVISUAL:@The_monster@ wobbles unsteadily, but gives you a thumbs up.\n"
msgstr "VISUAL:@The_monster@从靴子里拽出一截断掉的触手，重重叹了口气。\n\n@The_monster@咧嘴笑道：“就连无定形者也阻挡不了比欧弗的天选之人！”\n\n@The_monster@得意地喊道：“现在轮到谁笑了？”\n\n@The_monster@打了个寒战，说：“刚才有那么一会儿，我的脑袋好像长在了胳膊肘上……”\n\n@The_monster@说：“我想，我再也无法像以前那样看待星辰了。”\n\n@The_monster@大喊：“有种就再试一次！”\n\nw:1\n@The_monster@轻声胡言乱语：“明明只是一只蝴蝶……”\n\nVISUAL:@The_monster@摇摇晃晃，站立不稳，却仍向你竖起大拇指。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:friendly bfb orc"
msgid "@The_monster@ shouts, \"Vengeance for the fallen!\"\n\n@The_monster@ shouts, \"Blood calls out to blood!\"\n\n@The_monster@ cries, \"Kill them all! Beogh will know Beogh's own!\"\n\n@The_monster@ beats @possessive@ weapon against @possessive@ chest and roars.\n\n@The_monster@ cries out, \"For our kin! And for all that died before them!\"\n\n@The_monster@ smears @possessive@ weapon with vermillion and lifts it high.\n\n@The_monster@ shouts, \"Eye for eye, tooth for tooth, life for life!\"\n\n@The_monster@ cries, \"Return their pain upon them a hundredfold!\"\n"
msgstr "@The_monster@喊道：“为死去的同胞复仇！”\n\n@The_monster@喊道：“鲜血呼唤鲜血！”\n\n@The_monster@高呼：“把他们全杀了！比欧弗自会认出自己的信徒！”\n\n@The_monster@用@possessive@武器敲打@possessive@胸膛，发出咆哮。\n\n@The_monster@高呼：“为了我们的同胞！为了此前所有的死者！”\n\n@The_monster@将@possessive@武器涂上朱红，高高举起。\n\n@The_monster@喊道：“以眼还眼，以牙还牙，以命抵命！”\n\n@The_monster@高呼：“把他们施加的痛苦百倍奉还！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:cherub"
msgid "@The_monster@ sings praise to the Shining One, in four-part harmony.\n\n@The_monster_possessive@ lion-head roars!\n\n@The_monster_possessive@ eagle-head screeches!\n\n@The_monster@ sings praise to Zin.\n\n@The_monster@ sings praise to Elyvilon.\n"
msgstr "@The_monster@以四部和声歌颂光明神。\n\n@The_monster_possessive@狮头发出咆哮！\n\n@The_monster_possessive@鹰头发出尖啸！\n\n@The_monster@歌颂辛。\n\n@The_monster@歌颂艾利维隆。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:zin angel"
msgid "w:40\n@The_monster@ recites @_axioms_of_law_@\n\n@The_monster@ recites @_recite_what_@ @_recite_subject_@\n\n@The_monster@ preaches about @_recite_subject_@\n\n@The_monster@ @_recites_start_@ a @_lecture_modifier_@ lecture about @_recite_subject_@\n\n@The_monster@ explains in detail about @_recite_subject_@\n\n@The_monster@ explains the importance of @_important_subject_@\n\n@The_monster@ @_recites_start_@ a @_lecture_modifier_@ sermon about @_recite_subject_@\n\n@The_monster@ @_recites_start_@ a @_lecture_modifier_@ speech about @_recite_subject_@\n\nw:5\n@The_monster@ speaks about @_recite_subject_@\n"
msgstr "w:40\n@The_monster@诵读@_axioms_of_law_@\n\n@The_monster@吟诵@_recite_what_@@_recite_subject_@\n\n@The_monster@宣讲@_recite_subject_@\n\n@The_monster@@_recites_start_@发表一场@_lecture_modifier_@演讲，主题是@_recite_subject_@\n\n@The_monster@详细阐述@_recite_subject_@\n\n@The_monster@解释了以下事项的重要性：@_important_subject_@\n\n@The_monster@@_recites_start_@进行一场@_lecture_modifier_@布道，主题是@_recite_subject_@\n\n@The_monster@@_recites_start_@发表一场@_lecture_modifier_@讲话，主题是@_recite_subject_@\n\nw:5\n@The_monster@谈论@_recite_subject_@\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_recites_start_"
msgid "begins\n\nlaunches into\n\nembarks on\n"
msgstr "开始\n\n着手\n\n开始着手\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_recite_what_"
msgid "a poem about\n\nthe sacred texts on\n\nthe word of Zin on\n\nsonorously on\n\nloudly on\n"
msgstr "有关以下主题的诗歌：\n\n有关以下主题的经文：\n\n辛对以下事项的教诲：\n\n，声音洪亮，主题是\n\n，声音响亮，主题是\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_lecture_modifier_"
msgid "lengthy\n\npassionate\n\nrighteous\n\nstern\n"
msgstr "冗长的\n\n慷慨激昂的\n\n义正词严的\n\n严厉的\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_recite_subject_"
msgid "w:120\n@_important_subject_@\n\nw:80\n@_axioms_of_law_@\n\nthe Law and the prophets.\n\nthe importance of the Law.\n\nmutations, and how to avoid them.\n\npotions of mutation - the devil's brew!\n\nneqoxecs and zykzyls - may they all be destroyed!\n\na proper diet respecting intelligent beings.\n\nthe evils of necromancy.\n\nthe lawlessness of gambling.\n\nundead, and why they are evil.\n\nthe fall of Yredelemnul.\n\nthe reprobation of Lugonu.\n\nthe alliance of Zin and the Shining One.\n\nthe alliance of Zin and Elyvilon.\n\nthe lawlessness of @random_god_chaotic@.\n\nthe evilness of @random_god_evil@.\n\nthe goodness of @random_god_good@.\n"
msgstr "w:120\n@_important_subject_@\n\nw:80\n@_axioms_of_law_@\n\n律法与先知。\n\n律法的重要性。\n\n变异，以及如何避免变异。\n\n变异药水——魔鬼的酿造物！\n\n涅克索克与兹克兹尔——愿它们全部毁灭！\n\n尊重智慧生灵的正确饮食。\n\n死灵系魔法的邪恶。\n\n赌博的无法无天。\n\n亡灵，以及它们为何邪恶。\n\n伊莱德莱姆努尔的堕落。\n\n卢戈努的邪恶。\n\n辛与光明神的联盟。\n\n辛与艾利维隆的联盟。\n\n@random_god_chaotic@的无法无天。\n\n@random_god_evil@的邪恶。\n\n@random_god_good@的良善。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:confused zin angel"
msgid "@The_monster@ rambles incoherently.\n\n@The_monster@ lectures the ground at length about @_important_subject_@\n\n@The_monster@ lectures @possessive@ feet at length about @_important_subject_@\n\nVISUAL:@The_monster@ stares off into space for a moment.\n"
msgstr "@The_monster@语无伦次地絮叨着。\n\n@The_monster@对着地面长篇大论，谈论@_important_subject_@\n\n@The_monster@对着@possessive@双脚长篇大论，谈论@_important_subject_@\n\nVISUAL:@The_monster@朝着虚空发了一会儿呆。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:silenced zin angel"
msgid "VISUAL:@The_monster@ gestures @at_foe@ frantically.\n\nVISUAL:@The_monster@ looks angrily to the heavens.\n\nVISUAL:@The_monster@ furiously gestures all around.\n\nVISUAL:@The_monster@ scowls with righteous anger.\n"
msgstr "VISUAL:@The_monster@朝@at_foe@疯狂地打着手势。\n\nVISUAL:@The_monster@愤怒地仰望天空。\n\nVISUAL:@The_monster@愤怒地朝四周比划。\n\nVISUAL:@The_monster@义愤填膺地皱起眉头。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:deformed humanoid"
msgid "VISUAL:@The_monster@ howls in pain.\n\nVISUAL:@The_monster@ wails in agony.\n\nVISUAL:@The_monster@ weeps.\n\nVISUAL:@The_monster@ sobs.\n\n@The_monster@ screams, \"The pain, the pain!\"\n\nVISUAL:@The_monster@ begins coughing up blood.\n\n@The_monster@ yells, \"Please, just kill me!\"\n\nw:1\nVISUAL:@The_monster@ begins hyperventilating.\n\nVISUAL:@The_monster@ twists in agony.\n\nVISUAL:@The_monster@ stares vacantly at @possessive@ hideously deformed hands.\n\n@The_monster@ asks, \"What has happened to me?\"\n\n@The_monster@ asks, \"What has been done to me?\"\n\nVISUAL:@The_monster@ prays for aid.\n\n@The_monster@ says, \"I think I died... I think I'm dead...\"\n\nw:3\n@The_monster@ wails, \"So itchy! Itchy, itchy, itchy! Always itchy!\"\n\nVISUAL:@The_monster@ gurgles, unable to form words.\n\nw:1\n@The_monster@ yells, \"I will have my revenge on the monster who did this!\"\n\n@The_monster@ mumbles, \"Took all my skin, all gone, all gone...\"\n\n@The_monster@ says, \"I was beautiful once. Now look at me.\"\n\nVISUAL:@The_monster@ wriggles @possessive@ tentacles.\n\nVISUAL:A dozen eyes blink open in @the_monster_possessive@ chest.\n\nVISUAL:Strange appendages sprout from @the_monster_possessive@ back.\n\nVISUAL:@The_monster@ lashes @possessive@ tail.\n\nVISUAL:@The_monster@ suddenly sprouts two large horns!\n\nw:3\nVISUAL:@The_monster_possessive@ flesh secretes a thick mucus.\n\nVISUAL:Hollow, blind eyes appear on @the_monster_possessive@ head.\n\nVISUAL:Suppurating sores blossom under @the_monster_possessive@ eyelids.\n\n@The_monster@ begs you to kill @objective@.\n\nVISUAL:@The_monster@ looks at @possessive@ body and cries without tears.\n\n@The_monster@ screams, \"I am only a sick, bizarre, defaced creation.\"\n"
msgstr "VISUAL:@The_monster@痛苦地嚎叫。\n\nVISUAL:@The_monster@在剧痛中哀号。\n\nVISUAL:@The_monster@哭泣。\n\nVISUAL:@The_monster@啜泣。\n\n@The_monster@尖叫道：“好痛，好痛！”\n\nVISUAL:@The_monster@开始咳血。\n\n@The_monster@大喊：“求你了，杀了我吧！”\n\nw:1\nVISUAL:@The_monster@开始急促地喘息。\n\nVISUAL:@The_monster@痛苦地扭动。\n\nVISUAL:@The_monster@茫然地盯着@possessive@畸形得可怕的双手。\n\n@The_monster@问道：“我到底怎么了？”\n\n@The_monster@问道：“我被弄成了什么样？”\n\nVISUAL:@The_monster@祈求援助。\n\n@The_monster@说：“我想我死过了……我想我已经死了……”\n\nw:3\n@The_monster@哀号：“好痒！痒，痒，痒！一直都痒！”\n\nVISUAL:@The_monster@喉中咕噜作响，无法说出话来。\n\nw:1\n@The_monster@大喊：“我一定要向把我变成这样的怪物复仇！”\n\n@The_monster@含糊地说道：“拿走了我所有的皮，全没了，全没了……”\n\n@The_monster@说：“我曾经很美。再看看我现在。”\n\nVISUAL:@The_monster@蠕动着@possessive@触手。\n\nVISUAL:@the_monster_possessive@胸膛上睁开了十几只眼睛。\n\nVISUAL:奇怪的附肢从@the_monster_possessive@背上长出。\n\nVISUAL:@The_monster@甩动@possessive@尾巴。\n\nVISUAL:@The_monster@突然长出两只巨大的犄角！\n\nw:3\nVISUAL:@The_monster_possessive@肉体分泌出浓稠的黏液。\n\nVISUAL:@the_monster_possessive@头上出现了空洞失明的眼睛。\n\nVISUAL:@the_monster_possessive@眼皮下长出化脓的溃疮。\n\n@The_monster@恳求你杀了@objective@。\n\nVISUAL:@The_monster@望着@possessive@身体，欲哭无泪。\n\n@The_monster@尖叫道：“我不过是个病态、怪异、面目全非的造物。”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:gozag bribe"
msgid "@The_monster@ stares @at_foe@, then turns away, jangling a coin purse.\n"
msgstr "@The_monster@盯着@at_foe@，随后转身离开，钱袋叮当作响。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:gozag permabribe"
msgid "@The_monster@ grins @at_foe@ greedily, jangling a coin purse.\n"
msgstr "@The_monster@贪婪地朝@at_foe@咧嘴一笑，钱袋叮当作响。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:spectator"
msgid "@_spectator_speech_@\n\nw:70\n__NONE\n"
msgstr "@_spectator_speech_@\n\nw:70\n__NONE\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_spectator_speech_"
msgid "@The_monster@ jeers @_loudly_or_repeatedly_@ at you.\n\n@The_monster@ cheers @_loudly_or_repeatedly_@.\n\n@The_monster@ @_shouts_@ with approval.\n\n@The_monster@ @_mutters_@ to another spectator.\n\nVISUAL:@The_monster@ waves excitedly.\n\nw:5\nVISUAL:@The_monster@ waves a pennant with your name on it.\n\nw:5\nVISUAL:@The_monster@ waves a pennant, rooting for your enemy!\n\nw:5\nVISUAL:@The_monster_possessive@ armour gleams in the torchlight.\n\nw:1\nVISUAL:@The_monster@, chosen of Okawaru, glows resplendent with favour.\n"
msgstr "@The_monster@@_loudly_or_repeatedly_@嘲笑你。\n\n@The_monster@@_loudly_or_repeatedly_@欢呼。\n\n@The_monster@赞许地@_shouts_@。\n\n@The_monster@对另一个旁观者@_mutters_@。\n\nVISUAL:@The_monster@兴奋地挥手。\n\nw:5\nVISUAL:@The_monster@挥舞着写有你名字的小旗。\n\nw:5\nVISUAL:@The_monster@挥舞着小旗，为你的敌人助威！\n\nw:5\nVISUAL:@The_monster_possessive@防具在火光中闪耀。\n\nw:1\nVISUAL:@The_monster@蒙受奥格瓦如的眷顾，通体焕发出神恩的光辉。\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:goblin sharper"
msgid "VISUAL:@The_monster@ fiddles with @possessive@ portable altar.\n\nVISUAL:@The_monster@ shuffles one of @possessive@ decks.\n\nVISUAL:@The_monster@ fans some cards from one of @possessive@ decks.\n\nVISUAL:@The_monster_possessive@ deck briefly glows with a rainbow of weird colours.\n\n@The_monster@ chants, \"Know when to hold 'em, know when to fold 'em...\"\n\n@The_monster@ praises @possessive_God@.\n\n@The_monster@ grins. \"So many cards! Brought to you by @my_God@!\"\n\n@The_monster@ refuses insurance.\n\nw:20\n@_deck_of_destruction_line_@\n\nw:20\n@_deck_of_escape_line_@\n\nw:20\n@_deck_of_summoning_line_@\n\nw:10\n@_deck_of_punishment_line_@\n\nw:5\n@The_monster@ draws @_deck_of_oddities_card_@. \"Wait, this doesn't belong here!\"\n\nw:5\n@The_monster@ draws @_misplaced_card_@. \"Wait, where'd this come from?\"\n\nw:5\n@The_monster@ fumbles a card and drops it. \"Whoops!\"\n\nw:1\n@The_monster@ says, \"I wanted to be a wyvern-rider, but @my_God@ had other plans!\"\n"
msgstr "VISUAL:@The_monster@摆弄着@possessive@便携祭坛。\n\nVISUAL:@The_monster@将@possessive@一副套牌洗了洗。\n\nVISUAL:@The_monster@从@possessive@一副套牌中抽出几张牌，展开成扇形。\n\nVISUAL:@The_monster_possessive@套牌短暂地泛起虹彩般的诡异光芒。\n\n@The_monster@吟唱道：“该留牌时就留牌，该弃牌时就弃牌……”\n\n@The_monster@赞颂@possessive_God@。\n\n@The_monster@咧嘴笑道：“这么多牌！都是@my_God@赐予的！”\n\n@The_monster@拒绝购买保险。\n\nw:20\n@_deck_of_destruction_line_@\n\nw:20\n@_deck_of_escape_line_@\n\nw:20\n@_deck_of_summoning_line_@\n\nw:10\n@_deck_of_punishment_line_@\n\nw:5\n@The_monster@抽出了@_deck_of_oddities_card_@，说道：“等等，这张牌不该在这里！”\n\nw:5\n@The_monster@抽出了@_misplaced_card_@，说道：“等等，这张牌从哪来的？”\n\nw:5\n@The_monster@失手掉了一张牌，叫道：“哎呀！”\n\nw:1\n@The_monster@说：“我本想当个双足飞龙骑手，结果@my_God@另有安排！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_deck_of_oddities_card_"
msgid "the Bargain\n\nthe Curse\n\nFamine\n\nFocus\n\nthe Feast\n\nthe Genie\n\nthe Helix\n\nXom\n"
msgstr "交易牌\n\n诅咒牌\n\n饥荒牌\n\n专注牌\n\n盛宴牌\n\n神灯精灵牌\n\n螺旋牌\n\n佐姆牌\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_misplaced_card_"
msgid "the Ace of Spades\n\nthe Joker\n\nthe Old Maid\n\nthe Hanged Man\n\nthe Happy Squirrel\n\nWild Draw Four\n"
msgstr "黑桃王牌\n\n小丑牌\n\n老处女牌\n\n倒吊人牌\n\n快乐松鼠牌\n\n变色加四牌\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_deck_of_destruction_line_"
msgid "@The_monster@ draws Degeneration. \"So many ways to mutate things!\"\n\n@The_monster@ draws the Orb. \"Orbs of destruction hurt!\"\n\n@The_monster@ draws Pain. \"Necromancy hurts!\"\n\n@The_monster@ draws the Storm. \"Thunder and lightning everywhere!\"\n\n@The_monster@ draws Vitriol. \"Acid hurts!\"\n\n@The_monster@ draws Wild Magic. \"So many ways magic can go wrong!\"\n"
msgstr "@The_monster@抽出退化牌，说道：“让东西变异的办法可真多！”\n\n@The_monster@抽出宝珠牌，说道：“毁灭之球可疼了！”\n\n@The_monster@抽出痛苦牌，说道：“死灵系魔法可疼了！”\n\n@The_monster@抽出风暴牌，说道：“到处都是雷电！”\n\n@The_monster@抽出强酸牌，说道：“酸可疼了！”\n\n@The_monster@抽出狂野魔法牌，说道：“魔法出岔子的方式可真多！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_deck_of_escape_line_"
msgid "@The_monster@ draws the Cloud. \"No fresh air for enemies!\"\n\n@The_monster@ draws the Elixir. \"Healing and magic? Woohoo!\"\n\n@The_monster@ draws Exile. \"The Abyss is a horrible place!\"\n\n@The_monster@ draws the Tomb. \"I don't want to be sealed in with no windows!\"\n\n@The_monster@ draws Velocity. \"Know when to walk away, know when to run.\"\n"
msgstr "@The_monster@抽出云雾牌，说道：“让敌人没新鲜空气可吸！”\n\n@The_monster@抽出灵药牌，说道：“治疗加魔力？好耶！”\n\n@The_monster@抽出放逐牌，说道：“深渊可真是个可怕的地方！”\n\n@The_monster@抽出陵墓牌，说道：“我可不想被封在没有窗户的地方！”\n\n@The_monster@抽出迅捷牌，说道：“该走时就走，该跑时就跑。”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_deck_of_summoning_line_"
msgid "@The_monster@ draws the Dance. \"Hope the weapon's aim is true!\"\n\n@The_monster@ draws the Elements. \"Elemental beasts everywhere!\"\n\n@The_monster@ draws the Illusion. \"I have a twin now!\"\n\n@The_monster@ draws the Pentagram. \"Hope the demon is friendly!\"\n\n@The_monster@ draws the Rangers. \"New friends who can shoot!\"\n\n@The_monster@ draws the Swarm. \"Bees, bees everywhere!\"\n"
msgstr "@The_monster@抽出舞蹈牌，说道：“希望这武器打得准！”\n\n@The_monster@抽出元素牌，说道：“到处都是元素野兽！”\n\n@The_monster@抽出幻象牌，说道：“现在我有个双胞胎了！”\n\n@The_monster@抽出五芒星牌，说道：“希望这恶魔是友善的！”\n\n@The_monster@抽出游侠牌，说道：“会射击的新朋友！”\n\n@The_monster@抽出虫群牌，说道：“蜜蜂，到处都是蜜蜂！”\n"

#. Reviewed database-31–33; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_deck_of_punishment_line_"
msgid "@The_monster@ draws the Swine. \"I'm a pig now!\"\n\n@The_monster@ draws Torment. \"Half my health gone? Yikes!\"\n\n@The_monster@ draws the Wraith. \"Draining hurts!\"\n\n@The_monster@ draws Wrath. \"So many ways gods can punish you!\"\n"
msgstr "@The_monster@抽出猪群牌，说道：“我变成猪了！”\n\n@The_monster@抽出折磨牌，说道：“一半生命就这么没了？哎哟！”\n\n@The_monster@抽出怨灵牌，说道：“吸能可疼了！”\n\n@The_monster@抽出神怒牌，说道：“神罚的方式可真多！”\n"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb:database/monspeak.txt:nekomata"
msgid "{{\n  if you.race() == \"Felid\" then\n    return '@The_monster@ grumbles @to_foe@, \"Young upstarts should know their place.\"'\n  else\n    return 'VISUAL:@The_monster@ examines your form and snarls in deep contempt.'\n  end\n}} @player_only@\n\n{{\n  if you.race() == \"Felid\" then\n    return [[@The_monster@ sighs and remarks, \"You haven't even grown your second tail yet.\"]]\n  elseif you.skill(\"Spellcasting\") >= 5 then\n    return 'VISUAL:@The_monster@ scoffs at your paltry magic.'\n  else\n    return 'VISUAL:@The_monster@ regards your strength with dismissive scorn.'\n  end\n}} @player_only@\n\n{{\n  if you.race() == \"Felid\" then\n    return '@The_monster@ advises @to_foe@, \"Grace and deceit. The only things anyone needs.\"'\n  else\n    return 'VISUAL:@The_monster@ briefly ignores you to bat at some conjured hitodama.'\n  end\n}} @player_only@\n\nw:1\n@The_monster@ states, \"It's not just demons who despoil everything they cannot have.\"\n"
msgstr "{{\n  if you.race() == \"Felid\" then\n    return '@The_monster@ grumbles @to_foe@, \"Young upstarts should know their place.\"'\n  else\n    return 'VISUAL:@The_monster@ examines your form and snarls in deep contempt.'\n  end\n}} @player_only@\n\n{{\n  if you.race() == \"Felid\" then\n    return [[@The_monster@ sighs and remarks, \"You haven't even grown your second tail yet.\"]]\n  elseif you.skill(\"Spellcasting\") >= 5 then\n    return 'VISUAL:@The_monster@ scoffs at your paltry magic.'\n  else\n    return 'VISUAL:@The_monster@ regards your strength with dismissive scorn.'\n  end\n}} @player_only@\n\n{{\n  if you.race() == \"Felid\" then\n    return '@The_monster@ advises @to_foe@, \"Grace and deceit. The only things anyone needs.\"'\n  else\n    return 'VISUAL:@The_monster@ briefly ignores you to bat at some conjured hitodama.'\n  end\n}} @player_only@\n\nw:1\n@The_monster@说道：“毁掉自己得不到的一切，可不是恶魔才会干的事。”\n"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ grumbles @to_foe@, \"Young upstarts should know their place.\" @player_only@"
msgstr "@The_monster@对@to_foe@抱怨道：“年轻后辈该知道自己的本分。”@player_only@"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ examines your form and snarls in deep contempt. @player_only@"
msgstr "VISUAL:@The_monster@审视你的身形，极其轻蔑地龇牙低吼。@player_only@"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ sighs and remarks, \"You haven't even grown your second tail yet.\" @player_only@"
msgstr "@The_monster@叹气道：“你连第二条尾巴都还没长出来呢。”@player_only@"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ scoffs at your paltry magic. @player_only@"
msgstr "VISUAL:@The_monster@嗤笑你那微不足道的魔法。@player_only@"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ regards your strength with dismissive scorn. @player_only@"
msgstr "VISUAL:@The_monster@轻蔑地打量你的力量，不屑一顾。@player_only@"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ advises @to_foe@, \"Grace and deceit. The only things anyone needs.\" @player_only@"
msgstr "@The_monster@对@to_foe@告诫道：“优雅与欺骗。有这两样便足矣。”@player_only@"

#. Reviewed database-34; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ briefly ignores you to bat at some conjured hitodama. @player_only@"
msgstr "VISUAL:@The_monster@暂时不再理会你，转而拨弄起幻化出的几团鬼火。@player_only@"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ screams @at_foe@, \"Me learn from your wands next!\" @player_only@"
msgstr "@The_monster@朝@at_foe@尖叫：“接下来，俺要研究你的魔杖！”@player_only@"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ screams @at_foe@, \"You look like good test subject!\" @player_only@"
msgstr "@The_monster@朝@at_foe@尖叫：“你看着是个好实验对象！”@player_only@"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ shouts, \"I *knew* mine was better!\""
msgstr "@The_monster@喊道：“我就知道我的更好！”"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"Progress like this can't be stopped by anyone!\""
msgstr "@The_monster@说：“这样的进步，谁也阻挡不了！”"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ screams @at_foe@, \"Your tough hide won't protect you!\" @player_only@"
msgstr "@The_monster@朝@at_foe@尖叫：“你的厚皮保护不了你！”@player_only@"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ screams @at_foe@, \"Your supposed skill won't protect you!\" @player_only@"
msgstr "@The_monster@朝@at_foe@尖叫：“你那所谓的本事保护不了你！”@player_only@"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ screams @at_foe@, \"Where's your elephant now?!\" @player_only@"
msgstr "@The_monster@朝@at_foe@尖叫：“你的大象现在在哪儿？！”@player_only@"

#. Reviewed database-35; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ screams @at_foe@, \"Where's your power now?!\" @player_only@"
msgstr "@The_monster@朝@at_foe@尖叫：“你的力量现在在哪儿？！”@player_only@"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ looks down at you expectantly."
msgstr "VISUAL:@The_monster@满怀期待地低头看着你。"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ looks up at you expectantly."
msgstr "VISUAL:@The_monster@满怀期待地抬头看着你。"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:A distinct wet dog smell emanates from @the_monster@."
msgstr "VISUAL:@the_monster@身上散发出明显的湿狗气味。"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "VISUAL:@The_monster@ motions as if to dry @reflexive@ off on you."
msgstr "VISUAL:@The_monster@做出要在你身上蹭干@reflexive@的动作。"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"Ah, a wizard! I'll enjoy hearing you beg for your life.\" @player_only@"
msgstr "@The_monster@说：“啊，一位巫师！听你求饶一定很有趣。”@player_only@"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"You're no warrior. You fight like a peasant!\" @player_only@"
msgstr "@The_monster@说：“你算什么勇士。打起架来活像个农夫！”@player_only@"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"In the name of our god, lay down your life!\" @player_only@"
msgstr "@The_monster@说：“以我等神明之名，献出你的生命！”@player_only@"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"Kneel before Makhleb, unbeliever!\" @player_only@"
msgstr "@The_monster@说：“跪拜马科列布，不信者！”@player_only@"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"Ah, a fellow alchemist! Surely you'll appreciate what I've learned here.\" @player_only@"
msgstr "@The_monster@说：“啊，一位炼金术同道！你一定能欣赏我在此学到的东西。”@player_only@"

#. Reviewed database-36; glossary checked; canonical Lua executes once.
msgctxt "textdb-lua:database/monspeak.txt"
msgid "@The_monster@ says, \"Allow me to demonstrate my discoveries.\" @player_only@"
msgstr "@The_monster@说：“请容我展示自己的发现。”@player_only@"

