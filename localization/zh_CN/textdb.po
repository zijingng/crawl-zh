msgctxt "textdb:database/monspeak.txt:_hostile_orc_beogh_unbeliever_speech_common_"
msgid "@The_monster@ @_orc_says_to_foe_@, \"Beogh doesn't tell me what to do!\"\n\n@The_monster@ @_shouts_@ @at_foe@, \"You're not the messiah, I am!\"\n"
msgstr "@The_monster@@_orc_says_to_foe_@道：“比欧弗管不了我！”\n\n@The_monster@朝@at_foe@@_shouts_@道：“你才不是救世主，我才是！”\n"

#. Reviewed database-28–30; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:_hostile_orc_beogh_unbeliever_speech_rare_"
msgid "@The_monster@ @_orc_says_to_foe_@, \"Orcs don't need Beogh!\"\n\n@The_monster@ @_orc_says_to_foe_@, \"Beogh's messiah is just a fairy-tale.\"\n\n@The_monster@ says @to_foe@, \"Even if there were a messiah, it wouldn't be you.\"\n"
msgstr "@The_monster@@_orc_says_to_foe_@道：“兽人不需要比欧弗！”\n\n@The_monster@@_orc_says_to_foe_@道：“比欧弗的救世主不过是个童话。”\n\n@The_monster@对@to_foe@说：“就算真有救世主，也不会是你。”\n"

