msgid "<Elven Halls>\n"
msgstr "<Elven Halls>\n"

msgctxt "textdb:descript/quotes.txt:a staircase to the orcish mines"
msgid "<Orcish Mines>\n"
msgstr "<Orcish Mines>\n"

