msgctxt "textdb:descript/quotes.txt:mad acolyte of lugonu"
msgid ""
"“And when you look long into an abyss, the abyss also looks into you.”\n"
"    -Friedrich Nietzche, “Beyond Good and Evil”. 1886.\n"
msgstr ""
"“当你长久凝视深渊，深渊也在凝视你。”\n"
"    -Friedrich Nietzche, “Beyond Good and Evil”. 1886.\n"

