msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

msgctxt "textdb:database/monspell.txt:searing breath cast"
msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

msgctxt "textdb:database/monspell.txt:unseen searing breath cast"
msgid "@_unseen_breath_cast_@\n"
msgstr "@_unseen_breath_cast_@\n"

msgctxt "textdb:database/monspell.txt:slug dart cast"
msgid "@The_monster@ launches a dart @at@ @target@.\n"
msgstr "@The_monster@@at@@target@发射飞镖。\n"

msgctxt "textdb:database/monspell.txt:spit lava cast"
msgid "@The_monster@ spits lava @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐岩浆。\n"

msgctxt "textdb:database/monspell.txt:spit poison cast"
msgid "@The_monster@ spits poison @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐毒液。\n"

msgctxt "textdb:database/monspell.txt:unseen spit poison cast"
msgid "@_unseen_spit_cast_@\n"
msgstr "@_unseen_spit_cast_@\n"

msgctxt "textdb:database/monspell.txt:splinterspray cast"
msgid "@The_monster@ hurls a spray of @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷射出一片@beam@。\n"

msgctxt "textdb:database/monspell.txt:steam ball natural cast"
msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

msgctxt "textdb:database/monspell.txt:paralysis gaze cast"
msgid "@The_monster@ gazes piercingly through @target@!\n"
msgstr "@The_monster@以锐利目光直视@target@！\n"

msgctxt "textdb:database/monspell.txt:volley of thorns cast"
msgid "@The_monster@ fires a volley of thorns @at@ @target@.\n"
msgstr "@The_monster@@at@@target@齐射出一轮荆棘。\n"

msgctxt "textdb:database/monspell.txt:warning cry cast"
msgid "@The_monster@ howls a warning cry!\n"
msgstr "@The_monster@发出警告的嚎叫！\n"

msgctxt "textdb:database/monspell.txt:unseen warning cry cast"
msgid "You hear a loud warning cry!\n"
msgstr "你听见响亮的警告叫声！\n"

msgctxt "textdb:database/monspell.txt:weakening gaze cast"
msgid "@The_monster@ gazes fiercely through @target@!\n"
msgstr "@The_monster@凶狠地直视@target@！\n"

msgctxt "textdb:database/monspell.txt:woodweal cast"
msgid "@The_monster@ touches a tree and draws upon its vitality.\n"
msgstr "@The_monster@触碰一棵树，汲取其生命力。\n"

msgctxt "textdb:database/monspell.txt:seismic stomp cast"
msgid "@The_monster@ stomps @possessive@ heavy feet.\n"
msgstr "@The_monster@跺下@possessive@沉重双脚。\n"

msgctxt "textdb:database/monspell.txt:hurl torchlight cast"
msgid "@The_monster@ raises the black torch.\n"
msgstr "@The_monster@举起黑炬。\n"

msgctxt "textdb:database/monspell.txt:landbreaker natural cast"
msgid "@The_monster@ fractures the ground with @possessive@ footsteps.\n"
msgstr "@The_monster@用@possessive@脚步震裂地面。\n"

msgctxt "textdb:database/monspell.txt:ensnare arachne cast"
msgid "@The_monster@ points @possessive@ staff @at@ @target@, shooting a stream of webbing.\n\n@The_monster_possessive@ staff shoots out a stream of webbing.\n"
msgstr "@The_monster@用@possessive@法杖@at@@target@一指，射出一股蛛丝。\n\n@The_monster_possessive@法杖射出一股蛛丝。\n"

msgctxt "textdb:database/monspell.txt:unseen ensnare arachne cast"
msgid "A stream of webbing shoots out from thin air.\n"
msgstr "一股蛛丝凭空射出。\n"

msgctxt "textdb:database/monspell.txt:march of sorrows boris cast"
msgid "@The_monster@ [casts|pitches] forth @possessive@ victims' sorrows.\n\nw:5\n@The_monster@ rolls out @possessive@ victims' [laments|suffering].\n"
msgstr "@The_monster@[投出|掷出]@possessive@受害者的悲伤。\n\nw:5\n@The_monster@倾泻出@possessive@受害者的[哀叹|苦难]。\n"

msgctxt "textdb:database/monspell.txt:doomsaying cassandra cast"
msgid "@The_monster@ says, \"I have seen your future, @player_name@! Turn back before you are forced to see it for yourself!\"\n"
msgstr "@The_monster@说：“我已经看见了你的未来，@player_name@！快回头吧，别等到不得不亲眼见证！”\n"

msgctxt "textdb:database/monspell.txt:cantrip dissolution cast"
msgid "@The_monster@ gurgles to an absent god.\n\n@The_monster@ jiggles mournfully.\n\n@The_monster@ wobbles aimlessly.\n\n@The_monster@ says, \"Become one with my sorrow!\"\n\nw:1\n@The_monster@ asks, \"Why have you forsaken me @My_God@?\"\n"
msgstr "@The_monster@向一位缺席的神咕噜低语。\n\n@The_monster@悲哀地抖动。\n\n@The_monster@漫无目的地摇晃。\n\n@The_monster@说：“与我的悲伤融为一体吧！”\n\nw:1\n@The_monster@问：“@My_God@啊，你为何抛弃了我？”\n"

msgctxt "textdb:database/monspell.txt:summon eyeballs dissolution cast"
msgid "@The_monster@ gurgles deeply, a call to fellow slimes.\n\n@The_monster@ says, \"@My_God@ sees all!\"\n"
msgstr "@The_monster@低沉地咕噜作响，呼唤黏液同伴。\n\n@The_monster@说：“@My_God@洞察一切！”\n"

msgctxt "textdb:database/monspell.txt:dissolution cast"
msgid "@The_monster@ gurgles deeply.\n"
msgstr "@The_monster@低沉地咕噜作响。\n"

msgctxt "textdb:database/monspell.txt:frances cast"
msgid "@The_monster@ mutters in a terrible tongue.\n\n@The_monster@ whispers indecipherable words.\n\n@The_monster@ chants phrases taken from a devil's mouth.\n\n@The_monster@ screams a word of power!\n"
msgstr "@The_monster@用可怕的语言低声念咒。\n\n@The_monster@低语着无法理解的话。\n\n@The_monster@吟诵从魔鬼口中学来的词句。\n\n@The_monster@尖声喊出一句威能之语！\n"

msgctxt "textdb:database/monspell.txt:cantrip gastronok cast"
msgid "@The_monster@ bubbles merrily.\n\nVISUAL:@The_monster@ glows a brilliant shade of cerise.\n\nVISUAL:@The_monster@ wobbles crazily.\n\nVISUAL:@The_monster_possessive@ eyestalks stretch out, then return to normal size.\n\nYou wobble.\n\nYou take on a slight green cast.\n\nYou feel briefly sluggish.\n\nYou feel a sudden, passing aversion to salt.\n\nw:5\nYou feel a sudden urge to swivel your nonexistent eyestalks around.\n"
msgstr "@The_monster@欢快地冒出气泡。\n\nVISUAL:@The_monster@发出明亮的樱桃红色光芒。\n\nVISUAL:@The_monster@疯狂地摇晃。\n\nVISUAL:@The_monster_possessive@眼柄伸长，随后恢复原样。\n\n你摇晃起来。\n\n你略微泛起绿意。\n\n你短暂地感到迟钝。\n\n你突然对盐产生了一闪而过的厌恶。\n\nw:5\n你突然想转动自己并不存在的眼柄。\n"

msgctxt "textdb:database/monspell.txt:gastronok cast targeted"
msgid "@The_monster@ looks @at@ @target@ while chanting.\n\n@The_monster@ looks @at@ @target@ and mumbles some strange words.\n\n@The_monster@ casts a spell @at@ @target@.\n"
msgstr "@The_monster@一边吟唱，一边@at@@target@望去。\n\n@The_monster@@at@@target@望去，含糊地念着古怪的话。\n\n@The_monster@@at@@target@施放法术。\n"

msgctxt "textdb:database/monspell.txt:gastronok cast"
msgid "@The_monster_possessive@ eyestalks quiver as @subjective@ mumbles some strange words.\n\n@The_monster@ chants a spell, wobbling all the while.\n\n@The_monster@ mumbles some strange words.\n\n@The_monster@ casts a spell.\n"
msgstr "@The_monster_possessive@眼柄微颤，@subjective@含糊地念着古怪的话。\n\n@The_monster@摇摇晃晃地吟诵法术。\n\n@The_monster@含糊地念着古怪的话。\n\n@The_monster@施放了一个法术。\n"

msgctxt "textdb:database/monspell.txt:geryon cast"
msgid "@The_monster@ winds a great silver horn.\n"
msgstr "@The_monster@吹响一支巨大的银号角。\n"

msgctxt "textdb:database/monspell.txt:unseen geryon cast"
msgid "You hear a weird and mournful sound.\n"
msgstr "你听见一种古怪而哀伤的声音。\n"

msgctxt "textdb:database/monspell.txt:smiting jeremiah cast"
msgid "@The_monster@ lets out a twisted cry.\n\n@The_monster@ mumbles a slurred invocation.\n\nVISUAL:@The_monster@ throws @possessive@ arms up pleadingly.\n\n@The_monster@ cries, \"Fearful master, protect me!\"\n\n@The_monster@ shouts, \"O dreadful one, destroy my foe!\"\n"
msgstr "@The_monster@发出扭曲的哭喊。\n\n@The_monster@含糊不清地念出祷词。\n\nVISUAL:@The_monster@乞求般举起@possessive@双臂。\n\n@The_monster@哭喊：“可畏的主人，保护我！”\n\n@The_monster@高喊：“可怖者啊，摧毁我的敌人！”\n"

msgctxt "textdb:database/monspell.txt:mennas cast"
msgid "VISUAL:@The_monster@ gestures frantically.\n"
msgstr "VISUAL:@The_monster@疯狂地打着手势。\n"

msgctxt "textdb:database/monspell.txt:vanquished vanguard nergalle cast"
msgid "@The_monster@ calls out: \"@orc name@, @orc name@, @orc name@ - to me!\"\n\n@The_monster@ cries out, \"Spectres! Fight for the home you helped make!\"\n"
msgstr "@The_monster@呼唤：“@orc name@、@orc name@、@orc name@——到我身边来！”\n\n@The_monster@高喊：“幽魂们！为你们参与建立的家园而战！”\n"

msgctxt "textdb:database/monspell.txt:primal wave norris cast"
msgid "@The_monster@ invokes the aid of something beyond life against @target@.\n\n@The_monster@ calmly calls forth the wrath of something past death upon @target@.\n\n@The_monster@ prays to the universe for peace to reach @target@.\n"
msgstr "@The_monster@祈求超越生命之物的援助，对抗@target@。\n\n@The_monster@平静地向@target@唤来死后之物的愤怒。\n\n@The_monster@向宇宙祈祷，愿安宁降临@target@。\n"

msgctxt "textdb:database/monspell.txt:antimagic gaze norris cast"
msgid "Something numinous underneath @the_monster_possessive@ waves suddenly gazes at @target@.\n\n@The_monster_possessive@ eyes shimmer, overwhelming @target@ with visions from beyond.\n"
msgstr "@the_monster_possessive@波涛下，某种神秘存在突然凝视@target@。\n\n@The_monster_possessive@双眼微光闪烁，让@target@被彼岸的幻景淹没。\n"

msgctxt "textdb:database/monspell.txt:roxanne cast"
msgid "@sphinx cast@\n"
msgstr "@sphinx cast@\n"

msgctxt "textdb:database/monspell.txt:silent berserker rage rupert cast"
msgid "@The_monster@ flies into a rage!\n"
msgstr "@The_monster@陷入狂怒！\n"

msgctxt "textdb:database/monspell.txt:berserker rage rupert cast"
msgid "@The_monster@ roars madly and goes into a rage!\n"
msgstr "@The_monster@疯狂咆哮，陷入狂怒！\n"

msgctxt "textdb:database/monspell.txt:rupert cast targeted"
msgid "@The_monster@ roars wildly @at@ @target@.\n\n@The_monster@ yells loudly @at@ @target@.\n"
msgstr "@The_monster@@at@@target@狂野地咆哮。\n\n@The_monster@@at@@target@大声吼叫。\n"

msgctxt "textdb:database/monspell.txt:vv cast"
msgid "VISUAL:@The_monster@ gestures sharply.\n\nVISUAL:@The_monster@ stamps @possessive@ foot.\n\nVISUAL:@The_monster@ slams @possessive@ palms together.\n\nw:3\nVISUAL:@The_monster@ makes an elaborate arcing motion.\n"
msgstr "VISUAL:@The_monster@猛然打出手势。\n\nVISUAL:@The_monster@跺下@possessive@脚。\n\nVISUAL:@The_monster@将@possessive@双掌重重合拢。\n\nw:3\nVISUAL:@The_monster@做出一个复杂的弧形动作。\n"

msgctxt "textdb:database/monspell.txt:unseen vv cast"
msgid "You hear the sound of rock striking rock.\n"
msgstr "你听见岩石撞击岩石的声音。\n"

msgctxt "textdb:database/monspell.txt:hellfire mortar wiglaf cast"
msgid "VISUAL:@The_monster@ slams @possessive@ weapon against the ground.\n\n@The_monster@ shouts @at@ @foe@, \"Taste the blood o the mountain!\"\n\n@The_monster@ roars @at@ @foe@, \"Let me show ye whit a REAL cannon looks like!\"\n"
msgstr "VISUAL:@The_monster@将@possessive@武器重重砸向地面。\n\n@The_monster@@at@@foe@高喊：“尝尝高山之血的滋味！”\n\n@The_monster@@at@@foe@咆哮：“让俺给你瞧瞧啥叫真正的大炮！”\n"

msgctxt "textdb:database/monspell.txt:paralyse xtahua cast"
msgid "@The_monster@ roars overwhelmingly @at@ @target@!\n\n@The_monster@ thunders ferociously @at@ @target@!\n"
msgstr "@The_monster@@at@@target@发出压倒性的咆哮！\n\n@The_monster@@at@@target@发出凶猛的雷鸣般怒吼！\n"

msgctxt "textdb:database/monspell.txt:basilisk cast targeted"
msgid "@floating eye cast targeted@\n"
msgstr "@floating eye cast targeted@\n"

msgctxt "textdb:database/monspell.txt:basilisk cast"
msgid "@floating eye cast@\n"
msgstr "@floating eye cast@\n"

msgctxt "textdb:database/monspell.txt:bes kemwar cast"
msgid "@The_monster@ writhes about, and something writhes within @target@.\n"
msgstr "@The_monster@扭动起来，@target@体内也有东西在扭动。\n"

msgctxt "textdb:database/monspell.txt:airstrike blizzard demon cast"
msgid "@The_monster@ lashes out with icy intensity.\n\n@The_monster@ gestures with frozen lightning.\n\n@The_monster@ waves @possessive@ @arms@ in writhing circles.\n"
msgstr "@The_monster@带着冰寒之力猛然出击。\n\n@The_monster@以冻结的闪电打出手势。\n\n@The_monster@挥动@possessive@@arms@，画出扭曲的圆圈。\n"

msgctxt "textdb:database/monspell.txt:silent blizzard demon cast"
msgid "@The_monster@ lashes out with icy intensity.\n\n@The_monster@ gestures with frozen lightning.\n"
msgstr "@The_monster@带着冰寒之力猛然出击。\n\n@The_monster@以冻结的闪电打出手势。\n"

msgctxt "textdb:database/monspell.txt:blizzard demon cast"
msgid "@The_monster@ crackles with melancholic malice.\n\n@The_monster@ roars with sorrowful spite.\n"
msgstr "@The_monster@伴着忧郁的恶意噼啪作响。\n\n@The_monster@带着悲哀的怨毒咆哮。\n"

msgctxt "textdb:database/monspell.txt:bombardier beetle cast"
msgid "@The_monster@ sprays incendiary fluid @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷洒燃烧液。\n"

msgctxt "textdb:database/monspell.txt:march of sorrows bone dragon cast"
msgid "@The_monster@ breathes [collective despair|endless sorrows] @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐[众生的绝望|无尽的悲伤]。\n"

msgctxt "textdb:database/monspell.txt:brain worm cast"
msgid "@The_monster_possessive@ bulging head throbs.\n\n@The_monster_possessive@ throbbing head pulsates.\n"
msgstr "@The_monster_possessive@鼓胀头颅搏动起来。\n\n@The_monster_possessive@悸动头颅一阵阵脉动。\n"

msgctxt "textdb:database/monspell.txt:burial acolyte cast"
msgid "@The_monster@ [drones|recites] a funeral chant.\n"
msgstr "@The_monster@[低吟|诵念]葬礼祷歌。\n"

msgctxt "textdb:database/monspell.txt:battlecry cherub cast"
msgid "@The_monster@ sings a powerful hymn!\n"
msgstr "@The_monster@唱起强有力的赞美诗！\n"

msgctxt "textdb:database/monspell.txt:beckoning gale chonchon cast"
msgid "@The_monster@ chants while flapping @possessive@ wings @at@ @target@.\n\nw:5\n@The_monster@ screeches @at@ @target@ while spinning and swirling.\n"
msgstr "@The_monster@一边吟唱，一边@at@@target@扇动@possessive@翅膀。\n\nw:5\n@The_monster@旋转盘旋，@at@@target@尖叫。\n"

msgctxt "textdb:database/monspell.txt:cognitogaunt cast"
msgid "@The_monster@ glimmers violently.\n"
msgstr "@The_monster@剧烈地闪烁微光。\n"

msgctxt "textdb:database/monspell.txt:clockroach cast"
msgid "@The_monster@ sprays sand from its hourglass @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷出沙漏中的沙子。\n"

msgctxt "textdb:database/monspell.txt:crystal echidna cast targeted"
msgid "@The_monster@ flicks its quills @at@ @target@.\n"
msgstr "@The_monster@@at@@target@弹射棘刺。\n"

msgctxt "textdb:database/monspell.txt:crystallising shot crystal guardian cast"
msgid "@The_monster@ fires a shard of @reflexive@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@射出一块@reflexive@的碎片。\n"

msgctxt "textdb:database/monspell.txt:culicivora cast targeted"
msgid "@The_monster@ chitters @at@ @target@.\n"
msgstr "@The_monster@@at@@target@吱吱作响。\n"

msgctxt "textdb:database/monspell.txt:curse skull cast"
msgid "@The_monster@ rattles @possessive@ jaw.\n"
msgstr "@The_monster@使@possessive@下颌咯咯作响。\n"

msgctxt "textdb:database/monspell.txt:silent curse skull cast"
msgid "@The_monster@ rattles @possessive@ jaw silently.\n"
msgstr "@The_monster@无声地震动@possessive@下颌。\n"

msgctxt "textdb:database/monspell.txt:unseen curse skull cast"
msgid "You hear the clattering of teeth.\n"
msgstr "你听见牙齿相碰的咯咯声。\n"

msgctxt "textdb:database/monspell.txt:minor healing dryad cast"
msgid "@The_monster@ draws upon the vitality of nature.\n"
msgstr "@The_monster@汲取自然的生命力。\n"

msgctxt "textdb:database/monspell.txt:dryad cast"
msgid "@The_monster@ calls out to the forest.\n"
msgstr "@The_monster@向森林呼唤。\n"

msgctxt "textdb:database/monspell.txt:eidolon cast targeted"
msgid "@The_monster@ stares piercingly @at@ @target@.\n"
msgstr "@The_monster@@at@@target@投去锐利的凝视。\n"

msgctxt "textdb:database/monspell.txt:lightning bolt electric golem cast"
msgid "@The_monster@ hurls @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@投出@beam@。\n"

msgctxt "textdb:database/monspell.txt:primal wave elemental wellspring cast"
msgid "A torrent of water rises up through @the_monster@!\n"
msgstr "一股激流从@the_monster@中涌起！\n"

msgctxt "textdb:database/monspell.txt:summon water elementals elemental wellspring cast"
msgid "Water spirits pour forth from @the_monster@!\n"
msgstr "水之精魂从@the_monster@中涌出！\n"

msgctxt "textdb:database/monspell.txt:eye of draining cast"
msgid "@The_monster@ smirks and gazes @at@ @target@.\n"
msgstr "@The_monster@露出得意神色，@at@@target@凝视。\n"

msgctxt "textdb:database/monspell.txt:flayed ghost cast"
msgid "@The_monster@ stares @at@ @foe@ with tortured malice.\n\n@The_monster@ cries, \"Suffer as I suffered!\"\n\n@The_monster@ cries, \"Feel what I felt!\"\n"
msgstr "@The_monster@@at@@foe@投去饱受折磨的恶意凝视。\n\n@The_monster@哭喊：“承受我受过的苦吧！”\n\n@The_monster@哭喊：“体会我尝过的痛吧！”\n"

msgctxt "textdb:database/monspell.txt:silent flayed ghost cast"
msgid "@The_monster@ moans in silent anguish.\n\n@The_monster@ stares @at@ @foe@ with tortured malice.\n"
msgstr "@The_monster@在无声的痛苦中呻吟。\n\n@The_monster@@at@@foe@投去饱受折磨的恶意凝视。\n"

msgctxt "textdb:database/monspell.txt:formless jellyfish cast"
msgid "@The_monster@ shimmers eerily.\n"
msgstr "@The_monster@诡异地闪烁微光。\n"

msgctxt "textdb:database/monspell.txt:summon mortal champion fravashi cast"
msgid "@The_monster@ beckons forth its champion.\n"
msgstr "@The_monster@召来自己的勇士。\n"

msgctxt "textdb:database/monspell.txt:stone arrow gargoyle cast"
msgid "@The_monster@ hurls a @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@投出一枚@beam@。\n"

msgctxt "textdb:database/monspell.txt:ghost moth cast"
msgid "@The_monster@ looks around.\n"
msgstr "@The_monster@环顾四周。\n"

msgctxt "textdb:database/monspell.txt:ghost moth cast targeted"
msgid "@The_monster@ stares @at@ @target@.\n"
msgstr "@The_monster@@at@@target@凝视。\n"

msgctxt "textdb:database/monspell.txt:unseen ghost moth cast targeted"
msgid "You feel you are being watched by something. @player_only@\n"
msgstr "你觉得有东西在注视自己。@player_only@\n"

msgctxt "textdb:database/monspell.txt:glowing orange brain cast"
msgid "@The_monster@ pulsates.\n"
msgstr "@The_monster@搏动起来。\n"

msgctxt "textdb:database/monspell.txt:golden eye cast targeted"
msgid "@The_monster@ blinks @at@ @target@.\n"
msgstr "@The_monster@@at@@target@眨眼。\n"

msgctxt "textdb:database/monspell.txt:guardian serpent cast targeted"
msgid "@The_monster@ coils @reflexive@ and waves @possessive@ upper body @at@ @target@.\n\n@The_monster@ gestures with @possessive@ tail @at@ @target@.\n\nw:3\n@The_monster@ weaves intricate patterns with the tip of @possessive@ tongue.\n"
msgstr "@The_monster@盘起@reflexive@，@at@@target@挥动@possessive@上半身。\n\n@The_monster@@at@@target@以@possessive@尾巴打出手势。\n\nw:3\n@The_monster@用@possessive@舌尖织出复杂的图案。\n"

msgctxt "textdb:database/monspell.txt:guardian serpent cast"
msgid "@The_monster@ casts a spell.\n"
msgstr "@The_monster@施放了一个法术。\n"

msgctxt "textdb:database/monspell.txt:fireball hell hog cast"
msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

msgctxt "textdb:database/monspell.txt:beckoning gale hippogriff cast"
msgid "@The_monster@ flaps @possessive@ wings @at@ @target@.\n"
msgstr "@The_monster@@at@@target@扇动@possessive@翅膀。\n"

msgctxt "textdb:database/monspell.txt:warning cry hippogriff cast"
msgid "@The_monster@ screeches a warning cry!\n"
msgstr "@The_monster@发出警告的尖叫！\n"

msgctxt "textdb:database/monspell.txt:unseen warning cry howler monkey cast"
msgid "You hear a tremendous hooting and howling!\n"
msgstr "你听见震耳的呼叫和嚎声！\n"

msgctxt "textdb:database/monspell.txt:warning cry howler monkey cast"
msgid "@The_monster@ hoots and howls with incredible vigour!\n"
msgstr "@The_monster@精力充沛地呼叫嚎叫！\n"

msgctxt "textdb:database/monspell.txt:blink range ironbound thunderhulk cast"
msgid "Strange energies crackle from @the_monster_possessive@ apparatus.\n"
msgstr "奇异能量从@the_monster_possessive@装置中噼啪迸出。\n"

msgctxt "textdb:database/monspell.txt:kobold blastminer cast targeted"
msgid "@The_monster@ blasts @possessive@ cannon @at@ @target@.\n"
msgstr "@The_monster@@at@@target@发射@possessive@大炮。\n"

msgctxt "textdb:database/monspell.txt:awaken flesh kobold fleshcrafter cast"
msgid "@The_monster@ cackles and gestures.\n\n@The_monster@ chants and writhes.\n"
msgstr "@The_monster@一边怪笑，一边打着手势。\n\n@The_monster@一边吟唱，一边扭动。\n"

msgctxt "textdb:database/monspell.txt:bolt of flesh kobold fleshcrafter cast"
msgid "@The_monster@ weaves a wave of flesh @at@ @target@.\n"
msgstr "@The_monster@@at@@target@编织出一道血肉浪潮。\n"

msgctxt "textdb:database/monspell.txt:laughing skull cast"
msgid "@The_monster@ cackles spitefully.\n\n@The_monster@ gibbers with scorn.\n\n@The_monster@ lets out a vicious peal of laughter.\n"
msgstr "@The_monster@怨毒地怪笑。\n\n@The_monster@轻蔑地胡言乱语。\n\n@The_monster@发出一阵恶毒的狂笑。\n"

msgctxt "textdb:database/monspell.txt:silent laughing skull cast"
msgid "@The_monster@ mockingly cackles in silence.\n\n@The_monster@ violently rattles with glee.\n"
msgstr "@The_monster@无声地发出嘲弄的怪笑。\n\n@The_monster@欣喜若狂地剧烈震颤。\n"

msgctxt "textdb:database/monspell.txt:unseen laughing skull cast"
msgid "You hear spiteful cackling.\n\nYou hear scornful gibbering.\n"
msgstr "你听见怨毒的怪笑。\n\n你听见轻蔑的胡言乱语。\n"

msgctxt "textdb:database/monspell.txt:manticore cast"
msgid "@The_monster@ flicks @possessive@ tail.\n"
msgstr "@The_monster@甩动@possessive@尾巴。\n"

msgctxt "textdb:database/monspell.txt:bolt of magma molten gargoyle cast"
msgid "@The_monster@ blasts magma @at@ @target@!\n"
msgstr "@The_monster@@at@@target@轰出熔岩！\n"

msgctxt "textdb:database/monspell.txt:orange crystal statue cast"
msgid "@The_monster@ glitters.\n"
msgstr "@The_monster@闪闪发光。\n"

msgctxt "textdb:database/monspell.txt:orange crystal statue cast targeted"
msgid "@The_monster@ fixes @possessive@ piercing gaze on @target@.\n"
msgstr "@The_monster@用@possessive@锐利目光锁定@target@。\n"

msgctxt "textdb:database/monspell.txt:orb of fire cast"
msgid "@The_monster@ glows yellow.\n\n@The_monster@ glows bright magenta.\n\n@The_monster@ glows deep purple.\n\n@The_monster@ glows red.\n\n@The_monster@ emits a lurid red light.\n"
msgstr "@The_monster@发出黄光。\n\n@The_monster@发出明亮的品红色光芒。\n\n@The_monster@发出深紫色光芒。\n\n@The_monster@发出红光。\n\n@The_monster@散发出刺目的红光。\n"

msgctxt "textdb:database/monspell.txt:orb of entropy cast"
msgid "w:20\n@The_monster@ [pulses|vibrates].\n\n@The_monster@ gnaws at the world.\n\n@The_monster@ eats away at reality.\n\nExistence decays around @the_monster@.\n"
msgstr "w:20\n@The_monster@[搏动|震颤]起来。\n\n@The_monster@啃噬世界。\n\n@The_monster@侵蚀现实。\n\n@the_monster@周围的存在开始衰败。\n"

msgctxt "textdb:database/monspell.txt:orb of winter cast"
msgid "@The_monster@ glitters with frost.\n\n@The_monster@ swirls like a blizzard.\n\nw:30\n@The_monster@ glows [icy blue|with a pale light|sapphire].\n"
msgstr "@The_monster@闪耀着寒霜。\n\n@The_monster@如暴风雪般旋转。\n\nw:30\n@The_monster@发出[冰蓝色光芒|苍白光芒|蓝宝石色光芒]。\n"

msgctxt "textdb:database/monspell.txt:obsidian statue cast"
msgid "@The_monster_possessive@ eyes glow briefly.\n"
msgstr "@The_monster_possessive@双眼短暂发光。\n"

msgctxt "textdb:database/monspell.txt:bolt of fire ophan cast"
msgid "@The_monster@ harnesses the cleansing power of fire!\n"
msgstr "@The_monster@驾驭火焰的净化之力！\n"

msgctxt "textdb:database/monspell.txt:unseen bolt of fire ophan cast"
msgid "Something harnesses the cleansing power of fire!\n"
msgstr "某物驾驭了火焰的净化之力！\n"

msgctxt "textdb:database/monspell.txt:force lance polterguardian cast"
msgid "@The_monster@ focuses its will @at@ @target@.\n"
msgstr "@The_monster@@at@@target@集中意志。\n"

msgctxt "textdb:database/monspell.txt:ghostly fireball revenant cast"
msgid "@The_monster@ lashes out with ghostly flames.\n"
msgstr "@The_monster@以幽魂火焰猛然出击。\n"

msgctxt "textdb:database/monspell.txt:spectral cloud revenant cast"
msgid "@The_monster@ conjures spectral mists around @target@.\n"
msgstr "@The_monster@在@target@周围造出幽魂薄雾。\n"

msgctxt "textdb:database/monspell.txt:dispel undead revenant cast"
msgid "@The_monster@ gestures violently @at@ @target@.\n"
msgstr "@The_monster@@at@@target@猛烈地打出手势。\n"

msgctxt "textdb:database/monspell.txt:blink away revenant cast"
msgid "__NONE\n"
msgstr "__NONE\n"

msgctxt "textdb:database/monspell.txt:battlecry satyr cast"
msgid "@The_monster@ plays a rousing melody on @possessive@ pipes!\n"
msgstr "@The_monster@用@possessive@排箫吹出振奋的旋律！\n"

msgctxt "textdb:database/monspell.txt:cause fear satyr cast"
msgid "@The_monster@ plays a frightful melody on @possessive@ pipes!\n"
msgstr "@The_monster@用@possessive@排箫吹出骇人的旋律！\n"

msgctxt "textdb:database/monspell.txt:sleep satyr cast"
msgid "@The_monster@ plays a lulling melody on @possessive@ pipes!\n"
msgstr "@The_monster@用@possessive@排箫吹出催眠的旋律！\n"

msgctxt "textdb:database/monspell.txt:injury mirror screaming refraction cast"
msgid "@The_monster@ shines with woeful anguish.\n\n@The_monster@ rattles its vertebrae in radiant agony.\n"
msgstr "@The_monster@闪耀着悲恸的痛苦。\n\n@The_monster@在辉光笼罩的剧痛中震动自己的脊椎骨。\n"

msgctxt "textdb:database/monspell.txt:lee's rapid deconstruction screaming refraction cast"
msgid "An echo of @the_monster@ flickers and hopelessly wails @at@ @target@.\n"
msgstr "@the_monster@的一个回响闪烁着，@at@@target@发出绝望的哀号。\n"

msgctxt "textdb:database/monspell.txt:scrub nettle cast targeted"
msgid "@The_monster@ launches toxic spines @at@ @target@.\n"
msgstr "@The_monster@@at@@target@发射毒刺。\n"

msgctxt "textdb:database/monspell.txt:warning cry seraph cast"
msgid "@The_monster@ shouts a warning to @possessive@ allies!\n"
msgstr "@The_monster@向@possessive@盟友高声示警！\n"

msgctxt "textdb:database/monspell.txt:unseen warning cry seraph cast"
msgid "You hear a loud warning shout!\n"
msgstr "你听见响亮的示警喊声！\n"

msgctxt "textdb:database/monspell.txt:invisibility shadowghast cast"
msgid "@The_monster@ slips into darkness.\n"
msgstr "@The_monster@隐入黑暗。\n"

msgctxt "textdb:database/monspell.txt:throw icicle shard shrike cast"
msgid "@The_monster@ spits a shard of ice @at@ @target@.\n"
msgstr "@The_monster@@at@@target@吐出一块寒冰碎片。\n"

msgctxt "textdb:database/monspell.txt:confuse sphinx marauder cast"
msgid "@The_monster@ roars a[n obscure| perplexing] riddle with a strange tongue.\n"
msgstr "@The_monster@用奇异的语言吼出一个[晦涩的|令人困惑的]谜语。\n"

msgctxt "textdb:database/monspell.txt:vex sphinx marauder cast"
msgid "@The_monster@ screeches a[n impossible| nonsensical| cliché] riddle in a mystic tongue.\n"
msgstr "@The_monster@用神秘的语言尖声说出一个[无解的|毫无意义的|老掉牙的]谜语。\n"

msgctxt "textdb:database/monspell.txt:smiting guardian sphinx cast"
msgid "@The_monster@ mutters an ancient curse @at@ @target@.\n"
msgstr "@The_monster@@at@@target@低念古老的诅咒。\n"

msgctxt "textdb:database/monspell.txt:paralysis guardian sphinx cast"
msgid "@The_monster@ whispers a [stupefying|staggering] mystic riddle.\n"
msgstr "@The_monster@低语一个[令人呆滞的|令人震惊的]神秘谜语。\n"

msgctxt "textdb:database/monspell.txt:sphinx cast"
msgid "@The_monster@ mumbles some strange words.\n\n@The_monster@ casts a spell.\n"
msgstr "@The_monster@含糊地念着古怪的话。\n\n@The_monster@施放了一个法术。\n"

msgctxt "textdb:database/monspell.txt:electrical bolt shock serpent cast"
msgid "@The_monster@ discharges a tendril of electricity.\n"
msgstr "@The_monster@放出一道触须般的电流。\n"

msgctxt "textdb:database/monspell.txt:sun moth cast"
msgid "@The_monster_possessive@ wings beat fiercely.\n"
msgstr "@The_monster_possessive@翅膀猛烈拍动。\n"

msgctxt "textdb:database/monspell.txt:rebounding blaze thermic dynamo cast"
msgid "A wild whirl of fire shoots out from @the_monster@ @at@ @target@.\n\n@The_monster@ overcharges @reflexive@ and releases excess heat @at@ @target@.\n"
msgstr "一团狂旋的火焰从@the_monster@中射出，并@at@@target@飞去。\n\n@The_monster@让@reflexive@过载，@at@@target@释放多余的热量。\n"

msgctxt "textdb:database/monspell.txt:rebounding chill thermic dynamo cast"
msgid "A wild whirl of ice shoots out from @the_monster@ @at@ @target@.\n\n@The_monster@ overflows with ice and vents excess cold @at@ @target@.\n"
msgstr "一团狂旋的寒冰从@the_monster@中射出，并@at@@target@飞去。\n\n@The_monster@溢满寒冰，@at@@target@排出多余的寒气。\n"

msgctxt "textdb:database/monspell.txt:unseen thermic dynamo cast"
msgid "You hear a violent whirl.\n"
msgstr "你听见猛烈的旋转声。\n"

msgctxt "textdb:database/monspell.txt:thrashing horror cast"
msgid "@The_monster@ churns violently!\n"
msgstr "@The_monster@剧烈翻腾！\n"

msgctxt "textdb:database/monspell.txt:undertaker cast targeted"
msgid "@The_monster@ reaches out for @target@.\n"
msgstr "@The_monster@伸向@target@。\n"

msgctxt "textdb:database/monspell.txt:flashing balestra undying armoury cast"
msgid "A weapon leaps out from @the_monster@ and lunges @at@ @target@!\n"
msgstr "一件武器从@the_monster@中跃出，@at@@target@猛刺过去！\n"

msgctxt "textdb:database/monspell.txt:death rattle ushabti cast"
msgid "@The_monster@ shakes and rattles.\n"
msgstr "@The_monster@摇晃着，咯咯作响。\n"

msgctxt "textdb:database/monspell.txt:warning cry ushabti cast"
msgid "@The_monster@ shakes and rattles deafeningly!\n"
msgstr "@The_monster@摇晃着，发出震耳欲聋的咯咯声！\n"

msgctxt "textdb:database/monspell.txt:unseen warning cry ushabti cast"
msgid "You hear a deafening rattling sound!\n"
msgstr "你听见震耳欲聋的咯咯声！\n"

msgctxt "textdb:database/monspell.txt:ushabti cast targeted"
msgid "@The_monster@ gestures stiffly @at@ @target@.\n"
msgstr "@The_monster@@at@@target@僵硬地打出手势。\n"

msgctxt "textdb:database/monspell.txt:unseen warning cry vault sentinel cast"
msgid "You hear a note loudly blown on a horn!\n"
msgstr "你听见一声响亮的号角！\n"

msgctxt "textdb:database/monspell.txt:warning cry vault sentinel cast"
msgid "@The_monster@ blows a loud note on a signal horn!\n"
msgstr "@The_monster@吹响信号角，发出响亮的号声！\n"

msgctxt "textdb:database/monspell.txt:metal splinters war gargoyle cast"
msgid "@The_monster@ launches @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@发射@beam@。\n"

msgctxt "textdb:database/monspell.txt:weeping skull cast"
msgid "@The_monster@ [unleashes|releases] gushing sobs.\n\n@The_monster_possessive@ misery [bubbles over|overflows].\n"
msgstr "@The_monster@[爆发出|发出]汹涌的抽泣。\n\n@The_monster_possessive@苦难[翻涌而出|满溢而出]。\n"

msgctxt "textdb:database/monspell.txt:silent weeping skull cast"
msgid "@The_monster_possessive@ misery [bubbles over|overflows].\n"
msgstr "@The_monster_possessive@苦难[翻涌而出|满溢而出]。\n"

msgctxt "textdb:database/monspell.txt:unseen weeping skull cast"
msgid "You hear gushing sobs.\n"
msgstr "你听见汹涌的抽泣声。\n"

msgctxt "textdb:database/monspell.txt:airstrike wind drake cast"
msgid "@The_monster@ flaps @possessive@ wings @at@ @target@.\n"
msgstr "@The_monster@@at@@target@扇动@possessive@翅膀。\n"

msgctxt "textdb:database/monspell.txt:wind blast wind drake cast"
msgid "@The_monster@ exhales a fierce blast of wind!\n"
msgstr "@The_monster@呼出一阵猛烈狂风！\n"

msgctxt "textdb:database/monspell.txt:corrupting pulse wretched star cast"
msgid "@The_monster@ pulses with an eldritch light!\n"
msgstr "@The_monster@带着诡异光芒搏动起来！\n"

msgctxt "textdb:database/monspell.txt:wretched star cast"
msgid "@The_monster@ glows turbulently.\n"
msgstr "@The_monster@发出动荡的光芒。\n"

msgctxt "textdb:database/monspell.txt:grave claw vampire bloodprince cast"
msgid "@The_monster@ reaches out @possessive@ hand.\n\n@The_monster@ snaps @possessive@ fingers.\n"
msgstr "@The_monster@伸出@possessive@手。\n\n@The_monster@打响@possessive@手指。\n"

msgctxt "textdb:database/monspell.txt:ravenous swarm vampire bloodprince cast"
msgid "@The_monster@ unfurls @possessive@ wings.\n\n@The_monster@ spreads @possessive@ arms wide.\n"
msgstr "@The_monster@展开@possessive@翅膀。\n\n@The_monster@大张@possessive@双臂。\n"

msgctxt "textdb:database/monspell.txt:dominate undead vampire bloodprince cast"
msgid "@The_monster@ exerts the full weight of @possessive@ authority.\n\n@The_monster@ compels the dead to obey.\n\n@The_monster@ whispers, \"Kneel.\"\n"
msgstr "@The_monster@施展@possessive@全部威势。\n\n@The_monster@迫使死者服从。\n\n@The_monster@低语：“跪下。”\n"

msgctxt "textdb:database/monspell.txt:manifold assault natural cast"
msgid "@The_monster@ seems to occupy many places at once.\n"
msgstr "@The_monster@似乎同时出现在许多位置。\n"

msgctxt "textdb:database/monspell.txt:acid ball nascent plasmodium cast"
msgid "@The_monster@ squirts acid @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷射酸液。\n"

msgctxt "textdb:database/monspell.txt:angel cast targeted"
msgid "@The_monster@ calls down the wrath of @possessive_God@ upon @target@.\n"
msgstr "@The_monster@向@target@降下@possessive_God@的神怒。\n"

msgctxt "textdb:database/monspell.txt:crab cast targeted"
msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

msgctxt "textdb:database/monspell.txt:dragon cast targeted"
msgid "@The_monster@ breathes @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@喷吐@beam@。\n"

msgctxt "textdb:database/monspell.txt:dragon cast"
msgid "@The_monster@ roars!\n"
msgstr "@The_monster@咆哮！\n"

msgctxt "textdb:database/monspell.txt:unseen dragon cast"
msgid "You hear a roar.\n"
msgstr "你听见一声咆哮。\n"

msgctxt "textdb:database/monspell.txt:drake cast targeted"
msgid "@dragon cast targeted@\n"
msgstr "@dragon cast targeted@\n"

msgctxt "textdb:database/monspell.txt:floating eye cast targeted"
msgid "@The_monster@ gazes @at@ @target@.\n"
msgstr "@The_monster@@at@@target@凝视。\n"

msgctxt "textdb:database/monspell.txt:floating eye cast"
msgid "@The_monster@ looks around.\n"
msgstr "@The_monster@环顾四周。\n"

msgctxt "textdb:database/monspell.txt:unseen floating eye cast targeted"
msgid "You feel something staring at you. @player_only@\n"
msgstr "你觉得有东西在盯着自己。@player_only@\n"

msgctxt "textdb:database/monspell.txt:living spell cast"
msgid "@The_monster@ casts @reflexive@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@施放@reflexive@。\n"

msgctxt "textdb:database/monspell.txt:raven cast"
msgid "@The_monster@ stares into @foe_possessive@ soul.\n"
msgstr "@The_monster@凝视@foe_possessive@灵魂深处。\n"

msgctxt "textdb:database/monspell.txt:malmutate zykzyl cast"
msgid "@The_monster@ seethes with envy of @foe_possessive@ form.\n"
msgstr "@The_monster@对@foe_possessive@形态嫉妒得怒火中烧。\n"

msgctxt "textdb:database/monspell.txt:enfeeble zykzyl cast"
msgid "@The_monster@ overflows with resentment.\n"
msgstr "@The_monster@满溢着怨恨。\n"

msgctxt "textdb:database/monspell.txt:bolt of flesh zykzyl cast"
msgid "@The_monster@ hurls a piece of @reflexive@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@掷出@reflexive@的一块血肉。\n"

msgctxt "textdb:database/monspell.txt:ostracise cast"
msgid "@The_monster@ freezes your soul cold.\n"
msgstr "@The_monster@将你的灵魂冻得冰冷。\n"

msgctxt "textdb:database/monspell.txt:polymorphed wizard cast targeted"
msgid "@The_monster@ casts a spell @at@ @target@.\n"
msgstr "@The_monster@@at@@target@施放法术。\n"

msgctxt "textdb:database/monspell.txt:polymorphed wizard cast"
msgid "@The_monster@ casts a spell.\n"
msgstr "@The_monster@施放了一个法术。\n"

msgctxt "textdb:database/monspell.txt:polymorphed unseen wizard cast"
msgid "You hear some strange, mumbled words.\n"
msgstr "你听见有人含糊地念着古怪的话。\n"

msgctxt "textdb:database/monspell.txt:haste other priest cast"
msgid "@The_monster@ calls upon @possessive_God@ to speed up @target@.\n"
msgstr "@The_monster@祈求@possessive_God@加速@target@。\n"

msgctxt "textdb:database/monspell.txt:heal other priest cast"
msgid "@The_monster@ calls upon @possessive_God@ to heal @target@.\n"
msgstr "@The_monster@祈求@possessive_God@治疗@target@。\n"

msgctxt "textdb:database/monspell.txt:might other priest cast"
msgid "@The_monster@ calls upon @possessive_God@ to strengthen @target@.\n"
msgstr "@The_monster@祈求@possessive_God@强化@target@。\n"

msgctxt "textdb:database/monspell.txt:malign offering priest cast"
msgid "@The_monster@ utters a dark prayer and points @at@ @target@.\n"
msgstr "@The_monster@念出黑暗祷词，@at@@target@一指。\n"

msgctxt "textdb:database/monspell.txt:blink magical cast"
msgid "__NONE\n"
msgstr "__NONE\n"

msgctxt "textdb:database/monspell.txt:priest cast targeted"
msgid "@The_monster@ calls down the wrath of @possessive_God@ upon @target@.\n\n@The_monster@ mumbles some strange prayers to @possessive_God@ against @target@.\n\n@The_monster@ invokes the aid of @possessive_God@ against @target@.\n"
msgstr "@The_monster@向@target@降下@possessive_God@的神怒。\n\n@The_monster@向@possessive_God@含糊地祈祷，诅咒@target@。\n\n@The_monster@祈求@possessive_God@援助，对抗@target@。\n"

msgctxt "textdb:database/monspell.txt:priest cast"
msgid "@The_monster@ prays to @possessive_God@.\n\n@The_monster@ mumbles some strange prayers to @possessive_God@.\n\n@The_monster@ utters an invocation to @possessive_God@.\n"
msgstr "@The_monster@向@possessive_God@祈祷。\n\n@The_monster@向@possessive_God@含糊地念着古怪的祷词。\n\n@The_monster@向@possessive_God@念出祷告。\n"

msgctxt "textdb:database/monspell.txt:unseen priest cast targeted"
msgid "You hear @something@ call down the wrath of @a_God@ upon @target@.\n\nYou hear @something@ mumble some strange prayers to @a_God@ against @target@.\n\nYou hear @something@ invoke the aid of @a_God@ against @target@.\n"
msgstr "你听见@something@向@target@降下@a_God@的神怒。\n\n你听见@something@向@a_God@含糊地祈祷，诅咒@target@。\n\n你听见@something@祈求@a_God@援助，对抗@target@。\n"

msgctxt "textdb:database/monspell.txt:unseen priest cast"
msgid "You hear some strange, mumbled prayers to @a_God@.\n"
msgstr "你听见向@a_God@含糊念出的古怪祷词。\n"

msgctxt "textdb:database/monspell.txt:non-humanoid wizard cast targeted"
msgid "@The_monster@ stares @at@ @target@ and mumbles some strange words.\n\n@The_monster@ casts a spell @at@ @target@.\n"
msgstr "@The_monster@@at@@target@盯视，含糊地念着古怪的话。\n\n@The_monster@@at@@target@施放法术。\n"

msgctxt "textdb:database/monspell.txt:non-humanoid wizard cast"
msgid "@The_monster@ mumbles some strange words.\n\n@The_monster@ casts a spell.\n"
msgstr "@The_monster@含糊地念着古怪的话。\n\n@The_monster@施放了一个法术。\n"

msgctxt "textdb:database/monspell.txt:unseen non-humanoid wizard cast"
msgid "You hear some strange, mumbled words.\n"
msgstr "你听见有人含糊地念着古怪的话。\n"

msgctxt "textdb:database/monspell.txt:wizard cast targeted"
msgid "@The_monster@ gestures @at@ @target@ while chanting.\n\n@The_monster@ points @at@ @target@ and mumbles some strange words.\n\n@The_monster@ casts a spell @at@ @target@.\n"
msgstr "@The_monster@一边吟唱，一边@at@@target@打着手势。\n\n@The_monster@@at@@target@一指，含糊地念着古怪的话。\n\n@The_monster@@at@@target@施放法术。\n"

msgctxt "textdb:database/monspell.txt:wizard cast"
msgid "@The_monster@ gestures wildly while chanting.\n\n@The_monster@ mumbles some strange words.\n\n@The_monster@ casts a spell.\n"
msgstr "@The_monster@一边吟唱，一边疯狂地打着手势。\n\n@The_monster@含糊地念着古怪的话。\n\n@The_monster@施放了一个法术。\n"

msgctxt "textdb:database/monspell.txt:unseen wizard cast"
msgid "You hear some strange, mumbled words.\n"
msgstr "你听见有人含糊地念着古怪的话。\n"

msgctxt "textdb:database/monspell.txt:magical cast targeted"
msgid "@The_monster@ gestures @at@ @target@.\n"
msgstr "@The_monster@@at@@target@打出手势。\n"

msgctxt "textdb:database/monspell.txt:magical cast"
msgid "@The_monster@ gestures.\n"
msgstr "@The_monster@打出手势。\n"

msgctxt "textdb:database/monspell.txt:beam catchall cast"
msgid "@The_monster@ throws @beam@ @at@ @target@.\n"
msgstr "@The_monster@@at@@target@投出@beam@。\n"


#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:conjuration miscast player"
msgid "Sparks fly from your @hands@\n\nA strange surge of energy strikes you from nowhere\n\nA wave of violent energy washes through your body\n\nEnergy rips through your body\n\nYou are caught in a violent explosion\n\nYou are blasted with magical energy\n"
msgstr "电火花从你的@hands@中飞出\n\n一股来历不明的奇异能量骤然击中了你\n\n狂暴的能量席卷你的身体\n\n能量撕扯着你的身体\n\n你被卷入猛烈的爆炸\n\n魔法能量轰击了你\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:conjuration miscast monster"
msgid "Sparks fly from @the_monster_possessive@ @hands@\n\n@The_monster@ emits a flash of light\n\n@The_monster@ lurches violently\n\n@The_monster@ jerks violently\n\n@The_monster@ is caught in a violent explosion\n\n@The_monster@ is blasted with magical energy\n"
msgstr "电火花从@the_monster_possessive@@hands@中飞出\n\n@The_monster@发出一道闪光\n\n@The_monster@猛地踉跄了一下\n\n@The_monster@剧烈地抽动\n\n@The_monster@被卷入猛烈的爆炸\n\n魔法能量轰击了@The_monster@\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:conjuration miscast unseen"
msgid "A violent explosion happens from out of thin air\n\nThere is a sudden explosion of magical energy\n"
msgstr "空中凭空发生了猛烈的爆炸\n\n魔法能量突然爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:hexes miscast player"
msgid "Multicoloured lights dance before your eyes\n\nYou feel a bit tired\n\nThe light around you dims momentarily\n\nYou hear an indistinct dissonance whispering inside your mind\n\nYou feel a strange surge of energy\n\nWaves of @any_colour@ light ripple over your body\n\nYou feel enfeebled\n\nMagic surges out from your body\n"
msgstr "五彩斑斓的光点在你眼前舞动\n\n你感到有些疲倦\n\n你周围的光线暗淡了一瞬\n\n你的脑海中响起模糊而不和谐的低语\n\n你感到一股奇异的能量涌动\n\n一波波@any_colour@的光在你身上荡漾\n\n你感到虚弱无力\n\n魔力从你的身体中涌出\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:hexes miscast monster"
msgid "Multicoloured lights dance around @the_monster@\n\n@The_monster@ looks sleepy for a second\n\nThe light around @the_monster@ dims momentarily\n\n@The_monster@ twitches\n\n@The_monster_possessive@ body glows momentarily\n\nWaves of @any_colour@ light ripple over @the_monster_possessive@ body\n\nMagic surges out from @the_monster@\n"
msgstr "五彩斑斓的光点在@the_monster@周围舞动\n\n@The_monster@一瞬间显得昏昏欲睡\n\n@the_monster@周围的光线暗淡了一瞬\n\n@The_monster@抽搐了一下\n\n@The_monster_possessive@身体发光了一瞬\n\n一波波@any_colour@的光在@the_monster_possessive@身上荡漾\n\n魔力从@the_monster@的身体中涌出\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:hexes miscast unseen"
msgid "Multicoloured lights dance in the air\n\nA patch of light dims momentarily\n\nMagic surges out from thin air\n"
msgstr "五彩斑斓的光点在空中舞动\n\n一片光亮暗淡了一瞬\n\n魔力凭空涌出\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:summoning miscast player"
msgid "A fistful of eyes flickers past your view\n\nDistant voices call out in your mind\n\nSomething forms from out of thin air\n\nA chorus of moans calls out in your mind\n\nDesperate hands claw out at you\n"
msgstr "一把眼珠在你眼前一闪而过\n\n遥远的声音在你脑海中呼唤\n\n某种东西凭空成形\n\n一片呻吟声在你脑海中响起\n\n绝望的手向你抓来\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:summoning miscast monster"
msgid "Desperate hands claw out at @the_monster@\n"
msgstr "绝望的手向@the_monster@抓去\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:summoning miscast unseen"
msgid "Desperate hands claw out at random\n"
msgstr "绝望的手向四周乱抓\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:necromancy miscast player"
msgid "You hear strange and distant voices\n\nThe world around you seems to dim momentarily\n\nYou feel as though something walked over your grave\n\nYou sense a malignant aura\n\nYou feel very uncomfortable\n\nPain shoots through your body\n\nYou feel horribly lethargic\n\nYour flesh rots away\n\nFlickering shadows surround you\n\nYou are engulfed in negative energy\n\nYou convulse helplessly as pain tears through your body\n"
msgstr "你听见奇怪而遥远的声音\n\n你周围的世界仿佛暗淡了一瞬\n\n你莫名地打了个寒战，仿佛有东西踏过了你的坟墓\n\n你感到一股恶毒的气息\n\n你感到极不舒服\n\n疼痛贯穿你的身体\n\n你感到极度倦怠\n\n你的血肉开始腐烂\n\n闪烁的阴影围绕着你\n\n你被负能量吞没\n\n疼痛撕扯着你的身体，你无法控制地抽搐起来\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:necromancy miscast monster"
msgid "@The_monster@ twitches violently\n\n@The_monster@ pauses, visibly distraught\n\n@The_monster@ seems to dim momentarily\n\n@The_monster@ looks as though something walked over @possessive@ grave\n\n@The_monster@ is briefly tinged with black\n\n@The_monster@ scowls horribly\n\n@The_monster@ convulses with pain\n\n@The_monster@ looks incredibly listless\n\n@The_monster@ rots away\n\nFlickering shadows surround @the_monster@\n\n@The_monster@ is engulfed in negative energy\n\n@The_monster@ convulses helplessly with pain\n\n@The_monster@ seems frightened for a moment\n"
msgstr "@The_monster@剧烈地抽搐\n\n@The_monster@停了下来，显得心神不宁\n\n@The_monster@仿佛暗淡了一瞬\n\n@The_monster@仿佛感到有什么踏过了@possessive@坟墓\n\n@The_monster@一瞬间染上了黑色\n\n@The_monster@露出可怕的怒容\n\n@The_monster@痛苦地痉挛\n\n@The_monster@显得极度萎靡\n\n@The_monster@开始腐烂\n\n闪烁的阴影围绕着@the_monster@\n\n@The_monster@被负能量吞没\n\n@The_monster@痛苦地抽搐，无法自控\n\n@The_monster@一瞬间显得惊恐不安\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:necromancy miscast unseen"
msgid "The air has a black tinge for a moment\n\nShadows flicker in the thin air\n"
msgstr "空气一瞬间染上了黑色\n\n阴影在空中闪烁\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:translocation miscast player"
msgid "You catch a glimpse of the back of your own head\n\nYou feel a wrenching sensation\n\nYou feel off-balance for a moment\n\nThe floor and the ceiling briefly switch places\n\nYou spin around\n\nThe world appears momentarily distorted\n\nYou are caught in a field of spatial distortion\n\nSpace twists in upon itself\n\nSpace [bends|warps] [crazily |]around you\n"
msgstr "你瞥见了自己的后脑勺\n\n你感到一阵剧烈的扭拽\n\n你一瞬间失去了平衡\n\n地面和天花板短暂地交换了位置\n\n你原地旋转起来\n\n世界仿佛扭曲了一瞬\n\n你被卷入空间扭曲的力场\n\n空间向内扭曲\n\n你周围的空间[弯折|扭曲]起来，[疯狂地|]变形\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:translocation miscast monster"
msgid "@The_monster@ jerks violently for a moment\n\n@The_monster@ looks off-balance for a moment\n\n@The_monster@ spins around\n\n@The_monster@ appears momentarily distorted\n\n@The_monster_possessive@ features rearrange themselves for a while\n\n@The_monster@ is caught in a field of spatial distortion\n\nSpace [bends|warps] [crazily |]around @the_monster@\n"
msgstr "@The_monster@剧烈地抽动了一瞬\n\n@The_monster@一瞬间显得失去了平衡\n\n@The_monster@原地旋转起来\n\n@The_monster@仿佛扭曲了一瞬\n\n@The_monster_possessive@容貌短暂地错位重组\n\n@The_monster@被卷入空间扭曲的力场\n\n@the_monster@周围的空间[弯折|扭曲]起来，[疯狂地|]变形\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:translocation miscast unseen"
msgid "The space around something warps impossibly\n\nA piece of empty space twists and distorts\n\nA rift temporarily opens in the fabric of space\n"
msgstr "某个东西周围的空间发生了不可思议的扭曲\n\n一片空无一物的空间扭曲变形\n\n空间的结构中短暂地裂开了一道缝隙\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:fire miscast player"
msgid "[Cinders|Ashes] fly from your @hands@\n\nThe air around you burns with energy\n\nHeat runs through your body\n\nYou feel uncomfortably hot\n\nFire whirls out from your @hands@\n\nFlames sear your flesh\n\nYou are blasted with [searing |][fire|flames]\n\nYou are caught in a fiery explosion\n\nThere is a sudden and violent explosion of flames\n"
msgstr "[余烬|灰烬]从你的@hands@中飞出\n\n你周围的空气因能量而燃烧\n\n热流穿过你的身体\n\n你感到热得难受\n\n火焰从你的@hands@中旋出\n\n烈焰灼烧着你的血肉\n\n你遭到[灼热的|][火焰|烈焰]轰击\n\n你被卷入烈焰爆炸\n\n烈焰突然猛烈地炸开\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:fire miscast monster"
msgid "[Cinders|Ashes] fly from @the_monster_possessive@ @hands@\n\nThe air around @the_monster@ burns with energy\n\nDim flames ripple over @the_monster_possessive@ body\n\nFire whirls out @the_monster_possessive@ @hands@\n\nFlames sear @the_monster@\n\n@The_monster@ is blasted with [searing |][fire|flames]\n\n@The_monster@ is caught in a fiery explosion\n"
msgstr "[余烬|灰烬]从@the_monster_possessive@@hands@中飞出\n\n@the_monster@周围的空气因能量而燃烧\n\n微弱的火焰在@the_monster_possessive@身上荡漾\n\n火焰从@the_monster_possessive@@hands@中旋出\n\n烈焰灼烧着@the_monster@\n\n@The_monster@遭到[灼热的|][火焰|烈焰]轰击\n\n@The_monster@被卷入烈焰爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:fire miscast unseen"
msgid "Fire whirls out of nowhere\n\nA flame briefly burns in thin air\n\nFire explodes from out of thin air\n\nA large flame burns hotly for a moment in the thin air\n"
msgstr "火焰凭空旋出\n\n一簇火焰在空中短暂地燃烧\n\n火焰凭空炸开\n\n一大团火焰在空中炽烈地燃烧了一瞬\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:ice miscast player"
msgid "You shiver with cold\n\nA chill runs through your body\n\nYour @hands@ feel@hand_conj@ numb with cold\n\nYou feel [a little bit|uncomfortably|extremely] cold\n\n[Ice|Frost] covers your body\n\nYou are encased in [ice|frost]\n\nYou are covered in a thin layer of [ice|frost]\n\nHeat is drained from your body\n\nYou are caught in an explosion of ice and frost\n"
msgstr "你冷得发抖\n\n寒意穿过你的身体\n\n你的@hands@冻得麻木@hand_conj@\n\n你感到[有点冷|冷得难受|极其寒冷]\n\n[冰层|霜层]覆盖了你的身体\n\n你被[冰层|霜层]包裹\n\n一层薄薄的[冰|霜]覆盖了你\n\n你的体温被抽走\n\n你被卷入冰霜爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:ice miscast monster"
msgid "@The_monster@ shivers with cold\n\nFrost covers @the_monster_possessive@ body\n\n@The_monster@ shivers\n\n@The_monster@ is covered in a thin layer of [ice|frost]\n\nHeat is drained from @the_monster@\n\n@The_monster@ is caught in an explosion of ice and frost\n\n@The_monster@ is encased in [ice|frost]\n"
msgstr "@The_monster@冷得发抖\n\n霜覆盖了@the_monster_possessive@身体\n\n@The_monster@打了个寒战\n\n一层薄薄的[冰|霜]覆盖了@The_monster@\n\n@the_monster@的体温被抽走\n\n@The_monster@被卷入冰霜爆炸\n\n@The_monster@被[冰层|霜层]包裹\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:ice miscast unseen"
msgid "Wisps of condensation drift in the air\n\nIce and frost explode from out of thin air\n\nAn unseen figure is encased in [ice|frost]\n"
msgstr "缕缕凝结的水汽在空中飘荡\n\n冰霜凭空炸开\n\n一个看不见的身影被[冰层|霜层]包裹\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:air miscast player"
msgid "Sparks of electricity dance around you\n\nThe air around you crackles with energy\n\nYou are blasted with air\n\nThere is a short, sharp shower of sparks\n\nThe wind whips around you\n\nYou feel a sudden electric shock\n\nElectricity courses through your body\n\nYou are caught in an explosion of electrical discharges\n"
msgstr "电火花在你周围跳动\n\n你周围的空气因能量而噼啪作响\n\n你遭到气流轰击\n\n一阵猛烈的电火花骤然迸发\n\n狂风在你周围呼啸\n\n你突然遭到电击\n\n电流穿过你的身体\n\n你被卷入放电引发的爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:air miscast monster"
msgid "@The_monster@ bobs in the air for a moment\n\nSparks of electricity dance between @the_monster_possessive@ @hands@\n\nThe air around @the_monster@ crackles with energy\n\n@The_monster@ is blasted with air\n\n@The_monster@ is briefly showered in sparks\n\nThe wind whips around @the_monster@\n\n@The_monster@ is jolted\n\n@The_monster@ is caught in an explosion of electrical discharges\n\n@The_monster@ is struck by twisting air\n"
msgstr "@The_monster@在空中上下浮动了一瞬\n\n电火花在@the_monster_possessive@@hands@之间跳动\n\n@the_monster@周围的空气因能量而噼啪作响\n\n@The_monster@遭到气流轰击\n\n@The_monster@一瞬间被迸发的电火花笼罩\n\n狂风在@the_monster@周围呼啸\n\n@The_monster@遭到电击\n\n@The_monster@被卷入放电引发的爆炸\n\n扭曲的气流击中了@The_monster@\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:air miscast unseen"
msgid "The wind whips up out of nowhere\n\nSomething invisible sparkles with electricity\n\nThe air around something crackles with energy\n\nElectrical discharges explode from out of thin air\n\nThe air madly twists around a spot\n"
msgstr "狂风凭空卷起\n\n某个看不见的东西闪烁着电光\n\n某个东西周围的空气因能量而噼啪作响\n\n放电引发的爆炸凭空发生\n\n空气在一处疯狂地扭曲\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:earth miscast player"
msgid "[Sand|Gravel] pours from your @hands@\n\nYou feel a surge of energy from the ground\n\nThe floor [shifts|shudders|quakes|rumbles] beneath you alarmingly\n\nYou are hit by flying rocks\n\nYou are blasted with sand\n\nRocks fall onto you out of nowhere\n\nYou are caught in an explosion of flying shrapnel\n"
msgstr "[沙子|碎石]从你的@hands@中倾泻而出\n\n你感到地面涌来一股能量\n\n你脚下的地面[错动|颤动|震动|隆隆作响]，令人心惊\n\n飞石击中了你\n\n你遭到沙尘轰击\n\n石块凭空落下，砸中了你\n\n你被卷入碎片四射的爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:earth miscast monster"
msgid "[Sand|Gravel] pours from @the_monster_possessive@ @hands@\n\n@The_monster@ is hit by flying rocks\n\n@The_monster@ is blasted with sand\n\nRocks fall onto @the_monster@ out of nowhere\n\n@The_monster@ is caught in an explosion of flying shrapnel\n"
msgstr "[沙子|碎石]从@the_monster_possessive@@hands@中倾泻而出\n\n飞石击中了@The_monster@\n\n@The_monster@遭到沙尘轰击\n\n石块凭空落下，砸中了@the_monster@\n\n@The_monster@被卷入碎片四射的爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:earth miscast unseen"
msgid "Flying rocks appear out of thin air\n\nA miniature sandstorm briefly appears\n\nRocks fall out of nowhere\n\nFlying shrapnel explodes from thin air\n"
msgstr "飞石凭空出现\n\n一场小型沙暴短暂地出现\n\n石块凭空落下\n\n碎片凭空炸开，四处飞散\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:alchemy miscast player"
msgid "You are engulfed in toxic fumes\n\nThere is a flash of cinnabar\n\n[Mercury|Quicksilver|Fool's gold|Saltpeter|Sulphur|Liquid metal] flows from your @hands@\n\nParts of your body briefly turn [golden|silvery|metallic|leaden|crystalline]\n\nw:4\nYou are overcome by clouds of @any_colour@ smoke\n\nw:4\nThe inside of your mouth momentarily tastes like @any_colour@\n\nw:2\nYour skin changes to @any_colour_pattern@\n\nw:2\nYou are surrounded by clouds of @any_glowing_colour@ dust\n"
msgstr "你被有毒的烟气吞没\n\n朱砂闪过一道光芒\n\n[水银|汞液|黄铁矿|硝石|硫磺|液态金属]从你的@hands@中流出\n\n你身体的某些部位短暂地变成[金色|银色|金属质地|铅质|结晶状]\n\nw:4\n成片的@any_colour@烟雾笼罩了你\n\nw:4\n你的嘴里一瞬间尝到了@any_colour@的味道\n\nw:2\n你的皮肤变成了@any_colour_pattern@\n\nw:2\n成片的@any_glowing_colour@尘埃围绕着你\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:alchemy miscast monster"
msgid "@The_monster@ is engulfed in toxic fumes\n\n@The_monster@ is [blasted|coated] with [cinnabar|sulphur] dust\n\n@The_monster@ is coated in salt\n\n@The_monster@ starts coughing violently\n\n@The_monster@ looks incredibly sick\n\nw:5\n@The_monster@ is overcome by clouds of @any_colour@ smoke\n\nw:5\n@The_monster_possessive@ skin changes to @any_colour_pattern@\n\nw:5\n@The_monster@ is surrounded by clouds of @any_glowing_colour@ dust\n"
msgstr "@The_monster@被有毒的烟气吞没\n\n@The_monster@[遭到轰击，身上沾满了|身上裹满了][朱砂|硫磺]粉末\n\n@The_monster@的身上裹满了盐\n\n@The_monster@开始剧烈地咳嗽\n\n@The_monster@显得病得很重\n\nw:5\n成片的@any_colour@烟雾笼罩了@The_monster@\n\nw:5\n@The_monster_possessive@皮肤变成了@any_colour_pattern@\n\nw:5\n成片的@any_glowing_colour@尘埃围绕着@The_monster@\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:alchemy miscast unseen"
msgid "The air has a green tinge for a moment\n\nSulphurous heat explodes from thin air\n\nAn unseen figure is coated in salt\n"
msgstr "空气一瞬间染上了绿色\n\n灼热的硫磺气息凭空炸开\n\n一个看不见的身影被盐包裹\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:forgecraft miscast player"
msgid "You lose structural integrity\n\nYou feel yourself deconstruct slightly\n\nA [buzzing|clanking|creaking|whirring] sound echoes in your mind\n\nMetal odds and ends fall onto you out of nowhere\n\nYou are covered in metallic shards\n\nYou are caught in an explosion of metallic debris\n"
msgstr "你的身体结构开始崩解\n\n你感到自己的身体稍微分解了一些\n\n你的脑海中回荡着[嗡嗡声|铿锵声|嘎吱声|呼呼声]\n\n零碎的金属凭空落下，砸中了你\n\n你的身上满是金属碎片\n\n你被卷入金属碎屑爆炸\n"

#. Reviewed database-01; canonical keys and English fallback preserved.
msgctxt "textdb:database/miscast.txt:forgecraft miscast monster"
msgid "@The_monster@ loses structural integrity\n\nMetal odds and ends fall onto @the_monster@ out of nowhere\n\n@The_monster@ is covered in metallic shards\n\n@The_monster@ is caught in an explosion of metallic debris\n"
msgstr "@The_monster@的身体结构开始崩解\n\n零碎的金属凭空落下，砸中了@the_monster@\n\n@The_monster@的身上满是金属碎片\n\n@The_monster@被卷入金属碎屑爆炸\n"

