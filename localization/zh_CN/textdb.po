#. Reviewed database-25–27; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:dream sheep"
msgid "@The_monster@ \"Baaaas\" balefully.\n\n@The_monster@ \"Baaaas\" sleepily.\n"
msgstr "@The_monster@不祥地“咩——”了一声。\n\n@The_monster@睡意朦胧地“咩——”了一声。\n"

#. Reviewed database-25–27; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:default electric golem"
msgid "SOUND:@The_monster@ crackles and sizzles.\n"
msgstr "SOUND:@The_monster@发出噼啪嘶鸣。\n"

#. Reviewed database-25–27; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:erythrospite"
msgid "VISUAL:@The_monster@ throbs to the beat of your heart.\n"
msgstr "VISUAL:@The_monster@随着你的心跳搏动。\n"

#. Reviewed database-25–27; glossary checked before translation.
msgctxt "textdb:database/monspeak.txt:frilled lizard"
msgid "@The_monster@ unfolds @possessive@ giant frill.\n\n@The_monster@ hisses @at_foe@.\n"
msgstr "@The_monster@展开@possessive@巨大的颈褶。\n\n@The_monster@朝@at_foe@发出嘶声。\n"

#. Reviewed database-25–27; glossary checked before translation.
