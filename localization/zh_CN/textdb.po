msgctxt "textdb:database/shout.txt:_riddle_adj_"
msgid "a baffling\n\na brilliant\n\nw:20\na clever\n\na confusing\n\nw:20\na cunning\n\nan impossible\n\nan ingenious\n\na masterful\n\na mind-bending\n\na perplexing\n\na vexing\n\n"
