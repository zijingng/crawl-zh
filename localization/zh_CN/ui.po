msgid "You aren't carrying any weapons that can be enchanted."
msgstr "你没有携带可附魔的武器。"

msgctxt "d.item.reason"
msgid "Your stasis prevents you from teleporting."
msgstr "你的稳态阻止了传送。"

msgctxt "d.item.reason"
msgid "Long-range teleportation is disallowed in Dungeon Sprint."
msgstr "地下城冲刺模式不允许远距离传送。"

msgctxt "d.item.reason"
msgid "A magic seal in the Gauntlet prevents long-range teleports."
msgstr "竞技场中的魔法封印阻止了远距离传送。"

msgctxt "d.item.reason"
msgid "Your body glows too brightly to become invisible."
msgstr "你的身体发光太亮，无法隐形。"

msgctxt "d.item.reason"
msgid "You are backlit; invisibility will do you no good right now."
msgstr "你身上有背光，现在隐形对你没有帮助。"

