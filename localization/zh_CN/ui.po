msgctxt "d.item.reason"
msgid "Trog doesn't allow you to memorise spells!"
msgstr "特洛戈不允许你记忆法术！"

msgctxt "d.item.reason"
msgid "There's no point in enhancing weapons you can't use!"
msgstr "强化你无法使用的武器毫无意义！"

msgctxt "d.item.reason"
msgid "There's no point in enchanting armour you can't use!"
msgstr "为你无法使用的防具附魔毫无意义！"

msgctxt "d.item.reason"
msgid "There is nothing left to identify."
msgstr "已经没有可鉴定的物品了。"

msgctxt "d.item.reason"
msgid "You have no need of identification."
msgstr "你不需要鉴定物品。"

msgctxt "d.item.reason"
msgid "You cannot coerce anything to answer your summons."
msgstr "你无法驱使任何生物回应召唤。"

msgctxt "d.item.reason"
msgid "You can't read that!"
msgstr "你无法阅读它！"

msgctxt "d.item.reason"
msgid "You have no spells to forget."
msgstr "你没有可遗忘的法术。"

msgctxt "d.item.reason"
msgid "The air is too still for clouds to form."
msgstr "空气过于静止，无法形成云雾。"

msgctxt "d.item.reason"
msgid "This place cannot be mapped!"
msgstr "此地无法绘制地图！"

msgctxt "d.item.reason"
msgid "You can't drink."
msgstr "你无法饮用药水。"

msgctxt "d.item.reason"
msgid "You cannot drink potions in your current state!"
msgstr "你当前的状态无法饮用药水！"

msgctxt "d.item.reason"
msgid "You are too berserk!"
msgstr "你过于狂暴！"

msgctxt "d.item.reason"
msgid "You refuse to indulge in frivolous drinking."
msgstr "你拒绝沉溺于无谓的饮酒。"

msgctxt "d.item.reason"
msgid "It's too cold; everything's frozen solid!"
msgstr "这里太冷了，所有东西都冻成了固体！"

msgctxt "d.item.reason"
msgid "You can't drink that!"
msgstr "你无法饮用它！"

msgctxt "d.item.reason"
msgid "You cannot see clearly; the smoke and ash is too thick!"
msgstr "烟尘太浓，你无法看清！"

msgctxt "d.item.reason"
msgid "You are too confused!"
msgstr "你太混乱了！"

msgctxt "d.item.reason"
msgid "You cannot read scrolls in your current state!"
msgstr "你当前的状态无法阅读卷轴！"

msgctxt "d.item.reason"
msgid "You refuse to depend on such disposable conveniences."
msgstr "你拒绝依赖这种用过即弃的便利品。"

msgctxt "d.item.reason"
msgid "you are already filled with unstable energy."
msgstr "你体内已经充满不稳定的能量。"

msgctxt "d.item.reason"
msgid "You cannot evoke magical items."
msgstr "你无法唤发魔法物品。"

msgctxt "d.item.reason"
msgid "You can't evoke that!"
msgstr "你无法唤发它！"

msgctxt "d.item.reason"
msgid "This wand has no charges."
msgstr "这根魔杖没有充能。"

msgctxt "d.item.reason"
msgid "That item cannot be used by those who cannot gain allies!"
msgstr "无法获得盟友的人不能使用此物品！"

