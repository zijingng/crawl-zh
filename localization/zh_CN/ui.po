msgctxt "lua.map"
msgid "You hear the roar of battle."
msgstr "你听到战斗的咆哮声。"

msgctxt "lua.map"
msgid "There is an entrance to a bailey on this level. Hurry and find it before the portal closes forever!"
msgstr "本层有通往堡场的入口。快在传送门永久关闭前找到它！"

msgctxt "lua.map"
msgid "You hear coins being counted."
msgstr "你听到清点钱币的声音。"

msgctxt "lua.map"
msgid "An interdimensional caravan has stopped on this level and set up a bazaar. Hurry and find its entrance before they move on!"
msgstr "一支跨维度商队在本层停驻，开设了市集。快在他们离开前找到入口！"

msgctxt "lua.map"
msgid "You hear a distant wind."
msgstr "你听到远处的风声。"

msgctxt "lua.map"
msgid "There is a portal to the Desolation of Salt on this level. Hurry and find it before the gateway collapses!"
msgstr "本层有通往荒盐之地的传送门。快在入口坍塌前找到它！"

msgctxt "lua.map"
msgid "You hear a distant snort."
msgstr "你听到远处传来一声鼻息。"

msgctxt "lua.map"
msgid "Hark! There is a gateway to a gauntlet on this level. Find the entrance quickly before the gate is sealed!"
msgstr "听着！本层有通往竞技场的入口。快在大门封闭前找到它！"

msgctxt "lua.map"
msgid "You feel a wave of frost pass over you."
msgstr "你感到一阵寒气掠过全身。"

msgctxt "lua.map"
msgid "There is an entrance to an ice cave on this level. Hurry and find it before the portal melts!"
msgstr "本层有通往冰窟的入口。快在传送门融化前找到它！"

msgctxt "lua.map"
msgid "You hear the solemn chanting of funerary rites."
msgstr "你听到葬礼仪式上庄严的吟唱。"

msgctxt "lua.map"
msgid "There is an entrance to the Necropolis on this level. Hurry and find it before the portal closes!"
msgstr "本层有通往亡者之城的入口。快在传送门关闭前找到它！"

msgctxt "lua.map"
msgid "You hear the hiss of flowing sand."
msgstr "你听到流沙的嘶嘶声。"

msgctxt "lua.map"
msgid "There is an entrance to an ossuary on this level. Hurry and find it before the portal is buried!"
msgstr "本层有通往埋骨地的入口。快在传送门被掩埋前找到它！"

msgctxt "lua.map"
msgid "You hear the sound of rushing water."
msgstr "你听到湍急的水声。"

msgctxt "lua.map"
msgid "There is an entrance to a sewer on this level. Hurry and find it before the portal rusts away!"
msgstr "本层有通往下水道的入口。快在传送门锈蚀崩毁前找到它！"

msgctxt "lua.map"
msgid "You feel an oppressive heat about you."
msgstr "你感到周围热浪逼人。"

msgctxt "lua.map"
msgid "There is an entrance to a volcano on this level. Hurry and find it before the entrance collapses!"
msgstr "本层有通往火山的入口。快在入口坍塌前找到它！"

msgctxt "lua.map"
msgid "You hear the crackle of arcane power."
msgstr "你听到奥术能量的噼啪声。"

msgctxt "lua.map"
msgid "There is an entrance to a wizard's laboratory on this level! Hurry and find it before the portal closes forever!"
msgstr "本层有通往巫师实验室的入口！快在传送门永久关闭前找到它！"

msgctxt "lua.map"
msgid "The portal closes with a thud."
msgstr "传送门砰的一声关闭了。"

msgctxt "lua.map"
msgid "The gate to the bazaar disappears!"
msgstr "通往市集的大门消失了！"

msgctxt "lua.map"
msgid "The gateway collapses."
msgstr "入口坍塌了。"

msgctxt "lua.map"
msgid "The archway melts and disappears."
msgstr "拱门融化消失了。"

msgctxt "lua.map"
msgid "The funeral rites fall silent, and the phantasmal passage disappears!"
msgstr "葬礼仪式归于寂静，幻影通道消失了！"

msgctxt "lua.map"
msgid "The hiss of flowing sand is gone."
msgstr "流沙的嘶嘶声消失了。"

msgctxt "lua.map"
msgid "The drain falls to bits."
msgstr "排水口碎裂崩塌了。"

msgctxt "lua.map"
msgid "There is a deep roar from within the tunnel. Moments later, a river of lava pours forth, sealing it permanently."
msgstr "隧道深处传来低沉的轰鸣。片刻之后，一股熔岩涌出，将它永久封住。"

msgctxt "lua.map"
msgid "The flow of magic halts."
msgstr "魔力的流动停止了。"

