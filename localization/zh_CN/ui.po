msgctxt "phase4.item-use"
msgid "You can't carry that many items."
msgstr "你无法携带这么多物品。"

msgctxt "phase4.item-use"
msgid "You don't have anything to inscribe."
msgstr "你没有可以添加铭文的物品。"

msgctxt "phase4.item-use"
msgid "You take a swig of the potion and flex your muscles."
msgstr "你喝了一口药水，舒展了一下肌肉。"

msgctxt "phase4.item-use"
msgid "The energy of discovery flows from your fingertips!"
msgstr "发现的能量从你的指尖涌出！"

msgctxt "phase4.item-use"
msgid "A wave of despondency washes over your surroundings."
msgstr "一阵消沉的气息掠过四周。"

msgctxt "phase4.item-use"
msgid "This is a scroll of acquirement!"
msgstr "这是一张获取卷轴！"

msgctxt "phase4.item-use"
msgid "Anything you acquired here would fall and be lost!"
msgstr "在这里获取的任何物品都会掉下去，永远丢失！"

msgctxt "phase4.item-use"
msgid "You assume a fearsome visage."
msgstr "你显露出可怖的面容。"

msgctxt "phase4.item-use"
msgid "The creatures around you are filled with an inner flame!"
msgstr "你周围的生物体内燃起了心火！"

msgctxt "phase4.item-use"
msgid "The air around you briefly surges with heat, but it dissipates."
msgstr "周围的空气短暂涌起热浪，随即消散。"

msgctxt "phase4.item-use"
msgid "It is a scroll of enchant weapon."
msgstr "这是一张武器附魔卷轴。"

msgctxt "phase4.item-use"
msgid "It is a scroll of brand weapon."
msgstr "这是一张印记卷轴。"

msgctxt "phase4.item-use"
msgid "It is a scroll of identify."
msgstr "这是一张鉴定卷轴。"

msgctxt "phase4.item-use"
msgid "It is a scroll of enchant armour."
msgstr "这是一张防具附魔卷轴。"

msgctxt "phase4.item-use"
msgid "It is a scroll of amnesia."
msgstr "这是一张遗忘卷轴。"

msgctxt "phase4.item-use"
msgid "You feel forgetful for a moment."
msgstr "你一瞬间感到有些健忘。"

msgctxt "phase4.item-use"
msgid "You can't pick that up."
msgstr "你无法拾取那个物品。"

msgctxt "phase4.evoke"
msgid "Nothing answers your call."
msgstr "没有任何东西回应你的呼唤。"

msgctxt "phase4.evoke"
msgid "You can't zap that!"
msgstr "你无法使用那个魔杖！"

msgctxt "phase4.evoke"
msgid "You conserve a charge of your wand."
msgstr "你节省了一次魔杖充能。"

msgctxt "phase4.evoke"
msgid "The now-empty wand crumbles to dust."
msgstr "耗尽充能的魔杖化为了尘土。"

msgctxt "phase4.evoke"
msgid "You open the lid..."
msgstr "你打开盖子……"

msgctxt "phase4.evoke"
msgid "...but nothing happens."
msgstr "……但什么也没有发生。"

msgctxt "phase4.evoke"
msgid "You reach into the sack..."
msgstr "你把手伸进袋子……"

msgctxt "phase4.evoke"
msgid "...and things crawl out!"
msgstr "……有东西爬了出来！"

msgctxt "phase4.evoke"
msgid "...but only cobwebs fall out."
msgstr "……但只有蛛网落了出来。"

msgctxt "phase4.evoke"
msgid "You can't place a gateway to a ziggurat here."
msgstr "你无法在这里放置通往神塔的入口。"

msgctxt "phase4.evoke"
msgid "Finish your current ziggurat first!"
msgstr "先完成当前的神塔！"

msgctxt "phase4.evoke"
msgid "You set the figurine down, and a mystic portal to a ziggurat forms."
msgstr "你放下雕像，一道通往神塔的神秘传送门随之形成。"

msgctxt "phase4.evoke"
msgid "You can't use the mirror on yourself."
msgstr "你无法用镜子复制自己。"

msgctxt "phase4.evoke"
msgid "You can't see anything there to clone."
msgstr "你看不到那里有任何可以复制的东西。"

msgctxt "phase4.evoke"
msgid "The mirror can't reflect that."
msgstr "镜子无法映照那个目标。"

msgctxt "phase4.evoke"
msgid "The box is emptied!"
msgstr "盒子空了！"

msgctxt "phase4.evoke"
msgid "The sack is emptied!"
msgstr "袋子空了！"

msgctxt "phase4.evoke"
msgid "The lightning rod overheats!"
msgstr "闪电棒过热了！"

msgctxt "phase4.evoke"
msgid "The mirror clouds!"
msgstr "镜面变得模糊！"

msgctxt "phase4.evoke"
msgid "The tin is emptied!"
msgstr "罐子空了！"

msgctxt "phase4.evoke"
msgid "The condenser dries out!"
msgstr "凝聚器干涸了！"

