msgctxt "d.feature"
msgid "There is an entrance to %s here."
msgstr "这里有通往%s的入口。"

#, c-format
msgctxt "d.feature.help"
msgid "\nWhile standing here, you can traverse %s with the <w>%s</w> key."
msgstr "\n站在这里时，可以通过%s，按键为 <w>%s</w>。"

