msgctxt "w.ui"
msgid "You can't move yourself into the arena."
msgstr "你不能将自己移入竞技场。"

msgctxt "w.ui"
msgid "Monster is already summoned."
msgstr "怪物已经是召唤物了。"

msgctxt "w.ui"
msgid "What summon longevity (1 to 6)? "
msgstr "召唤持续时间等级（1 至 6）？ "

msgctxt "w.ui"
msgid "Which summon type (ESC to exit)?"
msgstr "选择召唤类型（ESC 退出）？"

msgctxt "w.ui"
msgid "Cast which spell by name? "
msgstr "施放哪个法术（输入英文名）？ "

msgctxt "w.ui"
msgid "No such spell."
msgstr "没有这个法术。"

msgctxt "w.ui"
msgid "Monster is now summoned."
msgstr "怪物现在是召唤物了。"

msgctxt "w.ui"
msgid "Invalid monster type."
msgstr "无效的怪物类型。"

msgctxt "w.ui"
msgid "Old type and new type are the same, not polymorphing."
msgstr "新旧类型相同，不进行变形。"

msgctxt "w.ui"
msgid "Target species must be different from current species."
msgstr "目标种族必须与当前种族不同。"

msgctxt "w.ui"
msgid "Polymorph failed."
msgstr "变形失败。"

msgctxt "w.ui"
msgid "Monster turned into something other than the desired type."
msgstr "怪物变成了预期之外的类型。"

msgctxt "w.ui"
msgid "Choose a destination!"
msgstr "选择目的地！"

msgctxt "w.ui"
msgid "Can't make already dead target miscast."
msgstr "不能让已死亡的目标发生法术失误。"

msgctxt "w.ui"
msgid "Miscast which school or spell, by name? "
msgstr "测试哪个学派或法术的失误（输入英文名）？ "

msgctxt "w.ui"
msgid "No matching spell or spell school."
msgstr "没有匹配的法术或学派。"

msgctxt "w.ui"
msgid "Enter fail: "
msgstr "输入失败值： "

msgctxt "w.ui"
msgid "Enter level, fail: "
msgstr "输入等级和失败值： "

msgctxt "w.ui"
msgid "Can only enter spell level for schools, not spells."
msgstr "只能为学派输入法术等级，具体法术无需输入。"

msgctxt "w.ui"
msgid "Spell level can be at most 9."
msgstr "法术等级不能超过 9。"

msgctxt "w.ui"
msgid "Number of repetitions? "
msgstr "重复多少次？ "

msgctxt "w.ui"
msgid "Key pressed, interrupting miscast testing."
msgstr "收到按键，停止失误测试。"

msgctxt "w.ui"
msgid "(C)reate, create (T)emporary, or (L)oad bones file?"
msgstr "创建(C)、临时创建(T)或载入遗骨文件(L)？"

msgctxt "w.ui"
msgid "What species would you like to be now? "
msgstr "现在要变成哪个种族（输入英文名）？ "

msgctxt "w.ui"
msgid "That species isn't available."
msgstr "该种族不可用。"

msgctxt "w.ui"
msgid "Cast which spell? "
msgstr "施放哪个法术（输入英文名）？ "

msgctxt "w.ui"
msgid "Cannot find that spell."
msgstr "找不到这个法术。"

msgctxt "w.ui"
msgid "Memorise which spell? "
msgstr "记忆哪个法术（输入英文名）？ "

msgctxt "w.ui"
msgid "Spell is monster-only - unpredictable behaviour may result."
msgstr "此法术仅供怪物使用，可能出现不可预测的行为。"

msgctxt "w.ui"
msgid "Super healing."
msgstr "超级治疗。"

#, c-format
msgctxt "w.ui"
msgid "Piety needs to be between 0 and %d."
msgstr "虔诚必须在 0 到 %d 之间。"

#, c-format
msgctxt "w.ui"
msgid "Ru piety can't be greater than %d."
msgstr "入的虔诚不能超过 %d。"

#, c-format
msgctxt "w.ui"
msgid "Enter new interest (current = %d, Enter for 0): "
msgstr "输入新的关注度（当前 %d，Enter 设为 0）： "

msgctxt "w.ui"
msgid "Interest must be between 0 and 255."
msgstr "关注度必须在 0 到 255 之间。"

#, c-format
msgctxt "w.ui"
msgid "Set piety to %d, interest to %d."
msgstr "虔诚设为 %d，关注度设为 %d。"

msgctxt "w.ui"
msgid "Are you sure you want to be excommunicated?"
msgstr "确定要被逐出教会吗？"

#, c-format
msgctxt "w.ui"
msgid "Setting piety to %d."
msgstr "正在将虔诚设为 %d。"

#, c-format
msgctxt "w.ui"
msgid "Enter new gold value (current = %d, Enter for %d): "
msgstr "输入新的金币数（当前 %d，Enter 设为 %d）： "

msgctxt "w.ui"
msgid "You are not religious!"
msgstr "你没有信仰任何神祇！"

#, c-format
msgctxt "w.ui"
msgid "Current progress to next sacrifice: %d  Progress needed: %d"
msgstr "当前献祭进度：%d  所需进度：%d"

#, c-format
msgctxt "w.ui"
msgid "Enter new piety value (current = %d, Enter for 0): "
msgstr "输入新的虔诚值（当前 %d，Enter 设为 0）： "

msgctxt "w.ui"
msgid "Which skill (by name)? "
msgstr "选择技能（输入英文名）？ "

msgctxt "w.ui"
msgid "That skill doesn't seem to exist."
msgstr "这项技能似乎不存在。"

msgctxt "w.ui"
msgid "That skill was removed."
msgstr "这项技能已被移除。"

msgctxt "w.ui"
msgid "Can't change a useless skill."
msgstr "无法修改无用的技能。"

#, c-format
msgctxt "w.ui"
msgid "To what level? (current = %.1f) "
msgstr "设为多少级？（当前 %.1f） "

msgctxt "w.ui"
msgid "Set all skills to what level? "
msgstr "将全部技能设为多少级？ "

msgctxt "w.ui"
msgid "Ignoring mut resistance to apply mutation."
msgstr "忽略变异抗性，施加变异。"

msgctxt "w.ui"
msgid "Which mutation (name, 'good', 'bad', 'any', 'xom', 'slime', 'qazlal')? "
msgstr "选择变异（英文名，或 'good'、'bad'、'any'、'xom'、'slime'、'qazlal'）？ "

msgctxt "w.ui"
msgid "No matching mutation names."
msgstr "没有匹配的变异名。"

msgctxt "w.ui"
msgid "How many levels to increase or decrease? "
msgstr "增加或减少多少级？ "

msgctxt "w.ui"
msgid "Which bane? "
msgstr "选择哪个灾厄（输入英文名）？ "

msgctxt "w.ui"
msgid "No matching bane names."
msgstr "没有匹配的灾厄名。"

msgctxt "w.ui"
msgid "Enter values for X, Y, Z (space separated) or return: "
msgstr "输入 X、Y、Z 的值（空格分隔），或按回车： "

msgctxt "w.ui"
msgid "Enter values for Str, Int, Dex (space separated): "
msgstr "输入力量、智力、敏捷值（空格分隔）： "

#, c-format
msgctxt "w.ui"
msgid "Setting attributes (Str, Int, Dex) to: %i, %i, %i"
msgstr "属性（力量、智力、敏捷）设为：%i、%i、%i"

msgctxt "w.ui"
msgid "Edit which duration (name)? "
msgstr "编辑哪个持续状态（输入英文名）？ "

msgctxt "w.ui"
msgid "Edit which duration (ESC to exit)?"
msgstr "编辑哪个持续状态（ESC 退出）？"

msgctxt "w.ui"
msgid "Can't set duration directly to 0, setting it to 1 instead."
msgstr "不能直接将持续时间设为 0，已改为 1。"

msgctxt "w.ui"
msgid "Enter new experience level: "
msgstr "输入新的经验等级： "

#, c-format
msgctxt "w.ui"
msgid "Experience level set to %d."
msgstr "经验等级已设为 %d。"

msgctxt "w.ui"
msgid "Nothing happens."
msgstr "什么也没发生。"

msgctxt "w.ui"
msgid "You allow the flow of time to resume."
msgstr "你让时间恢复了流动。"

msgctxt "w.ui"
msgid "You bring the flow of time to a stop."
msgstr "你让时间停止了流动。"

msgctxt "w.ui"
msgid "That god doesn't seem to exist!"
msgstr "这位神祇似乎不存在！"

msgctxt "w.ui"
msgid "You suffer the terrible wrath of No God."
msgstr "你承受了“无神”的可怕神罚。"

msgctxt "w.ui"
msgid "You are not under penance."
msgstr "你没有受到赎罪惩罚。"

msgctxt "w.ui"
msgid "Which form (ESC to exit)?"
msgstr "选择形态（ESC 退出）？"

msgctxt "w.ui"
msgid "Transformation failed."
msgstr "变形失败。"

msgctxt "w.ui"
msgid "Not even in wizmode may divine creatures worship a god!"
msgstr "即使在巫师模式中，神性生物也不能信仰神祇！"

msgctxt "w.ui"
msgid "You already have no god!"
msgstr "你已经没有信仰了！"

msgctxt "w.ui"
msgid "You already worship that god!"
msgstr "你已经信仰这位神祇了！"

msgctxt "w.ui"
msgid "(Tension uses a given god's perspective to check on their summons; use 'No God' to ignore this.)"
msgstr "（威胁值会从指定神祇的角度判断召唤物；输入 'No God' 可忽略此影响。）"

msgctxt "w.ui"
msgid "What action should Xom take? (Blank = any) "
msgstr "让佐姆采取什么行动（输入英文名，留空随机）？ "

msgctxt "w.ui"
msgid "That action doesn't seem to exist!"
msgstr "这个行动似乎不存在！"

#, c-format
msgctxt "w.ui"
msgid "Zot clock should be between 0 and %d"
msgstr "佐特时钟必须在 0 到 %d 之间。"

#, c-format
msgctxt "w.ui"
msgid "Enter new Zot clock value (current = %d, from 0 to %d): "
msgstr "输入新的佐特时钟值（当前 %d，范围 0 至 %d）： "

msgctxt "w.ui"
msgid "You can only abyss_teleport() inside the Abyss."
msgstr "只能在深渊中执行 abyss_teleport()。"

msgctxt "w.ui"
msgid "Running Jiyva off-level sacrifice."
msgstr "正在执行吉瓦的跨楼层献祭。"

msgctxt "w.ui"
msgid "Failure to give mutation."
msgstr "施加变异失败。"

msgctxt "w.ui"
msgid "Failure to toggle bane."
msgstr "切换灾厄失败。"

msgctxt "w.ui"
msgid "Not a <magenta>Wizard</magenta> Command."
msgstr "这不是<magenta>巫师</magenta>命令。"

msgctxt "w.ui"
msgid "Re-activating wizard mode."
msgstr "重新启用巫师模式。"

msgctxt "w.ui"
msgid "Can't repeat re-activating wizard mode."
msgstr "无法重复重新启用巫师模式。"

msgctxt "w.ui"
msgid "WARNING: ABOUT TO ENTER WIZARD MODE!"
msgstr "警告：即将进入巫师模式！"

msgctxt "w.ui"
msgid "If you continue, your game will not be scored!"
msgstr "继续后，本局游戏将不计分！"

msgctxt "w.ui"
msgid "Do you really want to enter wizard mode?"
msgstr "确定要进入巫师模式吗？"

msgctxt "w.ui"
msgid "Can't repeat entering wizard mode."
msgstr "无法重复进入巫师模式。"

msgctxt "w.ui"
msgid "Enter Wizard Command (? - help): "
msgstr "输入巫师命令（? - 帮助）： "

msgctxt "w.ui"
msgid "You cannot repeat that wizard command."
msgstr "你无法重复该巫师命令。"

msgctxt "w.ui"
msgid "WARNING: ABOUT TO ENTER EXPLORE MODE!"
msgstr "警告：即将进入探索模式！"

msgctxt "w.ui"
msgid "In explore mode, death is optional."
msgstr "在探索模式中，你可以选择是否接受死亡。"

msgctxt "w.ui"
msgid "Once you set a character to explore mode, you can't switch back."
msgstr "角色一旦设为探索模式，就无法切回原模式。"

msgctxt "w.ui"
msgid "Do you really want to enter explore mode?"
msgstr "确定要进入探索模式吗？"

msgctxt "w.ui"
msgid "Can't repeat entering explore mode"
msgstr "无法重复进入探索模式。"

#, no-c-format
msgctxt "w.help"
msgid "<yellow>Player stats</yellow>\n<w>A</w>      set all skills to level\n<w>Ctrl-D</w> change enchantments/durations\n<w>g</w>      exercise a skill\n<w>k</w>      change experience level and skills\n<w>l</w>      change experience level\n<w>Ctrl-P</w> list props\n<w>r</w>      change character's species\n<w>s</w>      set skill to level\n<w>x</w>      gain an experience level\n<w>$</w>      set gold to a specified value\n<w>]</w>      get a mutation\n<w>}</w>      toggle a bane\n<w>_</w>      gain religion\n<w>^</w>      set piety to a value\n<w>@</w>      set Str Int Dex\n<w>#</w>      load character from a dump file\n<w>&</w>      list all divine followers\n<w>=</w>      show info about skill points\n<w>n</w>      set Zot clock to a value\n<w>N</w>      get current tension value\n\n<yellow>Dungeon features</yellow>\n<w>T</w>      make a trap\n<w>,</w>/<w>.</w>    create up/down staircase\n<w>(</w>      turn cell into feature\n<w>\\</w>      make a shop\n\n<yellow>Builder debugging</yellow>\n<w>L</w>      place a vault by name\n<w>P</w>      create a level based on a vault\n<w>R</w>      regenerate current level\n<w>Ctrl-A</w> generate new Abyss area\n<w>K</w>      mark all vaults as unused\n<w>:</w>      find branches and overflow\n       temples in the dungeon\n<w>;</w>      list known levels and counters\n<w>Ctrl-E</w> dump level builder information\n\n<yellow>Other level related commands</yellow>\n<w>{</w>      magic mapping\n<w>b</w>      controlled blink\n<w>B</w>      controlled teleport\n<w>~</w>      go to a specific level\n<w>u</w>/<w>d</w>    shift up/down one level\n<w>e</w>      trigger explore traps\n<w>Ctrl-B</w> banish yourself to the Abyss\n<w>Ctrl-S</w> change Abyss speed\n<w>Ctrl-W</w> change Shoals' tide speed\n"
msgstr "<yellow>玩家属性</yellow>\n<w>A</w>      设置全部技能等级\n<w>Ctrl-D</w> 修改附魔／持续状态\n<w>g</w>      锻炼技能\n<w>k</w>      修改经验等级及技能\n<w>l</w>      修改经验等级\n<w>Ctrl-P</w> 列出属性字段\n<w>r</w>      修改角色种族\n<w>s</w>      设置技能等级\n<w>x</w>      提升一级经验\n<w>$</w>      设置金币数\n<w>]</w>      获得变异\n<w>}</w>      切换灾厄\n<w>_</w>      选择信仰\n<w>^</w>      设置虔诚\n<w>@</w>      设置力量、智力、敏捷\n<w>#</w>      从转储文件载入角色\n<w>&</w>      列出全部神祇追随者\n<w>=</w>      显示技能点信息\n<w>n</w>      设置佐特时钟\n<w>N</w>      显示当前威胁值\n\n<yellow>地下城地形</yellow>\n<w>T</w>      创建陷阱\n<w>,</w>/<w>.</w>    创建上／下楼梯\n<w>(</w>      更改格子地形\n<w>\\</w>      创建商店\n\n<yellow>生成器调试</yellow>\n<w>L</w>      按英文名放置预设地图\n<w>P</w>      用预设地图创建楼层\n<w>R</w>      重新生成当前楼层\n<w>Ctrl-A</w> 生成新的深渊区域\n<w>K</w>      将所有预设地图标为未使用\n<w>:</w>      查找分支和额外\n       神殿在地下城中的位置\n<w>;</w>      列出已知楼层和计数器\n<w>Ctrl-E</w> 转储楼层生成信息\n\n<yellow>其他楼层命令</yellow>\n<w>{</w>      魔法探图\n<w>b</w>      受控闪现\n<w>B</w>      受控传送\n<w>~</w>      前往指定楼层\n<w>u</w>/<w>d</w>    向上／下移动一层\n<w>e</w>      触发探索陷阱\n<w>Ctrl-B</w> 将自己放逐到深渊\n<w>Ctrl-S</w> 修改深渊速度\n<w>Ctrl-W</w> 修改浅滩潮汐速度\n"

#, no-c-format
msgctxt "w.help"
msgid "<yellow>Player stats</yellow>\n<w>A</w>      set all skills to level\n<w>Ctrl-D</w> change enchantments/durations\n<w>g</w>      exercise a skill\n<w>k</w>      change experience level and skills\n<w>l</w>      change experience level\n<w>Ctrl-P</w> list props\n<w>r</w>      change character's species\n<w>s</w>      set skill to level\n<w>x</w>      gain an experience level\n<w>$</w>      set gold to a specified value\n<w>]</w>      get a mutation\n<w>}</w>      toggle a bane\n<w>_</w>      gain religion\n<w>^</w>      set piety to a value\n<w>@</w>      set Str Int Dex\n<w>#</w>      load character from a dump file\n<w>&</w>      list all divine followers\n<w>=</w>      show info about skill points\n<w>n</w>      set Zot clock to a value\n<w>N</w>      get current tension value\n\n<yellow>Dungeon features</yellow>\n<w>T</w>      make a trap\n<w>,</w>/<w>.</w>    create up/down staircase\n<w>(</w>      turn cell into feature\n<w>\\</w>      make a shop\n\n<yellow>Builder debugging</yellow>\n<w>L</w>      place a vault by name\n<w>P</w>      create a level based on a vault\n<w>R</w>      regenerate current level\n<w>Ctrl-A</w> generate new Abyss area\n<w>K</w>      mark all vaults as unused\n<w>:</w>      find branches and overflow\n       temples in the dungeon\n<w>;</w>      list known levels and counters\n<w>Ctrl-E</w> dump level builder information\n<w>Ctrl-L</w> show builder logs for level\n\n<yellow>Other level related commands</yellow>\n<w>{</w>      magic mapping\n<w>b</w>      controlled blink\n<w>B</w>      controlled teleport\n<w>~</w>      go to a specific level\n<w>u</w>/<w>d</w>    shift up/down one level\n<w>e</w>      trigger explore traps\n<w>Ctrl-B</w> banish yourself to the Abyss\n<w>Ctrl-S</w> change Abyss speed\n<w>Ctrl-W</w> change Shoals' tide speed\n"
msgstr "<yellow>玩家属性</yellow>\n<w>A</w>      设置全部技能等级\n<w>Ctrl-D</w> 修改附魔／持续状态\n<w>g</w>      锻炼技能\n<w>k</w>      修改经验等级及技能\n<w>l</w>      修改经验等级\n<w>Ctrl-P</w> 列出属性字段\n<w>r</w>      修改角色种族\n<w>s</w>      设置技能等级\n<w>x</w>      提升一级经验\n<w>$</w>      设置金币数\n<w>]</w>      获得变异\n<w>}</w>      切换灾厄\n<w>_</w>      选择信仰\n<w>^</w>      设置虔诚\n<w>@</w>      设置力量、智力、敏捷\n<w>#</w>      从转储文件载入角色\n<w>&</w>      列出全部神祇追随者\n<w>=</w>      显示技能点信息\n<w>n</w>      设置佐特时钟\n<w>N</w>      显示当前威胁值\n\n<yellow>地下城地形</yellow>\n<w>T</w>      创建陷阱\n<w>,</w>/<w>.</w>    创建上／下楼梯\n<w>(</w>      更改格子地形\n<w>\\</w>      创建商店\n\n<yellow>生成器调试</yellow>\n<w>L</w>      按英文名放置预设地图\n<w>P</w>      用预设地图创建楼层\n<w>R</w>      重新生成当前楼层\n<w>Ctrl-A</w> 生成新的深渊区域\n<w>K</w>      将所有预设地图标为未使用\n<w>:</w>      查找分支和额外\n       神殿在地下城中的位置\n<w>;</w>      列出已知楼层和计数器\n<w>Ctrl-E</w> 转储楼层生成信息\n<w>Ctrl-L</w> 显示本层生成日志\n\n<yellow>其他楼层命令</yellow>\n<w>{</w>      魔法探图\n<w>b</w>      受控闪现\n<w>B</w>      受控传送\n<w>~</w>      前往指定楼层\n<w>u</w>/<w>d</w>    向上／下移动一层\n<w>e</w>      触发探索陷阱\n<w>Ctrl-B</w> 将自己放逐到深渊\n<w>Ctrl-S</w> 修改深渊速度\n<w>Ctrl-W</w> 修改浅滩潮汐速度\n"

#, no-c-format
msgctxt "w.help"
msgid "<yellow>Other player related effects</yellow>\n<w>c</w>      card effect\n<w>h</w>/<w>H</w>    heal yourself (super-Heal)\n<w>X</w>      make Xom do something now\n<w>z</w>      cast spell by number/name\n<w>!</w>      memorise spell\n<w>W</w>      god wrath\n<w>w</w>      god mollification\n<w>p</w>      polymorph into a form\n<w>V</w>      toggle xray vision\n<w>E</w>      (un)freeze time\n\n<yellow>Monster related commands</yellow>\n<w>m</w>/<w>M</w>    create specified monster\n<w>D</w>      detect all monsters\n<w>G</w>      dismiss all monsters\n<w>\"</w>      list monsters\n\n<yellow>Item related commands</yellow>\n<w>a</w>      acquirement\n<w>i</w>/<w>I</w>    identify/unidentify inventory\n<w>y</w>/<w>Y</w>    id/unid item types+level items\n<w>o</w>/<w>%</w>    create an object\n<w>t</w>      tweak object properties\n<w>v</w>      recharge all XP evokers\n<w>Ctrl-V</w> show gold value of an item\n<w>-</w>      get a god gift\n<w>|</w>      create all unrand artefacts\n<w>Ctrl-\\</w> create all unrands / fallbacks\n<w>+</w>      make randart from item\n<w>'</w>      list items\n<w>J</w>      Jiyva off-level sacrifice\n<w>Z</w>      Unobtain runes and Orb of Zot\n\n<yellow>Debugging commands</yellow>\n<w>f</w>      quick fight simulation\n<w>F</w>      single scale fsim\n<w>Ctrl-F</w> double scale fsim\n<w>Ctrl-I</w> item generation stats\n<w>O</w>      measure exploration time\n<w>Ctrl-T</w> dungeon (D)Lua interpreter\n<w>Ctrl-U</w> client (C)Lua interpreter\n<w>Ctrl-X</w> Xom effect stats\n<w>Ctrl-Y</w> temporarily suppress wizmode\n<w>Ctrl-C</w> force a crash\n<w>`</w>      list unassigned command keys\n\n<yellow>Other wizard commands</yellow>\n(not prefixed with <w>&</w>!)\n<w>x?</w>     list targeted commands\n<w>X?</w>     list map-mode commands\n"
msgstr "<yellow>其他玩家效果</yellow>\n<w>c</w>      卡牌效果\n<w>h</w>/<w>H</w>    治疗自己（超级治疗）\n<w>X</w>      让佐姆立即行动\n<w>z</w>      按编号／英文名施法\n<w>!</w>      记忆法术\n<w>W</w>      触发神罚\n<w>w</w>      平息神怒\n<w>p</w>      变成指定形态\n<w>V</w>      切换透视\n<w>E</w>      冻结／恢复时间\n\n<yellow>怪物命令</yellow>\n<w>m</w>/<w>M</w>    创建指定怪物\n<w>D</w>      侦测全部怪物\n<w>G</w>      遣散全部怪物\n<w>\"</w>      列出怪物\n\n<yellow>物品命令</yellow>\n<w>a</w>      宝物获取\n<w>i</w>/<w>I</w>    鉴定／取消鉴定物品栏\n<w>y</w>/<w>Y</w>    鉴定／取消鉴定种类及本层物品\n<w>o</w>/<w>%</w>    创建物品\n<w>t</w>      调整物品属性\n<w>v</w>      充能全部经验唤发物品\n<w>Ctrl-V</w> 显示物品金币价值\n<w>-</w>      获得神赐物品\n<w>|</w>      创建全部固定神器\n<w>Ctrl-\\</w> 创建全部固定神器／替代品\n<w>+</w>      将物品变成随机神器\n<w>'</w>      列出物品\n<w>J</w>      吉瓦跨楼层献祭\n<w>Z</w>      撤销符文和佐特宝珠获取\n\n<yellow>调试命令</yellow>\n<w>f</w>      快速战斗模拟\n<w>F</w>      单参数战斗模拟\n<w>Ctrl-F</w> 双参数战斗模拟\n<w>Ctrl-I</w> 物品生成统计\n<w>O</w>      测量探索耗时\n<w>Ctrl-T</w> 地下城 (D)Lua 解释器\n<w>Ctrl-U</w> 客户端 (C)Lua 解释器\n<w>Ctrl-X</w> 佐姆效果统计\n<w>Ctrl-Y</w> 暂时停用巫师模式\n<w>Ctrl-C</w> 强制崩溃\n<w>`</w>      列出未分配命令键\n\n<yellow>其他巫师命令</yellow>\n（不加 <w>&</w> 前缀！）\n<w>x?</w>     列出瞄准命令\n<w>X?</w>     列出地图模式命令\n"

