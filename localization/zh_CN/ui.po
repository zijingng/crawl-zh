msgid "%s is immovably fixed there."
msgstr "%s牢牢固定在那里，无法移动。"

msgctxt "s.log"
msgid "...but somehow remains in the same place."
msgstr "……但不知为何仍留在原地。"

#, c-format
msgctxt "s.log"
msgid "You are hurled through space towards %s monsters!"
msgstr "你被掷穿空间，朝%s怪物飞去！"

#, c-format
msgctxt "s.log"
msgid "%s tunnels through space-time and arrives with you!"
msgstr "%s穿过时空隧道，与你一同到达！"

#, c-format
msgctxt "s.log"
msgid "You create a dimensional link between your ranged weaponry and %s."
msgstr "你在自己的远程武器与%s之间建立了空间连接。"

