msgctxt "d.god.power"
msgid "recite Zin's Axioms of Law"
msgstr "你可以诵读辛的法则公理。"

msgctxt "d.god.power"
msgid "call upon Zin for vitalisation"
msgstr "你可以祈求辛赐予活力。"

msgctxt "d.god.power"
msgid "call upon Zin to imprison the lawless"
msgstr "你可以祈求辛囚禁不法者。"

msgctxt "d.god.power"
msgid "call upon Zin to create a sanctuary"
msgstr "你可以祈求辛创造庇护所。"

msgctxt "d.god.power"
msgid "Zin will cleanse your potions of mutation."
msgstr "辛会净化你的变异药水。"

msgctxt "d.god.power"
msgid "donate money to Zin"
msgstr "你可以向辛捐献金钱。"

msgctxt "d.god.power"
msgid "You and your allies can gain power from killing the unholy and evil."
msgstr "你与你的盟友可以通过杀死不洁与邪恶生物获取力量。"

msgctxt "d.god.power"
msgid "call upon the Shining One for a divine shield"
msgstr "你可以祈求光明神赐予神圣护盾。"

msgctxt "d.god.power"
msgid "channel blasts of cleansing flame"
msgstr "你可以引导净化火焰的爆发。"

msgctxt "d.god.power"
msgid "summon a divine warrior"
msgstr "你可以召唤神圣战士。"

msgctxt "d.god.power"
msgid "The Shining One will bless your weapon with holy wrath... once."
msgstr "光明神将以神圣之怒祝福你的武器……仅此一次。"

msgctxt "d.god.power"
msgid "bring forth the wretched and dying"
msgstr "你可以唤来可怜的濒死者。"

msgctxt "d.god.power"
msgid "Kikubaaqudgha protects you from necromantic miscasts and death curses."
msgstr "奇库巴库哈保护你免受死灵魔法误施与死亡诅咒的影响。"

msgctxt "d.god.power"
msgid "Kikubaaqudgha protects you from unholy torment."
msgstr "奇库巴库哈保护你免受邪恶的折磨。"

msgctxt "d.god.power"
msgid "invoke the sign of ruin"
msgstr "你可以唤起毁灭征兆。"

msgctxt "d.god.power"
msgid "Kikubaaqudgha will grant you forbidden knowledge or bloody your weapon with pain... once."
msgstr "奇库巴库哈将赐予你禁忌知识，或以痛苦染血你的武器……仅此一次。"

msgctxt "d.god.power"
msgid "Kikubaaqudgha will grant you forbidden knowledge."
msgstr "奇库巴库哈将赐予你禁忌知识。"

msgctxt "d.god.power"
msgid "light the black torch and reap souls in Yredelemnul's name"
msgstr "你可以点燃黑色火炬，以伊莱德莱姆努尔之名收割灵魂。"

msgctxt "d.god.power"
msgid "recall your undead harvest"
msgstr "你可以召回收割而来的亡灵。"

msgctxt "d.god.power"
msgid "Yredelemnul will gift you temporary undead servants when you light the torch."
msgstr "点燃火炬时，伊莱德莱姆努尔会赐予你临时的亡灵仆从。"

msgctxt "d.god.power"
msgid "hurl gouts of umbral torchlight"
msgstr "你可以投掷成团的暗影炬光。"

msgctxt "d.god.power"
msgid "bind living souls"
msgstr "你可以束缚活体的灵魂。"

msgctxt "d.god.power"
msgid "engulf your surroundings in Yredelemnul's grip"
msgstr "你可以用伊莱德莱姆努尔的掌控笼罩周围。"

msgctxt "d.god.power"
msgid "gain magical power from killing"
msgstr "你可以通过杀敌恢复魔力。"

msgctxt "d.god.power"
msgid "Vehumet aids your destructive spells."
msgstr "维胡梅特增强你的毁灭性法术。"

msgctxt "d.god.power"
msgid "Vehumet extends the range of your destructive spells."
msgstr "维胡梅特延长你的毁灭性法术的射程。"

msgctxt "d.god.power"
msgid "Okawaru requires that you fight alone, and prevents you from gaining allies."
msgstr "奥格瓦如要求你独自战斗，使你无法获得盟友。"

msgctxt "d.god.power"
msgid "gain great but temporary skills"
msgstr "你可以暂时获得高超的技艺。"

msgctxt "d.god.power"
msgid "speed up your combat"
msgstr "你可以加快战斗中的攻击速度。"

msgctxt "d.god.power"
msgid "enter into single combat with a foe"
msgstr "你可以与一名敌人展开单挑。"

msgctxt "d.god.power"
msgid "Okawaru will gift you throwing weapons as you gain piety."
msgstr "随着你的虔诚增长，奥格瓦如会赐予你投掷武器。"

msgctxt "d.god.power"
msgid "Okawaru will grant you a choice of weapons... once."
msgstr "奥格瓦如将让你挑选一件武器……仅此一次。"

msgctxt "d.god.power"
msgid "Okawaru will grant you a choice of armour... once."
msgstr "奥格瓦如将让你挑选一件防具……仅此一次。"

msgctxt "d.god.power"
msgid "gain health from killing"
msgstr "你可以通过杀敌恢复生命。"

msgctxt "d.god.power"
msgid "unleash Makhleb's destructive might"
msgstr "你可以释放马科列布的毁灭之力。"

msgctxt "d.god.power"
msgid "summon an infernal servant of Makhleb"
msgstr "你可以召唤马科列布的地狱仆从。"

msgctxt "d.god.power"
msgid "Makhleb will allow you to brand your body with an infernal mark... once."
msgstr "马科列布将允许你在身上烙印地狱印记……仅此一次。"

msgctxt "d.god.power"
msgid "call upon Sif Muna for magical energy"
msgstr "你可以祈求席夫·穆纳赐予魔力。"

msgctxt "d.god.power"
msgid "freely open your mind to new spells"
msgstr "你可以自由地敞开心灵，学习新的法术。"

msgctxt "d.god.power"
msgid "call upon Sif Muna to cast any spell from your library"
msgstr "你可以祈求席夫·穆纳施放法术库中的任意法术。"

msgctxt "d.god.power"
msgid "Sif Muna will gift you books as you gain piety."
msgstr "随着你的虔诚增长，席夫·穆纳会赐予你法术书。"

msgctxt "d.god.power"
msgid "go berserk at will"
msgstr "你可以随时进入狂暴。"

msgctxt "d.god.power"
msgid "call upon Trog for regeneration and willpower"
msgstr "你可以祈求特洛戈赐予再生与意志力。"

msgctxt "d.god.power"
msgid "call in reinforcements"
msgstr "你可以召来援军。"

msgctxt "d.god.power"
msgid "Trog will gift you melee weapons as you gain piety."
msgstr "随着你的虔诚增长，特洛戈会赐予你近战武器。"

msgctxt "d.god.power"
msgid "draw from decks of power"
msgstr "你可以从力量牌组中抽牌。"

msgctxt "d.god.power"
msgid "Nemelex will gift you decks of power as you gain piety."
msgstr "随着你的虔诚增长，尼姆雷斯・索布会赐予你力量牌组。"

msgctxt "d.god.power"
msgid "choose one out of three cards"
msgstr "你可以从三张牌中选取一张。"

msgctxt "d.god.power"
msgid "deal four cards at a time"
msgstr "你可以一次发出四张牌。"

msgctxt "d.god.power"
msgid "stack five cards from your decks"
msgstr "你可以从牌组中叠放五张牌。"

msgctxt "d.god.power"
msgid "purify yourself"
msgstr "你可以净化自身。"

msgctxt "d.god.power"
msgid "heal and attempt to pacify others"
msgstr "你可以治疗其他生物并尝试使其和平。"

msgctxt "d.god.power"
msgid "provide healing for yourself"
msgstr "你可以治疗自身。"

msgctxt "d.god.power"
msgid "call upon Elyvilon for divine vigour"
msgstr "你可以祈求艾利维隆赐予神圣活力。"

msgctxt "d.god.power"
msgid "Lugonu protects you from the effects of unwielding distortion weapons."
msgstr "卢戈努保护你免受放下扭曲武器的影响。"

msgctxt "d.god.power"
msgid "Lugonu may banish nearby foes when other gods try to punish you."
msgstr "其他神祇试图惩罚你时，卢戈努可能放逐附近的敌人。"

msgctxt "d.god.power"
msgid "depart the Abyss"
msgstr "你可以离开深渊。"

msgctxt "d.god.power"
msgid "banish your foes"
msgstr "你可以放逐敌人。"

msgctxt "d.god.power"
msgid "corrupt the fabric of space"
msgstr "你可以腐化空间结构。"

msgctxt "d.god.power"
msgid "gate yourself to the Abyss"
msgstr "你可以将自己传送至深渊。"

msgctxt "d.god.power"
msgid "Lugonu will corrupt your weapon with distortion... once."
msgstr "卢戈努将以扭曲之力腐化你的武器……仅此一次。"

msgctxt "d.god.power"
msgid "smite your foes"
msgstr "你可以惩击敌人。"

msgctxt "d.god.power"
msgid "recall your apostles"
msgstr "你可以召回使徒。"

msgctxt "d.god.power"
msgid "Beogh will send orc apostles to challenge you in battle as you gain piety."
msgstr "随着你的虔诚增长，比欧弗会派遣兽人使徒前来挑战你。"

msgctxt "d.god.power"
msgid "You can recruit apostles that you defeat into your service."
msgstr "你可以招募被你击败的使徒为你效力。"

msgctxt "d.god.power"
msgid "Your apostles are sometimes healed when you deal damage."
msgstr "当你造成伤害时，你的使徒有时会得到治疗。"

msgctxt "d.god.power"
msgid "rally a vengeful horde"
msgstr "你可以集结复仇的军团。"

msgctxt "d.god.power"
msgid "walk on water"
msgstr "你可以在水面行走。"

msgctxt "d.god.power"
msgid "Jiyva protects you from corrosive effects."
msgstr "吉瓦保护你免受腐蚀效果影响。"

msgctxt "d.god.power"
msgid "Jiyva will mutate your body as you gain piety."
msgstr "随着你的虔诚增长，吉瓦会使你的身体发生变异。"

msgctxt "d.god.power"
msgid "call acidic ooze from nearby walls"
msgstr "你可以从附近墙壁中唤出酸性黏液。"

msgctxt "d.god.power"
msgid "turn your foes to slime"
msgstr "你可以将敌人化为黏液。"

msgctxt "d.god.power"
msgid "You may expel jellies when seriously injured."
msgstr "你受到重伤时可能释放出软泥怪。"

msgctxt "d.god.power"
msgid "You can walk through plants and fire through allied plants."
msgstr "你可以穿过植物，并让攻击穿过友方植物。"

msgctxt "d.god.power"
msgid "encircle yourself with summoned briar patches"
msgstr "你可以召唤荆棘丛环绕自身。"

msgctxt "d.god.power"
msgid "grow a ballistomycete"
msgstr "你可以培育一株弹道真菌。"

msgctxt "d.god.power"
msgid "transform dungeon walls and trees into plant allies"
msgstr "你可以将地下城墙壁与树木转化为植物盟友。"

msgctxt "d.god.power"
msgid "grow an oklob plant"
msgstr "你可以培育一株奥克罗布植物。"

msgctxt "d.god.power"
msgid "Cheibriados slows the effects of poison on you."
msgstr "切布理亚多延缓毒素对你的作用。"

msgctxt "d.god.power"
msgid "bend time to slow others"
msgstr "你可以扭曲时间，使其他生物减速。"

msgctxt "d.god.power"
msgid "warp the flow of time around you"
msgstr "你可以扭转周围的时间流动。"

msgctxt "d.god.power"
msgid "inflict damage on those overly hasty"
msgstr "你可以对过于急躁的生物造成伤害。"

msgctxt "d.god.power"
msgid "step out of the flow of time"
msgstr "你可以步出时间之流。"

msgctxt "d.god.power"
msgid "Ashenzari warns you of distant threats and treasures.\nAshenzari shows you where magical portals lie."
msgstr "艾申扎利会警告你远处的威胁与宝藏。\n艾申扎利会指示魔法传送门的位置。"

msgctxt "d.god.power"
msgid "Ashenzari identifies your possessions."
msgstr "艾申扎利鉴定你拥有的物品。"

msgctxt "d.god.power"
msgid "Ashenzari reveals the unseen."
msgstr "艾申扎利揭示不可见的事物。"

msgctxt "d.god.power"
msgid "Ashenzari keeps your mind clear."
msgstr "艾申扎利使你保持头脑清醒。"

msgctxt "d.god.power"
msgid "Ashenzari protects you from the dungeon's malevolent forces."
msgstr "艾申扎利保护你免受地下城中恶意力量的侵扰。"

msgctxt "d.god.power"
msgid "Ashenzari reveals the structure of the nearby dungeon."
msgstr "艾申扎利揭示附近地下城的结构。"

msgctxt "d.god.power"
msgid "Dithmenos quiets all noise in your surroundings."
msgstr "迪斯姆诺使你周围的一切声音安静下来。"

msgctxt "d.god.power"
msgid "Your shadow sometimes tangibly mimics your actions."
msgstr "你的影子有时会化为实体，模仿你的行动。"

msgctxt "d.god.power"
msgid "mislead enemies by swapping places with your shadow"
msgstr "你可以与影子交换位置，误导敌人。"

msgctxt "d.god.power"
msgid "unleash an enemy's spells as if they were a marionette"
msgstr "你可以将敌人当作提线偶，释放其法术。"

msgctxt "d.god.power"
msgid "surround yourself with impenetrable night"
msgstr "你可以让无法穿透的黑夜环绕自身。"

msgctxt "d.god.power"
msgid "Gozag turns your defeated foes' bodies to gold."
msgstr "哥萨戈将被你击败的敌人的尸体化为黄金。"

msgctxt "d.god.power"
msgid "Your enemies may become distracted by gold."
msgstr "你的敌人可能因黄金而分心。"

msgctxt "d.god.power"
msgid "petition Gozag for potion effects"
msgstr "你可以向哥萨戈请求药水效果。"

msgctxt "d.god.power"
msgid "fund merchants seeking to open stores in the dungeon"
msgstr "你可以资助打算在地下城开店的商人。"

msgctxt "d.god.power"
msgid "bribe branches to halt enemies' attacks and recruit allies"
msgstr "你可以贿赂分支，让敌人停止攻击并招募盟友。"

msgctxt "d.god.power"
msgid "Qazlal grants you and your divine allies immunity to clouds."
msgstr "卡兹拉尔使你与你的神授盟友免疫云雾。"

msgctxt "d.god.power"
msgid "You are surrounded by a storm."
msgstr "风暴环绕着你。"

msgctxt "d.god.power"
msgid "call upon nature to destroy your foes"
msgstr "你可以呼唤自然之力摧毁敌人。"

msgctxt "d.god.power"
msgid "give life to nearby clouds"
msgstr "你可以赋予附近的云雾生命。"

msgctxt "d.god.power"
msgid "The storm surrounding you is powerful enough to repel missiles."
msgstr "环绕你的风暴足够强大，能够排斥投射物。"

msgctxt "d.god.power"
msgid "You adapt resistances upon receiving elemental damage."
msgstr "受到元素伤害时，你会适应性地获得抗性。"

msgctxt "d.god.power"
msgid "call upon nature's wrath in a wide area around you"
msgstr "你可以在周围广阔区域唤起自然之怒。"

msgctxt "d.god.power"
msgid "You now exude an aura of power that intimidates your foes."
msgstr "你散发出力量光环，威慑敌人。"

msgctxt "d.god.power"
msgid "Your aura of power can strike those that harm you."
msgstr "你的力量光环能够打击伤害你的生物。"

msgctxt "d.god.power"
msgid "heal your body and restore your magic"
msgstr "你可以治疗身体并恢复魔力。"

msgctxt "d.god.power"
msgid "gather your power into a mighty leap"
msgstr "你可以积聚力量，奋力跃出。"

msgctxt "d.god.power"
msgid "wreak a terrible wrath on your foes"
msgstr "你可以向敌人施以可怖的愤怒。"

msgctxt "d.god.power"
msgid "stomp with the beat"
msgstr "你可以随着节拍重踏。"

msgctxt "d.god.power"
msgid "pass through a line of other dancers"
msgstr "你可以穿过一整排其他舞者。"

msgctxt "d.god.power"
msgid "Uskayaw will force your foes to helplessly watch your dance."
msgstr "阿斯卡亚将迫使敌人无助地观看你的舞蹈。"

msgctxt "d.god.power"
msgid "Uskayaw will force your foes to share their pain."
msgstr "阿斯卡亚将迫使敌人分担彼此的痛苦。"

msgctxt "d.god.power"
msgid "merge with and destroy a victim"
msgstr "你可以与一个目标融为一体，并将其摧毁。"

msgctxt "d.god.power"
msgid "Your ancestor manifests to aid you."
msgstr "你的先祖显现并协助你。"

msgctxt "d.god.power"
msgid "recall your ancestor"
msgstr "你可以召回先祖。"

msgctxt "d.god.power"
msgid "remember your ancestor's identity"
msgstr "你可以忆起先祖的身份。"

msgctxt "d.god.power"
msgid "swap creatures with your ancestor"
