msgctxt "p.ui"
msgid "Magic washes over you without effect."
msgstr "魔法掠过你，却没有产生效果。"

msgctxt "p.ui"
msgid "Magic courses through your body."
msgstr "魔法流遍你的全身。"

msgctxt "p.ui"
msgid "You feel slightly irritated."
msgstr "你感觉有些烦躁。"

msgctxt "p.ui"
msgid "You're too dead to put down roots!"
msgstr "你已经死得太彻底，无法扎根了！"

