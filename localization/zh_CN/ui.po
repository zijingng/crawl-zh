msgctxt "log.beam"
msgid "You hear a grinding noise."
msgstr "你听到一阵研磨声。"

msgctxt "log.beam"
msgid "The damaged grate falls apart."
msgstr "受损的铁栅散架了。"

msgctxt "log.beam"
msgid "The mercury splashes!"
msgstr "水银飞溅！"

msgctxt "log.beam"
msgid "You have difficulty breathing."
msgstr "你感到呼吸困难。"

msgctxt "log.beam"
msgid "Your projectile teleports!"
msgstr "你的投射物传送了！"

msgctxt "log.beam"
msgid "The wave splashes down."
msgstr "波浪落下，水花四溅。"

msgctxt "log.beam"
msgid "You hear a splash."
msgstr "你听见一声水响。"

msgctxt "log.beam"
msgid "The mud splashes down."
msgstr "泥浆落下，四处飞溅。"

msgctxt "log.beam"
msgid "You hear a sizzling sound!"
msgstr "你听到一阵嘶嘶声！"

msgctxt "log.beam"
msgid "Strange energies course through your body."
msgstr "奇异的能量流经你的身体。"

msgctxt "log.beam"
msgid "Your will is overpowered!"
msgstr "你的意志被压制了！"

msgctxt "log.beam"
msgid "This spell isn't strong enough to banish yourself."
msgstr "这个法术的力量不足以放逐你自己。"

msgctxt "log.beam"
msgid "Pain shoots through your body!"
msgstr "剧痛贯穿你的全身！"

msgctxt "log.beam"
msgid "You convulse!"
msgstr "你抽搐起来！"

msgctxt "log.beam"
msgid "Your mind is blasted!"
msgstr "你的心灵遭到轰击！"

msgctxt "log.beam"
msgid "You feel a momentary urge to oink."
msgstr "你短暂地产生了学猪叫的冲动。"

msgctxt "log.beam"
msgid "Your teleport is interrupted."
msgstr "你的传送被打断了。"

msgctxt "log.beam"
msgid "You feel yourself grow more vulnerable to poison."
msgstr "你感觉自己变得更容易受到毒素伤害。"

msgctxt "log.beam"
msgid "You feel an ill-omen...."
msgstr "你感到一阵不祥的预兆……"

msgctxt "log.beam"
msgid "Your body is warped painfully!"
msgstr "你的身体被痛苦地扭曲！"

msgctxt "log.beam"
msgid "You feel your light-headedness will last longer."
msgstr "你感觉头晕还会持续更久。"

msgctxt "log.beam"
msgid "You feel light-headed."
msgstr "你感到头晕。"

msgctxt "log.beam"
msgid "You feel your inability to drink will last longer."
msgstr "你感觉禁饮状态还会持续更久。"

msgctxt "log.beam"
msgid "You feel unable to drink."
msgstr "你感到无法饮用药水。"

msgctxt "log.beam"
msgid "You feel your silence will last longer."
msgstr "你感觉沉默还会持续更久。"

msgctxt "log.beam"
msgid "An unnatural silence engulfs you."
msgstr "一片不自然的寂静笼罩了你。"

msgctxt "log.beam"
msgid "You feel your vulnerability to fire will last longer."
msgstr "你感觉对火焰的脆弱状态还会持续更久。"

msgctxt "log.beam"
msgid "Cherry-coloured flames burn away your fire resistance!"
msgstr "樱红色火焰烧去了你的火焰抗性！"

msgctxt "log.beam"
msgid "You are skewered in place!"
msgstr "你被刺穿，钉在了原地！"

msgctxt "log.beam"
msgid "You are encased in ice."
msgstr "你被封在冰中。"

msgctxt "log.beam"
msgid "A part of your body evaporates into steam!"
msgstr "你身体的一部分蒸发成了蒸汽！"

msgctxt "log.attack"
msgid "You feel devious."
msgstr "你感到诡计多端。"

msgctxt "log.attack"
msgid "Your autodazzler retaliates!"
msgstr "你的自动炫光器发动反击！"

msgctxt "log.mon-cast"
msgid "Mutagenic energy flows into you."
msgstr "致变能量流入你的体内。"

msgctxt "log.mon-cast"
msgid "You feel a dangerous fate closing in on you..."
msgstr "你感觉危险的命运正向你逼近……"

msgctxt "log.mon-cast"
msgid "You feel very mighty all of a sudden."
msgstr "你突然感到力量充沛。"

msgctxt "log.mon-cast"
msgid "Something gnaws heavily on your mind!"
msgstr "某种力量猛烈啃噬着你的心灵！"

msgctxt "log.mon-cast"
msgid "Something gnaws on your mind!"
msgstr "某种力量啃噬着你的心灵！"

msgctxt "log.mon-cast"
msgid "You feel your power leaking away."
msgstr "你感觉力量正在流失。"

msgctxt "log.mon-cast"
msgid "Stolen life floods into an unseen void!"
msgstr "被窃取的生命力涌入了看不见的虚空！"

msgctxt "log.mon-cast"
msgid "The doors slam shut!"
msgstr "门砰地关上了！"

msgctxt "log.mon-cast"
msgid "A door slams shut!"
msgstr "一扇门砰地关上了！"

msgctxt "log.mon-cast"
msgid "You are pushed out of the doorway!"
msgstr "你被推出了门口！"

msgctxt "log.mon-cast"
msgid "Vines fly forth from the trees!"
msgstr "藤蔓从树木中飞射而出！"

msgctxt "log.mon-cast"
msgid "Thorny briars emerge from the ground!"
msgstr "带刺的荆棘从地上冒了出来！"

msgctxt "log.mon-cast"
msgid "Zin's power protects your fellow warrior from evil magic!"
msgstr "辛的力量保护你的战友免受邪恶魔法侵害！"

msgctxt "log.mon-cast"
msgid "Send 'em back where they came from!"
msgstr "把它们送回原来的地方去！"

msgctxt "log.mon-cast"
msgid "An aura of fear fills the air!"
msgstr "恐惧的气息弥漫在空气中！"

msgctxt "log.mon-cast"
msgid "A freezing vortex appears out of thin air!"
msgstr "一道冰冻涡流凭空出现！"

msgctxt "log.mon-cast"
msgid "You are encased in ice."
msgstr "你被封在冰中。"

msgctxt "log.mon-cast"
msgid "The long-dead rise up around you."
msgstr "早已死去的亡者在你周围起身。"

msgctxt "log.mon-cast"
msgid "You feel haunted."
msgstr "你感到鬼魂缠身。"

msgctxt "log.mon-cast"
msgid "You sense an evil presence."
msgstr "你感知到一股邪恶的存在。"

msgctxt "log.mon-cast"
msgid "An electric hum fills the air."
msgstr "空气中充满电流的嗡鸣。"

msgctxt "log.mon-cast"
msgid "A wave of cold passes over you."
msgstr "一股寒流掠过你的身体。"

msgctxt "log.delay"
msgid "Your memorisation is interrupted."
msgstr "你的法术记忆被打断了。"

msgctxt "log.delay"
msgid "You stop dropping stuff."
msgstr "你停止丢弃物品。"

msgctxt "log.delay"
msgid "You stop ascending the stairs."
msgstr "你停止上楼。"

msgctxt "log.delay"
msgid "You stop descending the stairs."
msgstr "你停止下楼。"

msgctxt "log.delay"
msgid "Your meditation is interrupted."
msgstr "你的冥想被打断了。"

msgctxt "log.delay"
msgid "You stop digging."
msgstr "你停止挖掘。"

msgctxt "log.delay"
msgid "You stop transforming."
msgstr "你停止变形。"

msgctxt "log.delay"
msgid "You stop imbuing your servitor."
msgstr "你停止为仆从灌注魔力。"

msgctxt "log.delay"
msgid "Your concentration is interrupted."
msgstr "你的专注被打断了。"

msgctxt "log.delay"
msgid "Done waiting."
msgstr "等待结束。"

msgctxt "log.delay"
msgid "You start memorising the spell."
msgstr "你开始记忆这个法术。"

msgctxt "log.delay"
msgid "You begin to meditate on the wall."
msgstr "你开始对着墙壁冥想。"

msgctxt "log.delay"
msgid "You begin to dig a shaft."
msgstr "你开始挖掘竖井。"

msgctxt "log.delay"
msgid "You begin untransforming."
msgstr "你开始恢复原形。"

msgctxt "log.delay"
msgid "You begin transforming."
msgstr "你开始变形。"

msgctxt "log.delay"
msgid "You continue untransforming."
msgstr "你继续恢复原形。"

msgctxt "log.delay"
msgid "You continue transforming."
msgstr "你继续变形。"

msgctxt "log.delay"
msgid "You finish memorising."
msgstr "你完成了法术记忆。"

msgctxt "log.delay"
msgid "You finish merging with the rock."
msgstr "你完成了与岩石的融合。"

msgctxt "log.delay"
msgid "...yet there is something new on the other side. You quickly turn back."
msgstr "……但另一侧出现了新的东西。你迅速折返。"

msgctxt "log.delay"
msgid "...and sense your way blocked. You quickly turn back."
msgstr "……并感到去路被阻。你迅速折返。"

msgctxt "log.delay"
msgid "You finish imbuing your servitor."
msgstr "你完成了对仆从的魔力灌注。"

msgctxt "log.delay"
msgid "Reactivating autopickup."
msgstr "自动拾取已重新启用。"

msgctxt "log.delay"
msgid "You sense a monster nearby."
msgstr "你感知到附近有一只怪物。"

msgctxt "log.delay"
msgid "HP restored."
msgstr "生命值已恢复。"

msgctxt "log.delay"
msgid "Magic restored."
msgstr "魔力已恢复。"

msgctxt "log.delay"
msgid "Ancestor HP restored."
msgstr "先祖生命值已恢复。"

msgctxt "log.throw"
msgid "You have nothing you can fire or use right now."
msgstr "你现在没有可发射或使用的物品。"

msgctxt "log.spl-selfench"
msgid "You stand defiantly in death's doorway!"
msgstr "你无畏地立于死亡之门前！"

msgctxt "log.spl-selfench"
msgid "You seem to hear sand running through an hourglass..."
msgstr "你仿佛听见沙漏中流沙的声音……"

msgctxt "log.spl-selfench"
msgid "Your icy armour melts away."
msgstr "你的寒冰护甲融化了。"

msgctxt "log.spl-selfench"
msgid "Your icy armour thickens."
msgstr "你的寒冰护甲变厚了。"

msgctxt "log.spl-selfench"
msgid "A film of ice covers your body!"
msgstr "一层薄冰覆盖了你的身体！"

msgctxt "log.spl-selfench"
msgid "Your cloak of flame flares fiercely!"
msgstr "你的烈焰斗篷猛烈燃烧！"

msgctxt "log.spl-selfench"
msgid "A sizzling cloak of flame settles atop your icy armour."
msgstr "一件嘶嘶作响的烈焰斗篷覆在你的寒冰护甲上。"

msgctxt "log.spl-selfench"
msgid "A protective cloak of flame settles atop you."
msgstr "一件保护你的烈焰斗篷覆在你身上。"

msgctxt "log.spl-selfench"
msgid "Your body is healed in an amazingly painful way."
msgstr "你的身体以极其痛苦的方式被治愈了。"

msgctxt "log.spl-selfench"
msgid "Your life is in your own hands once again."
msgstr "你的生命再次掌握在自己手中。"

msgctxt "log.spl-selfench"
msgid "You release your grip on the fallen and begin the cycle anew!"
msgstr "你放开对亡者的掌控，开始新的循环！"

msgctxt "log.spl-selfench"
msgid "You call out to the remnants of the fallen!"
msgstr "你呼唤亡者的残存之物！"

msgctxt "log.spl-selfench"
msgid "The fallen lash out in pain!"
msgstr "亡者在痛苦中发动攻击！"

msgctxt "log.spl-selfench"
msgid "A profound silence engulfs you."
msgstr "深沉的寂静笼罩了你。"

msgctxt "log.spl-selfench"
msgid "The ground around you becomes liquefied!"
msgstr "你周围的地面液化了！"

msgctxt "log.spl-selfench"
msgid "There is nobody nearby that the sprites are interested in."
msgstr "附近没有精灵们感兴趣的目标。"

msgctxt "log.spl-selfench"
msgid "You ready an explosive catalyst."
msgstr "你准备好了一剂爆炸催化剂。"

msgctxt "log.spl-clouds"
msgid "There's already a cloud here!"
msgstr "这里已经有云雾了！"

msgctxt "log.spl-clouds"
msgid "A cloud of volatile blastmotes flares up around you! Run!"
msgstr "一团不稳定爆炸微粒在你周围燃起！快跑！"

msgctxt "log.spl-clouds"
msgid "Blessed fire suddenly surrounds you!"
msgstr "神圣火焰突然包围了你！"

msgctxt "log.spl-clouds"
msgid "The air fills with toxic fumes!"
msgstr "空气中充满有毒烟雾！"

msgctxt "log.spl-clouds"
msgid "There's no open space to fill with poison."
msgstr "没有可充满毒雾的空地。"

