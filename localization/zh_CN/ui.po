msgctxt "p.ui"
msgid "You are exhausted."
msgstr "你精疲力竭。"

msgctxt "p.ui"
msgid "Your blood congeals into armour."
msgstr "你的血液凝结成凝血护甲。"

msgctxt "p.ui"
msgid "Your weapon exudes an aura of protection."
msgstr "你的武器散发出保护光环。"

msgctxt "p.ui"
msgid "You feel bolstered by spreading misfortune."
msgstr "散播不幸让你感觉更加强大。"

msgctxt "p.ui"
msgid "You feel queasy."
msgstr "你感觉恶心。"

msgctxt "p.ui"
msgid "That felt strangely inert."
msgstr "你感觉它莫名地毫无效果。"

msgctxt "p.ui"
msgid "That seemed strangely inert."
msgstr "它似乎莫名地毫无效果。"

msgctxt "p.ui"
msgid "You feel much better."
msgstr "你感觉好多了。"

msgctxt "p.ui"
msgid "You feel magically purged."
msgstr "你感觉魔法得到了净化。"

msgctxt "p.ui"
msgid "You feel slightly less contaminated with magical energies."
msgstr "你感觉魔法能量造成的污染略微减轻了。"

msgctxt "p.ui"
msgid "You feel briefly invigorated."
msgstr "你短暂地感到振奋。"

msgctxt "p.ui"
msgid "You feel more experienced!"
msgstr "你感觉更有经验了！"

msgctxt "p.ui"
msgid "A flood of memories washes over you."
