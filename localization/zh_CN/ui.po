msgctxt "m.ui"
msgid "Are you sure you want to leave this trove?"
msgstr "确定要离开这个秘藏吗？"

msgctxt "m.ui"
msgid "Really leave the ziggurat figurine behind?"
msgstr "确定要留下神塔小雕像吗？"

msgctxt "m.ui"
msgid "Really leave the Orb behind?"
msgstr "确定要留下佐特宝珠吗？"

msgctxt "m.ui"
msgid "Alright, then stay!"
msgstr "那好，就留下吧！"

msgctxt "m.ui"
msgid "Really go through this one-way escape hatch?"
msgstr "确定要穿过这个单向逃生舱口吗？"

msgctxt "m.ui"
msgid "Really dive through this shaft in the floor?"
msgstr "确定要跳进地板上的这个竖井吗？"

msgctxt "m.ui"
msgid "You will be unable to climb back up again until you either destroy or join the power ruling this place. Continue?"
msgstr "除非摧毁或加入统治此地的势力，否则你将无法爬回去。继续吗？"

msgctxt "m.ui"
msgid "The transporter is blocked on the other side!"
msgstr "转移装置的另一端被堵住了！"

msgctxt "m.ui"
msgid "The transporter is blocked by a creature on the other side!"
msgstr "转移装置的另一端被一个生物堵住了！"

msgctxt "m.ui"
msgid "You enter the transporter and appear at another place."
msgstr "你进入转移装置，出现在了另一处。"

#, c-format
msgctxt "m.ui"
msgid "You are %d%% of the way to level %d."
msgstr "你已获得%d%%的升级经验，目标等级为%d级。"

#, c-format
msgctxt "m.ui"
msgid "I'm sorry, level %d is as high as you can go."
msgstr "抱歉，你最高只能升到第%d级。"

msgctxt "m.ui"
msgid "With the way you've been playing, I'm surprised you got this far."
msgstr "以你的玩法，能走到这里已经让我很惊讶了。"

#, c-format
msgctxt "m.ui"
msgid "You'll get an extra life in %d.%02d levels' worth of XP."
msgstr "再获得相当于%d.%02d级的经验，你就会得到一条额外生命。"

#, c-format
msgctxt "m.ui"
msgid "If you died right now, you'd get an extra life in %d.%02d levels' worth of XP."
msgstr "如果现在死去，你需要再获得相当于%d.%02d级的经验才能得到一条额外生命。"

msgctxt "m.ui"
msgid "Really rest while Zot is near?"
msgstr "佐特迫近，确定还要休息吗？"

msgctxt "m.ui"
msgid "You start waiting."
msgstr "你开始等待。"

msgctxt "m.ui"
msgid "You start resting."
msgstr "你开始休息。"

msgctxt "m.ui"
msgid "Move the cursor to view the level map, or type <w>?</w> for a list of commands."
msgstr "移动光标查看楼层地图，或按<w>?</w>查看命令列表。"

msgctxt "m.ui"
msgid "Returning to the game..."
msgstr "正在返回游戏……"

msgctxt "m.ui"
msgid "You should not fight recklessly!"
msgstr "你不该鲁莽地战斗！"

msgctxt "m.ui"
msgid "Nothing quivered!"
msgstr "没有准备任何投掷物！"

msgctxt "m.ui"
msgid "Char dump unsuccessful! Sorry about that."
msgstr "角色记录导出失败！"

msgctxt "m.ui"
msgid "Saving game... please wait."
msgstr "正在保存游戏……请稍候。"

msgctxt "m.ui"
msgid "Unknown command. (For a list of commands type <w>?\\?</w>.)"
msgstr "未知命令。（按<w>?\\?</w>查看命令列表。）"

msgctxt "m.ui"
msgid "Unknown command."
msgstr "未知命令。"

msgctxt "m.ui"
msgid "You have a vision of a gate."
msgstr "你看到了一个入口的幻象。"

msgctxt "m.ui"
msgid "You have a vision of multiple gates."
msgstr "你看到了多个入口的幻象。"

msgctxt "m.ui"
msgid "Your passage of Golubria closes with a snap!"
msgstr "你的格鲁布里亚通道啪地关闭了！"

msgctxt "m.ui"
msgid "You hear a snapping sound."
msgstr "你听到啪的一声。"

msgctxt "m.ui"
msgid "Outside, the world ends."
msgstr "外面的世界迎来了末日。"

msgctxt "m.ui"
msgid "Sorry, but your quest for the Orb is now rather pointless. You quit..."
msgstr "抱歉，现在你寻找佐特宝珠的任务已毫无意义。你退出了……"

msgctxt "m.ui"
msgid "You feel a strong urge to attack something."
msgstr "你强烈地想要攻击什么东西。"

msgctxt "m.ui"
msgid "You feel your anger nearly subside."
msgstr "你感到怒火即将消退。"

msgctxt "m.ui"
msgid "Your blood rage is quickly leaving you."
msgstr "你的嗜血狂怒正在迅速消退。"

msgctxt "m.ui"
msgid "You must enter the number of times for the command to repeat."
msgstr "你必须输入重复执行命令的次数。"

msgctxt "m.ui"
msgid "Enter command to be repeated: "
msgstr "输入要重复执行的命令："

msgctxt "m.ui"
msgid "Can't re-do previous command from within a macro."
msgstr "无法在宏中重新执行上一条命令。"

msgctxt "m.ui"
msgid "Clearing travel trail."
msgstr "正在清除移动轨迹。"

msgctxt "m.ui"
msgid "Clearing monster memory."
msgstr "正在清除怪物记忆。"

msgctxt "m.ui"
msgid "You feel aware of your surroundings."
msgstr "你感知到了周围的环境。"

msgctxt "m.ui"
msgid "Spicy!"
msgstr "真辣！"

msgctxt "m.ui"
msgid "--more--"
msgstr "--更多--"

msgctxt "m.ui"
msgid "Nothing appears to happen."
msgstr "似乎什么也没发生。"

msgctxt "m.ui"
msgid "You are unaffected."
msgstr "你未受影响。"

msgctxt "m.ui"
msgid "You resist."
msgstr "你抵抗了影响。"

msgctxt "m.ui"
msgid "You partially resist."
msgstr "你抵抗了部分影响。"

msgctxt "m.ui"
msgid "You are too berserk!"
msgstr "你过于狂暴！"

msgctxt "m.ui"
msgid "You are too confused!"
msgstr "你太混乱了！"

msgctxt "m.ui"
msgid "You can't do that in your present form."
msgstr "你目前的形态无法这么做。"

msgctxt "m.ui"
msgid "You aren't carrying anything."
msgstr "你没有携带任何物品。"

msgctxt "m.ui"
msgid "You can't do that yet."
msgstr "你暂时还不能这么做。"

msgctxt "m.ui"
msgid "Okay, then."
msgstr "那好吧。"

msgctxt "m.ui"
msgid "Why would you want to do that?"
msgstr "你为什么要这么做？"

msgctxt "m.ui"
msgid "There's nothing there!"
msgstr "那里什么也没有！"

msgctxt "m.ui"
msgid "There's nothing close enough!"
msgstr "没有足够近的目标！"

msgctxt "m.ui"
msgid "The spell fizzles."
msgstr "法术失效了。"

msgctxt "m.ui"
msgid "Huh?"
msgstr "嗯？"

msgctxt "m.ui"
msgid "You blink."
msgstr "你闪现了。"

msgctxt "m.ui"
msgid "You feel a strange sense of stasis."
msgstr "你感到一阵奇异的稳态。"

msgctxt "m.ui"
msgid "You don't know any spells."
msgstr "你还不会任何法术。"

msgctxt "m.ui"
msgid "You feel your magic capacity increase."
msgstr "你感到魔力容量增加了。"

msgctxt "m.ui"
msgid "You feel your magic capacity decrease."
msgstr "你感到魔力容量减少了。"

msgctxt "m.ui"
msgid "You feel momentarily disoriented."
msgstr "你短暂地迷失了方向。"

msgctxt "m.ui"
msgid "You detect nothing."
msgstr "你没有探测到任何东西。"

msgctxt "m.ui"
msgid "You cannot move."
msgstr "你无法移动。"

msgctxt "m.ui"
msgid "You see a ghostly outline there, and the spell fizzles."
msgstr "你看到那里有一道幽灵般的轮廓，法术失效了。"

msgctxt "m.ui"
msgid "Your health is already full."
msgstr "你的生命值已经全满。"

msgctxt "m.ui"
msgid "Your reserves of magic are already full."
msgstr "你的魔力已经充满了。"

msgctxt "m.ui"
msgid "You feel better."
msgstr "你感觉好些了。"

msgctxt "m.ui"
msgid "You feel your power returning."
msgstr "你感到力量正在恢复。"

msgctxt "m.ui"
msgid "You feel momentarily drained."
msgstr "你短暂地感到虚弱。"

msgctxt "m.ui"
msgid "You suddenly feel drained of magical energy!"
msgstr "你突然感到魔力被抽空了！"

msgctxt "m.ui"
msgid "There's something in the way."
msgstr "有什么东西挡住了去路。"

msgctxt "m.ui"
msgid "You can't see that place."
msgstr "你看不到那个地方。"

msgctxt "m.ui"
msgid "Your god isn't willing to do this for you now."
msgstr "你的神现在不愿为你这么做。"

msgctxt "m.ui"
msgid "There is no available space!"
msgstr "没有可用的空间！"

msgctxt "m.ui"
msgid "Your stasis prevents you from teleporting."
msgstr "你的稳态状态阻止了传送。"

msgctxt "m.ui"
msgid "You spin around."
msgstr "你转了个圈。"

#, c-format
msgctxt "log.monster"
msgid "%s is empowered by the presence of the orb!"
msgstr "%s因宝珠的存在而获得强化！"

#, c-format
msgctxt "log.monster"
msgid "%s cracks slightly."
msgstr "%s出现了细微的裂痕。"

#, c-format
msgctxt "log.monster"
msgid "%s shakes eagerly."
msgstr "%s急切地摇晃着。"

#, c-format
msgctxt "log.monster"
msgid "%s hatches with a roar like a landslide!"
msgstr "%s伴随着山崩般的轰鸣破壳而出！"

#, c-format
msgctxt "log.monster"
msgid "%s flows with the water."
msgstr "%s顺着水流移动。"

#, c-format
msgctxt "log.monster"
msgid "%s flows through the trees."
msgstr "%s穿行于树木之间。"

#, c-format
msgctxt "log.monster"
msgid "%s glows brighter."
msgstr "%s发出了更明亮的光。"

#, c-format
msgctxt "log.monster"
msgid "%s blazes with a fierce heat."
msgstr "%s燃起了炽烈的高温。"

msgctxt "m.ui"
msgid "You feel the power of Zot begin to gather its forces!"
msgstr "你感到佐特之力开始集结！"

#, c-format
msgctxt "log.monster"
msgid "%s is stunned by your conviction and fails to attack."
msgstr "%s被你的信念震慑，未能发起攻击。"

#, c-format
msgctxt "log.monster"
msgid "%s crumbles as it rolls away."
msgstr "%s一边滚动，一边碎裂。"

#, c-format
msgctxt "log.monster"
msgid "%s sinks back into the magma."
msgstr "%s沉回了岩浆中。"

#, c-format
msgctxt "log.monster"
msgid "%s's core grows cold and it stops moving."
msgstr "%s的核心逐渐冷却，停止了移动。"

#, c-format
msgctxt "log.monster"
msgid "%s's core flares to life once more."
msgstr "%s的核心再次燃起。"

#, c-format
msgctxt "log.monster"
msgid "%s flashes!"
msgstr "%s闪耀起来！"

#, c-format
msgctxt "log.monster"
msgid "%s violently releases its spores."
msgstr "%s猛烈地释放出孢子。"

#, c-format
msgctxt "log.monster"
msgid "%s is dazed by the spores."
msgstr "%s被孢子弄得晕头转向。"

#, c-format
msgctxt "log.monster"
msgid "%s zaps a wand."
msgstr "%s使用了一根魔杖。"

msgctxt "m.ui"
msgid "You hear a zap."
msgstr "你听到一声魔杖激发的声响。"

#, c-format
msgctxt "log.monster"
msgid "%s crackles loudly."
msgstr "%s发出响亮的噼啪声。"

msgctxt "m.ui"
msgid "You hear a loud crackle."
msgstr "你听到响亮的噼啪声。"

#, c-format
msgctxt "log.monster"
msgid "%s returns to your side."
msgstr "%s回到了你身边。"

#, c-format
msgctxt "log.monster"
msgid "%s is distracted by your dazzling golden aura."
msgstr "%s被你耀眼的金色光环分散了注意力。"

msgctxt "m.ui"
msgid "Something you can't see is thrashing in a web."
msgstr "某个你看不见的东西正在蛛网里猛烈挣扎。"

#, c-format
msgctxt "log.monster"
msgid "%s struggles to get unstuck from the web."
msgstr "%s挣扎着想摆脱蛛网。"

#, c-format
msgctxt "log.monster"
msgid "%s tears free of the web."
msgstr "%s挣脱了蛛网。"

msgctxt "m.ui"
msgid "Something wriggles in the net."
msgstr "某个东西在网里扭动。"

#, c-format
msgctxt "log.monster"
msgid "%s struggles against the net."
msgstr "%s在网中挣扎。"

msgctxt "m.ui"
msgid "All of a sudden the net rips apart!"
msgstr "网突然被撕裂了！"

#, c-format
msgctxt "log.monster"
msgid "%s splits in two!"
msgstr "%s分裂成了两个！"

msgctxt "m.ui"
msgid "You hear a squelching noise."
msgstr "你听到一声黏糊糊的响动。"

#, c-format
msgctxt "log.monster"
msgid "%s escapes!"
msgstr "%s逃脱了！"

#, c-format
msgctxt "log.monster"
msgid "%s struggles to escape constriction."
msgstr "%s挣扎着想摆脱缠绕。"

msgctxt "m.ui"
msgid "The door bursts into shrapnel!"
msgstr "门炸成了碎片！"

#, c-format
msgctxt "log.monster"
msgid "%s bursts through the door, destroying it!"
msgstr "%s撞穿了门，将它彻底毁坏！"

msgctxt "m.ui"
msgid "The door mysteriously vanishes."
msgstr "门神秘地消失了。"

#, c-format
msgctxt "log.monster"
msgid "%s eats the door!"
msgstr "%s吃掉了门！"

#, c-format
msgctxt "log.monster"
msgid "%s flops around on dry land!"
msgstr "%s在干燥的陆地上扑腾！"

#, c-format
msgctxt "log.monster"
msgid "%s passes through the gate."
msgstr "%s穿过了入口。"

msgctxt "m.ui"
msgid "The shaft crumbles and collapses."
msgstr "竖井碎裂坍塌了。"

msgctxt "m.ui"
msgid "Motes of dream dust float from an unseen source."
msgstr "梦尘从看不见的源头飘散出来。"

#, c-format
msgctxt "log.monster"
msgid "%s sings a water chant to call the tide!"
msgstr "%s吟唱水之咒文，召来潮汐！"

#, c-format
msgctxt "log.monster"
msgid "%s squirts a massive cloud of ink into the water!"
msgstr "%s向水中喷出了一大片墨云！"

msgctxt "m.ui"
msgid "Suddenly you stand beside yourself."
msgstr "突然，你站在了另一个自己身旁。"

msgctxt "m.ui"
msgid "There is a horrible, sudden wrenching feeling in your soul!"
msgstr "你的灵魂突然传来一阵可怕的撕扯感！"

msgctxt "m.ui"
msgid "You see a puff of smoke."
msgstr "你看到一团烟雾。"

#, c-format
msgctxt "log.monster"
msgid "%s is duplicated!"
msgstr "%s被复制了！"

msgctxt "m.ui"
msgid "You feel a bit more experienced."
msgstr "你觉得自己更有经验了些。"

msgctxt "m.ui"
msgid "You feel as though you may have cheated fate."
msgstr "你觉得自己或许欺骗了命运。"

msgctxt "m.ui"
msgid "You feel an ambush drawing close...."
msgstr "你感到一场伏击正在迫近……"

msgctxt "m.ui"
msgid "The necklace of Bloodlust glows a violent red."
msgstr "嗜血项链发出了狂暴的红光。"

msgctxt "m.ui"
msgid "You feel the ancient rage of your axe."
msgstr "你感到了斧头中远古的怒火。"

msgctxt "m.ui"
msgid "The wailing of the fallen reaches a fever pitch!"
msgstr "亡者的哀嚎达到了狂热的顶点！"

msgctxt "m.ui"
msgid "You feel your strength returning."
msgstr "你感到力量正在恢复。"

#, c-format
msgctxt "log.monster"
msgid "%s falls apart and the last of its fire goes out."
msgstr "%s四分五裂，最后的火焰也熄灭了。"

msgctxt "m.ui"
msgid "You feel your sun fade away."
msgstr "你感到你的太阳消逝了。"

msgctxt "m.ui"
msgid "Your magic returns to you!"
msgstr "你的魔力回到了你身上！"

msgctxt "m.ui"
msgid "You feel something broadcast a psychic alarm."
msgstr "你感到某个东西发出了心灵警报。"

msgctxt "m.ui"
msgid "That felt strangely unrewarding."
msgstr "这种感觉出奇地没有收获。"

msgctxt "m.ui"
msgid "A wave of disorienting energy ripples outward as you feel the reach of Zot diminish."
msgstr "一波令人晕眩的能量向外扩散，你感到佐特的影响减弱了。"

msgctxt "m.ui"
msgid "The kraken's tentacles disappear."
msgstr "海妖的触手消失了。"

msgctxt "m.ui"
msgid "The starspawn's tentacles wither and die."
msgstr "星之眷族的触手枯萎死去了。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer in a wild frenzy."
msgstr "%s不再陷入狂乱。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer berserk."
msgstr "%s不再狂暴。"

#, c-format
msgctxt "log.monster"
msgid "%s looks more energetic."
msgstr "%s看起来更有活力了。"

#, c-format
msgctxt "log.monster"
msgid "%s's excess health fades away."
msgstr "%s额外的生命值消退了。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer moving quickly."
msgstr "%s不再快速行动。"

#, c-format
msgctxt "log.monster"
msgid "%s slows down."
msgstr "%s慢了下来。"

#, c-format
msgctxt "log.monster"
msgid "%s becomes audible again."
msgstr "%s的声音再次变得可以听见。"

#, c-format
msgctxt "log.monster"
msgid "%s no longer looks unusually strong."
msgstr "%s看起来不再异常强壮。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer moving slowly."
msgstr "%s不再缓慢行动。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer overcome with frustration."
msgstr "%s不再被挫败感淹没。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer paralysed."
msgstr "%s不再麻痹。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer petrified."
msgstr "%s不再石化。"

#, c-format
msgctxt "log.monster"
msgid "%s seems less confused."
msgstr "%s似乎不那么混乱了。"

#, c-format
msgctxt "log.monster"
msgid "%s stops glowing."
msgstr "%s不再发光。"

#, c-format
msgctxt "log.monster"
msgid "%s stops burning."
msgstr "%s身上的火熄灭了。"

#, c-format
msgctxt "log.monster"
msgid "%s looks more healthy."
msgstr "%s看起来更健康了。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer liquefying the ground."
msgstr "%s不再使地面液化。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer dazed."
msgstr "%s不再晕眩。"

#, c-format
msgctxt "log.monster"
msgid "%s's inner flame fades away."
msgstr "%s体内的心火消退了。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer mute."
msgstr "%s不再失语。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer blind."
msgstr "%s不再失明。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer stupefied."
msgstr "%s不再神志不清。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer mad."
msgstr "%s不再发疯。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer regenerating."
msgstr "%s不再再生。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer strong-willed."
msgstr "%s不再意志坚定。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer weakened."
msgstr "%s不再虚弱。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer more vulnerable to fire."
msgstr "%s不再更易受到火焰伤害。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer more vulnerable to poison."
msgstr "%s不再更易中毒。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer unusually agile."
msgstr "%s不再异常敏捷。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer encased in ice."
msgstr "%s不再被冰封。"

#, c-format
msgctxt "log.monster"
msgid "%s's sign of ruin fades away."
msgstr "%s的毁灭征兆消退了。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer being sapped."
msgstr "%s不再被汲取力量。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer corroded."
msgstr "%s不再受到腐蚀。"

#, c-format
msgctxt "log.monster"
msgid "%s seems less drained."
msgstr "%s似乎不那么虚弱了。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer deflecting missiles."
msgstr "%s不再偏斥投射物。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer unusually resistant."
msgstr "%s不再拥有异常的抗性。"

#, c-format
msgctxt "log.monster"
msgid "%s seems less brilliant."
msgstr "%s似乎不那么聪慧了。"

#, c-format
msgctxt "log.monster"
msgid "%s loses the glow of perfection."
msgstr "%s失去了完美的光辉。"

#, c-format
msgctxt "log.monster"
msgid "%s is no longer infested."
msgstr "%s不再遭到寄生。"

#, c-format
msgctxt "log.monster"
msgid "%s stops rolling and uncurls."
msgstr "%s停止翻滚，展开了身体。"

#, c-format
msgctxt "log.monster"
msgid "%s no longer looks unusually toxic."
msgstr "%s看起来不再异常剧毒。"

#, c-format
