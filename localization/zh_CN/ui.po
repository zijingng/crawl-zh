msgctxt "d.cards"
msgid "You radiate a wave of entropy!"
msgstr "你释放出一股熵能波！"

msgctxt "d.cards"
msgid "You reveal a symbol of torment!"
msgstr "你展示出折磨符印！"

msgctxt "d.cards"
msgid "Really abort (and waste the card)?"
msgstr "确定要取消并浪费这张牌吗？"

msgctxt "d.cards"
msgid "You begin rapidly regenerating health and magic."
msgstr "你的生命与魔力开始迅速恢复。"

msgctxt "d.cards"
msgid "You somehow manage to escape divine attention..."
msgstr "你竟然设法逃过了神祇的注意……"

msgctxt "d.cards"
msgid "You see a puff of smoke."
msgstr "你看到一团烟雾。"

msgctxt "d.cards"
msgid "You sense the presence of something unfriendly."
msgstr "你感觉到某种敌意的存在。"

msgctxt "d.cards"
msgid "Clouds appear around your foes!"
msgstr "云雾出现在你的敌人周围！"

msgctxt "d.cards"
msgid "You hear a clap of thunder!"
msgstr "你听到一声雷鸣！"

msgctxt "d.cards"
msgid "You feel a surge of magic."
msgstr "你感到魔力涌动。"

msgctxt "d.cards"
msgid "You feel a momentary urge to oink."
msgstr "你一瞬间很想发出猪叫声。"

msgctxt "d.delay"
msgid "Keep equipping yourself?"
msgstr "继续穿戴装备吗？"

msgctxt "d.delay"
msgid "Keep transforming yourself?"
msgstr "继续变形吗？"

msgctxt "d.delay"
msgid "Keep imbuing your servitor?"
msgstr "继续灌注你的仆从吗？"

#, c-format
msgctxt "d.delay"
msgid "Deactivating autopickup; reactivate with <w>%s</w>."
msgstr "已关闭自动拾取；按 <w>%s</w> 重新开启。"

msgctxt "d.overview"
msgid "                    <white>Dungeon Overview and Level Annotations</white>\n"
msgstr "                    <white>地下城概览与楼层注释</white>\n"

msgctxt "d.overview"
msgid "\n<green>Branches:</green>"
msgstr "\n<green>分支：</green>"

msgctxt "d.overview"
msgid " (press <white>G</white> to reach them and <white>?/b</white> for more information)"
msgstr "（按 <white>G</white> 前往，按 <white>?/b</white> 查看更多信息）"

#, c-format
msgctxt "d.overview"
msgid "<yellow>%*s</yellow> <darkgrey>(visited)</darkgrey>"
msgstr "<yellow>%*s</yellow> <darkgrey>（已到访）</darkgrey>"

msgctxt "d.overview"
msgid "\n<green>Altars:</green>"
msgstr "\n<green>祭坛：</green>"

msgctxt "d.overview"
msgid " (press <white>_</white> to reach them and <white>?/g</white> for information about gods)"
msgstr "（按 <white>_</white> 前往，按 <white>?/g</white> 查看神祇信息）"

msgctxt "d.overview"
msgid "\n<green>Shops:</green>"
msgstr "\n<green>商店：</green>"

msgctxt "d.overview"
msgid " (press <white>$</white> to reach them - yellow denotes antique shop)"
msgstr "（按 <white>$</white> 前往；黄色表示古董商店）"

msgctxt "d.overview"
msgid "\n<green>Portals:</green>\n"
msgstr "\n<green>传送门：</green>\n"

msgctxt "d.overview"
msgid "\n<green>Annotations:</green> (press <white>!</white> to add a new annotation)\n"
msgstr "\n<green>注释：</green>（按 <white>!</white> 添加注释）\n"

msgctxt "d.overview"
msgid "\n<green>Annotations:</green>\n"
msgstr "\n<green>注释：</green>\n"

msgctxt "d.overview"
msgid "Sorry, you haven't seen any altar yet."
msgstr "你还没有见过任何祭坛。"

msgctxt "d.overview"
msgid "Sorry, you haven't seen any shop yet."
msgstr "你还没有见过任何商店。"

msgctxt "d.overview"
msgid "There is no level above you."
msgstr "你的上方没有楼层。"

msgctxt "d.overview"
msgid "There is no level below you in this branch."
msgstr "此分支中你的下方没有楼层。"

msgctxt "d.overview"
msgid "That's not a valid depth."
msgstr "楼层深度无效。"

#, c-format
msgctxt "d.overview"
msgid "Current level annotation: <lightgrey>%s</lightgrey>"
msgstr "当前楼层注释：<lightgrey>%s</lightgrey>"

msgctxt "d.overview"
msgid "Cleared annotation."
msgstr "已清除注释。"

#, c-format
msgctxt "d.property"
msgid "It affects your AC (%d)."
msgstr "它影响你的护甲值（%d）。"

#, c-format
msgctxt "d.property"
msgid "It affects your evasion (%d)."
msgstr "它影响你的闪避值（%d）。"

#, c-format
msgctxt "d.property"
msgid "It affects your strength (%d)."
msgstr "它影响你的力量（%d）。"

#, c-format
msgctxt "d.property"
msgid "It affects your intelligence (%d)."
msgstr "它影响你的智力（%d）。"

#, c-format
msgctxt "d.property"
msgid "It affects your dexterity (%d)."
msgstr "它影响你的敏捷（%d）。"

#, c-format
msgctxt "d.property"
msgid "It affects your accuracy & damage with ranged weapons and melee (%d)."
msgstr "它影响你的远程武器与近战攻击的命中率和伤害（%d）。"

msgctxt "d.property"
msgid "It insulates you from electricity."
msgstr "它使你抵抗电击。"

msgctxt "d.property"
msgid "It protects you from poison."
msgstr "它使你抵抗毒素。"

#, c-format
msgctxt "d.property"
msgid "It affects your health (%d)."
msgstr "它影响你的生命上限（%d）。"

#, c-format
msgctxt "d.property"
msgid "It affects your magic capacity (%d)."
msgstr "它影响你的魔力上限（%d）。"

msgctxt "d.property"
msgid "It lets you see invisible."
msgstr "它使你能够看见隐形事物。"

msgctxt "d.property"
msgid "It lets you turn invisible."
msgstr "它使你能够隐形。"

msgctxt "d.property"
msgid "It grants you flight."
msgstr "它使你能够飞行。"

msgctxt "d.property"
msgid "It lets you blink."
msgstr "它使你能够闪现。"

msgctxt "d.property"
msgid "It may make a loud noise when swung."
msgstr "挥动它时可能发出巨响。"

msgctxt "d.property"
msgid "It prevents spellcasting."
msgstr "它使你无法施法。"

msgctxt "d.property"
msgid "It prevents most forms of teleportation."
msgstr "它阻止大多数形式的传送。"

#, no-c-format
msgctxt "d.property"
msgid "It berserks you when you make melee attacks (%d% chance)."
msgstr "近战攻击时它可能使你狂暴（概率为 %d%）。"

msgctxt "d.property"
msgid "It protects you from confusion, rage, mesmerisation and fear."
msgstr "它保护你免受混乱、狂暴、魅惑与恐惧。"

msgctxt "d.property"
msgid "It causes magical contamination when unequipped."
msgstr "卸下它会造成魔法污染。"

msgctxt "d.property"
msgid "It protects you from missiles."
msgstr "它保护你免受投射物攻击。"

msgctxt "d.property"
msgid "It increases your rate of health regeneration."
msgstr "它提高你的生命恢复速度。"

msgctxt "d.property"
msgid "It protects you from acid and corrosion."
msgstr "它使你抵抗酸液与腐蚀。"

msgctxt "d.property"
msgid "It protects you from mutation."
msgstr "它保护你免受变异。"

msgctxt "d.property"
msgid "It may corrode you when you take damage."
msgstr "受伤时它可能使你遭受腐蚀。"

msgctxt "d.property"
msgid "It drains your maximum health when unequipped."
msgstr "卸下它会汲取你的生命上限。"

msgctxt "d.property"
msgid "It may slow you when you take damage."
msgstr "受伤时它可能使你减速。"

msgctxt "d.property"
msgid "It will be destroyed if unequipped."
msgstr "卸下它会使其毁坏。"

#, c-format
msgctxt "d.property"
msgid "It affects your SH (%d)."
msgstr "它影响你的格挡值（%d）。"

msgctxt "d.property"
msgid "It increases damage dealt and taken."
msgstr "它提高你造成和承受的伤害。"

msgctxt "d.property"
msgid "It causes one to take an extra step when moving towards enemies, briefly stunning them if this results in an attack."
msgstr "朝敌人移动时它使你额外前进一步；若因此发起攻击，则会使敌人短暂眩晕。"

msgctxt "d.property"
msgid "It increases the power of your magical spells."
msgstr "它提高你的法术威力。"

msgctxt "d.property"
msgid "It increases your evasion after moving or waiting."
msgstr "移动或等待后，它提高你的闪避值。"

msgctxt "d.property"
msgid "It increases your rate of magic regeneration."
msgstr "它提高你的魔力恢复速度。"

msgctxt "d.property"
msgid "It increases the success rate of your magical spells."
msgstr "它提高你的施法成功率。"

msgctxt "d.property"
msgid "It may silence you when you take damage."
msgstr "受伤时它可能使你陷入沉默。"

msgctxt "d.property"
msgid "It inflicts you with a random bane when you equip it."
msgstr "装备它会使你受到一种随机灾厄。"

msgctxt "d.property"
msgid "It increases the power of your Conjurations spells."
msgstr "它提高你的塑能系魔法的威力。"

msgctxt "d.property"
msgid "It increases the power of your Hexes spells."
msgstr "它提高你的妖系法术威力。"

msgctxt "d.property"
msgid "It increases the power of your Summonings spells."
msgstr "它提高你的召唤系魔法的威力。"

msgctxt "d.property"
msgid "It increases the power of your Necromancy spells."
msgstr "它提高你的死灵系魔法的威力。"

msgctxt "d.property"
msgid "It increases the power of your Translocations spells."
msgstr "它提高你的位移系魔法的威力。"

msgctxt "d.property"
msgid "It increases the power of your Fire spells."
msgstr "它提高你的火系法术威力。"

msgctxt "d.property"
msgid "It increases the power of your Ice spells."
msgstr "它提高你的冰系法术威力。"

msgctxt "d.property"
msgid "It increases the power of your Air spells."
msgstr "它提高你的气系法术威力。"

msgctxt "d.property"
msgid "It increases the power of your Earth spells."
msgstr "它提高你的土系法术威力。"

msgctxt "d.property"
msgid "It increases the power of your Alchemy spells."
msgstr "它提高你的炼金术法术威力。"

msgctxt "d.property"
msgid "It increases the power of your Forgecraft spells."
msgstr "它提高你的锻造术法术威力。"

msgctxt "d.describe"
msgid "It sustains your strength, intelligence and dexterity."
msgstr "它维持你的力量、智力与敏捷。"

msgctxt "d.describe"
msgid "It may teleport you next to monsters."
msgstr "它可能将你传送至怪物身旁。"

msgctxt "d.describe"
msgid "It can be evoked for teleport control."
msgstr "可以发动它以控制传送。"

msgctxt "d.describe"
msgid "It allows you to eat raw meat even when not hungry."
msgstr "它使你即使不饿也能吃下生肉。"

msgctxt "d.describe"
msgid "It protects your inventory from destruction."
msgstr "它保护你的物品栏免遭毁坏。"

msgctxt "d.describe"
msgid "It allows you to control your flight when levitating."
msgstr "它使你在悬浮时能够控制飞行。"

msgctxt "d.describe"
msgid "It reduces the accuracy of all your attacks."
msgstr "它降低你所有攻击的命中率。"

msgctxt "d.describe"
msgid "It causes incoming damage to be divided between your reserves of health and magic."
msgstr "它使你承受的伤害由生命与魔力共同承担。"

msgctxt "d.describe"
msgid "It allows you to gain divine favour quickly."
msgstr "它使你更快获得神祇的青睐。"

msgctxt "d.describe"
msgid "It reflects blocked missile attacks."
msgstr "它会反射被格挡的投射物攻击。"

msgctxt "d.describe"
msgid "It improves your skill with shapeshifting (+5)."
msgstr "它提高你的变形术技能（+5）。"

msgctxt "d.describe"
msgid "It restores some MP whenever you drink a potion and also enhances your alchemy spells."
msgstr "每当你饮用药水时，它会恢复一些魔力，并增强你的炼金术法术。"

msgctxt "d.describe"
msgid "It reduces the duration of hostile enchantments and decays magical contamination more quickly."
msgstr "它缩短敌对附魔的持续时间，并加快魔法污染的消退。"

msgctxt "d.describe"
msgid "\nYou are unable to wield it."
msgstr "\n你无法挥舞它。"

msgctxt "d.describe"
msgid "\nIt is too large for you to wield."
msgstr "\n它太大了，你无法挥舞。"

#, c-format
msgctxt "d.describe"
msgid "The beam does %dd%d damage."
msgstr "射线造成 %dd%d 点伤害。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt can be maximally enchanted to +%d."
msgstr "\n\n它最多可以附魔至 +%d。"

msgctxt "d.describe"
msgid "\n\nIt cannot be enchanted further."
msgstr "\n\n它无法继续附魔。"

msgctxt "d.describe"
msgid "\n\nIt is always destroyed on impact."
msgstr "\n\n它命中后必定损毁。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt has a 1/%d chance to be destroyed on impact."
msgstr "\n\n它命中后有 1/%d 的概率损毁。"

#, c-format
msgctxt "d.describe"
msgid "If you quaff this potion your AC would be %d."
msgstr "饮用此药水后，你的护甲值将为 %d。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your shielding (%+d)."
msgstr "\n\n它影响你的格挡值（%+d）。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your AC (%+d)."
msgstr "\n\n它影响你的护甲值（%+d）。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your evasion (%+d)."
msgstr "\n\n它影响你的闪避值（%+d）。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your strength (%+d)."
msgstr "\n\n它影响你的力量（%+d）。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your intelligence (%+d)."
msgstr "\n\n它影响你的智力（%+d）。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your dexterity (%+d)."
msgstr "\n\n它影响你的敏捷（%+d）。"

#, c-format
msgctxt "d.describe"
msgid "\n\nIt affects your accuracy and damage with ranged weapons and melee (%+d)."
msgstr "\n\n它影响你的远程武器与近战攻击的命中率和伤害（%+d）。"

msgctxt "d.describe"
msgid "\nIt has a curse placed upon it."
msgstr "\n它受到了诅咒。"

msgctxt "d.describe"
msgid "Your spells cost less MP as you Rev up. Whenever you cast a spell, you make a melee attack against a random enemy in range."
msgstr "随着转速提高，你的施法魔力消耗降低。每当你施法时，你会对攻击范围内的随机敌人发动一次近战攻击。"

#, no-c-format
msgctxt "d.describe"
msgid "Your evocable items recharge 30% faster and wands have a 30% chance to not spend a charge."
msgstr "你的可发动道具充能速度提高 30%，魔杖有 30% 的概率不消耗充能。"

msgctxt "d.describe"
msgid "Your AC increases as you Rev (up to +5) and while fully Revved, your attacks may disarm enemies."
msgstr "随着转速提高，你的护甲值上升（最多 +5）；达到最高转速时，你的攻击可能缴械敌人。"

msgctxt "d.describe"
msgid "It sometimes fires a blinding ray at enemies whose attacks you dodge."
msgstr "当你闪避敌人的攻击时，它有时会向该敌人发射致盲射线。"

msgctxt "d.describe"
msgid "It is an ancient artefact."
msgstr "它是一件远古神器。"

msgctxt "d.describe"
msgid "It is a fabulous contraption, custom-made by your own hands."
msgstr "它是你亲手打造的奇妙装置。"

msgctxt "d.describe"
msgid "This item has been removed.\n"
msgstr "此物品已被移除。\n"

msgctxt "d.describe"
msgid "However, it recharges as you gain experience."
msgstr "不过，它会随着你获取经验值而恢复充能。"

msgctxt "d.describe"
msgid "\nIt is an ancient artefact."
msgstr "\n它是一件远古神器。"

msgctxt "d.describe"
msgid "\nEnchanting this artefact any further is beyond even your skills."
msgstr "\n即使以你的技艺，也无法再为这件神器附魔。"

msgctxt "d.describe"
msgid "\nThis ancient artefact cannot be changed by magic or mundane means."
msgstr "\n这件远古神器无法通过魔法或寻常手段改变。"

msgctxt "d.describe"
msgid "Awoken."
msgstr "已苏醒。"

msgctxt "d.describe"
msgid "A covering of ice."
msgstr "冰层覆盖。"

msgctxt "d.describe"
msgid "A halo."
msgstr "光环。"

msgctxt "d.describe"
msgid "An umbra."
msgstr "暗影光环。"

msgctxt "d.describe"
msgid "Liquefied ground."
msgstr "液化的地面。"

msgctxt "d.describe"
msgid "Translocational energy."
msgstr "位移能量。"

#, c-format
msgctxt "d.describe"
msgid "\nWhile standing here, you can exit the dungeon with the <w>%s</w> key."
msgstr "\n站在这里时，你可以按 <w>%s</w> 离开地下城。"

msgctxt "d.describe"
msgid " You have not yet explored it and cannot tell where it leads."
msgstr "你尚未探索过它，无法得知它通往何处。"

#, c-format
msgctxt "d.describe"
msgid " You can view the location it leads to by examining it with <w>%s</w> and pressing <w>%s</w>."
msgstr "你可以按 <w>%s</w> 查看它，再按 <w>%s</w> 查看目的地。"

#, c-format
msgctxt "d.describe"
msgid "\nPray here with <w>%s</w> to learn more.\n"
msgstr "\n在此按 <w>%s</w> 祈祷以了解更多。\n"

msgctxt "d.describe"
msgid " However, this will not work until the sealing runes wear off."
msgstr "不过，在封印符文消退之前无法这样做。"

msgctxt "d.describe"
msgid "\nIt can be dug through."
msgstr "\n可以挖穿它。"

msgctxt "d.describe"
msgid "\nA suitable weapon or spell can reach past it."
msgstr "\n合适的武器或法术可以越过它。"

msgctxt "d.describe"
msgid "\nSome spells can be cast through it."
msgstr "\n某些法术可以穿过它。"

msgctxt "d.describe"
msgid "\nYou are here."
msgstr "\n你在这里。"

msgctxt "d.describe"
msgid "Replace inscription with what? "
msgstr "要将铭文替换为什么？"

msgctxt "d.describe"
msgid "Inscribe with what? "
msgstr "要添加什么铭文？"

msgctxt "d.describe"
msgid "Your servitor can be imbued with this spell.\n"
msgstr "可以向你的仆从传授此法术。\n"

msgctxt "d.describe"
msgid "Your servitor could be imbued with this spell if your spell success rate were higher.\n"
msgstr "若你的施法成功率更高，就能向你的仆从传授此法术。\n"

msgctxt "d.describe"
msgid "This inflicts up to 40% magical contamination when cast by you.\n"
msgstr "由你施放时，此法术最多造成 40% 的魔法污染。\n"

msgctxt "d.describe"
msgid "This spell is empowered while you are enkindled.\n"
msgstr "当你被点燃时，此法术会得到强化。\n"

msgctxt "d.describe"
msgid "\nYou currently have no enchantments that could be removed by this.\n"
msgstr "\n你目前没有会被此法术移除的附魔。\n"

msgctxt "d.describe"
msgid "\n\n<magenta>When cast via Aphotic Marionette, this spell will affect the player instead."
msgstr "\n\n<magenta>通过无光提线偶施放时，此法术将改为影响玩家。"

msgctxt "d.describe"
msgid "Sparks flare out of its mouth and nostrils."
msgstr "火花从它的口鼻中喷出。"

msgctxt "d.describe"
msgid "Acidic fumes swirl around it."
msgstr "酸性烟雾在它周围盘旋。"

msgctxt "d.describe"
msgid "Venom drips from its jaws and stinger tail."
msgstr "毒液从它的口中与尾刺上滴落。"

msgctxt "d.describe"
msgid "Its outline shimmers with magical energy."
msgstr "它的轮廓闪烁着魔法能量。"

msgctxt "d.describe"
msgid "Smoke pours from its nostrils."
msgstr "烟雾从它的鼻孔中涌出。"

msgctxt "d.describe"
msgid "Frost pours from its nostrils."
msgstr "寒霜从它的鼻孔中涌出。"

msgctxt "d.describe"
msgid "Its scales and tail are adapted to the water."
msgstr "它的鳞片与尾巴适于水中生活。"

msgctxt "d.describe"
msgid "It is cloaked in a pall of superheated steam."
msgstr "它笼罩在一团炽热蒸汽中。"

msgctxt "d.describe"
msgid "It will release varied jellies when damaged or killed, with the number of jellies proportional to the amount of damage.\n"
msgstr "它受伤或死亡时会释放各种软泥怪，数量与受到的伤害成正比。\n"

msgctxt "d.describe"
msgid "It will release all of its jellies when polymorphed.\n"
msgstr "它变形时会释放出所有软泥怪。\n"

msgctxt "d.describe"
msgid "It looks just like you...spooky!\n"
msgstr "它看起来和你一模一样……真诡异！\n"

msgctxt "d.describe"
msgid "\nIt is quickly melting away.\n"
msgstr "\n它正在迅速融化。\n"

msgctxt "d.describe"
msgid "\nIt is quickly crumbling away.\n"
msgstr "\n它正在迅速崩解。\n"

msgctxt "d.describe"
msgid "\nIt is quickly withering away.\n"
msgstr "\n它正在迅速枯萎。\n"

msgctxt "d.describe"
msgid "\nIf struck, it will crumble away soon after.\n"
msgstr "\n它被击中后，很快就会崩解。\n"

msgctxt "d.describe"
msgid "\nIf struck, it will die soon after.\n"
msgstr "\n它被击中后，很快就会死亡。\n"

msgctxt "d.describe"
msgid "\nKilling this monster yields no experience or items."
msgstr "\n杀死此怪物不会获得经验值或物品。"

msgctxt "d.duration"
msgid "You feel more conspicuous."
msgstr "你感到自己更显眼了。"

msgctxt "d.duration"
msgid "You flicker back into view."
msgstr "你的身影闪烁着重新显现。"

msgctxt "d.duration"
msgid "The sprites lose interest in your situation."
msgstr "精灵们对你的处境失去了兴趣。"

msgctxt "d.duration"
msgid "You lose your grip on the chains of life and death."
msgstr "你失去了对生死锁链的掌控。"

msgctxt "d.duration"
msgid "You are agile."
msgstr "你身手敏捷。"

msgctxt "d.duration"
msgid "You feel a little less agile now."
msgstr "你感到不再那么敏捷了。"

msgctxt "d.duration"
msgid "You are possessed by a berserker rage."
msgstr "你正陷入狂暴之怒。"

msgctxt "d.duration"
msgid "You are no longer berserk."
msgstr "你不再狂暴。"

msgctxt "d.duration"
msgid "You are unable to berserk."
msgstr "你无法进入狂暴。"

msgctxt "d.duration"
msgid "You are short of breath."
msgstr "你气喘吁吁。"

msgctxt "d.duration"
msgid "You have got your breath back."
msgstr "你缓过气来了。"

msgctxt "d.duration"
msgid "You are brilliant."
msgstr "你才思敏捷。"

msgctxt "d.duration"
msgid "You feel a little less clever now."
msgstr "你感到头脑不再那么灵敏了。"

msgctxt "d.duration"
msgid "Your spell have diminished power."
msgstr "你的法术威力被削弱了。"

msgctxt "d.duration"
msgid "Your spells return to their normal power."
msgstr "你的法术恢复了正常威力。"

msgctxt "d.duration"
msgid "You are confused."
msgstr "你陷入了混乱。"

msgctxt "d.duration"
msgid "You feel less confused."
msgstr "你的混乱减轻了。"

msgctxt "d.duration"
msgid "You are no longer glowing."
msgstr "你不再发光。"

msgctxt "d.duration"
msgid "You are channelling the dead."
msgstr "你正在引导亡者。"

msgctxt "d.duration"
msgid "Your unholy channel expires."
msgstr "你的邪恶引导结束了。"

msgctxt "d.duration"
msgid "Your unholy channel is weakening."
msgstr "你的邪恶引导正在减弱。"

msgctxt "d.duration"
msgid "You are divinely vitalised."
msgstr "神力赋予你活力。"

msgctxt "d.duration"
msgid "You are imbued with divine vigour."
msgstr "神圣活力充盈着你。"

msgctxt "d.duration"
msgid "You are exhausted."
msgstr "你精疲力竭。"

msgctxt "d.duration"
msgid "You feel less exhausted."
msgstr "你的疲惫减轻了。"

msgctxt "d.duration"
msgid "You are protected by a layer of icy armour."
msgstr "一层寒冰护甲保护着你。"

msgctxt "d.duration"
msgid "You are armoured with a cloak of flame."
msgstr "烈焰披风保护着你。"

msgctxt "d.duration"
msgid "Your fiery armour burns out."
msgstr "你的烈焰护甲燃尽了。"

msgctxt "d.duration"
msgid "You are covered in liquid fire."
msgstr "液态火焰覆盖着你。"

msgctxt "d.duration"
msgid "You are weak-willed."
msgstr "你的意志薄弱。"

msgctxt "d.duration"
msgid "You feel your willpower return."
msgstr "你感到意志力恢复了。"

msgctxt "d.duration"
msgid "You are mighty."
msgstr "你力大无穷。"

msgctxt "d.duration"
msgid "You feel a little less mighty now."
msgstr "你感到力量不再那么强大了。"

msgctxt "d.duration"
msgid "You are paralysed."
msgstr "你被麻痹了。"

msgctxt "d.duration"
msgid "You are petrified."
msgstr "你被石化了。"

msgctxt "d.duration"
msgid "You are vexed."
msgstr "你受到恼咒影响。"

msgctxt "d.duration"
msgid "You feel more in control of yourself again."
msgstr "你再次感到能够掌控自己。"

msgctxt "d.duration"
msgid "You are turning to stone."
msgstr "你正在变成石头。"

msgctxt "d.duration"
msgid "You are fragile as glass."
msgstr "你如玻璃般脆弱。"

msgctxt "d.duration"
msgid "You feel less fragile."
msgstr "你不再那么脆弱了。"

msgctxt "d.duration"
msgid "You are resistant to the elements."
msgstr "你能够抵抗元素伤害。"

msgctxt "d.duration"
msgid "Your resistance to elements expires."
msgstr "你的元素抗性消失了。"

msgctxt "d.duration"
msgid "You start to feel less resistant."
msgstr "你开始感到抗性减弱了。"

msgctxt "d.duration"
msgid "You feel less slimy."
msgstr "你不再那么黏滑了。"

msgctxt "d.duration"
msgid "Your slime is starting to congeal."
msgstr "你的黏液开始凝固。"

msgctxt "d.duration"
msgid "You are calling forth ooze from nearby walls."
msgstr "你正在从附近的墙壁中唤出黏液。"

msgctxt "d.duration"
msgid "You stop calling forth ooze."
msgstr "你停止了召唤黏液。"

msgctxt "d.duration"
msgid "You are sleeping."
msgstr "你正在睡觉。"

msgctxt "d.duration"
msgid "You can move swiftly."
msgstr "你能够迅速移动。"

msgctxt "d.duration"
msgid "You are about to teleport."
msgstr "你即将传送。"

msgctxt "d.duration"
msgid "You are standing in death's doorway."
msgstr "你正置身于死亡之门。"

msgctxt "d.duration"
msgid "Your time is quickly running out!"
msgstr "你剩下的时间不多了！"

msgctxt "d.duration"
msgid "You are unable to enter death's door."
msgstr "你无法进入死亡之门。"

msgctxt "d.duration"
msgid "You step away from death's doorway."
msgstr "你离开了死亡之门。"

msgctxt "d.duration"
msgid "Quad Damage is wearing off."
msgstr "四倍伤害即将消退。"

msgctxt "d.duration"
msgid "You radiate silence."
msgstr "你散发出沉默。"

msgctxt "d.duration"
msgid "Your hearing returns."
msgstr "你的听觉恢复了。"

msgctxt "d.duration"
msgid "You are especially stealthy."
msgstr "你格外隐秘。"

msgctxt "d.duration"
msgid "You feel less stealthy."
msgstr "你感到不再那么隐秘了。"

msgctxt "d.duration"
msgid "You are terrified."
msgstr "你惊恐万分。"

msgctxt "d.duration"
msgid "Your fear fades away."
msgstr "你的恐惧消退了。"

msgctxt "d.duration"
msgid "You are in the eye of a polar vortex."
msgstr "你正处于极地涡流的中心。"

msgctxt "d.duration"
msgid "You are unleashing a barrage of alchemical reagents."
msgstr "你正释放出炼金试剂的弹幕。"

msgctxt "d.duration"
msgid "You are chanting a vengeful prayer."
msgstr "你正在诵经复仇的祷词。"

msgctxt "d.duration"
msgid "Your prayer is nearing its end."
msgstr "你的祈祷即将结束。"

msgctxt "d.duration"
msgid "You are channelling the inexorable grasp of Yredelemnul."
msgstr "你正在引导伊莱德莱姆努尔不可逃脱的掌控。"

msgctxt "d.duration"
msgid "You are liquefying the ground beneath you."
msgstr "你正在液化脚下的地面。"

msgctxt "d.duration"
msgid "The ground is no longer liquid beneath you."
msgstr "你脚下的地面不再液化。"

msgctxt "d.duration"
msgid "You possess the skills of a mighty hero."
msgstr "你拥有强大英雄的技艺。"

msgctxt "d.duration"
msgid "Your blows are lightning fast."
msgstr "你的攻击快如闪电。"

msgctxt "d.duration"
msgid "You are unable to create a polar vortex."
msgstr "你无法制造极地涡流。"

msgctxt "d.duration"
msgid "The winds around you calm down."
msgstr "你周围的风平息了。"

msgctxt "d.duration"
msgid "You are disjoining your surroundings."
msgstr "你正在分离周围的空间。"

msgctxt "d.duration"
msgid "The translocation energy dissipates."
msgstr "位移能量消散了。"

msgctxt "d.duration"
msgid "A sentinel's mark is revealing your location to enemies."
msgstr "哨兵印记将你的位置暴露给敌人。"

msgctxt "d.duration"
msgid "The sentinel's mark upon you fades away."
msgstr "你身上的哨兵印记消退了。"

msgctxt "d.duration"
msgid "Your melee and ranged attacks are strengthened by the souls of the fallen."
msgstr "亡者的灵魂强化了你的近战与远程攻击。"

msgctxt "d.duration"
msgid "Your fugue has ended."
msgstr "你的赋格曲结束了。"

msgctxt "d.duration"
msgid "You are losing your grip on the fallen."
msgstr "你正在失去对亡者的掌控。"

msgctxt "d.duration"
msgid "You are covered in terrible wounds."
msgstr "你满身都是可怖的伤口。"

msgctxt "d.duration"
msgid "Your attacks are enfeebled."
msgstr "你的攻击被削弱了。"

msgctxt "d.duration"
msgid "Your attacks no longer feel as feeble."
msgstr "你的攻击不再那么无力了。"

msgctxt "d.duration"
msgid "You are firmly anchored to this plane."
msgstr "你被牢牢锚定在此位面。"

msgctxt "d.duration"
msgid "You are no longer firmly anchored in space."
msgstr "你不再被牢牢锚定在空间中。"

msgctxt "d.duration"
msgid "You are unable to move around."
msgstr "你无法移动。"

msgctxt "d.duration"
msgid "You are able to move again."
msgstr "你又能移动了。"

msgctxt "d.duration"
msgid "You refuse to leave the level so soon after announcing yourself."
msgstr "刚刚宣告自己的到来，你不愿这么快就离开本层。"

msgctxt "d.duration"
msgid "You feel willing to depart the floor again."
msgstr "你再次愿意离开本层了。"

msgctxt "d.duration"
msgid "Your enlightenment fades."
msgstr "你的启明效果消退了。"

msgctxt "d.duration"
msgid "You are radiating toxic energy."
msgstr "你正在散发剧毒能量。"

msgctxt "d.duration"
msgid "Your toxic aura wanes."
msgstr "你的剧毒光环减弱了。"

msgctxt "d.duration"
msgid "You are reciting Zin's Axioms of Law."
msgstr "你正在诵经辛的法则公理。"

msgctxt "d.duration"
msgid "You are unable to recite."
msgstr "你无法诵经。"

msgctxt "d.duration"
msgid "You are ready to recite again."
msgstr "你又能诵经了。"

msgctxt "d.duration"
msgid "You are more vulnerable to fire."
msgstr "你更容易受到火焰伤害。"

msgctxt "d.duration"
msgid "You feel less vulnerable to fire."
msgstr "你不再那么容易受到火焰伤害。"

msgctxt "d.duration"
msgid "Barbed spikes are embedded in your body."
msgstr "倒刺嵌入了你的身体。"

msgctxt "d.duration"
msgid "You are more vulnerable to poison."
msgstr "你更容易受到毒素伤害。"

msgctxt "d.duration"
msgid "You feel less vulnerable to poison."
msgstr "你不再那么容易受到毒素伤害。"

msgctxt "d.duration"
msgid "You are partly encased in ice."
msgstr "你的部分身体被冰封住了。"

msgctxt "d.duration"
msgid "The ice encasing you melts away."
msgstr "包裹你的冰融化了。"

msgctxt "d.duration"
msgid "You are teleporting projectiles at a target."
msgstr "你正在将投射物传送至目标。"

msgctxt "d.duration"
msgid "Your dimensional bullseye dissipates."
msgstr "你的空间靶心消散了。"

msgctxt "d.duration"
msgid "You are summoning a forest."
msgstr "你正在召唤森林。"

msgctxt "d.duration"
msgid "Space becomes stable."
msgstr "空间恢复了稳定。"

msgctxt "d.duration"
msgid "You are beckoning forth a horde of dragons."
msgstr "你正在召唤龙群。"

msgctxt "d.duration"
msgid "The roar of the dragon horde subsides."
msgstr "龙群的咆哮平息了。"

msgctxt "d.duration"
msgid "You are unable to call dragons."
msgstr "你无法召唤龙群。"

msgctxt "d.duration"
msgid "You can once more reach out to the dragon horde."
msgstr "你又能呼唤龙群了。"

msgctxt "d.duration"
msgid "Qazlal is protecting you from fire."
msgstr "卡兹拉尔保护你免受火焰伤害。"

msgctxt "d.duration"
msgid "You feel less protected from fire."
msgstr "你抵御火焰的防护减弱了。"

msgctxt "d.duration"
msgid "Your protection from fire is fading."
msgstr "你抵御火焰的防护即将消失。"

msgctxt "d.duration"
msgid "Qazlal is protecting you from cold."
msgstr "卡兹拉尔保护你免受寒冷伤害。"

msgctxt "d.duration"
msgid "You feel less protected from cold."
msgstr "你抵御寒冷的防护减弱了。"

msgctxt "d.duration"
msgid "Your protection from cold is fading."
msgstr "你抵御寒冷的防护即将消失。"

msgctxt "d.duration"
msgid "Qazlal is protecting you from electricity."
msgstr "卡兹拉尔保护你免受电击伤害。"

msgctxt "d.duration"
msgid "You feel less protected from electricity."
msgstr "你抵御电击的防护减弱了。"

msgctxt "d.duration"
msgid "Your protection from electricity is fading."
msgstr "你抵御电击的防护即将消失。"

msgctxt "d.duration"
msgid "Qazlal is protecting you from physical damage."
msgstr "卡兹拉尔保护你免受物理伤害。"

msgctxt "d.duration"
msgid "You feel less protected from physical attacks."
msgstr "你抵御物理攻击的防护减弱了。"

msgctxt "d.duration"
msgid "Your protection from physical attacks is fading."
msgstr "你抵御物理攻击的防护即将消失。"

msgctxt "d.duration"
msgid "You are corroded."
msgstr "你受到了腐蚀。"

msgctxt "d.duration"
msgid "You are no longer corroded."
msgstr "你不再受到腐蚀。"

msgctxt "d.duration"
msgid "You are horrified, weakening your attacks and spells."
msgstr "恐惧削弱了你的攻击与法术。"

msgctxt "d.duration"
msgid "You are shielded by the power of the Shining One."
msgstr "光明神的力量护佑着你。"

msgctxt "d.duration"
msgid "You are briefly shielded after casting or invoking."
msgstr "施法或祈祷后，你会短暂获得护盾。"

msgctxt "d.duration"
msgid "You are cleaving through your foes."
msgstr "你正在劈斩敌人。"

msgctxt "d.duration"
msgid "Your cleaving frenzy subsides."
msgstr "你疯狂的劈斩平息了。"

msgctxt "d.duration"
msgid "You are regenerating under the effects of ambrosia."
msgstr "你正在神酒的作用下恢复。"

msgctxt "d.duration"
msgid "You are rapidly regenerating magical energy."
msgstr "你的魔力正在迅速恢复。"

msgctxt "d.duration"
msgid "A terrible howling echoes in your mind."
msgstr "可怕的嚎叫在你脑海中回荡。"

msgctxt "d.duration"
msgid "The infernal howling subsides."
msgstr "地狱般的嚎叫平息了。"

msgctxt "d.duration"
msgid "Vertigo is making it harder to attack, cast, and dodge."
msgstr "眩晕使你更难攻击、施法和闪避。"

msgctxt "d.duration"
msgid "The world stops spinning."
msgstr "世界不再天旋地转。"

msgctxt "d.duration"
msgid "Your shed blood clings to and protects you."
msgstr "你流出的鲜血附着在身上，保护着你。"

msgctxt "d.duration"
msgid "Your blood armour dries and flakes away."
msgstr "你的鲜血护甲干涸剥落了。"

msgctxt "d.duration"
msgid "Your weapon is exuding a protective aura."
msgstr "你的武器散发着防护光环。"

msgctxt "d.duration"
msgid "You are unable to hop."
msgstr "你无法跳跃。"

msgctxt "d.duration"
msgid "You are ready to hop once more."
msgstr "你又能跳跃了。"

msgctxt "d.duration"
msgid "You feel energetic enough to blinkbolt again."
msgstr "你的精力足以再次使用闪现雷击了。"

msgctxt "d.duration"
msgid "You are acrobatic and have increased evasion."
msgstr "你身手矫健，闪避值提高。"

msgctxt "d.duration"
msgid "You attract monsters toward you."
msgstr "你吸引怪物向你靠近。"

msgctxt "d.duration"
msgid "You are rapidly regenerating health and magic."
msgstr "你的生命与魔力正在迅速恢复。"

msgctxt "d.duration"
msgid "You are unable to speak a word of chaos."
msgstr "你无法说出混沌真言。"

msgctxt "d.duration"
msgid "You are ready to speak a word of chaos again."
msgstr "你又能说出混沌真言了。"

msgctxt "d.duration"
msgid "Casting spells may cause you to lose access to your magic."
msgstr "施法可能使你暂时无法使用魔法。"

msgctxt "d.duration"
msgid "Your magic seems less tainted."
msgstr "你的魔法似乎不再那么污浊了。"

msgctxt "d.duration"
msgid "You are unable to cast spells."
msgstr "你无法施法。"

msgctxt "d.duration"
msgid "You regain access to your magic."
msgstr "你重新获得了施法能力。"

msgctxt "d.duration"
msgid "You are rising toward the ceiling."
msgstr "你正在向天花板升起。"

msgctxt "d.duration"
msgid "Your sickness prevents you from regenerating health."
msgstr "疾病使你无法恢复生命。"

msgctxt "d.duration"
msgid "You feel your health improve."
msgstr "你感到健康状况好转了。"

msgctxt "d.duration"
msgid "You are unable to blink."
msgstr "你无法闪现。"

msgctxt "d.duration"
msgid "You feel ready to blink again."
msgstr "你又能闪现了。"

msgctxt "d.duration"
msgid "You are unable to cast Gavotte."
msgstr "你无法施放加沃特舞曲。"

msgctxt "d.duration"
msgid "Gravity stabilises in your vicinity."
msgstr "你附近的重力恢复了稳定。"

msgctxt "d.duration"
msgid "You are unable to cast Hellfire Mortar."
msgstr "你无法施放地地狱火迫击炮。"

msgctxt "d.duration"
msgid "You feel ready to split the earth once more."
msgstr "你又能劈开大地了。"

msgctxt "d.duration"
msgid "You are reanimating the dead."
msgstr "你正在复活死者。"

msgctxt "d.duration"
msgid "Your reaping aura expires."
msgstr "你的收割光环消失了。"

msgctxt "d.duration"
msgid "Your reaping aura is weakening."
msgstr "你的收割光环正在减弱。"

msgctxt "d.duration"
msgid "You are unable to siphon essence."
msgstr "你无法汲取精华。"

msgctxt "d.duration"
msgid "You are ready to siphon essence again."
msgstr "你又能汲取精华了。"

msgctxt "d.duration"
msgid "You are unable to performed a blood rite."
msgstr "你无法进行鲜血仪式。"

msgctxt "d.duration"
msgid "Your swarm has recently come to your defense."
msgstr "你的虫群刚刚保护过你。"

msgctxt "d.duration"
msgid "Your orb of stardust has temporarily expended its magic."
msgstr "你的星尘宝珠暂时耗尽了魔力。"

msgctxt "d.duration"
msgid "Your orb of mesmerism has temporarily expended its magic."
msgstr "你的魅惑宝珠暂时耗尽了魔力。"

msgctxt "d.duration"
msgid "Your orb has recharged its mesmeric power."
msgstr "你的宝珠恢复了魅惑之力。"

msgctxt "d.duration"
msgid "Your lithotoxin has recently activated."
msgstr "你的石毒刚刚生效过。"

msgctxt "d.duration"
msgid "Your hands have recently discharged their full voltage."
msgstr "你的双手刚刚释放过全部电力。"

msgctxt "d.duration"
msgid "You are surrounded by jinxing sprites."
msgstr "厄咒精灵环绕着你。"

msgctxt "d.duration"
msgid "The jinxing sprites lose interest in you."
msgstr "厄咒精灵对你失去了兴趣。"

msgctxt "d.duration"
msgid "You are unable to call your canine familiar."
msgstr "你无法召唤犬类魔宠。"

msgctxt "d.duration"
msgid "Your familiar recovers from its injuries."
msgstr "你的魔宠从伤势中恢复了。"

msgctxt "d.duration"
msgid "You are enveloped in primordial darkness."
msgstr "原初黑暗笼罩着你。"

msgctxt "d.duration"
msgid "Night gives way to day once more."
msgstr "黑夜再次让位于白昼。"

msgctxt "d.duration"
msgid "The further away your target is the more your accuracy is reduced."
msgstr "目标越远，你的命中率降低得越多。"

msgctxt "d.duration"
msgid "Your vision returns to normal."
msgstr "你的视力恢复了正常。"

msgctxt "d.duration"
msgid "The sign of ruin enfeebles you when you suffer attacks."
msgstr "毁灭征兆会在你受到攻击时削弱你。"

msgctxt "d.duration"
msgid "The sign of ruin upon you fades."
msgstr "你身上的毁灭征兆消退了。"

msgctxt "d.duration"
msgid "You are beckoning forth the legions of chaos."
msgstr "你正在召唤混沌军团。"

msgctxt "d.duration"
msgid "Your infernal gateway subsides."
msgstr "你的地狱之门消退了。"

msgctxt "d.duration"
msgid "You are surrounded by a whirlwind of blades."
msgstr "刀刃旋风环绕着你。"

msgctxt "d.duration"
msgid "You feel a little less murderous for the moment."
msgstr "你暂时不再那么杀气腾腾了。"

msgctxt "d.duration"
msgid "Your Destruction is growing increasingly wild."
msgstr "你的毁灭之力正变得愈发狂野。"

msgctxt "d.duration"
msgid "You are untethered in space."
msgstr "你在空间中失去了锚定。"

msgctxt "d.duration"
msgid "You feel more stable."
msgstr "你感到更加稳定了。"

msgctxt "d.duration"
msgid "You are making an unholy racket with your haunted armour."
msgstr "你附身的防具正发出邪异的喧嚣。"

msgctxt "d.duration"
msgid "Your flames burn bright with remembrance."
msgstr "回忆使你的火焰熊熊燃烧。"

msgctxt "d.duration"
msgid "Your flames start to waver."
msgstr "你的火焰开始摇曳。"

msgctxt "d.duration"
msgid "Your strikes ignite an explosive catalyst."
msgstr "你的攻击会点燃爆炸催化剂。"

msgctxt "d.duration"
msgid "Your shroud of slime is broken and needs time to repair."
msgstr "你的黏液帷幕已破碎，需要时间修复。"

msgctxt "d.duration"
msgid "Your slime shroud regrows."
msgstr "你的黏液帷幕重新长好了。"

msgctxt "d.duration"
msgid "Your melee attacks are strengthened by primal bloodlust."
msgstr "原始嗜血欲望强化了你的近战攻击。"

msgctxt "d.duration"
msgid "Your bloodlust subsides."
msgstr "你的嗜血欲望平息了。"

msgctxt "d.duration"
msgid "You feel your bloodlust ebbing."
msgstr "你感到嗜血欲望正在消退。"

msgctxt "d.duration"
msgid "You are parrying attacks and have increased SH."
msgstr "你正在招架攻击，格挡值提高。"

msgctxt "d.duration"
msgid "You feel very devious."
msgstr "你感到诡计多端。"

msgctxt "d.duration"
msgid "You feel less devious."
msgstr "你不再那么诡计多端了。"

msgctxt "d.duration"
msgid "Your maw is digesting a delicious meal."
msgstr "你的巨口正在消化美餐。"

msgctxt "d.duration"
msgid "You finish digesting your meal."
msgstr "你消化完了这顿美餐。"

msgctxt "d.duration"
msgid "You flicker for a moment."
msgstr "你的身影闪烁了一瞬。"

msgctxt "d.duration"
msgid "You break out of your daze."
msgstr "你摆脱了恍惚。"

msgctxt "d.duration"
msgid "Your icy envelope is restored."
msgstr "你的冰层外壳恢复了。"

msgctxt "d.duration"
msgid "Your willpower is greatly increased."
msgstr "你的意志力大幅提高。"

msgctxt "d.duration"
msgid "You feel the effects of Trog's Hand fading."
msgstr "你感到特洛格之手的效果正在消退。"

msgctxt "d.duration"
msgid "You are spewing a noxious bog."
msgstr "你正在喷吐毒沼。"

msgctxt "d.duration"
msgid "Your noxious spew wanes."
msgstr "你的毒沼喷吐减弱了。"

msgctxt "d.duration"
msgid "You have covered nearby walls with an icy ambush."
msgstr "你在附近墙壁上布下了冰霜伏击。"

msgctxt "d.duration"
msgid "Heavenly clouds are increasing your accuracy and damage."
msgstr "天界云雾提高了你的命中率与伤害。"

msgctxt "d.duration"
msgid "You can drink potions again."
msgstr "你又能饮用药水了。"

msgctxt "d.duration"
msgid "You can read scrolls again."
msgstr "你又能阅读卷轴了。"

msgctxt "d.duration"
msgid "A servant of Beogh has come to challenge you."
msgstr "一位比欧弗的仆从前来挑战你。"

msgctxt "d.duration"
msgid "You are seeking vengeance for the death of your brethren."
msgstr "你正为同胞的死亡寻求复仇。"

msgctxt "d.duration"
msgid "You feel less drowsy."
msgstr "你的困倦减轻了。"

msgctxt "d.duration"
msgid "Your slimification abates."
msgstr "你的黏液化减退了。"

msgctxt "d.duration"
msgid "The regenerative ooze finishes dripping off of you."
msgstr "你身上的再生黏液已全部滴落。"

