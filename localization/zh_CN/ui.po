msgctxt "d.feature.help"
msgid "\nWhile standing here, you can try to enter %s with the <w>%s</w> key; it will vanish after you do so."
msgstr "\n站在这里时，可以尝试进入%s，按键为 <w>%s</w>；进入后它就会消失。"

#, c-format
msgctxt "d.feature.help"
msgid "\nWhile standing here, you can enter %s with the <w>%s</w> key; it will vanish after you do so."
msgstr "\n站在这里时，可以进入%s，按键为 <w>%s</w>；进入后它就会消失。"

#, c-format
msgctxt "d.feature.help"
msgid "\nWhile standing here, you can enter <w>%s</w> with the <w>%s</w> key."
msgstr "\n站在这里时，可以进入<w>%s</w>，按键为 <w>%s</w>。"

#, c-format
msgctxt "d.feature.help"
msgid "\nWhile standing here, you can enter %s with with the <w>%s</w> key."
msgstr "\n站在这里时，可以进入%s，按键为 <w>%s</w>。"

#, c-format
msgctxt "d.feature.help"
msgid "\nWhile standing here, you can enter through %s with the <w>%s</w> key."
