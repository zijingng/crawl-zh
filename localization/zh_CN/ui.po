msgid "Yoink! You pull the items towards yourself."
msgstr "嗖！你将物品拉向自己。"

#, c-format
msgctxt "s.log"
msgid "%s is pinned by gravity."
msgstr "%s被重力钉住了。"

#, c-format
msgctxt "s.log"
msgid "%s is hurled suddenly forward!"
msgstr "%s突然被向前抛去！"

#, c-format
msgctxt "s.log"
msgid "%s is attracted toward you."
msgstr "%s被吸向你。"

#, c-format
msgctxt "s.log"
msgid "Gravity reorients to the %s!"
msgstr "重力转向了%s！"

#, c-format
msgctxt "s.log"
msgid "You pounce on %s with bestial fury!"
msgstr "你带着野兽般的狂怒扑向%s！"

#, c-format
msgctxt "s.log"
msgid "(You may use Imbue Servitor from the <w>%s</w>bility menu to change which spell your servitor casts.)"
