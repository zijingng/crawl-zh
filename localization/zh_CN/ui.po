msgstr "触手"

msgctxt "o.body"
msgid "pincer"
msgstr "螯钳"

msgctxt "o.body"
msgid "pincers"
msgstr "螯钳"

msgctxt "o.body"
msgid "arm"
msgstr "手臂"

msgctxt "o.body"
msgid "arms"
msgstr "手臂"

#, c-format
msgctxt "o.title"
msgid "%s the %s"
msgstr "%s，%s"

#, c-format
msgctxt "o.title"
msgid "%s, %s"
msgstr "%s·%s"

#, c-format
msgctxt "o.title"
msgid " %s "
msgstr " 【%s】 "

#, c-format
msgctxt "o.title"
msgid "(%s %s)"
msgstr "（%s%s）"

#, c-format
msgctxt "o.title"
msgid " Turns: %s, Time: %s"
msgstr " 回合：%s，时间：%s"

#, c-format
msgctxt "o.title"
msgid " of %s"
msgstr "，信奉%s"

msgctxt "p.ui"
msgid "Your unstable footing causes you to fumble your attack."
msgstr "立足不稳让你未能顺利发起攻击。"

msgctxt "p.ui"
msgid "A red film seems to cover your vision as you go berserk!"
msgstr "你陷入狂暴，眼前仿佛蒙上了一层血色！"

msgctxt "p.ui"
msgid "Your finesse ends abruptly."
msgstr "你的精湛技艺骤然结束。"

msgctxt "p.ui"
msgid "Your anger overwhelms your terror!"
msgstr "你的怒火压倒了恐惧！"

msgctxt "p.ui"
msgid "You feel yourself moving faster!"
msgstr "你感觉自己的动作变快了！"

msgctxt "p.ui"
msgid "You feel mighty!"
msgstr "你感觉力大无穷！"

msgctxt "p.ui"
msgid "You feel rather light."
msgstr "你感觉轻盈了许多。"

msgctxt "p.ui"
msgid "You feel a build-up of mutagenic energy."
msgstr "你感觉诱变能量正在积聚。"

msgctxt "p.ui"
msgid "You feel a malign power afflict you."
msgstr "你感觉一股恶意的力量侵袭了你。"

msgctxt "p.ui"
msgid "You feel ready to rampage towards enemies."
msgstr "你感觉已准备好向敌人横冲直撞。"

msgctxt "p.ui"
msgid "You feel strangely lacking in power."
msgstr "你感觉莫名地缺乏力量。"

msgctxt "p.ui"
msgid "You feel powerful."
msgstr "你感觉力量充沛。"

msgctxt "p.ui"
msgid "Mutagenic energies flood into your body!"
msgstr "诱变能量涌入你的体内！"

msgctxt "p.ui"
msgid "You no longer feel able to rampage towards enemies."
msgstr "你不再觉得自己能向敌人横冲直撞。"

msgctxt "p.ui"
msgid "You feel strangely numb."
msgstr "你感觉莫名地麻木。"

msgctxt "p.ui"
msgid "You really shouldn't be using a holy item like this."
msgstr "你实在不该使用这样的神圣物品。"

msgctxt "p.ui"
msgid "You really shouldn't be using an evil item like this."
msgstr "你实在不该使用这样的邪恶物品。"

msgctxt "p.ui"
msgid "You really shouldn't be using an unclean item like this."
msgstr "你实在不该使用这样的不洁物品。"

msgctxt "p.ui"
msgid "You really shouldn't be using a chaotic item like this."
msgstr "你实在不该使用这样的混沌物品。"

msgctxt "p.ui"
msgid "You really shouldn't be using a hasty item like this."
msgstr "你实在不该使用这样的加速物品。"

msgctxt "p.ui"
msgid "You really shouldn't be using a wizardly item like this."
msgstr "你实在不该使用这样的施法辅助物品。"

msgctxt "p.ui"
msgid "You hear the crackle of electricity."
msgstr "你听见电流的噼啪声。"

msgctxt "p.ui"
msgid "You see sparks fly."
msgstr "你看见火花迸射。"

msgctxt "p.ui"
msgid "You sense an unholy aura."
msgstr "你感受到一股不洁的气息。"

msgctxt "p.ui"
msgid "You feel a sense of dread."
msgstr "你心生恐惧。"

msgctxt "p.ui"
msgid "You have a feeling of ineptitude."
msgstr "你感觉无能为力。"

msgctxt "p.ui"
msgid "You feel a force failing to suppress your magic."
msgstr "你感觉有股力量试图压制你的魔法，却未能奏效。"

msgctxt "p.ui"
msgid "You feel magic leave you."
msgstr "你感觉魔力离你而去。"

msgctxt "p.ui"
msgid "Space warps around you for a moment!"
msgstr "你周围的空间短暂地扭曲了！"

msgctxt "p.ui"
msgid "Your weapon gleams with eagerness."
msgstr "你的武器闪烁着跃跃欲试的光芒。"

msgctxt "p.ui"
msgid "You feel a baleful cunning."
msgstr "你感受到一种恶毒的狡黠。"

msgctxt "p.ui"
msgid "You feel the dreadful sensation subside."
msgstr "你感觉恐惧正在消退。"

msgctxt "p.ui"
msgid "You feel magic returning to you."
msgstr "你感觉魔力正在回归。"

msgctxt "p.ui"
msgid "You feel very meek."
msgstr "你感觉十分怯懦。"

msgctxt "p.ui"
msgid "You feel guileless."
msgstr "你感觉毫无心机。"

msgctxt "p.ui"
msgid "You feel your power drawn to a protective spirit."
msgstr "你感觉自己的力量被引向一位守护灵。"

msgctxt "p.ui"
msgid "Now linked to your health, your magic stops regenerating."
msgstr "你的魔力与生命相连，不再自行恢复。"

msgctxt "p.ui"
msgid "You feel the presence of a powerless spirit."
msgstr "你感觉到一位无力的灵体在场。"

msgctxt "p.ui"
msgid "You feel spirits watching over you."
msgstr "你感觉有灵体守护着你。"

msgctxt "p.ui"
msgid "You feel resistant to fire."
msgstr "你感觉能够抵抗火焰。"

msgctxt "p.ui"
msgid "You feel resistant to cold."
msgstr "你感觉能够抵抗寒冷。"

msgctxt "p.ui"
msgid "You feel resistant to poison."
msgstr "你感觉能够抵抗毒素。"

msgctxt "p.ui"
msgid "You feel perceptive."
msgstr "你感觉感知更加敏锐。"

msgctxt "p.ui"
msgid "You become transparent for a moment."
msgstr "你的身体短暂地变得透明。"

msgctxt "p.ui"
msgid "You feel rather ponderous."
msgstr "你感觉沉重了许多。"

msgctxt "p.ui"
msgid "You feel strong-willed."
msgstr "你感觉意志坚定。"

msgctxt "p.ui"
msgid "You feel protected."
msgstr "你感觉受到保护。"

msgctxt "p.ui"
msgid "You feel stealthy."
msgstr "你感觉行动隐秘。"

msgctxt "p.ui"
msgid "You feel resistant to extremes of temperature."
msgstr "你感觉能够抵抗酷热与严寒。"

msgctxt "p.ui"
msgid "You feel more protected from negative energy."
msgstr "你感觉对负能量的抵抗增强了。"

msgctxt "p.ui"
msgid "You feel that your aim is more steady."
msgstr "你感觉瞄准更加稳定了。"

msgctxt "p.ui"
msgid "You are surrounded by a repulsion field."
msgstr "你被偏斥力场环绕。"

msgctxt "p.ui"
msgid "It gets dark."
msgstr "周围暗了下来。"

msgctxt "p.ui"
msgid "You feel less resistant to fire."
msgstr "你感觉对火焰的抵抗减弱了。"

msgctxt "p.ui"
msgid "You feel less resistant to cold."
msgstr "你感觉对寒冷的抵抗减弱了。"

msgctxt "p.ui"
msgid "You no longer feel resistant to poison."
msgstr "你不再感觉能够抵抗毒素。"

msgctxt "p.ui"
msgid "You feel less perceptive."
msgstr "你感觉感知不再那么敏锐。"

msgctxt "p.ui"
msgid "You feel less strong-willed."
msgstr "你感觉意志不再那么坚定。"

msgctxt "p.ui"
msgid "You feel less protected."
msgstr "你感觉保护减弱了。"

msgctxt "p.ui"
msgid "You feel less stealthy."
msgstr "你感觉行动不再那么隐秘。"

msgctxt "p.ui"
msgid "You feel hot and cold all over."
msgstr "你感觉浑身忽冷忽热。"

msgctxt "p.ui"
msgid "You feel less protected from negative energy."
msgstr "你感觉对负能量的抵抗减弱了。"

msgctxt "p.ui"
msgid "You feel strangely alone."
msgstr "你感觉莫名地孤独。"

msgctxt "p.ui"
msgid "Your magic begins regenerating once more."
msgstr "你的魔力再次开始自行恢复。"

msgctxt "p.ui"
msgid "Your aim is not that steady anymore."
msgstr "你的瞄准不再那么稳定了。"

msgctxt "p.ui"
msgid "The haze of the repulsion field disappears."
msgstr "偏斥力场的薄雾消散了。"

msgctxt "p.ui"
msgid "The dungeon's light returns to normal."
msgstr "地牢的光线恢复了正常。"

msgctxt "p.ui"
msgid "You feel less pious."
msgstr "你感觉虔诚减退了。"

msgctxt "p.ui"
msgid "You feel a shielding aura gather around you."
msgstr "你感觉一道护盾光环在周围凝聚。"

msgctxt "p.ui"
msgid "You repel a surge of foreign magic."
msgstr "你抵御了一股外来的魔法。"

msgctxt "p.ui"
msgid "You feel a surge of self-confidence."
msgstr "你感觉自信倍增。"

msgctxt "p.ui"
msgid "You already have all the faith you need."
msgstr "你已有足够的信仰。"

msgctxt "p.ui"
msgid "You feel no more acrobatic than usual."
msgstr "你感觉自己并未比平时更加灵活。"

msgctxt "p.ui"
msgid "You feel ready to tumble and roll out of harm's way."
msgstr "你感觉已准备好翻滚腾挪，避开伤害。"

msgctxt "p.ui"
msgid "You feel a wild power."
msgstr "你感受到一股狂野的力量。"

msgctxt "p.ui"
msgid "You feel a deeper understanding of alchemy."
msgstr "你感觉对炼金术的理解更深了。"

msgctxt "p.ui"
msgid "You feel as though your troubles will go away faster."
msgstr "你感觉自己的不适将更快消退。"

msgctxt "p.ui"
msgid "Space warps into you!"
msgstr "空间扭曲着撞向你！"

msgctxt "p.ui"
msgid "<green>Wyrmbane glows as a worthy foe approaches.</green>"
msgstr "<green>劲敌接近，龙祸泛起光芒。</green>"

msgctxt "p.ui"
msgid "Your limbs are stiffening."
msgstr "你的四肢正在僵硬。"

msgctxt "p.ui"
msgid "You feel less attractive to monsters."
msgstr "你感觉对怪物的吸引力减弱了。"

msgctxt "p.ui"
msgid "You can act again."
msgstr "你又能行动了。"

msgctxt "p.ui"
msgid "The heat melts your icy armour."
msgstr "热量融化了你的冰甲。"

msgctxt "p.ui"
msgid "Monsters! Monsters everywhere! You have to get out of here!"
msgstr "怪物！到处都是怪物！你必须逃离这里！"

msgctxt "p.ui"
msgid "You reel with horror at the sight of these foes!"
msgstr "看到这些敌人，你惊恐得摇摇欲坠！"

msgctxt "p.ui"
msgid "You feel a twist of horror at the sight of this foe."
msgstr "看到这个敌人，你心中一阵恐惧。"

msgctxt "p.ui"
msgid "The roots around you sink back into the ground."
msgstr "缠绕你的根须缩回了地下。"

msgctxt "p.ui"
msgid "The zombie hands holding you return to the earth."
msgstr "抓住你的僵尸之手缩回了地下。"

msgctxt "p.ui"
msgid "Your orb has finished recharging its magic."
msgstr "你的宝珠已完成魔力充能。"

msgctxt "p.ui"
msgid "Your recitation is interrupted."
msgstr "你的诵经被打断了。"

msgctxt "p.ui"
msgid "You feel your existence waver again."
msgstr "你感觉自身的存在再次动摇。"

msgctxt "p.ui"
msgid "Your fortress blast dissipates harmlessly."
msgstr "你的堡垒冲击消散了，未造成任何伤害。"

msgctxt "p.ui"
msgid "Your lungs strain for air."
msgstr "你的肺部因缺氧而不堪重负。"

msgctxt "p.ui"
msgid "As the last of your armour is driven back to you, your cacophony ends."
msgstr "最后一片防具飞回你身边，不谐狂响随之结束。"

msgctxt "p.ui"
msgid "You are ready to perform a blood rite again."
msgstr "你又能举行血祭了。"

msgctxt "p.ui"
msgid "Your time-warped blood is ready to ripple again."
msgstr "你的时间扭曲之血又能泛起涟漪了。"

msgctxt "p.ui"
msgid "The buzzing within you returns to its normal rhythm."
msgstr "你体内的嗡鸣恢复了正常节奏。"

msgctxt "p.ui"
msgid "You feel your defenses recover."
msgstr "你感觉防御恢复了。"

msgctxt "p.ui"
msgid "The wailing of tortured souls fills the air!"
msgstr "受折磨的灵魂发出的哀号充斥着空气！"

#, c-format
msgctxt "p.ui"
msgid "Your base attributes are Str %d, Int %d, Dex %d."
msgstr "你的基础属性为力量 %d、智力 %d、敏捷 %d。"

msgctxt "p.ui"
msgid "Uppercase letters only, please."
msgstr "请只使用大写字母。"

msgctxt "p.ui"
msgid "The curse of the Prune overcomes you."
msgstr "普鲁恩的诅咒压倒了你。"

msgctxt "p.ui"
msgid "You cannot enter water in your current form."
msgstr "你当前的形态无法进入水中。"

msgctxt "p.ui"
msgid "It's unwise to walk into this."
msgstr "踏进这里并不明智。"

msgctxt "p.ui"
msgid "Moving in this stuff is going to be slow."
msgstr "在这里移动会很缓慢。"

msgctxt "p.ui"
msgid "...and don't expect to remain undetected."
msgstr "……而且别指望不被发现。"

msgctxt "p.ui"
msgid "Don't expect to remain undetected while in the water."
msgstr "在水中时，别指望不被发现。"

msgctxt "p.ui"
msgid "Acid dripping from the walls corrodes you."
msgstr "墙上滴落的酸液腐蚀了你。"

msgctxt "p.ui"
msgid "Your life force feels restored."
msgstr "你感觉生命力恢复了。"

msgctxt "p.ui"
msgid "You feel power welling in your lungs."
msgstr "你感觉力量在肺中积聚。"

msgctxt "p.ui"
msgid "You feel ready to make another cacophony."
msgstr "你感觉又能施展不谐狂响了。"

msgctxt "p.ui"
msgid "You feel ready to scatter into bats once more."
msgstr "你感觉又能化作蝙蝠四散飞去了。"

msgctxt "p.ui"
msgid "You feel ready to drown your foes once more."
msgstr "你感觉又能淹没敌人了。"

msgctxt "p.ui"
msgid "You feel the doom around you dissipate."
msgstr "你感觉周围的厄运消散了。"

msgctxt "p.ui"
msgid "Extra life!"
msgstr "额外生命！"

msgctxt "p.ui"
msgid "Your capacity for spells is full, and you lose access to an earlier spell."
msgstr "你能掌握的法术已满，失去了较早获得的一个法术。"

msgctxt "p.ui"
msgid "You remember only oblivion."
msgstr "你的记忆中只剩虚无。"

#, c-format
msgctxt "p.ui"
msgid "Welcome back to level %d!"
msgstr "欢迎重返 %d 级！"

msgctxt "p.ui"
msgid "You have reached level 27, the final one!"
msgstr "你已达到最终等级：27 级！"

#, c-format
msgctxt "p.ui"
msgid "You have reached level %d, the highest you will ever reach!"
msgstr "你已达到 %d 级，再也无法提升等级了！"

msgctxt "p.ui"
msgid "Your skin feels tougher."
msgstr "你感觉皮肤更加坚韧。"

msgctxt "p.ui"
msgid "You feel monstrous as your demonic heritage exerts itself."
msgstr "你的恶魔血统开始显现，你感觉自己如同怪物。"

msgctxt "p.ui"
msgid "Your demonic ancestry asserts itself..."
msgstr "你的恶魔血统开始显现……"

msgctxt "p.ui"
msgid "You feel a burst of inspiration! You are finally ready to make a one-of-a-kind gizmo!"
msgstr "你灵光乍现！你终于准备好制造一件独一无二的装置了！"

msgctxt "p.ui"
msgid "Your scales feel tougher."
msgstr "你感觉鳞片更加坚韧。"

msgctxt "p.ui"
msgid "You are illuminated by a large divine halo."
msgstr "一道巨大的神圣光环照亮了你。"

msgctxt "p.ui"
msgid "You are illuminated by a divine halo."
msgstr "一道神圣光环照亮了你。"

msgctxt "p.ui"
msgid "You are illuminated by a small divine halo."
msgstr "一道小小的神圣光环照亮了你。"

msgctxt "p.ui"
msgid "An external divine halo illuminates you."
msgstr "一道外来的神圣光环照亮了你。"

msgctxt "p.ui"
msgid "* * * LOW MAGIC WARNING * * *"
msgstr "* * * 魔力值过低警告 * * *"

msgctxt "p.ui"
msgid "* * * LOW HITPOINT WARNING * * *"
msgstr "* * * 生命值过低警告 * * *"

msgctxt "p.ui"
msgid "You cannot pay life while functionally dead."
msgstr "你在生理上已死亡，无法支付生命。"

msgctxt "p.ui"
msgid "You don't have enough health at the moment."
msgstr "你目前没有足够的生命值。"

msgctxt "p.ui"
msgid "You don't have enough magic capacity."
msgstr "你的魔力值上限不足。"

msgctxt "p.ui"
msgid "You don't have enough magic at the moment."
msgstr "你目前没有足够的魔力值。"

msgctxt "p.ui"
msgid "Your magical contamination has faded to a safe level."
msgstr "你的魔法污染已降至安全水平。"

msgctxt "p.ui"
msgid "You fade completely from view now that you are no longer glowing from magical contamination."
msgstr "魔法污染的光芒已经消失，你现在完全隐形了。"

msgctxt "p.ui"
msgid "Your magical contamination has completely faded away."
msgstr "你的魔法污染已经完全消退。"

msgctxt "p.ui"
msgid "You feel momentarily confused."
msgstr "你短暂地感到困惑。"

msgctxt "p.ui"
msgid "Your divine stamina protects you from confusion!"
msgstr "你的神圣耐力保护你免于混乱！"

msgctxt "p.ui"
msgid "Your divine stamina protects you from poison!"
msgstr "你的神圣耐力保护你免于中毒！"

msgctxt "p.ui"
msgid "You are lethally poisoned!"
msgstr "你身中致命剧毒！"

msgctxt "p.ui"
msgid "You are no longer poisoned."
msgstr "你不再中毒。"

msgctxt "p.ui"
msgid "Your divine stamina protects you from the miasma!"
msgstr "你的神圣耐力保护你免受瘴气侵害！"

msgctxt "p.ui"
msgid "You dip into the water, and the flames go out!"
msgstr "你浸入水中，火焰熄灭了！"

msgctxt "p.ui"
msgid "The liquid fire finally exhausts itself."
msgstr "液火终于燃尽了。"

msgctxt "p.ui"
msgid "You shake off the liquid fire."
msgstr "你甩掉了身上的液火。"

msgctxt "p.ui"
msgid "You shake off some of the fire as you move."
msgstr "你移动时甩掉了一些火焰。"

msgctxt "p.ui"
msgid "You feel your silence will last longer."
msgstr "你感觉沉默将持续更久。"

msgctxt "p.ui"
msgid "An unnatural silence engulfs you."
msgstr "一片异常的寂静笼罩了你。"

msgctxt "p.ui"
msgid "Your stasis prevents you from being slowed."
msgstr "你的稳态阻止了减速。"

msgctxt "p.ui"
msgid "You already are as slow as you could be."
msgstr "你的速度已经无法再慢了。"

msgctxt "p.ui"
msgid "You feel yourself slow down."
msgstr "你感觉自己的动作变慢了。"

msgctxt "p.ui"
msgid "You feel as though you will be slow longer."
msgstr "你感觉减速将持续更久。"

msgctxt "p.ui"
msgid "You feel yourself speed up."
msgstr "你感觉自己的动作变快了。"

msgctxt "p.ui"
msgid "Barbed spikes become lodged in your body."
msgstr "带倒刺的尖刺扎进了你的身体。"

msgctxt "p.ui"
msgid "More barbed spikes become lodged in your body."
msgstr "更多带倒刺的尖刺扎进了你的身体。"

msgctxt "p.ui"
msgid "You are blinded for an even longer time."
msgstr "你的失明时间延长了。"

msgctxt "p.ui"
msgid "You are blinded!"
msgstr "你失明了！"

msgctxt "p.ui"
msgid "You recover from your berserk rage."
msgstr "你从狂暴中恢复了。"

msgctxt "p.ui"
msgid "Your stasis prevents you from being hasted."
msgstr "你的稳态阻止了加速。"

msgctxt "p.ui"
msgid "You already have as much speed as you can handle."
msgstr "你的速度已经达到所能承受的极限。"

msgctxt "p.ui"
msgid "You feel as though your hastened speed will last longer."
msgstr "你感觉疾速将持续更久。"

msgctxt "p.ui"
msgid "Your extra speed is starting to run out."
msgstr "你的额外速度开始消退。"

msgctxt "p.ui"
msgid "You feel less invigorated."
msgstr "你感觉不再那么振奋。"

msgctxt "p.ui"
msgid "The frozen ramparts melt away."
msgstr "冰霜壁垒融化了。"

msgctxt "p.ui"
msgid "Your tail turns into legs as you fly out of the water."
msgstr "你飞离水面，尾巴变回了双腿。"

msgctxt "p.ui"
msgid "You swoop lightly up into the air."
msgstr "你轻盈地飞上了天空。"

msgctxt "p.ui"
msgid "You fly up into the air."
msgstr "你飞上了天空。"

msgctxt "p.ui"
msgid "You float gracefully downwards."
msgstr "你优雅地向下飘落。"

msgctxt "p.ui"
msgid "You resist the pull of the Abyss."
msgstr "你抵抗了深渊的拉扯。"

msgctxt "p.ui"
msgid "You wobble for a moment."
msgstr "你摇晃了一下。"

msgctxt "p.ui"
msgid "Your stasis prevents you from being paralysed."
msgstr "你的稳态阻止了麻痹。"

msgctxt "p.ui"
msgid "You shrug off the repeated attempt to disable you."
msgstr "你抵御了再次使你失去行动能力的企图。"

msgctxt "p.ui"
msgid "You suddenly lose the ability to move!"
msgstr "你突然无法动弹了！"

msgctxt "p.ui"
msgid "Your divine stamina protects you from petrification!"
msgstr "你的神圣耐力保护你免于石化！"

msgctxt "p.ui"
msgid "You are slowing down."
msgstr "你的动作正在变慢。"

msgctxt "p.ui"
msgid "You have turned to stone."
msgstr "你变成了石头。"

msgctxt "p.ui"
msgid "Your clarity of mind shields you."
msgstr "清醒的头脑保护了你。"

msgctxt "p.ui"
msgid "You feel overwhelmed by frustration!"
msgstr "挫败感将你淹没！"

msgctxt "p.ui"
msgid "Your divine stamina protects you from disease!"
msgstr "你的神圣耐力保护你免于疾病！"

msgctxt "p.ui"
msgid "You feel ill."
msgstr "你感觉身体不适。"

msgctxt "p.ui"
msgid "You glow brighter."
msgstr "你身上的光芒更亮了。"

msgctxt "p.ui"
msgid "You are outlined in light."
msgstr "光芒勾勒出你的轮廓。"

msgctxt "p.ui"
msgid "You feel strangely conspicuous."
msgstr "你感觉自己莫名地显眼。"

msgctxt "p.ui"
msgid "Doom befalls you...."
msgstr "厄运降临在你身上……"

msgctxt "p.ui"
msgid "You shrug off repeated attempt to disable you."
msgstr "你抵御了再次使你失去行动能力的企图。"

msgctxt "p.ui"
msgid "You can't fall asleep in your current state!"
msgstr "你当前的状态无法入睡！"

msgctxt "p.ui"
msgid "You fall asleep."
msgstr "你睡着了。"

msgctxt "p.ui"
msgid "You wake up."
msgstr "你醒来了。"

msgctxt "p.ui"
msgid "You snap out of your daze."
msgstr "你从恍惚中清醒过来。"

msgctxt "p.ui"
msgid "Your tunneler's instincts keep you from falling into a shaft!"
msgstr "你的掘地本能让你免于坠入竖井！"

msgctxt "p.ui"
msgid "Yredelemnul refuses to let your conquest be stopped by a trick of the earth!"
msgstr "伊莱德莱姆努尔不容许大地的诡计阻止你的征服！"

msgctxt "p.ui"
msgid "You can't shaft yourself in your current form."
msgstr "你当前的形态无法自行挖掘竖井。"

msgctxt "p.ui"
msgid "You can't shaft yourself while unable to move."
msgstr "无法移动时，你不能自行挖掘竖井。"

msgctxt "p.ui"
msgid "You can't shaft yourself on this level."
msgstr "你无法在这一层自行挖掘竖井。"

msgctxt "p.ui"
msgid "You can't shaft yourself on this terrain."
msgstr "你无法在这种地形上自行挖掘竖井。"

msgctxt "p.ui"
msgid "A shaft appears beneath you!"
msgstr "一道竖井出现在你的脚下！"

msgctxt "p.ui"
msgid "The mark upon you grows brighter."
msgstr "你身上的标记变得更亮了。"

