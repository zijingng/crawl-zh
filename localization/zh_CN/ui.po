#, c-format
msgctxt "log.monster"
msgid "%s shudders."
msgstr "%s颤抖了一下。"

#, c-format
msgctxt "log.monster"
msgid "%s radiates an aura of fear!"
msgstr "%s散发出恐惧灵气！"

#, c-format
msgctxt "log.monster"
msgid "%s looks frightened!"
msgstr "%s看起来受到了惊吓！"

#, c-format
msgctxt "log.monster"
msgid "%s blinks into view!"
msgstr "%s闪现到视野中！"

#, c-format
msgctxt "log.monster"
msgid "%s is compelled to serve!"
msgstr "%s被强迫效力！"

#, c-format
msgctxt "log.monster"
msgid "%s's movement is quickened by the wind!"
msgstr "%s的行动因风而加速！"

#, c-format
msgctxt "log.monster"
msgid "%s's surroundings become eerily quiet."
msgstr "%s的周围变得诡异地安静。"

#, c-format
msgctxt "log.monster"
msgid "%s radiates an aura of cold."
msgstr "%s散发出寒冷灵气。"

#, c-format
msgctxt "log.monster"
msgid "%s shimmers and seems to become two!"
msgstr "%s闪烁着仿佛一分为二！"

#, c-format
msgctxt "log.monster"
msgid "%s begins deflecting missiles!"
msgstr "%s开始偏转投射物！"

#, c-format
msgctxt "log.monster"
msgid "%s channels a blast of cleansing flame!"
msgstr "%s引导出一道净化之焰冲击！"

#, c-format
msgctxt "log.monster"
msgid "%s binds the souls of nearby monsters."
msgstr "%s束缚了附近怪物的灵魂。"

#, c-format
msgctxt "log.monster"
msgid "%s launches a sporangium."
msgstr "%s发射了一枚孢子囊。"

#, c-format
msgctxt "log.monster"
msgid "%s curls into a ball and begins rolling!"
msgstr "%s蜷成一团，开始翻滚！"

#, c-format
msgctxt "log.monster"
msgid "%s is surrounded by blessed fire!"
msgstr "%s被神圣火焰包围！"

msgctxt "log.projectile.name"
msgid "noxious fumes"
msgstr "恶臭烟雾"

msgctxt "log.projectile.name"
msgid "blast of poison"
msgstr "毒素冲击"

msgctxt "log.projectile.name"
msgid "bolt of devastation"
msgstr "毁灭箭"

msgctxt "log.projectile.name"
msgid "doom bolt"
msgstr "厄运箭"

msgctxt "log.projectile.name"
msgid "bolt of flesh"
msgstr "血肉箭"

msgctxt "log.projectile.name"
msgid "surge of chaos"
msgstr "混沌涌流"

msgctxt "log.projectile.name"
msgid "spray of metal splinters"
msgstr "金属碎片喷流"

msgctxt "log.projectile.name"
msgid "crystallising shot"
msgstr "结晶射击"

