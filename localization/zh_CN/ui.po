msgid "The sign of ruin forms upon you!"
msgstr "毁灭征兆出现在你身上！"

#, c-format
msgctxt "log.monster"
msgid "%s is enveloped in gloom."
msgstr "%s被幽暗笼罩了。"

#, c-format
msgctxt "log.god"
