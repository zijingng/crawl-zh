msgid "You feel numb."
msgstr "你感到麻木。"

msgctxt "d.curse"
msgid "Strange energies run through your body."
msgstr "奇异的能量流遍你的身体。"

msgctxt "d.curse"
msgid "You shiver with cold."
msgstr "你冷得直发抖。"

msgctxt "d.curse"
msgid "You sense a malignant aura."
msgstr "你感到一股恶毒的气息。"

msgctxt "d.curse"
msgid "You feel very uncomfortable."
msgstr "你感到非常不适。"

msgctxt "d.curse"
msgid "Something just walked over your grave. No, really!"
msgstr "有什么东西刚刚走过你的坟墓。不，是真的！"

