  "terminology_revisions": [
    {
      "source": "descript/backgrounds.txt",
      "key": "Warper",
      "previous_reviewed_chinese": "位移术士起始携带自选武器、闪现卷轴和离散飞镖，法术库中还有一些位移系法术。\n",
      "reviewed_chinese": "位移术士起始携带自选武器、闪烁卷轴和离散飞镖，法术库中还有一些位移系法术。\n",
      "reason": "统一术语表：willpower=意志，blink=闪烁。"
    },
    {
      "source": "descript/skills.txt",
      "key": "Dodging",
      "previous_reviewed_chinese": "闪避技能影响躲开攻击的几率，无论是近战、远程还是魔法攻击。但某些攻击无法闪避，例如附魔效果（必须靠意志力抵抗）和爆炸。\n",
      "reviewed_chinese": "闪避技能影响躲开攻击的几率，无论是近战、远程还是魔法攻击。但某些攻击无法闪避，例如附魔效果（必须靠意志抵抗）和爆炸。\n",
      "reason": "统一术语表：willpower=意志，blink=闪烁。"
    },
    {
      "source": "descript/skills.txt",
      "key": "Hexes",
      "previous_reviewed_chinese": "妖术系魔法试图对附近的事物施加各种附魔效果。虽然不直接造成伤害，但中招的对手可能完全失去战斗力；不过，这类法术往往必须克服对手的意志力才能生效。精通妖术系魔法有助于克服这种抵抗。\n\n精通妖术系魔法能提高该流派法术的成功率和法术强度。许多法术同时属于多个流派，此时施法成功率和法术强度取决于这些流派技能的平均值。\n",
