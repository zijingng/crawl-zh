msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:winding a clockwork bee monstatus"
msgid "This creature is preparing to launch a clockwork bee and must focus on this\ntask for several turns. Most effects that would prevent this creature from\ncasting spells will also interrupt this process.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:withering away monstatus"
msgid "This creature will die in a few turns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:low-tier stab monstatus"
msgid "<blue>Melee attacks you make against this creature have a chance (proportional to\nyour stealth and weapon skill) of catching it off-guard and dealing\nincreased damage, especially if made with a short blade.</blue>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:high-tier stab monstatus"
msgid "<blue>Melee attacks you make against this creature will deal greatly increased damage,\nespecially if made with a short blade.</blue>\n"
msgstr ""

