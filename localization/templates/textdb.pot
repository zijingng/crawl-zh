msgctxt "textdb:descript/quotes.txt:amulet of magic regeneration"
msgid "<amulet>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:amulet of reflection"
msgid "<amulet>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:amulet of regeneration"
