msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:unable to see you monstatus"
msgid "This creature is unable to see you because you are invisible. Its accuracy\nagainst you is greatly decreased, it cannot make attacks of opportunity, and\nspells it casts may sometimes be aimed at the wrong locations.\n\nIt may also stumble around and eventually lose track of you, especially if it\nhas low intelligence.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:unable to translocate monstatus"
