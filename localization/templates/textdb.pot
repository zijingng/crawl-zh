#: crawl-ref/source/dat/database/godname.txt
msgctxt "textdb:database/godname.txt:xom lastname"
msgid "w:280\nXom of Chaos\n\nw:20\nXom the Chaotic\n\nw:5\nXom the Random\n\nw:5\nXom the Random Number God\n\nw:5\nXom the Elder Chaos God\n\nXom the Tricky\n\nw:5\nXom the Less-Predictable\n\nw:5\nXom the Unpredictable\n\nXom of Many Doors\n\nXom the Capricious\n\nw:5\nXom of Bloodstained Whimsey\n\nw:5\nXom of Enforced Whimsey\n\nXom of Bone-Dry Humour\n\nw:5\nXom of Malevolent Giggling\n\nw:5\nXom of Malicious Giggling\n\nw:2\nXom of Gnomic Intent\n\nw:2\nXom of Ineffable Intent\n\nw:2\nXom of Fickle Intent\n\nw:2\nXom of Swiftly Tilting Intent\n\nw:2\nXom of Unknown Intent\n\nXom the Fickle\n\nXom of Unknown Intention\n\nw:4\nThe Xom-Meister\n\nw:2\nThe Xom-Meister, Xom-a-lom-a-ding-dong\n\nw:2\nThe Xom-Meister, Xom-o-Rama\n\nw:2\nThe Xom-Meister, Xom-Xom-bo-Bom, Banana-Fana-fo-Fom\n\nw:5\nXom the Begetter of Turbulence\n\nw:5\nXom the Begetter of Discontinuities\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:singing sword"
msgid "An enchanted blade which loves nothing more than to sing to its owner, whether\nthey want it to or not.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:sulking sword"
msgid "<Singing Sword>\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:screaming sword"
msgid "<Singing Sword>\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:wrath of trog"
msgid "A bloodstained axe that was the favourite weapon of the old god Trog, before it\nwas lost. It induces a bloodthirsty berserker rage when used in battle, although\nmere mortals who wield it will find themselves temporarily overwhelmed by Trog's\npower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:mace of variability"
msgid "A large mace said to have appeared when Xom grew bored with the predictability\nof more ordinary instruments of chaos.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:glaive of prune"
msgid "The glaive of Prune carries a terrible and insidious curse. Unless its wielder\nmaintains firm self-control, they are doomed to undergo a horrifying (albeit\ntemporary) transformation. This is normally trivial to resist, but incapacitated\nwielders are certain to succumb, finding themselves nightmarishly purple, squishy,\nand delicious. They can take comfort in learning that it's surprisingly hard to\ninjure a giant prune.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:staff of olgreb"
msgid "A staff which was once wielded by the great alchemist Olgreb.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:crystal ball of wucad mu"
msgid "A sphere of flawless crystal, shaped by countless mantras. When one focuses upon\nit, the boundaries between 'self' and 'other' sometimes seem to blur.\n{{\n    if you.race() == \"Djinni\" then\n        return \"It is utterly useless to Djinn.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:vampire's tooth"
msgid "An ivory-like quick blade that looks like it could have been crafted from the\ntooth of some enormous predatory creature. It is lethally vampiric.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:scythe of curses"
msgid "A scythe surrounded by an ominous aura of dread. It carries a terrible and\nancient curse, which it busily inflicts on both the wielder and their enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:sceptre of torment"
msgid "An accursed bone sceptre, created by some unknown hellish power. When used in\ncombat, it causes agonising pain in all those unfortunate enough to gaze upon\nit, save for the wielder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:sword of cerebov"
msgid "A twisted blade, covered in eerie flames. Its demonic power burns away at the\nvery essence of those it is wielded against.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:orb of dispater"
msgid "An orb pulsing with unholy energies, granting the power to unleash damnation\nwhen held — although not without draining the wielder's vitality in the\nprocess. It carries with it some of the corrosive malice of the Iron City of\nDis.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:sceptre of asmodeus"
msgid "A bright ruby sceptre, carrying some of the powers of the arch-fiend Asmodeus.\nIt may call forth fiery demons from their infernal home to do the wielder's\nbidding.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:faerie dragon scales"
msgid "An enchanted suit of armour created from the scales of a rare breed of dragon,\nnow thought to be extinct. This prized relic is now one of the last proofs that\nthe vividly coloured faerie dragons ever existed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:demon blade \"bloodbane\""
msgid "A blade forged in Hell by the sacrifice of countless tortured souls. It\ninflicts the rage and suffering of those souls upon its wielder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:scimitar of flaming death"
msgid "A scimitar with a mysteriously smoking blade. Occasionally its heat leaks out,\ncovering opponents in magical flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:eveningstar \"brilliance\""
msgid "Soon after falling, Yredelemnul attempted to twist holy energy into a dark\nmockery of itself, turning it against its progenitors and weakening it against\nundead and demons. It was discovered too late that such a complete perversion\nwas uncontrollable; the foul flame destabilised or destroyed everything it was\ninfused into, except for several demonic test subjects and one stolen holy\nweapon. A lesser, and more stable, version of the dark energy proved more\nworkable, and became Yredelemnul's umbra.\n\nThis is that weapon: an eveningstar with its light long fled, despite its name,\nand a shadow that repulses those its light used to comfort...\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:demon blade \"leech\""
msgid "A blade forged in Hell by the sacrifice of countless tortured souls. It fills\nits wielder with the rage and suffering of those souls, and gorges itself\nfurther on drained life force every time it strikes, leaving behind a mess of\nblood and gore.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:dagger of chilly death"
msgid "A dagger made of one huge shard of sapphire. It covers opponents in ice,\nslowing down their movement somewhat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:dagger \"morg\""
msgid "An ugly rusty dagger. Many years ago it was the property of a powerful mage\ncalled Boris. He got lost in the Dungeon while seeking the Orb.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:scythe \"finisher\""
msgid "A long and exceedingly sharp scythe, capable of eviscerating in a single blow.\nIts extraordinary speed is the work of a mad wizard, who spent years refining\nit before discarding it in a fit of rage.\n\nThe blade looses a low keen as it cuts through the air.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:greatsling \"punk\""
msgid "A sling made of weird green leather, oozing corrosive slime. Originally the\nweapon of a notorious mischief-maker and general scamp, it's since fallen into\nless savoury hands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:longbow \"zephyr\""
msgid "This bow was woven from the air itself by Eiolaiphi the air mage as a gift for\none of the children of Uskayaw. The bow can be pulled with incredible speed,\nand it launches swift and true. It is also nearly indestructible, which is\nfortunate given that the original owner was ripped to pieces by jealous\ncelebrants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:giant club \"skullcrusher\""
msgid "A massive enchanted cudgel that augments the already considerable strength of\nanyone mighty enough to wield it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:glaive of the guard"
msgid "A glaive commissioned several years ago by a wealthy queen fearful for the\nsafety of her vast treasury. No foe, the smith promised, could defeat a guard\nwielding such a weapon!\n\nIt was stolen a few months later, along with the rest of the queen's treasury;\nthe guard, it transpired, had been caught napping. Still, it should serve more\nthan adequately in the hands of a waking user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:zealot's sword"
msgid "A sword made of one huge piece of crystal. Legend says it was the Shining One's\ngift to a worshipper. This blade is notorious for inducing bloodthirsty rage in\nboth the wielder and all of their followers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:arbalest \"damnation\""
msgid "An unholy crossbow, forged in the fires of Gehenna. It imbues the bolts it\nfires with the raw power of its namesake. Thankfully, the blasts this weapon\nproduces never harm the one firing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:sword of the dread knight"
msgid "An adamantine great sword. Its first wielder was a worshipper of Yredelemnul\nwho eschewed the use of magic in combat, preferring to destroy her enemies with\nbrute force. Unfortunately for her, not all of her opponents shared her\nlimitations.\n\nIt has felled countless great warriors under her grip, and the souls of those\nwho had their lives taken beckon it to take even more under its new owner.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:morningstar \"eos\""
msgid "A jewelled morningstar, glowing brightly with the light of the dawn. It\nilluminates the dungeon's recesses, revealing the machinations of those who\nwould prefer to stay invisible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:spear of the botono"
msgid "A dark and malign artefact. It increases the potency of hexes cast by anyone\nunwise enough to risk wielding it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:trident of the octopus king"
msgid "A trident stolen many years ago from the Octopus King's garden. Luckily, he\nseems to be in no hurry to get it back.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:mithril axe \"arga\""
msgid "A beautiful mithril axe, probably lost by some dwarven hero.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:elemental staff"
msgid "A powerful staff which used to belong to the leader of the Guild of Five\nElements. It is imbued with protective and offensive enhancements from all\nthe elemental schools of magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:heavy crossbow \"sniper\""
msgid "The sacred weapon of Toth-Mos, first apostle of the god Ashenzari. It grants\nthe wielder a fraction of Ashenzari's own vision, ensuring that every shot will\nland true.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:longbow \"piercer\""
msgid "An exceptionally large metal longbow.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:blowgun of the assassin"
msgid "This blowgun seems to guide the needle to seek the most lethal point to hit\nthe target, packing a nasty punch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:lance \"wyrmbane\""
msgid "An enchanted lance deadly to all dragonkind. It grows more powerful every time\nit inflicts a killing blow on a strong dragon. The more powerful it grows, the\nharder it will be to find a worthy opponent.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:spriggan's knife"
msgid "A dainty little knife which was made by Spriggans, or for Spriggans, or\npossibly from Spriggans. Anyway, it's in some way associated with those fey\nfolk.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:plutonium sword"
msgid "A triple sword made of weird glowing metal. It irradiates those it strikes,\ncausing a range of unpredictable effects — if they survive the impact of the\nblade itself, that is.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:great mace \"undeadhunter\""
msgid "A weapon imbued with magic to disrupt and destroy the forces binding undead\ncreatures together. Legends say that, long ago, a lich lord created many\nsuch weapons to ensure the loyalty of his undead servants. Sadly, this mace\nmight be the last one left.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:whip \"snakebite\""
msgid "A double-ended whip made from the cured hides of black mambas, and enchanted\nwith toxins ranging from ordinary venoms to asphyxiating curare.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:knife of accuracy"
msgid "It is almost unerringly accurate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:lehudib's crystal spear"
msgid "Presumably this relic led to the invention of the famous spell, or maybe the\nother way around.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:captain's cutlass"
msgid "An infamous weapon, once used by a vile pirate captain to slaughter countless\ninnocents. He finally met his destiny when a kraken swallowed his ship, and the\ncutlass was thought to be lost with him.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:storm bow"
msgid "A longbow with the colour of dark rain clouds that fires arrows like lightning.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:tower shield of ignorance"
msgid "A shield unearthed from the remains of a ruined city. It bears an inscription\nwritten in an ancient language. Scholars and wise men laboured for countless\nhours to decipher it, and in time, a translation was finally settled on:\n\n\"With a shield like this, who needs to think?\"\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:robe of augmentation"
msgid "A variegated robe, woven with enchantments to enhance the wearer's physical and\nmental abilities. Its creators wove in strands of hair from a hundred different\nanimals, each chosen for the unique strengths it could grant the robe's wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:cloak of the thief"
msgid "A pitch-black cloak which allows its wearer to excel in the arts of thievery.\nEven the clumsy will find their footsteps softer and the shouts of their\nadversaries less attention-getting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:tower shield \"bullseye\""
msgid "Just in case you had trouble getting hit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:crown of dyrovepreva"
msgid "A large circlet of dull bronze, set with a dazzling array of gemstones. It was\nfirst worn by a prince of the Titans, who sought protection from the incessant\nwarfare between his fellow princes. In practice, the main effect of the\nartefact was to unite his rivals against him.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hat of the bear spirit"
msgid "A fur hat once owned by Ukta, a powerful ogre shaman. It houses the spirit of\nan especially mighty bear, whose rages devastated the ogres until it was slain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:robe of misfortune"
msgid "A splendid flowing robe of fur and silk whose lucky colour has faded.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:cloak of flash"
msgid "A cloak that twitches and jerks without any intervention.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hood of the assassin"
msgid "A soft hood, enchanted by members of the Assassin's Guild to allow the wearer\nto sense potential victims nearby, and to easily spot vulnerabilities after\nclosing in on them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:lear's hauberk"
msgid "A well-made golden hauberk that covers all of its wearer's body parts. It\nincludes a chainmail coif, chausses and maille gauntlets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:skin of zhor"
msgid "The {{\n    if you.can_smell() then\n        return \"smelly \"\n    end\n}}skin of some strange animal, native to cold and distant lands. It radiates\nthe chill of its native habitat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:salamander hide armour"
msgid "Most salamanders' bodies are consigned to the fiery depths from which they\nsprang. Rarely, though, salamanders instead preserve the skins of those that\npassed. The runes and decorations on this hide suggest it once belonged to a\nrespected warrior or priest - perhaps even a king. The fiery spirit remains in\nthe skin, granting its power to the wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:gauntlets of war"
msgid "A pair of thick steel gauntlets. They were Okawaru's reward for a mighty\nwarlord. The owner is destined to die in battle, but what a death it will be!\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:shield of resistance"
msgid "A bronze shield, looking almost exactly like a tortoise's shell. It was built\nby the adherents of an obscure minor faith, who imbued it with the power of\ntheir god. As the god is said to, this shield protects against sword and sling,\nfrost and flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:robe of folly"
msgid "A dull grey robe. It is enchanted to provide mages with immeasurable power,\nand more than a little overconfidence...\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:maxwell's patent armour"
msgid "A suit of armour created by the famous inventor Maxwell, providing unparalleled\nprotective qualities at a very affordable price. His unorthodox materials left\nit with certain shortcomings, but he's yet to have anyone come back for a\nrefund.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:mask of the dragon"
msgid "The mask of the High Priest of ancient Erebora. In ancient times, the gods of\nthe Ereborans ceased to answer their prayers, and in desperation, the people\nturned to the forbidden worship of dragons. Now, of their works, only this mask\nremains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:robe of night"
msgid "A long black robe made of strange glossy material. It shrouds its wearer in\ndarkness, reducing the range of vision. According to legend, it was the gift\nof Rutra, a renowned demigoddess of the night, to one of her followers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:scales of the dragon king"
msgid "A suit of armour created from the enchanted scales of a once-mighty king of\ndragons. In his time, titans and lesser dragons struggled with him in vain —\nbut as with all things, even he was eventually cast down and undone. Of his\nlife and deeds, this is all that remains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hat of the alchemist"
msgid "A dirty hat. It bears signs of surviving many weird explosions, which suggests\nit may have means of protecting the head inside from the risks involved with\nalchemy experiments.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:fencer's gloves"
msgid "A pair of gloves made of white silk.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:cloak of starlight"
msgid "A phosphorescent cloak, woven of pure light beams. The ripples of its folds\nas the wearer leaps and swerves in combat may dazzle those who gaze on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:ratskin cloak"
msgid "A cloak stitched from the hides of hundreds of hell rats by an enchantress with\nfar too much time on her hands. Many more rats remain somehow concealed within\nit, and may scurry out to assist the wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:shield of the gong"
msgid "A heavy bronze gong that can be worn as a shield. Locked away in a temple for\nmany years, its bearer is shielded by decades of accumulated prayer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:amulet of the air"
msgid "A sky-blue amulet, suffused with enchantments that protect the wearer and make\ntheir Air spells more powerful. Its creator lacked just one thing: a steady\nhand.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:ring of shadows"
msgid "A black ring that can make its wearer one with the shadows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:amulet of cekugob"
msgid "A strange-looking piece of crystal on an ordinary-looking string, with an odd\nselection of powers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:amulet of the four winds"
msgid "A pendant made of purest jade. It grants its wearer immense willpower and\nmental fortitude.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:necklace of bloodlust"
msgid "A necklace made of bloodstained human and animal teeth, and something that\nappears to be a piece of spine.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:ring of the hare"
msgid "An unadorned malachite ring, half of an ancient pair. Its wearer is\nexceptionally difficult to catch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:ring of the tortoise"
msgid "A rough-hewn aquamarine ring, half of an ancient pair. Its wearer is\nexceptionally difficult to harm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:ring of the mage"
msgid "An enchanted sapphire, inset into a ring. It aids the spellcasting of its\nwearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:brooch of shielding"
msgid "A brooch with an intricate inlaid design, providing a range of magical\nprotections. Back in the good old days, every adventurer had one of these handy\ndevices. That, and a pony.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:robe of clouds"
msgid "A robe of a material as nebulous and insubstantial as the clouds. It whips the\nair around it up into a furious storm as it ripples and swirls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hat of pondering"
msgid "The favourite hat of the slug wizard Gastronok, stained with reddish slime and\nenchanted to aid in his arcane pondering. It has been specially enchanted to\nprotect against the desiccating effects of salt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:obsidian axe"
msgid "An axe with a powerful curse placed on it by one of the lords of Pandemonium,\nso that unsuspecting adventurers would unleash demons into this world. Beware,\nfor it has ways of taking its wielder under its command...\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:consecrated labrys"
msgid "An axe with a delicate blessing placed on it by one of the sacred Seraphim,\nso that worthy adventurers would rid this world of demons. Rejoice, for it has\nways of bringing courage to its wielder in even the darkest places...\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:lightning scales"
msgid "A set of armoured plates assembled to protect a creature with a long, scaly\nlower body. Faintly crackling with electricity, they supercharge their wearer's\nability to cover distance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:black knight's barding"
msgid "A heavy barding made from pitch-black steel and inlaid with plates of black\ndiamond. It once protected the steed of the Black Knight during their reign of\nterror. Those who wear it become partially undead, gaining some of the benefits\nwithout the unfortunate downsides, although the great weight of metal and stone\nslows the wearer somewhat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:amulet of vitality"
msgid "A jewelled amulet famed for its powers of resilience and recuperation. Its\ngreatest notoriety came from its use by the dread necromancer Borgnjor, who\nrelied upon it to maintain her slender hold on life. After her final demise,\nthe amulet vanished from the pages of history.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:autumn katana"
msgid "An exquisitely crafted sword. Its blade is so sharp that it can cut through\nspace itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:shillelagh \"devastator\""
msgid "A wooden cudgel, loaded with more than just lead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:dragonskin cloak"
msgid "An opalescent cloak gleaming with the colours of all kinds of dragons. It\nimbues the wearer with draconic resistances, although somewhat unreliably.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:ring of the octopus king"
msgid "One of the eight rings once worn by the Octopus King and now scattered across\nthe land. Each has its own unique enchantment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:axe of woe"
msgid "As you hold this axe your mind does not feel fully your own. Your body begins\nto exhibit strength far beyond its capabilities, and your movements become\nguided by Makhleb.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:moon troll leather armour"
msgid "A suit of armour rumoured to have been created by enchanting the hide of a\nnow-extinct species of troll. Whether the name rings true or is merely\nappropriated to add mystique is something of a mystery. The armour's innate\npowers of regeneration and magical protection, however, are hard to dispute.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:macabre finger necklace"
msgid "An ugly dangling finger on a string. Everything about it reeks of malign\ninfluences... but it's hard to avoid thinking that it would look better with a\nring on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:boots of the spider"
msgid "A novel pair of boots invented by a suitor of Arachne.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:dark maul"
msgid "A large, iron-shod maul specialised for dealing massively powerful blows. Such\npower comes at a price: the maul's head is so heavy it takes a great length of\ntime to lift it up for another swing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hat of the high council"
msgid "A relic of some ancient wizarding war. Centuries later, it still crackles with\neffects from the residual hexes and magical energies it was once subjected to\non a daily basis; spellcasters able to get a handle on its power, however, will\nfind it enhances the power of their spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:arc blade"
msgid "A blade somehow crafted from pure electricity. It arcs wildly between the\nwielder and their foes as it strikes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:demon whip \"spellbinder\""
msgid "A weapon said to have once been used to keep unruly imprisoned wizards in line;\nit violently disrupts the flow of magic around it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:lajatang of order"
msgid "A silver-bladed lajatang, once bestowed upon a favoured worshipper of Zin. It\nbecame the most prized weapon of the many priests of Zin. After their order was\ndestroyed, it fell into disuse and vanished from history.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:great mace \"firestarter\""
msgid "A huge mace imbued with potent fire magic. It fills those it strikes with an\ninner flame, and offers some protection against the resulting devastation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:orange crystal plate armour"
msgid "A suit of armour carved from transparent orange crystal. It provides remarkable\nprotection for both mind and body. The wearer can even channel psychic energies\nthrough the crystal itself, enhancing their magical abilities. However, it's\nrather heavy...\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:majin-bo"
msgid "A staff inhabited by a mighty demon, tricked and trapped in this form long ago.\nTo survive, she now offers great arcane power in a terrible bargain: in\nexchange for a tiny portion of the caster's life essence, taken every time its\nwielder casts a spell, she will redirect the life essence of creatures damaged\nby the spell to the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:pair of quick blades \"gyre\" and \"gimble\""
msgid "Two quick blades joined by a chain. Swinging one compels the wielder to swing\nthe other, as if they have minds of their own.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:maxwell's etheric cage"
msgid "A fine mesh cage designed to capture magical energy. Experimental notes suggest\nthat research was abandoned when the cage began to capture magical\ncontamination almost as effectively. Anyone reckless enough to place it on\ntheir head would find their magic regeneration dramatically increased, at the\ncost of multiplying any magical contamination received.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:crown of eternal torment"
msgid "A gold crown set with jet-black gems. It permanently afflicts its wearer with\nagonising pain, substantially reducing their resilience but rendering them\nimmune to further torments.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:robe of vines"
msgid "A robe woven of living vines. The vines form a symbiotic relationship with\ntheir wearer, greatly increasing their regeneration, but preventing them from\nbeing healed by potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:kryia's mail coat"
msgid "A coat of armour said to have been forged for Queen Kryia in her old age. She\ncontinued to insist on leading her armies from the front even into her dotage,\nand as her aging body failed her, this coat helped to enhance the healing\ndraughts that kept her alive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:frozen axe \"frostbite\""
msgid "A massive axe that looks like it was carved from a glacier, or possibly calved\nfrom one. It leaves ice crystals in its wake as it swings through the air.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:armour of talos"
msgid "A huge and weighty suit of bronze plate armour. Only one with a correspondingly\nhuge body can wear it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:warlock's mirror"
msgid "A handheld array of hexagonal mirrors, synthesised from a truly exotic\nsubstance and polished to a blinding sheen.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:amulet of invisibility"
msgid "An amulet that can be activated to render its wearer invisible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:scarf of invisibility"
msgid "A scarf that can be activated to render its wearer invisible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:maxwell's thermic engine"
msgid "A strange sword, one blade blistering hot and the other icy cold. When it hits\nits target the thermal gradient increases. What causes this effect is unknown\nbut it is rumoured that otherworldly forces are involved.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:demon trident \"rift\""
msgid "A small wrinkle in the very fabric of reality, magically bound to a shaft by\nsome mad acolyte of Lugonu. Its attacks can warp through nearby space at the\nwielder's command.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:sphere of battle"
msgid "An orb encased in vividly coloured scales, wrought by a long-forgotten wizard.\nIt was the mage Iskenderun's favourite playtoy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:cigotuvi's embrace"
msgid "A suit of armour borne of rotten flesh and bone and gristle, held intact by the\nwill of a long-dead sorcerer. The dreadful energies within it call to the bodies\nof the recently dead, protecting the wearer with a cocoon of carrion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:seven-league boots"
msgid "An enchanted pair of boots which grant the ability to take strides of incredible\nlength, as long as the wearer is advancing bravely towards their foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:mad mage's maulers"
msgid "A pair of gloves designed to carefully control and channel the flow of magic,\nlater misused and mangled by the lunatic murderer-mages of the Fifth Circle.\nTheir influence leaves the wearer utterly unable to cast spells - the wearer's\nmagic is redirected to far bloodier purposes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:dreamdust necklace"
msgid "A dull dusty mixture trapped within a cracked crystal on a thin silver chain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:dreamshard necklace"
msgid "A beautiful rainbow of colour and motion trapped within a delicate crystal on a\nthin silver chain. Listening carefully, one can hear the distant echo of a\nthousand dreams from all corners of reality, their melody giving a warm sense\nof safety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:delatra's gloves"
msgid "A pair of long ultramarine gloves, worn by a famed experimental alchemist in an\nage long past. They channel the energy of discovery, empowering their wearer with\nthe force created by a blind step from ignorance to certainty.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:woodcutter's axe"
msgid "A weapon that chops foes down as steadily and methodically as a forester cutting\nwood. The unchanging rhythm of its work has settled on it with the force of\nnatural law, and no amount of force or skill can make it swing faster or slower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:throatcutter"
msgid "Taken from a paladin of the Shining One by the common cutpurse who murdered her,\nThroatcutter was used for a long series of increasingly sordid deeds thereafter.\nBlood, murder and betrayal stain its history and blade both, and little trace now\nremains of the blade which once stood between danger and the innocent.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:staff of the meek"
msgid "A sacred relic of the Monks of St. Lee, followers of the renunciate archmage. Just\nas St. Lee sought to atone for the destruction his spells wrought by protecting\nothers, so his staff protects its wielder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:trishula \"condemnation\""
msgid "A weapon to bring forth guilt from the guilty. It was first wielded by the archangel\nLucriel, who, on seeing the suffering of the first mortals, led them as an army\nagainst the cruelty of the gods. The ragged survivors of Lucriel's army took this\nweapon with them into the wilderness, the sole remnant of an archangel's virtue.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:amulet of elemental vulnerability"
msgid "A blue-steel amulet. Its creator, an exceedingly practical woman, designed it to\nprovide powerful protection against mundane jabs, stabs and bites. It's worse than\nuseless against fire and frost, but how often does anyone really need to worry\nabout that?\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:mountain boots"
msgid "These sturdy boots were created by an artificer who lived high up on a remote\nmountain peak, as protection against the mountain's near-constant avalanches,\nrockslides, and snowstorms. No force short of translocations magic will budge\nthe wearer from their position.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:lochaber axe"
msgid "This brutal weapon, long thought lost to history, combines the extended reach\nof a polearm with the cleaving sharpness of an axe. Ghosts of ancient warriors\nlinger about it, draining fickle users.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hermit's pendant"
msgid "An ascetic once took a sacred vow, forswearing use of magical tools and ownership\nof everything but this pendant. Which god they made this vow to remains a point of\nbitter contention among the devout, but their pendant's power - and limitations -\nare irrefutable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:slick slippers"
msgid "Crafted from the tanned, smooth hide of a Western Skyshark, these slippers are\nastonishingly comfortable. They lack the protective benefits of a good pair of\nboots, but they can get their wearers out of almost any bind.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:force lance"
msgid "A plain iron lance, imbued with supernatural gravitas via the artifice of the\nmage Gell. It strikes with a force many times stronger than that imparted by\nthe wielder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:toga \"victory\""
msgid "An ancient artefact of Okawaru, these woolen robes were lost when a former\nchampion failed a duel. Its enchantments increase in power when the wearer\nemerges victorious from threatening combat, but resorting to the use of scrolls\nor potions for assistance causes them to fade away again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:storm queen's shield"
msgid "A disc of crackling metal, created by a woman whose cunning artifice and\ncrafty politics once united a continent. Most of her surviving inventions are\nclosely guarded by various royals, ostensible proof of their claim to be her\ntrue successor, but this early prototype slipped through their fingers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:hand cannon \"mule\""
msgid "Hand cannons use magical dust to launch projectiles. The alchemists who craft\nthem boast of their potency, but omit the smoke and noise blasted out with each\nshot. Filled with powdered blastmotes, Mule packs an especially powerful kick.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:gloves of the gadgeteer"
msgid "A pair of suede gloves covered in a dizzying array of delicate sigils. While\noriginally intended to aid in the crafting of magical devices, they are\nnonetheless useful for wringing every last drop of power out of someone else's\nwork.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:charlatan's orb"
msgid "This orb is the work of a master artificer, contracted to retrieve the orb, who\nvalued their life more than their professional integrity. While this fake\nfaithfully recreates the eerie glow and space-warping properties of the true\norb, the power it grants is artificial and only accessible to skilled evokers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:justicar's regalia"
msgid "A gleaming breastplate with a slot in its centre for a holy symbol or bejewelled\ncoat of arms. Those who hear commands given by its wearer feel filled with the\npower to carry them out, no matter the adversity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:skull of zonguldrok"
msgid "The skull of a legendary necromancer, seemingly parted from the rest of its\nbody. When held, it seems disinclined to explain the precise circumstances of\nits ending up in this state, but offers no objection to others siphoning what\nconsiderable necromantic power still remains in its ancient bones.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:fungal fisticloak"
msgid "The handiwork of a mad mycologist who once attempted to overcome the genetic\nanxiety of wandering mushrooms by cultivating a species that could be easily\ntransported without disturbing them. The result is as much a living organism as\nit is a piece of clothing, every linen fibre twined together with fungal mycelia\nthat draw both nutrients and confidence from whoever wears it. And in exchange\nfor such trifles as blood or peptides, the colony will instinctively lash out to\ndefend its wearer from whatever they perceive as a threat.\n\nIt's like wearing a thousand tiny friends at once! And the humming they fill\nyour mind with in the dark is actually quite lulling....\n\n(This item also occupies your helmet slot.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/unrand.txt
msgctxt "textdb:descript/unrand.txt:crown of vainglory"
msgid "An extravagant crown of gold filigree and glittering jewels that even a king\ncould feel immodest wearing. It grants its wearer a regal aura the match of any\nin heaven and also a great deal of unearned confidence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a faded altar of an unknown god"
msgid "An ancient altar, stripped of all identifying characteristics by the passage of\naeons. Praying at it will convert you to an unknown god, and the altar's deity\nwill greatly appreciate conversion at so ancient a site of worship.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a glowing golden altar of the shining one"
msgid "An altar to the Shining One, made from the purest gold and almost blinding in\nits radiance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken altar of ashenzari"
msgid "A crystal altar which shattered to pieces when Ashenzari was cursed. There is\nstill a great power remaining within it: a dark aura holds the shards in\nmid-explosion, suspended in time and space much like the god they herald.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a roughly hewn altar of beogh"
msgid "An altar to Beogh, unmistakably roughly hewn by orcish artisans.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a snail-covered altar of cheibriados"
msgid "A timeless altar to Cheibriados the Contemplative.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a shadowy altar of dithmenos"
msgid "An altar to Dithmenos the Shadowed. It seems to absorb light from its\nsurroundings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a white marble altar of elyvilon"
msgid "An altar to Elyvilon the Healer, made from purest white marble and topped by a\nsculpture of the Chalice of Purification.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a blossoming altar of fedhas"
msgid "An altar to Fedhas Madash, covered in vibrant and colourful plant life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an opulent altar of gozag"
msgid "A glittering golden and bejewelled altar to Gozag Ym Sagoz the Greedy, gleaming\nbrightly even in the dim dungeon light.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a hazy altar of hepliaklqana"
msgid "An altar to Hepliaklqana the Forgotten, shrouded in mist and difficult to make\nout clearly. Something about it seems terribly familiar, but it's impossible to\nsay exactly why.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a candlelit altar of ignis"
msgid "An altar to Ignis, the Dying Flame. It's completely covered in candles of all\nshapes and sizes, but only one remains alight, its slender flame wavering in the\nslightest breeze.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a viscous altar of jiyva"
msgid "A slimy, ever-shifting altar to Jiyva. You're not sure what it's made from, and\nyou don't really want to know.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ancient bone altar of kikubaaqudgha"
msgid "An altar created from piles of ancient bones, dedicated to the terrible\nDemon-God Kikubaaqudgha.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a corrupted altar of lugonu"
msgid "An altar to Lugonu the Unformed, possibly dedicated to some other power before\nit was irrevocably corrupted.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a burning altar of makhleb"
msgid "An ever-burning altar to Makhleb the Destroyer. Strange, twisting shapes are\nvisible in the flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sparkling altar of nemelex xobeh"
msgid "An altar sparkling with a lightshow brighter than any gambling den's, to\nattract followers for Nemelex Xobeh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an iron altar of okawaru"
msgid "An altar of iron and steel dedicated to the Warmaster Okawaru. Its edges are\nsurprisingly sharp.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a stormy altar of qazlal"
msgid "An altar dedicated to Qazlal Stormbringer, surrounded by fierce winds,\nelectrical discharges, puffs of fire and magma, and the occasional tremor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sacrificial altar of ru"
msgid "An altar to Ru the Awakened in the shape of a pair of scales, with a heart in\none scale and a pictogram representing power and enlightenment in the other.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a shimmering blue altar of sif muna"
msgid "An altar to Sif Muna the Loreminder, covered in intricate patterns and writings\nin long forgotten scripts. Atop a deep blue pedestal hovers a shimmering\ncondensation of pure magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a bloodstained altar of trog"
msgid "An altar to Trog the Wrathful, crudely made by what seem to be the hands of\ngiants and covered with bloodstains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a hide-covered altar of uskayaw"
msgid "An altar to Uskayaw the Reveller. It appears to be hollow and covered in a hide,\ngiving it a resonant surface. Carvings on the side depict grouped figures that\ncould be dancing or loving or fighting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a radiant altar of vehumet"
msgid "An altar, ablaze in the lights of Iskenderun and promising great destructive\npowers to those who would follow Vehumet.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ornate altar of the wu jian council"
msgid "A red and gold altar to the Wu Jian Council. Sharp slivers of steel drift\nthrough the quiet air surrounding it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a shimmering altar of xom"
msgid "An altar constantly shimmering in all visible colours, and probably some\ninvisible ones, matching the whims of Xom the Unpredictable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a basalt altar of yredelemnul"
msgid "An altar to Yredelemnul the Dark, worked from columnar basalt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a glowing silver altar of zin"
msgid "An altar to Zin the Law-Giver, made from silver as pristine as Zin's followers\nare expected to be, and glowing gently.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the endless lava"
msgid "A sea of fire and brimstone as far as the eye can see. Anyone venturing across\nit would be roasted in no time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the floor"
msgid "The floor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:some deep water"
msgid "A pool of deep water. Only giant creatures can wade through this, and only\nthose well-adapted to water can swim through it; for the rest, the only way\nthrough is to fly over.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:some lava"
msgid "An intensely hot pool of molten rock, emitting clouds of sulphurous smoke.\nNothing but the mythical salamander can cross this without flight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:some shallow water"
msgid "A pool of cloudy, waist-deep water. Those well-adapted to water can swim\nthrough it and attack normally. Non-swimmers must wade through the water slowly\nand will occasionally fail to attack in melee when wading through shallow\nwater; although large creatures are able to keep their balance, move at a\nnormal speed, and avoid fumbling.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a toxic bog"
msgid "A filthy pool of poisonous, waist-deep sludge. Wading or swimming through the\nsludge will damage and poison any creature, even those resistant to poison.\nThose well-adapted to water can swim through it and attack normally.\nNon-swimmers must wade through the water slowly and will occasionally fail to\nattack in melee when wading through shallow water; although large creatures are\nable to keep their balance, move at a normal speed, and avoid fumbling.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:some mud"
msgid "A thick layer of gritty mud. [[liquefied]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the open sea"
msgid "An expanse of endless wind and waves, with not a lighthouse in sight. Anyone\nventuring across it would be lost beyond all hope in short order.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an unnaturally hard rock wall"
msgid "A wall imbued with magic that makes it indestructible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a wall of the weird stuff which makes up pandemonium"
msgid "A wall made from the weird stuff which makes up Pandemonium. It seems to be\nlike rock in most other aspects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a crystal wall"
msgid "A wall made from polished crystal and imbued with arcane magics. They prevent\nits easy destruction, and make it reflect heat and cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a translucent rock wall"
msgid "A rock wall made from a mineral as translucent as good quality glass. Whether\nit is natural or magical, you cannot tell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a translucent stone wall"
msgid "A harder obstacle than rock walls. Only the mightiest magic can shatter stone\nwalls. It has been imbued with arcane magics which render it translucent.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a translucent unnaturally hard rock wall"
msgid "A wall imbued with magic that not only makes it indestructible but also makes\nit translucent like glass.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a stone wall"
msgid "A harder obstacle than rock walls. Only the mightiest magic can shatter stone\nwalls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a slime covered rock wall"
msgid "A rock wall coated with acidic green slime; just standing near it is enough to\ncause temporary corrosion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a metal wall"
msgid "A wall of bluish-grey metal. As every dungeon electrician knows, it will ground\neven magical bolts of lightning.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a rock wall"
msgid "A wall consisting of simple rock.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a frigid wall"
msgid "A wall that radiates a chill so intense it can damage enemies which stand next\nto it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a shop"
msgid "A shop in the dungeon, beyond sight of the world above, manned by a secretive\nand reclusive shopkeeper who cannot be bargained with, grants no refunds, and\nis interested in nothing you may have to sell. Some shops hawk antiques of\nunknown provenance, and offer little hint as to the quality or nature of their\ngoods.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a stone staircase leading down"
msgid "A staircase leading further down.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a stone staircase leading up"
msgid "A staircase leading back up.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a metal staircase leading down"
msgid "A staircase leading down to the grand vaults containing the silver rune of Zot,\nwhose wealth attracts the most powerful champions from across the Dungeon to its\ndefence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a metal staircase leading up"
msgid "A staircase leading up from the grand vaults containing the silver rune of Zot,\nwhose wealth attracts the most powerful champions from across the Dungeon to its\ndefence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a slimy stone staircase leading down"
msgid "A stone staircase leading further down.\n\n{{\n    if you.god() == \"Jiyva\" then\n        return \"It is slick with slippery slime, but that is no obstacle for one \" ..\n               \"such as yourself who has embraced the way of all slime.\"\n    else\n        return \"It is slick with slippery slime which will make it impossible \" ..\n               \"for you to climb back up again until the power ruling this place \" ..\n               \"is destroyed (or you choose to join it). However, being coated in \" ..\n               \"this slime will greatly increase your HP and MP regenaration for \" ..\n               \"short while afterward.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a slimy stone staircase leading up"
msgid "A stone staircase leading back up.\n\n{{\n    if you.god() == \"Jiyva\" then\n        return \"It is slick with slippery slime, but that is no obstacle for one \" ..\n               \"such as yourself who has embraced the way of all slime.\"\n    else\n        return \"It is slick with slippery slime, making it impossible for you to \" ..\n               \"climb until the power ruling this place is destroyed (or you choose \" ..\n               \"to join it).\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a tree"
msgid "A large tree. While in most places the dim light of the dungeon is not bright\nenough to sustain large plants, there are spots where, with the grace of\nFedhas, trees as big as those on the surface can grow underground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a mangrove"
msgid "This tree is specially adapted for growing in swampy conditions. Its vines are\ntoo thick to see through.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a demonic tree"
msgid "A tree hideously warped by the demonic forces of chaos. Despite its bizarre\nappearance and occasional, unsettling movement, it seems harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a petrified tree"
msgid "An ancient tree, long ago passed from biology into geology. While no longer\nwooden in a material sense, it retains the spiritual qualities of a tree.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an abandoned shop"
msgid "A shop that has been abandoned.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an orcish idol"
msgid "An idol of the orc god Beogh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an iron grate"
msgid "A rusted iron grate, brittle enough to be disrupted with a spell or a wand\nquite easily. It is too strong to be breakable by hand, however.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an escape hatch in the floor"
msgid "A spring-loaded one-way escape hatch set in the dungeon floor, allowing the\nadventurer beset by adversaries to exchange the perils of this level for the\nperils of the next.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an escape hatch in the ceiling"
msgid "A spring-loaded one-way escape hatch set in the ceiling.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a shaft"
msgid "A hole in the ground, leading to a dungeon level one or more floors deeper.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sealed passage leading down"
msgid "A descending passage sealed tightly by a magical barricade. It is impossible to\nclimb through it so long as the magic holds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sealed passage leading up"
msgid "An ascending passage sealed tightly by a magical barricade. It is impossible to\nclimb through it so long as the magic holds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an empty arch of ancient stone"
msgid "A stone archway that seems to lead to nowhere in particular.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a detected shop or portal"
msgid "A gateway of some kind. You cannot tell where it leads without approaching it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a passage of golubria"
msgid "An unstable gateway that allows instantaneous travel to another nearby passage\nof Golubria, and will close behind anything passing through it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a portal to somewhere"
msgid "A gash-like tear in reality that looks into some terrifying, starry otherworld.\nThankfully, the magic that opened it also prevents its vacuum from consuming\nand swallowing everything in sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a granite statue"
msgid "A stone statue whose features have long since withered away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gleaming silver wall"
msgid "A wall made of pure silver, formed by the power of Zin to temporarily imprison\na monster within its confines.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dry fountain"
msgid "A dried-up decorative fountain that has seen better days.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a fountain of clear blue water"
msgid "A decorative fountain, flowing with clear water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a fountain of blood"
msgid "A decorative fountain, spurting with foul-looking blood.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a fountain of eyes"
msgid "A decorative fountain, bubbling over with listless and unmoving eyes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a fountain of sparkling water"
msgid "A decorative fountain, flowing with brightly sparkling, faintly magic water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a cache of baked goods"
msgid "A hoard of breadstuffs, baked and fried from minor divine gifts of flour and\ngrowth cultures, granted extended shelflife through sacred succour. You already\ncarry as much food as you will ever need for this journey, but a light snack\nshouldn't hurt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a cache of fruit"
msgid "A pile of assorted fruit, ranging from common dungeon staples like chokos and\nsnozzcumbers, to rarer treats such as apples and oranges. You already carry as\nmuch food as you will ever need for this journey, but the occasional nibble\nwouldn't hurt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a cache of meat"
msgid "A stash of preserved meats of varied origins and preparations: strips of jerky,\nlumpy smoked sausages, and indeterminate protein rations. You already carry as\nmuch food as you will ever need for this journey, but this could offer the rare\nchance to try out yak...\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a runelight"
msgid "An unearthly, glittering light, floating and twisting in midair. A Rune of\nZot is surely nearby, its power overspilling to cause this spectacular sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken pillar"
msgid "A ruined and crumbled stone pillar.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a one-way staircase leading down"
msgid "A cursed staircase leading further down, imbued with magic to prevent any\nreturn back up the stairs. Adventurers taking this passage will need to find a\nreturn stairway somewhere else on the level where they arrive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a one-way staircase leading up"
msgid "A cursed staircase leading up, imbued with magic to prevent any return back\ndown the stairs. Adventurers taking this passage will need to find a return\nstairway somewhere else on the level where they arrive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the orb dais"
msgid "A raised pedestal upon which rests the fabled Orb of Zot. More ancient than even\nthe dungeon itself, it cannot be destroyed or transformed by any means.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a statue of an orb of fire"
msgid "A statue of a terrifying globe of raw primordial fire, said to dwell within the\nRealm of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a statue of an orb of winter"
msgid "A statue of a terrifying globe of uttermost cold, said to dwell within the\nRealm of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a statue of an orb of entropy"
msgid "A statue of a terrifying globe of profound nothingness, said to dwell within the\nRealm of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gate leading back out of this place"
msgid "A gate that will let you return whence you came.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gate leading out of pandemonium"
msgid "A gate leading back to the dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gate leading to another region of pandemonium"
msgid "A gate leading to yet another region of Pandemonium. There'll always be more.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a one-way gate leading to the halls of pandemonium"
msgid "A gate leading to the endless halls of Pandemonium.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the depths"
msgid "A staircase leading to the Depths.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gate to the realm of zot"
msgid "A gate leading to the Realm of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway back into the dungeon"
msgid "A gate which allows a feat popularly thought to be impossible: escaping Hell\nalive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway leading out of the abyss"
msgid "A gateway out of the Abyss, shimmering and shifting in the impermanent\nlandscape.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway leading deeper into the abyss"
msgid "A strangely calm gateway amid the roiling landscape of the Abyss. It leads\nfurther into the depths of the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to a ziggurat"
msgid "A portal leading to a ziggurat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to the ashen valley of gehenna"
msgid "A gateway leading to Gehenna.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway leading out of gehenna"
msgid "A gateway leading back to the Vestibule of Hell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to hell"
msgid "A gateway leading to the Vestibule of Hell. Few would go there voluntarily.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to the iron city of dis"
msgid "A gateway leading to the Iron City of Dis.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway leading out of dis"
msgid "<A gateway leading out of Gehenna>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to the decaying netherworld of tartarus"
msgid "A gateway leading to Tartarus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway leading out of tartarus"
msgid "<A gateway leading out of Gehenna>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to the freezing wastes of cocytus"
msgid "A gateway leading to Cocytus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway leading out of cocytus"
msgid "<A gateway leading out of Gehenna>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a hole to the spider nest"
msgid "A passage leading to the Spider Nest.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a one-way gate to the infinite horrors of the abyss"
msgid "A gateway leading to the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a crawl-hole back to the lair"
msgid "A passage leading back to the Lair of Beasts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an exit through the horrors of the abyss"
msgid "A gateway leading back to the dungeon via the madness of the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase back to the dungeon"
msgid "A staircase leading back up to the familiarity of the dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase back to the lair"
msgid "A staircase leading back up to the Lair of Beasts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase back to the mines"
msgid "A staircase leading back to the Orcish Mines.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase back to the vaults"
msgid "A staircase leading back to the Vaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase leading out of the dungeon"
msgid "This staircase leads back out of the dungeon.\n\nA staircase leading out of the dungeon. Climbing these stairs will end your\nquest, whether you carry the Orb with you or not.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase back to the crypt"
msgid "A staircase leading back to the Crypt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the crypt"
msgid "A staircase leading to the Crypt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the ecumenical temple"
msgid "A staircase leading to the Ecumenical Temple.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the elven halls"
msgid "A staircase leading to the Elven Halls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the lair"
msgid "A staircase leading to the Lair of Beasts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the orcish mines"
msgid "A staircase leading to the Orcish Mines.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the shoals"
msgid "A staircase leading to the Shoals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the slime pits"
msgid "A staircase leading to the Slime Pits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the snake pit"
msgid "A staircase leading to the Snake Pit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the swamp"
msgid "A staircase leading to the Swamp.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a staircase to the tomb"
msgid "A staircase leading to the Tomb of the Ancients.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gate to the vaults"
msgid "A gateway leading to the Vaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a transporter"
msgid "A one-way portal to another place on this level. When using a transporter,\nadjacent allies and monsters will travel with you to the other side.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a transporter landing site"
msgid "The destination site of a transporter. As the portal is one-way, you cannot use\nthis location to return back through the transporter.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an open door"
msgid "An open wooden door. If closed again, all monsters that can wield equipment,\nand some of them that can't, could open it again. If it is closed and reopened\nby a monster that is aware of you, it has a chance of breaking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a closed door"
msgid "A closed wooden door. All monsters that can wield equipment, and some of them\nthat can't, may open it again. If it is opened by a monster while it is aware\nof you, it has a chance of breaking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken door"
msgid "A disappointingly poorly maintained wooden door. It'd take nothing short of\nmagic to get this properly closed again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an open translucent door"
msgid "An open door made from magically translucent wood. If closed again, all monsters\nthat can wield equipment, and some of them that can't, could open it again. If\nit is closed and reopened by a monster that is aware of you, it has a chance of\nbreaking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a closed translucent door"
msgid "A closed door made from magically translucent wood. All monsters that can wield\nequipment, and some of them that can't, may open it again. If it is opened by a\nmonster while it is aware of you, it has a chance of breaking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken translucent door"
msgid "<A broken door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sealed door"
msgid "A door sealed tightly by arcane runes. It refuses to open for any creature not\nrecognised by its magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a runed door"
msgid "A door, covered in runic writing. It looks like there is something special\nbehind it — perhaps danger, perhaps treasure. You may break the runes by\nopening it like any other door, but creatures of the dungeon will not dare\nto try.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a runed translucent door"
msgid "A door, covered in runic writing, made from magically translucent wood. It has\nbeen created to seal away great danger or glorious treasure. You may break the\nrunes by opening it like any other door, but creatures of the dungeon will not\ndare to try.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large runed translucent door"
msgid "<A runed translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a runed translucent gate"
msgid "<A runed translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge runed translucent gate"
msgid "<A runed translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large open door"
msgid "<An open door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an open gate"
msgid "<An open door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge open gate"
msgid "<An open door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large closed door"
msgid "<A closed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a closed gate"
msgid "<A closed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge closed gate"
msgid "<A closed door>\n"
msgstr ""

