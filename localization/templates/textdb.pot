#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:mad acolyte of lugonu"
msgid "“And when you look long into an abyss, the abyss also looks into you.”\n    -Friedrich Nietzche, “Beyond Good and Evil”. 1886.\n"
msgstr ""

