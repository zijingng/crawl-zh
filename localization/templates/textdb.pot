msgid ""
msgstr ""
"Project-Id-Version: DCSS TextDB\n"
"Content-Type: text/plain; charset=UTF-8\n"

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:armataur"
msgid "Scaled mammals the size of horses, Armataurs are fast-rolling and tenacious when\npursuing enemies, but lack dexterity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:barachi"
msgid "Barachim are slow-moving, amphibious humanoids who can hop long distances.\nTheir extended range of vision also allows them to be seen from further away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:coglin"
msgid "Coglins ride enchanted exoskeletons able to wield weapons in both hands,\nwrapping slow-revving metal around their puny goblinoid frames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:deep elf"
msgid "Deep Elves have a strong affinity for all kinds of magic, but are very fragile.\nThey regenerate magical power rapidly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:demigod"
msgid "Demigods refuse to worship any god, but make up for this with divine attributes\nand high reserves of health and magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:demonspawn"
msgid "Demonspawn are half human, half demon. They acquire strong demonic mutations as\nthey grow.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:djinni"
msgid "Djinn are ever-burning spirits. They learn spells automatically as they grow,\nand cast by drawing down their own fires.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:draconian"
msgid "Draconians are versatile hybrids. They mature when reaching level 7 and develop\na colour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:formicid"
msgid "Formicids are humanoid ants adept at digging. Their limbs are exceptionally\nstrong and they live in a state of permanent stasis.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:felid"
msgid "Felids are many-lived sentient cats. They cannot use armour or weapons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:gargoyle"
msgid "Made of living stone, Gargoyles have a preternatural affinity for earth magic.\nThey have low health, but their stone bodies are incredibly tough.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:gnoll"
msgid "Gnolls are canine-like humanoids. They are unable to specialise in any single\nskill, but instead gradually become proficient in all skills at once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:human"
msgid "Humans are natural explorers. Discovering new places refreshes and invigorates them.\nThey are otherwise completely average.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:tengu"
msgid "Tengu are bird-people who love to fight, both with weapons and spells. They are\nfragile but agile, and eventually learn to fly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:kobold"
msgid "Kobolds are attuned to the shadows and can only see or be seen at a close range.\nThey are small and a little fragile, and are talented in most skills.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:merfolk"
msgid "Half fish, half human, Merfolk are citizens of both water and land. They are\nstrong combatants, and adept at using magic to assist in battle.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:minotaur"
msgid "Minotaurs are large muscular humans with bovine heads. They excel at all forms\nof close and ranged combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:mountain dwarf"
msgid "Mountain Dwarves are strong melee fighters and capable heavy-armoured casters.\nThey can use scrolls to enchant even some artefacts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:mummy"
msgid "Compelled to walk by an ancient curse, Mummies have innate faith and are adept\nat Necromancy, but learn other skills very slowly. They cannot drink potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:naga"
msgid "Nagas are hybrids: human from the waist up, with a snake-like tail instead of\nlegs. They move very slowly but are naturally resilient.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:octopode"
msgid "Octopodes are a species of amphibious cephalopods. They can wear eight rings,\nbut almost no armour fits them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:oni"
msgid "Large, robust, and extremely fond of drinking, Oni make capable brawlers and\nspellcasters and gain extra benefits from healing potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:poltergeist"
msgid "Formless ghosts who delight in hexing their enemies. They can equip many\ndifferent hats, gloves, boots, or cloaks at once, but cannot wear body armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:revenant"
msgid "Revenants are skeletal undead who are strong at melee combat and can empower\ndamage-dealing spells by consuming memories they harvest from their victims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:spriggan"
msgid "Very small, very frail and very fast, Spriggans are highly competent stabbers\nand spellcasters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:troll"
msgid "Trolls are monstrous creatures with powerful claws. They regenerate health\nrapidly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/species.txt
msgctxt "textdb:descript/species.txt:vine stalker"
msgid "Frail symbionts, Vine Stalkers cannot regain health from potions. Their magical\nreserves absorb damage, and they pack a magic-restoring bite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:air elementalist"
msgid "Air Elementalists have learned the Shock spell. Their electrical magic can harm\ngroups of foes, while their air spells assist in fighting or fleeing enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:artificer"
msgid "Artificers start with a few magic wands and a club. They'll need to find better\nweapons and armour before their wands run out.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:berserker"
msgid "Berserkers believe in Trog, the magic-hating god of frenzy. Not much can stop a\nraging berserker early on, apart from hubris.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:brigand"
msgid "Brigands carry poisoned darts and a small number of nasty curare darts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:chaos knight"
msgid "Chaos Knights are playthings of the unpredictable Xom, and are subject to the\ngod's constantly changing moods.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:cinder acolyte"
msgid "Cinder Acolytes worship Ignis, drawing upon the flame of a dying god until\nthere is nothing left. They have both melee and fire magic capabilities.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:conjurer"
msgid "Conjurers begin with the Magic Dart spell, and can learn other non-elemental\nspells to reliably blast their foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:delver"
msgid "Delvers start their quest five levels below the surface. A set of powerful magic\nitems helps them survive the dangerous journey upward.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:earth elementalist"
msgid "Earth Elementalists know the Sandblast spell, and can later learn more earthen\nspells suitable for subtle stabbing or brute-force blasting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:enchanter"
msgid "Enchanters know a variety of Hexes that can incapacitate their foes, and are\nequipped with an enchanted dagger and potions of invisibility.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:fighter"
msgid "Fighters are equipped with armour and shield, as well as a weapon of their\nchoice and potions of might.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:fire elementalist"
msgid "Fire Elementalists have learned the Foxfire spell. Their other starting spells\nare likewise focused on fiery and explosive destruction.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:gladiator"
msgid "Gladiators are ready for the arena with light armour, a weapon of their choice,\nand a few throwing weapons and nets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:hedge wizard"
msgid "Hedge Wizards are magic generalists, good at using a wide variety of tools to\nfrustrate their foes and gain an edge in the battlefield.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:hunter"
msgid "Hunters carry a shortbow, light armour and a scroll of butterflies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:hexslinger"
msgid "Hexslingers carry a sling, and use hex magic to make their foes more vulnerable\nto attacks from afar.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:ice elementalist"
msgid "Ice Elementalists begin with the Freeze spell. Their later spells provide strong\noffence and defence, but may restrict their movement.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:monk"
msgid "Monks start with a simple weapon of their choice, an orb of light, and a potion\nof divine ambrosia, and gain additional piety with the first god they worship.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:necromancer"
msgid "Necromancers start out with the Soul Splinter spell. Eventually, they can turn\nthe dead into allies and use the life force of the living to restore themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:reaver"
msgid "Reavers start with a weapon of their choice and deadly magic to supplement it\nwhen in need. They start with the Kiss of Death spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:summoner"
msgid "Summoners are able to cast Summon Small Mammal from the start, and begin with\nspells to summon stronger and more exotic allies in their library.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:forgewright"
msgid "Forgewrights are mages who specialise in the creation of turrets and mechanical\ncompanions to fight alongside.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:shapeshifter"
msgid "Shapeshifters use talismans to shift their form, making them powerful melee\nfighters (especially when unarmed) at the cost of armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:alchemist"
msgid "Alchemists start with the Poisonous Vapours spell, and their magic is very\neffective against foes susceptible to poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:wanderer"
msgid "Wanderers start with random equipment and skills.\n"
msgstr ""

#: crawl-ref/source/dat/descript/backgrounds.txt
msgctxt "textdb:descript/backgrounds.txt:warper"
msgid "Warpers start with a weapon of their choice, a scroll of blinking, darts of\ndisjunction, and some Translocation spells in their library.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:fighting"
msgid "Fighting skill increases your accuracy and damage in physical combat, and\nalso increases your maximum health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:short blades"
msgid "Short Blades are more effective than any other weapon type at stabbing helpless\nfoes.\n\nBeing skilled with Short Blades will allow you to attack more quickly with all\nweapons of this type, as well as increasing your accuracy and damage with them.\n\nBeing skilled with Short Blades increases your effectiveness with Long Blades,\nand vice versa.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:long blades"
msgid "Being skilled with Long Blades will allow you to attack more quickly with all\nweapons of this type, as well as increasing your accuracy and damage with them.\n\nBeing skilled with Long Blades increases your effectiveness with Short Blades,\nand vice versa.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:axes"
msgid "Axes cleave through multiple enemies with a single swing, hitting foes in an\narc around the wielder.\n\nBeing skilled with Axes will allow you to attack more quickly with all weapons\nof this type, as well as increasing your accuracy and damage with them.\n\nBeing skilled with Axes increases your effectiveness with Maces & Flails and\nPolearms, and vice versa.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:maces & flails"
msgid "Being skilled with Maces & Flails will allow you to attack more quickly with\nall weapons of this type, as well as increasing your accuracy and damage with\nthem.\n\nBeing skilled with Maces & Flails increases your effectiveness with Axes and\nStaves, and vice versa.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:polearms"
msgid "Polearms can be evoked with ‘v’ to attack enemies from two spaces away.\n\nBeing skilled with Polearms will allow you to attack more quickly with all\nweapons of this type, as well as increasing your accuracy and damage with them.\n\nBeing skilled with Polearms increases your effectiveness with Axes and Staves,\nand vice versa.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:staves"
msgid "Staves require a relatively low amount of skill to be used most effectively,\nalthough they lack the high damage potential of some other weapon classes.\n\nBeing skilled with Staves will allow you to attack more quickly with all\nweapons of this type, as well as increasing your accuracy and damage with them.\n\nBeing skilled with Staves increases your effectiveness with Maces & Flails and\nPolearms, and vice versa.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:ranged weapons"
msgid "Being skilled with Ranged Weapons will let you attack more quickly with all\nbows, crossbows and slings, as well as increasing your accuracy and damage with\nthem.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:throwing"
msgid "Training Throwing will make thrown weapons (such as javelins) more accurate\nand damaging. It also makes certain magical darts more likely to have an\neffect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:armour"
msgid "Armour skill multiplies the AC gained from wearing armour of all kinds, both\nfrom body armour and cloaks, gloves, etc. It also slightly lessens penalties\nto spellcasting and ranged weapon speed from heavy armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:dodging"
msgid "The Dodging skill will affect your chance of dodging an attack, be it melee,\nranged or magical. Certain types of attack cannot be dodged, however, such as\nenchantments (which must be resisted with willpower) and explosions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:stealth"
msgid "By training Stealth, you can make it less likely that monsters will notice you\nif they are asleep or otherwise unalert, and increase your chances of monsters\nlosing track of you after you leave their vision. Note that more powerful\nmonsters tend to be more suspicious and observant.\n\nStealth skill, along with the weapon skill for your equipped weapon, also\ngoverns the likelihood of doing a great amount of damage when attacking a\ndistracted or helpless creature, as well as the amount of extra damage dealt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:shields"
msgid "A high Shields skill helps you block melee attacks or projectiles (both magical\nand non-magical) with your equipped shield, and reduces their penalty to your\nevasion, attack speed and spellcasting success.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:unarmed combat"
msgid "Being skilled in Unarmed Combat increases your accuracy, damage and attack\nspeed in melee combat when barehanded.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:spellcasting"
msgid "{{\n    if you.race() == \"Djinni\" then\n        return \"Being skilled in Spellcasting increases the success rate and spell \"..\n               \"power of all spells.\"\n    else\n        return \"Being skilled in Spellcasting slightly increases the success \" ..\n                \"rate and spell power of all spells, along with increasing your \" ..\n                \"magical reserves. Training Spellcasting also gives you more spell \" ..\n                \"slots to spend on new spells.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:conjurations"
msgid "Conjurations are battle oriented spells, which often work by conjuring up a\nchunk of short-lived matter and propelling it towards the victim to deal direct\ndamage. Being skilled in Conjurations usually increases the damage and accuracy\nof such spells, and sometimes affects their range or the size of the area\naffected.\n\nBeing skilled in Conjurations increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:hexes"
msgid "Hexes try to bestow various enchantments on nearby things. While none do direct\ndamage, being ensorcelled can effectively take an opponent out of combat,\nalthough they often require overcoming an opponent's willpower to have an effect.\nSkill in Hexes can help overcome this.\n\nBeing skilled in Hexes increases the success rate and spell power of spells in\nthis school. Many spells belong to a combination of several schools, in which\ncase spellcasting success and power will depend on the average skill in these\nschools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:summonings"
msgid "Summonings deals with summoning creatures from another plane of reality to\ntemporarily aid you. Increasing Summonings skill may grant a number of effects\ndepending on the spell, such as longer duration or more powerful allies. Note\nthat summoned beings do not leave corpses and give no experience when killed,\nand their equipment is as ephemeral as they are.\n\nBeing skilled in Summonings increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:forgecraft"
msgid "Forgecraft is the art of shaping tangible objects out of magic. Forgecraft\nspells can construct a wide array of mechanical creatures that will fight\nalongside the caster, as well as create traps and barricades and even turn the\nphysical resilience of one's armour into a weapon.\n\nBeing skilled in Forgecraft increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:necromancy"
msgid "Necromancy is the art of draining and gaining life, although most often\nassociated with zombies and other undead. As such, Necromancy spells have a\nwide range of effects, ranging from spells to create or disrupt the undead to\nspells granting unholy healing in various forms.\n\nBeing skilled in Necromancy increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:translocations"
msgid "Translocations focus on the spatial movement of beings or objects, including\nuseful spells to translocate yourself over short distances quickly or to\ntransport your enemies away from you.\n\nBeing skilled in Translocations increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:alchemy"
msgid "Alchemy is the art of toxins and transmutation. Spells in this school can twist\nobjects and creatures into different shapes, unleash powerful poisons, or even\nunweave the fabric of magic itself.\n\nBeing skilled in Alchemy increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:fire magic"
msgid "Fire Magic focuses mainly on dealing fire damage over long distances, with many\neffective Conjurations.\n\nBeing skilled in Fire Magic increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:ice magic"
msgid "Ice Magic contains a range of direct damage spells, as well as some defensive\neffects - for example, crafting temporary ice armour.\n\nBeing skilled in Ice Magic increases the success rate and spell power of spells\nin this school. Many spells belong to a combination of several schools, in\nwhich case spellcasting success and power will depend on the average skill in\nthese schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:air magic"
msgid "Air Magic provides spells to deal damage directly with the wind, as well as\nnoisy but powerful lightning Conjurations. It also provides some utility\nspells, such as a call to the wind to assist your movement or a Hex to prevent\nmost use of magic in the area surrounding you.\n\nBeing skilled in Air Magic increases the success rate and spell power of spells\nin this school. Many spells belong to a combination of several schools, in\nwhich case spellcasting success and power will depend on the average skill in\nthese schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:earth magic"
msgid "Earth Magic contains spells able to deal large amounts of direct physical\ndamage, which cannot be resisted like fire, cold and lightning damage can. It\nis also linked with Alchemy, with spells to liquefy the earth around you, or to\nturn your enemies to stone.\n\nBeing skilled in Earth Magic increases the success rate and spell power of\nspells in this school. Many spells belong to a combination of several schools,\nin which case spellcasting success and power will depend on the average skill\nin these schools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:invocations"
msgid "Your Invocations skill affects the likelihood that an attempt to use divine\nabilities with certain gods will be successful, and often the power of such\nabilities.\n\n{{\n    if you.race() ~= \"Djinni\" then\n        return \"The Invocations skill also affects your magical reserves, \" ..\n               \"but to a lesser degree than the Spellcasting skill. Only the \" ..\n               \"higher contribution is used.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:evocations"
msgid "Evocations skill affects your ability to use magical items like wands and other\nuncommon objects, increasing the power or success rate of such items.\n"
msgstr ""

#: crawl-ref/source/dat/descript/skills.txt
msgctxt "textdb:descript/skills.txt:shapeshifting"
msgid "Shapeshifting enables the use of magical talismans to change oneself into other\nforms. Sufficient skill allows one to use more powerful forms without gravely\ndamaging one's health. Being skilled in Shapeshifting also makes most forms\nsomewhat stronger, in ways which vary between forms.\n"
msgstr ""

#: crawl-ref/source/dat/descript/passives.txt
msgctxt "textdb:descript/passives.txt:no teleportation passive"
msgid "You cannot teleport or blink.\n"
msgstr ""

#: crawl-ref/source/dat/descript/passives.txt
msgctxt "textdb:descript/passives.txt:no spellcasting passive"
msgid "You cannot cast spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/passives.txt
msgctxt "textdb:descript/passives.txt:random rage passive"
msgid "You have a chance of going berserk when you make a melee attack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/passives.txt
msgctxt "textdb:descript/passives.txt:corrode self passive"
msgid "You have a chance of being corroded when you take damage.\n"
msgstr ""

