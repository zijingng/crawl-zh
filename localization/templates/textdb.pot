#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:flame cloud"
msgid "A cloud of raging fire. Any creature not entirely immune to fire will be hurt\nby time spent in the flames.\n\nRanged cold attacks passing through the cloud are substantially reduced in\nrange, dissipating the cloud in the process.\n\nIf placed near or over water, the heat will generate steam nearby.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:noxious fumes cloud"
msgid "A cloud of vile, choking fumes. Any creature spending time in it will be at\nrisk of becoming confused by the gases, unless resistant to poison. Tougher,\nmore experienced creatures are less likely to be affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:freezing vapour cloud"
msgid "A cloud of freezing air. Any creature not entirely immune to cold will be hurt\nby time spent inside.\n\nRanged fire attacks passing through the cloud are substantially reduced in\nrange, dissipating the cloud in the process.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:poison gas cloud"
msgid "A cloud of deadly poison. Any creature without resistance to poison will be\nboth poisoned and directly harmed by time spent in it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:_smoke_cloud_"
msgid "A cloud of coloured smoke. Harmless, except to the asthmatic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:black smoke cloud"
msgid "<_smoke_cloud_>\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:grey smoke cloud"
msgid "<_smoke_cloud_>\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:blue smoke cloud"
msgid "<_smoke_cloud_>\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:purple smoke cloud"
msgid "<_smoke_cloud_>\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:translocational energy cloud"
msgid "The remnant of some creature that was recently here but is no longer, banished\nnearby, across the level, or out of reality itself, all the way into the Abyss.\nSome wizards say these are a kind of \"allergic reaction\" the universe\nproduces, in response to magic that warps space in impossible ways; a cosmic\nsneeze. Perhaps metaphysically gross, but otherwise harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:spreading flames cloud"
msgid "A raging forest fire. Any creature not entirely immune to fire will be hurt by\ntime spent in the flames. The flames will intermittently flare up and fill\ntheir surroundings with lesser fires. Any trees unfortunate enough to be nearby\nwill often find themselves transformed into more kindling for the fire.\n\nRanged cold attacks passing through the cloud are substantially reduced in\nrange, dissipating the cloud in the process.\n\nIf placed near or over water, the heat will generate steam nearby.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:steam cloud"
msgid "A cloud of scalding steam. Creatures caught within will be mildly injured,\nand fire resistance will further reduce the damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:ink cloud"
msgid "A cloud of ink, completely filling the water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:calcifying dust cloud"
msgid "A petrifying cloud. Creatures caught in the cloud for any length of time will\nfind themselves turning to stone, though more experienced creatures may be able\nto resist the effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:blessed fire cloud"
msgid "A cloud of divine fire, imbued with holy power. Those in the service of one of\nthe good gods will be unaffected by it. All other creatures will be hurt by it,\nwith undead and demonic creatures being greatly harmed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:foul pestilence cloud"
msgid "A cloud of foul pestilence. Any living being caught within it will find\nthemselves poisoned, and may also find their movements slowed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:thin mist cloud"
msgid "A cloud of thin mist. Atmospheric, but harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:seething chaos cloud"
msgid "A cloud of seething chaos. A wide variety of unpredictable effects apply to\nthose within the clouds, ranging from invisibility to berserk rage to complete\nparalysis.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:rain cloud"
msgid "An extremely localised rainstorm. It may produce short-lived pools of shallow\nwater. Beings made of fire are averse to spending much time in the rain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:mutagenic fog cloud"
msgid "A cloud of pure, unstructured magic, condensed into a scintillating mist;\nessentially toxic magical waste. Creatures venturing within will find\nthemselves increasingly contaminated with magical radiation, sufficient amounts\nof which will inflict negative mutations when dissipating.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:magical condensation cloud"
msgid "The wake of some highly concentrated magical energy, itself entirely harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:whirling frost cloud"
msgid "The winds of a polar vortex. It will deal severe damage to anyone within it,\nonly partially mitigated by resistance to cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:sparse dust cloud"
msgid "A cloud of sparse dust. Atmospheric, but harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:spectral mist cloud"
msgid "A cloud of spectral mist. It causes minor damage to all creatures other than\nthe undead. Dangerous but short-lived spectral undead creatures will coalesce\nfrom the mist over time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:acidic fog cloud"
msgid "A cloud of flesh-searing acid, which will deal damage and apply corrosion to\nthose within it. Resistance to corrosion will provide immunity to its effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:thunder cloud"
msgid "A dark storm cloud. It will intermittently strike those within with lightning,\ndealing severe damage to those without resistance to electricity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:excruciating misery cloud"
msgid "A cloud of lingering despair and necromantic energy. Living creatures trapped\nwithin will repeatedly lose small fractions of their maximum health, though\nprotection from negative energy will mitigate the effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:white fluffiness cloud"
msgid "A white, fluffy cloud. Not actually solid enough to use as a pillow, and yet\nstill oddly peaceful.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:salt cloud"
msgid "A cloud of rapidly whirling dust and salt. It stings the eyes and skin of any\ncreatures caught within, although it is ultimately harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:golden dust cloud"
msgid "A cloud of shimmering golden dust. While within it, followers of the Council\ngain tremendous strength in combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:smouldering embers cloud"
msgid "A cloud of smouldering embers. It can easily be smothered by any creature\nstanding over it, but if left alone will ignite into a blazing cloud of flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:wisps of flame cloud"
msgid "A trail of sparks and wisps of flame. Atmospheric, but harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:alcoholic mist cloud"
msgid "A haze of aerosolised moonshine so thick that creatures can become drunk just\nwalking through it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:blastmotes cloud"
msgid "A cloud of volatile blastmotes. These explode on contact with flame or creatures.\nThe explosion is concussive, knocking adjacent creatures away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:sparks cloud"
msgid "A trail of electric sparks. Atmospheric, but harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:faint pestilence cloud"
msgid "The faintest hint of foul pestilence, seeping out from somewhere. While not\ndense enough to be harmful yet, it is thickening rapidly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:magnetised fragments cloud"
msgid "A cloud of countless tiny fragments of magnetised metal, still vibrating\nslightly from a recent electrical discharge. They will function as an attractor\nfor the Magnavolt spell until they dissipate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:bats cloud"
msgid "A swarm of tiny vampire bats, so dense that it is impossible to count them all.\nThey will relentlessly assail anything but the undead who stands in their midst,\ngradually lulling them to sleep with their soporific bites - and continuing to\nfeed off their helpless body, once they fall.\n"
msgstr ""

#: crawl-ref/source/dat/descript/clouds.txt
msgctxt "textdb:descript/clouds.txt:rust cloud"
msgid "A cloud of oxidising vapour that continuously corrodes and weakens the attacks\nof whatever stands inside it (but does only minimal damage).\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:acid dragon scales"
msgid "The scales of an acid dragon. Although it does not provide its wearer with as\nmuch protection as the armour made from the scales of some larger dragons, it is\nsomewhat lighter and less encumbering. It is also remarkably smooth, letting\ncorrosive slime flow off it like water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of chemistry"
msgid "An amulet which allows the wearer to extract small amounts of magical energy\nfrom any potion they drink and also enhances the power of their alchemy spells.\nThe magic restoration effect requires the amulet to attune itself to the\nwearer's body while their reserves of magic are full.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of dissipation"
msgid "An amulet which causes magic contamination and negative status effects upon the\nwearer to expire twice as quickly with time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of faith"
msgid "A charm crafted to call the attention of the gods to its wearer. This divine\nattention makes it easier to please your god, but your god will also take more\nnotice of your transgressions. The amulet will drain some of your divine favour\nwhen removed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of guardian spirit"
msgid "An amulet containing a protective spirit which will cause any damage taken to\nbe divided between the wearer's reserves of health and magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of magic regeneration"
msgid "An amulet that increases the wearer's rate of magic regeneration. In order to\nfunction, it must first attune itself to the wearer's body with full reserves\nof magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of nothing"
msgid "An amulet with no special properties.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of reflection"
msgid "An amulet which improves its wearer's ability to shield against attacks. If\nno shield is worn, the force the amulet emits can serve as a weak shield on\nits own. Regardless, any ranged attacks the wearer blocks will be reflected\nback toward the attacker.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of regeneration"
msgid "An amulet that increases the wearer's rate of health regeneration. In order to\nfunction, it must first attune itself to the wearer's body at full health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of the acrobat"
msgid "An amulet that allows the user to tumble and roll to evade the blows of their\nenemies, but only while moving and waiting. While taking other actions\n(including climbing stairs) the amulet conveys no benefits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:amulet of wildshape"
msgid "An amulet which improves its wearer's skill with Shapeshifting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:animal skin"
msgid "A large piece of thick skin covered in fur, cut from the corpse of an animal\nand worn as a primitive garment. It offers rudimentary protection against harm,\nbut, having never been tanned, it carries a light stench of rotting flesh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:arbalest"
msgid "A large piece of machinery used for firing bolts, braced with steel and cranked\nwith a windlass. It takes some time to load and fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:azure gem"
msgid "[[gem]]\n\nAs clear and blue as a cloudless sky or a depthless sea, this gem holds its\nsecrets locked within impenetrable depths.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:baked corpse"
msgid "A baked corpse. Warm, useless, and dead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:bardiche"
msgid "A long pole with an enormous, cleaving blade on one end.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:barding"
msgid "Armour for the scaly midsections of nagas and armataurs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:battleaxe"
msgid "A large war axe with a formidable double-sided head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:blade talisman"
msgid "A jagged cluster of blades, almost impossible to grasp without injury. Causes\nlong, needle-thin blades to grow from the wearer's body, allowing them to\nperform rapid auxiliary melee attacks and even parry blows. Having so many\nfragments of metal inside one's body reduces the effectiveness of body armour,\nbut Shapeshifting skill mitigates this effect as well as increases the damage\ndealt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of air"
msgid "A primer on the elemental magics of Air. The great minotaur hero Vuxhurn, given\na copy of this book while trapped atop the tower of a wizard with a particularly\nperverse sense of humour, used its pages to construct a rudimentary glider and\nsoared to freedom.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of annihilations"
msgid "A tome of arcane fury, greatly sought after by sorcerers. It allows the gifted\nand resourceful to conjure destruction with ease.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of armaments"
msgid "A book describing various magical arms and armours. It was written in the midst\nof a particularly bloody civil war, and the text is made substantially less\nhelpful by its author's frequent digressions describing the crimes committed by\nthe other side.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of battle"
msgid "An astonishingly vain and self-aggrandising work. The author claims credit for a\nwide swathe of weapon-augmenting magics, but seems to have misunderstood or\nmisrepresented most of them. Only a few of the spells described in the book\nactually work.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of beasts"
msgid "A book of spells focused on the summoning of beasts. Its pages nip at careless\nreaders' fingers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of blasting"
msgid "A book of spells used to set off powerful explosions. This edition's binder\nwas careful to pad the cover, so that if its reader lacked sufficient caution,\nthe book, at least, would survive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of blood"
msgid "A book of works dedicated to the manipulation of blood, both that of the caster\nand of creatures with particularly unusual ichor flowing through their veins.\nSome claim it to have been composed by the vampire lord Jory, but it's unclear\nwhy he would deign to share his secrets with others.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of burglary"
msgid "A book containing spells useful for theft, breaking and entering, and other\nmiscellaneous larceny.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of callings"
msgid "An introductory text on the magical summoning of beasts and beings from other\nrealms.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of cantrips"
msgid "A book containing a small selection of very basic magic spells, intended for\nbeginners who wish to learn the rudiments of one of the featured magical\nschools.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of chaos"
msgid "A book of spells that leave the caster's surroundings in a state of complete\ndisarray. It's not clear why anyone would write such a thing, but it's here.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of conjurations"
msgid "A book containing an introduction to the destructive magical arts of\nConjurations.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of contraptions"
msgid "A book of schematics and spells to construct a variety of elaborate mechanisms.\nThe obvious safety hazards involved with many of them are relegated to a single\nfootnote on page 157, but to an enterprising adventurer, that might be\nconsidered an upside.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of cryoformation"
msgid "An illustrated guide to shaping ice into both practical and artistic forms. An\nentire chapter is devoted to tables of mineral impurities and their effect on\ncolour and melting point.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of dangerous friends"
msgid "A book describing the creation and use of magical entities best kept at arm's\nreach. Or, preferably, even farther.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of death"
msgid "A manuscript containing dark spells of Necromancy. Each page is filled with\ngrotesque art depicting scenes of disgusting decay.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of debilitation"
msgid "A spellbook containing spells known for having a particularly unpleasant\neffect on their victims. It's considered something of a faux pas in the\nwizarding community to be seen with this book in one's collection.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of decay"
msgid "A book of Necromancy, dictated by the god Kikubaaqudgha to an unfortunate\napostle across the course of a nine-day fugue. The necromancer is said to have\nfinished the dread work with their own life's blood... but of course this is\njust a copy, written in almost entirely normal ink.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of displacement"
msgid "A book of spells to bring others closer, or sometimes farther, depending on the\nuser's whim.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of dreams"
msgid "The somniloquent utterings of a famed mystic, using uniquely bizarre imagery\nand cryptic digressions to describe spells drawn from the mystic's visions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of duality"
msgid "An eclectic spellbook, mingled with rambling philosophical anecdotes about the\ntwin nature of every action. Even by the end, it remains unclear whether the\nauthor considered there to be some spiritual purity to spells which incorporate\noffence and defence into a single motion, or if they just lived a life extremely\npressed for time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of fire"
msgid "A book containing advanced spells in the elemental school of Fire, stolen from\nthe secret college of the djinn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of fixed level"
msgid "A book of magic spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of fixed theme"
msgid "A book of magic spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of flames"
msgid "The standard text used in arcane academies by students of the elemental magic\nof Fire. Readers are recommended to wear a pair of insulated gloves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of frost"
msgid "A book of magic spells, often used as an introduction to the elemental magics\nof Ice. Its pages feel unusually brittle, as if they'd crumble at a touch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the fortress"
msgid "A book of spells that purports to make their caster as resilient as a stone\nfortress. Its cover is fashioned from thick, magically-reinforced steel, making\nthe book unreasonably heavy for no obvious benefit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of geomancy"
msgid "A book containing basic spells involving the element of Earth. Readers are\nrecommended to wear a pair of gardening gloves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the grave"
msgid "A heavy tome of necromantic spells. Those who touch it frequently report a\npalpable sense of unease, as if something unwholesome were buried between its\nvery pages.\n{{\n    if you.can_smell() then\n        return \"Its vellum smells faintly of dirt and decay.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of hexes"
msgid "A spellbook containing an assortment of powerful Hexes, which sparkles and\nshimmers as the pages are flipped.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of ice"
msgid "A book of advanced magical spells using the element of Ice. Readers are\nrecommended to wear a pair of warm gloves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of iron"
msgid "An ancient, metal-bound spellbook, covered in dark red blotches. Are they\nrust stains, or..?\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of lightning"
msgid "A book that fairly crackles with arcane power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of maladies"
msgid "A concise catalogue of afflictions, both magical and mundane, often described\nwith a disquieting degree of cheerfulness. Most of them operate on timescales\ntoo slow to be useful to an adventurer, but a few sound remarkably efficacious.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of metalworking"
msgid "A tome of advanced Forgecraft magic. Its pages are regularly inlaid with\ntechnical figures made from elaborate metal filigree, perhaps as an illustration\nof the author's own skill with the art described herein.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of minor magic"
msgid "A spellbook containing a variety of simple but useful magical incantations.\nMany prominent spellcasters used this book to begin their arcane studies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of misfortune"
msgid "A spellbook dedicated to the art of inflicting creative calamities on one's\nfoes. Superstitious wizards claim that the book itself actually absorbs ill\nfortune and carry it around as a good-luck charm, but the effects of this\nseem subtle at best.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of movement"
msgid "A spellbook that seems to leap open at the slightest touch. Its writing flits\nfrom description of one spell to another, giving enough information to truly\nunderstand only a few of them, though all seem to relate to movement in some\nway.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of necromancy"
msgid "A macabre book containing basic Necromancy spells. Readers are recommended to\nwear a pair of gloves they don't mind disposing of afterward.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of party tricks"
msgid "A book containing a variety of fun spells guaranteed to liven up any wizarding\nparty, as well as a number of toasts, jokes, and party games.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of power"
msgid "A book of powerful and destructive magic spells, rumbling and shuddering with\nbarely-contained energies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of scorching"
msgid "A magical book, blasted and scoured by long exposure to the desert sun. Upon\nits badly-weathered pages lie the secrets to inflicting the desert's dangers\nupon the caster's foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of sloth"
msgid "A lazily written book.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of spatial translocations"
msgid "A basic spellbook on the magical field of Translocations. Many would-be mages\nhave seen it disappear just as they needed it most.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of spectacle"
msgid "A book covered in glittering sequins. An impromptu lightshow bursts from every\npage, clearly reserving this book for only the tackiest of wizards.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of spontaneous combustion"
msgid "A heavy tome written with wildly flammable ink. Care must be taken even opening\nit, but the power of the spells described therein is undeniable.\n{{\n    if you.can_smell() then\n        return \"Its desiccated pages smell faintly of sulphur.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the spheres"
msgid "A book containing a well-rounded collection of sphere-related spells. Its\nfinal pages begin to describe a spell titled 'Summon Orb of Zot', but sadly,\nthe remainder of the book has been completely vaporised.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of storms"
msgid "A book written by the magician Lan Shi, who was preoccupied with the study and\ncontrol of natural phenomena. Most of Shi's works have been lost, but those\nstill remaining are treasured by wizards lucky (or unscrupulous) enough to get\ntheir hands on a copy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the dragon"
msgid "A magical book of spells which allow some command over dragons and their\naspects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the wilderness"
msgid "A book holding lore ripped from distant and untamed lands, allowing their\ndenizens to be called forth to serve the reader.\n{{\n    if you.can_smell() then\n        return \"It smells distressingly musty.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the earth"
msgid "A guide to drawing immense power from the depths of the earth. The original was\nwritten as a collaboration between the hill dwarves and the mountain dwarves, but\nits compilation was cut short when a massive wave of earthquakes plunged the hill\ndwarves' civilisation into ruin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the hunter"
msgid "A mundane book on hunting. Someone has gone through and covered the book in\ncorrections and scathing criticisms, crossing out entire sections in favour of\nspells that accomplish the same task.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the moon"
msgid "A book written by a mad wizard, who had become convinced that the moon far above\nwas composed, not of shining light, but of rock as solid as that beneath one's feet.\nMany of the pages have been mangled beyond recognition, seemingly shredded by a\npair of powerful claws... but what would a troll be doing with a spellbook?\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the senses"
msgid "A scholarly work, describing the senses used by living creatures to perceive the\nworld around them. A handful of spells are included to demonstrate the principles\nbeing described.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of transmutation"
msgid "A meticulous compendium of research notes, filled with formulae for decomposing\nand reconstituting all manner of substances. It was written by one of the\nlegendary alchemists among the sludge elves, before that species mysteriously\nvanished from the world. The author appears to have had a strange obsession with\nbecoming a butterfly, but even if their ultimate aim eluded them, many of the\nspells detailed therein are nonetheless quite practical.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the tundra"
msgid "A frost-gripped tome describing icy spells, somewhat abridged. The Vaults are\nsaid to hold the full text, but the guardians of that place guard their\ntreasures jealously.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of the warp"
msgid "A book of advanced Translocations spells, written by a particularly\nmisanthropic mage. After its completion, they were never seen again, which may\nor may not have been the point.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of touch"
msgid "A book describing spells requiring very close proximity to their target. The\nauthor seems to have had a low opinion of their wizardly peers, and spends much\nof the text describing the hygiene and social etiquette needed to enter close\nproximity to other sentient beings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of unlife"
msgid "An unholy book describing a variety of magical methods for the creation and\ncommand of undead servants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of vapours"
msgid "A book of magic spells for creating an assortment of clouds, vapours and mists.\nIt is difficult to read, as the text is frequently interrupted by descriptions\nof unusually-shaped clouds the author spotted while writing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of weapons"
msgid "A book of spells used by rebels against an ancient and evil empire. The rebels\nwere crushed, but this book was rediscovered years later, found by paladins of\nthe crusade that finally destroyed the empire and slew its immortal twin\nsovereigns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of wicked creation"
msgid "A long-forbidden tome, describing spells for various unholy (or, at least,\nunderhanded) creations. It would be unwise to bring such a book back to the\nsurface world - better to read it and discard it in some well-hidden location.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:book of winter"
msgid "A book of spells written by the sorceress Ellawe, who sought to use her time\nproductively while trapped inside by particularly harsh weather for over six\nmonths. A postscript details the bloody vengeance she took after discovering\nthe weather mage responsible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:boomerang"
msgid "A curved, flat, throwing baton designed to return to its user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:box of beasts"
msgid "A box filled with the bizarre leftovers of a depraved wizard's magical\nexperimentations. Opening it might set loose a friendly mutant beast: bizarre\ncreatures, each with their own combination of traits. Increased skill with\nEvocations will allow stronger beasts to be released.\n\nThere are six known traits:\n * Bat beasts fly and move very quickly, but erratically.\n * Fire beasts resist and breathe fire.\n * Ox beasts resist cold, are armoured with thick fur, and can knock back foes.\n * Shock beasts resist electricity and can transform into living lightning.\n * Sting beasts resist poison and have a reaching poison-tail attack.\n * Weird beasts can see invisible and attack with constricting tentacles.\n\nAs far as anyone knows, all beasts have exactly two of these traits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:broad axe"
msgid "An axe with langets, spikes, a lengthed haft and a single-bladed crescent head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:buckler"
msgid "A small piece of wood and metal, to be strapped on one arm for defence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:chain mail"
msgid "A suit of armour made entirely out of tiny metal rings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:cloak"
msgid "A cloth cloak.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:club"
msgid "A heavy piece of wood. While clubs are rather primitive weapons, bashing\nsomeone's skull in with one remains a very popular and effective means of\ndispute resolution.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:codex of conductivity"
msgid "An exhaustive collection of research notes on the effects of electricity upon\neverything from sawdust to snozzcumbers, interspersed with spell formulae and\nusable technical schematics. The author's handwriting deteriorates shockingly in\nthe middle of the chapter on spriggan electrophysiology, leading to much\nspeculation about both their identity and their sense of self-preservation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:compendium of siegecraft"
msgid "An analytical treatise on siege warfare, written in a clear and readable manner.\nA majority of its chapters are concerned with logistics and the maintenance of\nsupply lines, but several detail spells useful for breaching fortifications\n(and also other, softer, things).\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:condenser vane"
msgid "A magical device that condenses ambient energy into various destructive clouds.\nWhen evoked these clouds form around hostile monsters near the user. The\nquantity and lethality of these clouds increases with Evocations skill. At low\npower it will create noxious fumes, and as power increases this gives way to\nroaring flames, freezing vapours, and poisonous gas. At the highest tiers of\npower storm clouds, acidic fog and clouds of excruciating misery become\navailable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:corpse"
msgid "A corpse. Useless and dead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:crystal plate armour"
msgid "An incredibly heavy but extremely effective suit of crystalline armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:dagger"
msgid "A double-edged fighting knife with a sharp point.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:dart"
msgid "A thin piece of metal, typically coated in some harmful substance. When thrown\nit can deliver its toxins into the bloodstream of a living or demonic being.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:decaying skeleton"
msgid "A decaying skeleton.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:deck of destruction"
msgid "A deck of magical cards, most of which hurl death and destruction at one's foes\n(or, if unlucky, at oneself).\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:deck of escape"
msgid "A deck of magical cards, mainly dealing with various forms of escape.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:deck of punishment"
msgid "A deck of magical cards which wreak havoc on the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:deck of summoning"
msgid "A deck of magical cards, depicting a range of weird and wonderful creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:demon blade"
msgid "A terrible weapon, forged in the fires of Hell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:demon trident"
msgid "A terrible three-pronged weapon, moulded by fire and brimstone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:demon whip"
msgid "A terrible weapon, woven in the depths of the inferno.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:dire flail"
msgid "A flail with long spikes and a heavy head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:double sword"
msgid "A fearsome weapon with a forked, razor-sharp blade.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:dragon-coil talisman"
msgid "An intricate carving, inlaid with dragon tooth and scale. {{\n    local desc = \"Transforms the wearer into a mighty\"\n\n    if you.race():find(\"Draconian\") then\n        desc = desc .. \" dragon. The wearer retains their innate colour, \" ..\n                       \"becomes resistant to poison, and their breath weapon's \" ..\n                       \"power and recharge rate are greatly increased.\"\n    else\n        desc = desc .. \" golden dragon. The wearer becomes resistant to fire, \" ..\n                       \"cold, and poison, and gains a powerful breath attack \" ..\n                       \"that inflicts all three types of damage at once, but \" ..\n                       \"only recharges as you gain XP.\"\n    end\n    return desc\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:earthy gem"
msgid "[[gem]]\n\nDeep within this gem, flowing leaves and swaying branches seem to lurk. And\nhere, a bone picked clean - there, a predator's eyes, staring hungrily out..?\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:eel talisman"
msgid "A strange sea fossil, adorned with abalone and pearl.\n{{\n    local hands = you.hand() .. \"s\"\n    return \"Causes the wearer's \" .. hands\n}}\nto transform into a pair of wriggling electric eels that sometimes discharge\narcs of electricity through connected targets when used to strike enemies. When\nthe wearer's health becomes dangerously low, they will discharge an even more\nviolent voltage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:eggplant"
msgid "A rotten eggplant which you can throw at the Crawl developers. It's a bug if\nyou ever see this message.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:eudemon blade"
msgid "A sacred blade from the forges of Heaven, inhabited by a good spirit. It is a\nfavoured weapon of the Shining One's servants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:eveningstar"
msgid "The opposite of a morningstar. A balanced mace with a long shaft and a metal\nhead covered in lethal spikes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:everburning encyclopedia"
msgid "A book of magical spells, meticulously organised, dense, and almost entirely\nburnt black. Only a few pages are still legible, but the power within still\nblasts the reader with a furnace-like heat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:executioner's axe"
msgid "A fearsome weapon covered in dried blood and crude engravings of torture and\ndeath, bearing an enormous axehead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:falchion"
msgid "A long single-edged sword with a slightly curved blade.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:fen folio"
msgid "A collection of spells once used by the great swamp civilisations.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:figurine of a ziggurat"
msgid "A small figurine made of some strange material, shaped like a stepped pyramid.\nIt is remarkably detailed – almost like a real, vast structure, shrunk somehow\nsmaller than a human hand.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:fire dragon scales"
msgid "The scales of a fire-breathing dragon. It provides great protection from fire,\nwhile rendering its wearer more susceptible to cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:flail"
msgid "A mace with a short chain connecting the head to the haft.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:flux bauble"
msgid "A small glass bauble containing an ominously glowing substance. Crushing it will\nflood you with transmutational energy, leaving your physical form unstable at a\nfundamental level.\n\nIn this state of flux, your melee attacks are much weaker, but each strike will\ncontaminate whatever you hit with transmutational energy - growing so intense\nupon the third strike that it will cause their body to twist and deform,\ninflicting significant damage. The lack of certainty in your physical form also\nmakes you much harder to hit, though you glow in a way that hinders stealth.\n\nThe power contained in each bauble is finite, and once it is exhausted by\nspreading it to enemies, you will return to your previous form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:fortress talisman"
msgid "A miniature battlement, carved from a piece of shell. Transforms the wearer into\na heavily armoured crab, fusing whatever body armour they are wearing into the\nshell in the process. In this form, they are slow-moving, but well-defended and\neven capable of wielding a weapon in their large main claw. Despite all this\nbulk, they are well-adapted to the water. They can also breathe clouds of rust\nat the cost of their own HP, which corrode and weaken enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:gell's gravitambourine"
msgid "A copper and tungsten tambourine that vibrates excitedly in your hands, as if\neager to be used.\n\nJust as music brings people together, shaking it with the proper rhythm will\ndraw a large group of monsters into a narrow space and hold any hostile ones in\nplace for a short time with inescapable waves of crushing gravity.\n\nThe area of effect and duration increases with Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:gem"
msgid "A stone of unearthly beauty and almost immeasurable value outside the dungeon.\nWithin its confines, it is utterly useless.\n\nZot hoards these gems jealously, and will spitefully smash them soon after an\nadventurer enters the branch of the Dungeon in which they rest. Still, a very\nquick-moving adventurer might seize one first and keep its precious shards.\nZot cannot track gems outside their home branches, so with truly astonishing\nspeed, it might be possible to abscond with one still intact... but such a\nfeat is difficult to credit, and likely pointless besides.\n\nOnce the Orb of Zot is taken, Zot will be unable to smash any gems.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:giant club"
msgid "A giant lump of wood.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:giant spiked club"
msgid "A giant lump of wood with sharp spikes at one end.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:glaive"
msgid "A pole with a large, heavy blade on one end.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:golden dragon scales"
msgid "The scales of a golden dragon. It is much heavier than most dragon scale\narmours, and grants its wearer resistance to poison, fire and cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:gold piece"
msgid "A pile of glittering gold coins.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:granite talisman"
msgid "A heavy stone icon, bearing the countenance of some long-forgotten king or god.\nTransforms the wearer into a slow, stone statue. The wearer's stone body is\nimmune to poison and miasma, and gains resistance to electricity, negative\nenergy, and torment. Shapeshifting skill increases armour granted.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:grand grimoire"
msgid "A book describing how the mighty among summoners can bend to their will the\nterrible things from betwixt the planes. Many have been the unwary souls,\nhowever, who have toyed with this tome and been driven mad by unimaginable\neldritch horrors.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:great mace"
msgid "An enormous metal war club, of great cumbrousness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:great sword"
msgid "A sword with a very long, heavy blade and a long handle.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:great wizards, vol. ii"
msgid "A collection of spells from great wizards throughout history. The author seems\nto have been extremely enthusiastic, and each wizard is described in voluminous,\ncomprehensive detail.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:great wizards, vol. vii"
msgid "A collection of spells from great wizards throughout history. The author seems\nto have been quite tired of their project - the wizards' descriptions are terse\nand minimal, meeting the lowest requirement for completeness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:halberd"
msgid "A polearm consisting of an axe blade topped with a spike, mounted on a long\nshaft.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:hammer"
msgid "A blunt striking weapon, essentially equivalent to a mace.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:hand axe"
msgid "A small axe.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:hand cannon"
msgid "A machine that fires metal slugs via applied thaumaturgy. Some enchant their\nprojectiles to fall forward instead of down, others bewitch the slugs with a\nfatal attraction to their targets. All are slow, loud, and blast out thick\nsmoke with each shot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:handbook of applied construction"
msgid "A practical introduction to Forgecraft, covering basic principles and their\ncommon applications.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:hat"
msgid "A cloth hat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:helmet"
msgid "A piece of metal headgear.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:hive talisman"
msgid "A preserved and decorated hive, still dripping with ambrosial nectar. Transforms\nthe wearer into a living beehive, filled with the buzz of countless insects\nlabouring inside them. The nectar produced within greatly increases the wearer's\nhealth and magic regeneration and if they become seriously injured, angry bees\nwill swarm out to defend their hive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:horn of geryon"
msgid "The horn belonging to Geryon, guardian of the Vestibule of Hell. It has the\npower to call forth demonic beasts. With high Evocations skill, it will call\ngreater numbers of beasts, with lower chances of those beasts being hostile.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:sling"
msgid "A piece of cloth and leather for launching stones, adequate for hunting small\ngame like rabbits or goblins.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ice dragon scales"
msgid "The scales of a cold-breathing dragon. It provides great protection from cold,\nwhile rendering its wearer more susceptible to fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:inkwell talisman"
msgid "A small bottle filled with mystical ink. Transforms the wearer into a walking\nscroll whose body is tattooed with the knowledge of a hundred mages. Being an\nomnibus of magical techniques gives them increased skill with all spell schools,\nwhich improves with Shapeshifting skill, but the form's ability to channel such\nmagic is limited, and it cannot cast spells above level 4.\n\nIts attacks are also very weak, but have a chance of restoring 1 MP when they\nhit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ivory gem"
msgid "[[gem]]\n\nCountless spirits swirl around this gem, shrouding it in a bone-deep chill.\nUnwelcome in the Good gods' afterlife, they find here a heaven of their own.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:jade gem"
msgid "[[gem]]\n\nSigils of fire burn deep within this gem, symbol of the eternal compact between\nnaga and salamander. Their bond is that of the poison which scourges the impure\nand the flame which burns away impurity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:javelin"
msgid "A lightweight spear, designed for throwing. It will pass through the targets it\nhits, potentially hitting all targets in its path until it reaches maximum\nrange.\n{{\n    if you.race() == \"Kobold\" or you.race() == \"Spriggan\" then\n        return \"Unfortunately, it is too long and awkward for you to use.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:kite shield"
msgid "A piece of wood and metal, to be strapped on one arm for defence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:lajatang"
msgid "A very rare and extremely effective weapon, featuring a pole with half-moon\nblades at both ends.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:large rock"
msgid "A very large and very heavy stone. {{\n    if you.race() == \"Ogre\"\n       or you.race() == \"Troll\"\n   then\n       return \"\"\n   else\n       return \"Only large creatures are capable of throwing it.\"\n   end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:leather armour"
msgid "A suit made from layers of tanned animal hide. It provides basic protection\nwith almost no hindrance to spellcasting or stealthy movement.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:lightning rod"
msgid "A rod that allows its wielder to fire unavoidable blasts of lightning.\nConsecutive evocations cause the discharge to be sustained, which increases the\npower level up to four times and allows the blast to be redirected to affect an\narea. The strength of the blast increases with Evocations skill and, for\nredirected blasts, decreases with the size of the affected area.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:long sword"
msgid "A sword with a long, slashing blade.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:longbow"
msgid "A long, strong bow made of yew.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:lupine talisman"
msgid "A painted eyepatch made from a scrap of wolf pelt. Transforms the wearer into a\nvicious werewolf, muscles surging with predatory instinct. Killing enemies with\nmelee attacks in this form will give a stacking bonus to your damage and\naccuracy, and slaying enough of them in a row will cause you to unleash a\nvicious howl that makes any still alive cower in fear - and leaves them\nsusceptible to a devastating leaping takedown.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:mace"
msgid "A short club with a metal head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:manual"
msgid "A valuable book which allows one to learn a certain skill faster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:maxwell's memoranda"
msgid "A loosely bound collection of the infamous Maxwell's schemes, diagrams and plans.\nAmidst messages written to and by his many minions, allies of convenience and\nhated rivals, a patient reader can discover spells of electrifying power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:maw talisman"
msgid "A miniature, desiccated head of some ferocious and hopefully extinct creature.\nTransforms the wearer's midsection into a giant mouth, gnashing and ready to devour\nfoes. This maw confers a powerful bite attack which scales additionally with the\nwearer's own strength and can devour slain creatures to temporariy increase\none's regeneration. Unfortunately, it also confers such profound hunger that it\ncan be difficult to pull oneself away from particularly appetising foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:medusa talisman"
msgid "A fossilised jellyfish polyp, inscribed with sigils. Causes a mane of long\nstinging tendrils to sprout from the wearer's head which lash out at nearby\nenemies whenever the wearer attacks, poisoning them. When they feel their host's\nlife is in danger, they can even turn these poisoned foes to stone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:midnight gem"
msgid "[[gem]]\n\nThe stoneborn brought forth this gem from the uttermost depths of the earth as\na gift and a warning: beware Zot! That it lies now within Zot's power is a sure\nproof of the perversity of mortals and fate alike.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:milky-white gem"
msgid "[[gem]]\n\nSmooth as a spider's silk, white as the eyes of some crawling thing which has\nlived too long in the dark, this gem buzzes with a fearful potential. Still, to\na certain eye, it possesses a strange allure...\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:morningstar"
msgid "A mace with a head covered in short spikes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:mossy gem"
msgid "[[gem]]\n\nThough it drips with mud and muck, still a peculiar dignity attaches itself to\nthis gem. The people of the Swamp, who first carried this stone, struggled\nagainst insurmountable odds. They failed, but there is much to admire even in\nthe ruin of their efforts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:my sojourn through swampland"
msgid "While purporting itself to be the personal account of a famous naturalist, it\nbecomes clear upon reading that this book was compiled from multiple unrelated\nsources, including notes from a stagehand of a travelling magical circus. The\ntravelogue may be fictitious, but some of the spell diagrams carefully\ntranscribed in the margins seem quite real.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:necronomicon"
msgid "An extremely rare book, powerful and sinister. Many foolhardy magicians have\ntried to study this tome, only to find themselves entangled within necromantic\nforces they could not hope to control.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:orb"
msgid "A sphere of crystal, carried in place of a shield. Magic scintillates within\nits interior.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:orb of zot"
msgid "An invaluable artefact. Once you have escaped to the surface with it, your\nquest is complete.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:orcbow"
msgid "A recurved bow, crudely crafted from troll-bone and warg hair. The cave orcs'\nuse of archery, so unlike their surface-dwelling ancestors, shows the influence\nof their elvish allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:pair of boots"
msgid "A pair of boots. They are worn on the feet, and cover all but the largest\nhooves and talons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:pair of gloves"
msgid "A pair of gloves. They are worn on the hands, and cover all but the largest\nclaws.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:parchment"
msgid "A brief text on magic, perhaps excerpted from some larger work. It contains\nknowledge of one spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:partisan"
msgid "A long polearm with sharp protrusions on either side of the spearhead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:pearl dragon scales"
msgid "The nacreous scales of a pearl dragon. It grants its wearer resistance to\nnegative energies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:phantom mirror"
msgid "A hand mirror which can create a reflection of a nearby creature, clouding\nin the process. The reflection's duration increases with Evocations skill and\ndecreases with the willpower of the target. It is, invariably, slightly weaker\nthan the creature it mirrors.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:phial of floods"
msgid "An enchanted vessel of elemental water. Removing the stopper unleashes a torrent\nof water, smashing the target and flooding the nearby area. If any creatures\nengulfed by the wave need air to breathe, they'll be unable to cast spells until\nthey recover. The strength of the torrent and the duration of the flooding\nincrease with Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:plate armour"
msgid "A full suit of solid metal plate: cuirass, pauldrons, vambraces, waist plate\nand greaves. It provides excellent protection.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of ambrosia"
msgid "A strange substance, produced by ghost moths. Consuming it causes regeneration\nof health and magic, along with total befuddlement. The two effects are\nfundamentally linked – the regeneration ends the moment the confusion does.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of berserk rage"
msgid "A potion which can send one into an incoherent rage, granting them a great but\ntemporary increase to their health, damage, and speed. In exchange, their mind\nis clouded by anger, only allowing them to move and attack in melee. The rage\nwill wear off quickly if they do not attack monsters, and upon expiry, the\nimbiber will be fatigued, causing them to slow dramatically and rendering them\nunable to berserk again for a short duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of blood"
msgid "A potion containing the essence of life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of brilliance"
msgid "A potion which increases the power of the drinker's spells and halves their\nmagic cost (rounding up).\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of cancellation"
msgid "A potion which ends most magical effects, good or bad, affecting one who drinks\nit. It also reduces magical contamination.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of curing"
msgid "A potion which restores a small amount of health, and cures poison and\nconfusion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of enlightenment"
msgid "A potion which uplifts both the body and mind of its drinkers, lifting them\nfrom the ground and increasing their Will to resist the world's temptations.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of experience"
msgid "A truly wonderful and very rare drink, which grants experience when consumed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of haste"
msgid "An enchanted beverage which speeds the actions of anyone who drinks it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of heal wounds"
msgid "A magical healing elixir which causes wounds to close and heal almost\ninstantly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of invisibility"
msgid "A potion which confers invisibility on one who consumes it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of lignification"
msgid "A potion which transforms the imbiber into an animated tree with sap for blood and\nbranches capable of holding weapons. Such a tree has minimal evasion but increased\nhealth and natural armour, and is resistant to poison, and immune to torment and\ndrowning. However, it is rooted in place while the transformation lasts, and\ncannot teleport.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of magic"
msgid "A valuable potion which grants an infusion of magical energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of might"
msgid "A potion which greatly increases the power of the drinker's melee attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of moonshine"
msgid "A potent alcohol, distilled in some dubious corner of the dungeon. Drinking it\nreduces the imbiber's accuracy, evasion, and spellcasting success for a while.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of mutation"
msgid "A potion which mutates the drinker, removing several mutations then\ngranting a few random mutations, which are likely (but not guaranteed) to be\nbeneficial.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of resistance"
msgid "A potion which grants temporary resistance to a variety of harmful effects:\nfire, cold, electricity, poison, and acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:potion of attraction"
msgid "A potion which makes the drinker attract enemies, translocating them quickly closer\nfor the duration of the effect. The effect is surprisingly subtle, and unwary\nvictims may sleep through it entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:prismatic gem"
msgid "[[gem]]\n\nShining with every colour of the rainbow and a few others besides, some\nconsider this gem 'a bit tacky'. Preposterous!\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:protean talisman"
msgid "An ever-changing fragment of something primordial; its substance seems to\nundulate between flesh and bone and perhaps even metal. A sufficiently skilled\nshapeshifter can stabilise it into a useable - if unpredictable - form.\n\n(If your Shapeshifting skill is at least 6, attempting to put this on will\ntransform it into a random one of: Rimehorn, Scarab, Medusa, or Spore talismans.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:quad damage"
msgid "A mysterious item resembling a rune of some kind. Once evoked, it will make the\nuser glow blue and add a reverb to all sound... and there may be other effects\nas well.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:quarterstaff"
msgid "A sturdy wooden pole, meant for fighting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:quicksilver dragon scales"
msgid "The scales of a quicksilver dragon. Although it does not provide its wearer\nwith as much protection as the scales of some heavier dragons, it is somewhat\nlighter and less encumbering. The armour repels both attacks on the wearer's\nwillpower and magical modification of itself - it cannot be enchanted.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:quick blade"
msgid "A dagger with an uncanny enchantment upon it, allowing it to strike twice\nfor every blow its wielder makes. It takes great skill to use to its full\npotential.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:quill talisman"
msgid "A spiny trinket reminiscent of a cactus. Causes sharp quills to grow all over\nthe wearer's body which may cause injury to anyone unwise enough to attack them\nin melee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:rapier"
msgid "A slender, sharply pointed sword, with an uncommonly elegant design.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:riddle talisman"
msgid "An intricate puzzlebox containing an unknowable prize. Transforms the wearer into\na riddle-loving sphinx. In this form, they are {{\n    if you.race() == \"Felid\" then\n        return \"normally capable of wearing a cloak and barding (though your\" ..\n               \" own diminutive size would prevent this)\"\n    else\n        return \"capable of wearing a cloak and barding\"\n    end\n}}, and their melee attacks cause powerful winds to strike their foe which do\nincreased damage for every open space next to them. They are also masterful\nenchanters, casting Hex spells much more easily and ignoring a portion of their\nfoe's Willpower.\n\nAlas, their love of riddles is so compulsive that even the most hardened\nadventurer will be unable to resist posing them to new foes they encounter, no\nmatter how unwise this may be.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:rimehorn talisman"
msgid "A crude ornament carved from the horn of a rare arctic beast - so cold to the\ntouch that ice still clings to it. Transforms the wearer into a rime yak, a hardy\nungulate that is highly resistant to cold and whose breath is so frigid that it\nfreezes the walls around itself as it fights. Being so attuned to arctic\ntemperatures also makes it easier for the wearer to cast Ice magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring mail"
msgid "A light leather suit reinforced with a covering of metal rings. It is\nprotective in combat, but slightly uncomfortable due to the added weight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of dexterity"
msgid "A ring that increases the dexterity of its wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of evasion"
msgid "A ring that makes its wearer more capable of avoiding attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of flight"
msgid "A ring that grants its wearer flight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of intelligence"
msgid "A ring that increases the intelligence of its wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of resist corrosion"
msgid "A ring that protects its wearer from the effects of acid and corrosion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of magical power"
msgid "A ring that increases its wearer's reserves of magical power for so long as it\nis worn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of poison resistance"
msgid "A ring that protects its wearer from poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of positive energy"
msgid "A ring that protects its wearer from the effects of negative energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of protection"
msgid "A ring that protects its wearer from most sources of damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of protection from cold"
msgid "A ring that protects its wearer from cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of protection from fire"
msgid "A ring that protects its wearer from fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of willpower"
msgid "A ring that increases its wearer's willpower, protecting against certain\nmagical effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of see invisible"
msgid "A ring that allows its wearer to see invisible things.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of slaying"
msgid "A ring that increases the wearer's accuracy and damage with ranged weapons and\nmelee attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of strength"
msgid "A ring that increases the strength of its wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:ring of wizardry"
msgid "A ring that increases the success rate of its wearer's magical spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:robe"
msgid "A large, loose-fitting, wide-sleeved outer garment made of light cloth. It\noffers little protection against physical harm, but does not hinder evasion or\nspellcasting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:rune of zot"
msgid "A charm which allows entry into the Realm of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:sack of spiders"
msgid "A woven silk bag. Opening it will cover the area with webs, spiders, and other\nskittering things. Evocations skill increases spider quality, quantity and webbing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:sacred scourge"
msgid "A blessed weapon, woven by the saints in Heaven and hated by the unholy. It is\na favoured weapon of the Shining One's servants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:sanguine talisman"
msgid "A vial of roiling blood that pulses with the beat of an unseen heart. Transforms\nthe wearer into a fearsome vampire - a creature that straddles the border between\nlife and undeath. They can drink the lifeblood of the living to heal themselves,\nand even turn those they slay stealthily into vampiric thralls, but do not heal\nin the presence of monsters. At great effort, they may scatter into a swarm of\nbats - either to flee or to assail their enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:sanguine gem"
msgid "[[gem]]\n\nThey who smote down Death herself and buried themselves in a Tomb of their own\nmaking were not shy of their ambitions. Fain to seize upon baubles and\noverweening proud, their Lord journeyed into their eternal unrest with this gem\nupon their breast.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scale mail"
msgid "A leather suit covered with metal plates attached to each other in overlapping\nrows to provide full protection, but at the cost of reduced freedom of\nmovement.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scarab talisman"
msgid "A small golden cameo of a beetle. Transforms the wearer into a sun scarab, a\nfiery insect that carries around a mote of searing heat and light outside\nitself, like a tiny sun.\n\nThis solar ember burns adjacent enemies whenever the scarab attacks, and can be\nhealed by swapping with it. In addition, the scarab's own mandibles can reduce\nenemies' fire resistance and Fire spells are easier for the wearer to cast.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scarf"
msgid "A length of stylish fabric. At its creation, enchantments were woven into it,\nand as such it cannot accept further enchantment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scimitar"
msgid "A long sword with a wide, curved blade.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of acquirement"
msgid "A wonderful scroll which causes the creation of a valuable item, with the\nreader choosing from a small selection. The items offered will often be a\ngood match for the reader's skills; and if nothing recommends itself, the\nreader can always choose a heap of gold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of amnesia"
msgid "A scroll that allows its reader to selectively erase one spell from memory to\nrecapture the magical energy bound up with it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of blinking"
msgid "A scroll that allows its reader to teleport a short distance, with precise\ncontrol.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of brand weapon"
msgid "A scroll that imbues a weapon with a random brand. Any existing brand will be\nreplaced with a different one, and any brand forbidden by your current god will\nnot be chosen. Artefacts cannot be branded in this way.\n\nMelee weapons will commonly be branded with the flaming, freezing, heavy,\nvenom or protection brand (or with the special brand exclusive to the category\nof weapon being branded), and rarely with the draining, electrocution, spectral,\nvampiric or chaos brand.\n\nRanged weapons will commonly be branded with the flaming, freezing, heavy or\ndraining brand, and rarely with the electrocution or chaos brand.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of butterflies"
msgid "A scroll that surrounds its user with a flight of beautiful butterflies, blowing\nback other creatures nearby with the flapping of their wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of enchant armour"
msgid "A scroll that places an enchantment on a piece of armour chosen by the reader.\nBody armour and bardings can be enchanted up to the same value as their base\narmour rating. Bucklers, kite shields and tower shields can be enchanted up to\n+3, +5 or +8 respectively, and other armour can be enchanted up to +2. Magical\nartefacts cannot be enchanted at all.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of enchant weapon"
msgid "A scroll that places an enchantment on a weapon chosen by the reader,\nincreasing both accuracy and damage. Weapons can be enchanted up to +9. Magical\nartefacts cannot be enchanted at all.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of fear"
msgid "A scroll that causes great fear in nearby foes, causing them to flee until\nattacked, cornered, or enough time has passed.\n\nNon-living, undead and plant monsters cannot be feared, and berserk or frenzied\nmonsters are also immune.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of fog"
msgid "A scroll that surrounds the reader with a dense cloud of fog, which can block\nvision temporarily. The fog takes a short time to fully spill out.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of identify"
msgid "A useful magic scroll which identifies the properties of any unknown object.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of immolation"
msgid "A scroll that fills the creatures around the reader with an unstable and\npowerful inner flame. This fire is released any time the victims are hit, and\nexplosively released upon their death. Giant creatures cause bigger explosions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of noise"
msgid "A prank scroll that creates a loud noise when read.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of poison"
msgid "A scroll that fills the air with poison, covering every unoccupied space in\nsight with toxic fumes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of revelation"
msgid "A scroll that reveals its reader's surroundings. The layout of the current\nfloor is fully mapped, and everything within a moderate radius, including\nboth visible and invisible monsters, is momentarily shown.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of silence"
msgid "A scroll that eliminates all sound near the reader. This makes reading scrolls,\ncasting spells, invoking divine abilities, or shouting impossible in the\nreader's vicinity.\n\nCertain monsters have innate magical or special abilities which will still be\nusable while silenced.\n\nThe effect starts out with a large radius, which will then shrink, eventually\ncovering only the reader, before it times out.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of summoning"
msgid "A scroll that calls forth several allied creatures woven from shadow into the\nshapes of those beings found within the reader's immediate vicinity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of teleportation"
msgid "A scroll that translocates the reader to a random position after a short delay.\nReading this scroll while waiting for a teleportation will instead cancel it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of torment"
msgid "A scroll that calls on the powers of darkness to inflict great pain on any\nnearby creature — including the reader! This halves the resilience of all\nliving creatures and cuts down all holy creature resilence by about a third,\nalthough it is never directly fatal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scroll of vulnerability"
msgid "A scroll that briefly halves the willpower of the reader and any nearby beings,\nrendering them vulnerable to many magical effects. The scroll cannot affect\nthose fully immune to such effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:scythe"
msgid "A farm implement, usually only used by untrained mobs in combat. In practice,\nit's quite similar to a halberd.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:serpent talisman"
msgid "A jade snake coiled around a fossilised egg. Transforms the wearer into an\namphisbaena - a legendary two-headed serpent. It is capable of wearing two\npieces of headgear at once and its powerful coils can wind around foes and crush\nthem to death, but its cold blood leaves it succeptible to being slowed by cold\nattacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:shining gem"
msgid "[[gem]]\n\nMany are the treasures of the Ironbound Order, but none older nor more precious\nthan this steel-shining gem. The Vaults were first forged to hold it, and none\nwho gazed within its depths could fault the choice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:shimmering gem"
msgid "[[gem]]\n\nUnearthly energies gently flow along the surface of this gem, guided by the\narchmage who first built the Elven Halls. Countless generations of elves\nflocked to learn from her, but her foremost pursuit was always the perfection\nof this piece of art.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:shop voucher"
msgid "A coupon good for one item of any price from any store in the dungeon, to be\nused automatically when you would make a purchase that exceeds your funds. How\ngenerous! No refunds. One coupon per purchase per customer. Offer limited by\navailability. Void if defaced or otherwise altered. Valid only within the\ndungeon of Zot and its subsidiary branches. Additional purchase not required.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:shortbow"
msgid "A curved piece of wood and string, for shooting arrows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:short sword"
msgid "A personal stabbing weapon with a short grip.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:smoky gem"
msgid "[[gem]]\n\nSwirls of dark smoke seem to lurk in the depths of this gem. Countless dark\ndeeds were done in the Dungeon even before Zot seized and remade it, and their\ndreadful residue now taints every hint of beauty trapped within its confines.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:spear"
msgid "A hunting weapon consisting of a wooden shaft with a pointed metal head\nfastened on one end.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:spider talisman"
msgid "A strange charm made from shed arachnid exoskeletons bound together with silk.\nTransforms the wearer into an agile jumping spider who can move swiftly towards\nfoes and inflict grievous damage on any it catches unaware. It cannot be\nensnared by webs, but its attacks can ensnare its enemies in them. It can also\nleap briskly away from many dangers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:spore talisman"
msgid "A small charm made from a still-living mushroom. Transforms one of the wearer's\narms and parts of their lower body into a vibrant mass of multicoloured fungus.\nMelee attacks in this form may release spores that weaken their target, as well\nas cause mushrooms to sprout on the ground behind them which will release their\nown bursts of dazing spores if allowed to grow. Shapeshifting skill increases\nthe durability of these mushrooms as well as their damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of air"
msgid "A staff that increases the power of air spells cast by its wielder, and\ninsulates them from electricity. If the wielder is skilled in Evocations and\nAir Magic, they can shock those struck by it, dealing electrical damage which\nbypasses half of defenders' armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of alchemy"
msgid "A staff that increases the power of alchemy spells cast by its wielder, and\nprotects them from the effects of poison. If the wielder is skilled in\nEvocations and Alchemy, they can envenom those struck by it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of cold"
msgid "A staff that increases the power of ice spells cast by its wielder, and\nprotects them from the effects of cold. If the wielder is skilled in Evocations\nand Ice Magic, they can freeze those struck by it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of conjuration"
msgid "A staff that increases the power of conjurations cast by its wielder. If the\nwielder is skilled in Evocations and Conjurations, they can blast those they\nstrike with pure energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of necromancy"
msgid "A staff that increases the power of necromantic spells cast by its wielder, and\nprotects them from negative energy. If the wielder is skilled in Evocations and\nNecromancy, they can inflict great pain on those living souls they strike,\ndealing negative energy damage which bypasses armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of earth"
msgid "A staff that increases the power of earth spells cast by its wielder. If the\nwielder is skilled in Evocations and Earth magic, they can fracture the ground\nbeneath those struck by it, dealing substantial damage - though much less to\ncreatures which fly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:staff of fire"
msgid "A staff that increases the power of fire spells cast by its wielder, and\nprotects them from the effects of fire. If the wielder is skilled in Evocations\nand Fire Magic, they can burn those struck by it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:starry gem"
msgid "[[gem]]\n\nOdd lights twinkle within the depths of this gem. From what strange stuff is it\nmade, and from what distant land did it travel?\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:steam dragon scales"
msgid "The scales of a steam-breathing dragon. Unlike the scales of some larger\ndragons, it does not provide its wearer with much protection (beyond a\nresistance to scalding steam), but it is extremely light and supple.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:stone"
msgid "A small chunk of dense but otherwise unremarkable natural mineral. It can be\nthrown to cause minor damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:shadow dragon scales"
msgid "The scales of a great umbral dragon. It is heavier than most dragon scale\narmours, but its encumbrance does not penalise the wearer's stealth. It also\ngrants additional stealth to the wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:storm dragon scales"
msgid "The scales of a lightning-breathing dragon. It is heavier than most dragon\nscale armours, and gives its wearer resistance to electrical discharges.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:storm talisman"
msgid "Lightning trapped, impossibly, in a bottle. Lets the wearer walk through the air\nas a raging, lightning-filled tempest. The wearer's melee attacks are electrified\nand strike all adjacent foes. The wearer also flies, gains immunity to poison,\nmiasma, petrification, constriction, and sticky flame, and also resists\nelectricity. They can launch themselves as a lightning bolt, blasting through\neverything in their way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:swamp dragon scales"
msgid "The scales of a swamp dragon. It confers resistance to poison on its wearer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:talisman of death"
msgid "A grey-black vessel, infused with dark power through a sickening ritual.\nTransforms the wearer into an undying offence against life itself.\n\nFoes struck by wearer's melee weapons or hands are weakened, slowed, and drained.\nThe wearer can also heal themself by tormenting living foes nearby; Shapeshifting\nskill increases the amount healed. Further, the wearer resists cold, has enhanced\nwillpower, and is immune to poison, miasma, negative energy, and torment.\n\nThe wearer also gains some of the more dubious benefits of having an undead body.\nThey are vulnerable to holy damage and Dispel Undead, and cannot consume potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:there-and-back book"
msgid "A compilation of children's stories about great adventures, always ending with\nthe traveller returning to the place they started. The love infused into its\npages by countless generations has granted it power, allowing a skilled mage to\ntransport others by reciting specific passages.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:throwing net"
msgid "A mesh of ropes knotted together with weights around the edge, used to entangle\nand entrap targets. Struggling victims can eventually destroy the net and break\nfree, if they live long enough.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:tower shield"
msgid "A large piece of wood and metal, to be strapped on one arm for defence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:tin of tremorstones"
msgid "A set of dormant, magnetic earth elementals in the form of tiny, very heavy\npebbles. When released, the elementals are drawn magnetically to the center of\nnearby monsters, where they literally explode with rage at their rest being\ndisturbed. Tremorstones usually land slightly off-target, and the user is\nalways at risk of being hit. However, armour is extremely effective at\nrepelling the lightweight fragments of rock from a tremorstone's explosion, so\na well-armoured wielder has little to fear. Evocations skill increases the\nnumber of explosions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:treatise on traps"
msgid "An analytical volume discussing methods and materials with which to construct a\ndizzying array of traps - from those intended to safeguard a pantry from ants to\nones which would please even the most sadistic dungeon architect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:trident"
msgid "A fishing spear improved with a longer shaft and a three-pronged metal head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:trismegistus codex"
msgid "A magical book\nwritten by a\nnumerologically obsessed wizard.\nEverything from sentence\nlength to overall\norganization is structured.\nIt's unclear whether\nthe author thought\nthis was helpful.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:triple crossbow"
msgid "A crossbow with three strings arranged in series to provide exceptional power,\ninitially designed as a siege weapon and then scaled down. It takes a\nconsiderable amount of time to load and fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:triple sword"
msgid "A formidable weapon created by a master craftsman. The blade of the sword forks\ninto three great razor-sharp edges.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:trishula"
msgid "A blessed trident moulded by cleansing flame, with three points symbolising the\ncombined might of the three holy gods. It is a favoured weapon of the Shining\nOne's servants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:troll leather armour"
msgid "The stiff and knobbly skin of a troll. It magically regenerates its wearer's\nflesh, once attuned to the wearer's body at full health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:the unrestrained analects"
msgid "A collection of spells that assault everything in sight of the caster,\nunrestrained by petty limitations like 'needing a clear shot' or 'concern about\ncollateral damage'.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of acid"
msgid "A magical device which throws bolts of corrosive acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of charming"
msgid "A magical device which causes a creature to become fiercely, but briefly,\nloyal to the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of digging"
msgid "A magical device which drills tunnels through unworked rock.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of flame"
msgid "A magical device which throws little puffs of flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of iceblast"
msgid "A magical device which creates a loud explosion of ice shards, bypassing half\nof victims' resistance to cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of light"
msgid "A magical device which fires a ray of searing light, injuring and blinding\nthose struck. Only living, undead, demonic and angelic monsters can be blinded,\nand tougher monsters will recover their vision more quickly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of mindburst"
msgid "A magical device which launches a psychic attack on a target creature. If it\novercomes their willpower, it 'blows their mind' in a violently literal fashion,\ndealing damage that bypasses their armour entirely. It is useless against\nmindless creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of paralysis"
msgid "A magical device which can render a creature immobile, incapable of moving any\nof its limbs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of polymorph"
msgid "A magical device which causes a creature to be transmogrified into another\nform. It is especially effective against shape-changing creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of quicksilver"
msgid "A magical device which fires a beam of destructive energy, dispelling\nenchantments on creatures struck.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of roots"
msgid "A magical device which fires a magical seed, entangling its target and adjacent\nfoes in quick-growing tree roots. Those entangled will be immobilised and take\ndamage over time until they escape or the roots wither away. The roots will only\nsprout from solid ground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wand of warping"
msgid "A magical device which creates a brief but violent rift in space, damaging\neverything caught in its wake and sometimes blinking them a short distance away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:war axe"
msgid "A military axe with a long haft and a single-bladed head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:wellspring talisman"
msgid "A small amphora from which pours a seemingly unending quantity of water.\nTransforms the wearer's flesh into elemental water, allowing them to move flexibly\nand reach to attack from a great distance. From time to time, they can even\ncause the water around them to rise up and drown their enemies.\n\nThe malleability of this water even allows them to retain the benefits of their\nphysical mutations, but cold attacks can freeze it solid and fire may cause it\nto erupt with steam.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:whip"
msgid "A long plaited strip of leather. Originally developed for use in disagreements\nwith cattle, this simple weapon is now widely used to settle differences\nbetween all sorts of creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/items.txt
msgctxt "textdb:descript/items.txt:young poisoner's handbook"
msgid "An introductory book for the magic arts of poison. Readers are recommended to\nwear a pair of very thick, non-absorbent gloves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:abjuration spell"
msgid "Reduces the remaining duration of any nearby hostile summoned creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:acid ball spell"
msgid "Hurls an explosive ball of corrosive acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:agonising touch spell"
msgid "Cuts the health of an adjacent creature in half. This damage is never\ndirectly lethal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:agony spell"
msgid "Cuts the health of a target creature in half. This damage is never directly\nlethal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:airstrike spell"
msgid "Causes the air around a creature to twist itself into a whirling vortex of\nmeteorological fury. It does more damage to targets surrounded by empty space.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:alistair's intoxication spell"
msgid "Converts a small portion of the brain matter of those around you into alcohol,\nattempting to confuse all intelligent creatures within view (although\npoison-resistant creatures may resist the effects). The caster will experience\nvertigo briefly if they successfully make contact with other minds. It is\nfrequently used as an icebreaker at wizard parties.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:alistair's walking alembic spell"
msgid "Constructs a mobile and combat-capable alchemical manufactory. It uses the\nfriction of melee combat to brew a variety of useful potions, venting clouds of\ntheir toxic byproducts at whatever it punches. When it has built up enough heat\nto complete its synthesis, it will automatically dispense the finished potions\nto nearby allies before falling apart.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:anguish spell"
msgid "Afflicts nearby foes with supernatural anguish, causing all damage they deal to\nrebound on them for the duration of the effect. Strong-willed foes can resist the\nnecromantic visions of pain and suffering, and mindless creatures are unaffected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:animate dead spell"
msgid "For some time after casting this, living creatures killed by the caster will rise\nas zombies. The chance of reanimating a monster and the duration of the effect\nincrease with spell power. Re-casting this spell will return zombies to dust, as\nwill leaving the floor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:antimagic gaze spell"
msgid "Causes the target's magic to leak into the air, as though they were hit by an\nantimagic weapon, and heals the caster for the amount of magic drained,\nwith no direct line of fire required.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:apportation spell"
msgid "Pulls the top item or group of similar items from a distant pile to the floor\nnear the caster. With low power, items might not be moved all the way to the\ncaster's position.\n\nExtremely powerful magical items, such as the Orb of Zot, may actively resist\nthe pull of this spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:arcjolt spell"
msgid "Sends a wave of electricity through everything adjacent or near-adjacent to\nthe caster. The electricity continues to arc through everything in a connected\nchain, though the caster themself is unaffected. The damage dealt bypasses half\nof defenders' armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:avatar song spell"
msgid "Sings a powerfully haunting song. Adventurers who fail to resist will become\nunable to move away from the singer (and will sometimes be drawn closer\ninvoluntarily), while other creatures will become dazed outright.\n\nIn addition, it may call forth drowned souls from any nearby bodies of deep\nwater.\n\nLeaving the caster's line of sight will end the movement-controlling effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:awaken armour spell"
msgid "Draws upon the memory of your worn armour to manifest an echo of it that fights\nalongside you. This echo moves slowly, but the power of its blows increases\ndramatically with the weight of the armour used to form it. It possesses all\nthe defensive properties of the armour itself.\n\nSpellpower increases its durability.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:awaken flesh spell"
msgid "Channels a surge of chaotic energy through each pile of flesh in the caster's\nsight, animating them into empowered large abominations and dealing chaos damage\nto any foes unfortunate enough to be standing next to them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:awaken forest spell"
msgid "Gives some limited motility to nearby trees, allowing them to sway their\nbranches and shift their roots. Such enchanted trees will lash at any adjacent\nenemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:awaken vines spell"
msgid "Causes vines to grow from the ground. The vines will reach out and grab\ninterlopers, dragging them towards any nearby trees.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:banishment spell"
msgid "Banishes a creature into the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:battlecry spell"
msgid "Inspires nearby allies of the caster to fight more aggressively, increasing\nthe strength of their blows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:beckoning gale spell"
msgid "Twists the air around a creature to both deal damage and attempt to pull them\ncloser to the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:berserker rage spell"
msgid "<Berserk ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:berserk other spell"
msgid "Causes a nearby ally to fly into a berserk rage. Going berserk temporarily\nincreases health, speed, and damage dealt in melee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bestow arms spell"
msgid "Temporarily grants numerous nearby allies a magical weapon from within the\narmoury, so long as the souls holding it together remain intact.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bind souls spell"
msgid "Bestows an enchantment on other nearby living creatures that causes them to\nrise as simulacra after being slain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink allies away spell"
msgid "Blinks allies in sight of the caster away from a nearby enemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink allies encircling spell"
msgid "Translocates a number of allies in the caster's sight to surround a targeted\nenemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink away spell"
msgid "Translocates the caster to a location further away from a targeted enemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink close spell"
msgid "Translocates the caster a short distance towards a targeted enemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink other close spell"
msgid "Translocates a targeted enemy a short distance towards the caster. It cannot be\nresisted by willpower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink other spell"
msgid "Randomly translocates a targeted enemy a short distance. It cannot be resisted\nby willpower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink range spell"
msgid "Translocates the caster to a location further away from a targeted enemy, but\nstill within sight of the target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blink spell"
msgid "Randomly translocates the caster a short distance. After translocating in this\nway, the spell cannot be cast again for a short period of time depending on\nspell power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:blinkbolt spell"
msgid "Transforms the caster into a lightning bolt, and translocates the caster to\nthe bolt's destination.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of cold spell"
msgid "Fires a penetrating bolt of frost.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of devastation spell"
msgid "Fires a bolt of grief and heartache that cuts its victims' willpower in half.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of draining spell"
msgid "Fires a penetrating bolt of negative energy which drains any living creature\nit strikes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of fire spell"
msgid "Fires a penetrating bolt of flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of flesh spell"
msgid "Fires a barrage of conjured flesh, which will briefly remain as a pile on the\nground at the end of its path.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of light spell"
msgid "Fires a ray of searing light, which may blind any living, demonic, or holy\ncreature it strikes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bolt of magma spell"
msgid "Fires a penetrating bolt of molten rock. Half of its damage bypasses fire\nresistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:bombard spell"
msgid "Blasts an iron ball toward a target. The force of the blast often sends the\ncaster staggering backwards.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:borgnjor's revivification spell"
msgid "Instantly heals any and all wounds suffered by the caster, but also permanently\ndamages their health, to a degree dependent on (and inversely related to) power.\n\nIt is powerful enough to cancel the effects of Death's Door, although doing so\nwill briefly paralyse the caster. It has no effect on the undead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:borgnjor's vile clutch spell"
msgid "Calls forth hands from corpses interred beneath the dungeon floor long ago.\nEnemies caught in the area will be held in place and constricted until they\nbreak free.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:brain bite spell"
msgid "Drains a small amount of a visible enemy's mind and a proportion of their magic,\nwith no direct line of fire required. If the enemy has near-emptied magic\nreserves, they will take doubled damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:brom's barrelling boulder spell"
msgid "Unleashes a massive rolling boulder in a given compass direction. This boulder\ndamages any creature it hits, rolling over those who perish beneath it and\npushing any others helplessly backwards (along with anyone else unfortunate\nenough to be standing behind them).\n\nIts size and reckless locomotion make it difficult to use in confined areas; if\nlaunched down narrow passages, it will rapidly abrade against the walls and fall\napart. It will also crumble if it leaves the caster's sight or strikes a wall\nor otherwise unmoveable creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:brothers in arms spell"
msgid "<Brothers in Arms ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call canine familiar spell"
msgid "Summons an inugami to the caster's aid. These mystical canines form a bond with\ntheir summoner, strengthening them in direct proportion with the caster's\nspellpower.\n\nRecasting this spell while your familiar is nearby will imbue it with additional\nmagic, mending some of its wounds, cleansing it of poison, and causing its next\nattack to strike more quickly and cleave adjacent foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call down damnation spell"
msgid "Blasts a targeted enemy with damnation, with no direct line of fire required.\nThese unholy forces harm the victim and anyone adjacent, and are not affected\nby any means of protection, such as armour or resistances. However, certain\ncreatures, usually those able to invoke damnation themselves, are entirely\nunscathed by damnation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call down lightning spell"
msgid "Blasts a targeted enemy with lightning, with no direct line of fire required.\nThe targeting magics need distance to function, so enemies that are adjacent\nor nearly adjacent cannot be struck by this.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call imp spell"
msgid "Calls forth a minor demon from the pits of Hell, equipped with a spear with\nwhich to jab at the caster's enemies. The quality of the imp's weaponry rises\nwith spell power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call lost souls spell"
msgid "Summons some necromantic spectres. These lost souls can enter the bodies of more\npowerful undead to bring them back from brink of demise, or turn dying living\ncreatures into ghostly versions of themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call of chaos spell"
msgid "Calls upon the powers of chaos to empower nearby allies, granting them haste,\nmight, doubled vigour, or improved resistances. The chaotic magic may\noccasionally backfire and cause allies to instead lose their willpower or be\nberserked, polymorphed, or filled with inner flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:call tide spell"
msgid "Allows the caster to affect the tidal phase of all water within a large\ndistance. Soon after calling it, the waters on the whole level will reach high\ntide. Waters near the caster will reach even higher levels than they would\nnormally.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:cantrip spell"
msgid "Casts one of a number of minor spells, aimed at trying to bolster the caster's\nmorale. They have no noticeable effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:cause fear spell"
msgid "Causes fear in those near to the caster, causing those affected to be unable to\napproach the caster, and to sometimes fail to attack them in melee. Leaving the\ncaster's line of sight will end the effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:caustic breath spell"
msgid "<Caustic Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:chain of chaos spell"
msgid "Creates an arc of pure chaos, striking nearby creatures with unpredictable\neffects. The arc can touch upon the caster without harming them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:chain lightning spell"
msgid "Releases a massive electrical discharge that arcs to the creature nearest the\ncaster and then outward from it. The further it travels, the less damage it\ndoes. Secondary arcs have limited range and do little damage to the caster.\nThe spell bypasses half of defenders' armour and resistance to electricity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:charm spell"
msgid "Causes an otherwise hostile creature to fight on the caster's side for a while.\nAdventurers, set on their quest for the ORB, instead suffer momentary confusion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:chaos breath spell"
msgid "Exhales a large cloud of fumes filled with the very essence of chaos.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:cigotuvi's putrefaction spell"
msgid "Magically accelerates the decay of damaged living tissue, causing great clouds\nof miasma to billow forth from a targeted victim's wounds over several turns\nwhich may slow and heavily poison any living creature who stands in them. Air\ncurrents will prevent this pestilence from forming wherever the caster is\nstanding, but they are not otherwise protected from its effects.\n\nThis spell may only be cast on a living creature who is at least heavily\nwounded, and channelling such necrotic energies will leave the caster's own\nhealth temporarily drained (though spellpower will reduce the intensity of this\nside-effect).\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:cleansing flame spell"
msgid "Invokes a huge blast of divine fury centered on the user, severely damaging\nundead and demons and dealing damage to all other hostile creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:cold breath spell"
msgid "Exhales a focused blast of icy-cold air.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:concentrate venom spell"
msgid "Intensifies the natural venom of the target monster. Poisonous bites and spit\nbecome intense enough to slow and asphyxiate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:combustion breath spell"
msgid "<Combustion Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:confuse spell"
msgid "Induces a state of bewilderment and confusion in a creature's mind.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:confusing touch spell"
msgid "Enchants the caster's dominant hand with magical energy. This energy is\nreleased when the caster touches a monster, and may induce a state of confusion\nin the monster. The caster's attacks do no damage while attempting to touch a\nmonster in this way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:confusion gaze spell"
msgid "Induces a state of bewilderment and confusion in a creature's mind, with no\ndirect line of fire required.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:conjure ball lightning spell"
msgid "Creates a pack of ball lightnings, which seek out the nearest enemy before\nexploding in a huge blast of electricity. The damage dealt bypasses half of\ndefenders' armour. Casters are advised to use caution; the lightning is not\nmindful of what it may hit.\n\nThe magic which keeps ball lightnings cohesive has limited range, so they may\ndissipate harmlessly if allowed to drift too far away from their caster before\nexploding.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:conjure living spells spell"
msgid "Creates several living, autonomous spells, which cast themselves at the first foe\nto enter their range. Once cast, they dissipate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:construct spike launcher spell"
msgid "Constructs a simple mechanical trap within an adjacent wall which repeatedly\nskewers random adjacent enemies. Protected by the wall itself, it is\ninvulnerable to most forms of damage, but will fall apart if the caster leaves\nits vicinity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:corona spell"
msgid "Causes a halo of glowing light to surround and effectively outline a creature.\nThis glow offsets the dark, musty atmosphere of the dungeon, and makes the\naffected creature appreciably easier to hit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:corrosive bolt spell"
msgid "Fires a penetrating bolt of highly-corrosive acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:corrupt spell"
msgid "Unleashes Abyssal energies in the immediate vicinity. This changes the\nappearance of the affected area and temporarily summons creatures from the\nAbyss. This cannot be used in the Abyss itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:corrupting pulse spell"
msgid "Instills a corruption within all visible targets, temporarily mutating their\nbodies in an adverse fashion. It cannot affect artificial beings, and the\nundead will decompose if affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:creeping frost spell"
msgid "Calls forth freezing cold from the walls. Any enemies of the caster standing\nnext to the walls will be frozen and will find their movements slowed. Cold\nresistance will reduce damage, but not prevent the freezing effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:creeping shadow spell"
msgid "Calls forth shadows from the corners of nearby walls to strike at all of the\ncaster's enemies standing adjacent to them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:crystallising shot spell"
msgid "Hurls a large and heavy shard of crystal. It may render a creature's body\nstructure as brittle and fragile as shattered and unrefined crystal, increasing\nthe damage they take from all sources.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:curse of agony spell"
msgid "Curses a foe, halving their remaining health after each of the next two times\nthat the caster strikes them in melee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:death channel spell"
msgid "Binds the souls of slain living, demonic and holy creatures, forcing their\nspectres to remain and fight for the caster for as long as the channel lasts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:death rattle spell"
msgid "Exhales the essence of the dying, creating clouds of noxious miasma.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:death's door spell"
msgid "Renders the caster nigh invulnerable to harm for a brief period, but brings\nthem dangerously close to death in the process. So close, in fact, that the\nbody believes itself to be dead — healing effects will do nothing.\n\nThe caster will receive one warning shortly before the spell expires. After\nexpiry, the spell cannot immediately be recast, but with high power the caster\nwill be left further from death when the effect ends. It has no effect on those\nwho are already undead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:debugging ray spell"
msgid "Fires a ray which does massive damage (1500 hp) and always hits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:deflect missiles spell"
msgid "Envelops the caster in a repulsion field, greatly increasing their evasion\nagainst all types of projectile - even while otherwise incapacitated.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:detonation catalyst spell"
msgid "Affixes a volatile catalyst to the caster's fists or melee weapon, causing each\nof their strikes to release a fiery explosion at its primary target. The caster\nand their allies are protected from the explosion's effects. The activity of the\ncatalyst may be prolonged indefinitely as long as the caster continues to\nattack, but it rapidly loses potency when they take other actions. The base\ndamage of the caster's weapon and the caster's spellpower each increase the\nexplosion's damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:diamond sawblades spell"
msgid "Forges up to four razor-sharp sawblades at fixed positions around the caster\nwhich shred any enemies adjacent to them over several turns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dig spell"
msgid "Digs a tunnel through unworked rock.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dimension anchor spell"
msgid "Blocks any translocations attempted by the affected target, be they voluntary\nor not. This includes even some cross-plane effects, although notably not\nBanishment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dimensional bullseye spell"
msgid "Weaves a link between the caster's weaponry and a chosen target. Whenever the\ncaster fires or throws something at a *different* enemy, a matching projectile\nwill be teleported at the target. Spellpower increases their accuracy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:diminish spells spell"
msgid "Irresistibly weakens the power of an enemy's spells for a period of time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:discord spell"
msgid "Drives nearby creatures into an wild frenzy, causing them to mercilessly\nattack anything and everything nearby with great strength and speed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:disjunction spell"
msgid "Destabilises the space in a sphere around the caster for a while, causing\nanyone nearby to blink away from the caster. The chance of blinking depends on\nthe distance from the caster, being nearly certain when directly adjacent.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dispel undead spell"
msgid "Harms an adjacent undead creature greatly by interfering with the forces\nbinding it together.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dispel undead range spell"
msgid "Harms an undead creature greatly by interfering with the forces binding it\ntogether.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dispersal spell"
msgid "Teleports away any creatures within a short distance of the caster. Any\ncreature with the Will to resist will still be irresistibly blinked a shorter\ndistance, and any monster it affects at all has a separate Will-based chance\nof being confused by the warping of space.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:divine armament spell"
msgid "Manifests the caster's faith as a spiritual weapon, which will fight and slay\nthe caster's enemies under its own power.\n\nAs it is a direct reflection of the caster's unique zeal, the weapon they\nreceive from their god will be the same each time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dominate undead spell"
msgid "Attempts to forcibly change the allegiance of all nearby undead which are not\nalready loyal to the caster.\n\nAdventurers, being famously headstrong, cannot be fully controlled by this\nspell. They will instead lash out randomly for the duration of its effect,\nattacking nearby friend and foe alike before regaining their wits.\n\nThis spell can be broken prematurely by the death of its caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:doomsaying spell"
msgid "Foretells a terrible future, inflicting Doom equal to half of what it would take\nfor you to reach 100%. Upon the caster's death, a sliver of this fate will come\nto pass in the form of an ambush; several well-hidden enemies from the floor\nwill seek out your position unerringly and all stairs will temporarily be\nsealed.\n\nCan only be cast a single time, but even slaying the messenger in their sleep\nwill not avoid what fate has in store for you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:doom bolt spell"
msgid "Fires a bolt of accursed malice which inflicts Doom.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:oblivion howl spell"
msgid "Unleashes a piercing howl that catches and echoes in victims' minds. While\nthose echoes linger, nightmarish creatures will hear and track them to their\nsource. It can only be used once by a given creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dragon's call spell"
msgid "Issues a powerful call to a draconic realm, beckoning forth dragon after dragon\nto engage the summoner's enemies. The spell is taxing to maintain, and each new\ndragon which answers the call will further drain the summoner's magical\nreserves. After the call ends, it cannot be issued again for a short time. The\nduration of the call and the species of dragons called depend on spell power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:drain life spell"
msgid "Drains the life force of any nearby enemies, healing the user depending on\nthe damage dealt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:drain magic spell"
msgid "Causes the target's magic to leak into the air, as though they were hit by an\nantimagic weapon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:draining gaze spell"
msgid "Fills a living creature with negative energy, draining them for a fraction of\ntheir maximum health. This spell requires line of sight but not line of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:dream dust spell"
msgid "Overwhelms the target with soporific dream dust, putting them to sleep with an\nenchanting visual display. Additional dream sheep will increase the strength\nand duration of this effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:druid's call spell"
msgid "Recalls woodland creatures from elsewhere on the same level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:electrical bolt spell"
msgid "Throws a bolt of electricity at the target, with high accuracy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:enfeeble spell"
msgid "Overwhelms an enemy with malignant energies, irresistibly weakening their melee\nattacks and reducing the power of their spells. It will additionally daze and\nblind any foe that fails to resist the full force of the curse - even those\nwithout visual senses!\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ensnare spell"
msgid "Shoots a stream of webbing at a creature, ensnaring the target in a sticky web.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ensorcelled hibernation spell"
msgid "Lowers its target's metabolic rate, inducing hibernation. After awakening, the\ntarget will be unable to be put to sleep again for some time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:entropic weave spell"
msgid "Corrodes the target, with no direct line of fire required.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:eringya's noxious bog spell"
msgid "Causes the caster to release a torrent of sludge that transforms nearby areas\ninto a toxic bog. The sludge damages and poisons all monsters, even those\nresistant to poison. The bog cannot form on areas adjacent to multiple solid\nfeatures, nor on areas that lack solid floor, like deep water or lava. The\ntransformation is temporary and cannot be sustained out of the caster's sight.\nSpellpower will increase how long the bog lingers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:eringya's surprising crocodile spell"
msgid "Summons a toothy crocodile to assault an adjacent enemy. The crocodile will\nappear beneath the caster in a surge of murky water and perform an empowered\nattack against the chosen target, dragging both it and the caster backward\nbefore allowing the latter to dismount safely behind it. It cannot be recast\nwhile the crocodile is still active.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:eruption spell"
msgid "Splits the earth to draw up a localised, short-lived volcano under the target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fastroot spell"
msgid "Fires a magical seed, entangling victims in quick-growing tree roots. Those\nentangled will be painfully constricted until they escape or the roots wither\naway. The roots will only sprout from solid ground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:flay spell"
msgid "Opens painful illusionary wounds on the target's body, which disappear after\na short time or on the death of the caster. This cannot kill directly, and is\nineffective against unnatural targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fire breath spell"
msgid "Breathes a blast of fire at a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fire storm spell"
msgid "Calls forth a mighty storm of roaring flame directly onto the target, dealing\ndamage in a large area and leaving behind short-lived fire vortices. Half of\nits damage bypasses fire resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fireball spell"
msgid "Hurls an explosive ball of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:flame wave spell"
msgid "Blasts the caster's surroundings with a wave of fire. If the caster maintains\nfocus and supplies the spell with magical power (by waiting in place and not\ntaking any other actions), more and larger flame waves will radiate outward.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:flaming cloud spell"
msgid "Conjures up a large cloud of roaring flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:flash freeze spell"
msgid "Freezes the air around a target, causing significant harm and slowing the\ntarget's movement for a short time. Half of its damage bypasses cold resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:flashing balestra spell"
msgid "A single soul from within the armoury leaps out, striking with their weapon and\nthen duelling independently for a short time before returning to the maelstrom\nonce more.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fleetfoot spell"
msgid "Calls forth winds to increase the caster's movement speed for a short duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:force lance spell"
msgid "Fires a shaft of concussive force. If the impact deals damage, it may knock the\ntarget back. If this knockback causes the target to hit a wall or another\ncreature, both will take additional damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:forceful invitation spell"
msgid "Summons some creatures from one of the Snake Pit, the Spider Nest, the Swamp,\nthe Shoals, the Elven Halls, the Vaults, or the Crypt; the specific branch\nvaries with the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:forge blazeheart golem spell"
msgid "Constructs a shell of slag iron around a volatile elemental spark. It is capable\nof raining down powerful blows on its creator's adversaries - so powerful that\nthe golem itself is often damaged by their impact.\n\nOnly tenuously independent of its creator's magic, the flames within it will\nrapidly go dormant if the two ever leave each other's side. If its shell is\ndestroyed while the golem is still active, its exposed core will violently\ndetonate a moment later.\n\nIt gains greater explosive damage at higher power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:forge lightning spire spell"
msgid "Constructs an immobile lightning spire at a nearby location. This spire\nirregularly discharges bolts of electricity at the caster's foes, prioritizing\nwhichever of them is most distant from it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:forge monarch bomb spell"
msgid "Constructs a flying incendiary factory, packed to the brim with cluster\nbomblets which it can deploy both in melee and launch at range. While the\nmonarch's bomblets have no attack of their own, they will pursue the caster's\nenemies until given the signal to explode.\n\nRecasting this spell while anything it has created is still active will\ndetonate the monarch bomb and all bomblets, dealing a combination of fire and\nphysical damage to everything adjacent to them besides the caster themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:forge phalanx beetle spell"
msgid "Constructs a small mechanical guardian which bolsters its creator's armour\nclass for as long as it remains adjacent to them.\n\nWhile also capable of biting foes, the phalanx beetle will never voluntarily\nleave its creator's side, and if forcibly separated, will prioritise returning\nto them over any other concern.\n\nSpellpower increases the magnitude of the AC increase, as well as the beetle's\nown durability.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fortress blast spell"
msgid "Draws upon the caster's own physical integrity to create a kinetic shockwave\nthat damages foes in a large area. The caster is locked in place for several\nturns as the shockwave starts to form, and the spell will be cancelled if they\nare displaced during that time, but they may otherwise perform other actions\nfreely.\n\nSpellpower causes the spell to complete more quickly, but the damage depends\nentirely upon the caster's AC.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:foxfire spell"
msgid "Conjures two balls of burning swamp gas adjacent to the caster. The balls will\nrapidly seek the nearest monster and burn them. They will dissipate harmlessly\nif unable to reach a target or if the caster swaps places with them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:freeze spell"
msgid "Freezes an adjacent creature, dealing damage that bypasses any armour the\ntarget may have. This may temporarily slow cold-blooded creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:freezing cloud spell"
msgid "Conjures up a large cloud of lethally cold vapour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:freezing gust spell"
msgid "Fires a penetrating bolt of frigid air that leaves clouds of lethally cold\nvapour in its wake.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:frozen ramparts spell"
msgid "Encases surrounding walls with ice for a short time. Foes that wander near the\nicy walls will be damaged, and this may temporarily slow cold-blooded creatures.\nEach victim is only ever affected by one icy wall at a time.\n\nThe ice will crack and fall away if the caster moves to a new position.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fugue of the fallen spell"
msgid "Calls out to the lingering remnants of the long dead. While active, each\nnon-summoned enemy the caster or their allies slays attracts more vengeful\nsouls into the caster's weapon, temporarily enhancing their melee and ranged\neffectiveness. When this bonus reaches its maximum, every hit will unleash a\nglimmer of the dead's suffering, causing pain damage to each other foe adjacent\nto your target.\n\nRecasting this spell will release your grip on the souls you've attracted,\nresetting any bonus you've accumulated, and the cacophonous wailing of the dead\nmay attract unwanted attention even while you maintain it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fulminant prism spell"
msgid "Conjures a shining prism of an unstable soft gold alloy. This is useless as\nlegal tender, however, as it will unfortunately violently explode with arcane\nforce after a short duration. If destroyed prematurely, its blast will be much\nweaker.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:fulsome fusillade spell"
msgid "A magnum opus of reckless chemistry, this spell conjures up a surfeit of\nvolatile reagents to rain down upon your enemies. For the next several turns, up\nto 3 random enemies in sight will be struck by an exploding beaker that inflicts\neither fire, cold, electric, or poison damage. If any of these explosions\noverlap each other, the resulting reaction will inflict even greater\nirresistible damage and sometimes apply a random deleterious status on whoever\nis caught in the blast.\n\nThis spell costs a small amount of the caster's magical energy each turn to\nmaintain, and while it will never aim an explosion where it could hurt the\ncaster, the caster's allies (and anything else in the general vicinity) are not\nso fortunate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:funeral dirge spell"
msgid "A ritual chant that briefly rouses several nearby undead allies to move more\nswiftly and strike with greater might.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:galvanic breath spell"
msgid "<Galvanic Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:gell's gavotte spell"
msgid "Briefly reorients local gravity to be in a cardinal direction of the caster's\nchoosing, causing all creatures in sight to tumble a short distance in that\ndirection.\n\nThe caster is not immune to the gravitational effects of this spell, but will\nbe cushioned so they take no collision damage. Other creatures are not so\nfortunate, and the abrupt impact will batter anything which was not already\nstanding beside its new 'floor'.\n\nIt takes a short time for gravity to stabilise enough to recast this spell,\nthough more powerful mages are able to do so more frequently.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ghostly fireball spell"
msgid "Hurls an exploding ball of negative energy which drains any living creature\nit engulfs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ghostly sacrifice spell"
msgid "Uses an ally's motivating essence to create a blast of negative energy,\ndraining any living creature it engulfs. The being used to fuel the spell, no\nmatter whether living or construct, is consumed and unmade in the process.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:glacial breath spell"
msgid "<Glacial Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:glaciate spell"
msgid "Conjures forth a mighty blast of ice. Creatures within its cone-shaped area of\neffect take damage, with higher damage being dealt to those close to the\ncaster. Those hit by the blast are encased in ice, slowing their movement, and\nthose killed by the blast may be frozen into solid blocks of ice. Half of its\ndamage bypasses cold resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:gloom spell"
msgid "Emits a wave of pernicious gloom which attempts to smother the light around\nnearby creatures. Any living, demonic or holy creature caught in the effect may\nbriefly lose their eyesight and be left stumbling blindly.\n\nWillpower is useless against this spell, but stronger creatures may still shrug\noff its effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:grasping roots spell"
msgid "Calls giant grasping roots from deep underground that hold and constrict their\nvictim. The roots will retreat if the victim breaks free or if the caller moves\nout of view.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:grave claw spell"
msgid "Calls forth the spite of the recently dead to skewer a targeted enemy with\nshards of bone. This spell never misses, and will pin its target in place for\nseveral turns, but casting it rapidly consumes the remnants of death that linger\nupon the caster.\n\nYou can stockpile enough malice to cast this spell at most three times, and this\ncan only be replenished by causing the death of a sufficient number of living\nbeings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:infernal servant spell"
msgid "Summons a major demon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:greater ensnare spell"
msgid "Shoots a stream of webbing at a creature, ensnaring them in a sticky web and\nscattering additional webs nearby that dissolve after a short length of time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hailstorm spell"
msgid "Conjures a cannonade of hail, battering nearby creatures that fail to dodge.\nThe eye of the storm is wide enough that monsters adjacent to the caster are\nunaffected. Due to the strong impact and cutting edges, half of its damage\nbypasses cold resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:haste other spell"
msgid "Speeds the actions of a nearby ally.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:harpoon shot spell"
msgid "Fires a long and flexible barbed mass. The ensnared victim will either be\npulled adjacent to the caster or collide with anything blocking the way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:haste spell"
msgid "Speeds the actions of the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:haunt spell"
msgid "Calls wraiths and ghosts to haunt the caster's target. They will only attack\nthe creature they are haunting, and will dissipate quickly once their target\ndies. The number of spectres summoned increases with spell power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hellfire court spell"
msgid "Summons demons of flame and damnation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hellfire mortar spell"
msgid "Splits apart the ground in front of the caster and sculpts a terrifying weapon\nout of molten rock. This mortar will move slowly along the lava-filled chasm,\nautonomously launching gouts of magma at the caster's enemies as it does so.\n\nWhen it reaches the end of its path, or is obstructed in its movement by another\ncreature, it will sink back into the lava, and the chasm will seal itself shut\nshortly thereafter.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:heal other spell"
msgid "Heals a nearby ally.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hunting call spell"
msgid "Inspires nearby allies to quicken their movement.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hurl damnation spell"
msgid "<Hurl Damnation ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hurl sludge spell"
msgid "Conjures a focused blast of highly toxic sludge, poisoning the victim and\ndrenching their surroundings. The sludge damages and poisons all monsters,\neven those resistant to poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hoarfrost bullet spell"
msgid "Fires a shard of ice that coats whatever it hits with a layer of brittle frost\nwhich slows their movement.\n\nEach shot fired will deplete the cannon's remaining durability, but if it\nsurvives to fire 5 times, the final shot will fragment to hit all enemies around\nthe primary target for additional damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hoarfrost cannonade spell"
msgid "Sculpts a pair of icy cannons that assail the caster's enemies from long range.\nThe frigid shards they fire rapidly coat their targets with a layer of brittle\nfrost which slows their movement.\n\nThe cannons are short-lived and consume a part of themselves with every shard\nthey fire, but if they survive to fire their final salvo without interference,\nit will be extra-powerful.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:holy breath spell"
msgid "Exhales a large cloud of blessed flame, shining with the glory of the good\ngods. These flames are especially dangerous to undead and demonic creatures,\nand have no effect on holy creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:holy flames spell"
msgid "Traps an enemy in a ring of blessed flame. These flames are especially\ndangerous to undead and demonic creatures, and have no effect on holy\ncreatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:hurl torchlight spell"
msgid "Hurls a gout of umbral torchlight which deals irresistible damage to living,\ndemonic, and holy beings. The torchlight will also briefly empower any friendly\nundead caught in its blast and is harmless to those who worship Yredelemnul.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:iceblast spell"
msgid "Fires a large mass of ice, which explodes on impact. Half of its damage\nbypasses cold resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ignite poison spell"
msgid "Converts all nearby poison into liquid flame, burning poisoned creatures from\nwithin. It also turns clouds of poison and mephitic gases into flame. The\ncaster is not affected directly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ignition spell"
msgid "All foes in the caster's surroundings are engulfed in balls of fire. The caster\nand their allies are protected from the fire and will never be harmed by this\nspell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ill omen spell"
msgid "Bends the weave of fate against a target, inflicting significant Doom. Cannot\nbe used if there are any obstructions between the caster and their target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:infestation spell"
msgid "Calls forth a plague of scarabs, infesting affected creatures for a duration\ndepending on power and causing death scarabs to grow and burst from them upon\ndeath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:injury bond spell"
msgid "Binds the caster to nearby allies, reducing all damage they take by half in\nexchange for suffering half of the prevented damage themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:injury mirror spell"
msgid "Reflects damage taken for a short duration, hurting attackers whenever the\ncaster takes any damage. After the duration wears off, the caster cannot cast\nthis spell again for a short while.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ink cloud spell"
msgid "Releases a thick cloud of ink to obscure vision.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:inner flame spell"
msgid "Fills an enemy with an intense fire. This fire is released any time the target\nis hit, and explosively released upon death. The size of the explosion caused\nis dependent on the size of the target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:invisibility spell"
msgid "Turns the caster invisible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:invisibility other spell"
msgid "Turns a nearby ally invisible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:iron shot spell"
msgid "Hurls a large and heavy metal shot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:irradiate spell"
msgid "Transmutes an ultra-thin layer of the caster's skin (or equivalent) directly\ninto pure magical energy, blasting adjacent creatures. It may heavily deform\nits victims, weakening them and reducing their armour. The caster is not left\nentirely unaffected; some of the magic lingers, enough to leave them\ndangerously contaminated after a few castings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:iskenderun's battlesphere spell"
msgid "Conjures a small globe of destructive energy. Each time its creator casts a\noffensive spell, the battlesphere will also fire an unerring volley of energy at\nthe most injured nearby foe it can reach.\n\nThe battlesphere's creator can freely fire through its position without harming\nit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:iskenderun's mystic blast spell"
msgid "Detonates a crackling sphere of destructive energy. The explosion will hit all\nnearby monsters with physical force, knocking them back if damage is done.\nSpellpower increases damage and knockback distance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:jinxbite spell"
msgid "Calls the attention of trickster spirits. While it holds, the spirits will\nfollow up on the caster's attacks. If the spell overcomes victims' willpower,\nthey will suffer minor damage and be drained by the sprites' playful malice.\n\nFae assistance is fickle, however; they cannot be beckoned unless a susceptible\nvictim is visible, and will depart rapidly once no more remain. Calling on the\nfae also reduces the caster's own willpower for a time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:kinetic grapnel spell"
msgid "Weaves a thin kinetic filament around the caster's melee weapon and launches the\nother end of it at a nearby enemy. If this grapnel successfully hits and does\ndamage, it will become lodged in them, allowing the next melee attack the caster\nperforms against them to strike with perfect accuracy and a small slaying bonus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:volatile blastmotes spell"
msgid "Brings forth a cloud of volatile blastmotes around the caster. These explode\non contact with open flame or with creatures - including any caster foolish\nenough to linger in them! The explosion is concussive, knocking adjacent\ncreatures away. Damage done rises with the spell's power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:landbreaker spell"
msgid "Violently fractures the landscape, causing rubble to fall upon several nearby\nenemies and also the ground behind them - obstructing their path to flee the\ncaster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:launch bomblet spell"
msgid "Fires a bomblet on a ballistic trajectory that ignores line of fire, dealing\nminor damage to a single target within range and deploying the bomblet near it.\n\nCannot target enemies adjacent to the caster or those with no nearby room for\nthe bomblet to land.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:launch clockwork bee spell"
msgid "Constructs a mechanical bee and winds its clockwork mechanisms over several\nturns before unleashing it against a targeted foe. The bee is swift and\npowerful, but its clockwork quickly winds down as it attacks, eventually leaving\nit helpless and unable to move.\n\nThe caster may repair and rewind a dormant bee by attempting to move into it, at\nthe cost of 1 MP.\n\nSpellpower increases the number of attacks the bee may perform before going\ndormant.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:launch sporangium spell"
msgid "Launches a caustic sporangium which will pursue any intriguing sources of\nnutrients - such as yourself - and engulf them in a massive acidic explosion.\nNascent plasmodia, capable of firing acid of their own, may take root on any\nwalls this explosion touches - though none within 2 tiles of any other.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:leda's liquefaction spell"
msgid "Liquefies the ground around the caster, making it difficult to move through.\nAny movement through liquefied ground will be slowed, and creatures stuck in\nthe liquefied ground will be unable to fly. Attempts to attack the caster\nin melee may fail.\n\nThe effect starts out with a radius depending on power, which will then shrink,\neventually covering only the caster, before it times out. Maintaining the\nconnection to the ground slows the caster's movement, even if they are flying.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:lee's rapid deconstruction spell"
msgid "Fragments a wall or a suitably brittle visible monster into an explosion of\ndeadly shrapnel. It can be used on monsters made of ice, bone, or any wall-like\nsubstance, as well as those turned to stone by petrification. Its damage is\nstrongly reduced by armour.\n\nTargets made from rock, stone, ice or bone will cause a small explosion. Metal\ntargets will cause a small but more damaging explosion, and targets made from\ncrystal will cause a large and more damaging explosion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:legendary destruction spell"
msgid "Conjures two explosive magical effects in instant succession. The effects can\nbe any mix of Fireball, Iceblast, and Ghostly Fireball.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:lehudib's crystal spear spell"
msgid "Hurls a lethally sharp shard of crystal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:lesser beckoning spell"
msgid "Beckons the target forward, attempting to place them adjacent to the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:lightning bolt spell"
msgid "Fires a mighty bolt of lightning. Its damage bypasses half of defenders'\narmour, and it can be bounced off walls to hit targets twice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:magic dart spell"
msgid "Fires a small bolt of magical energy which never misses.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:magma barrage spell"
msgid "Fires penetrating bolts of molten rock at up to two different enemy targets.\nHalf of its damage bypasses fire resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:magnavolt spell"
msgid "Envelops a target in a thin layer of magnetically charged metal fragments, then\nunleashes a powerful surge of electricity that arcs unerringly towards every\nvisible target coated in these fragments - firing an additional beam at each\ntarget thus marked.\n\nMagnetised creatures are additionally unable to evade attacks and will be\nrevealed if invisible. If they die while still coated, they will leave behind a\nshort-lived cloud of electrified metal that will continue to serve as a\nlightning rod for this spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:major destruction spell"
msgid "Shoots a random harmful beam or explosion at the targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:major healing spell"
msgid "Heals a large amount of damage to the caster's body.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:malign gateway spell"
msgid "Tears a gash in reality, creating a self-sustained but temporary portal to an\nunknown, tainted otherworld. It requires open space to succeed. After a short\ntime, a powerful clawed tentacle will reach through the portal, remaining bound\nto the caster's will for a duration depending on power. With the portal's\nexpiry, the tentacle will be severed and turn on the caster. The duration of\nthe portal increases with spell power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:malign offering spell"
msgid "Drains life from an enemy, healing nearby allies in the process.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:malmutate spell"
msgid "Bestows a mutation on a target. The mutation is almost always harmful. It\ncannot affect artificial beings, and the undead will decompose if affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:manifold assault spell"
msgid "Warps space into paradoxical configurations to strike many visible foes with\none melee attack. Power increases the number of foes attacked with one cast,\nthough unarmed attacks strike only half as many targets at once, as additional\ncare must be taken when warping one's own limbs.\n\nThe time taken for the attack is exactly the same as a normal melee attack.\nAttacks performed this way never miss, but the exact spot struck cannot be\ncontrolled precisely, making them unable to do extra damage against unsuspecting\nfoes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mara summon spell"
msgid "Weaves illusions of the caster. Such illusions have the same physical prowess\nas the original, and can cast the same spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:march of sorrows spell"
msgid "Conjures a stream of stolen suffering, leaving clouds of excruciating misery in\nits wake and around its targets. These clouds of negative energy will rapidly\ndrain the living of small fractions of their maximum health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:marshlight spell"
msgid "Conjures two balls of burning swamp gas adjacent to the caster. The balls will\nrapidly seek the nearest monster and burn them. Wizards attempted to copy this\nwith the spell 'Foxfire', but their version is much less powerful.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:martyr's knell spell"
msgid "Beckons forth the soul of a long-dead martyr to shield your allies for a time.\nThis soul suffers a portion of the damage your allies would otherwise receive.\n\nIf it is slain (again!), it will transform into a flayed ghost, inflicting\nillusory wounds on foes. Such wounds are fleeting, and will disappear when the\nghost departs - unless you kill its victims first.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mass confusion spell"
msgid "Causes confusion in all who gaze upon the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mass regeneration spell"
msgid "Causes all allied monsters nearby to rapidly regenerate over a short period of\ntime. This regeneration is proportional to each of those creature's maximum\nhealth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:maxwell's capacitive coupling spell"
msgid "Gradually builds up electric charge in the caster, so long as they maintain\nfocus (by waiting in place and not taking any other actions). When a threshold\nis reached, the charge couples with the nearest foe, vaporising them instantly.\nHigher spell power will allow the caster to accumulate charge more rapidly. The\nspell requires a visible target to begin accumulating charge, though a different\nfoe may be targeted when the charge is released.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:maxwell's portable piledriver spell"
msgid "Compresses an envelope of space around the caster and an adjacent enemy (or a\ncontiguous line of enemies), then allows it to decompress abruptly, propelling\neveryone forward until the unfortunate being at the far end collides with\nsomething solid, inflicting damage on them proportional to the distance\ntravelled.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mephitic cloud spell"
msgid "Conjures a fragile flask that explodes into short-lived clouds of noxious fumes.\nThese clouds may cause confusion in any creature not resistant to poison.\nTougher, more experienced creatures are less likely to be affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mesmerise spell"
msgid "Attempts to entrance all enemies in sight. Adventurers who fail to resist will\nbecome unable to move away from the caster, while other creatures will become\ndazed outright.\n\nLeaving the caster's line of sight will end the movement-controlling effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:metabolic englaciation spell"
msgid "Lowers the metabolic rate of every creature in the caster's vicinity, slowing\nall those who are not resistant to cold. Cold-blooded creatures will be\naffected much more strongly, and tougher creatures will be slowed for a\nshorter time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:metal splinters spell"
msgid "Fires a burst of metal splinters. Its damage is strongly reduced by armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:miasma breath spell"
msgid "Creates a large cloud of foul pestilence, poisoning and sometimes slowing any\nliving creatures it touches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:might other spell"
msgid "Significantly increases a nearby ally's damage dealt in melee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:might spell"
msgid "Significantly increases the caster's damage in melee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mindburst spell"
msgid "Launches a psychic attack. If it overcomes the victim's willpower, it\n'blows their mind' in a violently literal fashion, dealing damage that\nbypasses their armour entirely. It is useless against mindless creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:minor healing spell"
msgid "Heals a small amount of damage to the caster's body.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:monstrous menagerie spell"
msgid "Summons a powerful exotic creature to the caster's aid: either a manticore, a\nlindwurm, or a sphinx marauder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mercury arrow spell"
msgid "Conjures an arrow of elemental mercury which deals direct poison damage to\nwhatever it hits and may also weaken their melee attacks for a short while.\n\nThe physical force of the arrow inflicts a small amount of damage even to those\nimmune to poison, and the weakening effect can splash to adjacent targets and\nignores poison resistance altogether.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mourning wail spell"
msgid "Exhales a stream of forgotten grief, leaving clouds of excruciating misery in\nits wake but skipping past creatures that would be vulnerable to it. These\nclouds of negative energy will rapidly drain the living of small fractions of\ntheir maximum health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mud breath spell"
msgid "<Mud Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:mutagenic gaze spell"
msgid "Causes mutagenic energy to accumulate in a target, eventually reaching levels\nhigh enough to cause harmful mutations or explosions of unstable magical energy.\n\nThis spell requires line of sight but not line of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:nazja's all-purpose tempering spell"
msgid "Manifests a magical hammer that repairs and temporarily augments the offensive\ncapabilities of any nearby construct - be it golem or phalanx beetle or even\ndancing weapon. This process results in a flurry of sparks, slag, and concussive\nshockwaves that do considerable damage to any enemies adjacent to the targeted\nconstruct, but it cannot be recast upon the same object until the enhancement\nwears off.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:nazja's percussive tempering spell"
msgid "Manifests a magical hammer that repairs and temporarily augments the offensive\ncapabilities of any construct that was created by the caster's own Forgecraft\nspells. This process results in a flurry of sparks, slag, and concussive\nshockwaves that do considerable damage to any enemies adjacent to the targeted\nconstruct, but it cannot be recast upon the same object until the enhancement\nwears off.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:noxious breath spell"
msgid "<Noxious Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:noxious cloud spell"
msgid "Creates a large cloud of noxious fumes, which may cause confusion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:nullifying breath spell"
msgid "<Nullifying Breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:olgreb's toxic radiance spell"
msgid "Causes the caster to radiate toxic energy, continuously inflicting poison on\neverything in line of sight for as long as the spell lasts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:orb of destruction spell"
msgid "Conjures an orb made of pure destructive magic. Compared to most other\nprojectiles, these orbs travel at a relatively slow pace. The orbs home onto\ntheir targets, yet because of their huge inertia, especially agile opponents\nmay be able to outmanoeuvre them. The orbs need some time to stabilise, and a\nnascent orb will deal reduced damage.\n\nResidents of the dungeon are able to maintain the orb until it impacts a\ntarget, but when cast by you the orb will dissipate upon leaving your line of\nsight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:orb of electricity spell"
msgid "Hurls a crackling orb of electrical energy, creating a huge explosion on\nimpact. Its damage bypasses half of defenders' armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ostracise spell"
msgid "Isolates a target from the divine - temporarily reducing their piety in the eyes\nof whichever god they worship and denying them access to any divine abilities\nthat piety would allow. Being repeatedly affected by this spell will reduce the\none's effective piety further and further, but can never directly lead to\nexcommunication.\n\nThis effect will slowly wear off as the afflicted being gains experience,\neventually restoring access to the full piety they once possessed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ozocubu's armour spell"
msgid "Envelops the caster's body in a protective layer of thick ice, granting a\nsubstantial bonus to armour as long as they remain in their current location.\nThe ice will crack and fall away if the caster moves to a new position. The\nspell decreases in effectiveness in heavier armour, granting a lower bonus the\nhigher the encumbrance rating of the caster's armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ozocubu's refrigeration spell"
msgid "Turns the air bitterly cold, freezing all other creatures in line of sight.\nThis is less effective against creatures packed tightly together - those\nadjacent to their allies will be partly insulated from the cold, taking less\ndamage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:pain spell"
msgid "Inflicts an extremely painful injury upon one living creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:paralyse spell"
msgid "Prevents a creature from taking any action for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:paralysis gaze spell"
msgid "Irresistibly prevents a creature from taking any action for a short time,\nrequiring multiple charges but not line of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:passage of golubria spell"
msgid "Opens two gateways (one always near the caster), which allow instantaneous\ntransport to random other open gateways to any creature entering them. There is\nno limit to the number of gateways that can be open at one time. However,\ngateways close a short time after being opened, or immediately once entered.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:passwall spell"
msgid "Allows the caster to travel a short distance through an adjacent rock wall and\nemerge again on the other side. This spell takes an unusally long time to cast,\nduring which the caster will be unable to act, but also gain increased armour\nfrom their attunement to the rock.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:permafrost eruption spell"
msgid "Calls on the ancient cold lurking within the earth to emerge - violently. The\nforce of its emergence blasts rock from the ceiling, smashing into the target\nwith unavoidable force. The cold itself is brief but unbearably bitter,\nbypassing armour entirely as it freezes the target and their neighbours.\n\nIt will always attempt to blast the largest concentration of foes in sight, and\nnever explodes next to the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:petrify spell"
msgid "Petrifies a targeted creature and up to two other foes in a chain. Those which\ndo not muster the Will to resist are briefly slowed, and then turned to stone.\nUntil they return to flesh, they are unable to act, but also take half damage.\nThe spell's power is lessened against secondary targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:petrifying cloud spell"
msgid "Exhales calcifying dust, which petrifies anyone affected for longer than a\nbrief moment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:phantom blitz spell"
msgid "Weaves and fires a phantom copy of the caster with great force. Such phantoms\nhave the same martial and mystic prowess as the caster, and an impromptu night\nparade of illusions may overwhelm the caster's victims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:phantom mirror spell"
msgid "Creates a phantom copy of a creature. The copy will be somewhat fragile, but\notherwise almost indistinguishable from the original.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:planar overlay spell"
msgid "Overlays part of an adjacent reality onto this one, causing random local\nmonsters to appear elsewhere on the floor. The first time this is used, multiple\nmonsters will arrive at once; afterward, they will appear at a slow, steady\nrate.\n\nAfter a considerable amount of time has passed, these monsters may even appear\nnear the player.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:plane rend spell"
msgid "Summons some of the greater threats from one of the Pits of Slime, the Elven\nHalls, the Vaults, the Crypt, the Tomb of Ancients, or the Realm of Zot; the\nspecific branch varies with each cast of the spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:plasma beam spell"
msgid "Fires a penetrating beam of plasma at one of the caster's most distant foes.\nThe ionised beam bypasses half of defenders' armour, and a second beam of fire\nfollows in its wake.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:platinum paragon spell"
msgid "Constructs a gleaming metal champion whose prowess rivals that of the greatest\nliving warriors. It is resistant to all forms of magic and wields a perfect\nreplica of any artefact melee weapon the caster chooses.\n\nIt creates a damaging shockwave around itself when first deployed and slowly\ngains charge as it attacks enemies. When it has gained sufficient charge, the\nspell may be recast to overload the paragon, unleashing a flurry of attacks\nin a wide area which inflict increased damage, but destroying the paragon in the\nprocess.\n\nDue to the magical link it maintains with its creator, it will perform an\nextra attack whenever they do, and will sometimes even parry attacks directed at\nthem, if they are close enough together.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:poison arrow spell"
msgid "Fires a magical arrow coated with the most vile and noxious toxin. Even those\nresistant to poison will be poisoned by it, and a small portion of its direct\ndamage bypasses poison resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:poisonous cloud spell"
msgid "Conjures forth a great cloud of lethal gases.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:poisonous vapours spell"
msgid "Transmutes a small amount of the air around a target into toxic vapours,\npoisoning anyone unfortunate enough to breathe them in. The quantity of air\naffected is small and it will not persist beyond the turn in which it is cast.\n\nIt cannot affect those with any resistance to poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:polar vortex spell"
msgid "Turns the air around the caster into a freezing vortex, doing tremendous damage\nto everyone caught in it that can only be half-mitigated by resistance to\ncold. Those affected will also be swept up into the air and tossed around.\nOnly the eye of the storm is a safe place, and it follows the caster. The\nvortex is unable to follow the caster through long-distance translocations.\nThe spell's effectiveness is greatly diminished in closed areas. After the\nvortex fades, it cannot be called forth again for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:polymorph spell"
msgid "Randomly alters the form of a creature. It is especially effective against\nshape-changing creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:porkalator spell"
msgid "Transforms the target into a pig. The target moves swiftly but cannot cast\nspells. The caster's demise will cause the transformation to end.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:portal projectile spell"
msgid "Teleports a fired or thrown missile at a targeted enemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:prayer of brilliance spell"
msgid "Empowers the magic of nearby wizard allies of the caster, allowing them to\ncast their magic more powerfully and more often.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:primal wave spell"
msgid "Conjures a torrent of water that may knock back the target, and creates a\npool of shallow water for a short duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:pyre arrow spell"
msgid "Launches a glob of liquid fire that clings to a targeted creature, dealing\narmour-ignoring fire damage over multiple turns. The victim can put the fire out\nmuch more quickly by moving.\n\nIf the target is insubstantial, the liquid fire will fail to stick.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:pyroclastic surge spell"
msgid "Draws searing flames from lava. Any enemies of the caster standing\nnext to or above lava will be burned.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:pyrrhic recollection spell"
msgid "Ignites a memory from the nimbus which surrounds Nobody, temporarily granting\nthem the knowledge of a powerful spell and healing their injuries.\n\nThis power is fleeting and will be extinguished after taking any significant\namount of damage, but so long as any other memories remain, they cannot be\nput to rest for good.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:quicksilver bolt spell"
msgid "Fires a bolt of dispelling energy at a targeted creature, possibly removing\nsome of its enchantments.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:ravenous swarm spell"
msgid "Unleashes a torrent of vampire bats, filling the air around a target.\n\nThese vampires will gnaw on anything which isn't undead with a voracious hunger,\nand their bites will eventually even lull their victims to sleep, leaving them\neasy prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:rebounding blaze spell"
msgid "Fires a penetrating bolt of energetic flames that can bounce off walls to hit\ntargets twice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:rebounding chill spell"
msgid "Fires a penetrating bolt of energetic cold that can bounce off walls to hit\ntargets twice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:regenerate other spell"
msgid "Causes another creature to rapidly regenerate over a short period of time.\nThis regeneration is proportional to that creature's maximum health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:rending blade spell"
msgid "Condenses the caster's magical energy into the form of a violently crackling\nblade. Each time the caster successfully hits with a melee attack while the\nspell is active, this blade will rend a path back and forth through nearby foes,\ndealing irresistible damage.\n\nCasting this spell temporarily drains *all* of the caster's remaining magical\npower to constitute the blade, but this energy will be returned to them as soon\nas the blade ceases to exist. Each point of magical power sequestered this way\nslightly increases the damage the blade inflicts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:resonance strike spell"
msgid "Calls a surge of power from the earth, striking an enemy within the caster's\nsight. The spell cascades through nearby constructs, growing in strength with\neach one standing near the target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:rimeblight spell"
msgid "Afflicts a creature (and up to two others near it) with a magical plague that\nslowly freezes them from the inside out. Victims take AC-ignoring cold damage\neach turn, and as the disease progresses, shards of crystalline ice will start\nerupting violently from their body, damaging nearby enemies. When they finally\nsuccumb, the plague may spread to those around them.\n\nIn living, holy, or demonic creatures, the disease is especially virulent,\nfeeding off the necromantic energies released by its host's suffering. As they\napproach the point of death, it will accelerate rapidly, devouring the last\nvestiges of their body and leaving nothing behind but a twisted pillar of\nstygian ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:roll spell"
msgid "Roll into a ball, granting the boulder beetle tremendous speed as well as\ndouble melee damage. The roll may only be performed when at distance from a\nfoe, and the beetle will always unroll after an attempted roll attack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sandblast spell"
msgid "Blasts a target with high-velocity rock shards. Gathering the rock from ambient\ngrit is slow, making this spell take one-and-a-half times as long to cast as\nmost. Its damage is strongly reduced by armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sap magic spell"
msgid "Taints a targeted creature's ability to cast spells. Casting a spell while\nafflicted with this condition causes the target to lose access to their magic,\nbriefly preventing them from casting any further spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:scorch spell"
msgid "Scorches a random foe. Those injured by this have their resistance to fire\nburned away for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sculpt simulacrum spell"
msgid "Forms icy simulacra of an adjacent living, demonic, or holy creature. These\nfragile doppelgangers will take shape over a short period of time, eventually\ngaining the ability to move and attack the caster's enemies.\n\nThe good gods frown on this spell, as it works blood and ichor into unnatural\nfacsimiles.\n\nYou can maintain up to 5 simulacra simultaneously.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:seal doors spell"
msgid "Imparts seals on nearby doors and stairs, preventing those not allied with\nthe caster from traversing them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:searing ray spell"
msgid "Fires a continuous piercing ray of arcane energy from the caster's hands. So\nlong as the caster maintains focus upon the spell and supplies it with magical\npower (by waiting in place and not taking any other actions), the ray will\nfollow the caster's target if it should move.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:searing breath spell"
msgid "Breathes a blast of fire at a targeted creature, leaving a cloud of flames at\nthe endpoint.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:seismic stomp spell"
msgid "Stomps heavily upon the ground, sending out violent shockwaves that fracture the\nground beneath multiple nearby enemies. Flying creatures take greatly reduced\ndamage from this attack, but those on the ground may sometimes to lose their\nfooting altogether, delaying their next action as they struggle to regain\nbalance on the uneven terrain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sentinel's mark spell"
msgid "Bestows a strong beacon upon a targeted creature. It announces the presence\nand location of the marked creature to everyone on the same level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:seracfall spell"
msgid "Violently collapses a nearby simulacrum into a large mass of ice, which\nexplodes on impact. The ice affects even cold-resistant creatures somewhat, due\nto the strong impact and cutting edges.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadowball spell"
msgid "Hurls a ball of flickering shadows, which explodes in a small area.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow beam spell"
msgid "Fires a penetrating beam of shadow.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow bind spell"
msgid "Pins several random nearby enemies to their own shadows, briefly preventing them\nfrom moving. At higher spellpower, it affects more enemies at once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow creatures spell"
msgid "Creates replicas of creatures native to the caster's current location, weaving\nthem from shadows and threads of Abyssal matter.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow draining spell"
msgid "Forcefully steals a sliver from the shadows of all nearby enemies, causing\ndamage which bypasses the victim's armour entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow prism spell"
msgid "Conjures a shadowy prism which will unleash a violent blast of shadows after a\nshort duration. If destroyed prematurely, this blast will be much weaker.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow puppet spell"
msgid "Summons a servant of living shadow to harass and constrict the caster's enemies.\nThe strength of its attacks is directly increased by spellpower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow shard spell"
msgid "Fires a shard of hardened shadow at a single enemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow shot spell"
msgid "Fires a small bullet of hardened shadow at a single enemy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow tempest spell"
msgid "Calls down shadowy lightning upon up to half of all visible enemies, dealing\nirresistible damage to them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow torpor spell"
msgid "Saps the energy from a line of enemies, slowing them for a short while.\nSpellpower increases the duration of this effect, but stronger creatures may\nshake off their lethargy more quickly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shadow turret spell"
msgid "Forms a stationary turret of solidified shadow that repeatedly fires upon the\ncaster's enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shatter spell"
msgid "Causes an enormous burst of concussive force around the caster, dealing severe\ndamage to all nearby creatures. It is especially effective against those made\nfrom ice, bone, or any wall-like substance (such as rock, metal or crystal), as\nwell as those turned to stone by petrification. It is less effective against\nflying, gelatinous and insubstantial creatures. It may also destroy nearby\nwalls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sheza's dance spell"
msgid "Summons weapons from far and wide - a dagger newly forged, a sword long-rusted\nin a moldering tomb, an axe still steaming with the blood of its victim -\nanimating them and sending them out to attack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shock spell"
msgid "Throws a bouncing bolt of electricity. It bypasses half of defenders' armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:shred spell"
msgid "Spins in place, dealing grievous damage to adjacent enemies with its serrated\nbody.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sigil of binding spell"
msgid "Creates two sigils nearby. Anyone who passes over them will be bound, able to\nact and dodge normally but unable to move away. When the effect wears off,\ntheir movement speed will rebound, giving them temporary swiftness. Swiftness\nfrom any source grants immunity to binding.\n\nOnly one set of sigils can be maintained at a time, and they will expire\nprematurely if they leave your sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sign of ruin spell"
msgid "Inflicts the sign of ruin upon a group of enemies, condemning their bodies to\ninexorable decay and collapse. Whenever anything bearing this sign receives\ndamage from a melee attack, they will suffer heavy draining and may additionally\nbecome either slow, weak, or blind.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:silence spell"
msgid "Eliminates all sound near the caster. This makes reading scrolls, casting\nspells, invoking divine abilities, or shouting impossible in the caster's\nvicinity.\n\nCertain monsters have innate magical or special abilities which will still be\nusable while silenced.\n\nThe effect starts out with a radius depending on power, which will then shrink,\neventually covering only the caster, before it times out.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:siphon essence spell"
msgid "Torments nearby living foes, cutting their health in half. This damage is never\ndirectly lethal. The pain inflicted then heals the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:siren song spell"
msgid "Sings a haunting song that mesmerises nearby listeners. Adventurers who fail to\nresist will become unable to move away from the singer, while other creatures\nwill become dazed outright.\n\nLeaving the caster's line of sight will end the movement-controlling effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sleep spell"
msgid "Puts a targeted creature to sleep. Taking damage will typically wake the\ntarget, and loud sounds can potentially do so as well.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sleetstrike spell"
msgid "Causes the air around a creature to twist itself into a whirling vortex of\nfrigid meteorological fury, encasing the victim in ice and slowing their\nmovement briefly. It does more damage to targets surrounded by empty space and\nhalf of its damage bypasses cold resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:slow spell"
msgid "Slows the actions of a creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:slug dart spell"
msgid "Fires a sharp dart of hardened chitin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:smiting spell"
msgid "Smites any targeted enemy within sight, with no direct line of fire required.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sojourning bolt spell"
msgid "Breathes a penetrating and unstable bijection burst. If it hits, it may teleport\nvictims after a short delay. For particularly interesting morsels of adventurers\nsuch as yourself, this teleport will translocate those victims towards the\ncaster's allies and bring the caster along for the ride, if possible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:soul splinter spell"
msgid "Attempts to force a tiny fragment of a living, holy, or demonic being's soul to\ntake leave of their body and manifest as a soul wisp. This wisp is nominally\nunder the necromancer's control, but will focus its attacks foremost on the\ncreature it was created from, instinctually trying to return to its proper home\nonce more. The victim will be weakened until the wisp reverts to where it\nbelongs.\n\nWisps created from more powerful souls have more damaging attacks, but are\nalways fragile.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:spawn tentacles spell"
msgid "Extends large tentacles to attack nearby enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:spectral cloud spell"
msgid "Creates a cloud of spectral mist, dealing minor damage to all creatures other\nthan the undead. Dangerous but short-lived spectral undead creatures will\ncoalesce from the mist over time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:spellspark servitor spell"
msgid "Constructs a metallic servant with a spark of the caster's own arcane knowledge\nat its core. This spark allows the servitor to unleash some of the destructive\nspells known to its creator, though the strongest and most volatile\nof magics cannot be imbued in this fashion. The strength of the servitor\nincreases with spell power.\n\n(While you know this spell, you may choose which of your eligible spells it will\ncast with the Imbue Servitor ability.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sphinx sisters spell"
msgid "Summons a pair of riddling sphinxes - one guardian and one marauder - to\ndebilitate the caster's enemies with hexes and batter them with violent winds.\n\nSpell power increases the sphinxes' durability and the power of their spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:spit acid spell"
msgid "Spits acid at a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:spit lava spell"
msgid "Spits lava at a targeted creature. Half of its damage bypasses fire resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:spit poison spell"
msgid "<Spit Poison ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:splinterfrost shell spell"
msgid "Constructs a frangible shell of reinforced ice in a half-circle around the\ncaster, pushing creatures out of the way to make space for it, if possible.\n\nThis barricade is durable, and whenever a segment of it is destroyed, will\nfracture into a salvo of icy projectiles launched at whatever destroyed it.\n\nIf the caster strays too far away from their barrier, it will melt rapidly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:splinterspray spell"
msgid "Fires a burst of wooden splinters. Its damage is strongly reduced by armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sporulate spell"
msgid "Releases a fast, gas-filled floating spore. After seeking out its foe, the\nspore will explode, damaging anything caught in the blast and further confusing\nliving creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:starburst spell"
msgid "Releases penetrating bolts of fire from the caster in every direction.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:static discharge spell"
msgid "Releases electrical charges against those next to the caster. These may arc to\nother adjacent creatures, or back to the caster, before eventually grounding\nout. It deals reduced damage when arcing to the caster, and the damage dealt\nbypasses half of defenders' armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:steam ball spell"
msgid "Throws a ball of hot steam towards a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:steam breath spell"
msgid "<Steam breath ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sticks to snakes spell"
msgid "Casts forth sticks and transforms them into snakes. Stronger casters will always\ncreate stronger snakes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sticky flame spell"
msgid "Unleashes a short-ranged spray of incendiary goo that clings to an adjacent\ncreature and deals armour-ignoring fire damage over several turns. If the victim\nis allowed to move, it will put out the fire prematurely.\n\nIf the target is insubstantial, the liquid fire will fail to stick.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:still winds spell"
msgid "Brings the air into unnatural stillness across a huge area, preventing anything\nshort of a polar vortex from breaking the calm. The effect takes concentration\nto maintain, and only lasts a short time; if the caster is killed, clouds will\nbegin to form again as normal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sting spell"
msgid "Conjures a jagged shard of crystallised toxins. The stinger's impact will always\npoison a susceptible target. Even resistant targets have a chance to be poisoned\nand immune monsters will still be damaged by the physical impact of the stinger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:stoke flames spell"
msgid "Adds malice to hellish fires, binding it with flame into a creeping inferno.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:stone arrow spell"
msgid "Fires a sharp spine of rock.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:strip willpower spell"
msgid "Greatly reduces the target's willpower, making them more vulnerable to a\nvariety of magical effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:stunning burst spell"
msgid "Fires a weak electrical burst which, on impact, causes very brief paralysis.\nWillpower is of no use against this effect, but resistance to electricity can\nsometimes prevent it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:sublimation of blood spell"
msgid "Converts some of the caster's blood into magical energy. The process is painful\nbut never directly lethal. The efficiency of the conversion increases with the\nspell's power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon air elementals spell"
msgid "Summons one or more air elementals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon cactus giant spell"
msgid "Summons a warrior from a particularly prickly tribe. Foes that strike these\ngiants in melee are in for a painful surprise! When cast at a higher power,\nolder, more robust warriors will answer the call.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon demon spell"
msgid "Opens a gate to the realm of Pandemonium and draws forth one of its inhabitants\nto serve the caster for a time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon dragon spell"
msgid "Summons and binds a powerful dragon to perform the caster's bidding. At high\npower it may summon particularly deadly varieties of dragon, or multiple lesser\ndragons at once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon drakes spell"
msgid "Summons multiple drakes and lindwurms.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon earth elementals spell"
msgid "Summons one or more earth elementals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon emperor scorpions spell"
msgid "Summons multiple noble and monstrous emperor scorpions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon executioners spell"
msgid "Summons multiple Executioners to tear apart foes of the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon eyeballs spell"
msgid "Summons multiple floating eyeballs that may be able to vitrify, polymorph,\nconfuse, mutate or disintegrate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon fire elementals spell"
msgid "Summons one or more fire elementals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon forest spell"
msgid "Forcefully intersects a forested plane with this world. It requires open space\nto succeed. While the spell holds, a spirit of the forest will be called forth,\nand the trees of the forest will be awakened to deal damage to nearby enemies.\nSpell power increases the duration, size, and thickness of the intersected\nplane; as well as the strength of the spirit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon greater demon spell"
msgid "Calls forth one of the greater demons of Pandemonium to serve the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon sin beast spell"
msgid "Summons a deadly sin beast.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon hell sentinel spell"
msgid "Summons a Hell Sentinel, a nightmarish edifice of animated hate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon holies spell"
msgid "Calls forth divine warriors to aid the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon horrible things spell"
msgid "Opens a gate to the Abyss and calls through two or more hideous abominations\nfrom that dreadful place. While powerful, brushing one's mind against the fabric\nof the Abyss in this manner invites Doom upon the caster and may eventually cost\nthem greatly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon hydra spell"
msgid "Summons a many-headed hydra to fight alongside the caster for a short time.\nSpell power determines the number of heads.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon ice beast spell"
msgid "Calls forth a beast of ice to serve the caster. The strength of the beast\ndepends on spell power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon illusion spell"
msgid "Summons a temporary mirror image of an enemy. Such a copy has the same physical\nprowess as the original, and can cast the same spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon mana viper spell"
msgid "Summons a violet-scaled serpent whose bite can swiftly drain the magical\nreserves of nearly any foe. At higher power, the antimagic properties of the\nviper's bite grow even stronger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon minor demon spell"
msgid "Summons between one and three minor (rank 5) demons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon mortal champion spell"
msgid "Calls forth one of the mightiest and fastest mortal champions of the Shining\nOne. In this Dungeon, spriggan defenders and deep elf blademasters will answer\nthe call.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon mushrooms spell"
msgid "Summons wandering mushrooms and deathcaps next to a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon scarabs spell"
msgid "Calls forth a swarm of death scarabs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon scorpions spell"
msgid "Calls forth a swarm of venomous scorpions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon seismosaurus egg spell"
msgid "Summons the egg of a brutish lizard, just on the verge of hatching. So long as\nthere are foes nearby and the caster remains adjacent to the egg, it will hatch\nseveral turns after being summoned to wreak havoc upon its summoner's foes.\n\nEven as a juvenile, a seismosaurus is a force to be reckoned with. It is nearly\nas hardy as a mountain, and its footfalls are capable of creating violent\nseismic shockwaves. Each shockwave deals considerable damage to non-flying\nenemies, and may sometimes even cause them to lose their footing altogether.\n\nSpell power increases the egg's durability and the strength of the seismosaur\nwithin, but not the time it takes to hatch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon small mammal spell"
msgid "Summons a rat, bat, or quokka to the caster's aid. Spell power increases the\nchance of summoning a quokka.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon spiders spell"
msgid "Summons one or more spiders.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon tzitzimitl spell"
msgid "Summons a tzitzimitl, a demon of disease and despair.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon ufetubus spell"
msgid "Summons multiple ufetubi; small, annoying demons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon undead spell"
msgid "Summons multiple undead monsters, creating various ghosts, vampires, wraiths\nand other lesser undead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon vermin spell"
msgid "Summons multiple rats, spiders, worms, and frogs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:summon water elementals spell"
msgid "Summons one or more water elementals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:swiftness spell"
msgid "Calls forth winds to greatly increase the caster's movement speed. After the\neffect ends, the caster's movements will be sluggish for a time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:symbol of torment spell"
msgid "Calls on the powers of darkness to cause agonising injury to any living or\nholy thing in the caster's vicinity, cutting their health in half (partially\nresisted by negative energy resistance). This damage is never directly lethal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:teleport other spell"
msgid "Attempts to teleport a targeted creature out of the caster's sight, after a\nshort delay.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw ally spell"
msgid "Throws a nearby ally at the monster's foe, doing minimal damage and landing the\nthrown monster nearby.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw barbs spell"
msgid "Fires a volley of barbs at the target, skewering them and making movement\npainful.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw bolas spell"
msgid "Hurls a colossal bolas at the target, wrapping around even the largest of foes\nand binding them in place.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw flame spell"
msgid "Throws a small puff of flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw frost spell"
msgid "Throws a small puff of frost.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw icicle spell"
msgid "Fires a shard of ice. Due to its strong impact and cutting edges, half of its\ndamage bypasses cold resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:throw klown pie spell"
msgid "Throws a harmful yet strangely delicious pie that can inflict its victim with a\nnumber of irresistible and debilitating temporary effects. These include\ninducing vertigo, silence, fire vulnerability, fragility, blindness, or an\naversion to drinking potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:thunderbolt spell"
msgid "Creates an arc of electricity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:trog's hand spell"
msgid "<Trog's Hand ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:kiss of death spell"
msgid "Conjures forth a fragment of the caster's essence and twists it into a fragment\nof death, painfully draining the victim. The caster, too, will find their health\nreduced, until they gain enough experience to recover.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:tukima's dance spell"
msgid "Animates the weapon of a targeted foe, ripping it from their hands and causing\nit to attack them relentlessly. Once the target dies, the weapon will fall to\nthe ground shortly thereafter.\n\nCertain powerful named artefacts cannot be animated, and any properties that\nrequire skill in evocations will not be active.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:upheaval spell"
msgid "Calls on the forces of nature to blast a small area with magma, ice, wind,\nor rubble.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vampiric draining spell"
msgid "Steals the life of an adjacent living creature and grants it to the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vanquished vanguard spell"
msgid "Calls out to the lingering souls of orcs who died in earlier ages, and, for a\nbrief moment, gives them purpose in battle once again.\n\nMore anchored to their past lives than most spectrals, they wield polearms with\nliving skill, and will encircle their quarry with cold efficiency.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:venom bolt spell"
msgid "Fires a penetrating bolt of poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vex spell"
msgid "Attempts to cloud the target's mind with thoughtless frustration, forcing them\nto spend several turns doing nothing but attacking nearby spaces (whether those\nspaces are empty or even contain their allies).\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:virulence spell"
msgid "Makes a targeted creature more vulnerable to poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:momentum strike spell"
msgid "Blasts a target with energy borrowed from the caster's own future movement. For\na short time afterward, the caster will be left immotile - unable to walk, fly\naround, slither, etc. Only motile creatures can cast this spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vhi's electric charge spell"
msgid "Sends the caster hurtling at a chosen nearby enemy, launching a high-accuracy\nmelee attack on arrival. Additional electric damage will be dealt based on the\nlength of the charge, the power of the spell, and the physical damage of the\nattack. The caster is wrapped in an envelope of twisted space, allowing them\nto safely pass through creatures, traps, and harmful terrain, and to displace\ncreatures at their destination. The time taken by the spell is the greater of\nthe time normally needed to cast a spell or that needed to launch one melee\nattack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vhi's electrolunge spell"
msgid "Sends the caster hurtling at a chosen nearby enemy, launching a high-accuracy\nmelee attack on arrival, with additional electrical damage based on spellpower.\nThe caster is wrapped in an envelope of twisted space, allowing them to safely\npass through creatures, traps, and harmful terrain, and to displace creatures at\ntheir destination.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vitrify spell"
msgid "Renders a creature's body structure as brittle and fragile as glass, increasing\nthe damage they take from all sources.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:vitrifying gaze spell"
msgid "Irresistibly renders a creature's body structure as brittle and fragile as\nglass, increasing the damage they take from all sources. It requires line of\nsight but not line of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:volley of thorns spell"
msgid "Launches a small hail of sharp thorns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:wall of brambles spell"
msgid "Causes brambles to rapidly grow nearby. They have almost no structural\nstrength, but the wicked thorns they bear make their removal difficult. Such\nbrambles are sparse enough that almost any missile can pass through unhindered.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:warning cry spell"
msgid "Generates a loud noise, alerting nearby enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:warp body spell"
msgid "Twists a creature's body with mutagenic corruption, doing a small amount of\ndamage and inflicting a transient mutation. If the target is already suffering\nfrom multiple transient mutations, it will inflict Vitrify instead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:warp space spell"
msgid "Creates a brief but violent rift in space, damaging everything caught in its\nwake and sometimes blinking them a short distance away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:waterstrike spell"
msgid "Causes the water around or under the target to violently swirl, dealing damage.\nIt can affect targets standing in or flying above water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:weakening gaze spell"
msgid "Irresistibly weakens a creature's melee attacks for a period of time,\nrequiring line of sight but not line of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:wind blast spell"
msgid "Causes a strong gust of wind, pushing away creatures and clouds in a cone. If\nthis causes a creature to collide with something, it will take damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:woodweal spell"
msgid "Draws on the vitality of leaf and bark to heal a large amount of damage.\nCannot be cast without a tree adjacent.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:word of recall spell"
msgid "Recalls intelligent allies from elsewhere on the same level to the caster,\nafter a short delay.\n"
msgstr ""

#: crawl-ref/source/dat/descript/spells.txt
msgctxt "textdb:descript/spells.txt:yara's violent unravelling spell"
msgid "If cast upon a creature already blessed (or cursed) with magical enchantments,\nthose enchantments will be torn apart, transforming into a spray of\ndestructive mutagenic radiation. The victim and anyone adjacent will be\nblasted and heavily deformed, weakening them and reducing their armour.\nSummoned creatures are particularly vulnerable, as the enchantments binding\nthem to this plane will unravel and cause them to be dismissed immediately.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:no ability ability"
msgid "If you get this description, it is a bug.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:spit poison ability"
msgid "Spits poison at a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:combustion breath ability"
msgid "Breathes a blast of volatile embers that explode violently around each creature\nthey touch. It is harmless to its user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:glacial breath ability"
msgid "Exhales a powerful wave of frost which encases anything it kills in a solid\nblock of durable ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:nullifying breath ability"
msgid "Breathes a large blast of pure antimagic that dispels magical effects from\nevery creature it hits and also significantly interferes with their ability to\ncast spells for a while. It is harmless to its user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:steam breath ability"
msgid "Breathes a powerful blast of steam, scalding a target and leaving\nsight-obscuring steam clouds in its wake.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:galvanic breath ability"
msgid "Exhales a charged burst of electricity that will arc through a target and every\nother creature that is connected to it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:mud breath ability"
msgid "Spits an enormous ball of mud that knocks back whatever it hits and drenches the\nsurrounding area in a mud slick which impedes enemy movement and causes them to\nsometimes fumble their attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:caustic breath ability"
msgid "Breathes a spray of concentrated acid which leaves corrosive clouds on any\nunoccupied tiles it passes over and corrodes whatever it hits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:noxious breath ability"
msgid "Breathes a line of noxious vapour which can confuse anything standing in it\nwhich does not resist poison. At higher levels, the clouds can cover a larger\narea and last longer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:breathe fire ability"
msgid "Breathes a blast of fire at a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:breathe poison gas ability"
msgid "Breathes a blast of poison gas at a targeted creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:invent gizmo ability"
msgid "Uses your peerless coglin ingenuity to invent and assemble a one-of-a-kind\npiece of equipment and permanently install it in yourself. Such inspiration\ndoes not strike twice, so choose wisely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:hurl damnation ability"
msgid "Blasts a targeted enemy with damnation. These unholy forces harm the victim and\nanyone adjacent, and are not affected by any means of protection, such as armour\nor resistances. However, certain creatures, usually those able to invoke\ndamnation themselves, are entirely unscathed by damnation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:word of chaos ability"
msgid "Speaks a word of chaos, forcing enemies nearby to blink away from the user.\nAdditionally, those affected may be slowed, ensnared, or terrified by the\nexperience. Invoking a word of chaos is no easy feat and will drain the user's\nmaximum health somewhat, and the ability then cannot be used again for a short\ntime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:heal wounds ability"
msgid "Heals the user significantly, with a chance of permanently reducing the user's\nmaximum magic capacity by one.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:dig ability"
msgid "Allows making tunnels through soft rock and rusted grates. Activating the\nability has no cost and simply prepares you to start digging; once active,\nmoving into a wall will start tunnelling. Doing so makes some noise and drains\nthe user's maximum health.\n\nOnce active, activating the ability again or making any non-digging movement\naction will cancel the Dig status.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:shaft self ability"
msgid "Sends you to a random position one to three floors down, as if you jumped into\na shaft trap. It takes some time to dig the shaft.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:evoke blink ability"
msgid "Randomly translocates the user a short distance. After translocating in this\nway, the ability cannot be activated again for a short period of time depending\non Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:evoke berserk rage ability"
msgid "<Berserk ability>\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:evoke invisibility ability"
msgid "Turns the user invisible for a short period of time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:end transformation ability"
msgid "Reverts you to your normal form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:begin untransformation ability"
msgid "Begins to transform you back into your native form. A short period of\nconcentration is required.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:imbue servitor ability"
msgid "Chooses one of the caster's destructive spells to grant to Spellspark Servitors\nthey create in the future, replacing any spell granted to them previously. The\ncaster must be capable of casting this spell themselves with a failure rate of\nno more than 20%.\n\nNote: imbuing a spell in this manner will take several turns and also dismiss\nyour servitor if it is active.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:imprint weapon ability"
msgid "Analyzes the structural composition of an artefact melee weapon in your\ninventory and imprints it upon your Platinum Paragon spell, allowing it to wield\na functional replica of it whenever you create one.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:cacophony ability"
msgid "Fully manifests your poltergeist nature, making all the armour you are haunting\nfly out and attack independently of your other actions for a short while - boots\nand scarves and helmets assailing your foes from all directions while a gleeful\ndin fills the air.\n\nThese items are still tethered to you and cannot be directed more than a short\ndistance away, but you do not share any damage they suffer and can freely fire\nthrough them. Their attacks may inflict a variety of minor maladies on your\nfoes - sometimes dazing, draining, or even confusing them.\n\nAfter using this ability, you must gain experience points before you can recover\nenough power to use it again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:bat swarm ability"
msgid "Scatters your physical form into a swarm of vampire bats, melding your equipment\nbut allowing you to move quickly and evasively. The number of bats that issue\nfrom your body is so immense that it even fills nearby spaces like a choking\ncloud, assailing enemies and gradually putting them to sleep.\n\nAfter using this ability, you must gain experience points before you can recover\nenough power to use it again. (Shapeshifting skill will increase the rate at\nwhich this skill recharges.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:enkindle ability"
msgid "Stokes your ghostly flames to a fever pitch, greatly enhancing your spellcasting\nat the cost of burning away all accumulated memories.\n\nWhile in this state, your damage-dealing spells cost no MP, are unaffected by\nencumbrance, and you receive a bonus to their spell success and power (the\nlatter of which increases with your experience level). Any spellclaw attack made\nwhile Enkindled inflicts bonus damage proportional to the level of spell cast,\nand heals you for a percentage of the damage dealt.\n\nEach spell you cast while Enkindled consumes a memory, and the state will end\nonce you have no more left (or after a short period of time, regardless).\n\nAt your current experience level, you can hold enough memories to cast a maximum\nof {{return 3 + math.floor(you.xl() * 3 / 20);}} spells in a row this way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:breathe rust ability"
msgid "Exhales a blast of oxidizing vapour that continuously corrodes and weakens the\nattacks of creatures which stand inside it. These clouds are long-lasting, but\ndo only minimal damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:golden breath ability"
msgid "Exhales a powerful blast of elemental devastation, which inflicts both fire and\ncold damage, and leaves clouds of poisonous vapour in its wake.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:recite ability"
msgid "Preaches to nearby monsters about Zin's laws for a short duration. After\nfinishing a recitation, it cannot be repeated for a short time.\n\nThe recitation will have different effects depending on the target: the chaotic\nand unclean will be affected by powerful and damaging effects, undead and\ndemons will be affected by weaker rebukes, and any other intelligent creatures\nwill have confusion sown amongst them, with heretics and priests of gods other\nthan Zin being punished much more strongly. The effectiveness of the recitation\nis increased by Invocations skill and piety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:vitalisation ability"
msgid "Temporarily provides protection from poison, confusion, petrification, and\nsickness, as well as the effects of clouds of foul pestilence. Your strength,\nintelligence and dexterity are also temporarily increased by a degree dependent\non Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:imprison ability"
msgid "Temporarily imprisons a monster in walls of silver. The duration of the prison\nis increased by Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sanctuary ability"
msgid "Transforms the area around the user into a domain of unbreakable law for a short\nduration. So long as anyone stands within this sanctuary, no harm may be done to\nthem by others, and they may do no harm to others in turn.\n\nBeings with hostile intent are unable to enter a sanctuary and those already\nnearby when it is created will be forced to flee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:cure all mutations ability"
msgid "Cures all your mutations — but only once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:divine shield ability"
msgid "Manifests a blindingly bright shield in front of the user. Held aloft by the\nShining One's power, it will unerringly block the next several attacks which\ncould be blocked by a mundane shield. Ranged attacks will be reflected and melee\nattackers have a chance of being briefly blinded by the resulting flash of\nlight.\n\nThis shield will block only a limited number of attacks before vanishing, with\nInvocations skill increasing how many.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:cleansing flame ability"
msgid "Invokes a huge blast of divine fury centered on the user, severely damaging\nundead and demons and dealing damage to all other hostile creatures. The power\nof the blast is increased by Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:summon divine warrior ability"
msgid "Summons a powerful warrior against evil, either an angel or a daeva. The\nduration of their assistance is increased by Invocations skill, and glory in\nbattle may lead the Shining One to bless them with an even longer stay.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:brand weapon with holy wrath ability"
msgid "Permanently blesses a weapon of your choice with the holy wrath of the Shining\nOne. Demon weapons will be converted into a more powerful sacred weapon. This\nblessing may only be used once, and it cannot be used on artefact weapons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:unearth wretches ability"
msgid "Bring forth those near death from Kikubaaqudgha's necropolis, providing ample\nfodder for all kinds of necromancy. Their number and quality is dependent on\nNecromancy skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sign of ruin ability"
msgid "[[Sign of Ruin spell]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:brand weapon with pain ability"
msgid "Permanently bloodies a weapon of your choice with the essence of pain\nitself. This blessing cannot be used on artefact weapons. You must choose\nbetween this gift or that of knowledge of the most powerful necromantic spells,\nand either gift may only be received once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:receive forbidden knowledge ability"
msgid "Grants you knowledge of the most powerful and sinister Necromancy spells:\nHaunt, Borgnjor's Revivification, Infestation, and Death's Door. You must choose\nbetween this gift or that of branding a weapon with pain, and either gift may\nonly be received once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:recall undead harvest ability"
msgid "Recalls your undead followers from anywhere in the dungeon to your immediate\nsurroundings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:light the black torch ability"
msgid "Raises the Black Torch aloft and calls upon Yredelemnul to light it aflame,\nmarking the beginning of your attempt to conquer the current level of the\ndungeon. Yredelemnul only grants piety for kills made while the torch is lit.\n\nThose who have earned some of Yredelemnul's favour will be gifted temporary\nundead servants to help begin their conquest, with stronger servants being\nprovided to the experienced and especially pious.\n\nYredelemnul does not offer second chances - the torch will be extinguished when\nyou leave the current floor, and it may only be lit once per floor, ever.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:hurl torchlight ability"
msgid "Hurls a gout of umbral fire from the Black Torch, which deals irresistible\ndamage to living, demonic, and holy beings. The torchlight will also briefly\nempower any of your undead servants caught in its blast, and is harmless to\nthose who worship Yredelemnul. The damage is increased by Invocations skill.\n\nThis ability can be used only while the torch is lit, and only a limited number\nof times on each floor. The number of uses available per floor increases with\npiety, and stoking the Black Torch's flames with a particularly remarkable soul\nby killing a unique named enemy will also provide an additional use.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:bind soul ability"
msgid "Attempts to bind the soul of a living, holy, or demonic being into your eternal\nservice. If the targeted monster is slain before it leaves your sight, it will\nreturn as a bound soul, retaining the equipment, spells and abilities it had in\nlife.\n\nOnly beings who are relatively uninjured may be targeted, and the focus required\nto keep their soul from escaping will consume 1/3 of the user's current health -\nreturning it only upon slaying them. The attempt will fail entirely if the\ntargeted monster leaves your sight before the process is complete.\n\nThe bound soul's health is influenced by the user's Invocations skill. It will\nfollow its captor through stairs, and can be recalled from other levels.\n\nOnly one soul can be bound at a time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:fathomless shackles ability"
msgid "Engulfs the user's surroundings in Yredelemnul's inexorable grip. So long as you\nremain within this profane sanctuary, all hostile creatures that share it with\nyou will be bound in place, and their life force will be continuously drained to\nrestore your own. Victims who are isolated from their allies will take damage at\na greatly increased rate.\n\nThe affected area will shrink over time, and a new one cannot be created until\nthe old one has fully expired.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:heroism ability"
msgid "Temporarily increases all of your combat skills, both offensive and defensive.\nThe duration is increased by Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:finesse ability"
msgid "Greatly increases your combat speed. The duration is increased by Invocations\nskill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:duel ability"
msgid "Enters you into single combat with a worthy foe. On success, you and the\nchallenged foe will be transported to Okawaru's Arena to fight to the death,\nwith no escape until you either emerge victorious or are slain.\n\nHalf of your missing health will be restored as the duel begins, and upon\nvictory, Okawaru will return your health and magical power to whatever they\nwere before you issued the challenge - letting you shake off any damage taken\nduring it in the blink of an eye.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:receive weapon ability"
msgid "Acquires a weapon from a choice of four. This blessing may only be redeemed\nonce.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:receive armour ability"
msgid "Acquires a piece of armour from a choice of four. This blessing may only be\nredeemed once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:unleash destruction ability"
msgid "Channels a blast of hellish {{\n    if you.get_base_mutation_level(\"Gehenna destruction\") == 1 then\n        return \"piercing fire, lava (from Gehenna's influence), lightning, or negative energy\"\n    elseif you.get_base_mutation_level(\"Cocytus destruction\") == 1 then\n        return \"piercing ice (from Cocytus' influence), cold, lightning, or negative energy\"\n    elseif you.get_base_mutation_level(\"Tartarus destruction\") == 1 then\n        return \"piercing fire, cold, devastation (from Tartarus' influence), or negative energy\"\n    elseif you.get_base_mutation_level(\"Dis destruction\") == 1 then\n        return \"piercing fire, cold, lightning, acid, or metal splinters (the last two from Dis' influence)\"\n    else\n        return \"fire, cold, lightning, or negative energy\"\n    end\n}} at a targeted creature. Damage and accuracy are increased by Invocations\nskill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:infernal servant ability"
msgid "Beckons a demon from the far reaches of Hell and binds it into service with your\nblood. At low Invocations skill, only lesser devils may be summoned, but major\ndemons and even executioners may answer the call of those with high Invocations\nskill.\n\nBeware that the armies of chaos are prone to infighting, and sometimes a\nhostile demon may answer the ritual alongside your summoned servant.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:brand self ability"
msgid "Permanently carves an Infernal Mark into yourself, forever tainting body and\nsoul in service of the Destroyer.\n\nSo long as you continue to worship Makhleb, this mark will grant you the\nfollowing power:\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:infernal legion ability"
msgid "Uses one's own body as a conduit to unleash an army of chaos upon the world.\nFor a short while, lesser demons will continuously manifest near the user -\nprovided there is something around for them to fight. While these demons may\nbe individually short-lived, the legions of chaos as a whole are virtually\ninexhaustible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:globe of annihilation ability"
msgid "Launches a roiling sphere of intense destructive force drawn from the {{\n    if you.get_base_mutation_level(\"Gehenna destruction\") == 1 then\n        return \"endless fires of Gehenna.\"\n    elseif you.get_base_mutation_level(\"Cocytus destruction\") == 1 then\n        return \"frigid wastes of Cocytus.\"\n    elseif you.get_base_mutation_level(\"Tartarus destruction\") == 1 then\n        return \"wailing grief of Tartarus.\"\n    elseif you.get_base_mutation_level(\"Dis destruction\") == 1 then\n        return \"ruthless spite of Dis.\"\n    else\n        return \"very Hells themselves.\"\n    end\n}}\n\nThis sphere gathers strength as it travels, and will attempt to home in on a\ndesignated target, though it moves and turns with considerable inertia. When it\ncollides with a creature or other obstruction, it will detonate in a violent\nexplosion of {{\n    if you.get_base_mutation_level(\"Gehenna destruction\") == 1 then\n        return \"fire or lava\"\n    elseif you.get_base_mutation_level(\"Cocytus destruction\") == 1 then\n        return \"cold or ice\"\n    elseif you.get_base_mutation_level(\"Tartarus destruction\") == 1 then\n        return \"negative energy or devastation\"\n    elseif you.get_base_mutation_level(\"Dis destruction\") == 1 then\n        return \"acid or metal splinters\"\n    else\n        return \"hellish energy\"\n    end\n}} whose radius depends on the distance travelled.\n\nYou are protected from this explosion yourself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:vessel of slaughter ability"
msgid "Invokes a blood pact with the Destroyer, temporarily granting you enormous power\nat a dangerous price.\n\nAt the moment the pact is sealed, a massive explosion of damnation will surround\nyou, and you will transform into a demonic avatar, granting you demonic\nresistances, invulnerable will, doubled healing from kills, and reducing all\ndamage you take by 1/3. You will additionally gain a bonus to all outgoing\ndamage proportional to how injured you were when you used this ability.\n\nWhen your transformation expires, you will be dragged down into the Crucible of\nFlesh, and made to fight through waves of demons until Makhleb considers your\ndebt paid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:channel magic ability"
msgid "Dramatically increases the user's regeneration of magical power for a duration\nthat increases with Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:forget spell ability"
msgid "Removes a known spell from memory, so as to free memory to learn others.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:divine exegesis ability"
msgid "Casts any spell from your spell library with guaranteed success. You receive a\nbonus to spell power based on your Invocations skill that is worth 50% more\nthan equivalent levels of training in the relevant skills of the spell itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:berserk ability"
msgid "Sends the user into a berserk rage. Going berserk temporarily increases health,\nspeed, and damage dealt in melee. It will time out quickly outside of combat,\nbut may be extended by multiple kills. While berserk, almost all actions other\nthan movement and melee combat are prevented. When the rage expires, the user\nwill be slowed and unable to berserk again for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:trog's hand ability"
msgid "Invokes a powerful regeneration ability which stacks with all other sources and\nis effective even on those who would not otherwise be able to regenerate. It\nalso fortifies the user's willpower, protecting against many magical effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:brothers in arms ability"
msgid "Summons huge angry allies to wreak havoc.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:purification ability"
msgid "Purges your body of poison, confusion, slowness, petrification, weakness, and\nsickness. Any drained maximum health will also be fully restored.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:heal other ability"
msgid "Heals a creature other than yourself by a moderate amount, depending on\nInvocations skill. Using this ability on hostile monsters will try to turn them\nneutral. This works best on living creatures, with the undead and demons being\nprogressively harder to pacify. Intelligent creatures are also more difficult\nto pacify.\n\nGhosts of dead adventurers and demon lords are too wrathful to be pacified,\nmindless creatures are too unintelligent to be pacified, and no monster can be\npacified while it is asleep.\n\nWhether the pacification succeeds or not, the invested piety and magic points\nare lost. If it does succeed, the monster is healed and you gain the monster's\nfull experience value. Otherwise, the monster is unaffected and you gain\nnothing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:heal self ability"
msgid "Heals a moderate amount of health, depending on Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:divine vigour ability"
msgid "Greatly increases your maximum health and magic points, depending on\nInvocations skill. Your current health and magic points will also be increased\nproportionally.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:depart the abyss ability"
msgid "Transports you out of the Abyss, returning you to the location from which you\nentered it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:banish ability"
msgid "Attempts to banish a creature into the Abyss. If the attempt succeeds, you gain\nsome piety and the creature's full experience value. Even creatures that resist\nare left malmutated and weakened by the brush with the Abyss. Invocations skill\nmakes Banishment harder to resist.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:corrupt ability"
msgid "Corrupts the current level by unleashing Abyssal energies on it. This will\ncause the area nearby to change appearance, and will gate in creatures from the\nAbyss bent on causing destruction. This will not work on levels already\ncorrupted or in the Abyss itself. The size of the effect is increased by\nInvocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:enter the abyss ability"
msgid "Transports you to Lugonu's realm instantly. The effort of even using the\nability will leave your health depleted.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:brand weapon with distortion ability"
msgid "Permanently corrupts a melee weapon of your choice with a localised field of\ndistortion. This blessing may only be used once, and it cannot be used on\nartefact weapons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:draw ability"
msgid "Draws a card from a deck of power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:triple draw ability"
msgid "Draws three cards from any deck, and allows you to choose one to play,\ndiscarding the other two.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:deal four ability"
msgid "Plays four cards from a deck in the time it normally takes to draw a\nsingle card.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:stack five ability"
msgid "Draws five cards from your choice of decks, and allows you to sort them into\nany order. Subsequently, you can draw these cards in the order you chose.\nRe-using this ability will discard the current stack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:smiting ability"
msgid "[[Smiting spell]] The strength of the smiting is increased by Invocations skill.\n\nBeogh will not allow you to use this directly against another apostle during a\ndivine trial.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:recall apostles ability"
msgid "Recalls your apostles from anywhere in the dungeon to your immediate\nsurroundings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:dismiss apostle ability"
msgid "Frees this apostle from your service, sending them out to do good in the world\nin Beogh's name.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:recruit apostle ability"
msgid "Anoints a defeated apostle, and welcomes them as a permanent follower. They will\nfollow you between floors and into any peril, willingly giving their life for\nthe cause and their kin.\n\nIf they die, Beogh will eventually revive them once you gain sufficient piety -\nthis process can be greatly accelerated by satisfying Beogh with the slaying of\nall foes who may have contributed to their apostle's death.\n\nYou can have at most 3 followers accompanying you at a time, though you may\nfreely dismiss old ones to invite new ones.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:blood for blood ability"
msgid "Beseeches Beogh to grant you an army with which to wreak bloody retribution.\nThe user will be immediately surrounded by orcish allies, with more of them\narriving over time from all directions. The prayer lasts a considerable\nlength of time, but will expire far more rapidly once there are no more foes in\nsight.\n\nUsable only while you are standing over the corpse of one of your apostles, and\nat most once per death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:wall of briars ability"
msgid "Grows short-lived briar patches around you. Monsters attacking these briars will\nbe damaged by sharp thorns. Invocations skill increases the briars' health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:grow ballistomycete ability"
msgid "Grows a short-lived ballistomycete at the location you choose. A ballistomycete\noccasionally releases spores that quickly seek out foes and violently explode,\ndamaging and confusing all living things caught in the blast.\n\nInvocations skill increases the health and duration of the ballistomycete as\nwell as the damage of its exploding spores.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:overgrow ability"
msgid "Permanently destroys a wall-like structure, growing a short-lived plant ally in\nits place. Even a tree will give its life to support the will of Fedhas, and\nonly truly indestructible walls are immune to this power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:grow oklob ability"
msgid "Grows a short-lived oklob plant at the location you choose. These dangerous\nplants spray corrosive vitriol at your foes.\n\nInvocations skill increases the health and duration of the oklob as well as the\nfrequency with which it sprays its acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:bend time ability"
msgid "Attempts to slow down everyone adjacent to you. High Invocations skill makes it\nharder to resist.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:temporal distortion ability"
msgid "Warps the flow of time, causing monsters to skip forwards in time relative to\nyou.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:slouch ability"
msgid "Causes damage to everyone in sight who is moving faster than you, dealing more\ndamage with greater differences in speed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:step from time ability"
msgid "Removes you completely from the flow of time. Time will pass as it usually does,\nand monsters will wander away and sometimes even fall back to sleep. After some\ntime has passed, you will return in the same state as the very second you\ndeparted.\n\nInvocations skill increases the likelihood that your absence will have been so\nlong that alert monsters have fallen asleep again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:slimify ability"
msgid "Coats a wielded weapon or your fists with slime, turning the next living or\ncorporeal undead monster hit into a neutral slime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:oozemancy ability"
msgid "Calls forth acidic ooze from the walls of the dungeon around you, damaging foes\ndepending on the number of slimy walls they remain adjacent to.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:curse item ability"
msgid "Curses a chosen equipped item, binding it to the wearer until the curse\nand the item both are broken. Cursed items can no longer be enchanted or\nmodified.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:shatter the chains ability"
msgid "Destroys a chosen cursed equipped item, relieving the wearer of the curse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:shadowslip ability"
msgid "Instantly swaps places with your shadow (so long as it is active) and misleads\nall enemies in sight about which of the two is which. Enemies which were\npreviously focused on you will instead focus their attention exclusively upon\nyour shadow for several turns before they realise their mistake - though if they\nsucceed in destroying your shadow, the illusion will end prematurely.\n\nThe duration of this effect increases with Invocations skill, as will the\ndurability of your shadow immediately after using it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:aphotic marionette ability"
msgid "Grabs hold of another creature's shadow and rapidly unleashes their spells and\nabilities as if they were your own, aimed at random enemies. Creatures they\nsummon this way will belong to you, and many beneficial effects that they would\napply to themselves will be applied to you instead. You are also fully protected\nfrom any damage they would cause.\n\nCan only be used on creatures with eligible spells that they could productively\ncast at the moment. The process also leaves the victim's shadow too dim to grasp\na second time - once used successfully on a target, it may never be used on them\nagain.\n\n(Not all spells can be cast via this method; those which cannot will be marked\nwith an exclamation mark when examined.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:primordial nightfall ability"
msgid "Invokes a night from before the stars first burned in the sky, engulfing your\nsurroundings in impenetrable darkness. The user's sight radius will be reduced\nto nothing, preventing enemies from tracking or aiming abilities at you, and\nslowly expand back to normal over the duration of the effect. Your stealth will\nalso be increased.\n\nIt cannot be invoked again until its effect has fully ended, as even the very\nfirst night of creation must eventually give way to day.\n\nInvocations skill increases the duration of the effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:potion petition ability"
msgid "Petitions Gozag to sell you the effects of a set of potions. (These effects will\nbe applied instantly and directly to the petitioner, rather than being provided\nor being drunk as a normal potion.) Gozag will offer three lists at a time, with\nvarying prices.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:call merchant ability"
msgid "Sends funds to a merchant to help them set up shop at your location. The cost of\nfunding a shop increases with the number of shops funded.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:bribe branch ability"
msgid "Gives 3000 gold to Gozag to spread throughout the inhabitants of the current\nbranch, only possible if the branch has intelligent inhabitants. Those monsters\nmay then become uninterested in fighting you (with tougher inhabitants having\nan increasing chance of being bribed), and more rarely will join your ranks,\nthough they will not leave their home branch. Enemies accepting a bribe will\nlower the remaining bribe fund; upon its exhaustion, bribed enemies will become\nindifferent if they have not become your allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:upheaval ability"
msgid "Calls on the forces of nature to blast a small area with magma, ice, wind,\nor rubble. This blast will never harm you or any elementals manifested by you.\nInvocations skill increases both damage and area affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:elemental force ability"
msgid "Causes your elemental clouds to coalesce into friendly elementals. Your\nInvocations skill increases the maximum number of elementals that can be\ncreated with one use of the ability.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:disaster area ability"
msgid "Blasts the entire area around you with powerful natural forces. Invocations\nskill increases both damage and area affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:draw out power ability"
msgid "Taps into your inner power to restore health and magic, as well as freeing your\nbody and mind from external constraints, including nets, webs, constriction,\npetrification, slowness, and confusion. The amount of health and magic restored\nincreases with piety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:power leap ability"
msgid "Performs an incredibly fast leap to a targeted location, causing an explosion\nupon landing which damages all adjacent foes. The amount of damage done\nincreases with your piety and experience level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:apocalypse ability"
msgid "Reveals Ru's truth to your enemies, dealing severe damage to all enemies in\nyour line of sight. Affected creatures may be paralysed, slowed or have their\nmagic drained. The damage dealt increases with your piety and experience level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice purity ability"
msgid "Sacrifices purity of body or mind, causing a single mutation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice words ability"
msgid "Sacrifices the ability to use magical scrolls in combat unless badly injured.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice drink ability"
msgid "Sacrifices the ability to drink potions in combat unless badly injured.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice essence ability"
msgid "Sacrifices magical essence, causing a single mutation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice health ability"
msgid "Sacrifices physical health, causing a single mutation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice stealth ability"
msgid "Sacrifices stealth, causing you to always be noticed by foes and preventing\nyou from having any ranks in the Stealth skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice forms ability"
msgid "Sacrifices forms, preventing you from voluntarily changing your form and from\nhaving any ranks in the Shapeshifting skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice artifice ability"
msgid "Sacrifices the ability to evoke any magical items, and prevents you from having\nany ranks in the Evocations skill.\n\nThis includes wands and other items which use Evocations skill - that is, it does\n*not* affect reaching weapons, talismans, and ziggurat figurines. This also renders\nmagical staves much less effective in melee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice love ability"
msgid "Sacrifices love, causing all creatures to become hostile, even those created\nby you. Monsters that are spell residue and which do not act independently,\nsuch as orbs of destruction and spectral weapons, are the only things which can\nremain friendly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice courage ability"
msgid "Sacrifices courage, causing you to become terrified of dangerous monsters. Such\nmonsters fill you with horror, which reduces the power of your spells and your\nability to hit and damage monsters in combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice arcana ability"
msgid "Sacrifices arcana, causing you to lose the ability to use certain schools of\nmagic and preventing you from having any ranks in those skills.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice nimbleness ability"
msgid "Sacrifices nimbleness, preventing you from having any ranks in the Dodging\nskill. This sacrifice is worth more if you cannot train Armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice durability ability"
msgid "Sacrifices durability, preventing you from having any ranks in the Armour\nskill. This sacrifice is worth more if you cannot train Dodging.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice a hand ability"
msgid "Sacrifices a hand, causing you to lose the ability to use shields{{\n    if you.race() ~= \"Formicid\" then\n        return \" and two-handed weapons\"\n    end\n}}, and to be able to wear one fewer ring.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice experience ability"
msgid "Sacrifices some of your past experiences, causing you to lose one level\nimmediately and also to have the maximum level you can attain lowered by one.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice skill ability"
msgid "Sacrifices your skills, causing you to have all of your skill aptitudes\ndecreased by one. This will likely cause you to lose ranks in trained skills.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice an eye ability"
msgid "Sacrifices an eye, causing you to have a much harder time hitting targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:sacrifice resistance ability"
msgid "Sacrifices your resistance to extreme temperatures, causing you to become\nvulnerable to heat and cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:reject sacrifices ability"
msgid "Rejects all offered sacrifices. Doing so means Ru will take more time\nevaluating your readiness for future sacrifices. Ru will not offer more\nsacrifices while there is an existing offer still extended.\n\nEach consecutive rejection increases the sacrifice timer significantly.\nAccepting a sacrifice will reset the timer to the standard length.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:stomp ability"
msgid "Stomps down in time with the rhythm of the dance, sending a shockwave through\nall adjacent creatures. The shockwave damages each creature by a fraction of\nits current health, plus damage increasing with Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:line pass ability"
msgid "Passes through a contiguous line of creatures at superhuman speed, ending up\nin a new location. Any creatures passed through in this way will be confused\nbriefly, with the duration of confusion increasing with Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:grand finale ability"
msgid "Merges with a target emotionally and physically, and then bursts forth from\nthem, violently splitting them apart and killing them instantly. This ability\nbecomes easier to use as the worshipper's piety and Invocations skill increase.\n\nMore violent Uskayaw sects consider their members not to be true worshippers\nuntil they have performed this rite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:renounce religion ability"
msgid "Renounces your faith. This will make you leave your god (and usually anger\nsaid god).\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:convert to beogh ability"
msgid "Swears fealty to Beogh, the god of cave orcs. This god demands that all\nnon-believers must die, but new believers must be spared and accepted into the\nfold. Beware, for orcs who do not see you convert may still be hostile until\nyou have built your reputation!\n\nAll other gods hate Beogh, and do not take desertion lightly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:donate gold ability"
msgid "Donates half of your gold to Zin, which will increase your piety over time. The\noverall increase is determined by the size of your donation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:recall ancestor ability"
msgid "Recalls your ancestor from anywhere in the dungeon to your immediate\nsurroundings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:idealise ability"
msgid "Restores your ancestor to an idyllic vision of their best self. Their wounds\nare forgotten and a glow of perfection infuses them, giving them a short-lived\nbut dramatic increase in strength, spellcasting, and armour. The quality of the\nhealing and duration of the idealisation granted are both improved by the\nInvocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:transference ability"
msgid "Forces a targeted creature to pass through the realms of memory and exchange\nplaces with your ancestor.\n\nWith great piety, those near the target will be drained to a degree depending\non Invocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:ancestor life: knight ability"
msgid "Remembers your ancestor as a knight, a strong melee combatant with superior\ndefences. This choice is permanent and cannot be undone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:ancestor life: battlemage ability"
msgid "Remembers your ancestor as a battlemage, a warrior capable of relentless offence\nwith both melee and conjurations. This choice is permanent and cannot be undone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:ancestor life: hexer ability"
msgid "Remembers your ancestor as a hexer, a cunning rogue capable of swift\nknifework and debilitating spellcasting. This choice is permanent and cannot be\nundone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:ancestor identity ability"
msgid "Recalls who your ancestor preferred to be known as, correcting their name and\ngender.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:wall jump ability"
msgid "Vaults off an adjacent wall towards enemies, striking all enemies adjacent to\nthe landing spot and taking two turns to complete the motion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:serpent's lash ability"
msgid "Allows you to move at supernatural speeds, making any normal movements up to a\ndistance of two tiles instant. Martial attacks performed under the effect of\nSerpent's Lash are more damaging and never miss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:heavenly storm ability"
msgid "Invokes a storm of heavenly clouds. While the storm rages, your evasion and\ncombat accuracy and damage are substantially increased, and striking enemies\nwith martial attacks increases this bonus. The storm weakens over time and\nfades away once the bonus reaches zero. The heavenly clouds prevent\ninvisibility, and obscure the vision of those outside the storm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:fiery armour ability"
msgid "Armours yourself in fire, providing +7 AC and searing foes foolish enough to\nstrike you in melee. The fire takes quite a long time to burn out.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:foxfire swarm ability"
msgid "Conjures a swarm of animate flames all around you. These rapidly seek the\nnearest monsters, burning them. They will dissipate harmlessly if unable to\nreach a target or if you swap places with them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:rising flame ability"
msgid "Sends you floating upward and, after a short delay for Ignis to gather enough\npower, blasts you through the ceiling and into the level above. This ability\nmay only be used once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:hop ability"
msgid "Hops toward a chosen destination, landing somewhere nearby. After using this\nability, you will be unable to hop again until you have spent some time not\nmoving. (Other actions, such as casting spells and attacking, are fine.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:blinkbolt ability"
msgid "Turns the user into living lightning and zaps them at the chosen monster,\ndealing electric damage to everything in their path and depositing the user\nat the bolt's end. After using this ability, you will be unable to use it\nagain for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:siphon essence ability"
msgid "Torments nearby living foes, halving their health. The pain inflicted heals\nthe user to an extent determined by Shapeshifting skill. After using this\nability, you will be unable to use it again for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:evoke the sceptre of asmodeus ability"
msgid "Calls on the power of Asmodeus to summon fiery demons of Hell. The demons\nsummoned will remain friendly only for a limited time, eventually becoming\nhostile before vanishing. The success of the ability scales with the Evocations\nskill, and this ability is available only while wielding the Sceptre of\nAsmodeus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:evoke damnation ability"
msgid "Blasts a targeted enemy with damnation. These unholy forces harm the victim and\nanyone adjacent, and are not affected by any means of protection, such as armour\nor resistances. However, certain creatures, usually those able to invoke\ndamnation themselves, are entirely unscathed by damnation. The power of this\nability scales with the Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:evoke the staff of olgreb ability"
msgid "Causes the caster to radiate toxic energy, continuously inflicting poison on\neverything in line of sight for as long as the aura lasts. The power of this\nability scales with the Evocations skill, and this ability is available only\nwhile wielding the Staff of Olgreb.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:jump ability"
msgid "Leaps through the air in the blink of an eye. While it is impossible to control\nyour destination, the movement is so abrupt and agile that no monster will be\nable to land a blow on you until you can act again, and many may lose track of\nyour position entirely.\n\nYou must spend a short while recovering between each use of this ability.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:watery grave ability"
msgid "Turns all of the water near you into a surging tide that attempts to drown every\nenemy standing in or above it. Those who need air to breathe will also become\nFlooded, preventing them from casting spells affected by Silence for several\nturns and dealing minor asphyxiation damage.\n\nAfter using this ability, you must gain experience points before you can recover\nenough power to use it again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/ability.txt
msgctxt "textdb:descript/ability.txt:bestial takedown ability"
msgid "Unleashes the full power of your predatory instincts to leap towards a terrified\nenemy and perform a vicious melee attack against them. This attack receives a\ndamage multiplier based on your Shapeshifting skill. If it kills them, you will\nalways perform a Howl afterward.\n\nCan only target an enemy who is afraid, and who has at least one occupiable tile\nadjacent to them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fast status"
msgid "All of your actions are 50% faster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:invis status"
msgid "You are invisible. Most enemies will be unable to see you and will suffer\npenalties to hit, though they may be able to guess at your general location.\nIf the status is greyed out, it is active but ineffective for some reason (for\nexample if you are glowing with magical contamination or standing in shallow\nwater).\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:tele status"
msgid "You are about to teleport. While waiting to teleport, attempting to apply the\nstatus again (such as by using a scroll of teleportation) will cancel the\nteleportation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:!tele! status"
msgid "You are about to teleport towards hostile monsters, if possible. Before this\nhappens, attempting to teleport again (such as by using a scroll of\nteleportation) will cancel this teleportation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fly status"
msgid "You are flying above the ground, and are able to cross water and lava or fight\nabove shallow water without penalties. Most types of flight will time out – be\ncareful what you are above when that happens!\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:agi status"
msgid "You are unnaturally agile, and gain a bonus to your evasion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:brill status"
msgid "You are unnaturally smart, and gain a bonus to the power of your spells as well\nas halving their magic cost (rounding up).\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:might status"
msgid "You are unnaturally mighty, doing significantly more damage in physical combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:regen status"
msgid "You regenerate health at an unnaturally fast rate. This is only shown for\ntemporary regeneration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-regen status"
msgid "Your health has stopped regenerating due to the presence of nearby monsters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:mpregen status"
msgid "You regenerate health and magic at an unnaturally fast rate. This is only shown\nfor temporary regeneration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:touch status"
msgid "Your attacks deal no damage, but have a chance of confusing monsters that they\nhit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:will++ status"
msgid "Your willpower is much stronger, protecting against many magical effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:regen will++ status"
msgid "Trog's Hand is simultaneously making you regenerate health at an unnaturally\nfast rate and strengthening your willpower to protect you against many magical\neffects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:berserk status"
msgid "You are hasted, deal increased damage in combat, and have increased health, but\nare unable to perform most actions other than moving and attacking in melee.\nThe status will wear off very quickly unless you are attacking monsters, and\nwhen it expires you will be slowed and unable to berserk again for a short\nduration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-berserk status"
msgid "You are recovering from your berserk rage, and are unable to berserk again for\na short duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:bearserk status"
msgid "You are filled with barbearic rage! You are hasted, deal grizzly damage, and\nhave greatly increased health, but find it impawsible to do much other than\nmove and maul foes. You'll bid furwell to this status very quickly unless you\nare attacking, and when it expires you will be slowed and unable to bearserk\nagain for a short duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:pois status"
msgid "You are poisoned and will continually lose health. While poisoned, your current\nhealth will be partially recoloured to display the eventual poison damage that\nwill be dealt. Poison can be cured immediately by potions of curing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:conf status"
msgid "You are confused. You may stumble in a random direction when attempting to move\nor attack, and are unable to cast spells or use most items other than potions.\nConfusion can be cured immediately by potions of curing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:contam status"
msgid "You are glowing with mutagenic radiation. This can inflict mutations over time\n(usually negative) or even cause you to suffer damage as the unstable magic\nexplodes violently. In addition, your glow prevents invisibility and reduces\nyour stealth.\n{{\n    local dmg = you.contam_max_damage();\n    if dmg > 0 then\n        return \"\\nAn explosion at your current level of contamination could \" ..\n               \"inflict up to \" .. dmg .. \" damage.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:drain status"
msgid "Your maximum health has been temporarily drained by negative energy. This\nstatus will not wear off by waiting, but will gradually expire as you gain\nexperience.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-breath status"
msgid "You are catching your breath, and are unable to use your innate breath ability\nuntil the status expires.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:breath status"
msgid "Indicates how many uses of your draconian breath weapon are available. If the\nindicator is dim, there are zero. Otherwise, the number of plusses indicate\nadditional uses available.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:breath+ status"
msgid "<Breath status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:breath++ status"
msgid "<Breath status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:exh status"
msgid "You are exhausted, and are unable to activate divine powers that cause\nexhaustion until the status expires.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:slow status"
msgid "All your actions take 50% longer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:para status"
msgid "You are paralysed, and completely unable to act.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:sleep status"
msgid "You are asleep, and completely unable to act. Taking damage will wake you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:held status"
msgid "You are held in a net or a spider web. You cannot move freely and will instead\ntry to struggle free.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:constr status"
msgid "You are being constricted by an enemy. Your evasion is impaired, and you will\ntake damage over time. You are unable to move away from the enemy, although you\ncan struggle to escape by attempting to do so, and will become increasingly more\nlikely to succeed and break the constriction when doing so multiple times.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:mesm status"
msgid "You are mesmerised and cannot move away from the monster mesmerising you. The\neffect can be broken by killing or confusing the responsible monster or by\nbreaking line of sight with them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fear status"
msgid "You are overcome with fear and cannot move towards the monster causing fear in\nyou. The effect can be broken by killing or confusing the responsible monster\nor by breaking line of sight with them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-tele status"
msgid "You are prevented from teleporting or blinking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-move status"
msgid "You cannot walk, fly around, slither, etc. You can still take other actions,\nand can still be moved via translocations or by being pushed, pulled, and so on.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:mark status"
msgid "Your location is marked due to the effects of a trap or a spell, and monsters\nwill hunt you down more precisely and will be able to detect you even if you\nare not in their vision.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fire status"
msgid "You are covered with sticky fire, which causes damage over a moderate duration.\nMoving will quell the fire much more rapidly, and entering water will extinguish\nit immediately.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fire+ status"
msgid "<Fire status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fire++ status"
msgid "<Fire status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:corona status"
msgid "You are surrounded by light, greatly reducing your stealth and making you\neasier to hit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:barbs status"
msgid "There are barbs embedded in your skin, and moving around will cause you to take\ndamage. Remaining in place for a short time will allow you to remove the barbs\nwithout taking damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:sick status"
msgid "You have been sickened, and your health will no longer regenerate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vertigo status"
msgid "You are disoriented and dizzy, reducing your accuracy, evasion, and\nspellcasting success rate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:corr status"
msgid "You are corroded, reducing your damage in physical combat and your armour by an\namount depending on the severity of the corrosion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:flay status"
msgid "You are covered in illusionary wounds, causing severe damage while the effect\nremains active. Destroying the source of the illusion will restore all health\nlost to the flaying.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:weak status"
msgid "Your melee attacks do 25% less damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:frozen status"
msgid "You are covered in ice, and your movement speed is reduced.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:sap status"
msgid "Your magic is sapped. Casting a spell will cause you to lose access to your\nmagic, briefly preventing you from casting any further spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-cast status"
msgid "You are unable to cast spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:crippled status"
msgid "At least one of your strength, intelligence, or dexterity has fallen to 0 or\nbelow. You will act slowly until this situation is remedied.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:dchan status"
msgid "You are channelling the dead, causing any living creatures killed in your\nvicinity to be raised as spectral servants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vit status"
msgid "You are divinely vitalised, providing protection from poison, confusion,\npetrification, and sickness, and increasing and sustaining your strength,\nintelligence and dexterity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:will/2 status"
msgid "Your willpower is weaker, making you vulnerable to many magical effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:stone status"
msgid "You are petrified, and completely unable to act. You are very easy to hit,\nbut all damage taken is substantially reduced.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:petr status"
msgid "You are turning to stone. Your actions are slowed, all damage taken is slightly\nreduced, and you will soon be completely petrified (gaining the Stone status).\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:resist status"
msgid "You are more resistant to fire, cold, electricity, poison and acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:slime status"
msgid "Your wielded weapon or your fists are coated in slime, and will turn the next\nliving or corporeal undead monster you hit into a neutral slime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:swift status"
msgid "You are covering ground swiftly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-swift status"
msgid "You are covering ground slowly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ddoor status"
msgid "You are temporarily invulnerable to harm, but are brought close to death in the\nprocess and cannot be affected by healing while the effect is active. After the\nspell expires, it cannot be immediately recast.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-ddoor status"
msgid "You are still close to death's doorway, and cannot recast Death's Door for a\nshort duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:quad status"
msgid "QUAD DAMAGE!\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:sil status"
msgid "You are silenced. This makes reading scrolls, casting spells, invoking divine\nabilities, or shouting impossible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:flooded status"
msgid "Your lungs are filled with liquid, preventing you from breathing properly. This\nmakes reading scrolls, casting spells, and invoking divine abilities impossible.\nYou will also take asphyxiation damage every turn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:stealth status"
msgid "Your stealth is greatly increased.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vortex status"
msgid "You are in the eye of a mighty ice storm. After the vortex fades, it cannot be\ncalled forth again for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-vortex status"
msgid "You are surrounded by unstable winds, and cannot recast Polar Vortex for a short\nduration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:liquid status"
msgid "You are liquefying the ground around you, slowing the movement of all creatures\nin the area.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:hero status"
msgid "Your combat skills are temporarily increased.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:finesse status"
msgid "Your combat speed is greatly increased.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:duel status"
msgid "You are duelling a foe in Okawaru's Arena, and will be returned whence you came\nif you are victorious.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:disjoin status"
msgid "You are destabilising space around yourself, causing nearby monsters to be\nrandomly blinked away from you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fugue status"
msgid "Your weapon is temporarily enhanced by the souls of the damned, providing\nslaying bonuses that increase with every enemy killed. At the maximum bonus,\nfoes adjacent to your attacks' targets suffer pain damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:debt status"
msgid "You have lived beyond your means. You cannot spend gold again until you earn\nenough to cancel out your debt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:toxic status"
msgid "You are radiating toxic energy, and will continuously inflict poison on all\nnearby creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:recite status"
msgid "You are reciting Zin's laws to nearby monsters, with a range of effects\ndepending on the target. After finishing a recitation, it cannot be repeated\nfor a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-recite status"
msgid "You have recently finished reciting Zin's laws, and cannot recite again for a\nshort duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rf- status"
msgid "You are more vulnerable to fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rp- status"
msgid "You are more vulnerable to poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:bullseye status"
msgid "You have targeted an enemy with a dimensional bullseye, causing missiles fired\nor thrown at a different enemy to also be teleported at the target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:forest status"
msgid "You are calling a forested plane into temporary existence, and awakening nearby\ntrees to damage your foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:dragoncall status"
msgid "You are calling forth mighty dragons to attack your foes. Each dragon which\nanswers the call will drain your magical energy. After the call ends, it cannot\nbe issued again for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-dragoncall status"
msgid "You have recently called forth dragons, and cannot recast Dragon's Call for a\nshort duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-potion status"
msgid "You are unable to quaff potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rf+ status"
msgid "You are more resistant to fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rc+ status"
msgid "You are more resistant to cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:relec+ status"
msgid "You are more resistant to electricity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:horr status"
msgid "You are terrified of nearby monsters, reducing your damage and accuracy in\ncombat as well as the power of your spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-scroll status"
msgid "You are unable to read scrolls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:cleave status"
msgid "Your melee attacks cleave, hitting all adjacent targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ambros status"
msgid "You are regenerating health and magic, but are also confused. Curing the\nconfusion will also end the regeneration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:surge status"
msgid "Your next use of an evokable device will have its power enhanced, at the cost\nof some of your magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:howl status"
msgid "A terrifying howl is echoing in your mind, calling forth powerful creatures to\nattack you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blood status"
msgid "Your body is covered in congealed blood, serving as armour for as long as you\nremain seriously injured.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:channel status"
msgid "You are channelling magical energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:beast status"
msgid "You have been transformed into a monstrous, furry were-beast. The ferocious\nenergy pulsing through your limbs keeps you ready to kill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:flux status"
msgid "You are unstable at a fundamental level. You inflict dangerous levels of\nmagical contamination on foes with each touch. Sufficient contamination\ncauses a highly localised meltdown, dealing enormous damage.\n\nHowever, this instability makes you unable to use weapons, shields, or\nbody armour. You also glow, reducing stealth and preventing invisibility,\nand you do less damage in melee, as your limbs sometimes destabilise mid-swing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:serpent status"
msgid "You have been transformed into a giant, cold-blooded, poison-resistant serpent,\nready to wind your coils around foes and crush them to death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:maw status"
msgid "Your midsection has transformed into a giant mouth, gnashing and ready to devour\nfoes. The mouth may devour slain creatures, healing you to an extent increased\nby your Shapeshifting skill and the power of the creature eaten. Skill also\nincreases the damage done by the maw.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:statue status"
msgid "You have been transformed into a slow but extremely robust stone statue.\nYour melee damage, both unarmed and with weapons, is substantially increased.\nYour stone body is immune to poison and miasma, and gains resistance to\nelectricity, negative energy and torment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:dragon status"
msgid "{{\n    local desc = \"You have been transformed into a mighty\"\n\n    if you.race():find(\"Draconian\") then\n        desc = desc .. \" dragon\"\n        if you.race() ~= \"Grey Draconian\" then\n            desc = desc .. \", increasing the power of any innate breath attacks\"\n        end\n        if you.race() == \"Red Draconian\" then\n            desc = desc .. \". You are highly resistant to fire and \" ..\n                           \"resistant to poison, but vulnerable to cold\"\n        elseif you.race() == \"White Draconian\" then\n            desc = desc .. \". You are highly resistant to cold and \" ..\n                           \"resistant to poison, but vulnerable to fire\"\n        elseif you.race() == \"Green Draconian\" then\n            desc = desc .. \" and retaining your innate colour\"\n        else\n            desc = desc .. \". You retain your innate colour, and are \" ..\n                           \"also resistant to poison\"\n        end\n    else\n        desc = desc .. \", fire-breathing dragon. You are highly resistant \" ..\n                       \"to fire and resistant to poison, but vulnerable to \" ..\n                       \"cold\"\n    end\n\n    desc = desc .. \".\"\n\n    return desc\n}} Your melee attacks deal incredible damage, and you are much more robust but\nless evasive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:storm status"
msgid "You have been transformed into a lightning-filled tempest. Your melee attacks\nare strengthened and electrified, and strike all adjacent foes. You gain flight,\nincreased evasion, immunity to poison, miasma, petrification, and constriction,\nand resistance to electricity. You gain the ability to launch yourself at foes\nas a lightning bolt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:death status"
msgid "You have been transformed into an undying offence against life itself.\n\nFoes struck by your hands or melee weapons are weakened, slowed, and drained,\nand you can heal yourself by tormenting living foes nearby. You also resist\ncold, have enhanced willpower, and are immune to poison, miasma, negative\nenergy, and torment. Unfortunately, you are vulnerable to holy damage and\nDispel Undead, and cannot consume potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:bat status"
msgid "You have been transformed into a swift-moving bat, increasing your evasion but\nsubstantially weakening your melee attacks.\n\nAny equipped weapons, armour and rings are melded, and you are unable to cast\nspells. The effectiveness of your melee attacks while in this form is based on\nexperience level instead of on Unarmed Combat skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:pig status"
msgid "You have been transformed into a pig. You move quickly but are less effective\nin melee.\n\nAny equipped weapons, armour and rings are melded, and you are unable to cast\nspells. The effectiveness of your melee attacks while in this form is based on\nexperience level instead of on Unarmed Combat skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:app status"
msgid "{{\n    if you.race() == \"Octopode\" then\n        return \"A vicious spike has grown from one of your tentacles, \" ..\n               \"increasing the damage of your extra tentacle attacks.\"\n    else\n        return \"Monstrous horns or talons have grown from your body, \" ..\n               \"granting a chance of making an extra attack in melee.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:tree status"
msgid "You have been transformed into a tree and are rooted to the ground, unable to\nmove or teleport. You have minimal evasion but increased health and natural\narmour, and are resistant to poison, and immune to torment and drowning.\n\nAny equipped cloak, helmet, gloves, boots and body armour are melded.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:wisp status"
msgid "You have been transformed into an insubstantial wisp of gas. You are highly\nevasive and are resistant to fire, cold, electricity and acid, and immune to\npoison, and negative energy.\n\nAny equipped weapons, armour and jewellery are melded, and you are unable to\ncast spells. The effectiveness of your melee attacks while in this form is based\non experience level instead of on Unarmed Combat skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fungus status"
msgid "You have been transformed into a sentient fungus. You are highly evasive and\ncan release spores to cause confusion when attacking in melee, but are unable\nto move when hostile creatures are present. You are resistant to poison and\nimmune to negative energy.\n\nAny equipped weapons and armour are melded, and you are unable to cast spells.\nThe effectiveness of your melee attacks while in this form is based on\nexperience level instead of on Unarmed Combat skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:shadow status"
msgid "You have been transformed into a swirling mass of dark shadows. You are\npermanently invisible and are immune to poison, draining, and torment. All\nincoming damage is halved, you bleed smoke on any incoming attack, and you have\ninfinite willpower. However, your ability to deal damage in melee and with\nranged attacks is halved, your spellcasting power is greatly hampered, and your\nmaximum health is further drained when taking damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:orb status"
msgid "You are near (or perhaps holding) the Orb of Zot, whose energies disrupt\ntranslocation magic. Teleportation will take longer and scrolls of blinking may\ntransport you a short distance away from your intended destination.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:orb? status"
msgid "You are holding the Charlatan's Orb, whose energies disrupt translocation\nmagic. Teleportation will take longer and scrolls of blinking may transport you\na short distance away from your intended destination.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-hop status"
msgid "Your legs are tired, and you are unable to hop. This status will only recover\nafter you spend several turns not moving. (Other actions, such as attacking or\ncasting spells, are fine.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ray status"
msgid "You are currently channelling a ray of searing magical energy. Pressing\n<w>.</w> or <w>s</w> to wait in place will maintain and intensify the ray, at\nthe cost of 1 MP per turn. Any other action, including recasting the spell,\nwill end it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ray+ status"
msgid "<Ray status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ray++ status"
msgid "<Ray status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:lash status"
msgid "You are moving at supernatural speed, causing movement actions to become\ninstant. Any martial attacks made while moving in this way deal increased\ndamage and never miss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:heavenly status"
msgid "You are surrounded by a storm of heavenly clouds. While the storm rages, your\nevasion and combat accuracy and damage are substantially increased, and\nstriking enemies with martial attacks increases this bonus. The storm weakens\nover time and fades away once the bonus reaches zero. The heavenly clouds\nprevent invisibility, and obscure the vision of those outside the storm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:slowm status"
msgid "Your movement is slowed on this liquid ground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:alive status"
msgid "You are full of blood, and regenerate health quickly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:aug status"
msgid "You receive spellcasting and slaying bonuses that scale with your health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:beogh status"
msgid "You can swear fealty to Beogh, the god of all orcs, through a nearby priest.\nTo do so, use the Convert to Beogh ability in the ability menu.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:bloodless status"
msgid "Your body is entirely devoid of blood, reducing your maximum health and\npreventing you from regenerating health when monsters are visible. You are\nimmune to poison and negative energy, significantly resist cold, and resist\ntorment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:bribe status"
msgid "You are bribing the inhabitants of the current branch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:cloud status"
msgid "You are in a cloud.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-clouds status"
msgid "The air is too still for clouds to form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:dig status"
msgid "You are digging.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:elixir status"
msgid "Your health and/or magic are being rapidly restored, as well as the health of\nyour allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fast+slow status"
msgid "You are under both slowing and hasting effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:lava status"
msgid "You are currently flying over lava.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:recall status"
msgid "You are recalling your allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:water status"
msgid "{{\n    local verb = you.flying() and \"flying over\" or\n                 you.race() == \"Merfolk\" and \"swimming in\" or \"standing in\"\n    local feat = view.feature_at(0, 0):gsub(\"_\", \" \")\n\n    if feat ~= \"deep water\" and feat ~= \"shallow water\" then\n        feat = \"water\"\n        verb = \"over\"\n    end\n\n    return \"You are currently \" .. verb .. \" \" .. feat .. \".\"\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:attr status"
msgid "Enemies are magically translocated toward you. (This won't wake them up.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:zot status"
msgid "You have spent too much time in one branch, allowing the malevolent power of Zot\nto notice you. If you spend the indicated number of turns in the branch without\ndescending to a new floor, Zot will find you, causing permanent health damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:zot count status"
msgid "If you spend the indicated number of turns in this branch without descending to\na new floor, Zot will find you, causing permanent health damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:gem status"
msgid "If you spend the indicated number of turns in this branch, its gem will be found\nand shattered by the power of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:gem (*) status"
msgid "The power of Zot no longer hunts you, but this branch's gem still remains\nintact.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rf0 status"
msgid "The wrath of Ignis prevents you from resisting fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-blink status"
msgid "You are unstable and cannot cast Blink or activate evoked blink abilities\nfor a short period of time. Powerful sources of translocation magic such as\nscrolls of blinking ignore this limitation, as do external sources of blinking\noutside of your control.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-bbolt status"
msgid "You are recovering from becoming lightning, and are unable to blinkbolt again\nfor a short duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:charge- status"
msgid "You are currently channelling electrical charge. Pressing <w>.</w> or <w>s</w>\nto wait in place will maintain and continue this process until it discharges.\nAny other action, including recasting the spell, will dissipate the charge\nharmlessly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:charge/ status"
msgid "<Charge- status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:charge\\ status"
msgid "<Charge- status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:charge| status"
msgid "<Charge- status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:wave status"
msgid "You are currently channelling waves of flames. Pressing <w>.</w> or <w>s</w>\nto wait in place will maintain and intensify the waves, at the cost of 1 MP per\nturn. Any other action, including recasting the spell, will end it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:wave+ status"
msgid "<Wave status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ramparts status"
msgid "You are encasing nearby walls in ice. The ice will crack and fall away if you\nmove to a new position.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:bog status"
msgid "You are creating a toxic bog in the nearby area, and are immune to its effects.\nYou cannot sustain this transformation in areas out of your line of sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:enlightened status"
msgid "You are in touch with a greater truth, increasing your resistance to effects\nwhich target your willpower. Tragically, this epiphany won't last.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:will+ status"
msgid "<Enlightened status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:reap status"
msgid "The dead are hopping! Living creatures you kill may rise as zombified servants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:peek status"
msgid "You are peering down the stairs. You can freely return to the previous level, but\nonce you take any action on this floor, all stairs leading back up will collapse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fragile status"
msgid "Your body is as fragile and brittle as glass, increasing the damage you take from\nall sources.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ooze status"
msgid "Acidic ooze creeps out of the walls around you. Each turn, foes are damaged\ndepending on the number of slimy walls they remain adjacent to.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:dog status"
msgid "You have summoned your canine familiar.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-dog status"
msgid "Your canine familiar is recovering from its injuries, and cannot be summoned\nagain for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-siphon status"
msgid "You have recently siphoned the essence of the living, and cannot do so again for\na short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-word status"
msgid "You are fatigued from recently speaking a word of chaos, and are unable to do so\nagain for a short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:jinx status"
msgid "Jinxing spirits encircle you. When you attack foes, those who fail a Will check\nare jinxed, taking damage and becoming drained. The spirits depart quickly when\nno foes are in sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rise status"
msgid "You are hovering upward toward the ceiling. After a short delay, Ignis' power\nwill blast you into the level above.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:challenge status"
msgid "You have been challenged by a chosen apostle of Beogh, who will know your\nlocation no matter where on the floor you are. Defeat them, and you may recruit\nthem to join you. If you flee the floor, Beogh will punish you by temporarily\ndepriving you of allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vengeance status"
msgid "One of your apostles has been killed, and you have not yet killed all foes who\nwere involved in their death. If you do so, Beogh will resurrect them sooner.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:pray status"
msgid "You have invoked divine aid in avenging the death of a fallen apostle. Orcs will\ncontinuously rally to your side, though your prayer will end more rapidly when\nthere are no more foes around to fight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:recruit status"
msgid "An orcish apostle is available to recruit as a permanent companion.\n(Use the Recruit Apostle ability)\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:torch status"
msgid "You carry the Black Torch. If this indicator is dark, the torch is unlit; if it\nis bright, you have called upon Yredelemnul to light the torch. So long as the\ntorch burns, you will gain piety for kills. With sufficient piety, you will be\nable to use its umbral fire to empower your undead servants and damage your\nenemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:shackles status"
msgid "Yredelemnul's grip is engulfing an area in life-stealing chains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rev status"
msgid "You're starting to limber up. Your weapon-based and unarmed attacks are closer\nto full strength, and will continue to grow more powerful with each swing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rev+ status"
msgid "You're limbering up. Your weapon-based and unarmed attacks are close to full\nstrength, and will continue to grow more powerful with each swing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:rev* status"
msgid "You're limbered up. Your weapon-based and unarmed attacks are at full strength,\nand will remain so as long as you keep swinging and for a short while afterward.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-gavotte status"
msgid "Gravity around you is still unstable, and you cannot cast Gell's Gavotte again\nuntil it settles back down.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:fusillade status"
msgid "You are hurling conjured alchemical reagents at nearby monsters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:nightfall status"
msgid "You are channelling the deepest night, greatly reducing your sight range. It\nwill gradually return to normal over time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blind status"
msgid "Your vision is badly impaired. All spells and attacks you perform (which do not\nautomatically hit) have an increased chance to miss. This chance is much greater\nthe further away you are from your target.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ruin status"
msgid "You are marked with the sign of ruin, causing any melee attacks which damage you\nto heavily drain and randomly slow, weaken, or blind you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-gclaw status"
msgid "You have not yet harvested enough death to cast Grave Claw again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:legion status"
msgid "You are beckoning the legions of chaos; short-lived demons will be periodically\nsummoned near you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-bloodrite status"
msgid "You have recently performed an infernal blood rite and must fully heal before\nbeing able to perform another.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:execution status"
msgid "You are sharing your body with an Executioner, giving you a powerful auxiliary\nattack that also triggers when you dodge attacks, as well as letting you rampage\ntowards foes. This will expire quickly if you stop attacking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:destr status"
msgid "Your Unleash Destruction is growing more powerful as you use it consecutively.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:destr+ status"
msgid "<Destr status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:destr++ status"
msgid "<Destr status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:destr+++ status"
msgid "<Destr status>\nIf you use it again, it will unleash a salvo of additional bolts aimed at random\ntargets and this bonus will reset.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:slaughter status"
msgid "You are an instrument of Makhleb's destructive will. Your power and defences are\ngreatly enhanced, but you must endure the Crucible of Flesh once this effect\nends.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:pact status"
msgid "Makhleb has come to collect on certain promises made to them.\n{{ if you.religion == \"Makhleb\" then\n        return \"Fulfill your oath as their instrument by slaying the terrified \" ..\n               \"mortals that have been gathered here, and they may grant you \" ..\n               \"freedom once again.\"\n   else\n        return \"Fight and bleed and you may be granted freedom once again.\"\n    end}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:escape! status"
msgid "A path out of the Crucible has opened. Find it and claim your freedom again. For\na time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:shield status"
msgid "You are protected by a divine shield. Enemies that strike it in melee will have\ntheir attacks completely blocked, and they may also be blinded by its light.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blast status"
msgid "You are preparing to unleash a kinetic shockwave and cannot move until this is\ncomplete.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blast. status"
msgid "<Blast status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blast.. status"
msgid "<Blast status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blast... status"
msgid "<Blast status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:winding status"
msgid "You are winding up your clockwork bee. It cannot attack its target until it is\nfully wound up.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:winding. status"
msgid "<Winding status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:winding.. status"
msgid "<Winding status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:winding... status"
msgid "<Winding status>\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:unstable status"
msgid "You have become untethered in space, blinking randomly each turn and suffering a\nsmall amount of damage each time you do so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vainglory status"
msgid "You have recently announced your regal presence and it simply would not do to\nleave the floor again so soon afterward.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:protected status"
msgid "Your platinum paragon is close enough to you to sometimes parry attacks directed\nat you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vexed status"
msgid "Your mind is clouded by frustration. For the next several turns, you will\nuncontrollably attack random adjacent creatures (whether friendly or enemy) or\neven empty space.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:drowsy status"
msgid "You are rapidly growing sleepy and may soon fall asleep completely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:vampire status"
msgid "You are a vampire - a creature that straddles the border between life and\nundeath. You can drink the lifeblood of the living to heal, and even turn those\nyou slay stealthily into vampiric thralls, but do not heal in the presence of\nmonsters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:swarm status"
msgid "You have transformed into a swarm of vampire bats, allowing you to move quickly\nand evasively. You may trail clouds of bats in your wake.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:memories status"
msgid "This indicates how many spells you could cast from accumulated memories if you\nEnkindled now.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:enkindled status"
msgid "You are burning accumulated memories for power. Each damage-dealing spell you\ncast will consume a memory. In exchange, their power and spell success are\nincreased, encumbrance penalties are ignored, and your spellclaw attacks do\nbonus damage proportional to the spell level and heal you based on the damage\ndealt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:cacophony status"
msgid "You are noisily attacking with all of your armour. Every piece of armour you\nhaunt currently moves of its own volition; any damage it takes will not affect\nyou, you can freely fire through it, and its attacks may daze, drain, or confuse\nyour enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:catalyst status"
msgid "You have an explosive catalyst readied. The catalyst will detonate, dealing fire\ndamage to the primary target of each of your melee attacks and any enemy\nadjacent to them, with each hit. Attacking will extend the duration of the\ncatalyst even if you miss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:shroud status"
msgid "You are covered by a thin shroud of slime that may deflect a melee attack. When\nit does, the shroud will break for a short time, though it will soon repair\nitself naturally.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:yak status"
msgid "You are a rime yak, fur encrusted with ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:spider status"
msgid "You are an agile jumping spider whose attacks can web enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:quill status"
msgid "You have spiny quills growing out of your body which may damage melee attackers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:hive status"
msgid "You are a living beehive, abuzz with busy insects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-swarm status"
msgid "The insects that dwell within you have recently swarmed to your defence. This\nwill not happen again until your health fully recovers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:aqua status"
msgid "Your body is composed of elemental water that can reach to attack and drown\nenemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:sphinx status"
msgid "You are a cunning, riddle-loving sphinx, with the force of a windstorm in your\npaws.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:werewolf status"
msgid "You are a vicious werewolf.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:slay status"
msgid "The damage and accuracy of your attacks is temporarily increased.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:scroll status"
msgid "You are a walking scroll, parchment crisp and full of magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:crab status"
msgid "You are a heavily-armoured crab with rusting breath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:scarab status"
msgid "You are a sun scarab, with solar fire blazing beside you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:medusa status"
msgid "You have a mane of venomous tendrils for hair.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-lithotox status"
msgid "Your lithotoxin has recently activated and will not do so again until you fully\nheal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:doom status"
msgid "A malevolent fate is gathering around you. If your Doom reaches 100%, you will\nbe afflicted by a random bane and your Doom will reset to 0. Banes have diverse\nnegative effects that can significantly endanger your character for an extended\nperiod of time.\n\nBoth Doom and Banes are only cured by gaining experience, though Banes typically\nlast much longer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:ostracised status"
msgid "Your connection to the divine has been partially cut-off, temporarily reducing\nyour effective piety. Gaining experience will eventually recover all piety that\nhas been locked away this way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:tesseract status"
msgid "A Boundless Tesseract is drawing in forces from a parallel reality. New monsters\nwill steadily appear at random locations across the floor until either of the\ntesseracts is destroyed. If this is allowed to continue for a very long time,\nthose monsters may sometimes appear near your location instead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-star status"
msgid "Your orb of stardust has recently expended its energy. It will recharge once\nseveral turns pass while your MP is full and there are no enemies in sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-mesm status"
msgid "Your orb of mesmerism has recently expended its energy. It will recharge after\na short length of time (but cannot recharge on turns where you move).\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:phobia status"
msgid "Your claustrophobia has given you a slaying malus. This is dependent on the\nnumber of walls surrounding you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:dim status"
msgid "The power of all your spells is reduced by half.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:sunder status"
msgid "Your next attack will have increased accuracy, inflict three times its normal\ndamage, and cleave at an increased range. This bonus is lost if you perform any\naction besides attacking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:devious status"
msgid "Your evasion and slaying are increased. This stacks up to 3 times and will never\nexpire so long as you continue to perform melee attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:slimifying status"
msgid "Your body is slowly being turned into slime. Even if a full transformation\noccurs, you have enough force of will to eventually revert back.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:jelly status"
msgid "You have been temporarily transformed into a jelly. You have several unusual\nresistances and extra health, but heavily weakened spells.\n\nAny equipped weapons and armour are melded. The effectiveness of your\nnewly-acidic melee attacks while in this form is based on your experience level\nrather than Unarmed Combat skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:oozeregen status"
msgid "You are covered in regenerative ooze from your recent trip down the stairs. For\na brief time, your wounds will heal rapidly and your reserves of magic will\nrecover quickly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:-hellfire status"
msgid "You are unable to cast Hellfire Mortar again until the effect of your last cast\nends.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:engorged status"
msgid "Your maw has just consumed a delicious meal, greatly increasing your\nregeneration until it finishes digesting it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:eel status"
msgid "Your arms are a pair of electric eels.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:blade status"
msgid "Multiple vicious blades are growing out of your body.\n"
msgstr ""

#: crawl-ref/source/dat/descript/status.txt
msgctxt "textdb:descript/status.txt:spore status"
msgid "Your arm is a mass of multicoloured fungus.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:pick-up"
msgid "                   <h>Picking up and dropping items</h>\n\n<h>Navigation and selecting items</h>\nUse the usual navigation keys (<w>arrow</w> keys, <w>pgdn</w>/<w>pgup</w>, <w>home</w>, <w>end</w>) to select\nitems, and <w>Space</w>/<w>.</w> to toggle whether the selected item will be picked up or\ndropped. Pressing an item's letter key will also toggle its pickup/drop state.\nGear, potions, scrolls, and evocable items are on separate pages which can be\nswitched between by <w>left arrow</w> and <w>right arrow</w>.\nPress <w>Return</w> to accept the current set of items.\n\nEntering a number before selecting by letter will toggle just that quantity of\na stack of items.\n\n<h>Regular expressions</h>\nYou can press <w>Ctrl-F</w> to enter a word (or a regular expression). All matching\nitems will be selected.\n\n<h>Category shortcuts</h>\nYou can quickly select items by type by pressing:\n<w>!</w>   potions      <w>(</w>   weapons        <w>)</w>   ammunition      <w>[</w>   armour\n<w>/</w>   wands        <w>|</w>   magical staves <w>?</w>   scrolls         <w>:</w>   books\n<w>\"</w>   amulets      <w>=</w>   rings          <w>}</w>   miscellaneous\nGlobal selects:  <w>,</w>   select all     <w>*</w>   invert all      <w>-</w>   deselect all\n                 <w>;</w>   select last unequipped\nNote that for dropping, the <w>,</w> command uses the <w>drop_filter</w> option, which\nnarrows the range of items to be (de)selected. The default is all useless items.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:known-menu"
msgid "                   <h>Known items menu</h>\n\n<h>Navigation and selecting items</h>\nUse the usual navigation keys (<w>arrow</w> keys, <w>pgdn</w>/<w>pgup</w>, <w>home</w>, <w>end</w>) to select\nitems, and <w>Space</w>/<w>.</w> to toggle the autopickup mode for the selected item type.\nPressing an item type's letter key will also toggle its autopickup state.\n\n<h>Selecting item types</h>\nItem types displayed in grey use the default autopickup options set in your\nconfiguration file. (Items that are useless to your character are displayed\nin <darkgrey>dark grey</darkgrey>.) Selecting a type of item overrides those options\n(indicated by <w>white</w> text), and toggles the item between the states:\n <w>+</w>  Items of this type will be picked up automatically.\n <w>-</w>  Items of this type will not be picked up automatically.\nAutopickup can also be toggled for all unknown items of a given category.\n\n<h>Category shortcuts</h>\nYou can quickly select all item types in a given category by pressing:\n<w>!</w>   potions      <w>?</w>   scrolls      <w>(</w>   ammunition        <w>\"</w>   amulets\n<w>=</w>   rings        <w>/</w>   wands        <w>|</w>   magical staves\nGlobal selects:  <w>*</w>   invert all   <w>^</w>   reset all to default\n\n<h>Viewing unknown and known items</h>\n<w>\\</w> and <w>-</w> toggle between the known and unknown items menus. Note\nthat none of the above features are available from the unknown items menu.\n\n<h>Restoring autopickup defaults</h>\nPressing <w>Ctrl-D</w> followed by an item letter or a category shortcut\ncancels the override and restores the selected item or items to their default\nsettings.\n\n<h>Regular expressions</h>\nYou can press <w>Ctrl-F</w> to enter a word (or a regular expression).\nAll matching items will be selected.\n\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:stash-search.prompt"
msgid "<h>Searching the stash-tracker</h>\n\nYou can search for items and dungeon features by name (or a substring of the\nname). In the list of search results, you can select a search result by its\nhotkey to travel to its location.\n\nSome examples of search strings:\n<w>mutation</w>      find all potions of mutation, including potions in shops.\n<w>throwing net</w>  finds every single throwing net and piles of nets.\n<w>shop</w>          lists all shops. Press <w>!</w> and a shop's letter for the stock.\n<w>Lair:2</w>        find everything known to be on Lair:2.\n<w>/D:[2-4]</w>      finds everything on Dungeon levels 2-4. Regexes are allowed!\n              Note that /D:[3-10] will not work as intended, since [x-y] is a\n              regex character range.\n<w>rPois</w>         finds all items with an rPois resistance.\n<w>rC++</w>          finds all items with an rC++ resistance.\n<w>+3</w>            finds all items with a +3 enchantment.\n<w>/Lair.*axe</w> and <w>axe && Lair</w> both show all axes in the Lair.\n\nSome shortcuts:\n<w>.</w>             lists everything on your current level.\n<w>..</w>            lists all items you know.\n<w>0</w> to <w>9</w>        lists all items at the specified waypoint.\n<w>*</w>             lists all items at all waypoints.\n<w>@<<query></w>      lists everything matching <<query> on your current level.\n<w>/<<regex></w>      lists items matching <<regex> as a regular expression.\n<w>=<<string></w>     lists items containing <<string> as a substring.\n\nYou can also examine shops and items in the search results by pressing <w>?</w> and\nthen selecting the hotkey for the search result. This will give a description\nof the item or the contents of the shop.\n\nThe stash search string is case-insensitive.\n\n<h>Searching by item properties:</h>\n\nYou can search for spell names (such as <w>Ignite Poison</w>) to find spellbooks\nthat contain the spell.\n\nYou can search for artefact item properties (such as <w>/prevents.*teleport</w>)\nto find artefacts that have the property.\n\nYou can search by some additional item properties: <w>artefact</w> or\n<w>artifact</w> will find identified artefacts, <w>ego</w> or <w>branded</w>\nwill find non-artefacts with a brand and unidentified items which may be\nbranded, <w>throwable</w> will find things you can throw, <w>dropped</w> will\nfind items you have dropped, <w>in_shop</w> will find items in shops, and (if\nthe autopickup_search option is enabled) <w>autopickup</w> will find items that\nwould be automatically picked up.\n\nSkill names (such as <w>Polearms</w> or <w>Long Blades</w>) will find all weapons that\ntrain that skill. You can also look for <w>melee weapon</w> and <w>ranged weapon</w>.\n\nYou can also search by item types such as <w>book</w> or <w>manual</w> or <w>jewellery</w>.\nFor armour slots, use <w>helmet</w> (all headgear), <w>gloves</w>, <w>shield</w>, and <w>body</w>.\nUse <w>armour && !!body</w> to list all armour pieces except for body armour.\n\n<h>Finding Dungeon Features:</h>\n\nYou can search for dungeon features by name: all shops will be found by a search\nfor <w>shop</w> (including shops that do not have \"shop\" in their name); other\ndungeon features can also be found by name: <w>dispersal trap</w>, <w>altar</w>,\netc. You can also search for altars by deity name: <w>Zin</w>.\n\n<h>Non-regex operators:</h>\n\nYou can use !! to negate a search string, && for a boolean AND, || for\nboolean OR, and <<<< >> for grouping.\n\nFor instance, to find rings (jewellery) but not ring mail you could use:\n<w>ring && !!mail</w>\n\nNote that <w>/</w> and <w>=</w> apply to individual patterns, not the entire query:\nyou should search for <w>armour && /r(C|F|Pois|Elec)</w>, not\n<w>/armour && r(C|F|Pois|Elec)</w>.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:level-map"
msgid "<h>Level Map ('<w>X</w>' in the main screen):</h>\n<w>Esc</w>        : Leave level map (also <w>Space</w> or any unused key).\n<w>Dir.</w>       : Move the cursor.\n<w>Shift-Dir.</w> : Move the cursor in larger steps (7 by default).\n<w>-</w> or <w>+</w>     : Scroll level map 20 grids up or down.\n<w>.</w>          : Start travel (also <w>Enter</w> and <w>,</w> and <w>;</w>).\n             (Moves cursor to the last travel destination if still on @.)\n<w>[</w> or <w>]</w>     : Examine the next higher or lower level.\n             (Moves cursor to the staircase destination if a known staircase is\n             highlighted.)\n<w>G</w>          : View another level by choosing a branch and depth.\n<w>o</w>          : Move the cursor to the next autoexplore target.\n<w>{</w> or <w>}</w>     : Zoom out or in (tiles only).\n\n<h>Travel exclusions</h>\n<w>e</w>          : Create a travel exclusion, change its radius, or remove it.\n<w>R#</w>         : Create a travel exclusion with a specified radius or change\n             its radius to #, where # is a number from 1 to 8.\n<w>E</w>          : Cycle through travel exclusions.\n<w>Ctrl-E</w>     : Erase all travel exclusions on the level.\n\n<h>Waypoints</h>\n<w>w</w>          : Set waypoint to current position.\n<w>W</w>          : Cycle through all waypoints on the level.\n\n<h>Cycle through features</h>\n<w><<</w> or <w>></w>     : Cycle through up or down stairs.\n<w>^</w>          : Cycle through traps.\n<w>\\</w> or <w>Tab</w>   : Cycle through shops and portals.\n<w>I</w>          : Cycle forward through all items.\n<w>O</w>          : Cycle backward through all items.\n<w>_</w>          : Cycle through altars.\n\n<h>Other</h>\n<w>v</w>          : Examine the last remembered state of the indicated tile.\n<w>!</w>          : Annotate level.\n<w>Ctrl-C</w>     : Clear monster memory.\n<w>Ctrl-F</w>     : Forget level map.\n<w>Ctrl-U</w>     : Restore forgotten level map.{{\nif you.wizard() then\n    return \"\\n\\n\"\n          .. \"<h>Wizard commands</h>\\n\"\n          .. \"<w>T</w>          : Teleport to cursor.\\n\"\n          .. \"<w>Ctrl-X</w>     : Completely wipe out map.\"\nend }}\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:interlevel-travel.branch.prompt"
msgid "<h>Interlevel Travel (choose a branch):\n Use the shortcut letter for a branch to select the branch for travel.\n\n Once you select a branch, you will be prompted for a depth in that\n branch (more help is available there).\n\n <w>Tab</w>    : Repeat last interlevel travel.\n <w>.</w>      : Travel to a level in the current branch.\n <w><<</w>      : Go up the nearest stairs.\n <w>></w>      : Go down the nearest stairs.\n <w>Ctrl-P</w> : Travel to a level in the branch above this one.\n <w>*</w>      : Show available waypoints (if any are set).\n <w>0</w>-<w>9</w>    : Go to the numbered waypoint.\n <w>_</w>      : Show available altars (if any are discovered).\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:interlevel-travel.depth.prompt"
msgid "<h>Interlevel Travel (go to a specific level in the selected branch)\n Type in the level number you want to go to and press Enter, or use:\n <w>Enter</w>  : Go to the default level.\n <w>0</w>      : Go to the entrance to the current branch.\n <w><<</w>      : Change the default to one level above the current.\n <w>></w>      : Change default to one level below the current.\n <w>-</w> or <w>p</w> : Change default to the branch above this one.\n <w>$</w>      : Change default to deepest visited level in this branch.\n <w>^</w>      : Change default to the entrance to the current branch.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:interlevel-travel.altar.prompt"
msgid "<h>Interlevel Travel (go to an altar):\n Use the shortcut letter (the initial of a god, with TSO being replaced by 1)\n to select the altar for travel.\n\n Once you select a god, you will begin travelling to the nearst altar.\n\n <w>Enter</w>  : Repeat last interlevel travel.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:annotate.prompt"
msgid "<h>Annotate (select level):\n <w>Enter</w> or <w>.</w> : Annotate current level.\n any <w>letter</w> : Annotate a level in the branch corresponding to the letter.\n <w><<</w>          : Annotate the level upstairs.\n <w>></w>          : Annotate the level downstairs.\n <w>Ctrl-P</w>     : Annotate a level in the branch above this one.\n <w>!</w>          : Show list of dungeon branches.\n\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:skill-menu"
msgid "                        <h>Skill management</h>\n\nYou gain experience for killing monsters (and very few other activities). This\nexperience is used to train skills. The skill screen allows you to select which\nskills to train.\n\nBy pressing its letter, you can cycle if and how a skill is trained:\n  <darkgrey>- deselected</darkgrey>    Skill will not be trained.\n  + selected      Skill will be trained.\n  <w>* focused</w>       Skill will be weighted higher for training.\n\nPressing a capital letter selects that skill and deselects all the others.\nThis shortcut is useful when you want to train only one skill.\n\nTraining can be done in two modes, which are toggled with the <w>/</w> key.\n  - automatic:    Skills are weighted based on your use of them.\n  - manual:       Experience is spread evenly across all activated skills.\n\nIn training target mode you can set skill training targets: target skill levels\nat which training of the skill will be automatically disabled.\n\nHow fast you train a skill is governed by the following factors:\n  - aptitude: Shown <white>white</white> in the Apt column. Higher numbers mean that less\n              experience is needed to advance a skill. Depends on species.\n  - skill manuals: Rare books giving an aptitude bonus of <lightred>+4</lightred> in one skill.\n\nOn top of that, there are some effects which directly modify a skill, for\nexample having trained a related skill (crosstraining), or certain god powers.\nReduced skills are shown in <magenta>magenta</magenta>, and enhanced skills in <green>green</green>.\nThe training percentage (in <brown>brown</brown>) shows the relative amount of experience\nwhich will be used to train this skill.\n\nApart from (de)selecting skills, you also have the following toggles:\n  <w>/</w> :  Switch between automatic and manual training modes.\n  <w>*</w> :  Display all skills, even those which aren't currently useful.\n  <w>?</w> :  Allows you to read the descriptions of skills.\n  <w>_</w> :  Show or hide skill level modifications (god powers, crosstraining).\n  <w>!</w> :  Switch between displaying training percentage, skill cost, or training\n       targets.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:spell-library"
msgid "<h>Spell Library</h>\n<w>Tab</w> or <w>!</w>  : Cycle forward through <w>Memorise</w>, <w>Describe</w>, <w>Hide</w>, and <w>Show</w> pages.\n<w>Shift-Tab</w> : Cycle backward through these pages.\n<w>Ctrl-F</w>    : Filter the list of spells shown with a regex.\n<w>?</w>         : Show this help.\n\nBy default, the spell library opens to the <w>Memorise</w> page; to begin memorising a\nspell, just press its letter. To read a spell's description, first switch to\nthe <w>Describe</w> page by pressing <w>Tab</w>, then press the spell's letter.\n\nMost characters will not be interested in memorising the majority of spells that\naccumulate in their spell library; this is where the <w>Show</w> and <w>Hide</w> pages come in\nhandy. To hide a spell from the <w>Memorise</w> and <w>Describe</w> pages, press its spell\nletter from the <w>Hide</w> page. Hidden spells can be shown again from the <w>Show</w> page.\n\nThe <w>auto_hide_spells</w> option can be useful; when enabled, all newly discovered\nspells are hidden by default.\n\n<w>Ctrl-F</w> can be used to filter the list of spells. Any filter set in this way will\npersist until the spell library is closed and reopened, or until a new filter is\nset with <w>Ctrl-F</w>. If <w>Enter</w> is pressed at the prompt without entering any text,\nthat will reset the filter to none.\nYou can filter spells by name and by spell school.\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:wiz-monster"
msgid "<h>Create specified monster</h>\n\nTo create a monster with the default equipment for its species, simply enter\nthe species name, such as <w>kobold</w> or <w>Yiuf</w>.\n\nA hydra or slymdra can be given a specific number of heads by calling it an\nn<w>-headed</w> <w>hydra</w> or n<w>-headed</w> <w>slymdra</w> (with a maximum of 20 heads):\n\n<w>four-headed hydra</w>\n\nTo set the colour a (very) ugly thing takes when it is first created, use:\n\n<w>white very ugly thing</w>\n\nThe valid colours are <w>brown</w>, <w>cyan</w>, <w>green</w>, <w>purple</w>, <w>red</w> and <w>white</w>.\n\nA mutant beast can be customised by prefacing it with a maturity level and/or\nhyphen-separated set of traits, as follows:\n\n<w>mature shock-weird mutant beast</w>\n\nThe valid maturity levels are <w>larval</w>, <w>juvenile</w>, <w>mature</w>, <w>elder</w> and <w>primal</w>. The\nfacets are <w>sting</w>, <w>bat</w>, <w>fire</w>, <w>weird</w>, <w>shock</w> and <w>ox</w>.\n\nA slime creature's size can be set to other than normal using the prefixes\n<w>large</w>, <w>very large</w>, <w>enormous</w> or <w>titanic</w>:\n\n<w>very large slime creature</w>\n\nIf a monster is a member of a band, you can request that it be eligible for\nband members by adding the keyword <w>band</w> to the name. For instance:\n\n<w>orc warlord band</w>\n\nSpecifying <w>band</w> doesn't force bands to be placed - it requests that the game\nuse the normal chances of creating a band. A band will only be placed if there\nis space for it.\n\nA monster can be given specific items by following the monster name with a\nsemi-colon and then with an item list. For example:\n\n<w>orc ; rapier | quick blade . chain mail | plate armour</w>\n\nwill generate an orc wielding either a rapier or a quick blade and wearing\neither chain mail or plate armour. Randarts and ego items are only generated\nif they are explicitly requested. Note that any items that the monster was\noriginally generated with will be removed and destroyed. This can be used to\nforce a monster to have no items whatsoever:\n\n<w>orc; nothing</w>\n\nFor further information, see <cyan>docs/develop/levels/syntax.txt</cyan>, section <cyan>ITEMS</cyan>.\nAny reference to a slash (<w>/</w>) should be replaced with a pipe (<w>|</w>) and any comma\n(<w>,</w>) with a full stop (<w>.</w>).\n\nThe same syntax is also used to create a specific type of dancing weapon:\n\n<w>dancing weapon; rapier</w>\n\nLimitations: If a monster is given a random launcher, there is no way to force\nthe ammo type to match the launcher type. As a special case, however, a\nlauncher dancing weapon is always generated with some suitable ammunition.\n\nYou can specify that a monster will always generate a corpse by using the tag\n<w>always_corpse</w>, or that it will never generate a corpse with <w>never_corpse</w>.\n\nBy default, monsters are generated asleep. This is changed by prefixing the\nname with <w>generate_awake</w>.\n\n<w>generate_awake boulder beetle</w>\n\nA prefix of <w>patrolling</w> prevents it from walking out of sight of the the place\nwhere it was created.\n\nYou can set the monster's god using the <w>god</w>: specifier as follows:\n\n<w>orc god:the_shining_one</w>\n\nIf the monster is to be a gift of the specified god, this should be suffixed\nwith <w>god_gift</w>:\n\n<w>orc god:the_shining_one god_gift</w>\n\nNote that the monster will not be considered a god gift unless <w>god_gift</w> is\nexplicitly set.\n\nYou can set the monster's faction by specifying <w>att</w>: one of:\n\n* <w>att:hostile</w> -- the default\n* <w>att:friendly</w> -- tame, will follow you\n* <w>att:neutral</w> -- hostile to both you and att:hostile monsters\n* <w>att:good_neutral</w> -- hostile to att:hostile\n* <w>att:fellow_slime</w> -- tame, won't follow you\n\nMonsters can be given colours that override their default colour:\n\n<w>col:darkgrey fungus</w>\n\nThe colour <w>any</w> can be given, in which case a random colour will be chosen.\n\nYou can override the displayed monster tile using the <w>tile</w>: specifier as\nfollows:\n\n<w>rat tile:mons_giant_bat</w>\n\nIn tiles version, this would create a monster that uses the \"<cyan>mons_giant_bat</cyan>\"\ntile, but is otherwise identical to a rat. In ASCII mode, this will do\nnothing.\n\nIf you want to place a random monster suitable for the level the map is\ngenerated on, you can use\n\n<w>random</w>\n\nIf you want to place a random monster suitable for some other place, you can\nuse a place: tag in the monster spec:\n\n<w>place:Abyss</w>\n\nUsing <w>place</w>: implies that you want a random monster. You can also request\nzombies from random monsters suitable for some other depth as (e.g.):\n\n<w>place:Elf:3 zombie</w>\n\nThe available modifiers are <w>zombie</w>, <w>draugr</w>, <w>simulacrum</w>, and <w>spectre</w>.\n\n<h>Overriding Monster Names</h>\n\nIndividual monsters can be given names as follows:\n\n<w>kobold name:Durwent</w>\n\nThis will cause the monster to appear as \"<cyan>Durwent the kobold</cyan>\". Spaces can be\nplaced in the name by substituting them with the _ symbol. It is worth noting\nthat \"<cyan>the <<race></cyan>\" will be appended to all names, which should be considered\nwhen coming up with them.\n\nThere are three different modifiers that can be used on a name:\n<w>name_adjective</w>, <w>name_suffix and </w>name_replace. <w>name_adjective</w> makes the\nname act as an adjective. For example:\n\n<w>kobold name:ugly name_adjective</w>\n\nWill cause \"<cyan>An ugly kobold</cyan>\", \"<cyan>The ugly kobold hits you</cyan>\", and so on.\n\n<w>name_suffix</w> does the same, but after the monster's base name:\n\n<w>kobold name:wearing_mittens name_suffix</w>\n\nWill give \"<cyan>A kobold wearing mittens</cyan>\", \"<cyan>The kobold wearing mittens hits you</cyan>\",\nand so on.\n\n<w>name_replace</w> causes the base name to be replaced by given name, as if the\nmonster was a unique:\n\n<w>kobold name:Durwent name_replace</w>\n\nWill result in \"<cyan>Durwent</cyan>\" rather than \"<cyan>Durwent the kobold</cyan>\". The corpse will\nstill be a \"<cyan>kobold corpse of Durwent</cyan>\".\n\n<w>name_species</w> uses the name for corpses as-is, without prefixing it with\n\"<cyan>kobold</cyan> <cyan>corpse of X</cyan>\" for <w>name_replace</w>. It also avoids the usual name tag\nthat displays above unique and renamed monsters in local tiles.\n\nIn combination with <w>name_replace</w> or <w>name_species</w>, there are two further tags\nthat can be used when renaming monsters, but not giving them an actual \"name\":\n<w>name_descriptor</w>, and <w>name_definite</w>.\n\nFor example:\n\n<w>kobold name:goblin name_replace</w>\n\nWill result in \"<cyan>goblin hits you</cyan>\". However, adding <w>name_descriptor</w> from the\nabove flags will result in \"<cyan>The goblin hits you</cyan>\" and in the description of the\nmonster, \"<cyan>A goblin</cyan>\".\n\n<w>kobold name:goblin name_replace name_descriptor</w>\n\nThe <w>name_definite</w> flag ensures that it is never referred to as \"<cyan>a</cyan>\" or \"<cyan>an</cyan>\",\nbut that the definite object is always used. Therefore, you will see \"<cyan>The\n<cyan>goblin</cyan> <cyan>hits you</cyan>\", as per above, but also \"<cyan>The goblin</cyan>\" in its description.\nSetting <w>name_definite</w> will automatically set the flag <w>name_descriptor</w>,\ntherefore meaning that:\n\n<w>kobold name:goblin name_replace name_definite</w>\n\nis exactly the same as:\n\n<w>kobold name:goblin name_replace name_descriptor name_definite</w>\n\n<w>name_zombie</w> can be used to redefine already zombified monsters (including\ndraugr, simulacra and spectrals).\n\nFinally, <w>name_nocorpse</w> will cause the name to be completely ignored for\ncorpses. For example:\n\n<w>wizard name:sad name_adjective name_nocorpse</w>\n\nwill result in \"<cyan>a sad wizard</cyan>\" that leaves \"<cyan>a wizard corpse</cyan>\".\n\nFor instances where space in definitions is limited, you can use abbreviated\nforms of these tags:\n\n* <w>name_suffix</w> -> <w>n_suf</w>\n* <w>name_adjective</w> -> <w>n_adj</w>\n* <w>name_replace</w> -> <w>n_rpl</w>\n* <w>name_species</w> -> <w>n_spe</w>\n* <w>name_descriptor</w> -> <w>n_des</w>\n* <w>name_definite</w> -> <w>n_the</w>\n* <w>name_zombie</w> -> <w>n_zom</w>\n* <w>name_nocorpse</w> -> <w>n_noc</w>\n\n<h>Overriding Monster Stats</h>\n\nFurther monster customisation can be made by using <w>hd</w> and <w>hp</w>. These two tags\nallow you to completely overwrite the original hit dice and hit points of a\nmonster:\n\n<w>kobold hd:20</w>\n\nCreates a kobold with a hit dice of 20. As its hp is randomised, based on its\nhit dice, this will also be re-rolled. Monsters with a specific hit point\nvalue will not have this value change.\n\nYou can also have a specific value for hit points:\n\n<w>kobold hp:20</w>\n\nCreates a kobold with 20 hit points. This is also useful for monsters (such as\nstatues) which come with non-randomised HP values.\n\nMonsters can be marked as summoned by using <w>dur</w> and <w>sum</w> tags. The <w>dur</w> tag\naccepts an integer between 1 and 6 inclusive. The <w>sum</w> tag accepts the name of\na spell (parsed as per the <w>spells</w> tag, described below) or any of <w>clone</w>\n(Rakshasa), <w>animate</w> (from animate dead), <w>chaos</w> (made from pure chaos), <w>miscast</w>\n(summoned from by spell miscast effect), <w>zot</w> (summoned by a Zot trap), <w>wrath</w>\n(summoned by a god in an act of retribution), <w>aid</w> (summoned by a god in order\nto give aid).\n\nOf the spells, <w>shadow_creatures</w> has the most significant effect, in that\nmonsters will dissipate into the shadows rather than disappear in a puff of\nsmoke. Using non-summoning spells will also have no effect.\n\nTagging a monster with <w>seen</w> will override the system and force that monster to\nbe marked as already viewed; this means that it won't generate messages such\nas \"<cyan>A kobold comes into view</cyan>\".\n\n<h>Overriding Monster Spells</h>\n\nMonster spell sets can be overridden with a <w>spells</w>: tag, used as follows:\n\n*<w>goblin spells:throw_flame.50.wizard</w>\n*<w>ancient lich spells:symbol_of_torment.26.wizard; glaciate.51.wizard</w>\n\n(a list of spell slots, consisting of a spell name with spaces replaced with\nunderscores, a frequency of casting and set of spell slot flags specified\nafterwards with <w>.</w>, with slots separated by <w>;</w>. There should be no spaces around\nthe <w>;</w> or after the <w>spells</w>: prefix)\n\nSpell names must exactly match the names in <cyan>spl-data.h</cyan>, with spaces replaced\nby underscores. Spell frequencies are an (x in 200) chance that that spell\nwill be cast. Spell flags include:\n\n* <w>natural</w>, <w>magical</w>, <w>demonic</w>, <w>wizard</w>, or <w>priest</w> - the manner in which this\nspell is being cast. Wizards and priests can be silenced and will trigger\nappropriate conducts (Trog will appreciate killing wizards, Beogh will\nappreciate killing priests). Magical, demonic, and wizard spells are subject\nto anti-magic effects. Natural spells do not generate noise.\n* <w>emergency</w> - the monster will only cast the spell when low on health.\n* <w>breath</w> - the spell is a breath weapon, and using it triggers a breath\ntimeout during which the spell cannot be cast again.\n* <w>no_silent</w> - the spell cannot be used while silent, even if it is an ability\ntype normally not subject to silence.\n* <w>instant</w> - the spell does not expend the monster's energy; they may take\nanother action on the same turn.\n* <w>noisy</w> - forces the spell to make noise even if it is a natural ability.\n\nYou may use <w>none</w> specify that a slot should be left empty. You can force a\nspell-less monster with:\n\n<w>orc wizard spells:none</w>\n\n<h>Setting enchantments</h>\n\nYou may give a monster any number of enchantments. It may start hasted, blind,\nhave permanent RMsl, etc. The syntax is <w>ench:<<name>:<<duration>:<<degree></w> or\n<w>perm_ench:<<name>:<<degree></w>. The <w><<degree></w> and <w><<duration></w> fields may be\nomitted.\n\nFor example:\n\n* <w>orc perm_ench:blind perm_ench:mad</w>\n* <w>dream sheep ench:sticky_flame</w>\n* <w>stone giant dur:1 ench:berserk</w>\n\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:macro-menu"
msgid "<h>Editing macros and keymaps</h>\n\nTo edit a current macro/keymap, select from the menu using the arrow keys or\nby hotkey. (Hotkeys that are used to navigate the menu can be selected by\narrow keys). To create a new mapping by entering a key, use the [<w>~</w>] key\nor the corresponding menu item, and then enter the key. This allows you to\ncreate (and edit) mappings that use menu keys. Use the [<w>!</w>] key to switch\nto keymap editing mode (see below for more information on keymaps).\n\n<w>Macros</w> allow remapping keys that are sent to the game when inputting\ncommands. This can be used to redefine a command key, or to define an unused\nkey. They map a key to a sequence of keystrokes, and keystrokes do carry over\ninto submenus.\n\nExample 1: mapping <w>e</w> to <w>p</w> would let the `e` key trigger the same\ncommand as the `p` key (which on the default settings is autofire).\n\nExample 2: mapping <w>1</w> to the sequence <w>zaf</w> would let the `1` key\ncast a spell that is on the letter `a` with default targeting.\n\nExample 3: mapping <w>F1</w> to <w>Q&a</w> would let the F1 key quiver the spell\nthat is on letter `a`.\n\n<w>Keymaps</w> are lower-level key substitutions that replace keys entirely with\na sequence of keystrokes. They are recommended for changing keys uniformly to\ndeal with alternative keyboard layouts. Keymaps are contextual, and the\ndefault/\"regular\" context is used anywhere that a non-specialised context is not\nactive. Macros take the result of keymaps as input.\n\nExample: In some European keyboard layouts, the § symbol replaces ~. Therefore,\nit could be useful to keymap § to ~ in both the regular and menu keymap contexts\nso that the main menu and macro menu become a bit easier to access. (In other\nlayouts, this applies instead to ½.)\n\nWhen used for mapping commands, keymaps can have unexpected side effects: e.g.\nmapping <w>1</w> to <w>zaf</w> via keymap is not recommended, because this will\nmake it hard to type `1` when entering a skill target.\n\n<w>Keycodes</w>: Both macros and keymaps accept keycodes when describing the\naction, in the form of <w>\\{n}</w> to enter keycode <w>n</w>. (Use <w>\\\\</w> to\nenter a backslash.) For example, use <w>\\{9}</w> to enter the keycode for the\n<w>tab</w> button. You can bind macros and keymaps by keycode by using <w>~~</w>\nat the macro edit menu.\n\n<w>Saving</w>: Bindings edited at this menu are saved in a .macro file in your\nsave directory. They will be overridden by settings in your options file. See\nthe `macro` command in options_guide.txt for more information.\n\n"
msgstr ""

#: crawl-ref/source/dat/database/help.txt
msgctxt "textdb:database/help.txt:console-keycodes"
msgid "<h>Keycodes for console and webtiles</h>\n\nKeycodes can be entered as numbers, or in some cases, human readable strings.\nThe following tables give both the numeric keycode, and the string; modified\nkeys generally must be entered by number. When entering a keycode  as part of a\nmacro action, it should be wrapped using the following syntax for keycode n:\n<w>\\{n}</w>. This should also be used when defining a keycode by number in your\nrc file. Example: when defining a macro that triggers F1, you can write\n\"\\{F1\\}\" or \"\\{-265}\". For named keys as part of a macro definition, the \\{}\nmay be omitted.\n\nPositive numeric values are ASCII character codes. Negative values are\ncrawl-internal keycodes for special keys. The sign is required for these to\nbe interpreted correctly. Keyboards vary quite a bit, and so not all of these\nbindings are available on all keyboards; cases where there is often variation\nare indicated specifically below.\n\nThe following is a quick-reference for some of the main keys you might want to\nbind.\n\n<w>8</w>: Backspace (and/or Delete, depending on keyboard)\n<w>9</w>: Tab\n<w>13</w>: Enter (and/or the Return key, depending on keyboard)\n<w>27</w>: Esc\n\n<w>-233</w>: Shift-Tab\n<w>-222</w>: Ctrl-Tab (on some keyboards)\n<w>-255</w>: Delete (on some keyboards)\n<w>-265</w>: F1   <w>-264</w>: F2   <w>-263</w>: F3   <w>-262</w>: F4   <w>-261</w>: F5\n<w>-260</w>: F6   <w>-259</w>: F7   <w>-258</w>: F8   <w>-257</w>: F9   <w>-256</w>: F10\n\nKeycodes up to F22 are defined, but may not work on all builds. (On webtiles,\nF11 and F12 are reserved.)\n\n<w>Number pad and navigation keys:</w>\n\nOn many keyboards, <w>numlock</w> switches between the number keys and\nnavigation keys. Modifiers for these keys may not work on all keyboards. When\nmodified number pad keys do work, Shift and Ctrl typically treats those keys as\nmodified navigation keys regardless of numlock status.\n\nNavigation keys:\n\n<w>-245</w>: PgDn    <w>-234</w>: Shift-PgDn    <w>-223</w>: Ctrl-PgDn\n<w>-246</w>: PgUp    <w>-235</w>: Shift-PgUp    <w>-224</w>: Ctrl-PgUp\n<w>-247</w>: Clear   <w>-236</w>: Shift-Clear   <w>-225</w>: Ctrl-Clear\n<w>-248</w>: End     <w>-237</w>: Shift-End     <w>-226</w>: Ctrl-End\n<w>-249</w>: Home    <w>-238</w>: Shift-Home    <w>-227</w>: Ctrl-Home\n<w>-250</w>: Insert  <w>-239</w>: Shift-Insert  <w>-228</w>: Ctrl-Insert\n<w>-251</w>: Right   <w>-240</w>: Shift-Right   <w>-229</w>: Ctrl-Right\n<w>-252</w>: Left    <w>-241</w>: Shift-Left    <w>-230</w>: Ctrl-Left\n<w>-253</w>: Down    <w>-242</w>: Shift-Down    <w>-231</w>: Ctrl-Down\n<w>-254</w>: Up      <w>-243</w>: Shift-Up      <w>-232</w>: Ctrl-Up\n\nNumber pad keys:\n\n<w>-1007</w>: NP7   <w>-1008</w>: NP8   <w>-1009</w>: NP9\n<w>-1004</w>: NP4   <w>-1005</w>: NP5   <w>-1006</w>: NP6\n<w>-1001</w>: NP1   <w>-1002</w>: NP2   <w>-1003</w>: NP3\n<w>-1000</w>: NP0\n<w>-1010</w>: NPenter\n<w>-1012</w>: NP/   <w>-1015</w>: NP*   <w>-1016</w>: NP+   <w>-1018</w>: NP-\n<w>-1019</w>: NP.   <w>-1021</w>: NP=\n\nSome number pad punctuation keys may not be distinguished from their \"regular\"\ncounterparts, again depending on keyboard and build.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ashenzari"
msgid "While it seems inconceivable that the divine could be shackled, Ashenzari is\njust that: bound to the sky for eternity, the unbudging god is all-knowing,\nall-seeing. Devoted worshippers are allowed to grasp shreds of this knowledge\nand foresight, but be warned: to Ashenzari, power and blessing and curse are\nall the same thing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:beogh"
msgid "A god of outcasts, pariahs, and the dispossessed, Beogh's altars are rarely\nfound among those of other faiths, but Beogh's missionaries may always be sought\nby those looking for a place to belong. Worshippers will find many friends\nwithin the dungeon, and those who prove their strength to Beogh may gain\nlifelong companions the equal of any adventurer. To worship Beogh is to believe\nthere is strength that transcends species and bloodline. To worship Beogh is to\nbe an orc.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:cheibriados"
msgid "Cheibriados is a god of deliberation. Those following Cheibriados travel more\nslowly the further they progress in their faith, and are forbidden from using\nany means to hasten themselves. In the process of so imitating their god, they\nattain perfection of mind and body, and the mysteries of time unfold before\nthem. Especially devout followers may even momentarily abandon the flow of\ntime and its needless disturbances.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:dithmenos"
msgid "Dithmenos is the god of night and of things half-seen in flickering torchlight.\nWorshipped by actors as often as thieves, followers of Dithmenos can learn to\ncontrol their own shadow as if it were an extension of their body - misdirecting\nonlookers and acting upon the world with force as tangible as anything that has\never been imagined lurking in the dark.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:elyvilon"
msgid "Elyvilon the Healer welcomes all kind souls prepared to help others. Those\nindividuals can expect to gain powerful healing abilities, by which they can\navoid bloodshed. Elyvilon appreciates exploration of the dungeon. Elyvilon's\nfollowers can convert to the Shining One or Zin while keeping some piety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:fedhas"
msgid "Fedhas is the god of plant and fungal life. Followers are prevented from\nharming any species under Fedhas' protection. In return, Fedhas grants a number\nof abilities that promote the growth of plants and fungi. These abilities may\nincidentally prove useful to adventurers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:gozag"
msgid "Gozag Ym Sagoz the Greedy teaches that the world belongs to the rich. Those\naccepting this principle may exchange their gold for divine assistance.\nFollowers of Gozag do not earn piety; the only way to impress this god is by\namassing a fortune, and worshippers may request as much assistance as they can\nafford. Fortunately, Gozag's worshippers are said to have the touch of gold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:hepliaklqana"
msgid "Hepliaklqana the Forgotten accepts the worship of those who would remember\ntheir forebears, and fight alongside the greatest of them all. Acolytes of\nHepliaklqana sacrifice a small part of their life essence to manifest their\nancestor into the world; as they explore and form new experiences, they will\nfind themselves able to shape and control their ancestor's memory, eventually\nbringing them into the ranks of the mythical heroes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ignis"
msgid "Ignis the Dying Flame offers followers power over fire in many forms. All of\nIgnis' power is offered unconditionally to any who would deign to worship, but\nonce used, it can never be replenished. Ignis' other worshippers deserted long\nago; the divine fire burns low, and soon it will go out.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:jiyva"
msgid "Jiyva is the ancient deity of the slimes. Followers are expected to\nsupport the spread and satiation of their fellow slimes by allowing them to\nconsume items, and are prevented from harming any slimes. Especially favoured\nfollowers will become as shapeless as their god, mutating wildly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:kikubaaqudgha"
msgid "Kikubaaqudgha is a terrible Demon-God, served by those who wish to indulge in\nthe powers of death. An evil god, Kikubaaqudgha requires worshippers to cause\nthe death and destruction of as many creatures as possible. In exchange,\nKikubaaqudgha offers great assistance to the aspiring necromancer: a supply of\nuseful bodies, knowledge of dark magic, and protection against necromantic\nbacklash.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:lugonu"
msgid "Banished to the chaotic realm of the Abyss, Lugonu the Unformed seeks followers\nto spread bloodshed and corruption in the overworld. Those who gain Lugonu's\nfavour will be granted some of the power of the Abyss itself, allowing them to\ncall forth eldritch horrors, and even to travel between the overworld and the\nAbyss at will.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:makhleb"
msgid "Makhleb the Destroyer is a fearsome deity of bloodshed and mortification of the\nflesh. Followers are expected to cleanse others by inflicting suffering and\ndeath on them in Makhleb's name. Dedicated followers may also access the raw\nenergies and hell-spawned servants of chaos, so that they may better break the\nimpure world and its false laws for their evil god's glory.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:nemelex xobeh"
msgid "Nemelex is a strange and unpredictable chaotic trickster god, whose powers are\ninvoked through magical packs of cards painted in the ichor of demons. Followers\nwill be granted decks of cards as they traverse the dungeon, and are encouraged\nto trust in the cards to provide them with divine assistance. However, the\nTrickster can also ensure that fortune favours the bold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:okawaru"
msgid "Okawaru is a dangerous and powerful god of battle. Followers are expected to\nconstantly prove themselves in combat, and may channel Okawaru's might to\nenhance their prowess. Okawaru demands that followers prove themselves by their\nown strength alone, and so worshippers are forbidden from gaining allies by any\nmeans. Okawaru pays little heed to easy victories, but will reward worshippers\nfor heroic feats against mighty foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:pakellas"
msgid "Pakellas the Inventive believes in the supremacy of devices, magical or\notherwise, over spells and other forms of magic. Followers, although cut off\nfrom ambient magical power, are provided with magical energy to empower their\ndevices so long as they use them to assert Pakellas' supremacy. Pakellas will\ngrant devout worshippers access to increasingly powerful devices.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:qazlal"
msgid "Qazlal Stormbringer is a violent god of tempests, who delights in unleashing\nthe forces of nature against the unsuspecting. Those who invite Qazlal's gaze\nwill find themselves the eye in a storm of elemental destruction, from which\nonly their God can protect them. Pious worshippers of Qazlal will gain the\nability to direct and control the destructive might of the storm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ru"
msgid "Of all the gods, only Ru opposed creation. Not as folly, but as distraction.\nInitiates of Ru can open channels to the powers underlying the visible world by\nrenouncing the fetters that bind them here. These sacrifices are not made to\nRu, but rather given up freely and permanently. Having made such sacrifices,\ninitiates will become able to draw upon this immense power to aid themselves,\neventually gaining the ability to unleash its destructive might against their\nfoes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:sif muna"
msgid "Sif Muna the Loreminder is a contemplative but powerful deity, served by those\nwho seek magical knowledge. Followers who triumph over their foes can call upon\nthe Loreminder for magical power and the ability to cast spells beyond their\nmagical training. The devout are rewarded with a supply of spellbooks taken\ndirectly from Sif Muna's legendary library.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:the shining one"
msgid "Followers of the Shining One are bound to the code of the honourable warrior,\nsoldiers in their god's eternal crusade against evil. For forsaking dark magic\nand underhanded tactics, the Shining One rewards them and their allies with the\npower they need to slay demons and the undead. Especially devout warriors can\neven call upon angels in times of need. The Shining One's followers can convert\nto Elyvilon or Zin while keeping some piety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:trog"
msgid "Trog is an ancient god of anger and violence. Followers are expected to kill in\nTrog's name, and especially to slay wizards. In return, worshippers of Trog\ngain the ability to go berserk at will in combat, and will be granted\nassistance in the form of powerful weapons and mighty allies. Followers are\nabsolutely forbidden the use of spell magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:uskayaw"
msgid "Uskayaw the Reveller is a god of ecstatic dance. In the dungeon, Uskayaw\nappreciates the passion and rhythm of combat, rewarding followers for each\nstrike they deliver and for the damage they deal their foes. The longer the\ndance continues, the greater powers Uskayaw offers. When the dance ends,\nUskayaw quickly loses interest.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:vehumet"
msgid "Vehumet is a god of the destructive powers of magic. Followers will gain divine\nassistance in commanding the hermetic arts, and the most favoured stand to gain\naccess to some of the fearsome spells in Vehumet's library. One's devotion to\nVehumet can be proven by the causing of as much carnage and destruction as\npossible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:wu jian"
msgid "The Wu Jian Council is a congregation of martial monks, ascended to divinity\nafter battling their way out of the afterlife. Disciples of the Council are\nable to execute acrobatic martial maneuvers, such as wall jumps, spinning\nattacks and punishing lunges. They will eventually become able to request\nhelp in the form of a storm of heavenly clouds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:xom"
msgid "Xom is a wild and unpredictable god of chaos, who seeks not worshippers but\nplaythings with which to toy. Many choose to follow Xom in the hope of\nreceiving fabulous rewards and mighty powers, but Xom is nothing if not\ncapricious. There is nothing a follower can do to influence Xom's mood.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:yredelemnul"
msgid "Cast down by the good gods eons ago, Yredelemnul seeks to despoil their\ncreations and chain all living souls within their inexorable grip. Followers who\nwould conquer in Yredelemnul's name are granted the power to reap an army of the\ndead and bind powerful souls into eternal service - provided they can sweep\nacross the land in a tide as inexorable as their god.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:zin"
msgid "Zin is a god of discipline. Followers must remain pure of body and soul,\nrefraining from dark magic and chaotic acts. They must also tithe a fraction of\nall gold gained, preferably followed by donations of more. In exchange,\nworshippers may invoke Zin's wrath upon sinners, and eventually gain various\ndivine protections. Zin's followers can convert to Elyvilon or the Shining One\nwhile keeping some piety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ashenzari powers"
msgid "Ashenzari exhorts followers to curse their possessions, periodically offering\nthese curses to worshippers as they explore. These curses grant improvements\nto specific skills, but cursed equipment cannot normally be enchanted and can\nonly be removed by shattering it forever. As worshippers equip more cursed\nequipment, Ashenzari will grant increasing knowledge of the surrounding dungeon.\nEventually, Ashenzari will reveal the invisible, grant clarity of mind, and\nprotect worshippers from the Dungeon's malevolent forces.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:beogh powers"
msgid "Worshippers will gain the power to call down Beogh's wrath upon their\noppressors, and other orcs will start to see them as one of their own.\nEspecially promising adherents will find themselves beset by rivals for Beogh's\nfavour, but overcoming these trials without fleeing will gain them loyal\ncompanions whom Beogh will resurrect time and time again, so long as they\ncontinue to fight and avenge in Beogh's name. A true chosen one may even rally\nan entire orcish army to avenge a wrongful death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:cheibriados powers"
msgid "Followers of Cheibriados move more slowly as they gain favour. As they move\nslower, worshippers of Cheibriados are granted increased attributes.\nCheibriados rewards the faithful with the power to slow other creatures and the\npower to briefly distort the flow of time. Devout worshippers will gain the\nability to inflict great harm on all those who move more quickly than they do,\nand finally the ability to step out of the flow of time entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:dithmenos powers"
msgid "Followers of Dithmenos are surrounded by an unnatural quiet, which helps the\nsounds they make go unnoticed. As they rise in devotion, they will find their\nown shadow begins to imitate some of their actions, attacking when they attack\nand even casting shadowy magics that mimic the form - if not the substance - of\nwhichever schools of magic they had been utilising.\n\nMore devout worshippers additionally gain the ability to swap places with their\nshadow to mislead enemies, grasp other beings' shadows to unleash their magic on\nthe worshipper's behalf, and finally call down a night so dark that it hides all\ndenizens of the dungeon from each other.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:elyvilon powers"
msgid "The Healer offers followers a number of means to heal themselves from damage\nand other ill effects. Followers may also attempt to pacify hostile monsters\nand turn them neutral. Elyvilon may directly intervene to save a follower's\nlife, and if there has been no such intervention recently, is sure to prevent\na killing blow against especially pious followers. Elyvilon may also\noccasionally protect the follower's allies from death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:fedhas powers"
msgid "Plants and fungi will not attack Fedhas' worshippers without provocation.\nWorshippers may walk through plants or fungi, and even fire missiles or spells\nthrough them without causing harm. Fedhas grants powers to temporarily grow a\nmenagerie of plant allies whose strength and duration increase with Invocations\nskill. Worshippers may grow a protective wall of briar patches as well as\nballistomycetes that fire damaging spores whose explosions confuse living\ncreatures. Devout followers can overgrow a stretch of solid terrain with a\ncluster of plant allies or even summon a mighty oklob plant.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:gozag powers"
msgid "For Gozag, both flesh and spirit are inferior to wealth, and therefore all\nmonsters are turned to gold upon death. Other monsters may then be briefly\ndistracted by imaginings of great wealth. Stalwarts can purchase immediate help\nin the form of potions, and may also pay to attract shopkeepers into the\ndungeon. Particularly well-off adherents may bribe the inhabitants of a branch\nof the dungeon to turn a blind eye to their presence, or even to change their\nallegiance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:hepliaklqana powers"
msgid "Hepliaklqana's worshippers are served by a guardian formed from a part of their\nlife essence, in the shape of their greatest ancestor. This ancestor is at\nfirst remembered as they were at the start of their fabled adventures, but will\nadvance in skill as their descendant does. Hepliaklqana always allows followers\nto recall their ancestor to their side, and, even if the ancestor is destroyed,\nHepliaklqana will call it forth again not long after. Further advancement in\nHepliaklqana's service allows worshippers to restore and strengthen their\nancestor, to swap them with other creatures, and to choose how to remember\ntheir life's talents.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ignis powers"
msgid "Followers can armour themselves in flame, call a swarm of foxfires against their\nfoes, or let Ignis' heat lift them to another level of the dungeon. However, the\nguttering flames of Ignis' power will only sustain a limited number of\ninvocations before only flickering embers remain. No matter how depleted, Ignis\nwill always grant followers resistance to fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:jiyva powers"
msgid "Jiyva will gradually fill the dungeon with jellies. These and any other fellow\nslimes will rapidly consume nearby items, as well as slowly consuming items from\nelsewhere in the dungeon. As they spread slime across more of the dungeon, Jiyva\nwill grant followers increasingly rapid health and magic regeneration, and will\nbegin mutating them to better reflect Jiyva's image. Followers will later become\nable to call forth acidic ooze from the walls of the dungeon, and to turn\nmonsters to slime with a touch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:kikubaaqudgha powers"
msgid "Kikubaaqudgha will enhance servants' necromantic prowess with gifts of\nNecromancy spells. Kikubaaqudgha will protect followers from the effects of\nnecromantic miscasts and death curses, and may even shield them from unholy\ntorment. Followers can unearth dying wretches as necromantic fodder, and may\ninvoke the sign of ruin to harm their enemies. Kikubaaqudgha will eventually\nallow followers to either receive knowledge of the most forbidden necromantic\nmagic, or to have their weapon imbued with pain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:lugonu powers"
msgid "Followers of Lugonu gain powers to depart the Abyss at will, to banish monsters\nthere, and to flee back inside when needed. Lugonu will also banish nearby foes\nif any other god attempts to interfere with their followers. Later, followers\nwill be able to corrupt the ordered world, opening a gate for creatures\nof the Abyss to pass through, and to gate themselves directly into this realm of\nchaos. Lugonu will protect followers who unwield weapons imbued with the\ndistorting energies of the Abyss, and eventually will offer to distort a\nfollower's melee weapon. Lugonu expects followers to spread unceasing\nchaos in the overworld, and as such does not grant piety to worshippers while\nthey remain in the Abyss itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:makhleb powers"
msgid "Makhleb offers followers the ability to unleash bolts of chaotic destruction at\nthe cost of their own health as well as call in help from powerful (if sometimes\nuncooperative) demons. The most devoted of worshippers will eventually be gifted\nwith knowledge of Infernal Marks, allowing them to ritually brand their own\nbodies in exchange for one of the Destroyer's many hellish powers.\n\nMakhleb's powers all come with a price in blood. However, Makhleb will grant\nfollowers renewed health in return for killing beings of all kinds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:nemelex xobeh powers"
msgid "The Trickster's followers gain various ways to influence fate when playing\ntheir cards. The effects of the cards will be more powerful with higher piety\nand with greater Invocations skill. Later, followers will gain powerful\nabilities to manipulate the cards, allowing them to choose one of three drawn\ncards, to gain the effects of multiple cards at once, and finally to stack\ndecks and re-order their contents.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:okawaru powers"
msgid "Followers of Okawaru will gain the ability to temporarily increase their skills\nin combat, and, much later, to deal much faster blows. Okawaru will eventually\ngift followers with ammunition, weapons and armour. The most favoured of\nOkawaru may challenge their foes to honourable single combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:pakellas powers"
msgid "Followers of Pakellas do not regenerate their magic power naturally, and are\nforbidden from using external means to do so; instead, they are granted\nmagical energy on killing beings. They may use increasing amounts of magical\nenergy to strengthen their devices, temporarily granting them additional\npower, and can also use their magical energy to recharge their devices.\nSufficiently devout followers will receive new devices from Pakellas, and may\neventually petition Pakellas to personally charge one of their devices beyond\nits normal limits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:qazlal powers"
msgid "Followers of Qazlal are protected from all clouds. As a follower of Qazlal\ngains divine favour, they are slowly surrounded by a loud storm. In addition to\ngenerating noise, the storm causes elemental clouds to appear near followers,\nblocks attacks, and (for the particularly devout) deflects incoming\nprojectiles. Qazlal allows followers to incite nature against their foes,\ncausing a localised natural disturbance or, for particularly devout followers,\na more widespread disaster. Followers of Qazlal eventually gain temporary\nresistances after taking damage, and can give life to clouds, turning them into\nallied elementals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ru powers"
msgid "Ru will offer followers a number of sacrifices as they travel the dungeon. On\naccepting these sacrifices, followers will gradually gain an aura of immense\npower. This aura will initially cause foes that attempt to harm them to falter\nand become stricken with maladies. After making further sacrifices, followers\nwill be able to draw on this power to restore their health and magic, or to\nmake a lightning-fast explosive leap. Exceptional sacrificants can unleash\ntheir power in a massive strike against all their foes. Each of the powers of\nRu's sacrificants increases in strength with more piety from more sacrifices.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:sif muna powers"
msgid "Sif Muna grants followers the ability to rapidly restore their magical energy,\nand to forget spells at will, so as to learn new ones. Worshippers can call\nupon the Loreminder to help cast any spell they've discovered, even if it's\nwell beyond their current magical training. Over time, devout followers will\nreceive spellbooks containing a vast range of spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:the shining one powers"
msgid "Followers of the Shining One are surrounded by a halo that reveals their\nenemies to them. Followers will gain power by killing evil beings, and with\ngrowing piety their life force will be protected. The Shining One will keep\nsummoned and charmed allies on their side longer, should the allies prove\nworthy of the crusade. Followers will gain use of a divine shield to protect\nthem in battle. Later, they can channel blasts of cleansing flame that are\nparticularly damaging to unholy beings, and can call upon powerful divine\nbeings as temporary allies. Highly pious followers may request the Shining\nOne's blessing upon a weapon. The Shining One may occasionally directly\nintervene to save a follower's life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:trog powers"
msgid "Trog offers various powers to help followers in battle. Followers will gain the\nability to go berserk at will, and Trog will extend the duration of their\nberserk rage on killing foes. Trog will grant followers the ability to rapidly\nheal their wounds while fortifying their willpower, and later the ability to\ncall in powerful raging allies. Eventually, Trog will gift followers with\nweapons, often with antimagic effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:uskayaw powers"
msgid "Worshippers of Uskayaw can stomp to damage foes around them, and rapidly move\nthrough a line of creatures while confusing them. When a worshipper's dance\nreaches a certain point, Uskayaw will immediately stop all foes so that the\ndancer may take a solo. As the dance continues, Uskayaw will link the emotions\nof foes, forcing them to share their pain. The duration of these effects will\nincrease with Invocations skill, and as long as the intensity of the dance is\nsufficient they may be repeated after a short time. If the dance continues\nfurther, Uskayaw allows worshippers to end it by melding with and then\nviolently exploding from a foe, killing it instantly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:vehumet powers"
msgid "Worshippers of Vehumet will quickly be able to recover their magical energy\nupon killing beings. As they gain favour, they will also gain enhancements to\ntheir destructive spells — first assistance in casting such spells and then\nincreased range for conjurations. Vehumet will offer followers the knowledge of\nincreasingly powerful destructive spells as they gain piety.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:wu jian powers"
msgid "Disciples of the Council learn to perform three martial techniques while moving\naround in combat. They will also be taught to move at unfathomable speeds for\nshort distances, and become able to summon a storm of golden clouds to increase\ntheir precision and damage for as long as they keep using martial attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:xom powers"
msgid "To worship Xom is to live riskily. In a good mood Xom may shower worshippers\nwith gifts, while at other times this capricious god could decide to “spice\nthings up a little” and send worshippers to their doom. If such toys of Xom\nprove to be interesting, so much the better; if not, well, there'll be other\nplaythings...\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:yredelemnul powers"
msgid "Followers of Yredelemnul carry the Black Torch, allowing them to gather souls\nand surround themselves in darkness. They can raise foes who die in the light of\nthe torch as mindless servants, hurl torchlight to scour the living and empower\nthe dead, and bind especially noteworthy souls to fight for them in death with\nthe full capacities they held in life. Especially devout worshippers can even\ncall down the inescapable grip of the Fallen directly, binding foes helplessly\nin place as the very life is sucked from them. Yredelemnul will also dispatch\nundead servants to aid followers at the start of each new conquest.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:zin powers"
msgid "Zin grants followers the ability to preach to the unenlightened masses, and\npowers to vitalise their bodies, protecting them from various afflictions.\nLater, followers gain the ability to imprison their foes temporarily. Followers\ncan eventually find temporary safety in a divine refuge. As piety grows,\nfollowers will be protected from mutation and the Hells, and Zin may even\noccasionally directly intervene to save a follower's life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ashenzari wrath"
msgid "Those who abandon Ashenzari will immediately have their curses shattered,\ndestroying whichever items they imbued with divine wisdom. Thereafter,\nAshenzari's wrath is constant and unrelenting for its duration. Victims will\nfind their skills impaired, and their enemies divinely guided – never losing\ntrack of them, never ending the hunt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:beogh wrath"
msgid "Blasphemers against the word of Beogh find themselves assaulted by waves of\norcish warriors, or by dancing electric weapons. Beogh may also simply smite\nsuch blasphemers – and when smiting true sinners, Beogh has a heavy hand\nindeed! Those who still worship Beogh will also find their followers regularly\ndeserting them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:cheibriados wrath"
msgid "Offenders against Cheibriados will find their movements remain slow while\nthe attention of Cheibriados remains upon them, and may have any magical hasting\nstripped away. They may also become further slowed, be put to sleep, or be\nbeset by the unparalleled volume of the inevitable passage of time ringing\nthroughout the Dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:dithmenos wrath"
msgid "When angered, Dithmenos turns the shadows against victims. Monsters emerge from\nthe darkness, both illusions woven from shadow and the very shadow themselves\nturning against sinners. Dithmenos' subtle punishments are, if anything, more\ndangerous: victims find the shadows ripped away from them, hunted with nowhere\nto hide; or find themselves smothered in shadow and sleeping, perhaps forever.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:elyvilon wrath"
msgid "Elyvilon is not a god known for wrath. Still, those earning Elyvilon's ire will\nfind the Healer occasionally protecting their foes from their attacks, and even\nfrom death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:fedhas wrath"
msgid "Those who offend Fedhas will find the forces of nature invoked against them\nthrough a dramatic increase in greenery. They may find themselves transmuted\ninto the plants they have forsaken, or surrounded by impenetrable walls of\nbriars plus vicious acid-spitting oklob plants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:hepliaklqana wrath"
msgid "Hepliaklqana believes that the only reasonable punishment for turning one's\nback on the path of memory is to be denied its use. All new experience is\ndenied to the unfortunate apostate, until Hepliaklqana decides they have\nbeen punished enough. The life essence sacrificed to manifest an ancestor will\nnot be returned until Hepliaklqana is mollified, and this will not be quick:\nunlike some, Hepliaklqana has a long memory.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:gozag wrath"
msgid "The first of Gozag's punishments is commercial: all shops opened through\nGozag's intervention shut their doors forever. The disloyal are advised to\nfinish their shopping before they launch their betrayal. For as long as Gozag\nremains angered, ex-worshippers may sometimes be bedazzled by the glint of coin,\nand their potions will have a chance to fail when quaffed. Any foes that are\nencountered may also be granted potions of their own to assist them against\nthose who resign from Gozag's service.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ignis wrath"
msgid "The wrath of Ignis is now weaker than that of most other gods. Apostates will\nfind their resistance to fire stripped away completely, and will be periodically\nassaulted by fire elementals, find their enemies strengthened by fire, or even\nhave the floor burned out from beneath them. Experienced and cautious\nadventurers will likely overmaster these assaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:jiyva wrath"
msgid "Jiyva's vengeance is swift and gurgling. All slimes turn against those who\noffend Jiyva, and Jiyva ensures a plentiful supply of further slimes. Victims,\ntoo, will find their own bodies becoming unstable; acquiring debilitating\nmutations or contamination, as well as having any gifts of slime mutations\nstripped away from them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:kikubaaqudgha wrath"
msgid "Kikubaaqudgha's wrath brings forth all the dread powers of necromancy. Victims\nmay witness the devastating Sign of Ruin form upon themselves, or both doomed\nand drained without any respect for their negative energy resistance.\nFurthermore, Kikubaaqudgha's gifts become tainted: the dead rise again as foes,\nand those that attempt to use necromantic magic to fend off wrath will find it\nbackfiring on them when least expected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:lugonu wrath"
msgid "Lugonu's ire renders the barrier between reality and the Abyss weak and\npermeable. Space warps, hurling victims across the dungeon, or even directly\ninto the Abyss. Lugonu also reaches out and sends the chaotic inhabitants of\nthe Abyss against victims, with veteran adventurers facing the greatest horrors\nof the Abyss. Lugonu does not forgive easily, and will not allow ex-worshippers\nto rejoin the fold while Lugonu's wrath still lasts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:makhleb wrath"
msgid "Those who invite the fury of Makhleb are buried in demons and destruction.\nThe greatest punishments are reserved for the strongest sinners; crystal spears\nand Executioners are hurled with abandon only at those Makhleb finds truly\ndeserving!\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:nemelex xobeh wrath"
msgid "Those who abandon Nemelex Xobeh have all of their gifted decks revoked\nimmediately. They are also regularly forced to draw from the deck of\nPunishment, inflicting a range of unpleasant effects including draining,\ntorment and polymorphing, as well as calling upon other gods to assist in\ninflicting wrath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:okawaru wrath"
msgid "Okawaru's most vicious warriors are sent against rebellious servants. Novices\nfind themselves swarmed by packs of ogres and gnolls, while champions are\nsurrounded by titans and elvish blademasters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:pakellas wrath"
msgid "Those that offend Pakellas will find themselves completely unable to make use\nof their devices for the duration of Pakellas' displeasure. Those who abandon\nPakellas altogether will also continue to be unable to regenerate their magical\npower so long as Pakellas' attention remains on them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:qazlal wrath"
msgid "Qazlal's wrath is swift and unmistakable. Sinners are stripped of their\nresistances and assaulted by furious elemental creatures, and Qazlal will\ncreate mighty thunderclaps to alert their foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:ru wrath"
msgid "Those who leave Ru's service will not receive any further punishment; however,\ntheir piety will be lost even upon rejoining, and their sacrifices remain\nforever.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:sif muna wrath"
msgid "Those in Sif Muna's ill graces find the very forces of magic rebelling against\nthem. They are confused and stupefied, their magical reserves drained, their\nenchantments unravelled. Casting spells, too, becomes unreliable – and even\ndangerous.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:the shining one wrath"
msgid "The Shining One's wrath is straightforward and unmistakable. Its victims find\nthemselves smitten with holy fire and beset with holy warriors. Sinners will be\nsilenced, and the Shining One will also shout to alert the victim's foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:trog wrath"
msgid "Trog's wrath is incandescent. Offenders find themselves swarmed by berserkers –\nfrom packs of bears to, for the most powerful, mobs of giants and trolls.\nOtherwise, those who anger Trog will regularly lose both their strength and\nself-control as they thoughtlessly thrash in place.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:uskayaw wrath"
msgid "Uskayaw's wrath turns the powers of the dance against the offender. The prude\nwill find their foes going berserk and will be forced to helplessly watch as\nfoes execute their own solos. When the dance is getting too slow, Uskayaw will\ncause noise to attract more revellers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:vehumet wrath"
msgid "Those that anger Vehumet find destruction amply heaped upon them. Novices are\nstruck by flame and frost; archmages by crystal spears and firestorms. Their\nown conjurations, too, are wont to misfire at the worst possible moments.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:wu jian wrath"
msgid "Those who turn against the Council must be prepared to endure death by a\nthousand cuts. No hiding place is secure, no disguise perfect enough to avoid\nthe sudden spring of traps, the flying daggers and the armies of animated\nweapons that will ambush the betrayer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:xom wrath"
msgid "Unfaithful ex-followers will find themselves suffering through Xom's bad moods\nfor so long as Xom can be bothered to remember about them. Still, Xom's caprice\nremains; the unfaithful are rewarded just as the faithful are punished.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:yredelemnul wrath"
msgid "Those who anger Yredelemnul find themselves beset by legions of the dead.\nSometimes, the god will also intervene directly, binding the unfaithful in\ninescapable chains as Yredelemnul's dark army demonstrates the price of\nbetrayal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:zin wrath"
msgid "Those under Zin's wrath will find their beneficial mutations stripped away,\ntheir enemies alerted, and their senses confounded by the axioms of Law;\nconfusion, fainting, blindness and complete paralysis will be their lot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/gods.txt
msgctxt "textdb:descript/gods.txt:wu jian extra"
msgid ":nowrap\n  .......       .......  (.) <lightred>Lunge</lightred>: Move directly towards an enemy to deal\n  ..<lightred>@</lightred>.O..  -->  ...<lightred>@</lightred>O..  extra damage.\n  .......       .......\n\n  .......       ...<lightred>@</lightred>...  (*) <lightred>Whirlwind</lightred>: Move between two tiles adjacent to\n  ...<lightred>@</lightred>O..  -->  ....O..  an enemy to strike them lightly. Multiple adjacent\n  .......       .......  foes can be attacked simultaneously this way.\n\n  ..#....       ..#....  (**) <lightred>Wall Jump</lightred>: Vault off a nearby wall and strike\n  ..#<lightred>@</lightred>O..  -->  ..#.O<lightred>@</lightred>.  enemies adjacent to the landing spot. Vaulting takes\n  ..#....       ..#....  two turns. Activated via the (a)bility menu.\n\nThese prevent enemies from getting free attacks on you while you move away.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:goal"
msgid "What exactly is the goal of this game?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:goal"
msgid "A: To survive and to win, obviously. For this you need to find the fabled Orb\nof Zot deep down in the dungeon and bring it back to the surface. To enter the\nrealm of Zot, you'll first need to collect three runes to be found in various\nbranches of the dungeon.\n\nHowever, if you're new to the game, you really shouldn't worry about this. Just\ntry to delve as deeply as possible and have fun exploring the many side\nbranches in Crawl with various characters of different species, skill sets, and\nreligions.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:userdir"
msgid "I can't find my save files, morgue and character dumps. Where are they?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:userdir"
msgid "If you're playing locally (i.e. not on one of the servers), the chardump\ncommand will tell you where the morgue file is written, and this information is\nalso displayed below the highscore at the end of a game.\n\nThe saves/ directory can be found in the same directory as the morgue/ one.\n\nIf you'd like to change either location, modify the morgue_dir and/or save_dir\noptions in the init file.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:roguelike difference"
msgid "What are the biggest differences to other popular roguelike games?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:roguelike difference"
msgid "A: First, you might want to read the philosophy section in the manual ('?N') to\nread about general important principles in Stone Soup's game design.\n\nAs for specific differences, the most important are probably the following:\n\n* Species is *much* more important than the character background (or \"class\").\n\n* Bones files only contain ghosts, never their equipment or cause of death.\n\n* You cannot sell items to shops or elsewhere.\n\n* Resistances can be gained via mutations or items, never through eating.\n\n* There are inevitable deaths, but new players can win without spoilers, if\n  they learn from their mistakes. Very good players can win several consecutive\n  games.\n\nAlso, our aim is to give Crawl a really smooth interface, so you should really\nread through the command list ('??') some time. The following commands are\nparticularly convenient:\n\n* 'o', for automatic exploration of an unknown level\n\n* 'G', for automatic travel to another level ('G?' for help)\n\n* 'X', to access the level map for travelling and other tasks ('X?')\n\n* 'Ctrl-F', to find and travel to items you've seen before ('Ctrl-F?')\n\n* 'Tab', to move towards or attack the nearest monster\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:survival"
msgid "How can I avoid dying all the time? Can you give me some playing tips?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:survival"
msgid "A: If you've got trouble even reaching the Temple, you might want to try a game\nor two in hints mode for some general playing hints.\n\nAlso, there are easy playing combinations and more challenging ones (marked in\ndark grey on the selection screen). If you are new to Crawl, sticking to the\neasier ones is advisable. In general, treat each new monster you meet with\nutmost caution, try to choose the location where you fight monsters, and keep\nan eye on your health and magic.\n\nFor specific hints dealing with a particular character, you can press '#'\nin-game to create a \"character dump\" in your morgue directory that details your\nequipment, items, skilling, and available spells. You can share this with other\nplayers to get feedback and advice through any of the community discussion\nresources listed at http://crawl.develz.org/.\n\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:downstairs"
msgid "I can't find any downstairs. Am I missing something?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:downstairs"
msgid "A: They may be in a part of the level that is not reachable from the upstairs\nyou came from. Try going up to the previous level and coming back down from\nthere via a different set of stairs. Note that most levels feature three\ndownstairs as well as three upstairs, not counting any escape hatches.\n\nAlternatively, if you are in one of the branches, you might also have reached\nits lowest level and have to turn around to explore another one. Check the\ndungeon overview ('Ctrl-O') to see how deep you've delved into a given branch,\nor the database ('?/b') for the number of levels for unseen branches.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:cheating"
msgid "Is there a cheating mode to Crawl where I can play without dying?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:cheating"
msgid "A: Press '+'!\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:weapons"
msgid "I've got two cool weapons. How can I tell which one is better?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:weapons"
msgid "A: \"Better\" depends on a number of factors, such as your weapon skills, whether\nit's one- or two-handed, the randart properties, the weapon brand, and the\nmonsters you're about to face. In general, switching from a weapon type at\nwhich you are already highly skilled to another one that you have no skill in\nis a waste of time. The brands may greatly differ in damage output, but you can\nget a good idea by bashing a few comparatively harmless monsters with each and\ncomparing the results.\n\nThe delay in swinging a weapon can be reduced by the corresponding weapon skill.\nYou can view your delay and damage rating with a weapon by reading its\ndescription or pressing '@' while the weapon is equipped. '@' works while\nunarmed too.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:religion"
msgid "Which gods would you recommend to a beginning player?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:religion"
msgid "A: The most straightforward gods to play are probably Trog or Okawaru (for melee\ncombat), Hepliaklqana or Okawaru (for ranged combat), Vehumet or Sif Muna (for\nspellcasting). Also, while unreliable, Xom can be a lot of fun.\n\nWhenever you encounter an altar, be sure to read the corresponding god's\ndescription (by praying on the altar with '>') and take your time in deciding\nwhether to pick this deity or not. As a follower, you can reread your god's\ndescription, now more detailed via the '!' toggle, on the '^' screen.\n\nYou're guaranteed to find altars to almost every god on the first ten levels of\nthe main dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:ghosts"
msgid "I keep getting murdered by my own ghosts. Can I deactivate them?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:ghosts"
msgid "A: There isn't any such option, and we're not planning to add one, either.\n\nKeep in mind that you don't absolutely have to fight every monster you\nmeet, and with ghosts it's even easier: they are generated in sealed\nvaults, and it is your choice whether to open each ghost vault.\n\nAlternatively, you could play a couple characters of strong species/background\ncombinations for the sole purpose of busting those ghosts, e.g. Troll\nBerserkers. Or play online, where you'll mostly be killed by others' ghosts\ninstead!\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:abyss"
msgid "I've somehow ended up in a place called \"Abyss\". How do I get out of here?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:abyss"
msgid "A: If you are in the Abyss for the first time, chances of getting out are\nslim. Still, here are a few general hints:\n\n* You need to find a gateway leading out of the Abyss. These are rare!\n\n* Don't stick around to fight; move as much as possible!\n\n* If you have it, use defensive equipment (weapons of protection, etc.).\n\n* Use teleportation to end up in a completely new part of the Abyss. (But keep\n  in mind that teleportation will take much longer to kick in than in the\n  Dungeon...)\n\n* Consider switching your allegiance to Lugonu, the god of the Abyss. Upon\n  conversion, you will be able to escape the Abyss immediately (but you may\n  anger your previous god!).\n\n* Descending deeper in the Abyss will increase the chance of finding an exit\n  out, but also increase the danger you face.\n\n* Killing enemies can create a gateway out, but most enemies will be\n  too dangerous to fight; pick your battles carefully!\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:randart"
msgid "What do the terms \"randart\" and \"unrandart\" signify?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:randart"
msgid "A: Apart from the standard items you'll find lying around in the dungeon, you\nmight also stumble upon artefacts which come in two varieties:\n\n* randart: a random artefact, usually a weapon, armour or jewellery, with\n  random properties such as conferring resistances or abilities.\n\n* unrandart: a rarer variety of artefact that is predefined instead of randomly\n  generated. Most unrandarts are identified on sight, and some come with\n  special effects or unique abilities that are not available elsewhere.\n\nNeither of these types can be enchanted or branded, either temporarily or\npermanently.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:interact"
msgid "Is there a way for me to interact with other players?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:interact"
msgid "A: If you play online you can watch games in progress, other players can watch\nyou while you play, and you can kill other players' ghosts. You can even send\nand receive messages.\n\nSee http://crawl.develz.org/ to find an online server. The website also lists\ncommunity discussion resources for Discord, Reddit, and IRC.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:version"
msgid "When will development reach the \"stable\" version 1.0?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:version"
msgid "A: Actually, by now we consider Stone Soup to be reasonably stable for a game\nof such active development, so please don't get hung up about the 0.X\nversioning and give it a try.\n\nWe've mostly kept the versioning for historic reasons and because it might\ncause undue confusion. We might decide to change that at some point, but maybe\nwe won't.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:beta"
msgid "Is there a way for me to play the new version before it is released?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:beta"
msgid "A: There certainly is! You can play \"trunk\" (what will eventually become the\nnext version) online on any of the online servers; https://crawl.develz.org\nalso hosts Windows and Mac binaries you can download. Note that trunk may be\nbuggy, and that very rarely a bug may invalidate your saved games. If that\ndoesn't bother you, go ahead and play!\n\nPlease report bugs on github (https://github.com/crawl/crawl/issues).\n\nWhen doing so, please mention the version (see '?v') you're currently playing,\nin case the bug's already been fixed or the feature already implemented.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:bug"
msgid "The game keeps crashing. / I think I found a bug. What do I do?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:bug"
msgid "A: Please submit a bug report on github (https://github.com/crawl/crawl/issues),\nand give as much information as you can:\n\n* What were you doing at the time?\n\n* What did you expect to happen, what happened instead, etc.\n\n* Most importantly, what version are you playing?\n  (If you're not sure, you can check in-game with '?v'.)\n\n* Console or tiles?\n\nFor crashes or monsters/items/levels behaving oddly, we probably need a save\nfile. If you're playing online console, you can create a copy of your save file\nfor the developers to access by selecting the version you are playing and then\npressing 'A' for Advanced options. Don't forget to include the server and your\nusername in your bug report!\n\nSometimes a screenshot can be helpful. If there are error messages, please\nwrite them down. Short of a save file, a guide on how to reproduce the crash\n(or bug) can be useful; you can use wizard mode for this.\n\nThanks in advance!\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:idea"
msgid "I've got a cool idea! What can I do with it?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:idea"
msgid "A: If you'd like your idea to get in, your surest bet is to put it in a place\nwhere a developer can see it. One good place is the official forum, at\nhttps://tavern.dcss.io/. If it catches the interest of at least one coder,\nchances are it'll make it into the game.\n\nNote that your idea has a better chance of being accepted if you present the\nramifications on gameplay. (\"How does [adding/removing X] make the game\nbetter?\") A suggestion for how to improve the interface may go in without much\nado, but other suggestions will probably require to defend & justify them.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:help"
msgid "I'd like to help improve the game. What can I do?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:help"
msgid "A: There are several areas where you can get creative and outside help is much\nappreciated. These are:\n\n* maps/vaults (see dat/ directory, docs/develop/levels/introduction.txt)\n\n* monster speech (see dat/database/, docs/develop/monster_speech.txt)\n\n* monster/item/spell descriptions (see dat/descript/)\n\n* tiles (see source/rltiles/, docs/develop/tiles_creation.txt)\n\nAlso, if you'd like to write a patch but don't know how to go about it, read\npatch_guide.txt in the docs/develop/ directory. Submit it and other new things\nat our github repository: https://github.com/crawl/crawl/issues\n\nKeep in mind that without previous discussions, we may not be able to use the\npatch, or it might need heavy modification. It's possible that it won't be\naccepted, usually for one of three reasons:\n\n* It doesn't fit into the Crawl world as we see it.\n\n* It violates Crawl's philosophy to avoid grinding and spoiler-heavy stuff.\n\n* We just don't think it's interesting enough to ever be implemented.\n\nThanks a lot for your support!\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:changes"
msgid "What did you change in the most recent version?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:changes"
msgid "A: The admittedly highly subjective highlights of the most recent major release\nare listed along with the version information under '?v'. For older releases'\nchanges, check out changelog.txt in the docs/ directory.\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:q:tiles lag"
msgid "The Tiles version is awfully slow! How can I improve that?\n"
msgstr ""

#: crawl-ref/source/dat/database/FAQ.txt
msgctxt "textdb:database/FAQ.txt:a:tiles lag"
msgid "A: Crawl renders its graphics using OpenGL and SDL. Because it uses OpenGL, it\ndepends on a little bit of hardware acceleration to not run slowly. If your\nsystem is not set up to enable this, then Crawl will run quite poorly.\n\nOn Windows, the default driver that ships with Windows is extremely slow. Make\nsure to update your graphics card driver to the latest one available. On Linux,\nyou should be sure to enable DRI.\n\nIn addition to these suggestions, you can also try to see whether tweaking some\noptions will improve performance. See docs/tiles_help.txt for details. If\nthings are still too laggy after all of that, you could try the non-graphical\nconsole version, or wait for a future version that does not depend on OpenGL.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial intro"
msgid "You can reread all messages at any time with\n<input>$cmd[CMD_REPLAY_MESSAGES]</input>. Also, press <input>Space</input>\n<localtiles> or <input>left click</input> with mouse</localtiles> to clear the\n<cyan>--more--</cyan> prompts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial death"
msgid "You die...\n\nIn Crawl, death is a sad but common occurrence. Note that there's usually\nsomething you could have done to survive, for example by using some kind of\nitem, running away, resting between fights, or by avoiding combat entirely.\nKeep trying, eventually you'll prevail!\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 start"
msgid "In this lesson you're going to learn how to move around and explore a level.\nYou can move <localtiles>by clicking somewhere with your <input>Mouse</input>,\nor </localtiles>with the <input>arrow keys</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 go_on"
msgid "You're doing great! Now, explore a bit until you reach the next blue square.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 diagonal"
msgid ":nowrap\nMove diagonally with the <input>number pad</input> (try Numlock on/off)<localtiles>,</localtiles> <console>or the </console><input>vi keys</input><console>.</console><localtiles>, or <input>mouse</input>.</localtiles>\n\n  Numpad:     <w>7 8 9</w>       vi-keys: <w>   $cmd[CMD_MOVE_UP_LEFT] $cmd[CMD_MOVE_UP] $cmd[CMD_MOVE_UP_RIGHT]</w><localtiles>    Mouse:     <w>click</w> on the floor</localtiles>\n               \\|/                     \\|/\n              <w>4</w>-<w>.</w>-<w>6</w> <w>                  $cmd[CMD_MOVE_LEFT]</w>-<w>.</w>-<w>$cmd[CMD_MOVE_RIGHT]</w>\n               /|\\                     /|\\\n              <w>1 2 3</w> <w>                  $cmd[CMD_MOVE_DOWN_LEFT] $cmd[CMD_MOVE_DOWN] $cmd[CMD_MOVE_DOWN_RIGHT]</w>\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 shiftmove"
msgid "A quicker way to “run” through a corridor is to press <input>Shift</input>\nalong with the <input>number pad</input> (try Numlock on/off) or <input>vi\nkeys</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 downstairs"
msgid "When standing on a staircase leading downwards, you can enter the next level\nwith <input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> or with\na <input>left click</input> on your character</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 levelmap"
msgid "What's this? To find out where you are, <tiles>have a look at the\n<w>minimap</w> to the right of the screen.</tiles><localtiles> You can have a\ncloser look at a part of the map with a <input>right mouse click</input> and\nalso can travel there with a <input>left click</input>.</localtiles><webtiles>\nYou can </webtiles><nomouse>enter the overmap view with\n<input>$cmd[CMD_DISPLAY_MAP]</input> and then move the cursor around to look\naround the level. You also can travel wherever your cursor is pointing by\npressing <input>.</input> or <input>Enter</input>. Press <input>Escape</input>\nto return to the normal game mode.</nomouse>\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 autoexplore"
msgid "Exploring manually can get tedious after a while, so you might want to let that\nhappen automatically. Try it by pressing <input>$cmd[CMD_EXPLORE]</input>\n<localtiles>, or by clicking on 'autoexplore', the first button in the command\nbar below the minimap.</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 exclusion"
msgid "Some dangerous ground is marked with <w>exclusions</w>. Autotravel\n<localtiles>(including <input>mouseclick</input>!) </localtiles>will not lead\nyou into exclusions. Instead you will automatically stop.\n\nHowever, autoexplore will move you safely around exclusions: so, you can safely\ncontinue by pressing <input>$cmd[CMD_EXPLORE]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 autoexplore_announce"
msgid "Autoexplore will stop when you first see items or dungeon features, like these\nstairs. To travel directly to the stairs, you can\n<localtiles><input>click</input> on them; or you can </localtiles>press\n<input>$cmd[CMD_DISPLAY_MAP]</input> to enter the map overview, then\n<input><<</input> to move the cursor to the nearest up-stairs, and\n<input>Enter</input> to go there.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 tutorial_end"
msgid "Congratulations! You've completed the first lesson!\n\nTo exit the tutorial, simply go up these stairs with\n<input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> or by\n<input>left clicking</input> on your character</localtiles>. Confirm the\nresulting prompt with an uppercase <input>Y</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 newlevel"
msgid "A new level! To begin with, head over to that door to the right.\n\nAlso, remember: You can reread old messages with\n<input>$cmd[CMD_REPLAY_MESSAGES]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 door"
msgid "You can open a closed door by walking into it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 close_door"
msgid "To close an open door, press <input>$cmd[CMD_CLOSE_DOOR]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 water"
msgid "Note how you can move through shallow but not through deep water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 upstairs"
msgid "When standing on a staircase leading upwards, you can enter the previous level\nwith <input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> or by\n<input>left clicking</input> on your character</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial1 exit"
msgid ":nowrap\n<white>Tutorial 1 summary: Movement</white>\n\n<yellow>Movement commands</yellow>\n   Numpad:       <w>7 8 9</w>           vi-keys:    <w>$cmd[CMD_MOVE_UP_LEFT] $cmd[CMD_MOVE_UP] $cmd[CMD_MOVE_UP_RIGHT]</w>\n                  \\|/                         \\|/\n                 <w>4</w>-<w>.</w>-<w>6</w>                       <w>$cmd[CMD_MOVE_LEFT]</w>-<w>.</w>-<w>$cmd[CMD_MOVE_RIGHT]</w>\n                  /|\\                         /|\\\n                 <w>1 2 3</w>                       <w>$cmd[CMD_MOVE_DOWN_LEFT] $cmd[CMD_MOVE_DOWN] $cmd[CMD_MOVE_DOWN_RIGHT]</w>\n\n  <input>Shift + direction</input> moves you several squares in this direction.<localtiles>\n  You also can move by <input>clicking</input> somewhere in sight or on the <w>minimap</w>.</localtiles>\n\n<yellow>Staircases</yellow>\n  <input>$cmd[CMD_GO_UPSTAIRS]</input>  go back to the previous level\n  <input>$cmd[CMD_GO_DOWNSTAIRS]</input>  enter the next level\n  <input>$cmd[CMD_DISPLAY_MAP]></input>/<input>$cmd[CMD_DISPLAY_MAP]<<</input> travel to the nearest up/downstairs\n\n<yellow>Doors</yellow> can be opened by walking into them\n  <input>$cmd[CMD_CLOSE_DOOR]</input>  close an open door\n\n<yellow>Travel</yellow><localtiles>\n  mouseclick on the <w>minimap</w></localtiles><nomouse>\n  <input>$cmd[CMD_DISPLAY_MAP]</input>  enter the level map, travel with <input>Enter</input></nomouse>\n  <input>$cmd[CMD_EXPLORE]</input>  autoexplore\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 start"
msgid "This lesson will teach you about monsters and fighting. First, we need a\nweapon! Go and grab the one lying over there.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 pickup_weapon"
msgid "Pick up this weapon<localtiles> by clicking on it in the inventory panel, and\nthen wield it by clicking on it again. Alternatively, pick it up</localtiles>\nwith <input>$cmd[CMD_PICKUP]</input> or <input>g</input> and then wield it with\n<input>$cmd[CMD_EQUIP]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 melee"
msgid "To attack a monster with your bare hands or wielded weapon, simply walk into\nit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 resting"
msgid "Very good! You can heal by resting with <input>$cmd[CMD_REST]</input>\n<localtiles>, or by clicking the 'rest' button in the command bar below the\nminimap</localtiles>. This will make you rest until your health is full, but\nwill be interrupted by important events.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 wait"
msgid "Rather than storm the room and get swarmed by monsters, you can also step back\nand wait (with <input>$cmd[CMD_WAIT]</input><localtiles> or by\n<input>clicking</input> on your character</localtiles>) for them to come to you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 resting_reminder"
msgid "Remember, you can rest up with <input>$cmd[CMD_REST]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 compare_monster_desc"
msgid "Examine these monsters (<localtiles>via <input>mouseover</input></localtiles>\n<nomouse>by pressing <input>$cmd[CMD_LOOK_AROUND]</input> to enter examine mode,\nand then <input>$cmd[CMD_TARGET_CYCLE_FORWARD]</input> to cycle through nearby\nmonsters</nomouse>)\nand compare their descriptions (<localtiles>with <input>rightmouseclick</input></localtiles>\n<nomouse>by pressing <input>$cmd[CMD_TARGET_DESCRIBE]</input> while selecting\nthem in examine mode</nomouse>)\nto find out which of these cages is safer to fight through.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 downstairs"
msgid "Well done! After resting to full health continue to the next level with\n<input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> or by <input>clicking</input>\non your character</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 newlevel"
msgid "Remember: You can reread old messages with\n<input>$cmd[CMD_REPLAY_MESSAGES]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 boomerangs"
msgid "Now, for ranged combat! Pick up these boomerangs with\n<input>$cmd[CMD_PICKUP]</input> or <input>g</input><localtiles>, or by\n<input>mouseclick</input>,</localtiles> and continue.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 throwing"
msgid "You can fire your boomerangs at a monster with <input>$cmd[CMD_FIRE]</input>\n<localtiles> or by <input>clicking</input> on them in the inventory\npanel</localtiles>. To confirm the auto-targeted monster, press\n<input>$cmd[CMD_TARGET_SELECT]</input> or <input>Enter</input>. You can skip\nthis and fire at the closest monster with <input>shift-tab</input> or <input>p</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 wield_bow"
msgid "Pick up this shortbow and wield it with <input>$cmd[CMD_EQUIP]</input>\n<localtiles> or by <input>mouseclick</input></localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 firing"
msgid "Firing arrows from your wielded shortbow works a bit differently from throwing boomerangs.\nUse <input>$cmd[CMD_PRIMARY_ATTACK]</input><localtiles> or <input>mouseclick</input>\n</localtiles>. You can change the targeted monster by pressing\n<input>$cmd[CMD_TARGET_CYCLE_FORWARD]</input> while in target mode. The worm is\nharmless behind the lava, so concentrate on the dummy which can fire at you.\nAgain, confirm your choice with <input>$cmd[CMD_TARGET_SELECT]</input> or\n<input>Enter</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 travel_reminder"
msgid "Remember that you can autoexplore using <input>$cmd[CMD_EXPLORE]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 explore"
msgid "Find the exit! Remember that you can autoexplore using\n<input>$cmd[CMD_EXPLORE]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 tutorial_end"
msgid "Congratulations! You've survived your first batch of monsters! To exit the\ntutorial, simply go down these stairs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial2 exit"
msgid ":nowrap\n<white>Tutorial 2 summary: Combat</white>\n\n<yellow>Weapons<console> <cyan>)</cyan></console></yellow>\n  <input>$cmd[CMD_PICKUP]</input>  pick up an item\n  <input>$cmd[CMD_EQUIP]</input>  equip an item<localtiles>\n  You can also do this by <input>clicking</input> on the weapon in your inventory.</localtiles>\n  <input>$cmd[CMD_QUIVER_ITEM]</input>  adjust your quiver\n\n<yellow>Monsters</yellow><localtiles>\n  <input>mouseover</input>  examine a monster\n  <input>rightclick</input> read a more detailed description</localtiles><nomouse>\n  <input>$cmd[CMD_LOOK_AROUND]</input>  examine a monster\n  <input>$cmd[CMD_LOOK_AROUND]$cmd[CMD_TARGET_DESCRIBE]</input> read a more detailed description</nomouse>\n  <input>$cmd[CMD_PRIMARY_ATTACK]</input> fire held weapon\n  <input>$cmd[CMD_FIRE]$cmd[CMD_TARGET_SELECT]</input> fire quiver at pre-targeted monster\n  <input>shift-tab</input>, <input>p</input> fire quiver at closest monster\n  <input>$cmd[CMD_FIRE]$cmd[CMD_TARGET_CYCLE_FORWARD]</input> target another monster<localtiles>\n  You can also fire a missile by <input>clicking</input> on it, then confirming the target with <input>Enter</input>.</localtiles>\n\n<yellow>Resting</yellow>\n  <input>$cmd[CMD_WAIT]</input>  wait and rest a single turn\n  <input>$cmd[CMD_REST]</input>  wait and rest up to 100 turns\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 start"
msgid "In this lesson you're going to learn about items and how to use them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 armour"
msgid "Pick up these boots with <input>$cmd[CMD_PICKUP]</input> and wear them with\n<input>$cmd[CMD_EQUIP]</input>.<localtiles> Or simply <input>mouseclick</input>\non them in the inventory panel.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 autopickup"
msgid "Some types of items<tiles>, marked with a green frame,</tiles> are picked up\nautomatically as you step on them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 scroll"
msgid "Many items are unidentified when you find them. One way to find out what they\ndo is to use them. Try reading this scroll with <input>$cmd[CMD_READ]</input>\n<localtiles> or with <input>mouseclick</input> in the inventory\npanel</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 scroll_noautopickup"
msgid "Autopickup does not work if there's a monster around. You can either pick up\nthis scroll now with <input>$cmd[CMD_PICKUP]</input><localtiles> or\n<input>clicking</input> on your character,</localtiles> or you can fight the\nnearby enemy and pick it up afterwards.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 ego_weapon"
msgid "An item described as <lightblue>runed</lightblue> or\n<lightblue>glowing</lightblue> will always be enchanted, or have special\nproperties, or both. Once you step on top of such an item, its properties will\nbe revealed to you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 inventory"
msgid "To view the description of your new weapon, find and select it in your\ninventory (<input>$cmd[CMD_DISPLAY_INVENTORY]</input>). <localtiles>You can\nalso <input>mouseover</input> or <input>right click</input> it in the inventory\npanel. </localtiles>Notice that all the item commands also work from the item\ndescription screens.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 battle"
msgid "Once you've successfully managed to poison a monster, it is sometimes best to\nretreat and let the poison do the work. Don't forget to retreat to heal too, if\nnecessary.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 downstairs"
msgid "Well fought! If necessary, rest up with <input>$cmd[CMD_REST]</input>, then\ncontinue downwards with <input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> or\nwith a <input>click</input> on your character</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 command_help"
msgid "If the many commands are too confusing, you can also look them up in the\ncommand help <input>$cmd[CMD_DISPLAY_COMMANDS]</input>. <localtiles>A number of\ncommands are also available in the clickable <w>command panel</w> to the right\nof the screen. </localtiles>Rereading old messages with\n<input>$cmd[CMD_REPLAY_MESSAGES]</input> is available as usual.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 trap"
msgid "Traps can have a variety of unpleasant effects, such as alerting monsters or\nteleporting you into danger. Some traps are permanent and will always be\nrevealed as part of the map, but other traps can be triggered by exploring new\ntiles, and won't exist after being triggered. If there's no way around, you'll\nhave to trigger the trap and deal with the consequences.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 potion"
msgid "Potions may provide vital healing or useful enchantments, but some have less\ndesirable effects. You can quaff this potion with\n<input>$cmd[CMD_QUAFF]</input><localtiles> or with\n<input>mouseclick</input></localtiles> to discover what it does.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 artefact_armour"
msgid "Items with <w>unusual names</w> are artefacts. Artefacts can have a number of\nspecial properties. Some unique artefacts (such as this cloak) are always\nidentified and may have special properties that cannot be found anywhere else!\nOthers are generated with a random selection of properties, and are\nunidentified until you step on top of them. Try equipping this cloak with\n<input>$cmd[CMD_EQUIP]</input><localtiles> or <input>mouseclick</input>\nin the inventory panel</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 wand_fire"
msgid "You can evoke a wand with <input>$cmd[CMD_EVOKE]</input><localtiles> or with\n<input>mouseclick</input> in the inventory panel</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 wand_digging"
msgid "A wand of digging can destroy rock walls. Use\n<input>$cmd[CMD_LOOK_AROUND]][$cmd[CMD_TARGET_DESCRIBE]</input> <localtiles>or\n<input>mouseover</input>/<input>right click</input> </localtiles>to check wall\ntypes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 amulet"
msgid "Jewellery is put on with <input>$cmd[CMD_EQUIP]</input><localtiles>\nor with <input>mouseclick</input> in the inventory panel</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 drop"
msgid "This amulet would be very powerful if your character had a god to worship,\nbut here and now, it's useless. You may want to drop it with\n<input>$cmd[CMD_DROP]</input><localtiles> or by\n<input>Shift-leftclicking</input> it in the inventory panel</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 gold"
msgid "Gold can be spent in shops. It takes no inventory space and cannot be dropped.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 shop"
msgid "Shops offer a variety of items, but they don't buy items from anyone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 enter_shop"
msgid "To enter this shop, press <input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> or\n<input>click</input> on your character</localtiles>. To buy items,\nselect them with their hotkey, hit <input>Enter</input> and confirm with\n<input>y</input>es. You can switch to description mode with <input>!</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 autoexplore_reminder"
msgid "Remember, you can explore the level automatically with\n<input>$cmd[CMD_EXPLORE]</input><localtiles> or by <input>clicking</input> the\nautoexplore command button in the <w>command panel</w></localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 go_shopping"
msgid "You now have enough gold to do some serious shopping! The quickest way back to\nthe shop is by searching for it. Type <input>$cmd[CMD_SEARCH_STASHES]</input>,\nand then enter “<w>shop</w>”. Select the result to start travelling.<localtiles>\nYou can also <input>click</input> on the search button in the command panel, or\nuse the minimap to return to the shop.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 optional_battle"
msgid "Warning, this way leads to <lightred>a difficult battle</lightred>. You may\nchoose to use what you've learned so far in a fight, or try to reach the other\nexit on the island. Either way, it may be a good idea to do some shopping, if\nyou haven't already.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 tutorial_end"
msgid "Well done! To exit the tutorial, simply go down these stairs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial3 exit"
msgid ":nowrap\n<white>Tutorial 3 summary: Items</white>\n\n<yellow>Item commands</yellow>\n  <input>$cmd[CMD_PICKUP]</input>  pick up an item\n  <input>$cmd[CMD_DROP]</input>  drop an item\n  <input>$cmd[CMD_EQUIP]</input>  equip armour, weapons, and jewellery\n  <input>$cmd[CMD_UNEQUIP]</input>  unequip armour, weapons, and jewellery\n  <input>$cmd[CMD_READ]</input>  read a scroll\n  <input>$cmd[CMD_QUAFF]</input>  quaff a potion\n  <input>$cmd[CMD_EVOKE]</input>  evoke a wand\n\n  Use and (un)equip commands are also available from item descriptions in the inventory menu (<input>$cmd[CMD_DISPLAY_INVENTORY]</input>).<localtiles>\n  And of course, <input>mouseclicks</input> also work.</localtiles>\n\n<yellow>Other</yellow>\n  <input>$cmd[CMD_DISPLAY_COMMANDS]?</input> access the command help\n  <input>$cmd[CMD_EXPLORE]</input>  explore automatically\n  <input>$cmd[CMD_SEARCH_STASHES]</input> search for items/features previously seen<localtiles>\n  Several of these commands can also be executed by clicking in the <w>command panel</w>.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 start"
msgid "In this lesson you're going to learn how to memorise and cast spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 spellbook"
msgid "You can memorise a spell from your spell library with\n<input>$cmd[CMD_MEMORISE_SPELL]</input><localtiles> or by\n<input>clicking</input> on the memorisation tab and selecting the spell\ntile</localtiles>. At experience level 1, only level 1 spells are available to\nyou. This will change as you gain experience. To find new spells, find and pick\nup spellbooks, and the spells will be added to your library.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 spellcasting"
msgid "To cast a spell, first memorise it with <input>$cmd[CMD_MEMORISE_SPELL]</input>.\nYou can then cast it with <input>$cmd[CMD_CAST_SPELL]</input><localtiles> or by\n<input>clicking</input> on the spell tile</localtiles>.\n\nPress <input>$cmd[CMD_CAST_SPELL]</input>, then press <input>?</input> to get a\nlist of your spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 spellquivering"
msgid "Spells, like ammo, are shown in the quiver slot, so you can use\n<input>$cmd[CMD_QUIVER_ITEM]</input> to ready a spell in the quiver. Use\n<input>$cmd[CMD_FIRE]</input> or <input>shift-tab</input> to fire the currently\nquivered spell.\n\nOnce you are out of magic points, retreat and rest to regain them with\n<input>$cmd[CMD_REST]</input><localtiles> or by <input>clicking</input> the\nrest icon in the command panel</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 ring_power"
msgid "Put on this ring with <input>$cmd[CMD_EQUIP]</input><localtiles> or\nby <input>clicking</input> it in the inventory panel</localtiles>, and then\nrest up to your new full potential.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 undead"
msgid "Unlike most monsters, zombies and skeletons do not regenerate health.\n<localtiles> You can also attempt to re-cast the last spell you used by\npressing <input>Ctrl+leftclick</input> on the monster.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 spell_success"
msgid "To check your spell proficiency, press <input>$cmd[CMD_DISPLAY_SPELLS]</input>\n<localtiles> or <input>mouseover</input> over your memorised\nspells</localtiles>. Compare your spell failure rates before and after wearing\nthis ring.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 mephitic_cloud"
msgid "Mephitic Cloud is a level 3 spell, so you can't memorise it yet. To level up\nquickly, here are more training dummies — without stones to throw this time.\n\nAt experience level 3, you'll be able to increase one of your stats — choosing\n<input>I</input>ntelligence will help your spellcasting even further.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 meph_reminder"
msgid "Don't forget to memorise your newly-available spell, by pressing\n<input>$cmd[CMD_MEMORISE_SPELL]</input><localtiles> or by\n<input>clicking</input> on the memorisation tab and selecting the spell\ntile</localtiles>!\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 aiming_clouds"
msgid "Mephitic Cloud covers an area in noxious fumes when cast, and you'll be able to\nsee the area it affects as you target it. Try to catch multiple enemies in a\nsingle cloud in order to be more efficient with your magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 forget_spell"
msgid "Gaining experience levels and raising your Spellcasting skill gives you spell\nslots to spend on spells. You can also <w>forget a memorised spell</w> to make\nspace for a new one by reading a scroll of amnesia. Read the scroll (with\n<input>$cmd[CMD_READ]</input><localtiles> or by\n<input>clicking</input> on it</localtiles>), and then select the spell you want\nto forget. You can relearn forgotten spells from your spell library later, as\nlong as you have spell slots available.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 memorise2"
msgid "After forgetting one of your old spells to make space, memorise this new spell\nwith <input>$cmd[CMD_MEMORISE_SPELL]</input><localtiles> or by\n<input>clicking</input> on the memorisation tab and selecting the spell\ntile</localtiles>. Then try your new spell and summon some demonic allies!\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 displace_allies"
msgid "Did you notice you can swap positions with your allies by moving into them?\nAmong other things, displacing a friendly creature can be a good way to escape\na fight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 order_allies"
msgid "Try to let your allies do the killing! If necessary, you can order them about\nwith <input>$cmd[CMD_SHOUT]</input>. Before opening this gate, you may want to\nwait with <input>$cmd[CMD_WAIT]</input> until your allies have caught\nup with you. Your summons will only stick around for a short time, so don't\nwait too long, or summon some new ones before starting a fight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 heavy_armour"
msgid "Heavy armour really hampers spellcasting. Try putting on that mail and shield\n(with <input>$cmd[CMD_EQUIP]</input><localtiles> or by\n<input>clicking</input> on them</localtiles>), and compare your spellcasting\nfailure rates with <input>$cmd[CMD_DISPLAY_SPELLS]</input><localtiles> or by\n<input>mouseovering</input> your memorised spells</localtiles>. You can take\narmour off again with <input>$cmd[CMD_UNEQUIP]</input><localtiles> or,\nagain, via <input>mouseclick</input></localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 resting_reminder"
msgid "Make sure you are at full health and magic points before entering a new area.\nIf necessary, rest up with <input>$cmd[CMD_REST]</input><localtiles> or by\n<input>mouseclick</input> in the command panel</localtiles>.\n\nYou can only summon a limited number of allies at once from any given spell,\nso try to take advantage of a wide range of spells. For example, your summoned\nimps are resistant to poison, so you can cast Mephitic Cloud to fight alongside\nthem without harming your allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 tutorial_end"
msgid "Congratulations, you're a real wizard now! To exit the tutorial, simply go down\nthese stairs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial4 exit"
msgid ":nowrap\n<white>Tutorial 4 summary: Magic</white>\n\n<yellow>Spellcasting commands</yellow>\n  <input>$cmd[CMD_MEMORISE_SPELL]</input>  learn a new spell\n  <input>$cmd[CMD_DISPLAY_SPELLS]</input>  check spell proficiency\n  <input>$cmd[CMD_CAST_SPELL]</input>  cast a spell<localtiles>\n  You can also learn new spells via the <w>memorisation tab</w>.\n  You can cast memorised spells via <input>leftclick</input>, and read their descriptions and check your spell proficiency by <input>mouseover</input> or <input>rightclick</input></localtiles>\n  <input>$cmd[CMD_QUIVER_ITEM]</input>  adjust your quiver\n\n  <input>$cmd[CMD_REST]</input>  rest up to 100 turns to regain magic points and health\n  <input>$cmd[CMD_SHOUT]</input>  order allies\n  <input>$cmd[CMD_UNEQUIP]</input>  take off equipment\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 start"
msgid "In this lesson you're going to learn about gods and how to use their powers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 dungeon_overview"
msgid "Up ahead is an altar to Trog the Wrathful! Trog is just one of many gods. In a\nreal game, you can check <input>$cmd[CMD_DISPLAY_OVERMAP]</input><localtiles>\nor <input>click the dungeon overmap button</input> in the command\npanel</localtiles> for a list of all altars and other interesting features\nfound so far.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 altar"
msgid "You can pray on an altar with <input>$cmd[CMD_GO_DOWNSTAIRS]</input>\n<localtiles> (or by <input>left clicking</input> on your character)</localtiles>\nto get an idea what a god offers you, and to join the faith. If\nyou press <input>!</input><localtiles> or\n<input>rightclick</input></localtiles> on the religion screen, you can see a\nmore detailed description.\n\nConfirm your choice with <input>J</input> or <input>Enter</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 religion"
msgid "Have a look at your current religious standing with\n<input>$cmd[CMD_DISPLAY_RELIGION]</input><localtiles> (or via the <w>religion\nbutton</w> in the command panel, or by <input>Shift-rightclicking</input> on\nthe player tile)</localtiles>. Again, pressing <input>!</input><localtiles> or\n<input>rightclicking</input></localtiles> will bring up a more detailed\ndescription of your god.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 piety_on_kill"
msgid "Some gods really like it if you kill monsters in their name. Let the slaughter\nbegin!\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 berserk"
msgid "Against particularly tough foes, you may want to use Trog's Berserk power with\n<input>$cmd[CMD_USE_ABILITY]</input><localtiles> or via the <w>command\npanel</w></localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 exhaustion"
msgid "A berserker rage is truly exhausting. After it ends, you cannot berserk again\nfor a short while and are slowed. It's best to rest with\n<input>$cmd[CMD_REST]</input><localtiles> (or via the\n<w>command panel</w>)</localtiles> until you feel fit again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 berserk2"
msgid "Berserk is also really useful against multiple enemies — as long as you don't\nrun out of steam in-between.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 tutorial_end"
msgid "Congratulations! You've finished the last tutorial lesson and are now ready for\nthe real game. Good luck!\n\nTo exit the tutorial, just go down these stairs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/tutorial.txt
msgctxt "textdb:descript/tutorial.txt:tutorial5 exit"
msgid ":nowrap\n<white>Tutorial 5 summary: Religion</white>\n\n<yellow>Religious commands</yellow>\n  <input>$cmd[CMD_GO_DOWNSTAIRS]</input>  pray at an altar to join a god\n  <input>$cmd[CMD_USE_ABILITY]</input>  use a divine ability\n  <input>$cmd[CMD_DISPLAY_RELIGION]</input>  check your religious standing<localtiles>\n  A <input>rightclick</input> on the player tile will also bring up the religion screen.</localtiles>\n\n<yellow>Resting</yellow>\n  <input>$cmd[CMD_WAIT]</input>  wait and rest a single turn\n  <input>$cmd[CMD_REST]</input>  wait and rest up to 100 turns\n\n<yellow>Other commands</yellow>\n  <input>$cmd[CMD_DISPLAY_OVERMAP]</input> display an overview of the dungeon\n  <input>$cmd[CMD_DISPLAY_COMMANDS]/</input>  search the description database\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:velocity card"
msgid "The card depicts an empty, well-worn pair of boots. Sand, ashes, and turf\ncoat the boots' soles.\n\nDrawing this card can grant great speed to allies or terrible slowness to foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the tomb card"
msgid "The card depicts a royal crypt, its entrance sealed by a heavy stone slab.\n\nDrawing this card entombs its user in protective, temporary walls of solid rock.\nAt lower power levels or with adjacent creatures, the tomb may be imperfect.\n\nThe tomb is sustained by the presence of its creator within it, and moving from\nthe centre of the tomb will cause its walls to crumble away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:exile card"
msgid "The card depicts ceaseless hands from a yawning portal overcoming a panicked\nfigure.\n\nDrawing this card can banish nearby creatures to the abyss, with more being banished\nat higher power levels. It will never banish the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the shaft card"
msgid "The card depicts a traveller plummeting into a chasm that has opened beneath\nthem.\n\nDrawing this card will create a shaft beneath the user, and possibly beneath\ntheir enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the elixir card"
msgid "The card depicts a smug smile formed out of nine chalices.\n\nDrawing this card rapidly restores the user's health and magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the cloud card"
msgid "The card depicts an iron gate enshrouded in mist.\n\nDrawing this card enshrouds the user's foes in rings of detrimental clouds. The\neffects of such clouds will vary with card power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:vitriol card"
msgid "The card depicts an oklob plant, dripping with its distinctive corrosive sap.\n\nDrawing this card will unleash a corrosive attack spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the storm card"
msgid "The card depicts a ship at sea sinking in a thunderstorm.\n\nDrawing this card unleashes a storm of wind and electrical discharges.\nIncreasing card power will result in a stronger wind force and stronger, more\nnumerous discharges.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:pain card"
msgid "The card depicts an iron wheel, menacing with spikes and rusted with blood.\n\nDrawing this card unleashes a necromantic attack spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the orb card"
msgid "The card depicts a figure surrounded by floating, glowing orbs of energy.\n\nDrawing this card unleashes one or possibly more destructive orbs of pure magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:degeneration card"
msgid "The card depicts a dragon whose scales are sloughing off, revealing a sheep\nunderneath.\n\nDrawing this card will attempt to polymorph and malmutate nearby enemies into\nweaker forms, and will briefly daze those that cannot be polymorphed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:wild magic card"
msgid "The card depicts a pointy wizard's hat, scorched and resting on a pile of ashes.\n\nDrawing this card causes wild magic (as if from miscasting a spell) to act upon\nits user's enemies. Each creature affected will restore some of the user's\nmagic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the elements card"
msgid "The card depicts the figures of great beasts lurking in a sandstorm.\n\nDrawing this card will summon three beasts of the four elements.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the pentagram card"
msgid "The card depicts cultists marking out a ritual pentagram on the floor.\n\nDrawing this card will summon a pair of demons to the user's aid. There is a\nsmall chance one of the demons will be hostile.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the dance card"
msgid "The card depicts an extravagantly-dressed, masked figure dancing alone in a\nvast room.\n\nDrawing this card will summon a dancing weapon. Its quality, brand, and\nfriendliness are all affected by card power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the swarm card"
msgid "The card depicts a bear surrounded by a swarm of bees. It hums ominously.\n\nDrawing this card will summon bees.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the rangers card"
msgid "The card depicts an arrow in a bull's-eye, which has been split by a second\narrow.\n\nDrawing this card will summon several archers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the illusion card"
msgid "The card depicts someone standing in a hall of mirrors, surrounded by their own\nreflections.\n\nDrawing this card will summon an illusion of the user. Its power will depend\nupon one's own.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:wrath card"
msgid "The card depicts the hand of the divine, reaching down from the heavens to hurl\nfurious lightning.\n\nDrawing this card will draw a god's wrath against the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the wraith card"
msgid "The card depicts absolutely nothing.\n\nDrawing this card will drain the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:the swine card"
msgid "The card depicts several feral hogs wallowing in a mud pit.\n\nDrawing this card will make its user turn pink and root for truffles.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:torment card"
msgid "The card depicts a screaming figure being tortured on the rack.\n\nDrawing this card will cause agonising injury to the user.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:a buggy card"
msgid "The card depicts a Crawl player filing a bug report on Mantis.\n\nDrawing this card is a bug, if one ever encounters it as such.\n"
msgstr ""

#: crawl-ref/source/dat/descript/cards.txt
msgctxt "textdb:descript/cards.txt:a very buggy card"
msgid "The card depicts several Crawl players angrily filing several bug reports on\nMantis.\n\nDrawing this card is a bug, if one ever encounters it as such.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:amulet"
msgid "An amulet to be worn as jewellery around the neck, charged with arcane powers\nof unknown provenance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:book"
msgid "An arcane textbook containing magical spells of unknown origin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:potion"
msgid "An unlabelled flask containing a single dose of unknown liquid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:ring"
msgid "A ring charged with arcane forces of unknown provenance, to be worn as jewellery\non a finger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:scroll"
msgid "A disposable arcane formula inscribed on parchment by a professional scribe or\nsorcerer. Anyone can evoke the power of the arcane formula by reading it out\nloud, but the nature of that power is not a priori apparent.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:staff"
msgid "A staff improved with arcane powers of unknown nature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/unident.txt
msgctxt "textdb:descript/unident.txt:wand"
msgid "An unusually magical sort of stick.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:dungeon"
msgid "It is still a mystery how this bizarre place was created. Some claim that it is\nthe playground of bored gods, whereas others maintain that it was shaped by all\nkinds of species who fled the overworld and shunned the light. No matter what\nits origin, this deep cavern is filled with riches unheard of as well as with\nample dangers to any intruder. Few have escaped alive, and even fewer have kept\nsome sliver of sanity sufficient to tell the tale.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:temple"
msgid "The Ecumenical Temple is a place of peace and refuge from the insanity of the\ndungeon. It usually contains altars to most of the known gods. Gods that value\nexploration grant no piety for exploring the Temple.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:orcish mines"
msgid "The Orcish Mines are home to the orcs that have settled in the Dungeon, their\nhumanoid allies, and piles of freshly mined gold. Enterprising merchants who\nsell to all comers have set up trading posts among the orcs and their brethren\nto make good use of that gold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:elven halls"
msgid "The Elven Halls are home to the deep elves, a race that turned their backs on\nthe sun long ago. Their halls are filled with riches, but a deadly welcome\nawaits any would-be robbers. In their long seclusion, the deep elves have\nperfected dark sorceries of a power the orcs can only dream of!\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:lair"
msgid "Most adventurers find the Lair of Beasts to be an exciting change of climate.\nAnd indeed, there is something to be said about getting gored, mauled and eaten\nrather than sliced, burnt or stabbed.\n\nThe Lair contains the entrances to one of the Swamp or the Shoals, one of the\nSnake Pit or the Spider Nest, and to the Pits of Slime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:swamp"
msgid "A swampy wasteland, the Swamp is filled with ooze, muck, flies and large\nslavering carnivorous monsters.\n\nA dungeon features only one of the Swamp and Shoals branches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:shoals"
msgid "The exotic underground beaches of the Shoals make up a few small islands in a\nseemingly endless sea. The merfolk have made it their home, alongside many\ndreaded sea creatures.\n\nA dungeon features only one of the Shoals and Swamp branches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:snake pit"
msgid "The corridors of the Snake Pit are home to all varieties of serpent, and are\ninhabited by a society of powerful nagas and salamanders.\n\nA dungeon features only one of the Snake Pit and Spider Nest branches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:spider nest"
msgid "The crumbling, web-choked caverns of the Spider Nest are packed with poisonous\narthropods and assorted creepy-crawlies.\n\nA dungeon features only one of the Spider Nest and Snake Pit branches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:slime pits"
msgid "The Slime Pits are the amorphous realm of acids, jellies and slimes. Even the\nwalls drip with painful acid. Any trace of intelligent beings has long been\ndissolved. Still, there are rumours of great treasures deep down, hidden safely\naway in secret chambers without any entrance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:vaults"
msgid "The Vaults are said to be home to great treasures and sealed evils alike, its\norigin known only to its guardians: the Ironbound Order. Intruders face an\norganised defence of trained maneuvers, arms and arcana, animated constructs,\ncoerced allies, and tamed beasts, all in common cause.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:crypt"
msgid "The Crypt is a huge repository for the ancient dead. The air is chill and\nfetid, the walls cold and damp. Bones are strewn liberally everywhere, and\nevery noise echoes worryingly, violating the overbearing silence of the grave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:tomb"
msgid "The Tomb of the Ancients is a place of damnation, of horrors animated by the\nvilest necromancy. The list of those who have returned from this place of pure\ndeath is exceedingly short.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:hell"
msgid "The Vestibule of Hell is guarded by Geryon, along with various denizens of\neach of the hells themselves.\n\nPortals to the Vestibule of Hell are found abundantly in the Depths.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:dis"
msgid "The Iron City of Dis is home to many of the most resilient guardians of hell.\nThose who do not belong in the halls of Dis will find the very earth itself\nopposing them.\n\nThe malice of this metal realm corrodes equipment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:gehenna"
msgid "Gehenna is a realm of lava, flames and damnation. Those who linger will have\nfire and brimstone rained down upon them.\n\nThe acrid smoke renders scrolls unreadable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:cocytus"
msgid "Cocytus is a grim and frost-bitten wasteland. Intruders will find the biting\nwinds and icy inhabitants of the wastes impeding their progress.\n\nThe frigid cold congeals potions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:tartarus"
msgid "Tartarus is a decaying netherworld. Over time, the undead, demons and devils of\nthis place drain the life from any who dare to enter.\n\nThe all-pervading rot saps visitors' willpower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:zot"
msgid "The Realm of Zot is a region of the dungeon that is so terrifying, so full of\nmadness, frenzy and lunacy, that it has been locked securely against random\ntrespassers. Only the most demented adventurers would dare gather the required\nkeys, break the seal and penetrate deeper — all in the vain hope for a fabled\nartefact no one has ever laid eyes on before.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:abyss"
msgid "The Abyss is a truly bizarre place, ever-changing and twisted. It is filled\nwith all sorts of monsters, mostly of demonic nature, whose common aim is to\nfeast on intruders. It is also the garbage dump for many sorcerers, who delight\nin sending would-be champions like you to these proving grounds of madness.\nReportedly, there is some structure to the chaos, as Lugonu seems to concoct\nschemes around this place and its denizens.\n\nPortals to the Abyss are found abundantly in the Depths.\n\nThe Abyss consists of seven infinite levels. The abyssal rune of Zot can be\nfound from the third level onwards, and is more common at greater depths.\nPortals back to the dungeon are scattered throughout the Abyss, and are found\nmore commonly at greater depths or while carrying the abyssal rune.\n\nKilling monsters will warp the substance of the Abyss, eventually generating a\ngateway out. Further persistence will wear holes in the Abyss, allowing descent\ninto deeper layers.\n\nThe fabric of the Abyss takes greater notice of the powerful; no matter how\nthey arrive, more experienced adventurers will find themselves drawn deeper\nwithin the maddening expanse of that realm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:pandemonium"
msgid "Pandemonium is an infinite realm of pain and suffering. While there are many\ntreasures to be found within, they are guarded by cruel demons and even\ncrueller demon lords.\n\nPortals to Pandemonium are found abundantly in the Depths.\n\nPandemonium is endless. Each area of Pandemonium has a small chance of\ncontaining a portal back to the dungeon, either directly or via the Abyss.\n\nNo fewer than five runes of Zot can be found in Pandemonium:\n • the fiery rune resides in the blazing realm of Cerebov\n • the glowing rune can be found in the contaminated domain of Mnoleg\n • the magical rune is guarded by the arcane powers of Lom Lobon\n • the dark rune is hidden in the shadowy abode of Gloorx Vloq\n • the demonic rune exists in multiple places, owned by less famous lords\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:ziggurat"
msgid "A ziggurat is a strange tower constructed of incrementally larger combat\narenas, each containing greater wealth and even greater danger than the last.\nBeware, for a ziggurat is not a place for the faint of heart: even the bravest\nand most skilled adventurers have met their ends in one. While a portal to\nsafety will be present on every level, once left, a ziggurat cannot be\nre-entered.\n\nOne ziggurat is guaranteed in the Depths. Tales tell of a magical item found\nat the bottom of each ziggurat, granting access to a new ziggurat in turn. Such\nan item is also said to be found at the bottom of the Tomb of the Ancients. Each\ntime a ziggurat is conquered by exiting it from the final floor, subsequent\nziggurats will become increasingly dangerous and lucrative.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:gauntlet"
msgid "An elaborate complex designed to lure foolhardy adventurers seeking riches and\nglory. Those who enter must choose a path through several combat arenas, each\nof which contains treasure guarded by dangerous and sometimes exotic creatures.\nAt the end awaits a fearsome minotaur, guarding a large hoard of loot taken from\nthe bodies of foolish adventurers.\n\nLong-range teleports are impossible in Gauntlets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:bazaar"
msgid "While some merchants set up shop in the dungeon, others travel in caravans from\nplace to place. The bazaars of these itinerant traders feature a number of\ndifferent shops and often have better stock than the sedentary ones, sometimes\neven at a bargain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:trove"
msgid "Once upon a time, an enterprising thief and wizard created a system of portals\nleading into the secret treasure troves and chambers of the rich. Too scared to\nloot them himself, he instead charged an extortionate fee for entry to anyone\nwho wanted to rifle through them.\n\nThe items inside such troves are likely to be useful, but beware: the wizard is\nlong dead, and even while alive he never offered a money-back guarantee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:necropolis"
msgid "While many locales across the Dungeon are dedicated to the long-interred\nrestless dead, those whose remains are fresh or lost are collected in the\nfloating ceremonial chambers of the Necropolis. Each soul is enshrined and\ntended to by the maintenance staff recreating both their lives and their moments\nof death, helping visitors bid farewell to the departed. With the advent of\nadventurers seeking the Orb of Zot, these realms have been repurposed: such\nghosts are blinded by rage and impossible to control, so both they and their\nstolen possessions are sealed away in these realms of reconciliation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:sewer"
msgid "Every inhabited place needs to dispose of its waste products. The Dungeon too\nhas its stinking sewers and drains, full of filthy water and ignored by most\nbut used as hideaways by the disgusting and the desperate. Old tales speak of\ndangerous creatures stalking through the foul-smelling green water, preying on\neach other without mercy. The tales also allude to valuable items accidentally\nwashed into the drainage tunnels, forgotten and left to grow mouldy in the damp\ncaverns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:ossuary"
msgid "The ossuary is a small tomb containing the remains and grave goods of some\ndistant relatives of the pharaohs, along with the corpses of their retainers\nand household animals. It is undoubtedly riddled with many traps, and its\nundead denizens are unlikely to take kindly to looting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:bailey"
msgid "The bailey is the occupied and well-guarded fortress of a ruthless warlord.\nThe treasures within are protected by both physical barriers and large numbers\nof well-armed humanoid warriors.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:ice cave"
msgid "The {{ if you.branch() == \"Elf\" or you.branch() == \"Swamp\" or\nyou.branch() == \"Snake\" or you.branch() == \"Shoals\" or you.branch() == \"Spider\"\nthen return \"glacial chasm\"; else return \"ice cave\"; end }} is a desolate cavern\nshaped from solid ice and filled with the echoes of bestial howls. The intricate\ncarvings and statues which once lined its walls have been warped and obscured by\ncenturies of slow melting and refreezing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:volcano"
msgid "Built from enormous blocks of obsidian, the volcano's sweltering chambers may\nonce have served as a temple to some strange deity, or perhaps the dwelling of\na mighty fire giant. The air shimmers with oppressive heat, and the dull roar\nof the volcano's heart never ceases.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:wizlab"
msgid "In ages past, the most powerful mages would frequently find or construct small\nrealms sealed off from the rest of the world, where they could isolate\nthemselves in the pursuit of ever-greater magical knowledge and power. The\nmages are long gone, but many of their arcane laboratories still exist, filled\nwith the results of their experiments. Those willing to explore these\nlaboratories may find powerful magical treasures, but be warned: any wizard\ncapable of constructing such a realm deserved their reputation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:depths"
msgid "The Depths are the deepest part of the dungeon proper, subject to the\ncorrupting influence of the Realm of Zot without being considered a part of it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:desolation"
msgid "The Desolation was once ruled by the divines Sheza and Sargol. After the dread\ntwins were cast down, the good gods reduced their former realm to salt, that\nsuch a terrible cult would never rise again. Amidst the ruins, only the last\ncultists of the dead gods, their heretical constructs, and the guardians\nof the cult's legendary treasure yet remain.\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:arena"
msgid "Okawaru's most favoured followers are granted access to the Arena to duel\nagainst their foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/branches.txt
msgctxt "textdb:descript/branches.txt:crucible"
msgid "The Crucible of Flesh is an infernal pit where Makhleb's most devoted and\ndetested alike are made to sanctify themselves in blood. No sane mortal would\never choose to come here, and yet even victims of the Destroyer's greatest ire\nmay be granted passage out once more, should they mete out mutilation equal to\nthe demonic torturers of this realm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:acid (acid) weapon ego"
msgid "It splashes victims with acid (2d4 damage, Corrosion).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:antimagic (antimagic) weapon ego"
msgid "It reduces your magical energy, and disrupts the spells and magical abilities of\nthose it strikes. Natural abilities and divine invocations are not affected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:chaos (chaos) weapon ego"
msgid "Each hit from it has a different, random effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:concussion (concuss) weapon ego"
msgid "It pushes those it hits backwards, briefly stunning them in the process. If it\npushes them into a solid feature, they will instead take an additional one-third\nof any damage that pierces their armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:distortion (distort) weapon ego"
msgid "It warps and distorts space around it, and may blink, banish, or inflict extra\ndamage upon those it strikes. Unwielding it can teleport you to foes or banish\nyou to the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:devious (devious) weapon ego"
msgid "It has an increased chance to perform stab attacks against vulnerable targets,\nand temporarily increases the wielder's EV and slaying each time they do so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:draining (drain) weapon ego"
msgid "It sometimes drains living victims (1/2 chance). This deals an additional\none-quarter of any damage that pierces defenders' armour as well as a flat 2-4\ndamage, and also weakens them slightly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:electrocution (elec) weapon ego"
msgid "It sometimes electrocutes victims (1/4 chance, 8-20 damage).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:entangling (entangle) weapon ego"
msgid "It sometimes constricts those it attacks with vines. (1/2 chance, 2-4 damage).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:flaming (flame) weapon ego"
msgid "It burns victims, dealing an additional one-quarter of any damage that pierces\ndefenders' armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:flaming (flame) weapon ego blade"
msgid "It burns victims, dealing an additional one-quarter of any damage that pierces\ndefenders' armour. Big, fiery blades are also staple armaments of hydra-hunters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:freezing (freeze) weapon ego"
msgid "It freezes victims, dealing an additional one-quarter of any damage that pierces\ndefenders' armour. It may also slow down cold-blooded creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:foul flame (foul flame) weapon ego"
msgid "It has been infused with foul flame, dealing an additional three-quarters damage\nto holy beings, an additional one-quarter damage to undead and demons, and an\nadditional half damage to all others, so long as it pierces armour. Holy beings\nand good god worshippers cannot use this.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:heavy (heavy) weapon ego"
msgid "It deals dramatically more damage, but attacks with it are much slower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:heavy (heavy) weapon ego ranged"
msgid "Any ammunition fired from it deals dramatically more damage, but attacks with\nit are much slower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:holy wrath (holy) weapon ego"
msgid "It has been blessed by the Shining One, dealing an additional three-quarters of\nany damage that pierces undead and demons' armour. Undead and demons cannot use\nthis.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:pain (pain) weapon ego"
msgid "It inflicts extra damage on living creatures proportional to your Necromancy\nskill.{{\n    if you.god() == \"Trog\" then\n        return \" Trog prevents you from unleashing this effect.\";\n    end\n}}{{\n    if you.is_useless_skill(\"necromancy\") then\n        return \" Your inability to study Necromancy prevents you from drawing on the full power of this weapon.\";\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:penetration (penet) weapon ego"
msgid "Any ammunition fired by it continues flying after striking targets, potentially\nhitting everything in its path until it leaves sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:protection (protect) weapon ego"
msgid "It grants you temporary protection after it strikes (+7 AC).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:reaping (reap) weapon ego"
msgid "Any living, holy, or demonic foe damaged by it may be temporarily reanimated\nupon death as a friendly spectral, with an increasing chance as more damage is\ndealt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:rebuke (rebuke) weapon ego"
msgid "It shields the wearer if their last action was a melee attack (+10 SH) and\nredirects blocked melee attacks to other nearby enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:spectralising (spect) weapon ego"
msgid "When you attack with it, this weapon's spirit leaps out and launches a second,\nslightly weaker strike. The spirit shares part of any damage it takes with you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:speed (speed) weapon ego"
msgid "Attacks with it are significantly faster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:sundering (sunder) weapon ego"
msgid "After you perform multiple consecutive attacks, its next attack will deal\ngreatly increased damage and also cleave into targets an extra space away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:valour (valour) weapon ego"
msgid "It fires a beam of energy whenever it strikes an enemy while its wielder has\nno less than 80% of their maximum hit points remaining. Unwielding it will\nbriefly Weaken its wielder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:vampirism (vamp) weapon ego"
msgid "It occasionally heals you for a portion of the damage dealt when it wounds a\nliving creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:venom (venom) weapon ego"
msgid "It poisons victims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:air (air) armour ego"
msgid "It enhances your Air magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:archery (archery) armour ego"
msgid "It has half the normal encumbrance for the purpose of ranged combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:attunement (attunement) armour ego"
msgid "When worn alongside a magical staff, it doubles the effectiveness of that\nstaff's primary enhancer and causes melee attacks made with it to restore a\nsmall amount of MP.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:cold resistance (rc+) armour ego"
msgid "It protects you from cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:command (command) armour ego"
msgid "It improves the power and success of your Summoning spells in proportion to your\nArmour skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:corrosion resistance (rcorr) armour ego"
msgid "It protects you from the effects of acid and corrosion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:death (death) armour ego"
msgid "It empowers your Necromancy spells and improves their success rate, but imposes\na health cost for other magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:dexterity (dex+3) armour ego"
msgid "It increases your dexterity (Dex +3).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:earth (earth) armour ego"
msgid "It enhances your Earth magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:energy (energy) armour ego"
msgid "It may return the magic spent to cast spells, but lowers their success rate. It\nalways returns the magic spent on miscasts. The spell refund chance is increased\nby your Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:fire (fire) armour ego"
msgid "It enhances your Fire magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:fire resistance (rf+) armour ego"
msgid "It protects you from fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:flying (fly) armour ego"
msgid "It grants you flight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:glass (glass) armour ego"
msgid "It may vitrify enemies when you injure them, making them more vulnerable to\nfurther damage. Your Evocations skill increases the likelihood and duration of\nvitrification.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:guile (guile) armour ego"
msgid "It weakens both your willpower and the willpower of everyone you hex, the latter\nof which is increased by your Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:harm (harm) armour ego"
msgid "It increases damage dealt and taken.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:hurling (hurl) armour ego"
msgid "It improves your accuracy and damage with thrown weapons, such as rocks and\njavelins (Slay +4).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:ice (ice) armour ego"
msgid "It enhances your Ice magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:infusion (infuse) armour ego"
msgid "It empowers each of your melee hits with a small part of your magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:intelligence (int+3) armour ego"
msgid "It increases your intelligence (Int +3).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:invisibility (+inv) armour ego"
msgid "When activated, it grants you temporary invisibility, but also drains your\nmaximum health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:light (light) armour ego"
msgid "It surrounds you with a glowing halo, revealing invisible creatures, increasing\naccuracy against all within it other than you, and reducing your stealth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:mayhem (mayhem) armour ego"
msgid "It causes witnesses of your kills to go into a frenzy, attacking everything\nnearby with great strength and speed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:mesmerism (mesmerism) armour ego"
msgid "When you are struck in melee, it briefly dazes all nearby enemies, then must\nrecharge by standing still for a while. Its duration, radius, and recharge\nspeed are improved by your Evocations skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:parrying (parrying) armour ego"
msgid "It shields you if your last action was a melee attack. The shielding is half as\neffective if your offhand is occupied by an item other than a weapon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:poison resistance (rpois) armour ego"
msgid "It protects you from poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:ponderousness (ponderous) armour ego"
msgid "It is very cumbersome, slowing your movement.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:positive energy (rn+) armour ego"
msgid "It protects you from the effects of negative energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:protection (ac+3) armour ego"
msgid "It protects you from most sources of damage (AC +3).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:pyromania (pyromania) armour ego"
msgid "It enhances your Fire magic and may unleash a blast of flames around you\nwhenever you kill an enemy by any means other than an attack. The explosion\nchance and damage both scale with Evocations and it may trigger no more than\nonce each turn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:rampaging (rampage) armour ego"
msgid "It causes one to take an extra step when moving towards enemies, briefly\nstunning them if this results in an attack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:reflection (reflect) armour ego"
msgid "It reflects blocked missile attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:repulsion (repulsion) armour ego"
msgid "It helps you evade both magical and non-magical projectiles (EV +15).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:resistance (rc+ rf+) armour ego"
msgid "It protects you from the effects of both fire and cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:resonance (resonance) armour ego"
msgid "It improves the success rate of your Forgecraft spells and enhances your melee\nattacks proportionally to your Forgecraft skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:see invisible (sinv) armour ego"
msgid "It allows you to see invisible things.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:shadows (shadows) armour ego"
msgid "It reduces the distance you can be seen at and can see.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:sniping (snipe) armour ego"
msgid "It increases your damage by an additional 50% with ranged and thrown weapons\nagainst incapacitated targets. Incapacitated targets are those that are asleep,\nparalysed, petrified, confused or caught in a net.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:spirit shield (spirit) armour ego"
msgid "It causes incoming damage to be divided between your reserves of health and\nmagic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:stardust (stardust) armour ego"
msgid "It conjures a barrage of shooting stars the first time you spend MP to use a\nspell or ability each battle, recharging only when your MP is restored and no\nmore enemies remain. Your Evocations skill increases the number and damage of\nthe stars and MP spent further increases damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:stealth (stlth+) armour ego"
msgid "It enhances your stealth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:strength (str+3) armour ego"
msgid "It increases your strength (Str +3).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:the archmagi (archmagi) armour ego"
msgid "It increases the power of your magical spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:willpower (will+) armour ego"
msgid "It increases your willpower, protecting against certain magical effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:wrath (*rage) armour ego"
msgid "It berserks you when you make melee attacks (20% chance).\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:atropa-tipped (atropa) missile ego"
msgid "It is tipped with a substance that causes blindness and brief confusion.\n\nThe chance of successfully applying its effect increases with your Throwing and\nStealth skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:chaos (chaos) missile ego"
msgid "When thrown, it has a random effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:curare-tipped (curare) missile ego"
msgid "It is tipped with a substance that causes asphyxiation, dealing direct damage as\nwell as poisoning and slowing those it strikes.\n\nIt is twice as likely to be destroyed on impact as other darts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:datura-tipped (datura) missile ego"
msgid "It is tipped with a substance that sends those it hits into a mindless frenzy,\nattacking friend and foe alike.\n\nThe chance of successfully applying its effect increases with your Throwing and\nStealth skill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:disjunction (disjunct) missile ego"
msgid "It causes any target it hits to become temporarily untethered in space, blinking\naway from you for several turns and taking minor damage each time it does so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:dispersal (disperse) missile ego"
msgid "It causes any target it hits to blink, with a tendency towards blinking further\naway from you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:poisoned (poison) missile ego"
msgid "It is coated with poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/egos.txt
msgctxt "textdb:descript/egos.txt:silver (silver) missile ego"
msgid "It deals increased damage compared to normal missiles and substantially\nincreased damage to chaotic and magically transformed beings. It also inflicts\nextra damage against mutated beings, depending on how mutated they are.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:ablaze with memories monstatus"
msgid "This creature has temporarily gained the ability to cast specific spells.\nIt will lose access to them again once sufficiently injured.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:about to teleport monstatus"
msgid "After a short delay, this creature will be teleported to somewhere else on the\ncurrent floor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:afflicted by rimeblight monstatus"
msgid "This creature suffers AC-ignoring cold damage every turn, and may sometimes\nexplode in a burst of ice that damages nearby allies. When it dies, it may\nspread rimeblight to other nearby allies.\n\nNatural, demonic, or holy creatures will be instantly killed once they reach\nlow health, and be replaced with pillars of rime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:ally target monstatus"
msgid "This creature is being targeted by one or more of your allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:anguished monstatus"
msgid "When this creature deals damage, it will suffer damage equal to the damage it\ndealt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:asleep monstatus"
msgid "This creature is unable to move, act, block, or dodge. Any hostile action will\nawaken it, though melee attacks against it (even by other monsters) will deal\nincreased damage.\n\n[[high-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:berserk monstatus"
msgid "This creature has 50% more health, deals 50% more damage with melee attacks, and\nboth moves and acts 50% faster. They cannot perform any action besides moving\nor attacking.\n\nWhen the berserk rage wears off, they will be slowed and unable to berserk for a\nshort duration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:blind monstatus"
msgid "This creature cannot see properly. Its accuracy is greatly decreased, it cannot\nmake attacks of opportunity, and spells it casts may sometimes be aimed at the\nwrong locations.\n\nIt may also stumble around and eventually lose track of its target, especially\nif it has low intelligence.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:bound in place monstatus"
msgid "This creature cannot move under its own power, but may still use translocations\nor be forcibly displaced by someone else.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:called by a tesseract monstatus"
msgid "This monster has been called from a parallel reality. Killing it will grant no\nexperience points, but it will be immediately cast back to its original reality\nas soon as the tesseract is destroyed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:catching its breath monstatus"
msgid "This creature has used a breath ability recently and cannot use it again for a\nshort while.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:catching his breath monstatus"
msgid "[[catching its breath monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:catching her breath monstatus"
msgid "[[catching its breath monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:catching their breath monstatus"
msgid "[[catching its breath monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:chanting recall monstatus"
msgid "This creature is chanting a Word of Recall. This will recall intelligent allies\nfrom elsewhere on the floor to the caster's vicinity after a short delay, but can\nbe interrupted by most effects which would normally prevent it from casting spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:charmed monstatus"
msgid "This creature has been charmed and will fight for your cause for a short while. This\neffect will wear off immediately if you attempt to harm it in any way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:concentrated venom monstatus"
msgid "This creature's natural venom has been intensified, giving any poison it inflicts\nthrough attacks or breath weapons a chance to slow and asphyxiate susceptible targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:confused monstatus"
msgid "This creature is unable to block or use spells or abilities and will stumble around\nat random, attacking whatever it bumps into - be they friend or foe or sometimes even\nthemselves.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:contaminated monstatus"
msgid "This creature has been contaminated by transmutational energy, and will suffer\nsignificant damage every third time such energy is inflicted upon them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:constricted by roots monstatus"
msgid "This creature is being constricted by tree roots, which reduces their evasion and\ninflicts some damage each turn. It may also prevent them from moving, though each\nattempt to do so has a chance to break this effect entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:constricted by zombie hands monstatus"
msgid "This creature is being constricted by clutching corpses from deep beneath the\nearth, which reduces their evasion and inflicts some damage each turn. It may also\nprevent them from moving, though each attempt to do so has a chance to break this\neffect entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:control wrested from you monstatus"
msgid "This formerly-friendly creature has been charmed by another creature to join their\nside. If you slay the source of this charm, it will regain its senses.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:corroded monstatus"
msgid "This creature's AC is reduced by 8.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:covered in liquid flames monstatus"
msgid "This creature has been coated in sticky flame, and will take AC-ignoring fire damage\neach turn. Movement will shake off the flames, causing it to expire much more\nrapidly and stepping into water will extinguish it entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:covered in magnetic dust monstatus"
msgid "This creature is unable to evade attacks or turn invisible. If it dies, it will leave\nbehind a cloud of magnetised fragments.\n\nEach time Magnavolt is cast, a beam of electricity will automatically be fired at this\ncreature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:covered in terrible wounds monstatus"
msgid "This creature has been afflicted with illusory wounds by a flayed ghost. These wounds\nwill disappear with time or when the flayed ghost is destroyed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:covering ground quickly monstatus"
msgid "This creature moves slightly faster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:covering ground slowly monstatus"
msgid "This creature is stuck in liquefied ground, causing it to move more slowly and also\nfumble 25% of the melee attacks it makes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:crumbling away monstatus"
msgid "This creature will be automatically destroyed in a few turns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:cursed with the promise of agony monstatus"
msgid "This creature is cursed, and will lose half its current health after the next time\nthe source of the curse hits it with a melee attack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:damage-immune at range monstatus"
msgid "This creature takes no damage by any means unless the original source of that\ndamage is adjacent to them. Non-damaging side-effects happen normally.\n\n(The source of damage from clouds and projectile-like monsters, such as foxfires,\nis always considered whatever creature first created them.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:dazed monstatus"
msgid "This creature is temporarily unable to act, but any hostile action will cause it to\nimmediately regain its senses.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:diminished spells monstatus"
msgid "This creature's spells are less powerful - dealing less damage, being less able to\novercome their target's willpower, and occasionally being weaker in other ways.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:dormant monstatus"
msgid "[[asleep monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:doubled in vigour monstatus"
msgid "This monster's current and maximum health are temporarily doubled.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:empowered by the touch of beogh monstatus"
msgid "This creature has been granted great power by Beogh to challenge you. Their melee\nand ranged attacks deal 33% more damage, their health is increased, and they cast\nspells more frequently. They are also able to track you, no matter where on the\ncurrent floor you flee.\n\nThey will lose these bonuses once the challenge is concluded.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:encased in ice monstatus"
msgid "This creature has been flash-frozen and its movement speed is greatly reduced for\na short time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:entangled in a net monstatus"
msgid "This creature is caught in a net, greatly reducing its evasion and preventing it\nfrom blocking. Any attempt it makes to move or attack will instead struggle against\nthe net, which may eventually destroy it. Spellcasting is unimpaired.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:entangled in a web monstatus"
msgid "This creature is caught in a spider's web, greatly reducing its evasion and\npreventing it from blocking. Any attempt it makes to move or attack will instead\nstruggle against the web, which may eventually destroy it. Spellcasting is\nunimpaired.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:extremely poisoned monstatus"
msgid "This creature suffers poison damage every turn and cannot be poisoned any\nfurther.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:fast monstatus"
msgid "This creature moves and acts 50% faster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:feeble figment monstatus"
msgid "This creature is but a fragile duplicate of another creature. Its health is\nreduced by 66%, it deals 33% less damage with attacks, and its spells are\nsignificantly weakened.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:flame-wreathed monstatus"
msgid "This creature has been empowered by the flames of Ignis. It deals additional\nfire damage with its melee attacks, moves 33% more quickly, and has increased AC\nand resistance to fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:fleeing monstatus"
msgid "This creature is fleeing in fear and will attempt each turn to move away from\nthe source of this fear. Beside movement, it may only cast spells which it\nthinks could help it escape, such as Blink.\n\nIf harmed directly or cornered against terrain, it will turn around to fight\nonce more.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:fragile as glass monstatus"
msgid "This creature receives 50% more damage from all sources.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:frenzied and wild monstatus"
msgid "This creature deals 50% more damage with melee attacks and both moves and\nattacks 50% faster. It cannot cast spells and will prioritise attacking the\nclosest other creature present each turn, whether they are friend or foe.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:fully charged monstatus"
msgid "This creature has gathered all the power it needs to cast its spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:grapneled monstatus"
msgid "This creature has been struck with a kinetic grapnel. The next melee attack\nfrom the grapnel's source will always hit and deal slightly increased damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:heavily contaminated monstatus"
msgid "[[contaminated monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:heavily drained monstatus"
msgid "This creature has been heavily drained, lowering the accuracy of their melee\nattacks, the power of their spells and special attack properties, and making\nthem more vulnerable to many status effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:idealised monstatus"
msgid "This creature has glows with the perfection of their best self. They deal 100%\nmore damage with melee attacks, have additional AC, and cast spells with\nsubstantially more strength.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:incited by gozag monstatus"
msgid "This creature has been roused into great speed by the wrath of Gozag Ym Sagoz.\nTheir haste or berserk state is permanent and will not wear off with time\nor through deliberate magical intervention.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:indifferent monstatus"
msgid "This creature is neither hostile nor allied and may attack creatures of all\ndispositions, should it wander into them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:infested monstatus"
msgid "This creature is infested with a death scarab, which will emerge from their\nbody once they die.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:inner flame monstatus"
msgid "Whenever this creature suffers damage, a flame cloud will briefly appear\nbeneath them. When they die, they will explode in a violent burst of fire,\ndamaging anything nearby and leaving behind additional flame clouds.\n\nGiant creatures will trigger an even larger explosion when they die.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:inspiring fear monstatus"
msgid "You are currently terrified of this creature, preventing you from deliberately\nmoving close to them and causing 33% of the melee attacks you make again\nagainst them fail.\n\nThis effect will break if you ever lose sight of this creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:interlaced with chaos monstatus"
msgid "This creature's melee attacks may inflict additional damage of a random element\nor cause various irresistible status effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:lashing out in frustration monstatus"
msgid "This creature has been magically vexed and is forced to attack a random adjacent\nspace each turn instead of performing any other actions. It is more likely to\nattack a space containing a creature than an empty one, but will attack its own\nallies as readily as its enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:lightly drained monstatus"
msgid "This creature has been lightly drained, somewhat lowering the accuracy of their\nmelee attacks, the power of their spells and special attack properties, and\nmaking them slightly more vulnerable to many status effects.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:lost in madness monstatus"
msgid "This creature has been driven to madness by the power of Zin. It will never again\nuse spells or abilities and will stumble around at random, attacking whatever\nit bumps into - be they friend or foe or sometimes even themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:magic disrupted monstatus"
msgid "This creature's spells and magical abilities have been disrupted and may fail when\nused. The chance of failure depends on the remaining duration of this effect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:magic-sapped monstatus"
msgid "This creature has had its access to magic tainted. Whenever it casts a spell, its\nmagic will be severely disrupted, making it likely any subsequent spells it casts\nwill fail.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:marked with the sign of ruin monstatus"
msgid "This creature has been condemned to inexorable decay and ruin. Whenever it takes\ndamage from melee attacks, it will be drained heavily and either slowed, weakened,\nor blinded.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:mesmerising monstatus"
msgid "This creature has mesmerised you, making you unable to voluntarily move away\nfrom them.\n\nThis effect will break if you ever lose sight of this creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:minion monstatus"
msgid "This creature has been created by magic and will cease to be once its creator dies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:missing a shadow monstatus"
msgid "This creature's shadow has been torn away from it and cannot be affected\nby Aphotic Marionette ever again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:misshapen and mutated monstatus"
msgid "This creature's AC is reduced by 8 and its accuracy, spell power, brand damage, and\nwillpower are moderately reduced.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:more vulnerable to fire monstatus"
msgid "This creature's fire resistance is reduced by one level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:more vulnerable to poison monstatus"
msgid "This creature's poison resistance is reduced by one level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:mute monstatus"
msgid "This creature has been stricken permanently mute by the power of Zin. This\nprevents all noise the creature could make, including the vocalisations\nrequired for most creatures to cast spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:not watching you monstatus"
msgid "This creature has been briefly distracted by something else.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:paralysed monstatus"
msgid "This creature is unable to move, act, block, or dodge attacks.\n\n[[high-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:paralysed with fear monstatus"
msgid "[[paralysed monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:partially charged monstatus"
msgid "This creature has built up part of the charge it needs to cast a spell or\nactivate an ability.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:peaceful monstatus"
msgid "This creature will never attack you and may attack other creatures hostile to\nyou, but will neither follow you nor obey any direct instructions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:petrifying slowly monstatus"
msgid "This creature will soon become fully petrified. Its movement and actions are\n50% slower and it is nearly unable to dodge attacks, though it also takes 33%\nless damage.\n\n[[low-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:petrified monstatus"
msgid "This creature is unable to move, act, block, or dodge attacks. By being made\nof stone, it also takes 50% less damage, gains immunity to negative energy and\npoison, but become vulnerable to deconstruction.\n\n[[high-tier stab monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:poisoned monstatus"
msgid "This creature suffers poison damage every turn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:radiating silence monstatus"
msgid "This creature is surrounded by a field of unnatural silence which eliminates\nall noise made within it as well as preventing the vocalisations required for\nmany creatures (including you) to read scrolls, cast spells, or invoke divine\naid.\n\nIf this effect was caused by a spell, the radius of the field will shrink over\ntime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:radiating toxic energy monstatus"
msgid "This creature shines with Olgreb's Toxic Radiance and will continuously inflict\npoison damage on all foes in sight for several turns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:ready to become your apostle monstatus"
msgid "This creature has been defeated in honourable combat and may be recruited as\none of your apostles via the ability menu.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:ready to howl monstatus"
msgid "This creature has not yet inflicted you with Oblivion Howl and may attempt to do so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:ready to sunder monstatus"
msgid "This creature's Sundering weapon is fully charged and its next attack will be\nmore accurate, inflict greatly increased damage, and cleave with increased range.\nThis effect will be lost if it moves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:reflecting blocked projectiles monstatus"
msgid "This creature reflects any projectile it blocks back to their original source.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:reflecting injuries monstatus"
msgid "Whenever this creature suffers damage, it inflicts 2/3rds as much damage back upon\nwhatever damaged it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:regenerating monstatus"
msgid "This creature regenerates health at a greatly increased rate, proportion to their\nmaximum health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:repelling missiles monstatus"
msgid "This creature has +15 EV when dodging projectiles, whether physical or magical.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:retreating monstatus"
msgid "This creature has been ordered to flee in a given direction, and will not attack\nor return to your side until they are given new instructions or have travelled a\nsufficient distance\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:rolling monstatus"
msgid "This creature has curled into a ball, increasing its movement speed and melee\ndamage by 100% until the next time it attacks something (or becomes unable to move).\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:sharing its pain monstatus"
msgid "This creature will inflict a portion of all damage it suffers upon nearby allies,\nwith those closer to it receiving a greater amount.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:sharing his pain monstatus"
msgid "[[sharing its pain monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:sharing her pain monstatus"
msgid "[[sharing its pain monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:sharing their pain monstatus"
msgid "[[sharing its pain monstatus]]\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:sheltered from injuries monstatus"
msgid "Half of the damage suffered by this creature is redirected to the ally protecting it\ninstead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:sick monstatus"
msgid "This creature is sick and cannot naturally regenerate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:silenced monstatus"
msgid "This creature is engulfed in a field of unnatural silence, preventing any noise\nit might make, including the vocalisations required for many creatures to cast\nspells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:skewered by barbs monstatus"
msgid "This creature will take minor damage whenever it moves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:slightly transparent monstatus"
msgid "This creature is normally invisible, but your magical sight allows you to see it\nnonetheless. This has no effect on you, though any allies you have may not be\nable to see it as you can.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:slow monstatus"
msgid "This creature moves and acts at 66% of normal speed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:softly glowing monstatus"
msgid "This creature has been outlined with a halo of light and is easier to hit and\nrevealed, if invisible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:soul bound monstatus"
msgid "This creature's soul has been bound in ice. When it dies, a simulacrum of its\noriginal form will rise in its place.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:soul-gripped monstatus"
msgid "This creature's soul will be bound in service to you once they die, though\nallowing them to stray from your line of sight for more than a brief moment\nwill cause you to lose your grasp on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:soul-splintered monstatus"
msgid "A fragment of this creature's soul has been extracted into a soul wisp,\npreventing further use of this spell until the wisp reunites with them again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:spells empowered monstatus"
msgid "This creature's spells are strengthened and it will cast them more frequently.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:spells diminished monstatus"
msgid "This creature's spells are significantly weakened.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:stilling the winds monstatus"
msgid "This creature is preventing any clouds from being created on the current floor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:strong monstatus"
msgid "This creature's melee attacks deal 50% more damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monstatus.txt
msgctxt "textdb:descript/monstatus.txt:strong-willed monstatus"
