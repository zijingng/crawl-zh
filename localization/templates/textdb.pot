msgid "<A broken door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge broken gate"
msgid "<A broken door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large translucent open door"
msgid "<An open translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an open translucent gate"
msgid "<An open translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge open translucent gate"
msgid "<An open translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large translucent closed door"
msgid "<A closed translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a closed translucent gate"
msgid "<A closed translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge closed translucent gate"
msgid "<A closed translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large translucent broken door"
msgid "<A broken translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken translucent gate"
msgid "<A broken translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge broken translucent gate"
msgid "<A broken translucent door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an alarm trap"
msgid "A trap that creates a loud noise to attract nearby monsters. In addition to the\nnoise it creates, it will apply an enchantment making monsters all over the\nlevel aware of your location. Hostile monsters may trigger this trap themselves\nto invoke its effects against you, but your allies will avoid stepping on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an archmage's trap"
msgid "A magical trap crafted by some avaricious master wizard. When you or a hostile\nmonster steps on it, you will lose a percentage of your mp, while up to three of\nthe strongest hostile spellcasters in sight will have their spells empowered.\nYour allies will avoid stepping on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a devourer's trap"
msgid "A magical trap linked by divine cruelty to the stomachs of some unfathomable\ninterdimensional predators. When you or a hostile monster steps on it, it has a\nhigh chance it will expel digestive acid onto you, corroding you. Your allies\nwill avoid stepping on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dispersal trap"
msgid "Anyone stepping on this trap will translocate themselves and anyone else in view\nto a new location nearby. Hostile monsters may trigger this trap, but your\nallies will avoid stepping on it.\n\nAfter triggering, it cannot be triggered again for several turns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dispersal trap (recharging)"
msgid "[[A dispersal trap]]\n\nIt is currently recharging and will become active again in a short while.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a harlequin's trap"
msgid "A magical trap left behind by the ineffable, spectacular revues of chaos. When\nyou or a hostile monster steps on it, up to three of the strongest monsters in\nsight will have their attacks temporarily interwoven with a touch of chaos. Your\nallies will avoid stepping on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a net trap"
msgid "A large concealed net launcher hanging from the dungeon's ceiling. Enchanted by\nthe power of Zot, whenever an intelligent creature steps here - whether friend\nor foe - the net will land only on you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a permanent teleport trap"
msgid "A magical trap which will displace anyone passing over it to a random place on\nthe same dungeon level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a pressure plate"
msgid "A trigger of some sort. You cannot tell what kind of trap it is attached to.\nIts complicated detection system will trigger the trap even when someone flies\nover it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a spike launcher"
msgid "A magical contraption which skewers nearby monsters with sharp spikes. It will\ndisintegrate after a short length of time or if the caster strays too far away\nfrom it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a teleport trap"
msgid "A magical trap which will displace anyone passing over it to a random place on\nthe same dungeon level. It is worn with age, and will dissipate on use.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a tyrant's trap"
msgid "A magical trap built to bolster the armies of some conquering despot. When you\nor a hostile monster steps on it, your melee attacks will be weakened to make\nup to three of the most dangerous monsters in sight become stronger. Your\nallies will avoid stepping on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a web"
msgid "A spider's web. The spider who left it must have been huge, as it seems to be\nmade for trapping {{ return you.genus(true) }} rather than flies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a zot trap"
msgid "A trap which inflicts dangerously unpredictable magical effects on those\nunlucky enough to step on it. You may find yourself petrified, contaminated\nwith enormous amounts of wild magic, have mighty fiends summoned against you,\nor the like. Hostile monsters may trigger this trap themselves to invoke its\neffects against you, but your allies will avoid stepping on it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a flagged portal"
msgid "A portal leading to a bailey, gradually fading away as the standard is lowered\nto the ground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gauntlet entrance"
msgid "A portal leading to a gauntlet.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a flickering gateway to a bazaar"
msgid "A portal leading to a bazaar, where itinerant merchants gather to sell their\nwares. They never stay in one place for very long.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gateway to a bazaar"
msgid "A portal leading to a bazaar, where itinerant merchants gather to sell their\nwares. They will wait for you, but once you get a chance to browse their\ninventory, the merchants will depart in search of other customers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a phantasmal passage"
msgid "A portal leading to one of many Necropolis repositories, where the freshly slain\nand deeply resentful are sealed away. This wandering rift will eventually move\nelsewhere to receive further dead.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a frozen archway"
msgid "A portal leading to an ice cave. The archway is gradually melting away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a glacial archway"
msgid "A portal leading to a glacial chasm, far more dangerous than the icy caverns\nfound in the shallower reaches of the Dungeon. The archway is gradually melting\naway.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sand-covered staircase"
msgid "A staircase leading to an ossuary. Sand is continuously pouring onto it,\ngradually blocking the entrance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a glowing drain"
msgid "A passage leading to a sewer. It is gradually rusting away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a portal to a secret trove of treasure"
msgid "A portal leading to a treasure trove. This portal is unstable and will collapse\nafter a single use.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dark tunnel"
msgid "A portal leading to the heart of a volcano. Rocks are falling from the roof and\nsides of the tunnel, filling the entry.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a crumbling gateway"
msgid "A salt-encrusted arch, covered with carved entreaties to the good gods to\ncontain the evils sealed therein. Whatever protections this arch once offered\nhave finally succumbed to the ravages of time, and a bitter breeze pours forth\nfrom the distant land beyond.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a magical portal"
msgid "A portal leading to a wizard's laboratory. It is fading away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a collapsed entrance"
msgid "A collapsed passage which cannot be used anymore.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an archival metal wall"
msgid "An ensorcelled metal wall coated in an inscrutable non-linear script, recording\nthe regrets of the interred and their visitors alike. As with all metal walls,\nit is next to impossible to destroy, and will ground all varieties of bounding\nlightning.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large window"
msgid "A window embedded in the side of an enormous metal pipe, allowing observation\nof the water flowing inside.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ice choked empty arch of ancient stone"
msgid "An inoperative portal, nearly completely encased in a mass of ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ice covered gate leading back out of this place"
msgid "A portal leading back to the place you came from. Its magic is holding the ice\nat bay, preventing it from blocking the gate. You will be unable to return here\nonce you pass through it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ice covered rock wall"
msgid "A rock wall covered by a thick layer of frost and ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:some ice crusted deep water"
msgid "A pool of deep water, crusted with broken blocks of ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:some ice crusted shallow water"
msgid "A pool of shallow water, crusted with broken blocks of ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a rock-blocked tunnel"
msgid "A tunnel which is no longer passable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a rocky tunnel leading out of this place"
msgid "An unstable passage in the volcanic rock, admitting a draft of cool air from\nbeyond. It leads back to the place you came from. You will be unable to return\nhere once you pass through it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an endless expanse of salt"
msgid "A seemingly endless, flat plain, wracked by blinding salt-storms. Anyone\nventuring across it would be lost beyond all hope in short order.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a ruined idol"
msgid "A monument to the glory of a dead god. The statue has been methodically\ndefaced; not a single distinguishing feature remains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a portal leading out of this place"
msgid "A shimmering magical gate leading back to the place you came from. You will be\nunable to return here once you pass through it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an autumnal tree"
msgid "A large tree that appears to be permanently locked in an autumnal moment.\nLeaves, coloured red and gold, fall from its branches and float gracefully to\nthe floor, but before they even reach the ground they shimmer and reappear on\nthe branches, ready to fall again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a crumbled stone wall"
msgid "A stone wall on the brink of collapsing from disrepair but somehow remaining\nstanding, seemingly frozen in time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a strange statue"
msgid "A statue with strange and alien features. Is it because the statue is worn and\ntarnished that it has become so unrecognisable? Or is it that the subject was\nsomething demonic and evil?\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a strange rock wall"
msgid "A wall decorated with images you might see in a tomb.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a highly decorated stone wall"
msgid "A wall covered with disturbing, horrifying images.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the rough-hewn floor"
msgid "The floor. It is rough and uneven in places.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:viscous fluid"
msgid "A sticky fluid which seems to be secreted by the nearby walls. It looks\ndisgusting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sinewy wall"
msgid "A wall that looks strangely organic, but incredibly tough and durable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a thin membrane"
msgid "A strange membrane, thin enough to see through.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the pulsating floor"
msgid "The floor. It pulses to an unknown beat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken fleshy orifice"
msgid "It seems to be oozing quietly. Best not to touch it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:zonguldrok's gravestone"
msgid "A gravestone of the house of Zonguldrok, still dripping with brackish ichor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a gravestone"
msgid "A nameless grave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the dimension's edge"
msgid "The edge of this tiny, isolated plane, where space itself dissolves into\noblivion. Entering or affecting this black void is impossible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a wall of crystal"
msgid "<A crystal wall>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:the damp floor"
msgid "The floor. It remains forever damp, perhaps due to the humidity or the constant\nflow of clouds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a wall of orange crystal"
msgid "A wall made from orange crystal. It has a mind-boggling sheen.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a wall of white crystal"
msgid "A wall made from low-grade crystal with an opalescent gleam.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a black wall"
msgid "A wall made perhaps from stone, or solid charcoal, or a substance found only in\nthe deepest hells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a carved rock wall"
msgid "A wall decorated with images of death and destruction.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an unnaturally hard bloodstone wall"
msgid "An indestructible bulwark, wrought from blood and tempered in the suffering of\nmortal lives beyond count.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a metal statue"
msgid "A base type statue for other statue flavours. If you see this, file a bug\nreport.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a decorative floor"
msgid "A base floor type for various decorations one can walk over. If you see this,\nfile a bug report.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a tree of woe"
msgid "A half-alive tree burdened with fruits of crystallised sorrow.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dead tree"
msgid "The dry remains of a long-dead tree.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dead mangrove"
msgid "The dry remains of a long-dead mangrove.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a bloodied mop and bucket"
msgid "A mop and bucket soaked with the bloody aftermath of demonic torture.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an iron statue"
msgid "A statue of an ancient warrior, festooned with trophies from fallen victims.\nSome dark substance oozes from the gaps in its visor; surely it must be oil..?\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an infernal standard"
msgid "A blazing flag of cruel conquest, planted amid the ruins of many a fallen\nkingdom to claim their ashes in the name of Hell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:ashen ground"
msgid "Ash and embers, littered with broken treasures and worthless coins from realms\nlong fallen.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a tempered metal wall"
msgid "Walls of brass and nickel, covered in a thin golden foil steadily peeling away\nin the constant, oppressive heat. Designs depict mortals dealing with devils,\nbut the former rarely seem to come out ahead on the exchange.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ice-covered rock wall"
msgid "A rock wall coated in a thick layer of ice. Twisted faces glower beneath the\nsurface, locked in perpetual grimaces of rage and betrayal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an ice-covered stone wall"
msgid "A stone wall coated in a thick layer of ice. Twisted faces glower beneath the\nsurface, locked in perpetual grimaces of rage and betrayal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:frost-covered floor"
msgid "Earth locked within perpetual frost and cold. It seems ageless and changeless,\nas though it has existed in this state for an eternity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a golden statue"
msgid "A solid gold statue of a saint.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a silver statue"
msgid "A geometric statue of solid silver, in both material and form championing\nsecurity and stasis.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a scintillating statue"
msgid "A magically shifting statue seemingly content to glimmer and dance in place,\ndedicated to the ineffable cosmic games of chaos.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a mystic cage"
msgid "A sturdy metal cage, inscribed with cryptic magics. Whatever it once held -\nwhether person, beast, or experiment - was evidently already freed in response\nto intruders like you infiltrating the Dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an arcane conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its destructive mystic\nenergy will harmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a misfortune conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its malevolent cursed\nenergy will harmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a dimensional conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its extraplanar warp\nenergy will harmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a soul conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its negative energy will\nharmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an alchemical conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its venomous churning\nenergy will harmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a fiery conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its ever-burning energy\nwill harmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an icy conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its chilling cold energy\nwill harmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an earthen conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its seismic energy will\nharmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a storm conduit"
msgid "A strange but benign metal construct, analysing raw ambient magical energy. If\ndestroyed and disrupted by sufficiently mighty magic, its crackling energy will\nharmlessly disperse.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an enigmatic dynamo"
msgid "A harmless yet sturdy metal construct, arcane both in power-source and\npurpose. Whatever it analyses, processes, powers, or produces can neither be\nassessed nor accessed by intruders like you infiltrating the Dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a nascence circuit"
msgid "A coruscating spark gap of twin electrodes of impenetrably advanced technology.\nThese are used to forge and power thaumaturgical constructs, though despite the\nconstant crackling, this one is used up and unable to do much more than\nharmlessly dance with the joy of creating life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a bedevilled crystal wall"
msgid "A wall made from shimmering crystal, from which some demonic plane peers out.\nWhile its composition both make it resist destruction plus reflect both fire and\ncold, the otherworldly forces within it seem to be entirely harmless... from\nthis end, anyway.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a floral vase"
msgid "A vibrant bouquet of flowers in a clay vessel, kept alive with ample water\nand some minor magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a garden patch"
msgid "A small decorative plot of flowers penned in by cobblestone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a flower patch"
msgid "A bed of hardy wildflowers, thriving in this place despite everything.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a mop and bucket"
msgid "A mop and bucket, useful for keeping one's environs orderly and clean. Too bad\nyou're here now.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a fur brush"
msgid "A grooming brush laid to rest beside a pile of tangled, matted yak fur.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a set of bottled spirits"
msgid "A mix of various alcoholic drinks with worn-down labels. Unfortunately, the\npreservative magic sealing each bottle makes it impossible to sample from them\nwithout smashing their bottles open.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a djembe set"
msgid "A drum ensemble whose rhythm serves as peaceful recreation here in the depths of\nthe earth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a caliginous standard"
msgid "A murky flag of dark conquest shimmering with vile energies, planted in the name\nof some grand despoiling crusade.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a skull pike"
msgid "Bones are a common sight in the Dungeon, but skulls left impaled in a shrike's\nmanner on display send a more deliberate message to trespassers: the pike has\nroom for one more skull, and whoever set it up is happy to help relieve its\nowner of theirs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a mourning vase"
msgid "A singular flower, suffused with gloom and held in a ceramic grip. It\nis difficult to tell whether it is even still alive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a broken floral vase"
msgid "A delicate arrangement, smashed to pieces and consigned to slow starvation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a weapon-inlaid floor"
msgid "The decorative elvish inlayings of weapons mark here the Hall of Blades, where\nmany of the Dungeon's keenest weapons originate, magically animated to\ndemonstrate their own lethality on would-be thieves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an orcish standard"
msgid "A flag of Beogh, raised to show that this fortification belongs to some arm of\nthe Dungeon's orcish military.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a silver wall"
msgid "A wall made of pure silver.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a rune-carved stone wall"
msgid "A strangely slime-free stone wall, carved all over with countless protective\nrunes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a rune-carved clear stone wall"
msgid "A strangely slime-free stone wall, with strange lights twinkling within its\nairy confines. Mystical runes are scattered across its surface, seemingly\nreferring to a 'Royal Jelly'.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sarcophagus"
msgid "An ancient sarcophagus. It appears to be empty.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a heavily etched metal wall"
msgid "A metal wall etched with murals depicting, in great and gruesome detail,\nexactly what will be done to anyone caught stealing from the Vaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a heavily etched crystal wall"
msgid "A crystal wall etched with murals depicting, in great and gruesome detail,\nexactly what will be done to anyone caught stealing from the Vaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an adventurer's gravestone"
msgid "The grave of an adventurer who came close to victory.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an elephant-shaped statue"
msgid "A worn granite statue depicting an elephant standing guard.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a weirdly glowing ball"
msgid "A floating ball radiating with shimmering light.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sealed sarcophagus"
msgid "An ancient sarcophagus. It is sealed shut.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an open sea?"
msgid "Though it exists in stark defiance of every conventional rule of physics and\ngeometry you know to be true, there can be no denying that here, in this tiny\nroom, is a vast and terrible sea of impossible size.\n\nEither that, or it's a blue wall.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a spawn point"
msgid "An entrance that the opposition may appear from.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:an exit from the tutorial"
msgid "A way out of the dungeon, letting you finish this lesson.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:haloed"
msgid "This area is lit by a divine halo, decreasing your stealth, preventing\ninvisibility, and increasing the accuracy of attacks against any illuminated\ncreatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:umbraed"
msgid "This area is wreathed by an umbra, improving your stealth if you are attuned to\nthe shadows, and decreasing the accuracy of attacks by those unattuned to the\nshadows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:liquefied"
msgid "The ground here is liquefied, making movement slow and causing any attempts to\nattack in melee to sometimes fail.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:disjunction haloed"
msgid "This area is bathed in translocational energy, causing creatures to blink away\nfrom the originator of the energy with an increasing chance the closer they are\nto the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:ice covered"
msgid "This wall is covered in magical ice that freezes victims who wander nearby.\nThis damage bypasses any armour the target may have, and will slow cold-blooded\ncreatures. Each victim is only ever affected by one icy wall at a time.\n\nThe creator of this icy covering and any of their allies can walk safely past\nthis wall.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:awoken"
msgid "This tree has been temporarily enchanted to grant it some limited motility,\nallowing it to lash out out at any adjacent enemies of the creature who awoke\nit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:tree burning"
msgid "It is susceptible to bolts of lightning and to sufficiently intense sources of\nfire. The resulting blaze can flare up, spreading to areas nearby and igniting\nother trees.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:mangrove burning"
msgid "It is susceptible to bolts of lightning and to sufficiently intense sources of\nfire. Mangroves do not burn as vigorously as normal trees, due to growing on\nswampy terrain, and leave behind shallow water after they smoulder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:demonic tree burning"
msgid "It is susceptible to bolts of lightning and to sufficiently intense sources of\nfire. Burning this tree releases a cloud of pure chaos instead of flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:welcome"
msgid "<white>Welcome to Dungeon Crawl!</white>\n\nYour objective is to lead your <w>{{ return you.race() }} {{ return you.class()\n}}</w> safely through the depths of the dungeon, retrieving the fabled Orb of\nZot and returning it to the surface. In the beginning, however, let discovery\nbe your main goal. Try to delve as deeply as possible but beware; death lurks\naround every corner.\n\nFor the moment, just remember the following keys and their functions:\n  <input>$cmd[CMD_DISPLAY_COMMANDS]?</input> — shows the items and the commands\n  <input>$cmd[CMD_SAVE_GAME]</input>  — saves the game, to be resumed later\n(but note that death is permanent)\n  <input>$cmd[CMD_LOOK_AROUND]</input>  — examines something in your vicinity\n\nThe hint mode will help you play Crawl without reading any documentation. If\nyou haven't yet, you might want to try out the tutorial. Also, if you feel\nintrigued, there is more information available in the following files from the\ndocs/ directory (all of which can also be read in-game):\n  <lightblue>quickstart.txt</lightblue>     — A very short guide to Crawl.\n  <lightblue>crawl_manual.txt</lightblue>   — This contains all details on\nspecies, magic, skills, etc.\n  <lightblue>options_guide.txt</lightblue>  — Crawl's interface is highly\nconfigurable. This document explains all the options.\n\nHappy Crawling!\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death"
msgid "Condolences! Your character's premature death is a sad, but common occurrence\nin Crawl. Rest assured that with diligence and playing experience your\ncharacters will last longer.\n\nPerhaps the following advice can improve your playing style:\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death conjurer melee"
msgid "As a Conjurer your main weapon should be offensive magic. Cast spells more\noften! Remember to rest when your Magic is low.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death berserker unberserked"
msgid "Don't forget to go berserk when fighting particularly difficult foes. It's\nrisky, but makes you faster and beefier.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death ranger melee"
msgid "Your bow and arrows are extremely powerful against distant monsters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death random 0"
msgid "Always consider using projectiles, wands or spells before engaging monsters in\nclose combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death random 1"
msgid "Learn when to run away from things you can't handle — this is important! It is\noften wise to skip a particularly dangerous level. But don't overdo this as\nmonsters will only get harder the deeper you delve.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death random 2"
msgid "Rest between encounters, if possible in an area already explored and cleared of\nmonsters. Pressing <input>$cmd[CMD_REST]</input><localtiles>, or\n<input>clicking on the 'rest' button in the command bar'</input></localtiles>\nwill rest for 100 turns, or until fully healed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death random 3"
msgid "Remember to use those scrolls, potions or wands you've found. Learn to\nimprovise: you will need to identify potions and scrolls by using them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death random 4"
msgid "If a particular encounter feels overwhelming, don't forget to use emergency\nitems early on. A scroll of teleportation or a potion of haste can really save\nyour bacon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:death random 5"
msgid "Never fight more than one monster, if you can help it. Always back into a\ncorridor so that they are forced to fight you one on one.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished"
msgid "Congrats! You survived until the end of hints mode — be sure to try the\nother characters as well. Note that the command help screen\n(<input>$cmd[CMD_DISPLAY_COMMANDS]?</input>) will look very different from now\non. Here's a last playing hint:\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished explored"
msgid "Walking around and exploring levels gets easier by using auto-explore\n(<input>$cmd[CMD_EXPLORE]</input>). Crawl will let you automatically move to\nand pick up interesting items.<localtiles>\n\nAutoexploration can also be started by <input>Ctrl-Leftclick</input> on the\nminimap.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished travel"
msgid "There is a convenient way to travel between distant dungeon levels: press\n<input>$cmd[CMD_INTERLEVEL_TRAVEL]</input> and enter the desired destination.\nIf your travel gets interrupted, issuing <input>$cmd[CMD_INTERLEVEL_TRAVEL]\nEnter</input> will continue it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished stashes"
msgid "You can search among all items existing in the dungeon with the\n<input>$cmd[CMD_SEARCH_STASHES]</input> command. For example,\n<input>$cmd[CMD_SEARCH_STASHES]</input> <w>“dagger”</w> will list all daggers,\nand allow you to travel to them. You can even search for dungeon features, like\n<w>“shop”</w> or <w>“altar”</w>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished random 0"
msgid "The game keeps an automated log for your characters. Use\n<input>$cmd[CMD_DISPLAY_COMMANDS]:</input> to read it. Once your character\nperishes, two morgue files are left in the <w>morgue/</w> directory. The one\nending in .txt contains a copy of your log. During play, you can create a dump\nfile with <input>$cmd[CMD_CHARACTER_DUMP]</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished random 1"
msgid "Crawl has a macro function built in: press <input>$cmd[CMD_MACRO_MENU]</input>\nto define a macro by first specifying a trigger key (say, <input>F1</input>)\nand a command sequence, for example <input>za.</input>. The latter will make\nthe <input>F1</input> key always zap the spell in slot a at the nearest\nmonster. For more information on macros, type\n<input>$cmd[CMD_DISPLAY_COMMANDS]~</input>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished random 2"
msgid "The interface can be greatly customised. All options are explained in the file\n<w>options_guide.txt</w> which can be found in the <w>docs</w> directory. The\noptions themselves are set in <w>init.txt</w> or <w>.crawlrc</w>. Crawl will\ncomplain if it can't find either file.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:finished random 3"
msgid "You can ask other Crawl players for advice and help using any of the community\nresources described at http://crawl.develz.org/\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert ashenzari"
msgid "You've just converted to worshipping <w>Ashenzari</w>. Unlike other gods,\nAshenzari only cares about curses. As you explore the dungeon, Ashenzari will\noffer curses, locking an item onto you. The more cursed items you wear, the more\nAshenzari will enhance your skills and otherwise help you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert gozag"
msgid "You've just converted to worshipping <w>Gozag</w>. Unlike other gods, Gozag only\ncares about gold; each divine power costs gold, and your foes turn to gold on\ndeath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert ru"
msgid "You've just converted to worshipping <w>Ru</w>. Unlike other gods, Ru grants\npiety (divine favour) in exchange for permanent sacrifices, like losing the\nability to train certain skills, or permanently losing a hand. The more piety\nyou have, the more abilities Ru will grant, and the more powerful those\nabilities will become. Ru will offer more sacrifices as you explore the depths\nof the dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert uskayaw"
msgid "You've just converted to worshipping <w>Uskayaw</w>. Unlike other gods,\nUskayaw's favour cannot be gradually gained as you explore the dungeon or slay\nmonsters. Instead, piety with Uskayaw is gained rapidly in combat as you deal\ndamage. The longer you remain in combat and the more damage you deal, the\ngreater the powers you will be offered. Once combat ends, Uskayaw's favour will\nbe quickly lost, and must be regained in the next battle.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert xom"
msgid "You've just converted to worshipping <w>Xom</w>. As a follower of Xom, you'll\nbe treated like a plaything, randomly helped or harmed for Xom's own amusement.\n\nThere is no way to guarantee Xom remains in a good mood - the best any follower\ncan hope for is to avoid letting Xom grow bored!\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert yredelemnul"
msgid "You've just converted to worshipping <w>Yredelemnul</w>. Unlike other gods,\nYredelemnul only cares about souls. Your enemies may rise to serve you after\ndeath, and you can expend them to invoke Yredelemnul's aid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_convert"
msgid "You've just converted to worshipping <w>{{ return you.god() }}</w>. Your piety\n(divine favour) will increase as you do things to please your new god, and will\ngradually decrease over time.\n\nYou can check your god's likes and dislikes, as well as your current standing\nand divine abilities, by typing\n<input>$cmd[CMD_DISPLAY_RELIGION]</input><localtiles>, or by pressing\n<input>Shift-right-click</input> on your avatar</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_first_object"
msgid "That <console>$1 </console>is an item. If you move there and press\n<input>$cmd[CMD_PICKUP]</input><localtiles>, or <input>left-click</input> on it\nin your inventory</localtiles>, you will pick it up.<console> Generally, items\nare shown by non-letter symbols like <w>%?!\"=()[</w>.</console> Some\nobjects<tiles>, marked with a green frame,</tiles> will be picked up\nautomatically.\n\nOnce it is in your inventory, you can drop it again with <localtiles>a\n<input>Shift-left-click</input>. Whenever you <input>right-click</input> on an\nitem</localtiles><console><input>$cmd[CMD_DROP]</input>. Any time you look at an\nitem in your inventory (<input>$cmd[CMD_DISPLAY_INVENTORY]</input>)</console>,\nyou can read about its properties and its description.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_potion"
msgid "You have picked up your first potion<console> ('<w>$item[potion]</w>')</console>.\n<localtiles>Simply <w>left-click</w> on it, or press</localtiles>\n<nomouse>Press</nomouse> <w>$cmd[CMD_QUAFF]</w> to quaff it.\n\nOnce you've identified a potion, either with a scroll of identification or by\ndrinking it, you'll automatically recognise all other potions of the same type;\nthis means it's sometimes useful to drink potions just to identify them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_scroll"
msgid "You have picked up your first scroll<console> ('<w>$item[scroll]</w>')</console>.\n<localtiles>Simply <w>left-click</w> on it, or press</localtiles>\n<nomouse>Press</nomouse> <w>$cmd[CMD_READ]</w> to read it.\n\nOnce you've identified a scroll, either with a scroll of identification or by\nreading it, you'll automatically recognise all other scrolls of the same type;\nthis means it's sometimes useful to read scrolls just to identify them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_wand"
msgid "You have picked up your first wand<console> ('<w>$item[wand]</w>')</console>.\n<localtiles>Simply <w>left-click</w> on it, or press</localtiles>\n<nomouse>Press</nomouse> <w>$cmd[CMD_EVOKE]</w> to evoke it.\n\nIf you find more wands of the same type, they'll merge into this wand and add\ncharges to it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_spbook"
msgid "You have picked up a book<console> ('<w>$item[book]</w>')</console>. On pickup,\nits spells are immediately added to your library. You'll be able to memorise\nspells from it via <w>$cmd[CMD_MEMORISE_SPELL]</w>, and cast them with\n<w>$cmd[CMD_CAST_SPELL]</w>.\n{{\n    if you.god() == \"Trog\" then\n        return \"Trog hates it when you memorise or study magic, though!\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_weapon"
msgid "This is the first weapon<console> ('<w>$item[weapon]</w>')</console> you've\npicked up. Use <w>$cmd[CMD_WIELD_WEAPON]</w><localtiles> or\n<w>left-click</w> on it</localtiles> to wield it, but be aware that this\nweapon might train a different skill from your current one. You can view the\nweapon's properties from your\n<w>$cmd[CMD_DISPLAY_INVENTORY]</w>nventory<localtiles> or by\n<w>right-clicking</w> on it</localtiles>.\n\n{{\n    if crawl.hints_type() == \"berserk\" then\n        return \"You should probably stick with axes. Checking other axes'\"\n               .. \" enchantments can be worthwhile, though!\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_missiles"
msgid "This is the first stack of missiles<console> ('<w>$item[missile]</w>')</console>\nyou've picked up. Missiles like boomerangs and throwing nets can be thrown by\nhand, and become more effective as you train the Throwing skill.\n<localtiles><w>Right-click</w> on</localtiles><nomouse>Select</nomouse>\nthe item in your <w>$cmd[CMD_DISPLAY_INVENTORY]</w>nventory to see more\ninformation.\n\n{{\n    if crawl.hints_type() == \"ranger\" then\n        return \"As you're already trained in Ranged Weapons, you don't really \"\n               .. \"need another type of ranged attack.\"\n    elseif crawl.hints_type() == \"magic\" then\n        return \"However, as a spellslinger, you don't really need another type\"\n               .. \" of ranged attack.\"\n    else\n        return \"\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_armour"
msgid "This is the first piece of armour<console> ('<w>$item[armour]</w>')</console>\nyou've picked up. <localtiles>You can click on it to wear it, and click again\nto remove it. <w>Right-clicking</w> on it will give more information.\n</localtiles><nomouse>Use <w>$cmd[CMD_WEAR_ARMOUR]</w> to wear it and\n<w>$cmd[CMD_REMOVE_ARMOUR]</w> to take it off again. You can view its\nproperties from your <w>$cmd[CMD_DISPLAY_INVENTORY]</w>nventory.\n</nomouse>\n\n{{\n    if you.get_base_mutation_level(\"horns\") > 0 then\n        return \"Note that because of your horns you will be unable to wear\"\n               .. \" helmets. (Press <w>$cmd[CMD_DISPLAY_MUTATIONS]</w> to see\"\n               .. \" a list of your mutations and innate abilities.)\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_jewellery"
msgid "You have picked up a piece of jewellery, either a ring\n<console>('<w>$item[jewellery]</w>') </console>or an\namulet<console> ('<w>$item[amulet]</w>')</console>.\n<nomouse>Press <w>$cmd[CMD_WEAR_JEWELLERY]</w> to put it on and\n<w>$cmd[CMD_REMOVE_JEWELLERY]</w> to remove it. You can view its properties\nfrom your <w>$cmd[CMD_DISPLAY_INVENTORY]</w>nventory.</nomouse>\n<localtiles>You can click on it to put it on, and click again to remove it. By\n<w>right-clicking</w> on it, you can view its properties.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_misc"
msgid "This is a curious object indeed. You can play around with it to find out what\nit does by <localtiles>clicking on it to e<w>$cmd[CMD_EVOKE]</w>oke </localtiles>\n<nomouse>e<w>$cmd[CMD_EVOKE]</w>oking </nomouse>it. As usual, selecting it from\nyour <w>$cmd[CMD_DISPLAY_INVENTORY]</w>nventory might give you more information.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_staff"
msgid "You have picked up a magic staff<console> ('<w>$item[magical staff]</w>')</console>.\nIt must be <w>$cmd[CMD_WIELD_WEAPON]</w>ielded to be of use. Magicians use\nstaves to increase their power in certain spell schools. It can also be used as\na weapon.<localtiles> You can wield a staff by <w>left-clicking</w>.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_gold"
msgid "You have picked up your first pile of gold<console>\n('<yellow>$item[gold]</yellow>')</console>. Press <w>$cmd[CMD_LIST_GOLD]</w> to\nsee how much you have. Gold is used in shops you'll find as you explore.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_stairs"
msgid "These<console> '$1'</console> are downstairs. You can enter the next (deeper)\nlevel by following them down (<w>$cmd[CMD_GO_DOWNSTAIRS]</w>). To return to this\nlevel, press <w>$cmd[CMD_GO_UPSTAIRS]</w> while standing on the upstairs. When\nyou take stairs, you are guaranteed a opportunity to act before any monsters you\nhave not seen before; after that, monsters get to move first.\n\n<localtiles>Alternatively, you can <w>left-click</w> on stairs you're standing\non to use them.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_escape_hatch"
msgid "This<console> '$1'</console> is an escape hatch. You can use it to leave a\nlevel with <w>$cmd[CMD_GO_UPSTAIRS]</w> and <w>$cmd[CMD_GO_DOWNSTAIRS]</w>\nrespectively<localtiles> (or by<w>left-clicking</w>)</localtiles>, like stairs;\nunlike stairs, however, hatches are a one-way trip, so be careful when\ndescending!\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_branch"
msgid "This<console> '$1'</console> is the entrance to a different branch of the\ndungeon. Each branch has different terrain and monsters, and some contain\nentrances to other branches. You can learn more by examining this\nentrance<localtiles> by hovering your mouse over its tile</localtiles><nomouse\nby pressing <w>$cmd[CMD_LOOK_AROUND]</w> and moving the cursor onto it.\"\n\nSome branches will be much safer and more rewarding than your current branch.\nOthers can be very dangerous, better visited when your character is more\npowerful.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_portal"
msgid "This<console> '$1'</console> is a portal to an optional level, offering extra\nloot in exchange for extra danger. There's no penalty for skipping it, but the\nportal will disappear if you wait, so you have to decide now if you want to risk\nit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_bazaar_portal"
msgid "This<console> '$1'</console> is a portal to an inter-dimensional bazaar filled\nwith shops. It will disappear if you don't enter it soon, so hurry.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_portal_2"
msgid "You can enter a portal just like a set of stairs, by standing on it and\n<localtiles><w>clicking</w> or </localtiles>pressing\n<w>$cmd[CMD_GO_DOWNSTAIRS]</w>. To return, find <tiles>a similar looking portal.\n</tiles><console>another $1 - but NOT the ancient stone arch you'll start out\non!</console>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_stair_brand"
msgid "<tiles>A small symbol on a stair tile signifies that there are items in that\nposition that you may want to check out.</tiles>\n<console>If any items are covering stairs or an escape hatch, then that will\nbe indicated by highlighting the <w><<</w> or <w>></w> symbol, instead of hiding\nthe stair symbol with an item glyph.</console>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_heap_brand"
msgid "<tiles>A small symbol on an item tile signifies that there is at least one other\nitem in the same heap that you may want to check out.</tiles>\n<console>If two or more items are on a single square, then the square will be\nhighlighted, and the symbol for the item on the top of the heap will be shown.\n</console>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_trap_brand"
msgid "<console>If any items are covering a trap, then that will be indicated by\nhighlighting the <w>^</w> symbol, instead of hiding the trap symbol with an item\nglyph.</console>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_trap"
msgid "You just discovered a trap. You'll occasionally find these nasty\nconstructions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_altar"
msgid "That<console> $1</console> is an altar.\n<localtiles>By <w>right-clicking</w> on it with your mouse</localtiles>\n<nomouse>If you target the altar with <w>$cmd[CMD_LOOK_AROUND]</w>, then press\n<w>$cmd[CMD_TARGET_DESCRIBE]</w></nomouse> you can get a short description.\n\nPress <w>$cmd[CMD_GO_UPSTAIRS]</w> or <w>$cmd[CMD_GO_DOWNSTAIRS]</w> while\nstanding on the square to join the faith or read some information about the god\nin question. Before taking up the corresponding faith you'll be asked for\nconfirmation.\n\n{{\n    if you.god() == \"No God\" and crawl.hints_type() == \"magic\" then\n        return \"The simplest god for an inexperienced conjurer is probably \"\n               .. \"Vehumet, though many other gods, like Sif Muna, can also \"\n               .. \"work well.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_shop"
msgid "That<console> $1</console> is a shop. You can enter it by typing\n<w>$cmd[CMD_GO_UPSTAIRS]</w> or <w>$cmd[CMD_GO_DOWNSTAIRS]</w>\n<tiles>, or by <w>left-clicking</w> on it<tiles>\nwhile standing on the square.\n\nIf there's anything you want which you can't afford yet, you can hold\n<w>Shift</w> and press the corresponding letter to put it on your shopping list.\nThe game will then remind you when you gather enough gold to buy it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_door"
msgid "That<console> $1</console> is a closed door. You can open it by walking into it.\nSometimes it is useful to close a door. Do so by <nomouse>pressing\n<w>$cmd[CMD_CLOSE_DOOR]</w> while next to it. If there are several doors, you\nwill then be prompted for a direction.</nomouse><localtiles>clicking on the door\nwhile next to it.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_runed_door"
msgid "That<console> $1</console> is a runed door, which is probably in front of\nsomething unusually dangerous. Monsters will never open it. If you do, the runes\nwill be broken, and it will become a normal door.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_killed_monster"
msgid "Congratulations, your character just gained experience by killing this monster!\nThis will raise some of your skills, making you more deadly.\n{{\n    if you.god() == \"Trog\" then\n        return \"Also, most kills will grant you favour in the eyes of Trog.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_new_level"
msgid "Well done! Reaching a new experience level is always a nice event. You get more\nhealth and magic points, and occasionally increases to your attributes:\nstrength, intelligence, and dexterity.\n\n{{\n    if crawl.hints_type() == \"magic\" then\n        return \"Gaining an experience level also lets you learn more difficult\"\n               .. \" spells. You can memorise a second spell with\"\n               .. \" <w>$cmd[CMD_MEMORISE_SPELL]</w><tiles> or by\"\n               .. \" <w>clicking</w> on it in the memorisation tab</tiles>.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_skill_raise"
msgid "One of your skills just reached a milestone. The skills you use are\nautomatically trained whenever you gain experience, by killing monsters. By\ndefault, experience goes to skills you actively use. To view or manage your\nskills, type <w>$cmd[CMD_DISPLAY_SKILLS]</w><localtiles> or click on the skill\ntab in the bottom-right</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_gained_magical_skill"
msgid "Being skilled in a magical \"school\" makes it easier to learn and cast spells of\nthat school. Many spells belong to a combination of several schools, in which\ncase the average skill in these schools will determine spellcasting success and\npower.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_gained_melee_skill"
msgid "Being skilled with a particular type of weapon will make you deal slightly more\ndamage and attack significantly faster with all weapons of that type. It's a\ngood idea to focus on just one weapon type, usually one you start with, though\nfinding a particularly good weapon may justify a switch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_gained_ranged_skill"
msgid "Being skilled with ranged weapons will let you deal slightly more damage and\nattack significantly faster with them. Remember that wearing heavy armour makes\nyou attack more slowly with ranged weapons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_choose_stat"
msgid "Upon gaining levels 3, 9, 15, etc., you get to choose an attribute to raise:\nstrength, intelligence, or dexterity.\n\n<w>Strength</w> makes heavy armour less cumbersome and slightly increases most\nweapons' damage.\n\n<w>Intelligence</w> makes your spells more reliable and powerful.\n\n<w>Dexterity</w> increases your evasion and stealth, and slightly increases the\ndamage of blades and ranged weapons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_malevolence"
msgid "As you explore the dungeon and reveal new tiles, the malevolent forces of the\ndungeon may randomly cause bad things to happen to you. When this happens,\npause, think carefully, and be ready to use consumables or abilities. Fight to\nsurvive!\"\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_opportunity_attack"
msgid "When you move away from an enemy, they have a small (1/3) chance of taking\nadvantage and launching a free attack. Repositioning and retreating is often\nstill good, but keep an eye out for those extra attacks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_you_enchanted"
msgid "Enchantments of all types can befall you temporarily.\nBrief descriptions of these appear at the lower end of the stats area.\nPress <w>$cmd[CMD_DISPLAY_CHARACTER_STATUS]</w> for more details. You can search\nfor full enchantment descriptions by pressing <w>$cmd[CMD_DISPLAY_COMMANDS]/T</w>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_you_poison"
msgid "Poison will rapidly reduce your health. You can wait it out with\n<w>$cmd[CMD_REST]</w>, but if you're in combat or lethally poisoned, you'll\nprobably want to quaff a potion of curing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_multi_pickup"
msgid "There are a lot of items here. You choose what to pick up from a menu:\npress <w>$cmd[CMD_PICKUP]</w><localtiles> or <w>click</w> on the player\ndoll</localtiles> to enter the pickup menu. To leave the menu, confirm your\nselection with <w>Enter</w>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_full_inventory"
msgid "Sadly, your inventory is limited to 52 items, and it appears your knapsack is\nfull. However, this is easy enough to rectify: simply <w>$cmd[CMD_DROP]</w>rop\nsome of the stuff you don't need right now. In the drop menu you can then\ncomfortably select which items to drop by pressing their inventory\nletter<localtiles>, or by clicking on them</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_shift_run"
msgid "Walking around takes fewer keystrokes if you press <w>Shift-direction</w> or\n<w>/ direction</w>. That will let you run until a monster comes into sight or\nyour character sees something interesting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_map_view"
msgid "As you explore a level, orientation can become difficult. Press\n<w>$cmd[CMD_DISPLAY_MAP]</w> to bring up the level map. Typing <w>?</w> shows\nthe list of level map commands. Most importantly, moving the cursor to a spot\nand pressing <w>.</w> or <w>Enter</w> lets your character move there on its own.\n\n<localtiles>Also, clicking on the right-side minimap with your <w>right mouse\nbutton</w> will zoom into that dungeon area. Clicking with the <w>left mouse\nbutton</w> instead will let you move there.</localtiles>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_auto_explore"
msgid "Fully exploring a level and picking up all the interesting looking items can be\ntedious. To save on this tedium you can press <w>$cmd[CMD_EXPLORE]</w> to\nauto-explore, which will automatically explore unmapped regions, automatically\npick up interesting items, and stop if a monster or interesting dungeon feature\n(stairs, altar, etc.) is encountered.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_done_explore"
msgid "Hey, you've finished exploring the dungeon on this level! You can search for\nstairs from the level map (<w>$cmd[CMD_DISPLAY_MAP]</w>) by pressing <w>></w>.\nThe cursor will jump to the nearest staircase, and by pressing <w>.</w> or\n<w>Enter</w> your character can move there, too. Each level of Crawl has three\n<console>white </console>up and three <console>white </console>down stairs.\nUnexplored parts can often be accessed via another level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_auto_exclusion"
msgid "To prevent autotravel or autoexplore taking you into dangerous territory, you\ncan set travel exclusions by entering the map view (<w>$cmd[CMD_DISPLAY_MAP]</w>)\nand then toggling the exclusion radius on the monster position with <w>e</w>.\nTo make this easier, some immobile monsters listed in the <w>auto_exclude</w>\noption (such as this one) are considered dangerous enough to warrant an\nautomatic setting of an exclusion. It will be automatically cleared if you\nmanage to kill the monster. You could also manually remove the exclusion with\n<w>$cmd[CMD_DISPLAY_MAP]ee</w> but unless you remove this monster from the\nauto_exclude list, the exclusion will be reset the next turn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_healing_potions"
msgid "Your health is getting dangerously low. Retreating and/or quaffing a potion of\nheal wounds or curing might be a good idea.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_need_healing"
msgid "If you're low on health or magic and there's no urgent need to move, you can\nrest for a bit. Ideally, you should retreat to an area you've already explored\nand cleared of monsters before resting, since resting on the edge of the\nexplored terrain increases the risk of rest being interrupted by a wandering\nmonster. Press <w>$cmd[CMD_REST]</w> or <w>shift-numpad-5</w>\n<localtiles>, or click on the 'rest' button,</localtiles> to do so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_need_poison_healing"
msgid "You are lethally poisoned, so now would be a good time to\n<w>$cmd[CMD_QUAFF]</w>uaff a potion of heal wounds or, better yet, a potion of\ncuring. If you have seen neither of these so far, try unknown potions in your\ninventory. Good luck!\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_on_fire"
msgid "You have been covered in sticky liquid flame. You can put this out more quickly\nby spending your turns moving, or put it out entirely by walking into a nearby\npool of water. Whatever covered you in liquid flames may light you further on\nfire while you run around, however.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_invisible_danger"
msgid "Fighting against a monster you cannot see is difficult. If you don't have a\nsource of see invisibility, you can find invisible monsters by luring them into\nshallow water, opaque clouds (from a scroll of fog), or a corridor, where their\nmovements will be more predictable. If things go south, try teleporting out, or\nleaving the level entirely!\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_need_healing_invis"
msgid "You recently noticed an invisible monster, so unless you killed it or left the\nscene, resting might not be safe. If you still need to replenish your health or\nmagic, you'll have to quaff an appropriate potion. For normal resting you will\nfirst have to get away from the danger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_can_berserk"
msgid "Against particularly difficult foes, you should use your Berserk\n<w>$cmd[CMD_USE_ABILITY]</w>bility. Killing monsters while berserking makes it\nlast longer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_postberserk"
msgid "Berserking is extremely exhausting! Afterwards you are slowed down, and you\nwon't be able to berserk again until enough time passes for your exhaustion to\nfade.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_run_away_1"
msgid "Whenever your health is very low and you're in danger of dying, check your\noptions carefully. Often, retreat or use of some item might be a viable\nalternative to fighting on.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_last_minute_berserk"
msgid "With Trog's support, you can use your Berserk ability\n(<w>$cmd[CMD_USE_ABILITY]</w>) to temporarily gain more health and greater\nstrength. Bear in mind that berserking at the last minute is often risky,\nand prevents you from using items to escape!\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_run_away_2"
msgid "If retreating to another level, keep in mind that monsters may follow you if\nthey're standing right next to you when you start climbing or descending the\nstairs. And even if you've managed to shake them off, they'll still be there\nwhen you come back, so you might want to use a different set of stairs when you\nreturn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_retreat_caster"
msgid "Without magical power you're unable to cast spells. While melee is a\npossibility, that's not where your strengths lie, so retreat (if possible) might\nbe the better option.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_advise_use_wand"
msgid "\\nOr you could e<w>$cmd[CMD_EVOKE]</w>oke a wand to harm or weaken your foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_you_mutated"
msgid "Mutations can be good or bad. Potions of mutation are the most common way to\nremove bad mutations, though they can also give you new ones. Check your\nmutations with <w>$cmd[CMD_DISPLAY_MUTATIONS]</w>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_new_ability_god_passive"
msgid "You just gained a divine ability. Press <w>$cmd[CMD_DISPLAY_RELIGION]</w>\n<localtiles> or press <w>Shift</w> and <w>right-click</w> on the player\ntile</localtiles> to take a look at your abilities.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_new_ability_god_active"
msgid "You just gained a divine ability. Press <w>$cmd[CMD_USE_ABILITY]</w> to take a\nlook at your abilities or to use one of them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_new_ability_item"
msgid "That item you just equipped granted you a new ability. Press\n<w>$cmd[CMD_USE_ABILITY]</w><localtiles> (or <w>click</w> in the <w>command\npanel</w>)</localtiles> to take a look at your abilities or to use one of them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_item_flight"
msgid "Flight will allow you to cross deep water or lava. Items that allow you to fly\nwill activate automatically when worn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_item_resistances"
msgid "Equipping this item affects your resistances. Check the overview screen\n(<w>$cmd[CMD_RESISTS_SCREEN]</w><localtiles> or click on the <w>character\noverview button</w> in the command panel</localtiles>) for details.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_god_displeased"
msgid "Uh-oh, $1 is growing displeased because your piety is running low. Possibly this\nis the case because you're committing heretical acts, because $1 finds your\nworship lacking, or a combination of the two. If your piety goes to zero, then\nyou'll be excommunicated. Better get cracking on raising your piety, and/or stop\nannoying your god. In any case, you'd better reread the religious description.\nTo do so, press <w>$cmd[CMD_DISPLAY_RELIGION]</w><localtiles> or press\n<w>Shift</w> and <w>right-click</w> on your avatar</localtiles>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_wield_weapon"
msgid "You can easily switch back to your weapon in slot a by\npressing <w>$cmd[CMD_WEAPON_SWAP]</w>. To change the slot of an item, press\n<w>$cmd[CMD_ADJUST_INVENTORY]i</w> and choose the appropriate slots.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_fleeing_monster"
msgid "Now that monster is scared of you! Note that you do not absolutely have to\nfollow it. Rather, you can let it run away. Sometimes, though, it can be useful\nto attack a fleeing creature by throwing something after it. If you have any\nstones in your <w>$cmd[CMD_DISPLAY_INVENTORY]</w>nventory, you can look at one\nof them to read an explanation of how to do this.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_monster_unusual"
msgid "That monster looks a bit unusual. You might wish to examine it a bit more\nclosely by <localtiles>hovering your mouse over its tile.</localtiles>\n<nomouse>pressing <w>$cmd[CMD_LOOK_AROUND]</w> and moving the cursor onto its\nsquare.</nomouse>\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_monster_friendly"
msgid "That monster is friendly to you and will attack your enemies. You can command\nyour allies by pressing <w>$cmd[CMD_SHOUT]</w>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_temporarily_friendly"
msgid "However, it is only <w>temporarily</w> friendly, and will become dangerous\nagain when this friendliness wears off.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_monster_shouted_unseen"
msgid "Uh-oh, some monster noticed you, either one that's around a corner or one that's\ninvisible. Plus, the noise it made will alert other monsters in the vicinity,\nwho will come to check out what the commotion was about.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_monster_shouted_seen"
msgid "Uh-oh, that monster noticed you! Plus, the noise it made will alert other\nmonsters in the vicinity, who will come to check out what the commotion\nwas about.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_monster_no_shout"
msgid "Uh-oh, that monster noticed you! Fortunately, it didn't make any noise, but many\nmonsters do make noise when they notice you. That will alert other monsters in\nthe area, who will come to check out what the commotion was about.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_monster_left_los"
msgid "$1 didn't vanish, but merely moved onto a square which you can't currently see.\nIt's still nearby, unless something happens to it in the short amount of time\nit's out of sight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_seen_zero_exp_mon"
msgid "That<console> $1</console> is $2. While <w>technically</w> a monster, it's\nmore like dungeon furniture, since it's harmless and doesn't move. If it's in\nyour way you can attack and kill it like other monsters, but you won't get any\nexperience for doing so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_abyss"
msgid "Uh-oh, you've wound up in the Abyss! The Abyss is a special place where you\ncannot remember or map where you've been; it is filled with nasty monsters, and\nyou're probably going to die.\n\nTo increase your chances of survival until you can find the exit<console> (a\nflickering <w>$1</w>)</console>, keep moving, don't fight any of the monsters,\nand don't chase after items on the ground. If monsters are closing in, try to\nuse items and abilities to get away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_spell_miscast_effects"
msgid "Miscasting a spell can have nasty consequences, particularly for the more\ndifficult spells. Your chance of successfully casting a spell increases with\nyour magic skills, and can also be improved with the help of some items. Use\nthe <w>$cmd[CMD_DISPLAY_SPELLS]</w> command<localtiles> or mouse over the spell\ntiles</localtiles> to check your current failure rates.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_you_miscast"
msgid "You just miscast a spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_miscast_armour"
msgid "Wearing heavy body armour or using a shield, especially a large one, can\nseverely hamper your spellcasting abilities. You can check the effect of this\nby comparing the failure rates on the <w>$cmd[CMD_CAST_SPELL]\\?</w> screen with\nand without the item being worn.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_miscast_contamination_and_mp"
msgid "If the spellcasting success chance is high (which can be checked by entering\n<w>$cmd[CMD_CAST_SPELL]\\?</w> or <w>$cmd[CMD_DISPLAY_SPELLS]</w>) then a miscast\nmerely means the spell is not working, along with a harmless side effect.\nHowever, for spells with a high failure rate, there's a chance of contaminating\nyourself with magical energy, plus a chance of an additional harmful side\neffect. Normally this isn't a problem, since magical contamination bleeds off\nover time, but if you're repeatedly contaminated in a short amount of time\nyou'll mutate or suffer from other ill side effects.\n\nNote that a miscast spell will still consume the full amount of MP that a\nsuccessfully cast spell would.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_glowing"
msgid "You've accumulated so much magical contamination that you're glowing! You\nusually acquire magical contamination from using some powerful magics, like\ninvisibility, or from miscasting spells.\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_contamination_mild"
msgid "As long as the status only shows in grey nothing will actually happen as a\nresult of it, but as you continue suffusing yourself with magical contamination\nyou'll eventually start glowing for real, which can have nasty effects, such as\nmutating you or dealing direct damage. In addition, glowing is going to make you\nmuch more noticeable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_contamination_severe"
msgid "This normally isn't a problem as contamination slowly bleeds off on its own, but\nit seems that you've accumulated so much contamination over a short amount of\ntime that it can have nasty effects, such as mutating you or dealing direct\ndamage. In addition, glowing is going to make you much more noticeable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_you_resist"
msgid "Most attacks in Crawl are defended against by your AC. Some, like fire or\ndraining attacks, can be further reduced by specific resistances. Other magical\neffects, such as Slow or Confusion hexes, are resisted by your willpower.\nYou'll find items that increase both kinds of resistances.\n\nTo view your current set of resistances, <localtiles><w>right-click</w> on the\nplayer avatar, or </localtiles>press <w>$cmd[CMD_RESISTS_SCREEN]</w>.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_caught_in_net"
msgid "While you are held in a net, you cannot move around or engage monsters in\ncombat. Instead, any movement you take is counted as an attempt to struggle free\nfrom the net.\n{{\n    if crawl.hints_type() == \"magic\" then\n        return \"Note that casting spells is still very much possible, as is\"\n               .. \" using wands, scrolls and potions.\"\n    else\n        return \"Note that using wands, scrolls and potions is still very much\"\n               .. \" possible.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_you_silence"
msgid "While you are silenced, you cannot cast spells, read scrolls or use divine\ninvocations. The same is true for any monster within the effect radius. The\nfield of silence (recognizable by <tiles>the special-looking frame tiles</tiles>\n<console>different-coloured floor squares</console>) is always centered on you\nand will move along with you. The radius will gradually shrink, eventually\nmaking you the only one affected, before the effect fades entirely.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_autopickup_thrown"
msgid "When stepping on items you've thrown, they will be picked up automatically.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_gained_spellcasting"
msgid "As your Spellcasting skill increases, you will be able to memorise more spells,\nand will have somewhat more MP. You'll also beomce lsightly better at casting\nall kinds of spells.\n\nPress <w>$cmd[CMD_DISPLAY_SKILLS]</w> <localtiles>(or click on the <w>skill\nbutton </w>in the command panel)</localtiles>to have a look at your skills and\nmanage their training.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_fumbling_shallow_water"
msgid "Fighting in shallow water will sometimes cause you to slip and fumble your\nattack. If possible, try to fight on firm ground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_cloud_warning"
msgid "Rather than step into this cloud and hurt yourself, you should either wait for a\nfew turns to see if it vanishes (with <w>$cmd[CMD_WAIT]</w>), or just step\naround it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/hints.txt
msgctxt "textdb:descript/hints.txt:hint_found_unknown"
msgid "You've found something new (but I don't know what)!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:__(_suffix_examine"
msgid "It has been enchanted to dance through the air and attack under its own power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:agnes"
msgid "This spriggan is aged and weathered from years of travel away from the forests\nand swamps that are home to her kin. Her choice of weapon and astonishing speed\nboth speak to the training she underwent. Underestimate her at your peril!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:aizul"
msgid "Once the primary guardian serpent of a legendary treasure hoard, she was\ndisgraced after thieves looted it while she slept. She seeks to make up for her\nfailure by protecting the only treasure the villains overlooked, a single\nprecious talisman.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:amaemon"
msgid "Amaemon always knew he was different, but it was still a horrific surprise when\nhis demonic heritage manifested. As his body twisted, Amaemon was forced to flee\nfar from the surface. The passage of time has only left him more obsessed with\nwhat he has lost - consumed by poison both physical and spiritual.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:antaeus"
msgid "Once a hero among the titans, Antaeus grew jealous of the titan queen. In\nsingle combat he challenged and slew her, and for this crime he was exiled and\ndescended into the Hells. Finding the inhabitants of that place no match for his\nmight, Antaeus tore from its substance a fourth Hell, Cocytus, a realm born of\nfrozen spite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:arachne"
msgid "Once a talented human weaver, Arachne was transformed into a monstrous\nhalf-spider by a jealous rival's curse. Driven out of her village, she found\nsanctuary for a time among the jorogumo before a bitter feud forced her to\nflee once more.\n\nNow she wanders other corners of the dungeon with a small retinue of loyal\nstudents in tow, seeking a new domain in which they can spin their peerless\ntapestries in peace.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:asmodeus"
msgid "Greatest and most cunning of the Lords of Hell, Asmodeus was born when the twin\nfires of greed and treachery first sparked to life within a mortal's heart.\nHis hideous body is perpetually wreathed in flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:asterion"
msgid "Once a king infamous for waging bloodthirsty campaigns, Asterion was exiled to\nthe depths of the dungeon for his crimes. Here he lurks in his tattered finery,\ndreaming of a new kingdom. In his lust for power, the minotaur king turned to\nthe worship of Makhleb, and Makhleb has rewarded him with horrifying\ndestructive might.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:azrael"
msgid "A powerful, belligerent efreet. (Is there any other kind?)\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bai suzhen"
msgid "A weary draconian with foreign and watery scales. She has come to the Dungeon\nin hopes of resurrecting her mortal husband; a noble cause, for a being once\nknown for quarrelling with saints and flooding unfortunate temples. If pressed\nto her limits, she will reveal her true form, the mere sight of which struck\nher husband dead. Adventurers may wish they were so lucky!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:blorkula the orcula"
msgid "Once a gangly and bedraggled vampire with a strange obsession with colour,\nBlorkula was offered succour by a missionary of Beogh and became a portly and\nvigorous orc with a strange obsession with colour instead.\n\nHe wields magic tinged with every hue of the rainbow, and has mastered the art\nof dividing his own form among its many colours to avoid killing blows - though\neven he must rest a while before doing so a second time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:boris"
msgid "An ancient and powerful lich. Like all true liches, Boris is immortal, and will\nregenerate his desiccated skeletal remains even if completely disintegrated.\nThe same cannot be said for his many victims over his many centuries, from\nwhich he collects and channels their dying woes and regrets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cassandra"
msgid "As a young woman, Cassandra bound herself in service to Ashenzari and was\nblessed and cursed in equal measure - granted the ability to foresee disasters,\nbut only those she was powerless to prevent.\n\nEventually driven from her homeland as a harbinger of the very plagues she'd\nspent a lifetime warning against, she has come to the dungeon in her final days\nin hope of averting one last catastrophe.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cerebov"
msgid "A violent and wrathful demon, Cerebov appears as a giant humanoid covered in\nshining golden armour and wielding a huge twisted sword.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:chuck"
msgid "Chuck the stone giant loves rocks, the bigger the better! Over the years, he\nhas managed to amass quite the collection, including some rare, enchanted ones.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:crazy yiuf"
msgid "A withered old gnoll with a long silver beard, wielding a quarterstaff and\nwearing a cloak. He looks like a figure from mythology! Wait, is his beard held\non to his ears with hooks?\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dispater"
msgid "Greatest and most ruthless of the Lords of Hell, Dispater was born when first an\niron sword drank mortal blood. They despise mortal vanities, the pursuit of\n‘reason’ and ‘beauty’ - the only art they enjoy is the art of war.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dissolution"
msgid "The Pits of Slime used to be a thriving civilisation, and Dissolution was the\nprophet of their god. When the city was overtaken by its current residents,\nonly Dissolution survived, for they alone turned faithfully to the Slime God.\nDissolution became a tremendous mass of acidic ooze, yet retained their\nintelligence. They are filled with hatred for anything that can hold a form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:donald"
msgid "{{\n    local descript = \"An adventurer just like you, trying to find the Orb.\"\n\n    if you.race() ~= \"Merfolk\" and you.race() ~= \"Octopode\" then\n        descript = descript .. \" Unlike you, and d\"\n    else\n        descript = descript .. \" D\"\n    end\n\n    descript = descript .. \"espite his hatred of it, he takes to water \" ..\n                           \"like a fowl.\"\n\n    return descript\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dowan"
msgid "A beautiful but vain deep elf with an aptitude for magic and little else. His\nskills are the perfect complement of his twin sister Duvessa's fighting prowess.\nIn search of more powerful spells, he journeys to the surface with his sister.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:duvessa"
msgid "A plain-looking deep elven fighter who is technically brilliant in many forms of\ncombat, but over-confident because of it. She is complemented by the magical\nskills of her twin brother, Dowan. She journeys to the surface to challenge\nits greatest champions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:edmund"
msgid "A jealous sibling of Sigmund (indeed, the youngest of nine brothers). He has\nnone of Sigmund's skills in magic, but makes up for it with his skills in\nfighting and a canny head for money. He is eager to prove his superiority by\nkilling hapless adventurers with his expensive flail and quick wit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:enchantress"
msgid "First and most fearful of her kind, the Enchantress rules over the spriggans of\nthe dungeon. She wears an opalescent outfit made of dragon skin that shimmers\nwith many colours.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ereshkigal"
msgid "Greatest and most inexorable of the Lords of Hell, Ereshkigal was born when\nfirst a mortal breathed her last. Noiselessly she laughs at lives cut short and\nloved ones separated by untimely death, enwreathed in the silence of the grave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:erica"
msgid "A wild-tempered adventuress. She's quite prideful for an octopode, and brandishes\ntheir venomous capacity and camouflage talents with cruel force.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:erolcha"
msgid "An especially cunning ogre-mage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eustachio"
msgid "An apprentice summoner with a flowing moustache. He has funny ideas about\nhonour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fannar"
msgid "A cold-hearted elven sorcerer, draped in robes of high office. They whisper\ngrimly to themself as they stalk the dungeon, trailing ice crystals through the\nair behind them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:frances"
msgid "A stout warrior who once bested a powerful lord of Pandemonium in combat,\ngaining control over the demon's realm and thanes. The battle left her with a\ndeep facial scar, one that she carries as a badge of honour rather than a\nsymbol of shame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:frederick"
msgid "A svelte fighter-mage with a gold-rimmed monocle, a keen sense of tradition,\nand the blood of the gods running through his veins. He's here looking for a\nworthy opponent, but he's yet to find one.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:gastronok"
msgid "A voracious and surprisingly intelligent slug, devoted to eating everything and\neveryone he comes across, with a pointed hat perched rakishly atop his head. He\nacquired the hat the same way he acquired his intelligence and his knowledge of\nspells: by consuming their former owner, a powerful wizard.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:geryon"
msgid "A huge, three-headed, winged arch-demon, guardian of the four Hells. Legends\nsay that his silver horn can summon terrible beasts to aid him in battle.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:gloorx vloq"
msgid "A shadowy figure clothed in profound darkness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:grinder"
msgid "An inefficient shadow imp previously employed as a torturer in one of the lower\ncircles of Hell. She has a tendency to complain and make inane statements.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:grum"
msgid "A tough-looking gnoll, wearing the pelt of one of his former war dogs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:grunn"
msgid "A brutally twisted undead gnoll in the eternal service of Ereshkigal, lord of\nTartarus. Legend has it that he sold his soul to return his most beloved hunting\ndog to life. Whether that hound is a member of his current pack, none can say.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:harold"
msgid "A middle-aged bounty hunter, anxious to retire after one final job. He hopes to\nsettle down somewhere and live a quiet life with his family, using the money\nfrom his final bounty: you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ignacio"
msgid "While a mortal cannot turn into a demon aside from divine intervention, this is\nwhat happened to Ignacio after Makhleb saw his love for his job and smiled upon\nhim. He is now slated to continue the joy of his life for all eternity.\n\nAlthough his new form includes a number of large razor-sharp blades growing\nfrom his demonic appendages, he kept his favourite axe and is eager to let you\ntest its edge.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ijyb"
msgid "A small and shrewd goblin inventor, wearing blue rags coated in soot.\nShe claims dominion over this level of the dungeon; trespassers will find\nthemselves on the business end of a homemade wand.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ilsuiw"
msgid "A deadly merfolk water-witch, who uses her dominion over the tides to draw\nunwitting adventurers to their deaths.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jeremiah"
msgid "Jeremiah was a peaceful dreamer, prone to impromptu naps. They slipped into\nslumber while gazing into a magical orb, and dreamed of an old and hateful\npower binding them into service. Now Jeremiah stumbles through the dungeon,\nsearching for the precious dreamshard that will restore their master’s power,\nunsure whether they wake or slumber still. Their dreams leak into reality in\nthe form of a constant stream of butterflies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jessica"
msgid "An evil apprentice sorceress. She entered the dungeon hoping to find a quiet,\nsecluded place where she could study the darker arts without being disturbed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jorgrun"
msgid "A dwarven magician, particularly well-attuned to the dungeon around him. He\nwields powerful earth magic in combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jory"
msgid "Once a simple village peasant, Jory found himself transformed in undeath into a\npowerful creature. Through the countless centuries unlived since then, he has\nhoned his skills in combat and magic, and amassed great wealth and many\npossessions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:joseph"
msgid "Looks like a mercenary in a stupid-looking hat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:josephina"
msgid "A fearsome necromancer who followed her craft beyond the limits of flesh and\nlife. Her pursuit of demonic knowledge left her body ruined, but the powers she\ngained allowed her to rebuild her missing limbs from glittering ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:josephine"
msgid "A formidable necromancer, committed to her craft even after it left her aged,\ndecaying, and half-undead herself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:khufu"
msgid "An incredibly powerful emperor on the way to godhood. He died quite some time\nago, but he sees no reason why that should stop him.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kirke"
msgid "A master of transformation and treachery. Beware, or you may be the next swine\nto join her herd!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lernaean hydra"
msgid "A huge beast, mightiest of hydras, infamous in myth and legend. It flows\nthrough the water faster than a human can run, swatting aside trees as though\nthey were matchsticks. Its many heads slaver and gnash constantly as it hunts\nfor prey to slake its bottomless appetite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lodul"
msgid "An ogre emissary of the Ironbound Order, sent to find and stop intruders before\nthey enter the Vaults. Fiercely charismatic, he's rallied a small army of his\nkin, overawing them with the long-range lightning array he wears on his back.\n(The large coin purse he took from the Vaults is also quite persuasive.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lom lobon"
msgid "Stoic and inscrutable, Lom Lobon is an ancient demon infamous for their mastery\nof magic. Rumoured to be the most learned being in the halls of Pandemonium,\nthey are at times sought out by mortal wizards who offer their souls in\nexchange for the secrets of the arcane. Lacking the terrible wrath present in\nmost demons, Lom Lobon's single eye instead hides a cold, impartial cruelty.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:louise"
msgid "A mighty sorceress, clad from head to toe in heavy armour. Once an adventurer\nlooking for the fabled Orb of Zot, she was cast into the Abyss and got\nhopelessly lost there. Toyed with by some greater power, she was stuck on the\nhostile plane for nearly a decade. When she finally emerged from the Abyss,\nLouise had become powerful indeed, but had also gone fully insane. She now\nwanders the halls of the dungeon, seeking other adventurers to share her fate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mara"
msgid "This tall and powerful demon is Mara, Lord of Illusions, mighty among dreamers.\nHe is capable of creating intricately detailed illusions, so real that they are\nalmost as deadly as the creatures they impersonate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:maggie"
msgid "In a distant time, Maggie was apprenticed to the dreaded Hell Knights - but she\ngrew impatient. In search of a shortcut to fame and fortune (and somewhat short\non imagination), she entered the Dungeon and set out to slay a dragon. Now\nhaving slain one, Maggie sees no reason to stop.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:margery"
msgid "A lithe spellcaster in service to the powers of Hell; it is her duty to ensure\nthat the inhabitants of the Dungeon never forget their place. She personally\nslew the ancient dragon from whose hide her strange armour is crafted.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:maurice"
msgid "A sly, conniving thief. A self-proclaimed legend, he was one of the most skilled\nand crafty of the thieves and rogues lured by the Orb. The magical parasitic\nvines that have claimed his body still wish to continue his life's work, with a\nback-up plan of both a vicious magic-drinking maw and potent wands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:menkaure"
msgid "A fair and noble ruler of an ancient and mighty kingdom, mummified after an\nearly death. His faithful priests subsequently infused him with great and\npowerful magic, seeking to grant him eternal life. Now he is forgotten and\nreduced to mouldering bandages and dry, brittle bones.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mennas"
msgid "There was once a human priest named Mennas. He travelled far and wide as a\nmissionary of Zin, often venturing even into Orcish lands. He beseeched the orcs\nto abandon their false tribes and return to the peoples of their birth; only\nZin's light could truly cleanse the weight of sin that had twisted their bodies.\n\nBy all accounts the orcs were not happy with Mennas. Eventually, a group of them\ndemanded he recant his words and when Mennas remained silent, they cut out his\ntongue.\n\nWhether or not this angel is that same Mennas is something of a mystery, as he\nseems to have difficulty speaking.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mlioglotl"
msgid "A demon prince once possessed a hunger for power that was exceptional even by\nthe standards of his kind. He betrayed his realm to Lugonu, and his reward was\nto become this twisted mass of corruption, now known only as Mlioglotl.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mnoleg"
msgid "A weirdly glowing figure, dancing through the twisted air of Pandemonium.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:murray"
msgid "A demonic skull rolling along the ground.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:natasha"
msgid "A fast-moving magical cat. Once a powerful wizard's familiar, Natasha was\nabandoned after her master was consumed by the very necromantic forces he sought\nto control. Now she patrols the dungeon, taking a bloody vengeance with spell\nand claw upon any adventurer who crosses her path.\n\nThis cat doesn't have nine lives, but just one death isn't going to be enough\nto put her down for good.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nellie"
msgid "A highly intelligent elephant who travelled as part of a circus. One dark\nnight, she slipped out of her chain and disappeared into Pandemonium, never to\nbe seen again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nergalle"
msgid "A shrewd and wizened orc who has devoted her life to chronicling the bloody\nhistory of her people. She claims to know the names and deeds of every last orc\nwho lost their life in their great exodus into the Dungeon, and even if this is\na lie, she nonetheless seems to be on a first-name basis with many of them.\n\nMore than any other orc still breathing, she knows the blood and sacrifice it\ntook to make this place a refuge for her kind. She will not brook it being\nintruded upon by anyone - least of all you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nessos"
msgid "A centaur warrior, skilled at warfare and deceit. They slew a mighty hydra, and\nnow its deadly blood drips, still-fuming, from their arrows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nikola"
msgid "A brilliant scientist obsessed with electricity. In his attempts to perfect his\nelectric golem, he was involved in a terrible accident, and now phases in and\nout of reality.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nobody"
msgid "A time-lost revenant, risen not from the death of a single individual but of\nmany - its bones fused together from the young and the elderly and different\nspecies altogether. Whether they were all the victims of a single massacre or\na thousand souls discarded over a thousand years is impossible to say now;\nhistory does not remember them.\n\nBut one thing is clear: they will fight to change that until every last memory\nthey have left burns away.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:norris"
msgid "A relaxed water cultist with a healthy tan and a soothing voice. He\ndoesn't really care if it is you or he who dies — “both” would probably be the\nbest option.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pargi"
msgid "An unusually weak troll.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:parghit"
msgid "An unusually strong troll, his thick frame scarred by many against-the-odds\nvictories. He has been wounded so many times that his body has adapted, and now\nheals almost instantly. His necklace of troll claws is a memento of those who\nunderestimated him.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pikel"
msgid "A wise kobold would fear the forces of Hell, and certainly would not set up a\nhighly lucrative transdimensional trade in damned souls. But Pikel is better\nknown for his whip than his wisdom, mercilessly tormenting his piteous charges\nas he ferries them to their buyers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:polyphemus"
msgid "A cyclops shepherd, he is very protective of his charges, whom he watches with\nan undying fervor through his single massive eye. Nevertheless, he won't\nhesitate to use them as projectiles in a pinch; after all, the best defence is\na good offence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:prince ribbit"
msgid "A frog of unusual size, with a tiny crown perched incongruously atop his head.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:robin"
msgid "A mountain hobgoblin, recently come in search of the legendary Orb. Not\nfoolhardy or reckless enough to delve into the depths of the Dungeon alone,\nRobin has built a small army of minions. Potential competitors will quickly\nfind a stream of screaming goblins flying toward them!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:roxanne"
msgid "A strikingly realistic sapphire statue of a famous earth mage who disappeared\nafter a catastrophic mishap with a magical talisman.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rupert"
msgid "Rippling muscles, glistening pecs, incredible glutes - Rupert is the peak of\nphysical perfection. Even so, his roars seem louder than even his fantastic form\ncan explain. Perhaps he holds some talisman that lends supernatural force to his\nbellows?\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:saint roka"
msgid "A mighty warlord. Some orcs even say they are the Chosen One of Beogh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sigmund"
msgid "The elder of a pair of brothers who came for the Orb. No one knows what Sigmund\nsaw in the dungeon to drive him mad, but his shrewd magical tactics and wicked\nscythe now leave little time for his victims to wonder. Despite his reputation\nas a vicious murderer, his grandiose and dramatic ways have earned him the\nadmiration of many denizens of the dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:snorg"
msgid "A particularly corpulent troll with a short temper and a sizable gut.\nUninterested in the Orb, Snorg delights in the endless parade of adventurers –\nthat is, easy meals — it attracts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sprozz"
msgid "A former beekeeper's apprentice with an ambitious dream: to modernise the whole\nworld's beekeeping industry with the smooth certainty of disease-proof metal.\nHis methods may be questionable and his goals dubious, but his prototype's\nstinger still looks awfully sharp...\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sojobo"
msgid "Queen of the tengu, with legendary skill in swordsmanship, tactics, and magic.\nStorytellers claim she once trapped a raging tempest in a bottle and kept it\nas a talisman.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sonja"
msgid "A graceful kobold assassin. Admire her graceful pirouettes, thrill at her\ndaring leaps! But watch out for her knives!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:terence"
msgid "A veteran of a war against the armataurs' elephant-riders. He has recently\nretired to make a new home in the dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tiamat"
msgid "The earthly avatar of Tiamat, deity of dragonkind, here incarnated as a mighty\ndraconian warrior. Her scales seem to shimmer and change colour as you watch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:urug"
msgid "A coarse and lanky orc. Urug lost her eye in a fight with a harpy, and has\nsworn to slay every last one of them. Unfortunately, the vision in her\nremaining eye is not very good, and she has mistaken you for one.\n{{\n    if you.can_smell() then\n        return \"She smells terrible.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wiglaf"
msgid "A cantankerous dwarf wearing a stupid-looking hat. He eyes you sourly, as if\ndeciding exactly how much offence he should take to the way you're staring at\nit.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vashnia"
msgid "An elite marksnaga who leads a skilled team of sharpshooters. She is\nparticularly skilled in translocation magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vv"
msgid "One of the Stoneborn, formed untold aeons ago with supreme command over rock.\nHer people shelter deep within the living earth, so whatever has forced Vv\ninto the oppressive openness of the Dungeon must be dire indeed. But whatever\nit is, she's not talking...\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:xak'krixis"
msgid "It has been centuries since outsiders were last allowed access to the cavernous\nlibraries of the formicids, but their emissaries are still seen from time to\ntime - surveying other lands for resources or scientific discoveries that might\naid the colony.\n\nThis one's study of the magical fibres excreted by orb spiders has already led\nto an alchemical breakthrough, allowing them to shape fulminant prisms such that\ntheir explosions are directed at enemies alone. Alas, their enthusiasm to\nconduct a field test bodes poorly for your health.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:xtahua"
msgid "An ancient and mighty dragon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:zenata"
msgid "A master weaponsmith, her flesh melding into steel so smoothly that it's hard to\ntell where one ends and the other begins. She entered the Dungeon to search for\nthe secrets of an ancient, long-suppressed cult, said to have exalted metal over\nflesh. The price of knowledge was her humanity - a price she paid eagerly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:serpent of hell gehenna"
msgid "A huge, red-glowing, three-headed dragon, shrouded in damnation. It is\npossessed by the very essence of Gehenna and its eternal fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:serpent of hell cocytus"
msgid "A massive white three-headed dragon, covered with shards of gleaming ice,\nwholly possessed by the nightmarish cold of Cocytus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:serpent of hell dis"
msgid "A towering three-headed beast with an army's worth of swords for teeth. Each of\nits scales is a shield with a razored edge.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:serpent of hell tartarus"
msgid "Seemingly three pairs of lurid magenta eyes hanging in the darkness, the\noutline of a vast, sinuous dragon is just barely perceptible behind. Its malice\nis palpable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:acid blob"
msgid "A lump of sickly pustulent flesh, dripping with lethal acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:acid dragon"
msgid "A small dragon with brilliant yellow scales, its mouth dripping with\ncorrosive slime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:adder"
msgid "A common dungeon snake, a species of troglodytic reptile commonly found in\nsubterranean spaces.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:air elemental"
msgid "A spirit drawn from the elemental plane of air. It exists in this world as a\nlightning-spitting spirit, stunning foes with its crackling bursts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:alderking"
msgid "A self-styled monarch of a shambling black alder, half respected and half\nridiculed by other fae. It backs up its aspirations to sovereignty with\nunearthly vile magic quite close to a touch of death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:alligator"
msgid "An aggressive crocodilian with great crunching jaws full of sharp teeth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:alligator snapping turtle"
msgid "A particularly large and nasty snapping turtle. Like its smaller relative, it\ncan reach out and bite from afar.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:anaconda"
msgid "A very large snake that moves with startling swiftness. It kills not by poison\nbut by constricting its prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ancestor"
msgid "A humanoid construct of insubstantial memory, floating through the air. Though\nperhaps somewhat changed in shape and bearing few discernable features, still\nthey seem somehow to resemble a warrior from the distantly remembered past.\nThe memory and the memorialist fight in concert, each able to fire past the\nother.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ancient champion"
msgid "An unfathomably ancient skeleton. It has hundreds of golden sigils etched onto\nits bones, and pulses with terrible, unholy power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ancient lich"
msgid "A lich who, having existed for countless centuries, has grown almost\nunimaginably powerful through the study of dark magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ancient zyme"
msgid "A nexus of sentient cancer and disease, borne aloft perhaps by malice alone.\nIts nature inflicts withering illness on all living beings in its presence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:angel"
msgid "A divine warrior of the Shining One. It is a towering winged figure of\nunnatural beauty surrounded by an aura of brilliant white light.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:apis"
msgid "A placid, sacred bull of Elyvilon. Its status as an exalted envoy of the Healer\nlets its very presence double the health of its allies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:apocalypse crab"
msgid "An opalescent crab with jet black eyes, and chaotic mists effusing from its\nmandibles. Rumours claim that this species is waiting for the end of time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:arcanist"
msgid "A wizard fond of spectacle and destruction. They scorn the cowardice of other\nmagicians, who hide from their foes rather than simply blasting them out of\nexistence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:armataur"
msgid "A curious quadraped, resembling a cross between an armadillo and a yaktaur.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:armour echo"
msgid "The sweat and toil of the armourer working leather and steel infuses an\nintention into their creation, a unique spark within every cuirass, pauldron and\nvambrace. A skilled forgewright can manifest these intentions in physical form,\nallowing their armour to protect its wearer in a more aggressive fashion than\narmour customarily does.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:aspiring flesh"
msgid "The divided and churning remains of a protean progenitor, striving desperately\nfor form. Whatever they become, the last of their progenitor's power ensure it\nwill be stronger and swifter than any such creature found elsewhere in the\ndungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:azure jelly"
msgid "An extremely cold blob of bright blue cytoplasm, forming bits of frost in the\nair around it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ball lightning"
msgid "A swift sphere of coruscating electrical energy. It will explode at the\nslightest disturbance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ball python"
msgid "A small snake that can augment its bite by constricting small creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ballistomycete"
msgid "A lumpy reddish fungus covered in knobbly rhizome growths, growing well in the\ndank underground dungeon. When it senses a threat, the ballistomycete may\nrelease a deadly floating spore that explodes on its victims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ballistomycete spore"
msgid "A fast, gas-filled floating spore released by a ballistomycete when it senses a\nthreat. After seeking out its foe, the spore will explode, damaging anything\ncaught in the blast and further confusing living creatures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:balrug"
msgid "A huge and very powerful demon, wreathed in fire and shadows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:barachi"
msgid "An amphibious humanoid with a very ugly attitude.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:basilisk"
msgid "A crested lizard of middling size with a terrible petrifying gaze.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bat"
msgid "A large grey bat that, despite being herbivorous, is quite aggressive. It is\nmyopic and uses echolocation to navigate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:battlemage"
msgid "A humanoid construct of insubstantial memory, floating through the air. Though\nperhaps somewhat changed in shape and bearing few discernable features, still\nit seems somehow to resemble a warrior from the distantly remembered past,\nskilled with both conjurations and melee combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:battlesphere"
msgid "A small globe of destructive energy. Each time its creator casts an offensive\nspell, it will launch a magical barrage at the most injured nearby foe it can\nreach.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bennu"
msgid "A sacred, self-created sunbird, representative of rebirth. It has ascended\npast the cycles of life and death, and calls upon aspects of both, rising forth\nfrom death in a burst of unholy flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bes kemwar"
msgid "A minor hairy maggot spirit, phasing in and out of this plane. Each regional\nvariant inflicts different minor ailments: the ones found in the Dungeon\ncause one's magic to grow weak.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:black bear"
msgid "A small black bear. Like all ursines, it will become enraged if badly hurt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:black draconian"
msgid "A muscular black-scaled humanoid with a reptilian tail and powerful wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:black mamba"
msgid "An astonishingly fast tropical snake whose bite bears a deadly venom.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:blazeheart core"
msgid "The exposed elemental core of a blazeheart golem. Far too unstable to remain\nwithout its shell, it is in the process of violently exploding.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:blazeheart golem"
msgid "A volatile elemental spark encased in a shell of slag iron. If destroyed while\nits fires still blaze, the exposed core will violently detonate a moment later.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:blink frog"
msgid "A species of frog that possesses the ability to blink at will. It can blink\nitself close to its intended prey, or blink away to escape harm. It is commonly\nfound in packs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:blizzard demon"
msgid "A greater demon formed from wistful snow and bitter lightning.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bloated husk"
msgid "A decaying undead corpse. When it reaches a victim (or if it's destroyed first),\nthe gases trapped inside it are released and create a large, violent\nconcussive blast.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:block of ice"
msgid "A block of ice shaped like a statue, but worked by no living hands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bog body"
msgid "An undead figure preserved by the brackish waters of a bog, and reanimated by\nsome unknown magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:boggart"
msgid "A malevolent and dangerous little sprite. The shadowy illusions it summons may\nnot be real, but are deadly all the same.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bombardier beetle"
msgid "An unassuming beetle filled with an incredible amount of hypergolic fluid. The\nsticky spray it fires is capable of igniting predators and unwary adventurers\nalike, though more experienced ones know to keep moving if they wish to avoid\na fiery grave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bomblet"
msgid "A small metal sphere surrounding a core of dormant fire magic. When given the\nproper command, it will detonate in a blast of metal and flame that is only\npartially affected by fire resistance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bone dragon"
msgid "A mighty undead abomination, pieced together from the broken bones of many\ndragons by powerful necromantic magic. The collective despair of such\ndesecrated dragons gives this horror its own undying breath weapon, in\nbillowing clouds of excruciating misery.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:boulder"
msgid "A mass of fast-rolling stone, crushing everything in its path.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:boulder beetle"
msgid "A grey beetle with an almost impenetrable rocky carapace. When at some distance\nfrom its foe, a boulder beetle is capable of rolling at high speed, attempting\nto crash into its target for heavy damage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bound soul"
msgid "The soul of a living, holy, or demonic creature, captured by a dark sacrifice\nto Yredelemnul. The bound soul will follow its captor through stairs and come\nwhen recalled from a different level.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:boundless tesseract"
msgid "An impossible shape that scintillates with unearthly colour. The power of Zot\nflows heavily through it, overlaying this reality with countless others where\nits domain remains pristine.\n\nEach tesseract is inextricably linked to the other, and destroying one will\ndestroy both (and expel all the creatures they have beckoned to this reality,\nas well as dazing even those which they have not). But so long as they are\nallowed to exist, there will be no end to the forces which seek to keep you from\nthe Orb.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:brain worm"
msgid "A slimy fluorescent worm with a greatly distended head. This creature feeds on\nothers' intellect as it squirms through unworldly grime.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:briar patch"
msgid "A tangled cluster of thorny briars, sharp enough to pierce thick hide and\narmour. Although stationary, its branches are possessed with a will of their\nown. They move to allow magic and missiles fired by those friendly to this\nplant to pass through unaffected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:brimstone fiend"
msgid "A huge and powerful demon wreathed in damnation, with great scaly wings. It is\none of the most fearsome denizens of any of the Hells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:broodmother"
msgid "A giant spider swollen with eggs. Its innumerable offspring are always at its\ncall.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:burial acolyte"
msgid "A masked priest in the service of Kikubaaqudgha, well-versed in choral rituals\nto both rouse the dead and send them to eternal rest.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:burstshroom"
msgid "A rapidly-growing mushroom whose life-cycle culminates in an explosive release\nof spores. These spores have a mild psychoactive effect and can sometimes daze\ncreatures who breathe them in.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bush"
msgid "A woody plant. It looks dry enough to be easily set on fire, and its foliage is\nnot very dense, permitting both magic and missiles to pass through unaffected.\nHowever, it is firmly rooted, and requires significant effort to destroy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bullfrog"
msgid "An unusually aggressive amphibian that pursues its prey with rapid hops.\nIts croak is loud and distinctive, but unlike its smaller counterparts above\nground, the dungeon bullfrog is as large as it sounds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bunyip"
msgid "A flesh-eating beast that uses its limbs and tail interchangeably. It moves\nwith alarming speed, but must pause to reorganise itself after each attack.\nIts distinctive screams carry far and wide.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:butterfly"
msgid "A large, brightly coloured butterfly with beautifully patterned wings,\nfluttering incongruously through the darkness of the cave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cactus giant"
msgid "A green-skinned, spiny colossus, with a hearty barrel chest and a thirst for\nbattle. Any foe that strikes it in melee will be lucky to live to regret it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cacodemon"
msgid "A maniacal demon, brimming with accursed power. Its gleeful laughter rarely\nceases, even in the heat of battle.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cane toad"
msgid "A hideous toad whose thick, warty hide is covered in poison glands. Unlike its\nsmaller above-ground relatives, this dungeon-dweller is the size of a wolf.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:catoblepas"
msgid "A sluggish black buffalo, its hide encrusted with dull scales. It carries its\nhog-like head just above the ground, protected by a stiff mane of bristles.\nIts fearsome breath turns flesh into stone.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:caustic shrike"
msgid "A swift, nightmarish bird whose razor-sharp metallic feathers drip with\ncorrosive acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:caustic sporangium"
msgid "A balloon-like sac of slime mold spores, suspended in a nutrient slurry to\nsustain them on their search for a new home. To the great misfortune of any\nadventurers in the vicinity, this slurry is also a highly potent acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:centaur"
msgid "A hybrid with the torso of a human atop the body of a horse. It is highly\nskilled in archery.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:centaur warrior"
msgid "A muscular centaur, veteran of numerous battles, armed with well-made weapons\nand able to use them skilfully.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cerulean imp"
msgid "A small, wilful minor demon. Its wings, far larger than its scrawny body, were\nmade to soar, and it lands only rarely and with the greatest reluctance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:chaos spawn"
msgid "A being of pure chaos, its form is constantly shifting, growing and then losing\neyes, mouths, claws and tentacles. It corrupts everything it touches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cherub"
msgid "A throne-bearer of the gods, whose head is beset by four faces: one of a man,\none of an ox, one of a lion, one of an eagle. It is one of the angelic beings\nwho stand before the good gods, singing eternal hymns of praise to their glory\nand greatness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:chonchon"
msgid "Some sorcerers care little for unholy realms or undead forms, seeking power\ninstead in the whims of cruel chaos. This ominous owl-winged head is all that\nremains of a former archmage: it delights in spreading misfortune and drinking\nblood in its new airborne form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:clockroach"
msgid "A common dungeon pest that combines the worst features of a scavenging insect\nand a looming deadline.\n\nTime flows strangely around it, rewinding any injuries inflicted upon it unless\nthe source of them is near enough to be caught up in its timestream.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cognitogaunt"
msgid "A wizened, headless corpse, animated not by conventional necromancy but by the\nmournful malice of dead stars. Its psychic eyes, floating disjointedly from its\nbody's movements, relentlessly burrow through its victims' minds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:clockwork bee"
msgid "A mechanical insect powered by an intricate array of gears and springs. It is\nvicious and resilient to damage, but its clockwork naturally winds down as it\nattacks, eventually leaving it unable to move until its creator winds it again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:colossal amoeba"
msgid "An unfathomably massive pile of mystic pulsating protoplasm. The slightest\nthreat will cause it to undergo rapid weaponised mitosis, rapidly overwhelming\npotential meals in a cytoplasmic tidal wave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:crawling flesh cage"
msgid "A modern breakthrough in arcane experimentation, this mobile prison cell\nweaponises the living fragments of once-escaped ugly things, extending the reach\nof their tendrils to thrash multiple foes at once from a distance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:creeping inferno"
msgid "A formless mass of ancient fire, bound by heat and malevolence. It longs to\nunleash itself as a wild fire storm, yet must first patiently burn towards its\nvictims with implaceable inevitability.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:creeping plasmodium"
msgid "An enormous and unnervingly motile slime mold colony. It creeps along the\ncrevices of the walls in search of nutrients and can spread itself to new\nlocations by launching enormous sporangia.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:crimson imp"
msgid "A small, ugly minor demon. Its fanged maw seems locked in a permanent malign\ngrin, and its horns protrude obscenely from its scaly pate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:crocodile"
msgid "A crocodilian with powerful jaws.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:crystal echidna"
msgid "A spiny, long snouted rodent grown out of pure living crystal. It is\nimmune to most forms of magic and hurls both crystallising shots and painful\nbarbs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:crystal guardian"
msgid "An intricate animated statue made of heavily ensorcelled crystal that is\nimmune to most forms of magic. The spells which created it are so powerful\nthat even flesh may start to crystallise around any fragments that become\nembedded in it - leaving its foes brittle and vulnerable.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:culicivora"
msgid "A small spider with rudimentary healing abilities. Though not undead, it packs\na nasty vampiric bite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:curse skull"
msgid "A charred skull floating in the air and rotating slowly. Mystic symbols are\ncarved into its blackened surface.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:curse toe"
msgid "A disembodied toe, hanging in the air and radiating an intense field of\nnegative energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cyclops"
msgid "A giant with one eye in the centre of its forehead. Despite its lack of\nbinocular vision, it is able to throw boulders with fearsome accuracy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:daeva"
msgid "A towering winged figure radiating an aura of brilliant golden light. It is a\ndivine agent of the Shining One.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dancing weapon"
msgid "A weapon enchanted to dance through the air and attack under its own power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dart slug"
msgid "A small invertebrate. It hunts prey considerably larger than itself by firing\nchitinous darts, using a concealed air bladder to launch them with remarkable\nrange and power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deathcap"
msgid "A noxious and deadly fungus suffused with negative energy. While parasitic in\nlife, undeath has granted it the ability to absorb its nutrients directly from\nthe life force of others.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:death cob"
msgid "A dreadful undead cob of maize. Look, this one was probably a mistake. We're\nsorry.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:death drake"
msgid "A dark and baleful minor dragon. It breathes a lethally potent miasma from its\npestilential maw.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:death knight"
msgid "A warrior-priest of Yredelemnul, chanting fearful supplications to its dark god.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:death scarab"
msgid "A hideous swarming undead insect, exuding death and decay and feeding on the\nlife energies of those unfortunate enough to encounter it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:death yak"
msgid "A larger and beefier relative of the common dungeon yak. Its little red eyes\ngleam with hunger for living flesh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf annihilator"
msgid "A deep elf who exults in conjured mayhem and destruction. It is widely hated\nand feared, both for the power and for the precision of its destructive magics.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf archer"
msgid "An experienced deep elf fighter with a penchant for ranged combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf blademaster"
msgid "A champion of the deep elves, who scorns magic and is devoted to the study of\nthe sword. It wields two weapons with astonishing dexterity and speed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf death mage"
msgid "A deep elf surrounded by a shimmering aura of negative energy, as a result of\nits practice of necromancy and life-sapping magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf demonologist"
msgid "A deep elf who is marked heavily by long years of contact with unnatural\ndemonic forces and the creatures of the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf elementalist"
msgid "A deep elf commanding the primal forces of the universe. It is renowned for its\nability to pin down even the most elusive foes with powerful, unavoidable magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf high priest"
msgid "An exalted servant of the ancient dark god of the deep elves, basking in\nhellish death magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf knight"
msgid "A battle-hardened deep elf fighter.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf master archer"
msgid "A deep elf archer who has devoted a lifetime to the mastery of archery,\ndismissing magic as a frivolous distraction.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf pyromancer"
msgid "A deep elf learned in the ways of fiery magic. It is capable of casting a\nwide array of scorching spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf sorcerer"
msgid "A mighty spellcaster who draws power from the very Hells, and possesses lethal\narcane abilities.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep elf zephyrmancer"
msgid "An elf with a singular focus on the magic of the air, leaving little time to\nstudy anything else.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep troll"
msgid "A stooped troll with dark skin. It often travels in packs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep troll earth mage"
msgid "A particularly intelligent deep troll. It uses its magic to tunnel through the\nearth and ambush foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deep troll shaman"
msgid "A deep troll blessed with divine power to strengthen and hasten its kin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demigod"
msgid "A human-like figure with an aura of power betraying its divine ancestry.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonic crawler"
msgid "A hellish insectoid creature, fueled by some infernal power that constantly\nregrows its chitinous segments. Nothing short of a lethal blow will stop it\nfor long.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonspawn"
msgid "A half-mortal, half-demonic creature, with its hellish heritage asserting\nitself through a certain devilish cast to its features.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonspawn blood saint"
msgid "A half-mortal, half-demonic creature, radiating an intense heat. It weaves\npowerful and unpredictable spells of devastation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonspawn corrupter"
msgid "A half-mortal, half-demonic creature, oozing with dark energies. It twists\nspace around itself, and can corrupt weapons, armour and even the very flesh of\nits opponents.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonspawn soul scholar"
msgid "A half-mortal, half-demonic creature, covered in icy blue scales. Its devotion\nto the deities of death grants it great insight into the vulnerabilities and\napplications of mortal souls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonspawn warmonger"
msgid "A half-mortal, half-demonic creature, now more beast than whatever species it\nis descended from. It is devoted to martial combat, disrupting the magic of its\nfoes as it feasts off of endless conflict.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:diamond sawblade"
msgid "A serrated disc forged of razor-sharp material. It spins in place at high\nvelocity, shredding through flesh and metal alike.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:diamond obelisk"
msgid "A towering obelisk surrounded by a powerful storm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dire elephant"
msgid "A huge pachyderm, wilder and fiercer than normal elephants, with a very thick\nhide, powerful legs, and a memory to die for.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:djinni"
msgid "An elemental spirit formed from smokeless fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oblivion hound"
msgid "A demon lapdog of the queen of Tartarus, bound to hunt her enemies. The first\ntime a foe hears its howl, it will echo in their mind, calling nightmarish\ncreatures to hunt them. Those who survive have the small consolation of being\ninoculated against that particular hound's howl.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dormant clockwork bee"
msgid "A mechanical insect powered by an intricate array of gears and springs. It has\nrun out of power and can only be rewound by its creator moving into it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian"
msgid "A brown-scaled humanoid with a reptilian tail and small wings. It is yet to\ndevelop the distinct colouring and powerful breath attack of its mature form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian annihilator"
msgid "A draconian that uses powerful conjurations to destroy anyone who dares to\nstand in its way.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian knight"
msgid "A draconian protected by thick scales, skilful weapon use, and complementary\nmagic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian monk"
msgid "A draconian who has eschewed the study of weaponry and magic in order to train\nin the art of unarmed combat. Its scaly fists, well-thewed legs, and mighty\ntail rain down blows upon its opponents.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian scorcher"
msgid "A cunning draconian who has mastered the inner secrets of the element of fire.\nIts scales are sooty from years of magical pyrotechnics.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian shifter"
msgid "A draconian master of the warp, who can translocate both itself and anyone else\nto any place, either on this world or outside of it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draconian stormcaller"
msgid "A draconian deriving its thunderous powers and draconic allies from the worship\nof Qazlal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:draugr"
msgid "A territorial gnarl of driftwood and shattered bones. Its resentment of the\nliving has slowly twisted its remains into a monstrous form, capable of\nbrandishing weapons and spreading terrible curses.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dread lich"
msgid "A lich who has made terrible pacts with demonic forces to augment its dark\nmagic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dream sheep"
msgid "A drowsy, fluffy ovine whose coat sparkles with motes of dream dust. It gathers\nin herds and fills the air with dream dust, overwhelming its victims and\nputting them to sleep.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:drowned soul"
msgid "A cold and hollow apparition of the drowned dead, chained by some lingering\nattachment to the depths in which it perished. It rushes to embrace the living,\nsharing the last moments of its watery fate with whatever it touches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:drude"
msgid "A conniving demon born from the nightmares of sleeping mages. It delights in\ncoaxing the imagined fears of mortals into reality.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dryad"
msgid "A spirit of nature, bound to the forest in which it resides. It is capable of\ncalling upon the trees to defend against incursions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dwarf"
msgid "A member of a short, sturdy mountain-dwelling folk.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:earth elemental"
msgid "A spirit drawn from the elemental plane of earth. It exists in this world as a\nsinuous stream of silt and stone, capable of smoothly flowing through solid\nrock.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:efreet"
msgid "An imposing, muscular figure engulfed in a cloud of searing flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eidolon"
msgid "An ancient skeletal apparition, sheathed in a cloud of mist. Its form glows\nwhite-hot with debilitating energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eldritch tentacle"
msgid "An immense, squamous appendage of some unseen creature, dripping with ichor and\ntipped with a single, terrible-looking claw.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eldritch tentacle segment"
msgid "A part of an immense, squamous appendage. It thrashes and pulsates like no\nother living thing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:electric golem"
msgid "An animated figure made completely of electricity, created in some demented\nwizard's experiment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:electric eel"
msgid "A type of fish capable of generating a powerful electric field.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eleionoma"
msgid "Spirits of marshes and bogs. From the cypresses and willows of the fens stems the\npower of these fierce protective spirits. With the boughs and branches they flow,\nemerging from trees near their foes to strike.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:elemental wellspring"
msgid "A swirling conflux of elemental water streaming from the elemental plane into\nthis one, with powerful spirits and mighty floods flowing from it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:elephant"
msgid "A large, thick-hided pachyderm. It crushes its foes and then thrashes them with\nits trunk.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:elf"
msgid "An elf, a member of an ancient fey race.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:emperor scorpion"
msgid "A giant scorpion with a massive barb on its tail dripping deadly venom. It is\none of the largest arachnids known.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:endoplasm"
msgid "A glob of grey sludge that has somehow developed a rudimentary awareness and\nlimited motility. It periodically draws heat from its surroundings to sustain\nitself, freezing enemies unfortunate enough to be adjacent at the time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:entropy weaver"
msgid "A gaunt humanoid with flaking, pale chitin. Its spindly limbs are capable of\nstartlingly quick movement and end in razor-sharp talons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:erythrospite"
msgid "A churning mass of flowing blood that throbs to the beat of an absent heart.\n\nDoes it wish to bury itself in your arteries because it recognises, on some\nprimordial level, that this is where it belongs? Alas, all it is capable of in\nthis fleeing moment of sentience is violence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ettin"
msgid "A two-headed giant, stronger than most, and able to land devastating blows left\nand right with its two huge weapons.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:executioner"
msgid "A horribly powerful and swift demon, its shape obscured by a cloud of swirling\nscythe-like blades.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eye of devastation"
msgid "A huge eyeball, encased in a levitating globe of incandescent energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:eye of draining"
msgid "A hovering horror, rare and unnatural even amongst servitor eyes, radiating\nbaleful energies. They monitor the flow of chaotic life and ever-present death\nfor the divine Jiyva.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:faun"
msgid "A hybrid with the torso of a human atop the forelegs of a goat. It is fabled\nfor its ability to play with the minds of those who intrude into its domain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:felid"
msgid "A feline creature that has been granted sentience by magical means. It uses the\ngift of speech to demand milk, treats and catnip.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fenstrider witch"
msgid "Followers of the ancient swamp ways, these witches rise above the muck and mire\non a pair of stilt-like chicken legs. They are masters of pain and poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire bat"
msgid "A bat whose leathery body burns with a hot flame.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire crab"
msgid "A variety of crab prized for its brilliantly jewelled shell. The rarity of the\nshells is only enhanced by its almost supernatural ability to wade through\nmolten lava and expel massive quantities of flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire dragon"
msgid "A great reptilian beast with powerful claws on its limbs, covered in thick\nred scales and with two huge bat-like wings. Little trails of smoke spill\nfrom its toothy maw.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire elemental"
msgid "A spirit drawn from the elemental plane of fire, which exists in this world as\na brilliant column of raging flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire giant"
msgid "A giant with obsidian skin and a wild mane of glowing red hair, holding aloft a\nfiery sword. Fire giants believe that they are destined to unite and burn the\nentire world to cinders.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire vortex"
msgid "A swirling cloud of flame. After striking a foe, it disintegrates.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:flayed ghost"
msgid "A hideous floating undead creature, the anguished spirit of a tortured victim,\nwith torn skin hanging from an emaciated body. It restlessly stalks the\ndungeon, inflicting the anguish it felt in life upon those still living.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fravashi"
msgid "A beneficent remnant of the countless mortal knights who serve the Shining One.\nTheir hosts' role in the divine hierarchy is to guide and direct their legions\nin righteous moral warfare, though they may also call upon those mortals to\ndefend themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:frilled lizard"
msgid "A lizard with a giant and colourful fringe folded around its neck. It flares\nits impressive frill at its victims while hissing angrily.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:formicid"
msgid "A sentient ant that walks upright and is competent at digging.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:formless jellyfish"
msgid "A gelatinous assemblage of tentacles and venom, leaving a glistening trail\nas it slides along. Surely such a mockery of life could not be natural..?\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:foxfire"
msgid "A thin wisp of flaming swamp gas. It will burn the first hostile thing it\ntouches and then dissipate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:freezing wraith"
msgid "An incorporeal skeletal form surrounded by a cloud of freezing air, likely the\nremains of some unfortunate adventurer. It now floats slowly through the\ndungeon, seeking to share its fate with others.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:frost giant"
msgid "A giant with blue skin and hair like ice and snow. Its eyes are as bleak as\nwinter skies. It marches grimly into battle with a great, frosty axe and\nhowling blasts of cold.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fulminant prism"
msgid "A slender prism of unstable, soft gold that crackles with barely-contained\ndestructive energy. Any blow which cracks its fragile surface is likely to\nresult in a violent explosion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fungus"
msgid "A lumpy grey fungus, growing well in the dank underground dungeon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:gargoyle"
msgid "A granite statue of a hideous winged monster, somehow brought to life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ghost crab"
msgid "A crab twisted by proximity to negative energy. Apparitions of the dead swirl\naround it, only barely visible.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ghost moth"
msgid "A vile interdimensional predator that feeds on the life force of living beings.\nIt resembles an enormous, spiny moth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ghoul"
msgid "A decayed cadaver, reanimated and accursed with a terrible hunger. It desires\nnothing but to feed on the flesh of the living, and will fell its victims with\nits vicious claws.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:glass eye"
msgid "A floating eyeball formed from living glass. Only the divine Jiyva could form\nsuch a curious servitor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:glowing orange brain"
msgid "A huge pulsating brain, floating just off the floor and glowing with mutagenic\nenergies. It radiates a constant psychic influence upon nearby allies, using its\nvast intellect to empower their spellcasting abilities.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:glowing shapeshifter"
msgid "A shapeshifter which has lost control over its transformations, and is\nconstantly changing form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:gnoll"
msgid "A taller and better-equipped relative of goblins, and ally of orcs. It is\nsomewhat doglike in appearance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:gnoll bouda"
msgid "A gnoll witch possessed by a spirit of spite which flashes out from behind\ntheir eyes. Its strange chants and ululations send other gnolls into a wild\nfrenzy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:gnoll sergeant"
msgid "A commander of a pack of gnolls. Scars on its stout body give evidence of how\nit earned its rank.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:globe of annihilation"
msgid "A roiling sphere of intense destructive energies, drawn from the fabric of the\nHells themselves. It pursues a designated target inexorably, growing in size as\nit travels. If it collides with either a creature or wall, it will explode\nviolently - though its creator is protected from the wild destruction unleashed\nas it does so.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:goblin"
msgid "A short, impatient and unfriendly humanoid. Goblins first appeared only a few\nyears ago, but are now remarkably numerous. Sadly, no number of raucous goblin\nparties will put them in a welcoming mood toward adventurers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:goblin rider"
msgid "Goblin clans fractured over the advent of steel exoskeletons long ago, prompting\nan experimental arms race for goblin hegemony. Some volunteered to join forces\nwith other species, an alliance that has enabled capturing and taming wyverns.\nFrom uptop their majestic dragon-like mounts, these goblins swiftly soar about\nand skewer those who intrude upon their allies' domain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:golden dragon"
msgid "A great winged dragon covered in shining golden scales. Legends say that its\nblood runs both hot and cold, and is venomous to boot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:golden eye"
msgid "A tiny and shimmering floating eye, swift as the wind and glistening like gold.\nIt has a peculiarly hypnotic look.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:goliath frog"
msgid "A frog of exceptional size, for a frog. It lashes its prey with its tongue\nfrom a distance to coat them in its acidic stomach juices.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:great orb of eyes"
msgid "A levitating ball, covered in malignant eyes and humming with eldritch\nenergies. Many is the adventurer ripped limb from limb by its dreadful\neyeteeth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:green death"
msgid "A bloated form covered in oozing sores and exhaling clouds of lethal poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:green draconian"
msgid "A muscular green-scaled humanoid with a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:grey draconian"
msgid "A muscular grey-scaled humanoid with a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:guardian mummy"
msgid "An ancient warrior, embalmed and cursed to walk in undeath for eternity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:guardian serpent"
msgid "A rare and distinct member of scaly society, light and swift like a snake, yet\nalso intelligent like a naga. It is said that a guardian serpent would rather\ndie in battle than leave anything to an intruder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:guardian sphinx"
msgid "A fearsome aged hybrid with a woman's head, a lion's body, and the wings of\nan eagle. It solemnly guards the temples and treasures of the Dungeon with a\nmultitude of mind-clouding maledictions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:halazid warlock"
msgid "An ancient undead sorcerer, exhumed by the living divines Sheza and Sargol and\nforced to labour night and day to anchor them to the world. Even after the fall\nof the divine twins, it works to resurrect its fallen masters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:harpy"
msgid "A bird-like creature with a human face that roams the coasts endlessly, feared\nfor its sharp claws and harrying strikes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:haunted armour"
msgid "An ordinary piece of armour, held in your haunting grip. It can attack nearby\nenemies, but must return to your side if you ever stray too far from it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sin beast"
msgid "A ravenous brute of a demon - as much animal as person. Born from the residue\nof mortal depravity, it gorges itself on malice and magic alike.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hell hog"
msgid "An extremely large and aggressive swine, bred in Hell, whose breath burns its\nfoes to ash.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hell hound"
msgid "A huge black dog with glowing red eyes, and smoke pouring from its fanged\nmouth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hell knight"
msgid "A heavily armoured warrior, in league with the powers of Hell, and usually\naccompanied by other unsavoury beings of its ilk.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hell rat"
msgid "A unusually large rat. Its weird, knobbly orange skin glows with the infernal\nenergies that spawned it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hell sentinel"
msgid "A towering monolith constructed and possessed by demonic forces. A thousand\neyes leer through slits in its jagged, spiked armour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hellephant"
msgid "An abhorrent pachyderm, descendant of demons, burning from within with the\nfires of Hell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hellfire mortar"
msgid "A terrifying weapon hewn from molten rock. It rains fiery destruction down upon\nits creators' enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hellion"
msgid "A hateful demon, desirous to see all life destroyed by its damnation.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hellwing"
msgid "A hideous skeletal demon. It swoops through the air on powerful wings of\nancient withered skin, taking sadistic joy from harrying those who would try to\nflee its grasp.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hexer"
msgid "A humanoid construct of insubstantial memory, floating through the air. Though\nperhaps somewhat changed in shape and bearing few discernable features, still\nit seems somehow to resemble a warrior from the distantly remembered past,\nready with debilitating spells and deadly knifework.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hippogriff"
msgid "A large creature with the hindquarters of a horse and the wings, head and\ntalons of a great eagle. As popular heraldric creatures, some fortresses may\nkeep them as symbols and defenders alike, where they in turn launch intruders\ninto the waiting blades of their masters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hoarfrost cannon"
msgid "An elegant siege weapon, magically sculpted from crystalline ice. As ephemeral\nas a summer snowstorm, every salvo it fires consumes a portion of itself until\nnothing is left behind but water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hobgoblin"
msgid "A larger and even ruder goblin. Hobgoblins are perfectly capable of wielding\nweapons, but most prefer to beat their opponents to death with their bare hands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hog"
msgid "A large even-toed ungulate. Like human beings, it is omnivorous, intelligent,\nand nearly hairless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:holy swine"
msgid "A rare celestial version of a usually filthy animal, said to be an angelic\nbeing who succumbed to hostile magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hound"
msgid "A fearsome hunting dog, lithe and alert.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:howler monkey"
msgid "An aggressively territorial primate, known for the astonishing variety and\nvolume of noise it can produce.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:human"
msgid "An uppity sort of surface-dwelling, hairless ape. Dwarves think of them as\nfragile, elves think of them as clumsy, and monsters think of them as tasty.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hydra"
msgid "A great and nightmarish lacertilian beast. It has many heads, and the potential\nto grow many more!\n\nHitting it with any bladed weapon bigger than a short blade risks lopping a\nhead off and causing two more to grow in its place. Very large claws, such as\ntrolls', are long enough to do the same. Only a weapon branded with flame will\ncauterise the wound and prevent more heads from growing.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ice beast"
msgid "A terrible creature, formed of snow and crystalline ice. Its feet leave puddles\nof icy water on the floor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ice devil"
msgid "A man-sized demon covered in glittering ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ice dragon"
msgid "A white, frost-coated dragon. Snowflakes trickle from its nostrils.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ice fiend"
msgid "A huge frigid demon covered in frost and wreathed in freezing air. It is one of\nthe most terrible denizens of the many Hells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ice statue"
msgid "An imposing idol of some nameless arctic god, carved in glistening deep blue\nice. Freezing vapours swirl about it, and a chill pervades the air.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iguana"
msgid "A green lizard with strong jaws and sharp teeth, prized for its flesh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:imperial myrmidon"
msgid "A warrior initiated in the mysteries of a dying cult, dedicated to serve\nthrones long-fallen. Its blows strip away magical defences, leaving its foes\nvulnerable to even the simplest hexes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:inugami"
msgid "A mystical canine, frequently bound into the service of wizards and sorcerers.\nIts eyes flicker with remarkable intelligence, but its bite is no less sharp\nthan its wilder cousins.\n\nThey are difficult to truly kill - when gravely wounded, they instead return to\nspiritual form to lick their wounds until ready to be summoned again.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iron dragon"
msgid "A very heavy, slow and apparently flightless dragon. It is named for its\nscales, which are so tough they might be iron. Small flakes of metal trail from\nits nostrils.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iron elemental"
msgid "A rare and powerful spirit from the elemental plane of earth, it exists in this\nworld by inhabiting a hulking mass of iron.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iron giant"
msgid "A huge, rusting monolith, larger than any other species of giant. It packs\nan incredible punch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iron golem"
msgid "A large, ponderous and very solid statue of metal, given the power of\nlocomotion through some esoteric means.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iron imp"
msgid "An ugly, twisted little minor demon with metal skin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:iron troll"
msgid "A great troll, mighty of limb and plated with thick scales that resemble\nlightly rusted iron, especially in their hardness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ironbound beastmaster"
msgid "A cruel and unruly brute who growls in the language of the untamed. Its very\npresence provokes and overworks non-sapient, living beasts and slimes alike into\na rapid fervour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ironbound convoker"
msgid "A guardian mage clad in pattern-etched armour. It can recite words of power\nto summon distant allies and imbue them with unnatural might.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ironbound frostheart"
msgid "An emaciated warrior-mage, bound to guard long-coveted treasures. It calls\nforth deadly frost from its surrounds, freezing foes that are next to walls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ironbound mechanist"
msgid "A well-armoured coglin whose talents with machinery have been harnessed by the\nIronbound order to repair and augment the many constructs that help guard the\nVaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ironbound thunderhulk"
msgid "A brutish figure, hastily armoured in scraps of leather and metal to combat\na fearsome intruder. On its back is an antique, arcane 'lightning rod', which\ncalls down thunder on distant foes, although it cannot hit nearby targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ironbound preserver"
msgid "A towering, muscular figure, capable of safeguarding its allies by selflessly\naccepting a portion of the injuries inflicted upon them.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jackal"
msgid "A small canine scavenger. Packs of jackals roam the underworld, searching for\ncarrion to devour.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jelly"
msgid "A pulsating mass of acidic protoplasm.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jiangshi"
msgid "A vampiric thrall bound into servitude by esoteric rituals. Though its rigid\nlimbs give it an awkward gait, it moves with surprising speed, leaping upon its\nvictims and leeching away their life essence with its vicious claws.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jorogumo"
msgid "A spider spirit that takes the appearance of a human. It weaves deadly magics to\nincapacitate and kill its prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:juggernaut"
msgid "A gigantic humanoid with thick iron plates welded to its skin. It moves with\nalarming speed and deals incredible damage with its immense fists, but must\nrest between blows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:jumping spider"
msgid "A spider which weaves webs between its front legs and leaps at its prey,\nensnaring them. The speed with which it leaps is almost supernatural.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:killer bee"
msgid "A giant bee, bearing a deadly barb which can sting repeatedly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:killer klown"
msgid "A comical figure full of life and laughter. It looks very happy to see you...\nbut is there a slightly malicious cast to its features? Is that red face paint\nor something altogether less pleasant?\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:knight"
msgid "A humanoid construct of insubstantial memory, floating through the air. Though\nperhaps somewhat changed in shape and bearing few discernable features, still\nit seems somehow to resemble a warrior from the distantly remembered past,\nwell equipped with arms and armour both.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kobold"
msgid "A small, greyish creature with the look and temperament of a feral dog. No one\nknows for sure where kobolds come from, but ancient demon-gods, evil spirits,\nand meddling wizards have all been suggested as culprits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kobold brigand"
msgid "A kobold that is bigger and tougher than the ordinary kobold, with a penchant\nfor underhanded tactics.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kobold blastminer"
msgid "A kobold, ready with multiple armaments to defend itself from the many\ndangers of the depths. The blastmote-packed cannon on its shoulder bears its\nmaker's mark, and is fiercely loyal; it will fire for none other.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kobold demonologist"
msgid "A kobold in league with demonic powers, able to call forth beings from the\ndepths of Hell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kobold fleshcrafter"
msgid "A skull-masked kobold, its body mutated by forbidden magics. It conducts vile\nexperiments in the service of demonic powers, formulating ever more terrible\nmonstrosities as vessels for devilish minds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kobold geomancer"
msgid "A wily kobold who has learned to weaponise every crack and crevice that lines\nthe walls of its domain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:komodo dragon"
msgid "An enormous monitor lizard more than capable of preying on large animals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:kraken"
msgid "A gargantuan sea monster, capable of devouring entire ships. Its many tentacles\nreach towards the shore and crush any who draw near.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:large abomination"
msgid "A hideous conglomeration of mangled body parts, possessed and altered in ways\nthat challenge sanity. Each varies in speed, strength, or resilience by\nthe nature of whatever unfortunates were used to make it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:laughing skull"
msgid "A blazing swift skull that cackles with the bleak malice of the dead. Fond of\nswarming, its laughter grows more spiteful and powerful for each nearby member\nof its own kind.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lava snake"
msgid "A burning red snake which dwells in pools of lava. It spits gobs of molten rock\nat passers-by.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lemure"
msgid "An accursed soul magically bound to hellish servitude for the highest bidder.\nIf its master is slain, it will be freed, departing this realm with gratitude.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lich"
msgid "A powerful wizard who has learned to cheat death itself, now existing as a\nskeletal, desiccated corpse kept intact by a mighty exercise of dark magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lightning spire"
msgid "A buzzing contraption made from a coil and a rod. It irregularly zaps\nelectricity at the most distant enemy in its range.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lindwurm"
msgid "A small serpentine dragon with a pair of strong forelimbs. Its thick scales\ngive off an eerie red glow.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:living spell"
msgid "A spell, waiting to cast itself at the first foe that enters its range. Once\nit does, it'll dissipate into the ether.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lost soul"
msgid "The echo of an unmourned soul. Though the memories of its living self are\nlong-faded, it is drawn to the moment of death by some lingering instinct. It\nseizes upon the passage of other souls, losing the last vestiges of its being\nin the memories of another's life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lurking horror"
msgid "A formless mass of negative energy, bound to bring terrible torment once the\nforces holding it together dissolve. The alien presence of intruders to the\nAbyss is sure to unravel it, yet it seems perversely drawn toward them; still,\nit seems somehow reluctant to move while being observed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mana viper"
msgid "A violet-scaled serpent with faintly glowing eyes. It thirsts for magic as well\nas flesh, and its bite can drink dry the magical reservoirs of even a powerful\nmage in no time.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:manticore"
msgid "A hideous cross-breed, bearing the features of a human and a lion, with great\nbat-like wings. Its tail bristles with spikes that can be loosed at potential\nprey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:marrowcuda"
msgid "The flame-wreathed skeleton of a carnivorous fish, darting through air as easily\nas it once parted water. It burns with a hunger it could not satisfy in life and\nis singularly driven by in death.\n\nWhile a single one may be only a nuisance, the swarm is never far behind, and\nevery bite it lands will summon more and more of them until every scrap of flesh\non its prey has been devoured.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:martyred shade"
msgid "The wandering shade of a long-dead soul who died for a forgotten cause. Though\ntheir memories have turned to mist, something deep within still compels them to\nserve and sacrifice - no matter the cost.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:meliai"
msgid "A nymphal hybrid, with a winged torso of a human atop the stinging abdomen\nof a bee. The meliai serve under many roles: priestesses of nature, nurses to\nthe divine, and warrior-champions for their hives.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:merfolk"
msgid "A hybrid with the torso of a human and the tail of a fish. It is capable of\ndwelling both in water and on land, and fiercely defends its domain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:merfolk aquamancer"
msgid "A slender merfolk mystic with unusually webby hands. Its form shifts and\nglistens as if seen through ocean spray.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:merfolk avatar"
msgid "A beguiling merfolk whose voice mesmerises listeners. It carries no weapon,\nbut its song summons drowned souls to defend the sea against intruders.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:merfolk impaler"
msgid "A powerfully muscled merfolk warrior, bearing a deadly weapon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:merfolk javelineer"
msgid "A fearsome merfolk champion with a piercing gaze and a large bundle of\njavelins.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:merfolk siren"
msgid "A beguiling merfolk whose voice can mesmerise listeners.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:minotaur"
msgid "A large muscular human with the head of a bull. It makes its home in a\ngauntlet where it awaits worthy challengers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:molten gargoyle"
msgid "A hideous molten stone statue come to life, with flames licking across its\nbody.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:monarch bomb"
msgid "A flying munitions factory, held aloft on jets of fiery exhaust and packed to\nthe brim with explosives. It can rapidly fill an area with bomblets, and when\ncommanded by its creator, will explode them all (and itself) to devastating\neffect.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:morphogenic ooze"
msgid "A multihued mire of roiling flesh and fluctuating sludge, striving and failing\nfor more coherence than any other slime. As a fresh carrier of the ruinous\ncontagion that overtook the Slime Pits, it can impart unto others the same\nhorrible fate. While it may not be a permanent transformation for you, the\nmelding of weapons and armour, as well as the severe weakening of spells, may\nmake it a lethal one regardless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:moth of wrath"
msgid "A moth known for its ability to inspire rage by touching its foes, or merely\ngazing at its friends. For some inexplicable reason, it was eradicated from\nthe surface centuries ago.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mountainshell"
msgid "An enormous land tortoise whose shell is so thick and rock-encrusted that\nsleeping ones are frequently mistaken for geological formations. And like a\nmountain, its exterior is nearly impervious to any destructive force; only at\nclose range can one properly aim for the narrow gaps between its plates to\nstrike the tender flesh within.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mummy"
msgid "An undead figure covered in bandages and embalming fluids, compelled to walk by\nan ancient curse. It radiates a malign aura.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mummy priest"
msgid "An ancient servant of a long forgotten god, embalmed and cursed to walk in\nundeath for all eternity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mutant beast"
msgid "A bizarre creature, twisted and warped by overexposure to magical radiation.\nEach has a different set of traits.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:naga"
msgid "A hybrid that is human from the waist up; below is a scaly, muscular snakelike\ntail. Its mouth drips with venomous saliva.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:naga mage"
msgid "A naga that has trained in the use of magic, trailed by an eldritch nimbus. It\nis especially skilled in spells dealing with poison and venom.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:naga ritualist"
msgid "An esoteric mystic draped in talismans. It venerates poison as a sacred gift\nand means of spiritual purification.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:naga sharpshooter"
msgid "A naga with exceptionally keen eyesight, adept in the use of ranged weaponry\nand simple magics which allows it to snipe at targets across nearly any\nobstruction.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:naga warrior"
msgid "A fearsome naga warrior clad in sturdy armour and wielding a mighty weapon.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nagaraja"
msgid "A magnificent example of the naga. It is an expert at both martial and magical\narts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nameless horror"
msgid "A malign force from the space between planes. It is hostile to the magic forces\nthat removed it from its home. These horrors are often the result of mistaken\nsummoning spells and have slain many aspiring wizards.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nascent plasmodium"
msgid "A slime mold colony in an early phase of its life cycle. Not yet mature enough\nto reproduce, it can still defend itself by firing globs of potent acid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nargun"
msgid "An ancient stone creature that has lived among these frozen caves since before\nAntaeus rent Cocytus into being. It tolerates its new neighbors begrudgingly,\npreferring the company of its petrified enemies. Veins of ice permeate its\nfrozen stone flesh.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:necromancer"
msgid "An evil wizard who is devoted to the practice of death magic, the mastery of\nunholy energies, and the raising of corpses into a parody of life.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:necrophage"
msgid "A vile undead creation of the most unholy necromancy, made from the decaying\ncorpses of humanoid creatures. It exists to spread disease and decay.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nekomata"
msgid "An upright feliform trickster of an elderly demon, with a forked tail ablaze\nwith a shimmering haze. It holds a deep disdain for mortal humanoids, a\npatronising pity for mortal cats, and enough mystic might to subjugate both.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:neqoxec"
msgid "A weirdly shaped demon, pulsing and shifting with mutagenic energies, its belly\ndistended with the devoured brains of its victims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:obsidian bat"
msgid "A faceless stone bat unearthed from infernal chasms. Devilish beasts hunt in its\nwake.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:obsidian statue"
msgid "A beautiful statue of an unknown creature, jet-black like a tear in reality.\nIts eyes glow with an otherworldly, malignant radiance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:occultist"
msgid "A wizard fond of illusion and treachery. They scorn the crudeness of other\nmagicians, who hurl wild conjurations toward their foes rather than cunningly\nexploiting their greatest weaknesses.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:octopode"
msgid "A more intelligent cousin of the mighty kraken, capable of using tools and\nspells. It is fully amphibious, but most of its species choose to stay beneath\nthe waves and serve their King.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ogre"
msgid "A large, ugly, and fat creature, distantly related to goblins. It is\ntremendously strong, and likes fighting alongside its orc friends.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ogre mage"
msgid "A rare breed of ogre, skilled in the use of magic. It usually becomes a\nchieftain among its kin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant"
msgid "A very dangerous plant which fends off predators by spraying corrosive vitriol\nat them. Even experienced adventurers give oklob plants a wide berth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob sapling"
msgid "A young oklob plant. It is more fragile than the mature specimen, but the acid\nit sprays is just as deadly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oni"
msgid "A large, rowdy, and drink-loving creature. When they're not busy with their\nduties serving any number of gods, oni mostly love a good fight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oni incarcerator"
msgid "An infamous, dutiful retainer of Gehenna. These immense and indomitable oni\nweave their weapons through reality itself to reach and capture the innumerable\ndamned souls owed to the hells upon their deaths.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ophan"
msgid "A creature from the heavenly realms. It consists of a wheel within a wheel, and\nboth of these are covered in eyes; strange flames of holy fire flicker all over\nit. To be seen by its countless eyes is to be highlighted and branded as both\ndissident and quarry for its allies to hunt down.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orange crystal statue"
msgid "An intricately carved idol of some nameless godling, hewn of translucent orange\ncrystal. Its lifeless eyes seem to glitter uncannily with a wicked\nintelligence. It is capable of unleashing a powerful psychic assault upon the\nminds of any who approach it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orange demon"
msgid "An amber-coloured demon with a barbed tail not unlike that of a scorpion.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb guardian"
msgid "A huge, glowing, four-limbed purple creature with heightened senses, created by\nthe Orb itself. It guards the Orb with enormous punctiliousness and violence,\nand its death will alert any Boundless Tesseracts on the level to begin creating\nreinforcements.\n\nUnless the Orb has already been disturbed, it will refuse to abandon its duty\nby leaving the floor.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb of destruction"
msgid "A conjured globe of pure magic that homes onto a designated target, albeit with\nmassive inertia. A smart and agile person may move out of its path, causing it\nto miss its target. It cannot be avoided by Dodging skill, and is able to make\nsharp turns to hit adjacent targets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb of entropy"
msgid "A globe of profound nothingness and the oblivion that awaits all things - flesh,\nsouls, and even time itself. When the universe ends, only these will remain.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb of fire"
msgid "A globe of raw primordial fire, capable of impressive pyrotechnics and of\ntwisting the very flesh of creatures who come into its ken.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb of winter"
msgid "A globe of deepest cold, still lingering from a time before the stars lit the\nheavens. It can shroud the soul in a chill so intense that even the gods cannot\nreach it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb spider"
msgid "An eerily glowing spider with strands of pure energy emerging from its\nspinnerets. It seems to want to keep its distance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc"
msgid "A subterranean tribe whose forebearers were once scattered across every corner\nof the surface world. Eons of persecution have taught them the necessity of\nviolence and the importance of having your brethren at your side.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc apostle"
msgid "An orcish wayfarer who has been touched by the hand of Beogh. Whether out of\nreligious devotion or personal jealousy, they have come to bar your path.\n\nHold nothing back - for neither they nor their followers will do so.\n\nGlory to Beogh!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc apostle follower"
msgid "A favoured child of Beogh, once not so unlike yourself.\n\nNow that you have proven yourself to them, they will fight and die for both you\nand the cause. Shepherd them well.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc high priest"
msgid "An exalted servant of the orc god Beogh and a master of many foul rites, to\nwhose aid Beogh will even send beings from the netherworld.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc knight"
msgid "A heavily armoured orc, covered in scars from many past battles. It commands\nits brethren in battle, rousing them to greater, more violent efforts with\nbloodcurdling shouts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc priest"
msgid "A servant of Beogh, the ancient god of the orcs. Beogh rewards its devoted\nprayers by striking down its enemies.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc sorcerer"
msgid "An exceptionally competent orcish wizard, in league with hellish and chthonic\nforces and motivated by the purest imaginable strain of malevolence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc warlord"
msgid "A supreme commander of an orc host, skilled at both melee and ranged combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc warrior"
msgid "An experienced, armoured and well-armed orc soldier, able to command a small\nmob of its fellows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orc wizard"
msgid "An orc who has gained proficiency in the occult arts, using them for martial\npurposes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pale draconian"
msgid "A muscular humanoid with pale scales, a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pandemonium lord"
msgid "A formidable demon lord inhabiting the endless halls of Pandemonium. Each one\nis different, with its own set of strengths and weaknesses.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:peacekeeper"
msgid "A four-legged humanoid construct, tasked with recapturing escaped prisoners and\npunishing heretics. Long after the fall of the empire it once served, it\ncontinues to enforce imperial law, knowing no jurisdiction.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pearl dragon"
msgid "A dragon consecrated to the holy divine powers. Its breath is blessed fire, and\nits claws sear its victims with divine wrath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:petrified flower"
msgid "A sizeable and statuesque flower, fossilised either by bitter grief or the cruel\ngrace of divinity, standing in its own eternal vigil.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:phalanx beetle"
msgid "An intricate mechanical beetle covered in reinforced metal plates that resemble\na shield. It projects a kinetic barrier around its creator while adjacent to\nthem, increasing their armour class.\n\nIt will never voluntarily leave its creator's side, and if forcibly seperated,\nwill prioritise returning to them over any other concerns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:phantasmal warrior"
msgid "A hideous translucent green spirit of a warrior fallen in battle but recalled\nto this plane by unholy magic. The blade it wields is ethereal, rendering those\nit strikes weak-willed and vulnerable to dark magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:phantom"
msgid "A nearly-transparent undead spirit, suspected by some sages to be a degenerate\nform of ghost, with no memories of its former life. It rarely stays in one\nplace for long.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pharaoh ant"
msgid "A royal ant returned to unlife through strange, probably horrifying means. It\nbinds the souls of its allies when slain, allowing them to fight on after death\nas simulacra.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pile of debris"
msgid "A heavily ruptured stonework, surrounded by rubble.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pile of flesh"
msgid "A leftover mess of broken bones, inert grasping organs, and scattered skin.\nWhile some highly-specialised sorcerers might be capable of bringing it to life,\nit is otherwise harmless - the possible leftovers of some departed or\nabsent-minded magus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pillar of rime"
msgid "A spire of strangely tenebrous ice, its brittle tendrils reaching skyward like\nthe fingers of an outstretched hand. {{\n    if spells.memorised(\"rimeblight\") then\n        return \"If only the dying breath of every soul could create such art.\"\n    else\n        return \"It might even be beautiful if you didn't know the gruesome \" ..\n               \"way it formed.\"\n    end\n}}\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pillar of salt"
msgid "A pillar of salt shaped like a statue, but worked by no living hands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:plant"
msgid "A plant that has adapted to grow in the unpleasant dungeon environment,\nsomehow thriving even underground in the absence of the sun.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:platinum paragon"
msgid "A gleaming warrior, wrought from precious metals and the very pinnacle of\nforgecraft techniques. Its every motion flows with a deadly, fluid grace that\nbelies its artifical nature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:player ghost"
msgid "The apparition of an unfortunate adventurer, retaining many of the skills and\nabilities the adventurer had in life. It is condemned to haunt this particular\nlevel of the dungeons, lashing out violently at the next adventurer to cross\nits path.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:polar bear"
msgid "A bear covered in glistening white fur, habituated to cold conditions. Like all\nursines, it will become enraged if badly hurt.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:poltergeist"
msgid "A ghostly trickster that is fond of possessing small objects and making them\nfly noisily through the air.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:polterguardian"
msgid "Many poltergeists are fiercely territorial over the domains they choose to\nhaunt, but these have extended that protection even to the people who share\ntheir domain with them. Some say they must be the lingering souls of those who\nguarded the Vaults in life; others suggest the Ironbound Order simply recruited\nthem in common cause. Whichever is true, their very presence shelters other\ncreatures from missiles, causing sling and spell alike to veer off-course at the\nlast moment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:profane servitor"
msgid "A blasphemous being that was once an angel of the Shining One. It now stands as\nunliving proof that not even the holiest of beings are beyond Yredelemnul's\ngrasp.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:program bug"
msgid "A ravenous and incredibly buggy monster. Please report its existence to the\nDevTeam.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:protean progenitor"
msgid "A gargantuan humanoid of fractured shape from the aeons when the seas were but\nprimordial soup. The many shapeshifters of the dungeon once sloughed off from\nthese unfathomably ancient beings, and when they themselves finally cease, even\ntheir remains will give birth one last time to furious monsters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:putrid mouth"
msgid "A starved spirit whose mouth is a pit of rot, emitting vile fumes. Its putrid\nmaw cannot eat the food it finds, so it moans with rage and desparate hunger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:purple draconian"
msgid "A muscular purple-scaled humanoid with a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:queen bee"
msgid "A ruler of a swarm of bees, even larger and more dangerous than its many\noffspring.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:quicksilver dragon"
msgid "A long and sinuous dragon, seemingly more neck and tail than anything else. Its\nskin shines like molten mercury, magical energies arc from its pointed snout,\nand it moves with terrifying swiftness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:quicksilver elemental"
msgid "A mercurial spirit drawn from the elemental plane of earth. It exists in\nthis world by inhabiting a shimmering body of liquid metal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:quokka"
msgid "A pesky little marsupial that is a bit like a rat, but not quite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:radroach"
msgid "A giant cockroach that has been exposed to high amounts of mutagenic energy. It\nis horrifyingly mutated, but this has only made it stronger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ragged hierophant"
msgid "A bedraggled priest, once-fine robes now lined with salt and dust. Forsaken by\nthe gods, it now relies on constructs to protect itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rakshasa"
msgid "A maneater demon, bestial and misshapen, in search of hidden power and\nknowledge. It is an expert in the art of illusion, and is exceptionally\nintelligent and cruel.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rat"
msgid "A dirty rodent that has grown large and aggressive in the dungeon environment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:raiju"
msgid "A profoundly unnatural hound, crackling with electricity. It travels in packs,\nand covers great distances by bursting into living lightning.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:reaper"
msgid "A haunting form wielding a giant scythe, ceaselessly harvesting the souls of\nthe living.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:red devil"
msgid "A larger cousin of the common imp, with a fiendish grin and two short wings\nsprouting from its shoulders. It favours tridents and loves to skewer its\nvictims with painful barbs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:red draconian"
msgid "A muscular red-scaled humanoid with a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hornet"
msgid "A buzzing hornet with a vicious stinger dripping with paralytic poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:raven"
msgid "A jet-black corvid with a nasty beak and a reputation for heralding bad luck.\nMost ornithologists consider this a baseless stereotype; the rest are still\nrecovering from a series of staggeringly unlikely accidents.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:redback"
msgid "A vicious black spider with a splash of red on its swollen abdomen. Its\nmandibles drip with lethal poison.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rending blade"
msgid "A crackling weapon formed of condensed magical energy. It can cut through entire\nrows of adversaries whenever its creator lands a melee attack.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:revenant"
msgid "The skeletal remains of someone who died unmourned and forgotten. It burns with\nan unquenchable hunger to be remembered.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:revenant soulmonger"
msgid "A timeworn revenant whose flames dance with the silhouettes of long-forgotten\natrocities. Cursed with a hunger they can never satisfy, they unleash these\nlong-dead echoes to reenact violence upon any soul they deem worthy of adding to\ntheir eternal collection.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ribbon worm"
msgid "A giant annelid, glistening with slime, with unusually large teeth. It expels\nfragments of its own innards to ensnare unsuspecting prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rime drake"
msgid "A small but dangerous dragon. Its breath is visible even on the warmest days.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:river rat"
msgid "A rodent with hair of a most peculiar green colour, and a powerful bite. It\ntends to form great swarms with its kin.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rock fish"
msgid "A strange stone-scaled fish that swims through solid rock with the same ease\nthat most fish do through water.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rockslime"
msgid "An oozing avalanche, scouring the ground beneath it as it rumbles forward.\nIt consumes only the metal and bone from its victims, using them to reinforce\nitself even further.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:royal jelly"
msgid "A particularly rich and golden gelatinous thing. Smaller jellies swim and pulse\njust below its surface, ready to burst forth at the slightest touch.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:royal mummy"
msgid "An ancient pharaoh, embalmed and cursed to undeath, now capable of great and\nterrifying feats of magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rust devil"
msgid "A hideous humanoid figure with rust-spotted metal skin, spreading corrosion\nand decay to all it touches.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sacred lotus"
msgid "A large and vivid bloom drifting placidly upon the surface of the water. The\ncradle of the lotus's petals shine with eternity and elegance - while it is\nentirely harmless, it would take immense effort to destroy it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:salamander"
msgid "A red, flaming half-human half-snake creature with a legendary affinity for\nfire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:salamander mystic"
msgid "A member of the salamander's scholarly caste, possessed of lesser size and\nstrength, but wise in the ways of magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:salamander tyrant"
msgid "An intimidating volcano lord. It commands the magma of its realm as an\nextension of its body, and the majesty of its gaze can weaken even the proudest\nchallenger.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:saltling"
msgid "A small, human-shaped agglomeration of salt. It was created by the last\nfugitive loyalists of the fallen eastern empire, forced in desperation to\nconstruct golems from local resources to defend themselves.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:satyr"
msgid "A more intelligent relative of the faun, often found in their company, and far\nmore unforgiving of — and dangerous to — interlopers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:scorpion"
msgid "A loathsome arachnid, armed to the teeth. Its body is covered in a thick\ncarapace, its tail is tipped by a venomous sting, and its forelimbs are\nequipped with a pair of sharp grasping claws.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:screaming refraction"
msgid "A deeply unfortunate soul mostly processed into crystal by some malevolent tear\nin reality. Ethereal reflections of its past and future suffering are cast upon\nnearby surfaces and foes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:scrub nettle"
msgid "An irritable, bristling shrub. It fends off anything that might graze upon it by\nlaunching some of its innumerable toxic stinging hairs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sea snake"
msgid "A brightly coloured snake, very comfortable in the water. It has a highly\npotent venomous bite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:searing wretch"
msgid "An animated corpse alight with terrible fire. The flames are fueled by its\nregenerating flesh, which bubbles and melts as it grows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:seismosaurus"
msgid "A stubborn and fiercely territorial lizard with the strength of a mountain. Its\nthunderous footfalls herald violent tremors.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:seismosaurus egg"
msgid "A lizard egg the size of a small boulder and nearly as hard. Perhaps as a\ndefence mechanism, they hatch rapidly in the presence of predators and even a\nnewborn can give all but the most ambitious of monsters a reason to consider an\neasier meal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:seraph"
msgid "A six-winged servant of the good gods, of the highest rank of the angelic\nhosts. Its eyes burn with divine fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:servant of whispers"
msgid "A member of an order of monks who abandoned their former faith. It now serves\na minor god of wind and whispers, who allows it to calm the air and, when\nin great need, to break the stillness with divine thunder.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow"
msgid "A featureless silhouette of your own body, moving independently through the\ndivine power of Dithmenos. No matter how many times it is struck down, it will\nreform itself, for a shadow is inextinguishable so long as whatever cast it\nremains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadowghast"
msgid "A skulking apparition that disguises itself as a harmless shadow. Attuned to the\ndim light of the dungeon, it can slip in and out of sight at will, moving\nswiftly from one pool of shade to the next before striking unerringly at the\nblind spots of those who cannot see it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow demon"
msgid "A mysterious demonic figure, difficult to distinguish from the darkness around\nit. It weaves the shadows into powerful minions.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow dragon"
msgid "A great umbral dragon, radiating evil and death. Its breath reeks of the grave.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow imp"
msgid "A shadowy minor demon, with an affinity for the necromantic arts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow prism"
msgid "A prism-like silhouette which wavers with barely-contained destructive energy.\nAny blow which disrupts its form will result in a violent blast of shadow.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow puppet"
msgid "A minor servant of living shadow whose form wavers perpetually on the edge of\nrecognition - as if an unseen light were flickering behind something almost\nfamiliar.\n\nThe strength of its attacks increases in proportion with the power of the spell\nwhich summoned it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow turret"
msgid "A strangely static silhouette whose form suggests a large cannon. Though it uses\nno gunpowder, the depths of its bore flickers angrily with every shot, as if\nremembering the fiery light of its ignition.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shadow wraith"
msgid "A mist-wreathed skeletal shadow, hanging in mid-air. It drains away the\nlife force of living beings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shambling mangrove"
msgid "A gnarled mangrove, possessed of sapience and a cantankerous disposition. Its\nroots run deep through the water and soil of its marshy home and can make\nfooting very difficult for those who provoke its ire. Marsh fauna are often\nfound nesting within its branches, and may not take kindly to being disturbed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shapeshifter"
msgid "A disturbing creature with the power to change its form. It is very rarely\nobserved alive in its natural state.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shard shrike"
msgid "An incredibly fast-moving bird, known for impaling its prey on shards of ice\nbefore tearing them to pieces. It has acclimated to the desolate wastes of\nCocytus, and is enveloped with an accursed chill.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shining eye"
msgid "A strangely deformed floating eyeball, pulsating with flesh-twisting energy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shock serpent"
msgid "A sinuous serpent whose body crackles with volatile electricity. Its electric\nshroud can discharge when struck, inflicting a painful shock on any nearby\nfoes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:shooting star"
msgid "A glimmering spark of magical energy. It seeks out nearby enemies to expend\nitself upon, dealing damage and pushing them backwards.\n\nIt does not block its allies' line of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:silent spectre"
msgid "A terrible spirit which brings an unearthly silence to the area around it,\nmaking it impossible to recite the magical incantations involved with casting\nspells or reading scrolls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:simulacrum"
msgid "An icy replica of a monster, animated by heretical magics.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sixfirhy"
msgid "A small vile creature that moves in bursts, stopping then darting with\nlightning speed. It sprays sparks as it goes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:skeletal warrior"
msgid "A vicious and heavily armed humanoid skeleton, animated by unholy power.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:skeleton"
msgid "A skeleton compelled to unlife by the exercise of necromancy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sky beast"
msgid "A strange aerial creature formed of fleshy clouds and electric feathers. It\ncommands the faint wind currents of the Dungeon with every strike, which will\nbuffet its victims in dramatic correlation to the amount of open air around\nsaid prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:skyshark"
msgid "Skysharks cut through the air with a thoughtless ease. Just a taste of blood\ngives them an enraged strength, and further morsels drive them into a frenzy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sleepcap"
msgid "A surprisingly ambulatory mushroom. It wafts its spores over prey to send them\ninto a deep sleep, making it simple for the fungus to kill and devour them.\nIt can take months for its mycelia to fully infiltrate and digest victims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:slime creature"
msgid "An icky glob of slime that slithers along the ground. It can merge with other\nslime creatures to become dramatically more dangerous, and is especially likely\nto do so in confined spaces.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:slymdra"
msgid "A quivering amalgam of viscous slime, its many pseudopods gnashing at the air\nlike a throng of reptilian maws. It rapidly absorbs nearby slime creatures into\nitself, growing a new 'head' for each one and becoming even more resilient.\n\nWhether through convergent evolution or genetic memory, it also shares the\nhydra's most infamous trait: lopping off a head with a bladed weapon will just\nmake it grow two more unless the wound is cauterised by a flaming weapon.\n\nWhen not stalking prey, its constituent slimes may separate from it again,\nperhaps to seek new food sources on their own.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:small abomination"
msgid "A hideous mass of body parts. Each varies in speed, strength, or resilience by\nthe nature of whatever unfortunates were used to make it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:smoke demon"
msgid "An infernal demon that manifests itself as a writhing cloud of smoke. Having\nconsiderable pyrokinetic powers, it can very effectively attack its enemies\nfrom afar.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:snaplasher vine"
msgid "A swift and sinuous vine brought alive by a dryad's magic. It can quickly bind\nand entangle the dryad's foes, dragging them back to the forest from which it\nsurges.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:snaplasher vine segment"
msgid "Part of a swift and sinuous vine brought alive by a dryad's magic. It can\nquickly bind and entangle the dryad's foes, dragging them back to the forest\nfrom which it surges.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:snapping turtle"
msgid "A belligerent testudine with an armoured carapace. Its neck is surprisingly\nextensible and can reach out and bite from afar.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:solar ember"
msgid "A mote of intense light and heat manifested by a sun scarab. It is linked to\ntheir essence and will never leave their side, being reconstituted time and time\nagain whenever it is extinguished.\n\nSome myths even claim that the sun which shines down upon the outside world was\nonce carried around by such a scarab.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:soul eater"
msgid "A demon that manifests as a malignantly shifting shadow gliding through the\nair. It radiates an intense aura of negative force.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:soul wisp"
msgid "A tiny fragment of a living soul, splintered from the body in which it belongs.\nToo mindless to be fully controlled, it seeks nothing but to reunite with its\ngreater self once more - unfortunately, this process tends to be more violent\nthan the magic which created it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spark wasp"
msgid "A profoundly unnatural insect covered in vaguely metallic plates. Its stinger\ncrackles with electricity, capable of delivering a powerful shock to unwary\nvictims, and is capable of closing the distance with them at shockingly\nlethal speed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spatial maelstrom"
msgid "A malevolent rift in reality, dissolving all terrain it passes by into swirling\nvortices.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spatial vortex"
msgid "A crazily shifting twist in the fabric of reality.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spectral thing"
msgid "A hideous glowing apparition.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spectral weapon"
msgid "A spirit drawn from a weapon — it never strikes on its own. Damage done to it\nwill be partially mirrored onto the caster.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spellspark servitor"
msgid "A magical construct forged around a spark of its creator's own arcane power,\nallowing it to wield some of their destructive magics directly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sphinx marauder"
msgid "A wicked youthful hybrid with a woman's head, a lion's body, and the wings of\nan eagle. It gleefully wreaks havoc with both the violent turbulence of\nhigh winds and the frustration of bewildering magics.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:splinterfrost barricade"
msgid "A durable barricade made of ice reinforced with forgecraft magic. A lattice of\nprecise hairline cracks are visible just beneath its surface which allow it to\nfracture into a barrage of razor-sharp projectiles whenever it sustains critical\ndamage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan"
msgid "A small humanoid, resembling a human or elf except for the size. It moves at a\ngreat speed, and loves playing dirty tricks on people.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan air mage"
msgid "A magically adept spriggan blessed with the secrets of the winds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan berserker"
msgid "A relatively mighty spriggan that plunges recklessly into combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan defender"
msgid "An elite, well-equipped spriggan warrior, renowned for its unbelievable agility\nand its prowess with advanced weaponry.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan druid"
msgid "A spriggan whose connection with the birds and the beasts is exceptionally\nstrong. If it dies, its sacrifice will heal and temporarily strengthen nearby\nanimals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan rider"
msgid "A spriggan that has tamed a hornet as its mount, and is tasked with protecting\nthe spriggan fens and cairns from intruders.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:star jelly"
msgid "A white gelatinous mound that pulses with a strange iridescence. Its body\nabsorbs magical energy like a sponge, and when sufficiently injured, will\nunleash this energy as a flurry of shooting stars.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:starcursed mass"
msgid "A mass of stellar detritus that glows with the sickly putrescence of a dying\nstar, forever shrieking soundlessly in a voice beyond mortal grasp. Its form\nundulates constantly, dividing spontaneously and then withdrawing when\nthreatened. When divided, its deafening chorus of screams can overwhelm the\nminds of even the bravest warriors, leaving them stunned and helpless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:starflower"
msgid "A mass of lashing vines and tentacles growing out of the husk of a dead star.\nSpace itself runs through the xylem and phloem of its branches, which appear to\nbe in many places at once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:starspawn tentacle"
msgid "The writhing appendage of a tentacled starspawn, capable of grasping nearly any\nprey and dragging it back to be devoured. Any damage dealt to it hurts the\nwhole creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:starspawn tentacle segment"
msgid "A sinuous length of an extended starspawn tentacle. Any damage dealt to it\nhurts the whole creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:statue"
msgid "A piece of sculpted granite with glowing red eyes. Although it is rooted to its\nbase, it can still move parts of itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:steam dragon"
msgid "A relatively small grey dragon, with a resilient-looking scaly hide and steam\npouring from its mouth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:steelbarb worm"
msgid "A large worm covered with hard, spiky metal plates. Despite the apparent\nheaviness of its outer armour, it is rather fast.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:stoker"
msgid "A mortal who made an unholy pact in life, now chained to tend the fires of\nhell in undeath as payment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:stone giant"
msgid "A gigantic humanoid with grey skin almost as hard as rock. It carries several\nboulders, and is perfectly capable of flinging them a great distance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:storm dragon"
msgid "A powerful dragon with a hide of thick matte scales almost like blue rubber,\nand enormous scaly wings crackling with sparks.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:strange machine"
msgid "A strange mechanical contraption, all hisses and pops. Shadows seem to dance\nacross its reflective surface.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sun demon"
msgid "A demonic figure shining with the heat and fury of a fallen star.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sun moth"
msgid "A moth of transcendent beauty, coated in pyrophoric scales. Tiny cinders dance\nand twirl in its wake and whenever it beats its wings, they ignite in such\nspectacular displays of incandescence that one could almost forget how far away\nthe sun is from this place.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:swamp dragon"
msgid "A slimy dragon, its gnarly hide covered in swamp muck. Noxious gases dribble\nfrom its snout.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:swamp drake"
msgid "A small and slimy dragon, covered in swamp muck and giving off a terrible\nstench.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:swamp worm"
msgid "A large slimy worm, adept at traversing swamps and marshes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tarantella"
msgid "A small but greatly-feared spider. Its touch alone causes victims to break into\na frenzied dance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tainted leviathan"
msgid "Before even the oldest of ancient liches mastered life and death, a group of\ntitans attempted to pull themselves free of mortality through brute strength.\nThey almost succeeded before rot dragged them to Ereshkigal. A glimmer of their\nformer beauty remains, alluring despite the stench.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tengu"
msgid "A humanoid figure with the head and talons of a bird. Its ferociously combative\nnature belies its fragile appearance.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tengu conjurer"
msgid "A tengu with a talent for the destructive magical arts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tengu reaver"
msgid "An elite, ferocious tengu highly skilled with both steel and spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tengu warrior"
msgid "A particularly bloodthirsty tengu who has opted to hone its skill in airborne\nfighting and weaponry instead of spellcasting.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tentacle"
msgid "The mighty tentacle of a kraken. Any damage dealt to it hurts the whole\ncreature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tentacle segment"
msgid "A part of the mighty tentacle of a kraken. Any damage dealt to it hurts the\nwhole creature.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tentacled monstrosity"
msgid "A writhing mass of tentacles, all covered in putrid mucus.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tentacled starspawn"
msgid "A lumbering maw shrouded in a mass of sinuous tentacles. On spotting prey, its\ntentacles lunge outward, dragging victims directly to its waiting gullet.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:thrashing horror"
msgid "A seething mass of yellow flesh. It thrashes erratically, staggering foes\nbeneath the weight of its impacts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:titan"
msgid "A huge, bolt-hurling, lightning-limned humanoid. It is unusually large and\npowerful, even among giants.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:thermic dynamo"
msgid "A clashing tempest of boundless energy, channelling into capacitor jewels. Its\nwhirls of fire and ice occasionally escape and ricochet wildly off of walls.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:thorn hunter"
msgid "A predatory marsh plant, possessed of motility and a rudimentary intelligence.\nIt ensnares its prey with protrusions of spiny brambles and then skewers the\ntrapped creatures with its razor-sharp thorns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:toadstool"
msgid "A short-lived species of fungus typically found on or around decaying organic\nmatter.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:toenail golem"
msgid "A huge animated statue made entirely from toenail clippings. Some people just\nhave too much time on their hands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tormentor"
msgid "A malign devil covered in all manner of claws, spines, and cruel hooks. It is\nable to inflict torturous agony on those foolish enough to gaze upon it.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:torpor snail"
msgid "A ponderous gastropod with a rock-hard shell. It is said to be in some way\nconnected with the god Cheibriados; its very presence slows the movements of\nunwary adventurers, leaving them easy prey for its terrifying, ever-gnashing\nradulae.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:training dummy"
msgid "A mannequin used for battle practice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:troll"
msgid "A huge and physically powerful humanoid creature. Short on intelligence but\nlong on brawn, its thick knobbly hide heals rapidly from most wounds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:twister"
msgid "A whirling vortex of frost.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:two-headed ogre"
msgid "A huge ogre with two heads on top of its bloated body. It is capable of holding\na weapon in each giant hand.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tyrant leech"
msgid "An exceptionally aggressive blood-sucking annelid that thrives in swamps and\nmarshlands.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tzitzimitl"
msgid "A horrific fallen divinity, possessing jaws of gnashing stone and a necklace of\nstarry organs. It spreads disease and despair, and patiently awaits the end of\ndays when it will devour the sun.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ufetubus"
msgid "A chattering and shrieking minor demon. They delight in sneaking past and\nbackstabbing their prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:undying armoury"
msgid "A swirling tempest of souls and steel: knights and blacksmiths and\nweaponmasters, all bound to weapons they once held in life. To fight one is like\nfighting an entire army.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ugly thing"
msgid "An ugly thing. According to legend, it is the otherworldly spawn of a wizard's\nbreeding experiment. Yuck.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:undertaker"
msgid "The Dungeon's vast repositories of the dead and the unholy realms thereafter\nboth require regular restocking and reorganisation, far beyond the coordination\nof the restless dead. These corpse-collecting constructs burrow through the\nearth and command divisions of zombified hands to assist them in stealing away\ncarrion, and may also violently create new corpses for such purposes.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:unseen horror"
msgid "A creature rarely seen by anyone; those few who have seen one would rather they\nhadn't. It moves erratically.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ushabti"
msgid "A funerary stone figurine kept in tombs to serve the deceased as they pass\nthrough the afterlife. It is inscribed with spells to protect the interred for\neternity.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vampire"
msgid "A human cursed with vampirism, drifting in a state between life and undeath,\nperpetually hungry for the blood of the living.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vampire bat"
msgid "A large black bat with vicious fangs that feeds on blood. It is the preferred\nform for vampires in disguise.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vampire bloodprince"
msgid "A scornful scion to whom even other vampires bend the knee. Their command over\nblood magic allows them to feed upon the lifeforce of entire armies at once.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vampire knight"
msgid "A powerful vampire noble who complements its combat prowess with dark magic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vampire mage"
msgid "A sorcerer who, by accident or design, has been afflicted with the curse of the\nvampire. Regardless, through undeath, it has finally mastered the art of dark\nmagic.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vampire mosquito"
msgid "A mosquito that has fed upon tainted blood and been transformed into a\nrevolting and pestilent undead insect, seeking to drain its victims to the last\ndrop.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vault guard"
msgid "A heavily armed and armoured guardian of the Vaults.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vault sentinel"
msgid "A vigilant scout, quick to alert its fellows to the presence of intruders. It\nmarks such intruders with powerful magic, making them unable to hide from\npursuit no matter where they flee.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vault warden"
msgid "A veteran commander, able to seal nearby doorways and staircases to prevent\nintruders from either trespassing further or escaping alive.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:very ugly thing"
msgid "A very ugly thing. According to legend, it is the otherworldly spawn of a\nwizard's breeding experiment. Double yuck!\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vine stalker"
msgid "A bizarre symbiotic creature, made up of a carnivorous vine magically combined\nwith a humanoid.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:void ooze"
msgid "The viscous detritus of a thousand failed spells, surging forward with unnerving\nspeed. Its very substance is a hole in the fabric of magic; enchantments find no\npurchase there and even momentary contact with it can leave one's spells greatly\ndiminished.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:walking alembic"
msgid "A mobile and combat-capable alchemical manufactory that uses the friction of\nmelee combat to brew a variety of useful potions. When it has built up enough\nheat to complete its synthesis, it will automatically dispense the finished\npotions to nearby allies and fall apart.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:walking earthen tome"
msgid "A spellbook that has gone too long without being read. It overflows with magic,\nforming thick armour from its binding, legs from its pages, and periodically\nerupting in flurries of free-floating, self-casting spells.\n\nIt is coated with impossibly ancient dust.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:walking crystal tome"
msgid "A spellbook that has gone too long without being read. It overflows with magic,\nforming thick armour from its binding, legs from its pages, and periodically\nerupting in flurries of free-floating, self-casting spells.\n\nIt is encrusted with long, sharp, deadly-looking crystals.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:walking divine tome"
msgid "A spellbook that has gone too long without being read. It overflows with magic,\nforming thick armour from its binding, legs from its pages, and periodically\nerupting in flurries of free-floating, self-casting spells.\n\nIts cover bears the icon of a long-forgotten god, still fully possessed of wrath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:walking frostbound tome"
msgid "A spellbook that has gone too long without being read. It overflows with magic,\nforming thick armour from its binding, legs from its pages, and periodically\nerupting in flurries of free-floating, self-casting spells.\n\nIt glistens with a thick layer of unmelting ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:walking tome"
msgid "A spellbook that has gone too long without being read. It overflows with magic,\nforming thick armour from its binding, legs from its pages, and periodically\nerupting in flurries of free-floating, self-casting spells.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wandering mushroom"
msgid "A large, fleshy mushroom that wanders slowly around the dungeon. It is both\ninnately curious and incredibly shy, pursuing the objects of its curiosity only\nwhen out of sight. Noxious spores drift around its cap.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:warg"
msgid "A particularly evil-looking wolf, usually found in the company of orcs.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:war gargoyle"
msgid "A rare type of gargoyle, constructed from a solid steel statue and imbued with\nvicious strength, speed, and weaponised breath.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:water elemental"
msgid "A spirit drawn from the elemental plane of water. It exists on this world as\npart of a body of water and can engulf other beings in its form, depriving them\nof breath and voice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:water moccasin"
msgid "A largish venomous brown snake. It usually lives near water, and is an able\nswimmer.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:water nymph"
msgid "A capricious nature spirit, deeply bonded with the waters in which it lives.\nWherever they flow, so may it, and ponds and rivers surge and leap at its\nwhim.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:weeping skull"
msgid "An undead skull kept aloft by unholy clouds of collective misery, which slowly\ndrift out in its wake. It mourns without end for the living, the dead, and its\nown former life all alike.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wendigo"
msgid "A gaunt spirit of frozen hunger, so ravenous it will consume friend and foe\nalike. According to legend, if one cuts off its legs, it will feast upon its own\nmarrow. It stalks those lost wandering in the cold and hunts with the force of\nblizzards.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:white draconian"
msgid "A muscular white-scaled humanoid with a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:white imp"
msgid "A small and mischievous minor demon covered in frost.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wight"
msgid "An ancient warrior, kept in a state of perpetual undeath by its desire to die\nwith honour in battle.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:will-o-the-wisp"
msgid "A green-glowing gaseous entity, flickering and pulsing irregularly as it hovers\nthrough the air. Travelers have been known to confuse these for distant lanterns -\na mistake rarely made twice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wind drake"
msgid "A small but powerful dragon, particularly adept amongst its kin at manipulating\nthe currents of air that surround it. It can exhale powerful blasts of wind.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wolf"
msgid "A strong wild canine, with sharp teeth and a healthy appetite.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wolf spider"
msgid "A hairy fast-moving hunting spider with vicious mandibles, the size of a wolf.\nIt roams the dungeon in search of prey, which it kills with its deadly venom.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:worldbinder"
msgid "A cloud of thick fog, with faint, feeble claws constantly reaching out and then\nfading back into the fog. When threatened, it calls forth creatures banished to\nthe void between realities, using them to defend itself.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wraith"
msgid "A cloud of black mist surrounding an insubstantial skeletal form. Its eyes burn\nbright with unholy malevolence and hunger for life essence, on which it feeds.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wretched star"
msgid "A conflux of unearthly light and energy, awash in unnatural colours and strange\nforms no normal being was meant to perceive. It fills all those in its presence\nwith the disorder of the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wyrmhole"
msgid "A small and strangely serpentine fold in space and time. Scholars once\ntheorised the Dungeon's easy access to manifold unholy realms is due to the\ntunneling of yet-undiscovered translocations dragons. Whether or not this is\ntrue, distant stars mottle this drake's endless lengths, and dimensions bend to\nits writhing whim.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wyvern"
msgid "A dragon-like creature with a long, sharply pointed tail. Although smaller and\nless formidable than true dragons, it is nonetheless a foe to be reckoned with.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:yak"
msgid "A common dungeon yak, covered in shaggy yak hair and bearing a nasty pair of\nyak horns.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:yaktaur"
msgid "A hybrid with the torso of a robust human atop the body of a yak. It excels in\nranged combat, and is also a formidable foe in close quarters.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:yaktaur captain"
msgid "An exceptionally strong and brutish yaktaur, able to order its weaker brethren\naround to do its bidding.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:yellow draconian"
msgid "A muscular yellow-scaled humanoid with a reptilian tail and small wings.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ynoxinul"
msgid "A winged demon covered in shiny metallic scales. It has a legion of minor\ndemons under its command.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:zombie"
msgid "A corpse raised to undeath by necromancy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:zykzyl"
msgid "A demon born of mortal envy, its flesh undulating with a sickening wetness\nwhenever it moves. It is driven by a singular desire to reduce all beauty to a\nform as hideous as its own.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:test spawner"
msgid "(If you see this outside wizmode or the arena, this is a bug.)\n\nWhatever it is, it is capable of spawning countless monsters by casting Shadow\nCreatures, and is virtually undestructible itself.\n\nTo destroy it, lower the central elevator pillar, then pump rockets into the\nhole in its exposed brain when the pillar rises to an appropriate height. You\ncan add another rocket while jumping down.\n\nOh wait, wrong game.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ghost"
msgid "The remains of a monster that existed in an older version, but has since been\nremoved.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sensed monster"
msgid "A hostile monster whose presence has been detected.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:trivial sensed monster"
msgid "A trivially weak monster whose presence has been revealed by the power of\nAshenzari.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:easy sensed monster"
msgid "A weak monster whose presence has been revealed by the power of Ashenzari.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tough sensed monster"
msgid "A somewhat dangerous monster whose presence has been revealed by the power of\nAshenzari.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:nasty sensed monster"
msgid "A very dangerous monster whose presence has been revealed by the power of\nAshenzari.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:friendly sensed monster"
msgid "A friendly monster whose presence has been {{\n    if you.god() == \"Ashenzari\" then\n        return \"revealed by the power of Ashenzari\"\n    else\n        return \"detected\"\n    end\n}}.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cloud mage"
msgid "A strange wizard who has attained mastery over clouds, making deft and\nforeboding mystic gestures.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:head instructor"
msgid "A powerful warrior-mage who instructs aspiring students in physical, magical,\nand anti-magical combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:hellbinder"
msgid "A mighty spellcaster wreathed in arcane energies, muttering profane\nincantations.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:master blaster"
msgid "A mighty old lich, notorious for blasting people with powerful conjurations at\nthe slightest provocation, or just on a whim.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:statue of wucad mu"
msgid "A statue made of a fine glassy orange crystal. It depicts a mystic known as\nWucad Mu, who mastered the matters of the mind, and is imbued with Wucad Mu's\npowers of mental combat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:moon troll"
msgid "A bizarre breed of intelligent troll, glowing with mysterious power from beyond\nthis world which shields it from damage except at close range.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:lunar statue"
msgid "<zot statue>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:air elementalist statue"
msgid "A delicate statue of a tengu gliding through the air. It looks quite\ninsubstantial.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:antique champion"
msgid "An unfathomably expensive skeleton. It has countless sigils engraved into its\nbones, and pulses with a ghostly presence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:archer statue"
msgid "A statue of a beautiful elven archer, sculpted in finest marble. It holds a\nbow aloft, and appears to be magically animated, letting it use the bow to\nriddle intruders with arrows.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bog mummy"
msgid "An undead figure preserved by the brackish waters of a bog. It has begun to\ndecay heavily, and looks fragile.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:captured wizard"
msgid "A wild-eyed wizard whose tongue has been cut out, frantically mumbling and\nwaving its arms but unable to cast a single spell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:charred statue"
msgid "A statue that has been imbued with flame, allowing it to make use of simple\nfire-based conjurations.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:cigotuvi's monster"
msgid "A terrifying creation that appears to have been constructed from the body parts\nof every monstrous creature imaginable, with writhing tentacles sprouting from\nits form.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:conjurer statue"
msgid "A statue able to harness the mightiest of pure conjurations ever devised by\nIskenderun.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:deformed humanoid"
msgid "A poor creature that looks hideously deformed.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:demonic plant"
msgid "A demonic mockery of a plant, covered with mysterious appendages and writhing\ntentacles. It appears to be harmless.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dimme"
msgid "A terrible creature with demonic ancestry. Its presence is horrifying, but\nsupernaturally compelling.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:drunken dwarf"
msgid "A dwarf who seems to be working as an ale quality tester, and is enjoying the\njob a little too much.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:earth elementalist statue"
msgid "A plain statue of a dwarf wielding a pickaxe. It looks incredibly heavy.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fire elementalist statue"
msgid "An ornately worked statue of an orc holding a torch aloft, hewn from black\nbasalt. The air around it shimmers.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:flesh golem"
msgid "An animated mound of misshapen flesh, sculpted over an iron skeleton.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:frost-covered statue"
msgid "A statue of a mage, with frost constantly forming across its surface.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ghost-faced bat"
msgid "A bat with a spectral visage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:giga bat"
msgid "An enormous, bloated bat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:goblin sharper"
msgid "A goblin newly converted to Nemelex Xobeh. It's still learning about all the\ncards and, thankfully, isn't inclined to use them against you.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:greater air elemental"
msgid "A mighty spirit drawn from the elemental plane of air, surrounded by a\ndeadly vortex of frost.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:ice bat"
msgid "An undead creature in the shape of a bat, made of ice.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:flame-cult kobold"
msgid "A kobold that has been enchanted to explode in a blaze of fire.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:mad acolyte of lugonu"
msgid "A devoted follower of Lugonu, driven mad by years of living in the Abyss.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:malarious merfolk avatar"
msgid "A young merfolk that looks deeply ill, but is still capable of bespelling its\naudience.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:master elementalist"
msgid "A demented wizard commanding the primal forces of the universe.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:megabat"
msgid "A huge black bat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:microbat"
msgid "A bat that, despite its name, is not any smaller than a megabat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spectator"
msgid "A follower of Okawaru, granted the honour of spectating a duel to the death.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant annihilator"
msgid "A mere plant that has somehow attained sentience and the use of magic, by some\ninconceivable sorcery.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant conjurer"
msgid "<oklob plant annihilator>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant demonologist"
msgid "<oklob plant annihilator>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant meteorologist"
msgid "<oklob plant annihilator>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant shifter"
msgid "<oklob plant annihilator>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob plant summoner"
msgid "<oklob plant annihilator>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob sapling priest"
msgid "An immature oklob plant that seems to be mumbling some orisons... er, what?!?\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:oklob sapling wizard"
msgid "<oklob plant annihilator>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:orb golem"
msgid "A metal golem crackling with magical energies. It must have been created by\na truly devious wizard, or possibly someone who misheard what monsters could\nbe found in the Realm of Zot.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:phase bat"
msgid "A strange, glowing bat that flutters through more dimensions than the average\nbat.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:phase spider"
msgid "An otherworldly spider that can move short and medium distances by briefly\nshifting between the planes of reality, in order to better ensnare its prey.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:pristine statue"
msgid "An immaculately sculpted porphyry statue of an archer poised to release a bolt,\nwith a full quiver at the hip.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:rotten bat"
msgid "A bat that is well past its sell-by date.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sickly merfolk siren"
msgid "A young merfolk that looks quite sick, but still has the power to mesmerise its\nvictims.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:skeletal bat"
msgid "A bat skeleton without the decency to lie unmoving like dead bats are supposed\nto.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:spriggan baker"
msgid "A spriggan that has mastered the culinary arts.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:still boulder"
msgid "A gargantuan mass of stone at rest.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:water elementalist statue"
msgid "A smooth statue of a beautiful merfolk bathing in a fountain, sculpted from\ncreamy, faintly pinkish travertine. It glistens softly in the light.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:witch"
msgid "An old and unnaturally ugly human, wearing robes stained with what appears to\nbe swamp ooze, cauldron soot and brew ingredients.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:withered plant"
msgid "A plant whose life has been drained away, but with its physical form still\nintact. It looks like it died many {{ if you.branch() == \"Crypt\" or\nyou.branch() == \"Tomb\" or you.branch() == \"Zot\" then return \"centuries\";\nelse return \"years\"; end }} ago.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:worm"
msgid "A giant annelid, glistening with slime, with unusually large teeth.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:zin angel"
msgid "A divine agent of Zin. It is a towering winged figure with an aura of brilliant\nwhite light. Its face is marked by a scowl, as if its zeal against any real or\nperceived vice overshadows its goodness.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:zot statue"
msgid "A profoundly disturbing statue, hewn from a single piece of dark gabbro\nscintillating with tiny crystals. It is impossible to tell whether it is\nintended to represent some creature or personage, or to be completely abstract.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dire wolf spider"
msgid "<wolf spider>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:giant anaconda"
msgid "<anaconda>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:greater orb of eyes"
msgid "<great orb of eyes>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:naga warlord"
msgid "<naga warrior>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sulphuric acid blob"
msgid "<acid blob>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vault guard captain"
msgid "<vault guard>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:grandmaster elementalist"
msgid "<master elementalist>\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:bag of meat"
msgid "One of the legions of abominations created by the sculptors of flesh. It is a\nhorrendous imitation of the human form, consisting of an unrecognisable mass of\nmeat stitched together with limbs sewn on seemingly at random. Its skin hangs\noff loosely in some places and bulges repulsively in others. Each one bears a\nlarge symbol carved into its flesh, a mark of pride from its twisted creator.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:large bag of meat"
msgid "One of the legions of abominations created by the sculptors of flesh. Its\nbloated hulk pulsates and throbs constantly with accursed fires. It looks as if\nit could explode into a torrent of viscera at any moment.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:meat berserker"
msgid "One of the legions of abominations created by the sculptors of flesh. Its form\nis large and muscular. It moves swiftly and with impetuous fury, the sole\nthought within its being to rend you apart with great fervour. As it rages, it\ncreates a cacophonous din.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:meat hydra"
msgid "One of the legions of abominations created by the sculptors of flesh. Each of\nits eight necks is distended and elongated, connected to a colossal body\ncrumpled and dripping with ichor. Its many heads spew blood while writhing and\nconvulsing in agony, as it brings torment to itself and anything else that\nbeholds its foul visage.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:meat beast"
msgid "One of the legions of abominations created by the sculptors of flesh. Ablaze\nwith demonic frenzy, it gores and tramples with ferocity unmatched. Its skin is\nflayed, exposing the glistening tendons and sinew underneath, and the teeth\ninside its cavernous maw are stained with blood.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:sculptor of flesh"
msgid "An artisan of unlife, the sculptor appears as a grim skeletal form. It has six\nlong arms ending in mangled hands with broken fingers, upon which it crawls\nlike a spider. Its skull is abnormally large and full of holes. Its bones are\nreddened and fractured, inscribed with the unholy spells it weaves to assemble\nits puppets.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:destroyer"
msgid "The destroyers begin to descend upon you. They come in numbers and with wrath,\nmaws gaping like abaddon, bottomless and abyssal. They bring your doom and will\nfeast on your remains.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:accursed"
msgid "The accursed are the ones who came before. They have come to ensure you share\ntheir fate.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:tyrant"
msgid "A colossal mass of bones and skulls, a walking tomb. You hear shrieks and\nscreams as it approaches, shattering off bones with each crushing step,\nreassembling itself in eternal unrest.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:dread"
msgid "An affront to existence, a void in which there is only torment and damnation.\nIts unearthly form is torn and twisted, black and hollow. It is bereft of\nrational thought, knowing only hatred and the desire to desecrate your soul.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:scourge"
msgid "A vast serpentine form with raw and diseased skin, seeping bile and pus,\nspouting venom and blight.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:observer"
msgid "You see the unseen, you stare and they stare back. They whisper and laugh, they\ngrin and cry, they leer at you with contempt and gaze at you in adoration. They\nare the observers, they are the judge of your worth and will decide your end.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:wretched soul"
msgid "A spectre, struggling to leave the mortal world it is incarcerated in. It\ndrains life and unlife from all those it comes into contact with.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:fleshlord"
msgid "One of the greatest servants of the Meatlord. It is muscular, agile and full of\nmalevolence.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:vile"
msgid "An emaciated figure brimming with damnation and plague. Its appearance\nsignifies the end of days.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:the servant"
msgid "His glaive is alight with the flames of hell.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:the captor"
msgid "Those who enter will not escape.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:the defiler"
msgid "His shield is emblazoned with images of infernal flames.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:the meatlord"
msgid "You behold the embodiment of filth, corruption and depravity: the Meatlord. His\nfoul body is bloated to the extreme, leaking viscous fluid and the stench of\ndeath. His head is that of a boar with bulging eyes and tusks split in two, his\nsnout flares and oozes as he snorts and squeals at the sight of you, and his\nmouth is a toothless rift which drools pools of blood and vomits forth\ndisgusting remains. His neck is stretched and lops forward, its skin sagging\ndownward. His immense gut writhes and distorts as the larvae within await their\nrepugnant release. His legs are unrecognisable masses of flesh, covered in\nprotrusions and throbbing boils. Your mind reels at the sight of this hideous\nform, and your senses begin to shut down in an attempt to preserve your sanity\nas you choke on the oppressive stench.\n"
msgstr ""

#: crawl-ref/source/dat/descript/monsters.txt
msgctxt "textdb:descript/monsters.txt:the unspeakable"
msgid "You hear the echoes of planets behind the deafening roar of stars as it\napproaches. It is the jaws of the abyss. It brings forth crawling chaos from\nwithin. It is the last sight you will ever see.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:an opulent altar of gozag"
msgid "“Mother, I kneel before gold,\n my lover and beloved;\n and knowing I adore him,\n he turns melancholic yellow.\n Because he follows his every lust\n whether doubloon or dust,\n a mighty knight\n is Don Dinero.”\n    -Francisco de Quevedo, _Poderoso caballero es don Dinero_. 1603.\n     trans. Christopher Johnson, 2009.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a broken pillar"
msgid "“Now Absalom in his lifetime had taken and reared up for himself a pillar,\n which is in the king's dale: for he said, I have no son to keep my name in\n remembrance...”\n    -KJV Bible, 2 Samuel 18:18.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:calcifying dust cloud"
msgid "“There is shadow under this red rock,\n (Come in under the shadow of this red rock),\n And I will show you something different from either\n Your shadow at morning striding behind you\n Or your shadow at evening rising to meet you;\n I will show you fear in a handful of dust.”\n    -T.S. Eliot, “The Waste Land”. 1922\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a crumbling gateway"
msgid "<Desolation>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a faded altar of an unknown god"
msgid "“Then Paul stood in the midst of Mars' hill, and said, Ye men of Athens, I\n perceive that in all things ye are too superstitious. For as I passed by, and\n beheld your devotions, I found an altar with this inscription, TO THE UNKNOWN\n GOD.”\n    -KJV Bible, Acts 17:22-23.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a flagged portal"
msgid "“We made an expedition;\n We met a host and quelled it;\n We forced a strong position,\n And killed the men who held it.\n ...\n“Fierce warriors rushed to meet us;\n We met them, and o’erthrew them:\n They struggled hard to beat us;\n But we conquered them, and slew them.”\n    -Thomas Love Peacock, “The War Song of Dinas Vawr”. 1829.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a gateway back into the dungeon"
msgid "“O Progeny of Heaven! Empyreal Thrones!\n With reason hath deep silence and demur\n Seized us, though undismayed. Long is the way\n And hard, that out of Hell leads up to light.”\n    -John Milton, _Paradise Lost_. 1674 (2nd Ed.).\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a gateway leading deeper into the abyss."
msgid "<Abyss>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a gateway to hell"
msgid "“I am the way into the city of woe.\n I am the way to a forsaken people.\n I am the way into eternal sorrow.\n\n Sacred justice moved my architect.\n I was raised here by divine omnipotence,\n Primordial love and ultimate intellect.\n\n Only those elements time cannot wear\n Were made before me, and beyond time I stand.\n Abandon all hope, ye who enter here.”\n    -Dante Alighieri, _The Divine Comedy_, “Inferno”, Canto III. ca. 1315.\n     trans. John Ciardi, 1954.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a gateway to a ziggurat"
msgid "“Captain: Take off every ‘zig’!!\n Captain: For great justice.”\n    -_Zero Wing_. 1990.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a gateway to the decaying netherworld of tartarus"
msgid "<Tartarus>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a granite statue"
msgid "“I met a traveller from an antique land\n Who said: Two vast and trunkless legs of stone\n Stand in the desert. Near them on the sand,\n Half sunk, a shatter'd visage lies, whose frown\n And wrinkled lip and sneer of cold command\n Tell that its sculptor well those passions read\n Which yet survive, stamp'd on these lifeless things,\n The hand that mock'd them and the heart that fed.\n And on the pedestal these words appear:\n ‘My name is Ozymandias, king of kings:\n Look on my works, ye Mighty, and despair!’\n Nothing beside remains: round the decay\n Of that colossal wreck, boundless and bare,\n The lone and level sands stretch far away.”\n    -Percy Bysshe Shelley, “Ozymandias”. 1818.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a one-way gate to the infinite horrors of the abyss"
msgid "“And if you gaze for long into an abyss, the abyss gazes also into you.”\n    -Friedrich Nietzsche, _Beyond Good and Evil_ , Aphorism 146. 1886.\n\n“Well, in our country,” said Alice, still panting a little, “you'd generally\n get to somewhere else — if you ran very fast for a long time, as we've been\n doing.” “A slow sort of country!” said the Queen. “Now here, you see, it takes\n all the running you can do, to keep in the same place. If you want to get\n somewhere else, you must run at least twice as fast as that!”\n    -Lewis Carroll, _Through the Looking-Glass, and What Alice Found There_,\nch. 2 “The Garden of Live Flowers”. 1871.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:the open sea"
msgid "“I mused upon the mystery of fish, their strange and mindless beauty, how—\n innocently evil—they prey upon each other, devouring the weaker and smaller\n without rage or shout or change of countenance. There, in the realm of water,\n which is also earth and air to them, the great fish passed up and down,\n growing old without aging and enjoying eternal growth without the softness of\n obesity. It was a world without morality, a world without choices, a world of\n eating and spawning and growing great. I envied the great fish, and (in other,\n smaller ponds) the lesser fish, darting and flashing and sparkling gold.\n\n They speak of ‘the beast in man,’ and of ‘the law of the jungle.’ Might they\n not (so I reflected, strolling underneath a sky of clouds as blue and as white\n as the tiles and marble of the Altar of Heaven), might they not better speak\n of ‘the fish in man’? And of ‘the law of the sea’? The sea, from which they\n say we came...?”\n    -Avram Davidson, “Dagon”, 1959.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a portal to a secret trove of treasure"
msgid "“He saw a large cavern and a vaulted [roof], in height equalling the stature\n of a full-grown man and it was hewn in the live stone and lighted up with\n light that came through air-holes and bullseyes in the upper surface of the\n rock which formed the roof. He had expected to find naught save outer gloom in\n this robbers' den, and he was surprised to see the whole room filled with\n bales of all manner stuffs, and heaped up from sole to ceiling with\n camel-loads of silks and brocades and embroidered cloths and mounds on mounds\n of vari-colored carpetings; besides which he espied coins golden and silvern\n without measure or account, some piled upon the ground and others bound in\n leathern bags and sacks. Seeing these goods and moneys in such abundance, Ali\n Baba determined in his mind that not during a few years only but for many\n generations thieves must have stored their gains and spoils in this place.”\n    -_The Arabian Nights_. trans. Sir Richard F. Burton, 1885.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a portal to somewhere"
msgid "“The hole now stood some three meters in diameter beginning from the dais -\n though its outline shrank and dilated slightly like a pulsing, living thing.\n Through it we could see shapes seething and changing constantly with the\n colors and the light. Purple trees grew upside down from a pink sky, changing\n into black flowers and the flowers into feathery tongues of giant yellow worms\n lumbering over a shaking, exploding desert. It was as if the world couldn't\n make up its mind what to be yet. Looking at the scene for even a moment gave\n me a headache, and anyone looking at it for long would surely go mad.”\n    -Laurence Yep, _Dragon War_. 1992.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a rock wall"
msgid "“I know not whether Laws be right,\n   Or whether Laws be wrong;\n All that we know who lie in gaol\n   Is that the wall is strong;\n And that each day is like a year,\n   A year whose days are long.”\n    -Oscar Wilde, “The Ballad of Reading Gaol”. 1898.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a sacrificial altar of ru"
msgid "“Then I began taking off my hands. I put them in the top drawer. I removed my\n feet and put them into the closet, along with my legs. I put my head in a box\n and hung my torso up on a hanger. Then I walked out of the apartment, climbed\n up the stairs to the roof. I opened the door and stepped out into a beautiful\n green meadow.”\n    -Celestial Navigations, “The Sniper”. 1995.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a shaft"
msgid "“Gravity, a mere nuisance to Christian, was a terror to Pope, Pagan, and\n Despair. To the mouse and any smaller animal it presents practically no\n dangers. You can drop a mouse down a thousand-yard mine shaft; and, on\n arriving at the bottom it gets a slight shock and walks away, provided\n that the ground is fairly soft. A rat is killed, a man is broken, a\n horse splashes.”\n    -J.B.S. Haldane, “On Being The Right Size”. March 1926.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a shimmering altar of xom"
msgid "the wise man bowed his head solemnly and spoke:\n “theres actually zero difference between good & bad things.\n you imbecile. you fucking moron”\n    -wint, @dril Twitter. June 1, 2014\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a staircase leading out of the dungeon"
msgid "“We shall not cease from exploration\n And the end of all our exploring\n Will be to arrive where we started\n And know the place for the first time.”\n    -T.S. Eliot, “Little Gidding”, _Four Quartets_. 1943.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a staircase to the ecumenical temple"
msgid "<Temple>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a staircase to the elven halls"
msgid "<Elven Halls>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a staircase to the orcish mines"
msgid "<Orcish Mines>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a staircase to the shoals"
msgid "<Shoals>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a staircase to the tomb"
msgid "“A tomb now suffices him for whom the world was not enough.”\n    -Alexander the Great's epitaph.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a stormy altar of qazlal"
msgid "“The storm irresistibly propels him into the future to which his back is\n turned, while the pile of debris before him grows skyward. This storm is what\n we call progress.”\n    -Walter Benjamin, “Theses on the Philosophy of History”. 1940.\n   trans. Harry Zohn, 1969.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:a tree"
msgid "“I like trees because they seem more resigned to the way they have to live than\n other things do.”\n    -Willa Cather, _O Pioneers!_. 1913.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:abyss"
msgid "“Out here in the zones, you never even knew when your bone marrow might book an\n exotic vacation and neglect to invite you along. Thinking square thoughts under\n a violet endomoon could redefine every third cell in your body as a verb. There\n were sneakers that ate feet, bifocals that ate eyeballs, strawberry yogurt that\n ate small intestines. Farther out there, _so_ much farther, there were\n wavelengths of something ancestral to light that could crawl into your past and\n eat the day you were born.\n\n Nobody so much as batted an eye or quivered a flange when these things happened\n to the unnaturally branchinated, the puzzling and comical tourists that blipped\n in and out from the forgettable grey. Things like herself, or Fern, or the\n plank maze loser were little more than _weird bugs_ to most entities, a quaint\n curiosity at best and more often an unwanted parasite. Infinite layers of\n reality, and it still felt, in the worst way, like she'd never left home.”\n    -Jonathan Wojcik, _Awful Hospital_. 2021.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:desolation"
msgid "“In the salt mines\n I saw the salt\n in this shaker.\n I know you won’t believe me,\n but there\n it sings,\n the salt sings, the skin\n of the salt mines\n sings\n with a mouth choking\n on dirt.\n Alone\n when I heard\n the voice\n of salt,\n I trembled\n in the empty\n desert.\n Near Antafagusta\n the whole\n salted plain\n shouts out\n in its\n cracked\n voice\n a pitiful\n song.”\n    -Pablo Neruda, “Ode to Salt”, 1957.\n     trans. Philip Levine, published 2013\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:elven halls"
msgid "“Elves are wonderful. They provoke wonder.\n Elves are marvelous. They cause marvels.\n Elves are fantastic. They create fantasies.\n Elves are glamorous. They project glamour.\n Elves are enchanting. They weave enchantment.\n Elves are terrific. They beget terror.\n The thing about words is that meanings can twist just like a snake, and if you\n want to find snakes look for them behind words that have changed their meaning.\n No one ever said elves are _nice_.\n Elves are _bad_.”\n    -Terry Pratchett, _Lords and Ladies_. 1992.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:orcish mines"
msgid "“You load sixteen tons, what do you get\n Another day older and deeper in debt\n Saint Peter don't you call me 'cause I can't go\n I owe my soul to the company store.”\n    -Merle Travis, “Sixteen Tons”. 1946.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:shoals"
msgid "“I often think about that old metaphor, the one that says we are all islands on\n a wide sea. Especially these days, now that things are more difficult than\n before and the world appears to be harsher than we once imagined it to be.\n\n We are all like islands, the philosopher said. Perhaps it's true. Yet I cannot\n help but remember an older saying scratched on a cave wall somewhere by a\n long- forgotten prophet: In the end the sea will claim everything.\n\n The ancient words crash into my mind like waves, waking me from sleep, filling\n me with feelings I cannot fully understand. We are like islands. Does it mean\n we are connected? Do we share a common origin? Or just the common fate of\n sinking?”\n    -“The Sea Will Claim Everything”. 2012.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:tartarus"
msgid "“There is a drear and lonely tract of hell\n From all the common gloom removed afar:\n A flat, sad land it is, where shadows are,\n Whose lorn estate my verse may never tell.”\n    -Edward Arlington Robinson, “Supremacy”. 1897.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:temple"
msgid "“And I heard a great voice out of the temple saying to the seven angels, Go\n your ways, and pour out the vials of the wrath of God upon the earth.”\n    -KJV Bible, Revelations 16:1.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:tomb"
msgid "“In the depths of every heart, there is a tomb and a dungeon, though the\n lights, the music, and revelry above may cause us to forget their existence,\n and the buried ones, or prisoners whom they hide. But sometimes, and oftenest\n at midnight, those dark receptacles are flung wide open. In an hour like this,\n when the mind has a passive sensibility, but no active strength; when the\n imagination is a mirror, imparting vividness to all ideas, without the power\n of selecting or controlling them; then pray that your grieves may slumber, and\n the brotherhood of remorse not break their chain.”\n    -Nathaniel Hawthorne, “The Haunted Mind”. 1835.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:agony spell"
msgid "<Curse of Agony spell>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:alistair's walking alembic spell"
msgid "Despite its unwieldy appearance, it is widely considered Alistair's most popular\nwork; countless variations of this spell can be found in surface libraries,\ncustomised to prepare everything from floor polish to vegetable soup. In the\ndepths of the dungeon, however, most mages favor the combat utility of the\nclassic iteration.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:animate dead spell"
msgid "“Remember, I am not recording the vision of a madman. The sun does not more\n certainly shine in the heavens, than that which I now affirm is true. Some\n miracle might have produced it, yet the stages of the discovery were distinct\n and probable. After days and nights of incredible labour and fatigue, I\n succeeded in discovering the cause of generation and life; nay, more, I became\n myself capable of bestowing animation upon lifeless matter.”\n    -Mary Shelley, _Frankenstein, or the Modern Prometheus_,\n     Vol. I, Chapter 3. 1818 (1st Ed.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:awaken armour spell"
msgid "\"A blacksmith shapes the heart of their steel just as much as any leader shapes\nthe hearts of their soldiers. If this armour of mine could speak, I know it\nwould say that we fight for the same cause.\"\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:awaken forest spell"
msgid " • Hel: [She died to] Infection! She's mine!\n — Thor: From a splinter that she got bravely fighting an elm!\n • Hel: Trees are inanimate plants, you buffoon!\n — Thor: Bravery knows no limits!\n    -Rich Burlew, _Order of the Stick_, #874.\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:banishment spell"
msgid "“An immense river of oblivion is sweeping us away into a nameless abyss.”\n    -Ernest Renan, Souvenirs\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:bat form ability"
msgid "“The bats have left the bell tower\n The victims have been bled”\n    -Bauhaus, “Bela Lugosi's Dead”. 1979.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:bend time ability"
msgid "“It's astounding\n Time is fleeting\n Madness takes its toll”\n    -Richard O'Brien, “Time Warp”. 1975.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:brain bite spell"
msgid "“Lister: I know what you want. It's pink and it's moist and it's in my head. And\n         that's where it's staying.”\n    -Red Dwarf, _Psirens_. 1993.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:call canine familiar spell"
msgid "“There seemed a strange stillness over everything. But as I listened, I heard\n as if from down below in the valley the howling of many wolves. The Count's\n eyes gleamed, and he said.\n\n ‘Listen to them, the children of the night. What music they make!’ Seeing, I\n suppose, some expression in my face strange to him, he added, ‘Ah, sir, you\n dwellers in the city cannot enter into the feelings of the hunter.’”\n    -Bram Stoker, _Dracula_. 1897.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:cause fear spell"
msgid "“And when Miranda sang\n Everyone turned away\n Used to the noose, they obey”\n    -The Mars Volta, “Miranda That Ghost Just Isn't Holy Anymore”. 2005.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:chain lightning spell"
msgid "“The trouble ain't that there is too many fools,\n but that the lightning ain't distributed right.”\n    -traditionally attributed to Samuel Clemens.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:charm spell"
msgid "“He held up his hand, and they all stopped, and I thought he seemed to be\n saying, ‘All these lives will I give you, ay, and many more and greater,\n through countless ages, if you will fall down and worship me!’ And then a red\n cloud, like the colour of blood, seemed to close over my eyes, and before I\n knew what I was doing, I found myself opening the sash and saying to Him,\n ‘Come in, Lord and Master!’”\n    -Bram Stoker, _Dracula_. 1897.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:corrupt ability"
msgid "“I fumbled to the window to experience the world\n And to hear my Madness singing, sitting on the kerbstone\n [A blind old drunken man who sings and mutters,\n  With broken boot heels stained in many gutters]\n And as he sang the world began to fall apart . . .”\n    -T.S. Eliot, “Prufrock's Pervigilium”. 1912 (published 1996).\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:curse of agony spell"
msgid "“Unbearable, isn't it? The suffering of strangers, the agony of friends. There\n is a secret song at the center of the world, Joey, and its sound is like\n razors through flesh.”\n    -Pinhead, _Hellraiser 3: Hell on Earth_. 1992.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:dragon's call spell"
msgid "“This is where the dragons went.\n They lie...\n Not dead, not asleep. Not waiting, because waiting implies expectation.\n Possibly the word we're looking for here is...\n ...dormant.\n And although the space they occupy isn't like normal space, nevertheless\n   they are packed in tightly. Not a cubic inch there but is filled by a claw,\n   a talon, a scale, the tip of a tail, so the effect is like one of those\n   trick drawings and your eyeballs eventually realise that the space between\n   each dragon is, in fact, another dragon.\n They could put you in mind of a can of sardines, if you thought sardines\n   were huge and scaly and proud and arrogant.\n And presumably, somewhere, there's the key.”\n    -Terry Pratchett, “Guards! Guards!”. 1990.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:duel ability"
msgid "DUEL, n. A formal ceremony preliminary to the reconciliation of two enemies.\nGreat skill is necessary to its satisfactory observance; if awkwardly\nperformed the most unexpected and deplorable consequences sometimes ensue.\nA long time ago, a man lost his life in a duel.\n    -Ambrose Bierce, _The Devil's Dictionary_, 1906.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:ensorcelled hibernation spell"
msgid "“Sweet dreams are made of this; who am I to disagree?”\n    -Eurythmics, “Sweet Dreams (Are Made of This)”. 1983.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:eringya's surprising crocodile spell"
msgid "A popular legend states that Eringya first demonstrated this spell as the\nclosing remark of a particularly acrimonious debate about wetlands conservation,\nbut most modern scholars consider this apocryphal.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:fire storm spell"
msgid "“Some have said there is no subtlety to destruction. You know what? They're\n dead.”\n    -Jaya Ballard, task mage (Magic: the Gathering).\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:frozen ramparts spell"
msgid "”And as you cross the circle line\n Well, the ice wall creaks behind\n You're a rabbit on the run”\n\n    -Jethro Tull, “Skating Away (on the Thin Ice of a New Day)”.  1974.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:irradiate spell"
msgid "“Reflex in the sky warn you you're gonna die\n Storm coming, you'd better hide from the atomic tide\n Flashes in the sky turns houses into sties\n Turns people into clay, radiation minds decay”\n    -Black Sabbath, “Electric Funeral”. 1970.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:iskenderun's battlesphere spell"
msgid "“Maxim 4: Close air support covereth a multitude of sins.”\n    -Howard Tayler, _The Seventy Maxims of Maximally Effective Mercenaries_,\n     in _Schlock Mercenary_. 2008.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:lee's rapid deconstruction spell"
msgid "“Now the house was full of men and women; and all the lords of the Philistines\n were there; and there were upon the roof about three thousand men and women,\n that beheld while Samson made sport.\n\n And Samson called unto the LORD, and said, O Lord GOD, remember me, I pray\n thee, and strengthen me, I pray thee, only this once, O God, that I may be at\n once avenged of the Philistines for my two eyes.\n\n And Samson took hold of the two middle pillars upon which the house stood, and\n on which it was borne up, of the one with his right hand, and of the other\n with his left.\n\n And Samson said, Let me die with the Philistines. And he bowed himself with\n all his might; and the house fell upon the lords, and upon all the people that\n were therein. So the dead which he slew at his death were more than they which\n he slew in his life.”\n    -KJV Bible, Judges 16:27-30.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:magic dart spell"
msgid "“Wie die Mächtigen es schon seit jeher wissen,\n Es gibt immer einen Kniff;\n Denn als Guter bist du niemals so gerissen,\n Ein Zauberpfeil der immer trifft!\n\n [As the powerful have known all along,\n There is always a trick;\n Because as a good person, you'll never be so cunning,\n A magic arrow that always hits!]”\n    -ASP, \"Verwandlungen I-III\". 2008\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:mass confusion spell"
msgid "“Go to, let us go down, and there confound their language, that they may not\n understand one another's speech. So the LORD scattered them abroad from thence\n upon the face of all the earth: and they left off to build the city.”\n    -KJV Bible, Genesis 11:7-8.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:maxwell's portable piledriver spell"
msgid "While originally designed for use in industrial construction, enterprising\ncopycats were quick to discover a multitude of other problems that could be\nsolved by moving one object into another, very, very quickly.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:mephitic cloud spell"
msgid "“Seit mehreren Jahren schon hatte die indische Cholera eine verstärkte\n Neigung zur Ausbreitung und Wanderung an den Tag gelegt. Erzeugt aus\n den warmen Moraesten des Ganges-Deltas, aufgestiegen mit dem\n mephitischen Odem jener üppig-untauglichen, von Menschen gemiedenen\n Urwelt- und Inselwildnis, in deren Bambusdickichten der Tiger kauert,\n hatte die Seuche in ganz Hindustan andauernd und ungewöhnlich heftig\n gewütet, hatte östlich nach China, westlich nach Afghanistan und\n Persien übergegriffen und, den Hauptstraßen des Karawanenverkehrs\n folgend, ihre Schrecken bis Astrachan, ja selbst bis Moskau getragen.”\n    -Thomas Mann, _Der Tod in Venedig_, 1911.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:mercury arrow spell"
msgid "“During the course of the treatise, each element is allowed time to tout its\n own virtues and usefulness to mankind, but when it comes time for Mercury,\n he announces that he presides over all of the beings that have come before\n him. Mercury is mother and father. He gives other metals their splendor and\n makes them useful to humanity. Without Mercury, the other metals would have no\n (use) value. Perhaps a seat on the throne would restrict him to a fixed\n position of sovereignty. He reigns, but he must be mobile.”\n    -Karen Pinkus, _Alchemical Mercury: A Theory of Ambivalance_, 2009\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:nazja's percussive tempering spell"
msgid "Scholars long considered the hammer mere theatrics to mask the complex\nstructural enhancement magics which must underpin this spell, and yet every\nattempt to remove it from the incantation has caused the spell to lose its\neffectiveness. The implications of this remain hotly debated.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:passwall spell"
msgid "“He says the best way out is always through.”\n    -Robert Frost, _A Servant to Servants_. 1915.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:petrify spell"
msgid "“Any pose held too long calcifies.\n A belief believed too long becomes dogma.\n Any expression held long enough will harden into a mask.\n And who is the _real_ us\n that hard exterior\n or the soft uncertain self we keep beneath?”\n    -Dorothy Gambrell, _Cat and Girl_, 2011.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:poison arrow spell"
msgid "“I saw in a hall an arrow pointing the way and I thought that this inoffensive\n symbol had once been a thing of iron, an inescapable and fatal projectile that\n pierced the flesh of men and lions and clouded the sun at Thermopylae and gave\n Harald Sigurdarson six feet of English earth forever.”\n    -Jorge Luis Borges, _Mutations_. 1960.\n     trans. Mildred Boyle\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:sacrifice love ability"
msgid "“Every thing is related in them which bears reference to my accursed origin;\n the whole detail of that series of disgusting circumstances which produced it\n is set in view; the minutest description of my odious and loathsome person is\n given, in language which painted your own horrors, and rendered mine\n ineffaceable. I sickened as I read. ‘Hateful day when I received life!’ I\n exclaimed in agony. ‘Cursed creator! Why did you form a monster so hideous that\n even you turned from me in disgust? God in pity made man beautiful and\n alluring, after his own image; but my form is a filthy type of yours, more\n horrid from its very resemblance. Satan had his companions, fellow-devils, to\n admire and encourage him; but I am solitary and detested.’”\n    -Mary Shelley, _Frankenstein, or the Modern Prometheus_,\n     Vol. II, Chapter 7. 1818 (1st Ed.)\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:shatter spell"
msgid "“So the people shouted when the priests blew with the trumpets: and it came to\n pass, when the people heard the sound of the trumpet, and the people shouted\n with a great shout, that the wall fell down flat, so that the people went up\n into the city, every man straight before him, and they took the city.\n\n And they utterly destroyed all that was in the city, both man and woman, young\n and old, and ox, and sheep, and ass, with the edge of the sword.”\n    -KJV Bible, Joshua 6:20-21.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:slimify ability"
msgid "“Rumack: It starts with a slight fever and dryness of the throat. When the\n virus penetrates the red blood cells, the victim becomes dizzy, begins to\n experience an itchy rash, then the poison goes to work on the central nervous\n system, severe muscle spasms followed by the inevitable drooling.\n [Oveur does all of the above as Rumack describes each one]\n Rumack: At this point, the entire digestive system collapses accompanied by\n uncontrollable flatulence.\n [Oveur begins to fart uncontrollably]\n Rumack: Until finally, the poor bastard is reduced to a quivering wasted piece\n of jelly.”\n    -Airplane! 1980.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:slouch ability"
msgid "“I remember doing the Time Warp\n Drinking those moments when\n The blackness would hit me\n And the void would be calling”\n    -Richard O'Brien, “Time Warp”. 1975.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:spellspark servitor spell"
msgid "<spellspark servitor>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:sticky flame spell"
msgid "“Give a man a fire and he's warm for a day, but set fire to him and he's warm\n for the rest of his life.”\n    -Terry Pratchett, “Jingo”. 1997.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:step from time ability"
msgid "“It's so dreamy\n Oh, fantasy free me\n So you can't see me\n No, not at all\n In another dimension”\n    -Richard O'Brien, “Time Warp”. 1975.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:summon demon spell"
msgid "“'Tis now the very witching time of night,\n When churchyards yawn and hell itself breathes out\n Contagion to this world.”\n    -William Shakespeare, _The Tragedy of Hamlet, Prince of Denmark_, III, 2.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:summon illusion spell"
msgid "“I am just a copy of a copy of a copy\n Everything I say has come\n before\n Assembled into something into something into something\n I don’t know for certain anymore\n\n I am just a shadow of a shadow of a shadow\n Always trying to catch up with myself\n I am just an echo of an echo of an echo\n Listening to someone’s cry for help\n\n Look what you had to start\n Why all the change of heart?\n You need to play your part\n A copy of a copy of a—”\n    -Nine Inch Nails, “Copy Of A”. 2013\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:summon seismosaurus egg spell"
msgid "Zoologists famously considered this animal to have been extinct for centuries\nuntil copies of this spell were unearthed among the affairs of a misanthropic\nhermit who'd finally made the wrong noble's hair fall out.\n\nSeveral well-funded expeditions were launched in the wake of the discovery, but\ndespite (or perhaps because of) the sometimes-violent competitiveness these\nnaturalists had for each other, the location of the lizards' nesting grounds\nremains unknown to this day.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:swiftness spell"
msgid "“JUST WALK OUT\n you can leave!!!\n  work\n  social thing\n  movies\n  home\n  class\n  dentist\n  clothes shoppi\n  too fancy weed store\n  cops if your quick\n  friend ships\n IF IT SUCKS... HIT DA BRICKS!!\n real winners quit” [sic]\n   -Admin, @dasharez0ne Twitter. March 30, 2018\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:temporal distortion ability"
msgid "“With a bit of a mind flip\n You're into the time slip\n And nothing can ever be the same”\n    -Richard O'Brien, “Time Warp”. 1975.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:waterstrike spell"
msgid "“Water dissolving\n And water removing\n There is water\n At the bottom of the ocean\n Under the water\n Carry the water\n Remove the water\n At the bottom of the ocean”\n    -Talking Heads, “Once in a Lifetime”. 1980.\n\n\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:acid dragon scales"
msgid "<steam dragon scales>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:amulet"
msgid "“Gringoire put out his hand for the little bag, but she drew back. ‘Do not\n touch it! It is an amulet, and either you will do mischief to the charm, or it\n will hurt you.’”\n    -Victor Marie Hugo, _Notre Dame de Paris_, Book II, chapter VII “A Wedding\n     Night”. 1831.\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:amulet of faith"
msgid "<amulet>\n"
msgstr ""

#: crawl-ref/source/dat/descript/quotes.txt
msgctxt "textdb:descript/quotes.txt:amulet of guardian spirit"
msgid "<amulet>\n"
msgstr ""

