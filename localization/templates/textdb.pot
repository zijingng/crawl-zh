msgctxt "textdb:descript/features.txt:a large runed door"
msgid "<A runed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a runed gate"
msgid "<A runed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a huge runed gate"
msgid "<A runed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a large sealed door"
msgid "<A sealed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
msgctxt "textdb:descript/features.txt:a sealed gate"
msgid "<A sealed door>\n"
msgstr ""

#: crawl-ref/source/dat/descript/features.txt
