msgctxt "a.art-data"
msgid ""
"Freeze:    It freezes victims, dealing an additional one-quarter of any damage that pierces defenders' armour. It may also slow down cold-blooded creatures.\n"
"Rev:       It becomes more effective when it hits something. This effect fades over time."
msgstr ""

msgctxt "a.art-data"
msgid "reach+"
msgstr ""

msgctxt "a.art-data"
msgid "Reach+:    It can reach especially far, and its reaching attacks ignore other creatures in the way."
msgstr ""

msgctxt "a.art-data"
msgid ""
"Battle: It summons a battlesphere in combat, with strength depending on Conjurations skill.\n"
"Destructive: It enhances your destructive magic, and weakens non-destructive magic."
msgstr ""

msgctxt "a.art-data"
msgid "Corpsefed rMiasma"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Corpsefed: It gathers nearby corpses to temporarily increase the armour it provides.\n"
"rMiasma:   It protects you from foul pestilence."
msgstr ""

msgctxt "a.art-data"
msgid "Rampage+∞"
msgstr ""

msgctxt "a.art-data"
msgid "Rampage+∞: When moving toward enemies, its wearer moves as far as possible, alerting their target en route."
msgstr ""

msgctxt "a.art-data"
msgid "Infuse+∞ VampMP"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Infuse+∞:  It empowers its wearer's blows with all of their magic.\n"
"VampMP:    Blows struck in melee replenish the wearer's magic."
msgstr ""

msgctxt "a.art-data"
msgid "*Dream"
msgstr ""

msgctxt "a.art-data"
msgid "*Dream:    It absorbs a single lethal wound into itself, holding its wearer just short of death and releasing dream-creatures to guard them."
msgstr ""

msgctxt "a.art-data"
msgid "ID++"
msgstr ""

msgctxt "a.art-data"
msgid "ID++:      It heals its wearer when they drink unknown potions, and restores their MP when they read unknown scrolls."
msgstr ""

msgctxt "a.art-data"
msgid "coup de grace"
msgstr ""

msgctxt "a.art-data"
msgid "Coup de Grace: It may instantly kill foes which have little health."
msgstr ""

msgctxt "a.art-data"
msgid "meekguard"
msgstr ""

msgctxt "a.art-data"
msgid "Meekguard: It provides extra protection to wielders with little health."
msgstr ""

msgctxt "a.art-data"
msgid "anguish,"
msgstr ""

msgctxt "a.art-data"
msgid "Anguish:   It makes its victims' attacks reflect back on them."
msgstr ""

msgctxt "a.art-data"
msgid "steadfast,"
msgstr ""

msgctxt "a.art-data"
msgid "Steadfast: It prevents involuntary movement, except for blinking, teleportation, or banishment."
msgstr ""

msgctxt "a.art-data"
msgid "reach-cleave, Poleaxe"
msgstr ""

msgctxt "a.art-data"
msgid "Reach-Cleave: It can be evoked to extend its reach, and strikes at all foes within reach, dealing less damage to those not targeted."
msgstr ""

msgctxt "a.art-data"
msgid "Poleaxe:   It uses either Axes or Polearms skill, whichever is higher."
msgstr ""

msgctxt "a.art-data"
msgid "Invo=14 Evo=0"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Invo=14:   It sets your Invocations skill to 14.\n"
"Evo=0:    It sets your Evocations skill to 0."
msgstr ""

msgctxt "a.art-data"
msgid "slick, slippery,"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Slick:     Its wearer cannot be constricted, netted, webbed, or stopped by binding sigils.\n"
"Slippery:  Its wearer slips away from damaging melee attacks, pulling the attacker onward."
msgstr ""

msgctxt "a.art-data"
msgid "knockback,"
msgstr ""

msgctxt "a.art-data"
msgid "Knockback: It sometimes drives back enemies it hits."
msgstr ""

msgctxt "a.art-data"
msgid "Valiant"
msgstr ""

msgctxt "a.art-data"
msgid "Valiant:   It becomes more powerful as more dangerous foes come into view."
msgstr ""

msgctxt "a.art-data"
msgid "*Victory"
msgstr ""

msgctxt "a.art-data"
msgid "*Victory:  When the wearer kills a threatening monster, it has a chance to gain +1 AC, +1 Slay, and +1 Int, capping at +7. When the wearer uses a scroll or a potion with a hostile monster in sight, its bonuses reset to +0. Unequipping it also resets its bonuses to +0."
msgstr ""

msgctxt "a.art-data"
msgid "shock,"
msgstr ""

msgctxt "a.art-data"
msgid "Shock:     When it blocks an attack, it may electrocute the attacker. This works even against foes who are a short distance away."
msgstr ""

msgctxt "a.art-data"
msgid "backblast,"
msgstr ""

msgctxt "a.art-data"
msgid "Backblast: When fired, it often launches its wielder backwards."
msgstr ""

msgctxt "a.art-data"
msgid "Gadgeteer Wandboost"
msgstr ""

#, no-c-format
msgctxt "a.art-data"
msgid ""
"Gadgeteer:   Your evocable items recharge 30% faster and wands have a 30% chance to not spend a charge.\n"
"Wandboost:   Your wands are more powerful."
msgstr ""

msgctxt "a.art-data"
msgid "orb Charlatan"
msgstr ""

#, no-c-format
msgctxt "a.art-data"
msgid ""
"It massively reduces your stealth.\n"
"It interferes with translocations, delaying teleports.\n"
"Charlatan: It boosts your other skills by 20% of your base Evocations skill."
msgstr ""

msgctxt "a.art-data"
msgid "Inspire Amulet+"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Inspire:   When you summon or create an ally, it gains Regeneration.\n"
"Amulet+:   You can equip an additional amulet."
msgstr ""

msgctxt "a.art-data"
msgid "Reaping Hat+"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Reaping:   When you kill an enemy with your weapon, its spirit may be forced to fight for you.\n"
"Hat+:   You can equip an additional hat (on the skull)."
msgstr ""

msgctxt "a.art-data"
msgid "Shroompunch Gloves+"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Shroompunch:   The cloak sometimes lashes out at its wearer's enemies, inflicting confusion with its spores.\n"
"Gloves+:   Your cloak can equip an additional pair of gloves."
msgstr ""

msgctxt "a.art-data"
msgid "Majesty Ring++"
msgstr ""

msgctxt "a.art-data"
msgid ""
"Majesty:   You are bathed in light that prevents you from turning invisible. Whenever you enter a new floor, you announce yourself to nearby enemies and refuse to leave the floor again for some time.\n"
"Ring++:   You can equip two additional rings."
msgstr ""

