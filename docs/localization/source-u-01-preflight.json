    {
      "file": "ui.cc",
      "sha256": "f956541a5404b5dab357a74ff370cc226d350422c36e02519032c56923c978b5",
      "hits": [
        {
          "term": "Console",
          "translation": "字符版/控制台/终端",
          "note": "【0.34.1 修订】DCSS 版本类型，与 Tiles（图形版）成对；命令行控制台本身按上下文另译。 来源：Makefile。\n【语境补充 2026-10-21】游戏显示模式用字符版。系统控制台或终端按上下文用对应词。条件标签保留英文。"
        },
        {
          "term": "dungeon",
          "translation": "地下城",
          "note": ""
        },
        {
          "term": "exit",
          "translation": "出口/退出/离开",
          "note": "【0.34.1 修订】名词用出口；命令动词用退出，按上下文处理，不把两者拼成一条输出。 来源：feature-data.h。\n【语境补充 2026-10-21】地点或设施用出口。菜单命令用退出。离开区域的动作用离开。"
        },
        {
          "term": "max",
          "translation": "最大值",
          "note": "【0.34.1 修订】通用上限词，不限于 HP/MP；reserves 表储备，不是 maximum 同义词。 来源：player.cc。"
        },
        {
          "term": "skill",
          "translation": "技能",
          "note": ""
        },
        {
          "term": "throw",
          "translation": "投掷",
          "note": "【0.34.1 修订】本条是动作动词；独立补充 Throwing 技能，不把普通 throwing 自动视为技能名。 来源：skills.cc。\n【0.34.1 法术名称】来源：crawl-ref/source/spl-data.h。含玩家法术、怪物专用、内部及旧版兼容条目；有定义不等于可由玩家学习。英文为规范名称；中文为统一译名。"
        },
        {
          "term": "Tiles",
          "translation": "图形版/图块/方格",
          "note": "【语境补充 2026-10-21】与 Console 对举的客户端模式用图形版。资源图像用图块。地图位置的 tiles 用方格。条件标签保留英文。"
        },
        {
          "term": "Will",
          "translation": "意志/将会/会",
          "note": "【0.34.1 补充/HUD缩写】意志缩写保留时使用 Will；不要替换成旧 MR。 来源：duration-data.h。\n【语境补充 2026-10-21】属性或抗性用意志。助动词 will 表示将来或意愿，按句意译为将会、会，也可省略。"
        },
        {
          "term": "Might",
          "translation": "强力术/可能/力量",
          "note": "【0.34.1 法术名称】来源：crawl-ref/source/spl-data.h。含玩家法术、怪物专用、内部及旧版兼容条目；有定义不等于可由玩家学习。英文为规范名称；中文为统一译名。\n【语境补充 2026-10-21】法术或能力标题保留强力术。情态动词 might 表示可能。名词 might 表示力量或威力。"
        },
        {
          "term": "player",
          "translation": "玩家",
          "note": "【0.34.1 怪物显示名】来源：mon-data.h（由 dat/mons 生成）及 mon-info.cc。规范英文用于存档、Lua、查询；中文仅用于显示。"
        },
        {
          "term": "float",
          "translation": "飘浮",
          "note": "【0.34.1 变异名称校对】来源：mutation-data.h、form-data.h、bane-data.h、dat/descript/mutations.txt；规范英文名及 TextDB 键保持不变，中文仅用于显示。此语境名称：飘浮。"
        }
      ]
    },
