  "terms": [
    {
      "Term": "Armour",
      "Translation": "防具/护身",
      "Part of Speech": "noun",
      "Variants": "",
      "Note": "【统一术语】防御装备大类及 Armour 技能均译“防具”；body armour 译“躯干防具”；AC 为“护甲值”。具体物品使用皮甲、锁子甲、板甲等名称。\n【语境补充 2026-10-21】装备大类与技能统一用防具。armour oneself 作动词用护身。body armour 仍用躯干防具，AC 仍用护甲值。具体皮甲、锁子甲、板甲等依完整专名。"
    },
    {
      "Term": "Cheibriados",
      "Translation": "切布理亚多",
      "Part of Speech": "noun",
      "Variants": "",
      "Note": "审慎之神\n【现行神祇】名称已与 0.34.1 god_name 返回值对应；中文专名为项目约定。来源：religion.cc。"
    },
